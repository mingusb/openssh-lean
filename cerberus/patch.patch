diff --git a/tests/openssh-gnu-keywords/aliases.c b/tests/openssh-gnu-keywords/aliases.c
new file mode 100644
index 00000000..9b38a3d8
--- /dev/null
+++ b/tests/openssh-gnu-keywords/aliases.c
@@ -0,0 +1,30 @@
+/* Regression for GNU keyword spellings used by portable OpenSSH's headers. */
+__extension__ static __inline int f(__const int *__restrict p) { return *p; }
+static __inline__ __signed__ int g(__const__ int *__restrict__ p) { return *p; }
+__extension__ typedef __signed int S;
+typedef __typeof(1) T;
+typedef __typeof__(1) U;
+int main(void) {
+  __const int x = 20;
+  __const__ int y = 20;
+  __volatile int a = 0;
+  __volatile__ int b = 0;
+  S s = 1;
+  T t = 1;
+  U u = 0;
+  int counter = 0;
+  __typeof__(counter++) local = 0;
+  int total;
+  if (__alignof(long) != __alignof__(long)) return 4;
+  /* Keep this keyword regression independent of operand-order enumeration. */
+  total = __extension__ f(&x);
+  total += g(&y);
+  total += a;
+  total += b;
+  total += s;
+  total += t;
+  total += u;
+  total += counter;
+  total += local;
+  return total;
+}
