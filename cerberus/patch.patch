+let gnu_scalar_core_integer value = match value with
+  | C.Vobject (C.OVinteger number) -> Mem.eval_integer_value number
+  | _ -> Nothing end
+
+let gnu_scalar_core_number number = C.Vobject (C.OVinteger (Mem.integer_ival number))
