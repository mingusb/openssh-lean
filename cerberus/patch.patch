+/* Independently declared aggregate types must survive canonical function
+   addresses, including anonymous records and recursive member types. */
+struct Node { int value; struct Node *next; };
+typedef struct { int value; } Anonymous;
+union Payload { int value; unsigned int bits; };
+struct Opaque;
+extern int inspect(struct Node *, Anonymous *, union Payload *);
+extern int by_value(struct Node);
+extern struct Node *identity(struct Node *);
+extern struct Opaque *opaque(void);
+extern int read_opaque(struct Opaque *);
+int main(void) {
+    struct Node node = {2, 0};
+    Anonymous anonymous = {3};
+    union Payload payload = {5};
+    int (*read)(struct Node *, Anonymous *, union Payload *) = inspect;
+    node.next = &node;
+    if (inspect(&node, &anonymous, &payload) != 12) return 1;
+    if (read(&node, &anonymous, &payload) != 12) return 2;
+    if (by_value(node) != 4) return 3;
