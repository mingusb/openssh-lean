+  list Symbol.sym -> list (Symbol.sym * C.core_base_type) -> list (C.expr unit) -> list (C.expr unit)
+let rec vla_capture_local labels captured (C.Expr annots node) =
+  C.Expr annots (vla_capture_local_node labels captured node)
+
+and vla_capture_local_node labels captured node =
+  let saved = List.map (fun (sym, bTy) -> (sym, ((bTy, Nothing), Caux.mk_sym_pe sym))) captured in
+  let passed = List.map (fun (sym, _) -> Caux.mk_sym_pe sym) captured in
+  match node with
+    | C.Epure _ -> node
+    | C.Ememop _ _ -> node
+    | C.Eaction _ -> node
+    | C.Ecase pe alternatives ->
+        C.Ecase pe (vla_capture_local_alternatives labels captured alternatives)
+    | C.Elet pattern pe body -> C.Elet pattern pe (vla_capture_local labels captured body)
+    | C.Eif condition yes no -> C.Eif condition (vla_capture_local labels captured yes) (vla_capture_local labels captured no)
+    | C.Eccall _ _ _ _ -> node
+    | C.Eproc _ _ _ -> node
+    | C.Eunseq expressions -> C.Eunseq (vla_capture_local_list labels captured expressions)
+    | C.Ewseq pattern left right -> C.Ewseq pattern (vla_capture_local labels captured left) (vla_capture_local labels captured right)
+    | C.Esseq pattern left right -> C.Esseq pattern (vla_capture_local labels captured left) (vla_capture_local labels captured right)
+    | C.Ebound body -> C.Ebound (vla_capture_local labels captured body)
+    | C.Eindivisible region body -> C.Eindivisible region (vla_capture_local labels captured body)
+    | C.End expressions -> C.End (vla_capture_local_list labels captured expressions)
+    | C.Esave label arguments body ->
+        C.Esave label
+          (if List.elem (fst label) labels then arguments ++ saved else arguments)
+          (vla_capture_local labels captured body)
+    | C.Erun annotation label arguments -> C.Erun annotation label (if List.elem label labels then arguments ++ passed else arguments)
+    | C.Epar expressions -> C.Epar (vla_capture_local_list labels captured expressions)
+    | C.Ewait _ -> node
+    | C.Eannot annotations body -> C.Eannot annotations (vla_capture_local labels captured body)
+    | C.Eexcluded _ _ -> node
+  end
+
+and vla_capture_local_alternatives labels captured alternatives =
+  match alternatives with
+    | [] -> []
+    | (pattern, body) :: rest ->
+        (pattern, vla_capture_local labels captured body) :: vla_capture_local_alternatives labels captured rest
+  end
+
+and vla_capture_local_list labels captured expressions =
+  match expressions with
+    | [] -> []
+    | expression :: rest -> vla_capture_local labels captured expression :: vla_capture_local_list labels captured rest
+  end
+
+declare {lean} termination_argument vla_capture_local = automatic
+declare {lean} termination_argument vla_capture_local_node = automatic
+declare {lean} termination_argument vla_capture_local_alternatives = automatic
+declare {lean} termination_argument vla_capture_local_list = automatic
+
+val vla_capture_scope: list Symbol.sym -> C.expr unit -> C.expr unit
+let vla_capture_scope bounds body =
+  let labels = List.map fst (Map_extra.toList (Caux.collect_saves body)) in
+  vla_capture_local labels (List.map (fun symbol -> (symbol, C.BTy_object C.OTy_integer)) bounds) body
diff --git a/frontend/model/vla_scopes.lem b/frontend/model/vla_scopes.lem
new file mode 100644
index 00000000..a822f0be
--- /dev/null
+++ b/frontend/model/vla_scopes.lem
@@ -0,0 +1,327 @@
+(* Declaration-scope lowering for AilSvla_scope.
+   Cabs creates one marker for each complete variably modified declarator;
+   this pass attaches the remaining lexical sequence to that marker. *)
+open import Pervasives
+import AilSyntax Ctype Symbol Loc Vla_types
+module A = AilSyntax
+
+val vla_declaration_symbols: forall 'a. A.statement 'a -> list Symbol.sym
+let vla_declaration_symbols declaration = match declaration.A.node with
+  | A.AilSdeclaration entries -> List.map fst entries
+  | A.AilSskip -> []
+  | _ -> []
+end
+
+let vla_is_declaration_fragment statement = match statement.A.node with
+  | A.AilSdeclaration _ -> true
+  | A.AilSskip -> true
+  | A.AilSvla_scope _ _ _ declaration -> match declaration.A.node with
+      | A.AilSdeclaration _ -> true
+      | A.AilSskip -> true
+      | _ -> false
+    end
+  | _ -> false
+end
+
+let vla_is_raw_scope statement = match statement.A.node with
+  | A.AilSvla_scope _ _ _ declaration -> vla_is_declaration_fragment declaration
+  | _ -> false
+end
+
+(* A labeled declaration's scope begins after the label, so a jump to that
+   label evaluates the declaration normally. A jump to any label later in the
+   attached remainder is checked against the explicit scope path. *)
+val vla_attach_declaration_tail:
+  forall 'a. A.bindings -> A.statement 'a -> list (A.statement 'a) ->
+  maybe (A.statement 'a)
+val vla_attach_fragments:
+  forall 'a. A.bindings -> list (A.statement 'a) -> list (A.statement 'a) -> list (A.statement 'a)
+let rec vla_attach_declaration_tail bindings stmt tail =
+  match stmt.A.node with
+    | A.AilSvla_scope identity captures checked declaration ->
+        let declared = vla_declaration_symbols declaration in
+        let moved = List.filter (fun (sym, (_, _, _, ty)) ->
+          List.elem sym declared && Vla_types.vla_has_runtime_extent ty) bindings in
+        let body = <| declaration with A.node= A.AilSblock moved (declaration :: tail) |> in
+        Just <| stmt with A.node= A.AilSvla_scope identity captures checked body |>
+    | A.AilSblock [] fragments ->
+        (* A labeled multi-declarator declaration retains this synthetic block
+           instead of passing through the block flattener. Source blocks have
+           already attached each scope to its own synthetic body, so they do
+           not satisfy the raw-declaration predicate. *)
+        if List.any vla_is_raw_scope fragments && List.all vla_is_declaration_fragment fragments then
+          Just <| stmt with A.node= A.AilSblock []
+            (vla_attach_fragments bindings fragments tail) |>
+        else Nothing
+    | A.AilSlabel label child annotation ->
+        Maybe.map (fun child -> <| stmt with A.node= A.AilSlabel label child annotation |>)
+          (vla_attach_declaration_tail bindings child tail)
+    | A.AilScase value child ->
+        Maybe.map (fun child -> <| stmt with A.node= A.AilScase value child |>)
+          (vla_attach_declaration_tail bindings child tail)
+    | A.AilScase_rangeGNU low high child ->
+        Maybe.map (fun child -> <| stmt with A.node= A.AilScase_rangeGNU low high child |>)
+          (vla_attach_declaration_tail bindings child tail)
+    | A.AilSdefault child ->
+        Maybe.map (fun child -> <| stmt with A.node= A.AilSdefault child |>)
+          (vla_attach_declaration_tail bindings child tail)
+    | A.AilSmarker marker child ->
+        Maybe.map (fun child -> <| stmt with A.node= A.AilSmarker marker child |>)
+          (vla_attach_declaration_tail bindings child tail)
+    | _ -> Nothing
+  end
+
+and vla_attach_fragments bindings fragments tail = match fragments with
+  | [] -> tail
+  | fragment :: rest ->
+      let remainder = vla_attach_fragments bindings rest tail in
+      (match vla_attach_declaration_tail bindings fragment remainder with
+        | Just scoped -> [scoped]
+        | Nothing -> fragment :: remainder
+      end)
+end
+
+val vla_scope_sequence: forall 'a. A.bindings -> list (A.statement 'a) -> list (A.statement 'a)
+let vla_scope_sequence bindings statements =
+  vla_attach_fragments bindings statements []
+
+val vla_scope_block:
+  forall 'a. A.bindings -> list (A.statement 'a) -> A.bindings * list (A.statement 'a)
+let vla_scope_block bindings statements =
+  (List.filter (fun (_, (_, _, _, ty)) -> not (Vla_types.vla_has_runtime_extent ty)) bindings,
+   vla_scope_sequence bindings statements)
+
+(* A target is legal only when its VM declaration-scope path is an ancestor
+   of the source path. Equality admits internal jumps; an empty target path
+   admits an outward jump. A new scope suffix can never be entered by goto or
+   switch dispatch. Unique symbols, not source locations, identify scopes. *)
+val vla_scope_path_prefix: list Symbol.sym -> list Symbol.sym -> bool
+let rec vla_scope_path_prefix target source = match (target, source) with
+  | ([], _) -> true
+  | (t :: ts, s :: ss) -> t = s && vla_scope_path_prefix ts ss
+  | _ -> false
+end
+
+(* The caller must collect label/source paths with a complete expression and
+   statement visitor, including GNU statement-expression bodies. This helper
+   does not infer that a missing label or unknown entry is safe. *)
+val vla_jump_path_valid:
+  list (Symbol.sym * list Symbol.sym) -> list Symbol.sym -> Symbol.sym -> bool
+let vla_jump_path_valid labels source target = match List.lookup target labels with
+  | Nothing -> false
+  | Just path -> vla_scope_path_prefix path source
+end
+
+type vla_control_error =
+  | Vla_jump_entry of Loc.t
+  | Vla_switch_entry of Loc.t
+  | Vla_missing_label of Loc.t
+
+type vla_control_census = <|
+  vla_labels: list (Symbol.sym * list Symbol.sym);
+  vla_jumps: list (Loc.t * Symbol.sym * list Symbol.sym);
+  vla_case_entries: list (Loc.t * list Symbol.sym * list Symbol.sym);
+|>
+
+let vla_empty_census = <| vla_labels= []; vla_jumps= []; vla_case_entries= [] |>
+
+let vla_merge_census first second = <|
+  vla_labels= first.vla_labels ++ second.vla_labels;
+  vla_jumps= first.vla_jumps ++ second.vla_jumps;
+  vla_case_entries= first.vla_case_entries ++ second.vla_case_entries;
+|>
+
+val vla_scan_expression:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> A.expression 'a -> vla_control_census
+val vla_scan_statement:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> A.statement 'a -> vla_control_census
+val vla_scan_expressions:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> list (A.expression 'a) -> vla_control_census
+val vla_scan_statements:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> list (A.statement 'a) -> vla_control_census
+val vla_scan_associations:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> list (A.generic_association 'a) -> vla_control_census
+val vla_scan_optional:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> maybe (A.expression 'a) -> vla_control_census
+val vla_scan_optionals:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> list (maybe (A.expression 'a)) -> vla_control_census
+val vla_scan_fields:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> list (Symbol.identifier * maybe (A.expression 'a)) -> vla_control_census
+val vla_scan_captures:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> list (Symbol.sym * A.expression 'a) -> vla_control_census
+val vla_scan_declarations:
+  forall 'a. list Symbol.sym -> maybe (list Symbol.sym) -> list (Symbol.sym * maybe (A.expression 'a)) -> vla_control_census
+
+(* This census is deliberately complete, including embedded GNU statement
+   expressions and unevaluated syntax. It never certifies entry safety from a
+   statement-only search that could miss a second goto in an expression. *)
+let rec vla_scan_expression path switch e =
+  let A.AnnotatedExpression _ _ _ node = e in
+  let self = vla_scan_expression path switch in
+  let merge = vla_merge_census in
+  let optional = vla_scan_optional path switch in
+  match node with
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> merge (self left) (self right)
+    | A.AilEassign left right -> merge (self left) (self right)
+    | A.AilEcompoundAssign left _ right -> merge (self left) (self right)
+    | A.AilEcond test yes no -> merge (self test) (merge (optional yes) (self no))
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEcall callee arguments -> merge (self callee) (vla_scan_expressions path switch arguments)
+    | A.AilEassert operand -> self operand
+    | A.AilEoffsetof _ _ -> vla_empty_census
+    | A.AilEgeneric control _ associations ->
+        merge (self control) (vla_scan_associations path switch associations)
+    | A.AilEarray _ _ values -> vla_scan_optionals path switch values
+    | A.AilEstruct _ values -> vla_scan_fields path switch values
+    | A.AilEunion _ _ value -> optional value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEbuiltin _ -> vla_empty_census
+    | A.AilEstr _ -> vla_empty_census
+    | A.AilEconst _ -> vla_empty_census
+    | A.AilEident _ -> vla_empty_census
+    | A.AilEsizeof _ _ -> vla_empty_census
+    | A.AilEsizeof_expr operand -> self operand
+    | A.AilEalignof _ _ -> vla_empty_census
+    | A.AilEannot _ operand -> self operand
+    | A.AilEva_start operand _ -> self operand
+    | A.AilEva_arg operand _ -> self operand
+    | A.AilEva_copy left right -> merge (self left) (self right)
+    | A.AilEva_end operand -> self operand
+    | A.AilEprint_type operand -> self operand
+    | A.AilEbmc_assume operand -> self operand
+    | A.AilEreg_load _ -> vla_empty_census
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEatomic operand -> self operand
+    | A.AilEgcc_statement _ statements -> vla_scan_statements path switch statements
+    | A.AilEinvalid _ _ -> vla_empty_census
+  end
+
+and vla_scan_statement path switch stmt =
+  let self = vla_scan_statement path switch in
+  let expr = vla_scan_expression path switch in
+  let merge = vla_merge_census in
+  let case_entry census = merge
+    (match switch with
+      | Nothing -> vla_empty_census (* ordinary switch-context typing rejects it *)
+      | Just source -> <| vla_empty_census with vla_case_entries= [(stmt.A.loc, source, path)] |>
+    end) census in
+  match stmt.A.node with
+    | A.AilSskip -> vla_empty_census
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> vla_scan_statements path switch statements
+    | A.AilSvla_scope identity captures _ body ->
+        merge (vla_scan_captures path switch captures)
+          (vla_scan_statement (path ++ [identity]) switch body)
+    | A.AilSif test yes no -> merge (expr test) (merge (self yes) (self no))
+    | A.AilSwhile test body _ -> merge (expr test) (self body)
+    | A.AilSdo body test _ -> merge (self body) (expr test)
+    | A.AilSbreak -> vla_empty_census
+    | A.AilScontinue -> vla_empty_census
+    | A.AilSreturnVoid -> vla_empty_census
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch test body -> merge (expr test) (vla_scan_statement path (Just path) body)
+    | A.AilScase _ body -> case_entry (self body)
+    | A.AilScase_rangeGNU _ _ body -> case_entry (self body)
+    | A.AilSdefault body -> case_entry (self body)
+    | A.AilSlabel label body _ -> merge <| vla_empty_census with vla_labels= [(label, path)] |> (self body)
+    | A.AilSgoto label -> <| vla_empty_census with vla_jumps= [(stmt.A.loc, label, path)] |>
+    | A.AilSdeclaration entries -> vla_scan_declarations path switch entries
+    | A.AilSpar statements -> vla_scan_statements path switch statements
+    | A.AilSreg_store _ operand -> expr operand
+    | A.AilSmarker _ body -> self body
+  end
+
+and vla_scan_expressions path switch expressions = match expressions with
+  | [] -> vla_empty_census
+  | expression :: rest -> vla_merge_census (vla_scan_expression path switch expression)
+      (vla_scan_expressions path switch rest)
+end
+
+and vla_scan_statements path switch statements = match statements with
+  | [] -> vla_empty_census
+  | statement :: rest -> vla_merge_census (vla_scan_statement path switch statement)
+      (vla_scan_statements path switch rest)
+end
+
+and vla_scan_associations path switch associations = match associations with
+  | [] -> vla_empty_census
+  | A.AilGAtype _ _ expression :: rest ->
+      vla_merge_census (vla_scan_expression path switch expression)
+        (vla_scan_associations path switch rest)
+  | A.AilGAdefault expression :: rest ->
+      vla_merge_census (vla_scan_expression path switch expression)
+        (vla_scan_associations path switch rest)
+end
+
+and vla_scan_optional path switch operand = match operand with
+  | Nothing -> vla_empty_census
+  | Just expression -> vla_scan_expression path switch expression
+end
+
+and vla_scan_optionals path switch operands = match operands with
+  | [] -> vla_empty_census
+  | operand :: rest -> vla_merge_census (vla_scan_optional path switch operand)
+      (vla_scan_optionals path switch rest)
+end
+
+and vla_scan_fields path switch fields = match fields with
+  | [] -> vla_empty_census
+  | (_, operand) :: rest -> vla_merge_census (vla_scan_optional path switch operand)
+      (vla_scan_fields path switch rest)
+end
+
+and vla_scan_captures path switch captures = match captures with
+  | [] -> vla_empty_census
+  | (_, expression) :: rest -> vla_merge_census (vla_scan_expression path switch expression)
+      (vla_scan_captures path switch rest)
+end
+
+and vla_scan_declarations path switch decls = match decls with
+  | [] -> vla_empty_census
+  | (_, operand) :: rest -> vla_merge_census (vla_scan_optional path switch operand)
+      (vla_scan_declarations path switch rest)
+end
+
+val vla_control_errors: forall 'a. A.statement 'a -> list vla_control_error
+let vla_control_errors body =
+  let census = vla_scan_statement [] Nothing body in
+  List.concat (List.map (fun (loc, label, source) -> match List.lookup label census.vla_labels with
+      | Nothing -> [Vla_missing_label loc]
+      | Just target -> if vla_scope_path_prefix target source then [] else [Vla_jump_entry loc]
+    end) census.vla_jumps) ++
+  List.concat (List.map (fun (loc, source, target) ->
+    if vla_scope_path_prefix target source then [] else [Vla_switch_entry loc]) census.vla_case_entries)
+
+(* The recursive calls cross statement/list boundaries. Use derived AIL sizes;
+   the list's extra step covers its empty-list base case. The Lean proof module
+   proves the sentinels unreachable from the public wrappers. *)
+declare {lean} fuel val vla_attach_declaration_tail = `fuelExhausted none`
+declare {lean} fuel val vla_attach_fragments = `fuelExhausted []`
+declare {lean} fuel_measure val vla_attach_declaration_tail = `lemSize stmt`
+declare {lean} fuel_measure val vla_attach_fragments = `expression_.lemSize_aux6 fragments + 1`
+declare {lean} termination_argument vla_scope_path_prefix = automatic
+declare {lean} fuel val vla_scan_expression = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_statement = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_expressions = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_statements = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_associations = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_optional = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_optionals = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_fields = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_captures = `fuelExhausted vla_empty_census`
+declare {lean} fuel val vla_scan_declarations = `fuelExhausted vla_empty_census`
+declare {lean} fuel_measure val vla_scan_expression = `lemSize e`
+declare {lean} fuel_measure val vla_scan_statement = `lemSize stmt`
+declare {lean} fuel_measure val vla_scan_expressions = `expression_.lemSize_aux2 expressions + 1`
+declare {lean} fuel_measure val vla_scan_statements = `expression_.lemSize_aux6 statements + 1`
+declare {lean} fuel_measure val vla_scan_associations = `expression_.lemSize_aux3 associations + 1`
+declare {lean} fuel_measure val vla_scan_optional = `expression_.lemSize_aux1 operand + 1`
+declare {lean} fuel_measure val vla_scan_optionals = `expression_.lemSize_aux4 operands + 1`
+declare {lean} fuel_measure val vla_scan_fields = `expression_.lemSize_aux5 fields + 1`
+declare {lean} fuel_measure val vla_scan_captures = `expression_.lemSize_aux7 captures + 1`
+declare {lean} fuel_measure val vla_scan_declarations = `expression_.lemSize_aux8 decls1 + 1`
diff --git a/frontend/model/vla_types.lem b/frontend/model/vla_types.lem
new file mode 100644
index 00000000..92250d7a
--- /dev/null
+++ b/frontend/model/vla_types.lem
@@ -0,0 +1,213 @@
+(* Shared source-type instantiation and checked runtime layout.
+   A bound symbol denotes one captured mathematical integer in one activation;
+   this module never evaluates a C expression or reads a C object. *)
+open import Pervasives
+import Ctype Symbol Loc Implementation Map_extra
+
+type vla_resolution_error =
+  | Vla_missing_capture of Symbol.sym
+  | Vla_nonpositive_extent of Symbol.sym * integer
+  | Vla_unresolved_function_type
+  | Vla_unsupported_extent_layout
+  | Vla_extent_size_overflow
+
+val vla_unique_symbols: list Symbol.sym -> list Symbol.sym
+let vla_unique_symbols symbols = List.foldl (fun acc sym ->
+  if List.elem sym acc then acc else acc ++ [sym]) [] symbols
+
+val vla_type_symbols: Ctype.ctype -> list Symbol.sym
+val vla_parameter_symbols: list (Ctype.qualifiers * Ctype.ctype * bool) -> list Symbol.sym
+let rec vla_type_symbols (Ctype.Ctype _ node) = match node with
+  | Ctype.VariableArray element bound ->
+      vla_unique_symbols (vla_type_symbols element ++ [bound])
+  | Ctype.Array element _ -> vla_type_symbols element
+  | Ctype.Pointer _ element -> vla_type_symbols element
+  | Ctype.Atomic element -> vla_type_symbols element
+  | Ctype.Function (_, result) parameters _ ->
+      vla_unique_symbols (vla_type_symbols result ++ vla_parameter_symbols parameters)
+  | Ctype.FunctionNoParams (_, result) -> vla_type_symbols result
+  | _ -> []
+end
+
+and vla_parameter_symbols parameters = match parameters with
+  | [] -> []
+  | (_, ty, _) :: rest -> vla_type_symbols ty ++ vla_parameter_symbols rest
+end
+
+val vla_has_runtime_extent: Ctype.ctype -> bool
+let vla_has_runtime_extent ty = not (List.null (vla_type_symbols ty))
+
+(* One immutable captured environment is used recursively. In particular this
+   must not consult the current value of the source variable in a bound like n.
+   Array annotations and pointer qualifiers survive instantiation verbatim.
+   Function types need separate prototype/definition compatibility semantics;
+   caller code cannot resolve a callee's parameter-bound symbols. *)
+val vla_instantiate_type:
+  list (Symbol.sym * integer) -> Ctype.ctype -> either vla_resolution_error Ctype.ctype
+let rec vla_instantiate_type captures (Ctype.Ctype annotations node as ty) =
+  let wrap constructor outcome = match outcome with
+    | Left problem -> Left problem
+    | Right resolved -> Right (Ctype.Ctype annotations (constructor resolved))
+  end in
+  match node with
+    | Ctype.VariableArray element bound ->
+        (match List.lookup bound captures with
+          | Nothing -> Left (Vla_missing_capture bound)
+          | Just count ->
+              if count <= 0 then Left (Vla_nonpositive_extent bound count)
+              else wrap (fun resolved -> Ctype.Array resolved (Just count))
+                (vla_instantiate_type captures element)
+        end)
+    | Ctype.Array element count -> wrap (fun resolved -> Ctype.Array resolved count)
+        (vla_instantiate_type captures element)
+    | Ctype.Pointer qualifiers element -> wrap (Ctype.Pointer qualifiers)
+        (vla_instantiate_type captures element)
+    | Ctype.Atomic element -> wrap Ctype.Atomic (vla_instantiate_type captures element)
+    | Ctype.Function _ _ _ ->
+        if vla_has_runtime_extent ty then Left Vla_unresolved_function_type else Right ty
+    | Ctype.FunctionNoParams _ ->
+        if vla_has_runtime_extent ty then Left Vla_unresolved_function_type else Right ty
+    | _ -> Right ty
+  end
+
+(* Bounds are already evaluated and validated at their declarators. This zip
+   only binds a Core constructor's ordered integer arguments to template keys;
+   it rejects missing/extra operands instead of guessing or truncating. *)
+val vla_bind_type_operands:
+  Ctype.ctype -> list integer -> maybe (list (Symbol.sym * integer))
+let vla_bind_type_operands ty values =
+  let symbols = vla_type_symbols ty in
+  if List.length symbols <> List.length values then Nothing
+  else Just (List.zip symbols values)
+
+(* A finite by-value dependency closure guards the memory layout oracle. This
+   is shared with compile-time scalar analysis: pointer pointees do not affect
+   pointer layout, while alignment-type and flexible-tail dependencies do. *)
+val vla_layout_ready: list Symbol.sym -> Ctype.ctype -> bool
+let rec vla_layout_ready known (Ctype.Ctype _ node) = match node with
+  | Ctype.Basic (Ctype.Integer ity) ->
+      maybe false (fun n -> n > 0) (Implementation.sizeof_ity ity) &&
+      maybe false (fun n -> n > 0) (Implementation.alignof_ity ity)
+  | Ctype.Basic (Ctype.Floating fty) ->
+      maybe false (fun n -> n > 0) (Implementation.sizeof_fty fty) &&
+      maybe false (fun n -> n > 0) (Implementation.alignof_fty fty)
+  | Ctype.Pointer _ _ ->
+      maybe false (fun n -> n > 0) Implementation.sizeof_pointer &&
+      maybe false (fun n -> n > 0) Implementation.alignof_pointer
+  | Ctype.Nullptr ->
+      maybe false (fun n -> n > 0) Implementation.sizeof_pointer &&
+      maybe false (fun n -> n > 0) Implementation.alignof_pointer
+  | Ctype.Byte -> true
+  | Ctype.Array element (Just count) -> count >= 0 && vla_layout_ready known element
+  | Ctype.Atomic element -> vla_layout_ready known element
+  | Ctype.Struct tag -> List.elem tag known
+  | Ctype.Union tag -> List.elem tag known
+  | _ -> false
+end
+
+val vla_layout_closure:
+  map Symbol.sym (Loc.t * Ctype.tag_definition) -> list Symbol.sym
+let vla_layout_closure tagDefs =
+  let member_dependencies members =
+    List.concat (List.map (fun (_, (_, align, _, member_ty)) ->
+      member_ty :: (match align with
+        | Just (Ctype.AlignType align_ty) -> [align_ty]
+        | _ -> []
+      end)) members) in
+  let supported_layout layout members =
+    maybe true Ctype.valid_gnu_amd64_tag_alignment layout.Ctype.minimum_alignment &&
+    List.all (fun (_, (_, align, _, _)) -> match align with
+      | Just (Ctype.AlignInteger n) -> Ctype.valid_gnu_amd64_tag_alignment n
+      | _ -> true
+    end) members in
+  let graph = List.map (fun (tag, (_, definition)) ->
+    let requirements = match definition with
+      | Ctype.StructDef layout members tail ->
+          let tail_dependencies = match tail with
+            | Just (Ctype.FlexibleArrayMember _ _ _ element) -> [element]
+            | Nothing -> []
+          end in
+          (supported_layout layout members, member_dependencies members ++ tail_dependencies)
+      | Ctype.UnionDef layout members ->
+          (supported_layout layout members, member_dependencies members)
+    end in
+    (tag, requirements)) (Map_extra.toList tagDefs) in
+  let include_ready_tag known (tag, (supported, dependencies)) =
+    if not supported || List.elem tag known ||
+       not (List.all (vla_layout_ready known) dependencies) then known
+    else tag :: known in
+  (* At most one pass per tag is needed to close a finite dependency chain.
+     Preserve graph order within each pass and the existing result order. *)
+  List.foldl (fun known _ -> List.foldl include_ready_tag known graph) [] graph
+
+val vla_checked_sizeof:
+  map Symbol.sym (Loc.t * Ctype.tag_definition) ->
+  (Ctype.ctype -> maybe integer) -> Ctype.ctype -> maybe integer
+let vla_checked_sizeof tagDefs oracle ty =
+  (* Types ready without record dependencies need no whole-table closure.
+     The same oracle and rejection boundary are retained for all other types. *)
+  if vla_layout_ready [] ty then oracle ty
+  else if vla_layout_ready (vla_layout_closure tagDefs) ty then oracle ty else Nothing
+
+val vla_check_size_limit:
+  (Ctype.ctype -> maybe integer) -> integer -> Ctype.ctype -> either vla_resolution_error unit
+let vla_check_size_limit sizeof maximum ty =
+  match sizeof ty with
+    | Nothing -> Left Vla_unsupported_extent_layout
+    | Just bytes ->
+        if bytes < 0 || maximum <= 0 then Left Vla_unsupported_extent_layout
+        else if bytes > maximum then Left Vla_extent_size_overflow
+        else Right ()
+  end
+
+(* Check every captured array extent, including arrays behind pointers. The
+   oracle returns an exact mathematical byte size, before size_t conversion.
+   Fixed/incomplete pointee types that introduce no VLA do not need a sizeof. *)
+val vla_check_extent_sizes:
+  (Ctype.ctype -> maybe integer) -> integer -> Ctype.ctype -> Ctype.ctype ->
+  either vla_resolution_error unit
+let rec vla_check_extent_sizes sizeof maximum (Ctype.Ctype _ source) (Ctype.Ctype _ concrete as ty) =
+  match (source, concrete) with
+    | (Ctype.VariableArray element _, Ctype.Array resolved _) ->
+        (match vla_check_extent_sizes sizeof maximum element resolved with
+          | Left problem -> Left problem
+          | Right () -> vla_check_size_limit sizeof maximum ty
+        end)
+    | (Ctype.Array element _, Ctype.Array resolved _) ->
+        (match vla_check_extent_sizes sizeof maximum element resolved with
+          | Left problem -> Left problem
+          | Right () ->
+              if vla_has_runtime_extent element then vla_check_size_limit sizeof maximum ty
+              else Right ()
+        end)
+    | (Ctype.Pointer _ element, Ctype.Pointer _ resolved) ->
+        vla_check_extent_sizes sizeof maximum element resolved
+    | (Ctype.Atomic element, Ctype.Atomic resolved) ->
+        vla_check_extent_sizes sizeof maximum element resolved
+    | _ -> Right ()
+  end
+
+val vla_instantiate_checked:
+  (Ctype.ctype -> maybe integer) -> integer -> list (Symbol.sym * integer) ->
+  Ctype.ctype -> either vla_resolution_error Ctype.ctype
+let vla_instantiate_checked sizeof maximum captures template =
+  match vla_instantiate_type captures template with
+    | Left problem -> Left problem
+    | Right concrete -> (match vla_check_extent_sizes sizeof maximum template concrete with
+        | Left problem -> Left problem
+        | Right () -> Right concrete
+      end)
+  end
+
+(* The mutual walk crosses from a CType node into its parameter list and back,
+   so Lean's default structural checker cannot see one common decreasing
+   argument. These derived-size measures bound every cross-call. The kernel-
+   checked stability proofs in Vla_types_lemMeasureProofs establish that the
+   fail-closed fuel sentinel is unreachable for every finite input. *)
+declare {lean} fuel val vla_type_symbols = `fuelExhausted []`
+declare {lean} fuel val vla_parameter_symbols = `fuelExhausted []`
+declare {lean} fuel_measure val vla_type_symbols = `ctype.lemSize c`
+declare {lean} fuel_measure val vla_parameter_symbols = `ctype_.lemSize_aux1 parameters + 1`
+declare {lean} termination_argument vla_instantiate_type = automatic
+declare {lean} termination_argument vla_layout_ready = automatic
+declare {lean} termination_argument vla_check_extent_sizes = automatic
