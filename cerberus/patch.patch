+structure Artifact where
+  schemaVersion : Nat
+  sourceBindingPath : String
+  sourceBindingSHA256 : String
+  translatorSHA256 : String
+  semanticSwitches : String
+  fieldNames : Array String
+  supply : Nat
+  executionDigest : String
+  orderedDigests : List String
+  linkedFunctionCount : Nat
+  linkedGlobalCount : Nat
+  snapshot : CerbCoreQuote.CoreSnapshot
+  deriving Lean.ToJson, Lean.FromJson
+
+structure Loaded where
+  coreFile : file Unit
+  supply : Nat
+  executionDigest : String
+  orderedDigests : List String
+  binding : CerbCoreQuote.LinkedBindingInputs
+
+/-- Emit a complete, executable linked Core DATA record. The source and
+translator identities are checked before and after serialization; the final
+path is replaced only after the new data is complete. -/
+def emit [CerbGlobal.Switches] (outputPath bindingPath : String)
+    (coreFile : file Unit) (supply : Nat) (executionDigest : String)
+    (orderedDigests : List String) : IO Unit := do
+  unless CerbGlobal.Switches.switches == [.gnu_pointer_conversions] do
+    throw <| IO.userError "runnable Core data requires GNU pointer conversions"
+  CerbCoreQuote.requireAbsolute outputPath
+  CerbCoreQuote.requireAbsolute bindingPath
+  let inputs ← CerbCoreQuote.verifyLinkedBinding bindingPath
+  let translatorPath := (← IO.appPath).toString
+  unless outputPath != bindingPath && outputPath != translatorPath &&
+      outputPath != inputs.libcCore &&
+      !(inputs.cabs ++ inputs.libcTus).contains outputPath do
+    throw <| IO.userError "runnable Core output overlaps a checked input"
+  unless orderedDigests.length == inputs.cabs.length &&
+      orderedDigests.length > 0 do
+    throw <| IO.userError "runnable Core digest count differs from source binding"
+  let snapshot ← (CerberusFresh.forceIO
+    (fun () => CerbCoreQuote.CoreSnapshot.fromFile coreFile) :
+      BaseIO CerbCoreQuote.CoreSnapshot)
+  unless (← (CerberusFresh.forceIO
+      (fun () => CerbCoreQuote.CoreSnapshot.dataRoundTrip coreFile) : BaseIO Bool)) do
+    throw <| IO.userError "runnable Core data round trip failed"
+  let translatorSHA ← CerbCoreQuote.hashFile "sha256sum" translatorPath 64
+  let artifact : Artifact := {
+    schemaVersion := 1
+    sourceBindingPath := bindingPath
+    sourceBindingSHA256 := inputs.bindingSHA256
+    translatorSHA256 := translatorSHA
+    semanticSwitches := "gnu_pointer_conversions"
+    fieldNames := CerbCoreQuote.linkedCoreFieldNames
+    supply
+    executionDigest
+    orderedDigests
+    linkedFunctionCount := snapshot.funs.length
+    linkedGlobalCount := snapshot.globs.length
+    snapshot
+  }
+  let temporary := outputPath ++ ".tmp"
+  let serialized ← (CerberusFresh.forceIO
+    (fun () => (Lean.toJson artifact).compress) : BaseIO String)
+  IO.FS.writeFile temporary serialized
+  let after ← CerbCoreQuote.verifyLinkedBinding bindingPath
+  unless after.bindingSHA256 == inputs.bindingSHA256 &&
+      (← CerbCoreQuote.hashFile "sha256sum" translatorPath 64) == translatorSHA do
+    throw <| IO.userError "runnable Core inputs changed during emission"
+  IO.FS.rename temporary outputPath
+
+/-- Load only a byte-identified artifact bound to the current C inputs and
+translator. No C frontend, linker, or quoted-expression elaboration runs. -/
+def load (bindingPath artifactPath expectedSHA256 : String) : IO Loaded := do
+  CerbCoreQuote.requireAbsolute bindingPath
+  CerbCoreQuote.requireAbsolute artifactPath
+  unless (← CerbCoreQuote.hashFile "sha256sum" artifactPath 64) == expectedSHA256 do
+    throw <| IO.userError "runnable Core artifact SHA-256 differs"
+  let inputs ← CerbCoreQuote.verifyLinkedBinding bindingPath
+  let raw ← IO.FS.readFile artifactPath
+  let json ← match Lean.Json.parse raw with
+    | .ok value => pure value
+    | .error error => throw <| IO.userError s!"runnable Core JSON parse failed: {error}"
+  let artifact : Artifact ← match Lean.fromJson? json with
+    | .ok value => pure value
+    | .error error => throw <| IO.userError s!"runnable Core decode failed: {error}"
+  let translatorSHA ← CerbCoreQuote.hashFile "sha256sum" (← IO.appPath).toString 64
+  unless artifact.schemaVersion == 1 &&
+      artifact.sourceBindingPath == bindingPath &&
+      artifact.sourceBindingSHA256 == inputs.bindingSHA256 &&
+      artifact.translatorSHA256 == translatorSHA &&
+      artifact.semanticSwitches == "gnu_pointer_conversions" &&
+      artifact.fieldNames == CerbCoreQuote.linkedCoreFieldNames &&
+      artifact.orderedDigests.length == inputs.cabs.length &&
+      artifact.orderedDigests.length > 0 &&
+      artifact.linkedFunctionCount == artifact.snapshot.funs.length &&
+      artifact.linkedGlobalCount == artifact.snapshot.globs.length do
+    throw <| IO.userError "runnable Core identity or field inventory differs"
+  unless (← CerbCoreQuote.hashFile "sha256sum" artifactPath 64) == expectedSHA256 do
+    throw <| IO.userError "runnable Core artifact changed while loading"
+  let coreFile ← (CerberusFresh.forceIO
+    (fun () => artifact.snapshot.toFile) : BaseIO (file Unit))
+  unless (← (CerberusFresh.forceIO
+      (fun () => CerbCoreQuote.CoreSnapshot.fromFile coreFile == artifact.snapshot) :
+      BaseIO Bool)) do
+    throw <| IO.userError "runnable Core decoded data changed during reconstruction"
+  return {
+    coreFile := coreFile
+    supply := artifact.supply
+    executionDigest := artifact.executionDigest
+    orderedDigests := artifact.orderedDigests
+    binding := inputs }
+
+end CerbCoreData
