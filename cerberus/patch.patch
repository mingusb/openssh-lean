+(* A by-value formal's member read denotes the corresponding actual value.
+   This does not authorize taking the address of the callee's copy. *)
+val gnu_record_actual_member:
+  A.expression GenTypes.genTypeCategory -> Symbol.identifier ->
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let gnu_record_actual_member actual ident
+    (A.AnnotatedExpression member_category member_annots member_loc _ as member)
+    (A.AnnotatedExpression category annots loc _ as result) =
+  let (qs, ty) = qualified_ctype_of member in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      not (gnu_record_argument_readonly actual) then Nothing else
+  let selected = match gnu_record_literal actual with
+    | Just (A.AnnotatedExpression _ _ _ (A.AilEstruct _ fields)) ->
+        (match List.lookup ident fields with | Just value -> value | Nothing -> Nothing end)
+    | _ -> match actual with
+        | A.AnnotatedExpression _ _ _ (A.AilErvalue operand) ->
+            Just (A.AnnotatedExpression category annots loc (A.AilErvalue
+              (A.AnnotatedExpression member_category member_annots member_loc
+                (A.AilEmemberof operand ident))))
+        | _ -> Nothing end
+  end in
+  maybe Nothing (fun value ->
+    if gnu_function_target_type_equal (ctype_of result) (ctype_of value) then Just value else
+      Just (A.AnnotatedExpression category annots loc
+        (A.AilEcast Ctype.no_qualifiers (ctype_of result) value))) selected
+
+val gnu_record_value_substitute:
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_record_value_substitute bindings (A.AnnotatedExpression category annots loc node as expr) =
+  let self = gnu_record_value_substitute bindings in
+  let rebuild node = A.AnnotatedExpression category annots loc node in
+  let unary make operand = maybe Nothing (fun value -> Just (rebuild (make value))) (self operand) in
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty then Nothing
+        else List.lookup sym bindings
+    | A.AilErvalue (A.AnnotatedExpression _ _ _
+        (A.AilEmemberof (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ident) as member) ->
+        (match List.lookup sym bindings with
+          | Just actual -> gnu_record_actual_member actual ident member expr
+          | Nothing -> Nothing end)
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty then Nothing
+        else unary (fun value -> A.AilErvalue value) operand
+    | A.AilEconst _ -> Just expr
+    | A.AilEstr _ -> Just expr
+    | A.AilEsizeof qs ty ->
+        if gnu_inline_fixed_object_type ty then Just expr else Nothing
+    | A.AilEsizeof_expr operand ->
+        if gnu_inline_fixed_object_type (ctype_of operand)
+        then Just (rebuild (A.AilEsizeof Ctype.no_qualifiers (ctype_of operand))) else Nothing
+    | A.AilEalignof _ ty -> if gnu_inline_fixed_object_type ty then Just expr else Nothing
+    | A.AilEoffsetof ty _ -> if gnu_inline_fixed_object_type ty then Just expr else Nothing
+    | A.AilEannot ty operand -> unary (fun value -> A.AilEannot ty value) operand
+    | A.AilEcast qs ty operand -> unary (fun value -> A.AilEcast qs ty value) operand
+    | A.AilEunary A.Address operand -> unary (fun value -> A.AilEunary A.Address value) operand
+    | A.AilEunary A.Indirection operand -> unary (fun value -> A.AilEunary A.Indirection value) operand
+    | A.AilEunary A.Plus operand -> unary (fun value -> A.AilEunary A.Plus value) operand
+    | A.AilEunary A.Minus operand -> unary (fun value -> A.AilEunary A.Minus value) operand
+    | A.AilEunary A.Bnot operand -> unary (fun value -> A.AilEunary A.Bnot value) operand
+    | A.AilEarray_decay operand -> unary (fun value -> A.AilEarray_decay value) operand
+    | A.AilEmemberof operand ident -> unary (fun value -> A.AilEmemberof value ident) operand
+    | A.AilEmemberofptr operand ident -> unary (fun value -> A.AilEmemberofptr value ident) operand
+    | A.AilEbinary left bop right -> (match (self left, self right) with
+        | (Just first, Just second) -> Just (rebuild (A.AilEbinary first bop second))
+        | _ -> Nothing end)
+    | A.AilEstruct tag fields ->
+        let values = List.foldr (fun (ident, value) acc -> match (value, acc) with
+          | (Nothing, Just rest) -> Just ((ident, Nothing) :: rest)
+          | (Just field_value, Just rest) -> maybe Nothing
+              (fun value -> Just ((ident, Just value) :: rest)) (self field_value)
+          | _ -> Nothing end) (Just []) fields in
+        maybe Nothing (fun fields -> Just (rebuild (A.AilEstruct tag fields))) values
+    | _ -> Nothing
+  end
