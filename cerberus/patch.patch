+val gnu_compiler_library_name: string -> bool
+let gnu_compiler_library_name name =
+  (match String.toCharList name with first :: _ -> first = #'_' | _ -> false end) ||
+  Set.member name gnu_compiler_library_names
+
+(* A direct external/noipa call is an opaque pointer boundary for GCC's
+   object-size query. Keep allocator-size attributes out of the unknown case:
+   those describe a compiler-visible extent and need their own argument-value
+   transport rather than an invented sentinel. *)
+val gnu_opaque_call_boundary:
+  A.expression GenTypes.genTypeCategory -> E.elabM (bool * Annot.attributes)
+let gnu_opaque_call_boundary callee =
+  (* A direct function designator may remain an AilEident at the call site;
+     gnu_inline_function_target handles its decayed and loaded-pointer forms. *)
+  let direct = match callee with
+    | A.AnnotatedExpression _ _ _ (A.AilEident sym) ->
+        if AilTypesAux.is_function (ctype_of callee) then Just (sym, ctype_of callee) else Nothing
+    | _ -> Nothing
+  end in
+  let target = match direct with
+    | Just _ -> E.return direct
+    | Nothing -> gnu_inline_function_target callee
+  end in
+  target >>= function
+    | Nothing -> E.return (false, Annot.no_attributes)
+    | Just (declared, _) ->
+        E.gnu_inline_target declared >>= fun target ->
+        E.gnu_has_source_definition target >>= fun defined ->
+        gnu_call_attributes callee >>= fun attrs ->
+        E.return (not defined || Cerb_attributes.has_gnu_noarg_attribute "noipa" attrs, attrs)
+  end
+
+(* Take immutable compiler snapshots before the runtime store executes. Only
+   closed facts survive; a failed capture stays absent, never becomes unknown. *)
+val gnu_memory_expression_readonly: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_memory_expression_readonly (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_memory_expression_readonly in
+  match node with
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) [_] -> true
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_va_arg_pack_len)) [] -> true
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_object_size false _))) [_] -> true
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_object_size true _))) [operand] ->
+        gnu_size_effects operand = Just false
+    | A.AilEstruct _ members -> List.all (fun (_, value) -> maybe true self value) members
+    | A.AilEunion _ _ value -> maybe true self value
+    | A.AilEarray _ _ values -> List.all (maybe true self) values
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEcond test yes no -> self test && maybe true self yes && self no
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.PostfixIncr _ -> false
+    | A.AilEunary A.PostfixDecr _ -> false
+    | A.AilEunary _ operand -> self operand
+    | _ -> gnu_size_effects expr = Just false
+  end
+
+(* Stores to nonescaping lexical automatic objects are private to a call.
+   This lvalue check excludes dereferences, arrays through pointers and unions
+   reached through caller storage. It is not a result-value summary. *)
+val gnu_readonly_local_lvalue:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_readonly_local_lvalue locals (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && match node with
+    | A.AilEident sym -> List.elem sym locals
+    | A.AilEmemberof base _ -> gnu_readonly_local_lvalue locals base
+    | A.AilEmemberofptr (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address base)) _ ->
+        gnu_readonly_local_lvalue locals base
+    | A.AilEunary A.Indirection (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address base)) ->
+        gnu_readonly_local_lvalue locals base
+    | A.AilEannot _ base -> gnu_readonly_local_lvalue locals base
+    | _ -> false
+  end
+
+val gnu_readonly_local_expression:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_readonly_local_expression locals (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_memory_expression_readonly expr then true else match node with
+    | A.AilEassign left right -> gnu_readonly_local_lvalue locals left &&
+        gnu_memory_expression_readonly right
+    | A.AilEcompoundAssign left _ right -> gnu_readonly_local_lvalue locals left &&
+        gnu_memory_expression_readonly right
+    | A.AilEunary A.PostfixIncr left -> gnu_readonly_local_lvalue locals left
+    | A.AilEunary A.PostfixDecr left -> gnu_readonly_local_lvalue locals left
+    | A.AilEbinary left A.Comma right ->
+        gnu_readonly_local_expression locals left && gnu_readonly_local_expression locals right
+    | A.AilEannot _ child -> gnu_readonly_local_expression locals child
+    | _ -> false
+  end
+
+(* This certificate says only that a visible call does not write caller memory.
+   It never removes the call or infers a return value. Calls and hidden effects
+   inside the body remain outside the certificate; declaration stores must name
+   the body's own fixed automatic objects. *)
+val gnu_readonly_call_body:
+  list Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_readonly_call_body locals stmt =
+  let self = gnu_readonly_call_body locals in
+  let expr = gnu_memory_expression_readonly in
+  match stmt.A.node with
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> gnu_readonly_local_expression locals operand
+    | A.AilSreturn operand -> expr operand
+    | A.AilSreturnVoid -> true
+    | A.AilSdeclaration declarations -> List.all (fun (sym, value) ->
+        List.elem sym locals && maybe true expr value) declarations
+    | A.AilSblock bindings statements ->
+        List.all (function
+          | (_, ((_, A.Automatic, _), _, qs, ty)) ->
+              not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings &&
+        List.all (gnu_readonly_call_body (List.map fst bindings ++ locals)) statements
+    | A.AilSif test yes no -> expr test && self yes && self no
+    | A.AilSwhile test body _ -> expr test && self body
+    | A.AilSdo body test _ -> self body && expr test
+    | A.AilSswitch test body -> expr test && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+(* Verify nested visible calls without assuming recursion or a missing body is
+   readonly. This is effect metadata only; every original call still executes. *)
+val gnu_memory_certified_readonly_seen:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+val gnu_readonly_transitive_body:
+  list Symbol.sym -> list Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_memory_certified_readonly_seen visited (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_memory_certified_readonly_seen visited in
+  let every operands = E.foldlM (fun ok operand -> if ok then self operand else E.return false) true operands in
+  if gnu_memory_expression_readonly expr then E.return true else match node with
+    | A.AilEcall callee args ->
+        gnu_call_attributes callee >>= fun attrs ->
+        if Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs
+        then E.return false else
+        (* The complete aggregate summary checks every returned field and
+           every actual, not merely the member selected by a caller. It also
+           excludes escaping callee locals and hidden calls. This handles
+           by-value record construction without declaring arbitrary compound
+           literal storage writes readonly. *)
+        gnu_record_call_value expr >>= fun record_value ->
+        if maybe false gnu_record_argument_readonly record_value then E.return true else
+        if not (gnu_inline_direct_designator callee) then E.return false else
+        every args >>= fun readonly ->
+        if not readonly then E.return false else
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) ->
+              if Cerb_attributes.has_gnu_noarg_attribute "const" attrs ||
+                  Cerb_attributes.has_gnu_noarg_attribute "pure" attrs
+              then E.return true else
+              E.gnu_inline_target declared >>= fun target ->
+              E.gnu_memory_call_body target >>= function
+                | Just (params, body) ->
+                    if List.length params <> List.length args || List.elem target visited
+                    then E.return false else
+                    (if gnu_readonly_call_body [] body then E.return true else
+                      gnu_readonly_transitive_body (target :: visited) [] body) >>= fun readonly ->
+                    let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                      "GNU readonly visible call " ^ show target ^ "; certified=" ^ show readonly) in
+                    E.return readonly
+                | Nothing -> E.return false
               end
-          end
+        end
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEbinary left _ right -> every [left; right]
+    | A.AilEcond test yes no -> every (test :: no :: maybe [] (fun value -> [value]) yes)
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEunary A.Address operand -> self operand
+    | A.AilEunary A.Indirection operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty then E.return false else self operand
+    | _ -> E.return false
+  end
+
+and gnu_readonly_transitive_body visited locals stmt =
+  let self = gnu_readonly_transitive_body visited locals in
+  let expression (A.AnnotatedExpression _ _ _ node as expr) =
+    if gnu_readonly_local_expression locals expr then E.return true else match node with
+      | A.AilEassign left right -> if gnu_readonly_local_lvalue locals left
+          then gnu_memory_certified_readonly_seen visited right else E.return false
+      | A.AilEcompoundAssign left _ right -> if gnu_readonly_local_lvalue locals left
+          then gnu_memory_certified_readonly_seen visited right else E.return false
+      | _ -> gnu_memory_certified_readonly_seen visited expr end in
+  match stmt.A.node with
+    | A.AilSskip -> E.return true
+    | A.AilSexpr operand -> expression operand
+    | A.AilSreturn operand -> expression operand
+    | A.AilSreturnVoid -> E.return true
+    | A.AilSdeclaration declarations -> E.foldlM (fun ok (sym, value) ->
+        if not ok || not (List.elem sym locals) then E.return false else
+        maybe (E.return true) expression value) true declarations
+    | A.AilSblock bindings statements ->
+        if not (List.all (function
+          | (_, ((_, A.Automatic, _), _, qs, ty)) -> not qs.Ctype.volatile &&
+              not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings) then E.return false else
+        E.foldlM (fun ok child -> if ok then
+          gnu_readonly_transitive_body visited (List.map fst bindings ++ locals) child
+          else E.return false) true statements
+    | A.AilSif test yes no -> expression test >>= fun ok ->
+        if not ok then E.return false else self yes >>= fun ok ->
+        if ok then self no else E.return false
+    | A.AilSwhile test body _ -> expression test >>= fun ok -> if ok then self body else E.return false
+    | A.AilSdo body test _ -> self body >>= fun ok -> if ok then expression test else E.return false
+    | A.AilSswitch test body -> expression test >>= fun ok -> if ok then self body else E.return false
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> E.return true
+    | A.AilSbreak -> E.return true
+    | A.AilScontinue -> E.return true
+    | A.AilSmarker _ body -> self body
+    | _ -> E.return false
+  end
+
+val gnu_memory_certified_readonly:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_memory_certified_readonly expr = gnu_memory_certified_readonly_seen [] expr
+
+(* A positive compiler boundary: a direct external non-builtin body is
+   unavailable to value-flow analysis. No result or memory value is inferred. *)
+val gnu_ordinary_opaque_memory_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_ordinary_opaque_memory_call callee =
+  if not (gnu_inline_direct_designator callee) then E.return false else
+  gnu_inline_function_target callee >>= function
+    | Nothing -> E.return false
+    | Just (declared, _) ->
+        E.gnu_inline_target declared >>= fun target ->
+        E.gnu_has_source_definition target >>= fun defined ->
+        gnu_call_attributes callee >>= fun attrs ->
+        let noipa = Cerb_attributes.has_gnu_noarg_attribute "noipa" attrs in
+        E.linker_name declared >>= fun name ->
+        E.return ((not defined || noipa) &&
+          maybe noipa (fun name -> not (gnu_compiler_library_name name)) name)
+  end
+
+(* The standard deallocator changes allocation lifetime, not the values of
+   surviving C objects. This is deliberately separate from readonly calls and
+   opaque calls: runtime free is retained and no unknown result is invented.
+   Reject definitions/interposition within the TU, indirect targets, changed
+   signatures and effectful argument evaluation. *)
+val gnu_standard_free_call: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_standard_free_call (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcall callee [actual] ->
+      if not (gnu_inline_direct_designator callee && gnu_memory_expression_readonly actual)
+      then E.return false else
+      let signature_ok = match ctype_of callee with
+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function (_, result)
+            [(_, Ctype.Ctype _ (Ctype.Pointer pointed_qs pointed), _)] false))) ->
+            AilTypesAux.is_void result && AilTypesAux.is_void pointed &&
+              not pointed_qs.Ctype.volatile
+        | _ -> false end in
+      if not signature_ok then E.return false else
+      gnu_inline_function_target callee >>= function
+        | Nothing -> E.return false
+        | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+            E.gnu_has_source_definition target >>= fun defined ->
+            E.linker_name declared >>= fun name ->
+            E.return (not defined && name = Just "free")
+      end
+  | _ -> E.return false
+end
+
+(* Prove an unavailable-body boundary from a complete callable census, not
+   from failure to resolve the target. These coarse distinctions only establish
+   incompatible C function types; they never establish memory disjointness.
+   Unknown/no-prototype candidates conservatively prevent exclusion. *)
+val gnu_indirect_incompatible_type: Ctype.ctype -> Ctype.ctype -> bool
+let rec gnu_indirect_incompatible_type left right = match (left, right) with
+  | (Ctype.Ctype _ (Ctype.Pointer _ left_target), Ctype.Ctype _ (Ctype.Pointer _ right_target)) ->
+      gnu_indirect_incompatible_type left_target right_target
+  | (Ctype.Ctype _ Ctype.Void, Ctype.Ctype _ Ctype.Void) -> false
+  | (Ctype.Ctype _ Ctype.Void, _) -> true
+  | (_, Ctype.Ctype _ Ctype.Void) -> true
+  | (Ctype.Ctype _ (Ctype.Struct first), Ctype.Ctype _ (Ctype.Struct second)) -> first <> second
+  | (Ctype.Ctype _ (Ctype.Union first), Ctype.Ctype _ (Ctype.Union second)) -> first <> second
+  | (Ctype.Ctype _ (Ctype.Struct _), _) -> true
+  | (_, Ctype.Ctype _ (Ctype.Struct _)) -> true
+  | (Ctype.Ctype _ (Ctype.Union _), _) -> true
+  | (_, Ctype.Ctype _ (Ctype.Union _)) -> true
+  | _ ->
+      (AilTypesAux.is_pointer left && AilTypesAux.is_arithmetic right) ||
+      (AilTypesAux.is_arithmetic left && AilTypesAux.is_pointer right)
+end
+
+val gnu_indirect_candidate_incompatible:
+  Ctype.ctype -> Ctype.ctype -> bool
+let gnu_indirect_candidate_incompatible call_type candidate =
+  match (call_type, candidate) with
+    | (Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function (_, result) params false))),
+       Ctype.Ctype _ (Ctype.Function (_, other_result) other variadic)) ->
+        gnu_indirect_incompatible_type result other_result || variadic ||
+          List.length params <> List.length other ||
+          List.any (fun ((_, left, _), (_, right, _)) ->
+            gnu_indirect_incompatible_type left right) (List.zip params other)
+    | _ -> false
+  end
+
+val gnu_indirect_target_types_disjoint:
+  maybe (list Ctype.ctype) -> A.expression GenTypes.genTypeCategory -> bool
+let gnu_indirect_target_types_disjoint types callee =
+  let diagnostic message = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf callee)
+    (fun () -> "GNU indirect target census: " ^ message) in
+  if gnu_inline_direct_designator callee then false else
+  if gnu_size_effects callee <> Just false then
+    let () = diagnostic "callee evaluation is not certified readonly" in false
+  else match (types, ctype_of callee) with
+    | (Just candidates, Ctype.Ctype _ (Ctype.Pointer _
+        (Ctype.Ctype _ (Ctype.Function (_, result) params false)))) ->
+        let remaining = List.filter (fun candidate ->
+          not (gnu_indirect_candidate_incompatible (ctype_of callee) candidate)) candidates in
+        let () = diagnostic ("remaining=" ^ show (List.length remaining) ^ "; types=[" ^
+          String.concat "; " (List.map Pp.stringFromCore_ctype (List.take 4 remaining)) ^ "]") in
+        remaining = []
+    | (Nothing, _) -> let () = diagnostic "incomplete callable census" in false
+    | _ -> let () = diagnostic ("unsupported callee type: " ^
+        Pp.stringFromCore_ctype (ctype_of callee)) in false
+  end
+
+(* Missing target analysis is insufficient: retain the existing positive
+   incoming pointer certificate independently of the complete-census proof. *)
+val gnu_positive_opaque_callee_value:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_positive_opaque_callee_value (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_positive_opaque_callee_value in
+  if not (AilTypesAux.is_pointer_to_function (ctype_of expr)) || gnu_size_effects expr <> Just false
+  then E.return false else match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        E.gnu_compiler_fact sym >>= fun fact -> E.return (fact = Just E.GNU_inline_unknown_extent_fact)
+    | A.AilErvalue operand -> gnu_loaded_memory_fact operand >>= fun fact ->
+        E.return (fact = Just E.GNU_inline_unknown_extent_fact)
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> if gnu_compatible_function_pointer (ctype_of expr) (ctype_of operand)
+        then self operand else E.return false
+    | A.AilEfunction_decay (A.AnnotatedExpression _ _ _ (A.AilEunary A.Indirection operand)) -> self operand
+    | _ -> E.return false
+  end
+
+val gnu_positive_opaque_indirect_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_positive_opaque_indirect_call callee =
+  if gnu_inline_direct_designator callee then E.return false else
+  gnu_inline_function_target callee >>= fun target ->
+  if isJust target then E.return false else
+  gnu_positive_opaque_callee_value callee >>= fun incoming ->
+  E.gnu_indirect_target_types >>= fun types ->
+  let excluded = gnu_indirect_target_types_disjoint types callee in
+  gnu_call_attributes callee >>= fun attrs ->
+  E.return ((incoming || excluded) && not (Cerb_attributes.has_gnu_noarg_attribute "const" attrs ||
+    Cerb_attributes.has_gnu_noarg_attribute "pure" attrs))
+
+(* Shared positive return-origin predicate. An unsized ordinary opaque call
+   differs from failure to analyse an expression or a declared sized allocator. *)
+val gnu_ordinary_unsized_pointer_result:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_ordinary_unsized_pointer_result (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return false else match node with
+    | A.AilEcall callee _ ->
+        gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+        gnu_call_attributes callee >>= fun attrs ->
+        let sized = match attrs with Annot.Attrs values -> List.any (fun attr ->
+          Cerb_attributes.is_gnu_named_attribute "alloc_size" attr) values end in
+        E.return (opaque && not sized)
+    | A.AilEannot _ child -> gnu_ordinary_unsized_pointer_result child
+    | A.AilErvalue child -> gnu_ordinary_unsized_pointer_result child
+    | A.AilEcast _ ty child -> if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of child)
+        then gnu_ordinary_unsized_pointer_result child else E.return false
+    | _ -> E.return false
+  end
+
+(* Sized external results can supply a retained memory origin on a later
+   invocation. They are NOT opaque at their assignment: this predicate is used
+   only by the separate mutable-entry census, never an all-writes invariant. *)
+val gnu_retained_sized_pointer_result:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_retained_sized_pointer_result (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_retained_sized_pointer_result in
+  if not (AilTypesAux.is_pointer (ctype_of expr)) ||
+      AilTypesAux.is_pointer_to_function (ctype_of expr) then E.return false else match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee) then E.return false else
+        gnu_opaque_call_boundary callee >>= fun (opaque, attrs) ->
+        let allocation = match attrs with Annot.Attrs values -> List.filter (fun attr ->
+          Cerb_attributes.is_gnu_named_attribute "alloc_size" attr) values end in
+        let decoded = List.map Cerb_attributes.decode_gnu_allocation_indices allocation in
+        let params = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ params _))) -> params
+          | Ctype.Ctype _ (Ctype.Function _ params _) -> params
+          | _ -> [] end in
+        let valid index = if index <= 0 then false else
+          match (List.index args (natFromInteger (index - 1)),
+                 List.index params (natFromInteger (index - 1))) with
+            | (Just arg, Just (_, ty, _)) ->
+                AilTypesAux.is_integer (ctype_of arg) && AilTypesAux.is_integer ty
+            | _ -> false end in
+        E.return (opaque && match decoded with
+          | Just indices :: rest -> indices <> [] && List.all valid indices &&
+              List.all (fun item -> item = Just indices) rest
+          | _ -> false end)
+    | A.AilEannot _ child -> self child
+    | A.AilErvalue child -> self child
+    | A.AilEcast _ ty child -> if AilTypesAux.is_pointer ty &&
+        AilTypesAux.is_pointer (ctype_of child) then self child else E.return false
+    | _ -> E.return false
+  end
+
+val gnu_global_opaque_value:
+  bool -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let gnu_global_opaque_value retained opaque_locals value =
+  if gnu_literal_null_pointer value then E.return (Just false) else
+  gnu_ordinary_unsized_pointer_result value >>= fun opaque ->
+  (if retained then gnu_retained_sized_pointer_result value else E.return false) >>= fun sized ->
+  let copied = gnu_size_effects value = Just false &&
+    maybe false (fun sym -> List.elem sym opaque_locals) (gnu_inline_direct_pointer_symbol value) in
+  E.return (if opaque || sized || copied then Just true else Nothing)
+
+(* An arithmetic or object-pointer output can escape only through a direct
+   ordinary unavailable-body call in this certificate. The complete definition walker
+   below checks every other occurrence, including all explicit writes. This
+   records a representation origin, not a successful/definite output write. *)
+val gnu_origin_output_argument:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_origin_output_argument subject (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident sym) as object_expr) ->
+      let (qs, ty) = qualified_ctype_of object_expr in
+      sym = subject && not qs.Ctype.const && not qs.Ctype.volatile &&
+        not (AilTypesAux.is_atomic ty) &&
+        (AilTypesAux.is_arithmetic ty || (AilTypesAux.is_pointer ty &&
+          not (AilTypesAux.is_pointer_to_function ty)))
+  | A.AilEannot _ operand -> gnu_origin_output_argument subject operand
+  | _ -> false
+end
+
+val gnu_origin_output_call:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let gnu_origin_output_call subject (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcall callee args ->
+      let output = gnu_origin_output_argument subject in
+      if not (List.any output args && List.all gnu_memory_expression_readonly args &&
+        gnu_inline_parameter_expression_safe subject callee &&
+        List.all (fun actual -> output actual ||
+          gnu_inline_parameter_expression_safe subject actual) args)
+      then E.return Nothing else
+      let signature = match ctype_of callee with
+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ params variadic))) ->
+            let (fixed, extra) = List.splitAt (List.length params) args in
+            List.length fixed = List.length params && (variadic || extra = []) &&
+              not (List.any output extra) &&
+              List.all (fun ((_, ty, _), actual) ->
+                not (output actual) || gnu_function_target_type_equal ty (ctype_of actual))
+                (List.zip params fixed)
+        | _ -> false end in
+      if not signature then E.return Nothing else
+      gnu_call_attributes callee >>= fun attrs ->
+      if List.any (fun name -> Cerb_attributes.has_gnu_noarg_attribute name attrs)
+        ["returns_twice"; "pure"; "const"]
+      then E.return Nothing else
+      gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+      E.return (if opaque then Just true else Nothing)
+  | _ -> E.return Nothing
+end
+
+val gnu_pointer_definition_expression_with:
+  (Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) ->
+  (A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) -> Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let rec gnu_pointer_definition_expression_with output_call classify subject (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_pointer_definition_expression_with output_call classify subject in
+  let every operands = E.foldlM (fun acc operand -> match acc with
+    | Nothing -> E.return Nothing
+    | Just seen -> self operand >>= fun result -> E.return (maybe Nothing (fun found -> Just (seen || found)) result)
+    end) (Just false) operands in
+  if gnu_inline_parameter_expression_safe subject expr then E.return (Just false) else match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident target)) right ->
+        if target <> subject then self right else
+        if not (gnu_inline_parameter_expression_safe subject right) then E.return Nothing else
+        classify right
+    | A.AilEassign left right -> every [left; right]
+    | A.AilEcompoundAssign (A.AnnotatedExpression _ _ _ (A.AilEident target)) _ right ->
+        if target <> subject then self right else
+        if gnu_inline_parameter_expression_safe subject right then classify expr else E.return Nothing
+    | A.AilEunary A.PostfixIncr (A.AnnotatedExpression _ _ _ (A.AilEident target)) ->
+        if target = subject then classify expr else E.return (Just false)
+    | A.AilEunary A.PostfixDecr (A.AnnotatedExpression _ _ _ (A.AilEident target)) ->
+        if target = subject then classify expr else E.return (Just false)
+    | A.AilEbinary left _ right -> every [left; right]
+    | A.AilEcond test yes no -> every (test :: no :: maybe [] (fun value -> [value]) yes)
+    | A.AilEcall callee args -> output_call subject expr >>= function
+        | Just result -> E.return (Just result)
+        | Nothing -> every (callee :: args)
+      end
+    | A.AilEannot _ child -> self child
+    | A.AilEcast _ _ child -> self child
+    | A.AilErvalue child -> self child
+    | _ -> E.return Nothing
+  end
+
+val gnu_pointer_definition_statement_with:
+  (Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) ->
+  (A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) -> Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let rec gnu_pointer_definition_statement_with output_call classify subject stmt =
+  let self = gnu_pointer_definition_statement_with output_call classify subject in
+  let expression = gnu_pointer_definition_expression_with output_call classify subject in
+  let merge actions = E.foldlM (fun acc action -> match acc with
+    | Nothing -> E.return Nothing
+    | Just seen -> action >>= fun result -> E.return (maybe Nothing (fun found -> Just (seen || found)) result)
+    end) (Just false) actions in
+  if gnu_inline_parameter_unchanged subject stmt then E.return (Just false) else match stmt.A.node with
+    | A.AilSexpr value -> expression value
+    | A.AilSreturn value -> expression value
+    | A.AilSblock _ statements -> merge (List.map self statements)
+    | A.AilSif test yes no -> merge [expression test; self yes; self no]
+    | A.AilSwhile test body _ -> merge [expression test; self body]
+    | A.AilSdo body test _ -> merge [self body; expression test]
+    | A.AilSswitch test body -> merge [expression test; self body]
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSmarker _ body -> self body
+    | A.AilSdeclaration declarations -> merge (List.map (fun (target, value) ->
+        maybe (E.return (Just false)) (fun value ->
+          if target = subject then classify value
+          else expression value) value) declarations)
+    | A.AilSpar statements -> merge (List.map self statements)
+    | _ -> E.return Nothing
+  end
+
+val gnu_pointer_definition_expression:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) -> Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let gnu_pointer_definition_expression =
+  gnu_pointer_definition_expression_with (fun _ _ -> E.return Nothing)
+
+val gnu_pointer_definition_statement:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) -> Symbol.sym ->
+  A.statement GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let gnu_pointer_definition_statement =
+  gnu_pointer_definition_statement_with (fun _ _ -> E.return Nothing)
+
+(* The same complete definition census serves global origins and private
+   output preservation. Keep the existing global classifier unchanged. *)
+val gnu_global_opaque_expression:
+  bool -> list Symbol.sym -> Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let gnu_global_opaque_expression retained opaque_locals subject expr =
+  gnu_pointer_definition_expression (gnu_global_opaque_value retained opaque_locals) subject expr
+
+val gnu_global_opaque_statement:
+  bool -> list Symbol.sym -> Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let gnu_global_opaque_statement retained opaque_locals subject stmt =
+  gnu_pointer_definition_statement (gnu_global_opaque_value retained opaque_locals) subject stmt
+
+(* Preserve an existing opaque member certificate only when the value
+   being stored is itself positively known to have an unknown compiler extent.
+   This joins unknown old/new contents without inventing an unknown result
+   for a failed capture. Known values and aliases are still invalidated. *)
+val gnu_memory_unknown_pointer_value: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_memory_unknown_pointer_value (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty)
+  then E.return false else
+  let is_unknown fact = match fact with
+    | Just E.GNU_inline_unknown_extent_fact -> true | _ -> false end in
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (load_qs, load_ty) = qualified_ctype_of operand in
+        if load_qs.Ctype.volatile || AilTypesAux.is_atomic load_ty then E.return false else
+        E.gnu_compiler_fact sym >>= fun fact -> E.return (is_unknown fact)
+    | A.AilErvalue operand ->
+        let (load_qs, load_ty) = qualified_ctype_of operand in
+        if load_qs.Ctype.volatile || AilTypesAux.is_atomic load_ty then E.return false else
+        gnu_memory_slot_of true operand >>= function
+          | Just slot -> E.gnu_memory_fact slot >>= fun fact -> E.return (is_unknown fact)
+          | Nothing -> E.return false end
+    | A.AilEannot _ operand -> gnu_memory_unknown_pointer_value operand
+    | _ -> E.return false
+  end
+
+(* Standard string searches return null or an interior pointer into their
+   first string. Only a positive opaque origin qualifies; known/missing sizes
+   retain their separate obligations. Runtime calls are never folded/replayed. *)
+val gnu_string_search_unknown_result:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_string_search_unknown_result (A.AnnotatedExpression _ _ _ node as expr) =
+  let char_pointer ty = match ty with
+    | Ctype.Ctype _ (Ctype.Pointer qs (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)))) ->
+        not qs.Ctype.volatile
+    | _ -> false end in
+  let integer_char ty = match ty with
+    | Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity)) ->
+        Implementation.normalise_integerType ity = Ctype.Signed Ctype.Int_
+    | _ -> false end in
+  match node with
+    | A.AilEcall callee [first; second] ->
+        let prototype = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _
+              (Ctype.Function (_, result) [(_, left, _); (_, right, _)] false))) ->
+              if char_pointer result && char_pointer left then Just right else Nothing
+          | Ctype.Ctype _ (Ctype.Function (_, result) [(_, left, _); (_, right, _)] false) ->
+              if char_pointer result && char_pointer left then Just right else Nothing
+          | _ -> Nothing end in
+        if not (char_pointer (ctype_of expr)) ||
+            not (gnu_inline_direct_designator callee) ||
+            not (List.all gnu_memory_expression_readonly [first; second])
+        then E.return false else
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_has_source_definition target >>= fun defined ->
+              E.linker_name declared >>= fun name ->
+              let admitted = maybe false (fun right ->
+                (name = Just "strpbrk" && char_pointer right) ||
+                (name = Just "strrchr" && integer_char right)) prototype in
+              if defined || not admitted then E.return false else
+                gnu_memory_unknown_pointer_value first >>= fun direct ->
+                if direct then E.return true else gnu_inline_opaque_offset false first
+        end
+    | _ -> E.return false
+  end
+
+val gnu_opaque_pointer_call_result:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_opaque_pointer_call_result (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_opaque_pointer_call_result in
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return false else
+  match node with
+    | A.AilEcall _ _ ->
+        gnu_ordinary_unsized_pointer_result expr >>= fun opaque ->
+        if opaque then E.return true else gnu_string_search_unknown_result expr
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+        then self operand else E.return false
+    | _ -> E.return false
+  end
+
+(* A closed integer store can overwrite pointer representation, but cannot
+   carry a visible allocation origin into it. The same origin-class property
+   holds for a read-modify-write of that destination with closed integer
+   operands: the old representation supplies no new external origin.
+   This certifies ONLY retention of an existing compiler-unknown extent class,
+   never a pointer value, bound, alias or scalar fact. Runtime reads and writes
+   remain emitted. Reject loaded RHS scalars (including saved address casts),
+   pointer-valued updates, volatile/atomic accesses and address effects. *)
+val gnu_literal_integer_store_chain:
+  A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_literal_integer_store_chain (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_literal_integer_store_chain in
+  if not (AilTypesAux.is_integer (ctype_of expr)) then false else
+  if gnu_inline_closed_integer_origin expr && gnu_size_effects expr = Just false
+  then true else match node with
+    | A.AilEassign left right ->
+        let (qs, ty) = qualified_ctype_of left in
+        not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+          AilTypesAux.is_integer ty && gnu_memory_expression_readonly left && self right
+    | A.AilEcompoundAssign left _ right ->
+        let (qs, ty) = qualified_ctype_of left in
+        not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+          AilTypesAux.is_integer ty && gnu_memory_expression_readonly left &&
+          gnu_inline_closed_integer_origin right && gnu_size_effects right = Just false
+    | A.AilEunary op left ->
+        let (qs, ty) = qualified_ctype_of left in
+        (op = A.PostfixIncr || op = A.PostfixDecr) &&
+          not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+          AilTypesAux.is_integer ty && gnu_memory_expression_readonly left
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ ty operand -> AilTypesAux.is_integer ty && self operand
+    | _ -> false
+  end
+
+(* Literal null has the existing target-specific unknown object extent. A
+   store of that origin cannot introduce a known allocation into an opaque
+   pointer member. This is only an origin-class certificate; normal stores and
+   typed-memory invalidation still execute. *)
+val gnu_literal_null_store_chain:
+  A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_literal_null_store_chain (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_literal_null_pointer expr then true else
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then false else match node with
+    | A.AilEassign left right ->
+        let (qs, ty) = qualified_ctype_of left in
+        not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+          AilTypesAux.is_pointer ty && gnu_memory_expression_readonly left &&
+          gnu_literal_null_store_chain right
+    | A.AilEannot _ operand -> gnu_literal_null_store_chain operand
+    | _ -> false
+  end
+
+(* A wrapper may pass a zero-valued formal to a byte-clear builtin. The caller
+   supplies this small context only for unchanged, unescaped formal objects.
+   Do not consult caller memory using callee symbols or assume an unknown fill
+   value is zero. *)
+val gnu_boundary_integer_zero:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_boundary_integer_zero zero_formals (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (AilTypesAux.is_integer (ctype_of expr)) then false else match node with
+    | A.AilEconst (A.ConstantInteger (A.IConstant number _ _)) -> number = 0
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (qs, ty) = qualified_ctype_of operand in
+        List.elem sym zero_formals && not qs.Ctype.volatile &&
+          not (AilTypesAux.is_atomic ty) && AilTypesAux.is_integer ty
+    | A.AilEcast _ ty operand ->
+        AilTypesAux.is_integer ty && gnu_boundary_integer_zero zero_formals operand
+    | A.AilEannot _ operand -> gnu_boundary_integer_zero zero_formals operand
+    | _ -> false
+  end
+
+(* Only unchanged, unescaped pointer formals can carry a literal null
+   argument into an effect summary. This is a value proof, not an assumption
+   about missing pointer information. Runtime conditions and calls are retained. *)
+val gnu_boundary_known_null:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let gnu_boundary_known_null null_formals expr =
+  gnu_memory_expression_readonly expr &&
+    (gnu_literal_null_pointer expr ||
+      (AilTypesAux.is_pointer (ctype_of expr) &&
+        maybe false (fun sym -> List.elem sym null_formals) (gnu_inline_direct_pointer_symbol expr)))
+
+val gnu_boundary_null_condition:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> maybe bool
+let gnu_boundary_null_condition null_formals (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (gnu_memory_expression_readonly expr) then Nothing else
+  let is_null = gnu_boundary_known_null null_formals in
+  if is_null expr then Just false else match node with
+    | A.AilEbinary left A.Eq right ->
+        if is_null left && is_null right then Just true else Nothing
+    | A.AilEbinary left A.Ne right ->
+        if is_null left && is_null right then Just false else Nothing
+    | _ -> Nothing
+  end
+
+(* Standard zero-byte writes introduce no known allocation origin on the
+   pinned amd64 profile. Retain only pre-existing opaque classes, not values,
+   bounds, aliases or memory contents. The call, its checked size/failure path
+   and operand evaluation are all retained by ordinary translation. A visible
+   definition is inspected by the recursive body analysis instead. *)
+val gnu_standard_zero_fill_call:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_standard_zero_fill_call zero_formals (A.AnnotatedExpression _ _ _ node) =
+  if not (Implementation.has_amd64_sysv_abi ()) then E.return false else match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee &&
+            List.all gnu_memory_expression_readonly args) then E.return false else
+        let void_pointer ty = match ty with
+          | Ctype.Ctype _ (Ctype.Pointer qs pointed) ->
+              not qs.Ctype.volatile && AilTypesAux.is_void pointed
+          | _ -> false end in
+        let int_type ty = match ty with
+          | Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity)) ->
+              Implementation.normalise_integerType ity = Ctype.Signed Ctype.Int_
+          | _ -> false end in
+        let size_type ty = match (ty, Ctype.size_t) with
+          | (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity)),
+             Ctype.Ctype _ (Ctype.Basic (Ctype.Integer size_ity))) ->
+              Implementation.normalise_integerType ity = Implementation.normalise_integerType size_ity
+          | _ -> false end in
+        let function_ty = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ ty) -> ty
+          | ty -> ty end in
+        let signature = match function_ty with
+          | Ctype.Ctype _ (Ctype.Function (_, result) params false) ->
+              if List.length params = List.length args
+              then Just (result, List.map (fun (_, ty, _) -> ty) params) else Nothing
+          | _ -> Nothing end in
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_has_source_definition target >>= fun defined ->
+              E.linker_name declared >>= fun name ->
+              let admitted = match (name, signature, args) with
+                | (Just "__explicit_bzero_chk", Just (result, [destination; length; bound]), [_; _; _]) ->
+                    AilTypesAux.is_void result && void_pointer destination &&
+                      size_type length && size_type bound
+                | (Just name, Just (result, [destination; fill; length]), [_; value; _]) ->
+                    (name = "memset" || name = "__builtin_memset") &&
+                      void_pointer result && void_pointer destination && int_type fill &&
+                      size_type length && gnu_boundary_integer_zero zero_formals value
+                | (Just name, Just (result, [destination; fill; length; bound]), [_; value; _; _]) ->
+                    (name = "__memset_chk" || name = "__builtin___memset_chk") &&
+                      void_pointer result && void_pointer destination && int_type fill &&
+                      size_type length && size_type bound && gnu_boundary_integer_zero zero_formals value
+                | (Just name, Just (result, [destination; length]), [_; _]) ->
+                    (name = "bzero" || name = "__builtin_bzero" || name = "explicit_bzero") &&
+                      AilTypesAux.is_void result && void_pointer destination && size_type length
+                | _ -> false end in
+              E.return (not defined && admitted)
+        end
+    | _ -> E.return false
+  end
+
+(* In the separated-frame proof, the protected storage belongs to an older
+   activation. Named objects here have distinct storage, even if their addresses
+   escape. A dereference needs a separately transported disjoint actual; pointer
+   names, casts, loaded members and extent sizes alone prove no separation. This
+   proof is used only to retain explicit opaque slots, never pointee contents. *)
+val gnu_boundary_separate_address:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+val gnu_boundary_separate_lvalue:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_boundary_separate_address pointers (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (gnu_memory_expression_readonly expr) then false else match node with
+    | A.AilEunary A.Address object_expr -> gnu_boundary_separate_lvalue pointers object_expr
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> List.elem sym pointers
+    | A.AilEannot _ operand -> gnu_boundary_separate_address pointers operand
+    | _ -> false
+  end
+and gnu_boundary_separate_lvalue pointers (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then false else match node with
+    | A.AilEident _ -> true
+    | A.AilEmemberof object_expr _ -> gnu_boundary_separate_lvalue pointers object_expr
+    | A.AilEmemberofptr pointer _ -> gnu_boundary_separate_address pointers pointer
+    | A.AilEunary A.Indirection pointer -> gnu_boundary_separate_address pointers pointer
+    | A.AilEannot _ operand -> gnu_boundary_separate_lvalue pointers operand
+    | _ -> false
+  end
+
+(* Direct calls use the completed declaration's C11/GNU noreturn contract.
+   Arguments and calls still take ordinary translation; this fact only excludes
+   their impossible normal continuation from a following memory-fact join. *)
+val gnu_expression_calls_noreturn: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_expression_calls_noreturn (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcall (A.AnnotatedExpression _ _ _ callee) _ ->
+      (match callee with
+        | A.AilEfunction_decay (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> E.function_is_noreturn sym
+        | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> E.function_is_noreturn sym
+        | _ -> E.return false end)
+  | A.AilEannot _ operand -> gnu_expression_calls_noreturn operand
+  | A.AilEcast _ _ operand -> gnu_expression_calls_noreturn operand
+  | _ -> E.return false
+end
