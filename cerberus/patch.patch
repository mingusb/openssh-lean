+(* Header typedefs and compiler builtins may spell size_t differently. Compare
+   their implementation-normalized integer types, not merely their widths. *)
+val gnu_standard_size_type: Ctype.ctype -> bool
+let gnu_standard_size_type ty = match (ty, Ctype.size_t) with
+  | (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer actual)),
+     Ctype.Ctype _ (Ctype.Basic (Ctype.Integer expected))) ->
+      Implementation.normalise_integerType actual = Implementation.normalise_integerType expected
+  | _ -> false end
