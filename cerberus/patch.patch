+    if (take(0) != 0 || take((void *)0) != 0) return 4;
+    if (take(explicit_value) != &wide) return 5;
+    if (tagged(&wide) != &wide) return 6;
+    if (integer(~0u) != -1 || integer(7) != 7) return 7;
+    if (bits(0L) != 0) return 8;
