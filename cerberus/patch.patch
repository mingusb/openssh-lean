+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_capture_saved_array_index translate_expr tagDefs in
+  match node with
+    | A.AilEbinary _ _ _ ->
+        (match gnu_inline_pointer_offset expr with
+          | Just (base, A.AnnotatedExpression category annots loc
+              (A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident subject) as left) original),
