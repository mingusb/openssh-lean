+        FILE *meta = fd < 0 ? NULL : fdopen(fd, "w");
+        if (!meta) { if (fd >= 0) close(fd); ok = 0; }
+        else {
+            fprintf(meta, "%sparts %zu\n", memo_manifest, memo_part_count - keep_from);
+            for (size_t i = keep_from; i < memo_part_count; ++i) {
+                const char *name = strrchr(memo_part_paths[i], '/') + 1;
