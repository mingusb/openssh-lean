index 00000000..8b11bff1
--- /dev/null
+++ b/lean_frontend/CerbMemo.lean
@@ -0,0 +1,152 @@
+import Lean.Util.ShareCommon
+import Std.Sync.Mutex
+
+/-!
+Runtime-only optimization. The kernel sees eval as thunk application. The
+compiler pass must establish absence of effects and untracked reads.
+Keys retain code identity and captured runtime arguments, with generic
+structural sharing and exact equality; hashes alone never establish a hit.
+-/
+namespace CerbMemo
+
+structure Stats where
+  calls : Nat := 0
+  hits : Nat := 0
+  misses : Nat := 0
+  entries : Nat := 0
+  deriving Repr, Inhabited
+
+@[extern "cerb_memo_table_new", noinline, never_extract]
+private unsafe opaque tableNew (structural : Bool) (unit : Unit) : NonScalar
+
+@[extern "cerb_memo_table_find"]
+private unsafe opaque tableFind (table key : @& NonScalar) : Option NonScalar
+
+@[extern "cerb_memo_table_insert"]
+private unsafe opaque tableInsert (table key value : NonScalar) : NonScalar
+
+@[extern "cerb_memo_table_clear"]
+private unsafe opaque tableClear (table : NonScalar) : NonScalar
+
+@[extern "cerb_memo_forget_lookup_wrappers"]
+private unsafe opaque forgetLookupWrappers
+    (identities : NonScalar) (rawKey : @& ShareCommon.Object) : NonScalar
+
+/-- The pinned ShareCommon traversal and equality use private mutable tables.
+    Their aliases never escape the mutex-protected cache implementation. -/
+private unsafe def mutableFactory : ShareCommon.StateFactory :=
+  unsafeCast ({
+    Map := NonScalar
+    Set := NonScalar
+    mkState := fun _ => (tableNew false (), tableNew true ())
+    mapFind? := tableFind
+    mapInsert := tableInsert
+    setFind? := tableFind
+    setInsert := fun table key => tableInsert table key key
+  } : ShareCommon.StateFactoryImpl)
+
+private unsafe structure CacheState where
+  sharing : ShareCommon.State mutableFactory := default
+  results : NonScalar := tableNew false ()
+  stats : Stats := {}
+  epoch : Nat := 0
+
+@[extern "cerb_memo_closure_key"]
+private unsafe opaque closureKey {α : Type} (f : @& (Unit → α)) : ShareCommon.Object
+
+private initialize store : Std.Mutex (Option NonScalar) ← Std.Mutex.new none
+-- Kernel elaboration, module initialization and bytecode checks do not need
+-- native storage. Enabling is explicit at the validated executable boundary.
+private initialize enabledSwitch : IO.Ref Bool ← IO.mkRef false
+private initialize nativeSwitch : IO.Ref Bool ← IO.mkRef false
+
+/-- Native cache entry points are used only after executable initialization.
+    Lean bytecode retains the pure definitions and needs no C externs. -/
+def nativeConfigured : BaseIO Bool := nativeSwitch.get
+
+private unsafe def withCache {α : Type} (f : CacheState → α × CacheState) : BaseIO α :=
+  store.atomically do
+    let raw ← get
+    -- Transfer ownership before modifying hash tables; retaining the old state
+    -- would force an array copy on every insertion.
+    set (none : Option NonScalar)
+    let s : CacheState := match raw with
+      | none => {}
+      | some value => unsafeCast value
+    let (value, s) := f s
+    set (some (unsafeCast s : NonScalar))
+    return value
+
+def configure (enabled : Bool) : IO Unit := do
+  if enabled && (← IO.getEnv "LEAN_ABORT_ON_PANIC").isNone then
+    throw <| IO.userError "memoization requires the interpreter abort-on-panic profile"
+  enabledSwitch.set enabled
+  nativeSwitch.set true
+
+unsafe def reset : IO Unit :=
+  withCache fun s =>
+    let (identities, canonical) : NonScalar × NonScalar := unsafeCast s.sharing
+    let sharing := unsafeCast (tableClear identities, tableClear canonical)
+    ((), { s with
+      sharing
+      results := tableClear s.results
+      epoch := s.epoch + 1
+      stats := { s.stats with entries := 0 }
+    })
+
+unsafe def snapshot : IO Stats :=
+  withCache fun s => (s.stats, s)
+
+private unsafe def evalCached {α : Type} (f : Unit → α) : BaseIO α := do
+  let probe : ShareCommon.Object × Nat × Option NonScalar ← withCache fun s =>
+    let rawKey := closureKey f
+    let (key, sharing) := s.sharing.shareCommon rawKey
+    -- Key/capture wrappers are new for every lookup, even a hit. They cannot be
+    -- reused by a later call; keep only their canonical key and the useful
+    -- identities of the captured argument graphs.
+    let (identities, canonical) : NonScalar × NonScalar := unsafeCast sharing
+    let sharing := unsafeCast (forgetLookupWrappers identities rawKey, canonical)
+    let found := tableFind s.results key
+    let stats := { s.stats with
+      calls := s.stats.calls + 1
+      hits := s.stats.hits + (if found.isSome then 1 else 0)
+      misses := s.stats.misses + (if found.isNone then 1 else 0)
+    }
+    ((key, s.epoch, found), { s with sharing, stats })
+  match probe with
+  | (_, _, some value) => return unsafeCast value
+  | (key, epoch, none) =>
+    let value := f ()
+    -- No mutex held while computing. Nested cache writes must be retained.
+    withCache fun s =>
+      if s.epoch != epoch then ((), s)
+      else
+        let added := (tableFind s.results key).isNone
+        ((), { s with
+          results := tableInsert s.results key (unsafeCast value)
+          stats := { s.stats with entries := s.stats.entries + (if added then 1 else 0) }
+        })
+    return value
+
+@[noinline, never_extract]
+unsafe def evalImpl {α : Type} (f : Unit → α) : α := unsafeBaseIO do
+  if !(← enabledSwitch.get) then return f ()
+  evalCached f
+
+/-- Cache an explicitly selected pure computation even when broad
+    memoization is disabled. The proof-visible value is still f (). -/
+@[noinline, never_extract]
+unsafe def evalSelectedImpl {α : Type} (f : Unit → α) : α := unsafeBaseIO do
+  if !(← nativeConfigured) then return f ()
+  evalCached f
+
+@[implemented_by evalImpl, noinline, never_extract]
+def eval {α : Type} (f : Unit → α) : α := f ()
+
+@[implemented_by evalSelectedImpl, noinline, never_extract]
+def evalSelected {α : Type} (f : Unit → α) : α := f ()
+
+theorem eval_eq {α : Type} (f : Unit → α) : eval f = f () := rfl
+theorem evalSelected_eq {α : Type} (f : Unit → α) : evalSelected f = f () := rfl
+
+end CerbMemo
