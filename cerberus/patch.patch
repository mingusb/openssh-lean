+  | A.AilEmemberofptr (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address operand)) _ ->
+      gnu_inline_parameter_lvalue sym operand
+  | A.AilEunary A.Indirection (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address operand)) ->
+      gnu_inline_parameter_lvalue sym operand
+  | A.AilEannot _ operand -> gnu_inline_parameter_lvalue sym operand
+  | _ -> false
