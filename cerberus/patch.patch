diff --git a/tools/check_memo_imports.py b/tools/check_memo_imports.py
new file mode 100644
index 00000000..ec8fc0ea
--- /dev/null
+++ b/tools/check_memo_imports.py
@@ -0,0 +1,27 @@
+"""Require the automatic compiler pass in every generated interpreter module."""
+from pathlib import Path
+import json
+import re
+import sys
+
+root = Path(__file__).resolve().parents[1]
+generated = root / "lean_frontend/generated"
+files = {p.stem: p for p in generated.glob("*.lean")}
+required = {"CerbMemo", "CerbMemoPass"}
+if not required <= files.keys():
+    sys.exit("memo import check: missing cache runtime or compiler pass")
+imports = {
+    name: set(re.findall(r"(?m)^import[ \t]+([\w.]+)", path.read_text()))
+    for name, path in files.items()
+}
+covered = {"CerbMemoPass"}
+while True:
+    more = {name for name, deps in imports.items() if deps & covered}
+    if more <= covered:
+        break
+    covered |= more
+missing = sorted(files.keys() - covered - {"CerbMemo"})
+if missing:
+    sys.exit("memo import check: modules missing automatic analysis: " + ", ".join(missing))
+print(json.dumps({"generated_modules": len(files), "analysis_modules": len(covered),
+                  "runtime_module": "CerbMemo", "uncovered_modules": missing}))
