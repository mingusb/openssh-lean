diff --git a/lean_frontend/test/Unit/HostFilesAdmissionRequestTest.lean b/lean_frontend/test/Unit/HostFilesAdmissionRequestTest.lean
new file mode 100644
index 00000000..4cec8f78
--- /dev/null
+++ b/lean_frontend/test/Unit/HostFilesAdmissionRequestTest.lean
@@ -0,0 +1,192 @@
+import CerbHostFilesAdmission
+import CerbHostFilesRequests
+import CerbHostFilesExtras
+set_option autoImplicit false
+
+open CerbMem CerbHostMemoryCells CerbHostFilesAdmission CerbHostFilesRequests CerbHostFilesGuest CerberusImpl
+
+private def expect (ok : Bool) (message : String) : IO Unit :=
+  if ok then pure () else throw (IO.userError message)
+
+private def pointer : PointerValue := nullPtrval void
+private def scalar : ctype := signed_int
+private def ptrType : ctype := .Ctype [] (.Pointer no_qualifiers void)
+
+private def runStatic : IO Unit := do
+  let packed : value := .Vlist (.BTy_tuple [.BTy_ctype, .BTy_object .OTy_pointer])
+    [.Vtuple [.Vctype scalar, .Vobject (.OVpointer pointer)]]
+  expect (match decodeVariadicPack packed with
+    | .ok [(type, _)] => ctypeEqual type scalar
+    | _ => false) "typed promoted variadic pack admission"
+  let malformed : value := .Vlist (.BTy_tuple [.BTy_ctype, .BTy_object .OTy_pointer])
+    [.Vtuple [.Vobject (.OVpointer pointer), .Vctype scalar]]
+  expect (match decodeVariadicPack malformed with | .error _ => true | _ => false)
+    "variadic tuple order must be exact"
+  expect (match CerbHostFilesExtras.fcntlNeedsArgument 1 with | .ok false => true | _ => false) "F_GETFD reads no vararg"
+  expect (match CerbHostFilesExtras.fcntlNeedsArgument 2 with | .ok true => true | _ => false) "F_SETFD requires promoted int"
+  expect (match CerbHostFilesExtras.fcntlNeedsArgument 99 with | .error _ => true | _ => false)
+    "unsupported fcntl command rejects before effects"
+  let closeResult := constructFrom "close" [.number 7] [scalar]
+  expect (match closeResult with | .ok (.close 7) => true | _ => false) "close construction"
+  let readResult := constructFrom "read" [.number 4, .pointer pointer, .number 9] [scalar, ptrType, scalar]
+  expect (match readResult with | .ok (.read 4 9 _) => true | _ => false) "read argument reordering"
+  let openResult := constructFrom "open" [.pointer pointer, .number 65] [ptrType, scalar] (.openMode (some 420))
+  expect (match openResult with | .ok (.open _ 65 (some 420)) => true | _ => false) "open prepared mode"
+  let badExtra := constructFrom "close" [.number 7] [scalar] (.fcntlArgument 1)
+  expect (match badExtra with | .error _ => true | _ => false) "extra kind mismatch must reject"
+  pure ()
+
+
+
+private def take {α : Type} (value : Except Failure α) : IO α :=
+  match value with
+  | .ok result => pure result
+  | .error (.boundary message) => throw (IO.userError message)
+  | .error (.memory _) => throw (IO.userError "unexpected modeled memory failure")
+
+private def field (name : String) (type : ctype) : CerbTagsWf.Member :=
+  (.Identifier CerbLocation.unknown name, (.Attrs [], none, no_qualifiers, type))
+private def definition (tag : sym) (members : List CerbTagsWf.Member) :
+    sym × (CerbLocation.Loc × tag_definition) :=
+  (tag, (CerbLocation.unknown, .StructDef natural_aggregate_layout members none))
+private def timevalTag : sym := .Symbol "file-extras" 8101 (.SD_Id "timeval")
+private def timespecTag : sym := .Symbol "file-extras" 8102 (.SD_Id "timespec")
+private def iovecTag : sym := .Symbol "file-extras" 8103 (.SD_Id "iovec")
+private def recordType (tag : sym) : ctype := .Ctype [] (.Struct tag)
+private def constPointer (type : ctype) : ctype :=
+  .Ctype [] (.Pointer { no_qualifiers with const := true } type)
+private def tags : CerbTags.TagDefsMap := Lem_Map.fromList [
+  definition timevalTag [field "tv_sec" CellKind.signedLong.ty, field "tv_usec" CellKind.signedLong.ty],
+  definition timespecTag [field "tv_sec" CellKind.signedLong.ty, field "tv_nsec" CellKind.signedLong.ty],
+  definition iovecTag [field "iov_base" ptrType, field "iov_len" CellKind.unsignedLong.ty]]
+private def sourceProgram : generic_file Unit core_run_annotation :=
+  { (default : generic_file Unit core_run_annotation) with enumDefs := fmapEmpty, tagDefs := tags }
+private def admitted (name : String) (types : List ctype)
+    (variadic : List (ctype × PointerValue) := []) : Admitted := {
+  location := CerbLocation.other "files extras allocated fixture"
+  program := sourceProgram
+  name := name
+  symbol := .Symbol "files-extras" 8100 (.SD_Id name)
+  parameterTypes := types
+  argumentObjects := []
+  nonnullParameters := []
+  variadicObjects := variadic
+}
+private def decoded (arguments : List Argument) (memory : MemState) : Decoded :=
+  ⟨arguments, [], memory⟩
+
+private def runMemory [LemFuel] [CerbGlobal.Switches] : IO Unit := do
+  let (base, memory) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 512))
+    (initialMemState 65536))
+  let locate (offset : Int) (state : MemState) := immediate
+    (effArrayShiftPtrval fmapEmpty tags (CerbLocation.other "extras fixture offset")
+      base unsigned_char (.IV .Prov_none offset)) state
+  let (timeval, memory) ← take (locate 0 memory)
+  let (timespec, memory) ← take (locate 32 memory)
+  let (vector, memory) ← take (locate 128 memory)
+  let (payload, memory) ← take (locate 256 memory)
+  let (mode, memory) ← take (locate 320 memory)
+  let (timevalCells, memory) ← take (arrayCells fmapEmpty tags .signedLong timeval 4 memory)
+  let (timespecCells, memory) ← take (arrayCells fmapEmpty tags .signedLong timespec 4 memory)
+  let (payloadCells, memory) ← take (arrayCells fmapEmpty tags .byte payload 5 memory)
+  let outputLease ← take (prepareOutputs fmapEmpty tags
+    (timevalCells ++ timespecCells ++ payloadCells ++ [⟨mode,.signedInt⟩]) memory)
+  let (_, memory) ← take (commitOutputs fmapEmpty tags outputLease
+    [1,2,3,4,5,6,7,8,65,0,255,66,67,420])
+  let mut memory := memory
+  for (index,count) in [(0,3),(1,2)] do
+    let (element, shifted) ← take (immediate (effArrayShiftPtrval fmapEmpty tags
+      (CerbLocation.other "iovec fixture") vector (recordType iovecTag)
+      (.IV .Prov_none index)) memory)
+    let bp := memberShiftPtrval fmapEmpty tags element iovecTag
+      (.Identifier CerbLocation.unknown "iov_base")
+    let lp := memberShiftPtrval fmapEmpty tags element iovecTag
+      (.Identifier CerbLocation.unknown "iov_len")
+    let (data, shifted) ← take (immediate (effArrayShiftPtrval fmapEmpty tags
+      (CerbLocation.other "iovec payload") payload unsigned_char
+      (.IV .Prov_none (if index == 0 then 0 else 3))) shifted)
+    let (_, stored) ← take (immediate (storeM fmapEmpty tags CerbLocation.unknown
+      ptrType false bp (.MVpointer void data)) shifted)
+    let lease ← take (prepareOutputs fmapEmpty tags [⟨lp,.unsignedLong⟩] stored)
+    let (_, next) ← take (commitOutputs fmapEmpty tags lease [count])
+    memory := next
+  let openCall := admitted "open" [constPointer char0, signed_int] [(signed_int,mode)]
+  let openExtra ← take (CerbHostFilesExtras.prepare .linuxAmd64 openCall
+    (decoded [.pointer pointer,.number 64] memory) memory)
+  expect (match openExtra.extra with | .openMode (some 420) => true | _ => false)
+    "O_CREAT must load the actual promoted mode from modeled memory"
+  expect (openExtra.inputFootprints.length == 1) "mode object is loaded once"
+  let noMode ← take (CerbHostFilesExtras.prepare .linuxAmd64
+    (admitted "open" [constPointer char0,signed_int] [(signed_int,pointer)])
+    (decoded [.pointer pointer,.number 0] memory) memory)
+  expect (match noMode.extra with | .openMode none => true | _ => false)
+    "noncreating open must leave unused variadic objects unread"
+  expect noMode.inputFootprints.isEmpty "unused vararg cannot introduce a read"
+  for (name, type, input, expected) in [
+      ("utimes",constPointer (recordType timevalTag),timeval,([1,2,3,4] : List Int)),
+      ("utimensat",constPointer (recordType timespecTag),timespec,([5,6,7,8] : List Int))] do
+    let types := if name == "utimes" then [constPointer char0,type]
+      else [signed_int,constPointer char0,type,signed_int]
+    let arguments := if name == "utimes" then [.pointer pointer,.pointer input]
+      else [.number (-100),.pointer pointer,.pointer input,.number 0]
+    let prepared ← take (CerbHostFilesExtras.prepare .linuxAmd64
+      (admitted name types) (decoded arguments memory) memory)
+    let .times (some cells) := prepared.extra |
+      throw (IO.userError "time pair did not produce original model cells")
+    let mut actual := []; let mut current := prepared.memory
+    for cell in cells do
+      let (value,_,next) ← take (readInteger fmapEmpty tags cell current)
+      actual := actual ++ [value]; current := next
+    expect (actual == expected) "time fields retain original element/member ordering"
+  let vectorExtra ← take (CerbHostFilesExtras.prepare .linuxAmd64
+    (admitted "writev" [signed_int,constPointer (recordType iovecTag),signed_int])
+    (decoded [.number 1,.pointer vector,.number 2] memory) memory)
+  let .spans spans := vectorExtra.extra | throw (IO.userError "missing iovec spans")
+  expect (spans.map (·.count) == [3,2] && vectorExtra.inputFootprints.length == 4)
+    "two actual iovecs produce four field-read footprints"
+  let mut gathered := ByteArray.empty
+  let mut current := vectorExtra.memory
+  for span in spans do
+    let (bytes,_,next) ← take (readBytes fmapEmpty tags span.pointer span.count.toNat current)
+    gathered := gathered ++ bytes; current := next
+  expect (gathered.data == #[65,0,255,66,67]) "iovec pointer identity and lengths preserve binary payload"
+  let (misaligned, _) ← take (locate 129 memory)
+  let rejected := CerbHostFilesExtras.prepare .linuxAmd64
+    (admitted "writev" [signed_int,constPointer (recordType iovecTag),signed_int])
+    (decoded [.number 1,.pointer misaligned,.number 1] memory) memory
+  expect (match rejected with | .error _ => true | _ => false)
+    "misaligned iovec record must reject before a native call or base-pointer load"
+  let emptyVectors ← take (CerbHostFilesExtras.prepare .linuxAmd64
+    (admitted "writev" [signed_int,constPointer (recordType iovecTag),signed_int])
+    (decoded [.number 1,.pointer pointer,.number 0] memory) memory)
+  expect (match emptyVectors.extra with | .spans [] => true | _ => false)
+    "zero iovcnt ignores NULL without shifting or checking a record address"
+  expect emptyVectors.inputFootprints.isEmpty "zero iovcnt introduces no memory read"
+  let writeExtra ← take (CerbHostFilesExtras.prepare .linuxAmd64
+    (admitted "write" [signed_int,constPointer void,CellKind.unsignedLong.ty])
+    (decoded [.number 1,.pointer payload,.number 5] memory) memory)
+  expect (match writeExtra.extra with | .bytes bytes => bytes.data == gathered.data | _ => false)
+    "write loads exact original binary span"
+  expect (!writeExtra.inputFootprints.isEmpty) "write bytes retain modeled read footprints"
+  let zeroWrite ← take (CerbHostFilesExtras.prepare .linuxAmd64
+    (admitted "write" [signed_int,constPointer void,CellKind.unsignedLong.ty])
+    (decoded [.number 1,.pointer pointer,.number 0] memory) memory)
+  expect (match zeroWrite.extra with | .bytes bytes => bytes.isEmpty | _ => false)
+    "zero-byte write does not dereference NULL"
+  expect zeroWrite.inputFootprints.isEmpty "zero-byte write has no fabricated read"
+  let setFlags ← take (CerbHostFilesExtras.prepare .linuxAmd64
