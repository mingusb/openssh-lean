diff --git a/lean_frontend/test/Unit/AutomaticMemoTest.lean b/lean_frontend/test/Unit/AutomaticMemoTest.lean
new file mode 100644
index 00000000..d0101549
--- /dev/null
+++ b/lean_frontend/test/Unit/AutomaticMemoTest.lean
@@ -0,0 +1,260 @@
+import CerbMemoPass
+
+set_option trace.CerbMemo.coverage true
+
+inductive TestExpr where
+  | value : Nat → TestExpr
+  | add : TestExpr → TestExpr → TestExpr
+  | variable : Nat → TestExpr
+  deriving Inhabited
+
+@[noinline] def treeSum : TestExpr → Array Nat → Nat
+  | .value n, _ => n
+  | .add a b, env => treeSum a env + treeSum b env
+  | .variable i, env => env[i]?.getD 0
+
+@[noinline] def listSum : List Nat → Nat
+  | [] => 0
+  | x :: xs => x + listSum xs
+
+@[noinline] def fib : Nat → Nat
+  | 0 => 0
+  | 1 => 1
+  | n + 2 => fib (n + 1) + fib n
+
+@[noinline] def selectedFib (n : Nat) : Nat :=
+  CerbMemo.evalSelected (fun _ => fib n)
+
+@[noinline] def next (r : IO.Ref Nat) : IO Nat := do
+  let n ← r.get
+  r.set (n + 1)
+  return n
+
+-- A native implementation with a misleadingly pure type must stay uncached.
+-- The name also checks that a namespace match cannot impersonate Init code.
+@[extern "cerb_memo_test_counter", noinline, never_extract]
+opaque Nat.memoTestCounter (seed : UInt32) : UInt32 := seed
+
+@[noinline] def callNative (n : Nat) : Nat :=
+  (Nat.memoTestCounter n.toUInt32).toNat
+
+@[noinline] def applyCallback (f : Nat → Nat) (values : List Nat) : Nat :=
+  match values with
+  | [] => 0
+  | x :: xs => f x + applyCallback f xs
+
+@[noinline] def callbackPure (x : Nat) : Nat :=
+  applyCallback (fun n => n + 1) [x, x + 1]
+
+@[noinline] def callbackNative (x : Nat) : Nat :=
+  applyCallback callNative [x, x + 1]
+
+@[noinline] def returnCallback (f : Nat → Nat) : Nat → Nat := f
+
+@[noinline] def callbackReturned (n : Nat) : Nat :=
+  let f := returnCallback callNative
+  f n
+
+-- Explicitly cached pure closure exercises disk relocation of returned code.
+@[noinline] def makeAdder (n : Nat) : Nat → Nat :=
+  CerbMemo.eval (fun _ => fun x => n + x)
+
+@[noinline] def applyPureFunction (f : Nat → Nat) (n : Nat) : Nat :=
+  CerbMemo.eval (fun _ => f n)
+
+structure CallbackBox where
+  callbacks : Array (Nat → Nat)
+
+@[noinline] def applyBox (box : CallbackBox) (n : Nat) : Nat :=
+  CerbMemo.eval (fun _ => (box.callbacks[0]?.getD id) n)
+
+-- Real interpreter symbol identifiers exceed the immediate Nat range.
+-- Compacted and heap MPZ objects have different allocation sizes.
+@[noinline] def largeNatResult (n : Nat) : Nat :=
+  CerbMemo.eval (fun _ => n + 19)
+
+@[noinline] def largeIntResult (n : Int) : Int :=
+  CerbMemo.eval (fun _ => n - 7)
+
+-- Reduction of the observed CoreParser scanner: evolving immutable map state
+-- must not turn each tail iteration into a retained memoization snapshot.
+@[noinline] def parserStateLoop : List Nat → Std.HashMap Nat Nat → Std.HashMap Nat Nat
+  | [], state => state
+  | n :: rest, state => parserStateLoop rest (state.insert n (n + 1))
+
+@[noinline] def parserStateResult (count : Nat) : Nat :=
+  (parserStateLoop (List.range count) {}).fold (fun total _ value => total + value) 0
+
+-- The real Core scanner has overlapping two-character patterns. Their shared
+-- fallback becomes a local join point before lambda lifting.
+@[noinline] def parserBranchLoop (fuel : Nat) (state : Std.HashMap Nat Nat)
+    (input : List Nat) : Std.HashMap Nat Nat :=
+  match fuel with
+  | 0 => panic! "parser regression fuel exhausted"
+  | fuel + 1 =>
+    match input with
+    | [] => state
+    | 0 :: 1 :: rest => parserBranchLoop fuel (state.insert 0 1) (1 :: rest)
+    | 1 :: 0 :: rest => parserBranchLoop fuel (state.insert 1 2) (0 :: rest)
+    | n :: rest => parserBranchLoop fuel (state.insert n (n + 1)) rest
+
+@[noinline] def parserBranchResult (count : Nat) : Nat :=
+  (parserBranchLoop (count + 1) {} (List.range count)).fold
+    (fun total _ value => total + value) 0
+
+-- Reduction of the measured stExpect_return wrapper: retaining an entire
+-- evolving state merely to package it in constructors saves no computation.
+@[noinline] def constructorReturn {α ε : Type} (value : α) : Except ε α :=
+  .ok value
+
+@[noinline] def constructorStateReturn {α ε σ : Type} (value : α) (state : σ) :
+    Except ε (α × σ) :=
+  constructorReturn (value, state)
+
+@[noinline] def withPanic (n : Nat) : Nat :=
+  if n == 0 then panic! "memoization panic control" else fib n
+
+@[extern "cerb_memo_identity_entries"]
+opaque identityEntries (_ : Unit) : BaseIO UInt64
+
+unsafe def main (args : List String) : IO UInt32 := do
+  let count := (args[0]?.getD "22").toNat?.getD 22
+  let enabled := args[1]?.getD "on" != "off"
+  CerbMemo.configure enabled
+  let persistent := args[2]?.getD "" == "persist"
+  if !persistent then CerbMemo.reset
+  if args[2]?.getD "" == "selected" then
+    if enabled then throw <| IO.userError "selected-cache check requires broad cache off"
+    let expected := fib count
+    if selectedFib count != expected then
+      throw <| IO.userError "selected cache changed the result"
+    let warm ← CerbMemo.snapshot
+    for _ in [:20] do
+      if selectedFib count != expected then
+        throw <| IO.userError "selected cache changed a repeated result"
+    let after ← CerbMemo.snapshot
+    if warm.entries != 1 || after.misses != warm.misses ||
+        after.hits < warm.hits + 20 then
+      throw <| IO.userError s!"selected cache missed repeated calls: {repr after}"
+    IO.println s!"selected_cache=passed hits={after.hits} misses={after.misses} entries={after.entries}"
+    return 0
+  if args[2]?.getD "" == "state-return" then
+    let input ← IO.mkRef 0
+    let mut state : List Nat := []
+    for i in [:count] do
+      input.set i
+      let n ← input.get
+      state := n :: state
+      match constructorStateReturn (ε := String) n state with
+      | .error message => throw <| IO.userError message
+      | .ok (value, returned) =>
+        if value != n || returned.length != i + 1 then
+          throw <| IO.userError "constructor state changed its result"
+        state := returned
+    let stats ← CerbMemo.snapshot
+    if stats.entries != 0 then
+      throw <| IO.userError s!"constructor-only return retained {stats.entries} states"
+    IO.println s!"state_return=unchanged length={state.length} entries={stats.entries}"
+    return 0
+  if args[2]?.getD "" == "repeated-hits" then
+    let input ← IO.mkRef 37
+    let warm ← input.get
+    if largeNatResult warm != 56 then
+      throw <| IO.userError "repeated-hit warm result mismatch"
+    let before ← identityEntries ()
+    let statsBefore ← CerbMemo.snapshot
+    let mut checksum := 0
+    for _ in [:count] do
+      let n ← input.get
+      checksum := checksum + largeNatResult n
+    let after ← identityEntries ()
+    let statsAfter ← CerbMemo.snapshot
+    if checksum != count * 56 then
+      throw <| IO.userError "repeated-hit result mismatch"
+    if enabled && (statsAfter.misses != statsBefore.misses ||
+        statsAfter.hits < statsBefore.hits + count) then
+      throw <| IO.userError "repeated calls did not hit the cache"
+    if after != before then
+      throw <| IO.userError s!"lookup wrappers retained: {before} -> {after} identities"
+    IO.println s!"lookup_wrappers=stable identities={after} checksum={checksum}"
+    return 0
+  if args[2]?.getD "" == "scanner" || args[2]?.getD "" == "scanner-branch" then
+    let input ← IO.mkRef count
+    let mut previous : Option CerbMemo.Stats := none
+    for _ in [:2] do
+      let n ← input.get
+      let actual := if args[2]?.getD "" == "scanner-branch" then parserBranchResult n
+        else parserStateResult n
+      if actual != n * (n + 1) / 2 then
+        throw <| IO.userError "parser-state result mismatch"
+      let stats ← CerbMemo.snapshot
+      if enabled && stats.entries > 2 then
+        throw <| IO.userError s!"parser iterations retained {stats.entries} cache states"
+      if let some before := previous then
+        if enabled && (stats.misses != before.misses || stats.hits <= before.hits) then
+          throw <| IO.userError "parser entry did not reuse its result"
+      previous := some stats
+      IO.println s!"parser_sum={actual} calls={stats.calls} hits={stats.hits} misses={stats.misses} entries={stats.entries}"
+    return 0
+  if args[2]?.getD "" == "panic" then
+    let value := withPanic 0
+    IO.println s!"unexpected panic result: {value}"
+    return 3
+  let start ← IO.monoNanosNow
+  let r ← IO.mkRef 0
+  let mut checksum := 0
+  for i in [:40] do
+    let x ← next r
+    if x != i then throw <| IO.userError "memoization suppressed an IO effect"
+    -- Construct fresh equal lists and expression trees on every iteration.
+    let observed := callNative (x % 2)
+    if observed != i + 1 + x % 2 then throw <| IO.userError "cache suppressed a native effect"
+    if callbackPure x != 2 * x + 3 then throw <| IO.userError "pure callback mismatch"
+    let input := List.range (count + x % 2)
+    let expected := input.length * (input.length - 1) / 2
+    let actual := listSum input
+    if actual != expected then throw <| IO.userError "list result mismatch"
+    let e := TestExpr.add (.variable 0) (.add (.value count) (.variable 1))
+    let env := #[x, count]
+    let result := treeSum e env
+    if result != x + 2 * count then throw <| IO.userError "state-dependent result mismatch"
+    checksum := checksum + actual + result + fib count
+  -- The native counter was called forty times. Two callback calls must still
+  -- execute, despite their caller and result type looking pure.
+  let callbackInput ← r.get
+  if callbackNative callbackInput != 41 + 40 + 42 + 41 then
+    throw <| IO.userError "cache suppressed effects through a callback"
+  if callbackReturned callbackInput != 43 + 40 then
+    throw <| IO.userError "cache suppressed effects through a returned callback"
+  if persistent then
+    let big := 17266044411312431381 + count
+    if largeNatResult big != big + 19 then
+      throw <| IO.userError "persisted large Nat mismatch"
+    let negative := -(Int.ofNat big)
+    if largeIntResult negative != negative - 7 then
+      throw <| IO.userError "persisted negative Int mismatch"
+    if largeIntResult (Int.ofNat big) != Int.ofNat big - 7 then
+      throw <| IO.userError "persisted positive Int mismatch"
+    let add := makeAdder count
+    if add 7 != count + 7 then throw <| IO.userError "persisted closure mismatch"
+    if applyPureFunction (fun x => x + count) 31 != count + 31 then
+      throw <| IO.userError "persisted callback key mismatch"
+    if applyBox ⟨#[fun x => x + count + 2]⟩ 31 != count + 33 then
+      throw <| IO.userError "persisted nested callback key mismatch"
+  let elapsed := (← IO.monoNanosNow) - start
+  let stats ← CerbMemo.snapshot
+  IO.println s!"enabled={enabled} checksum={checksum} io_calls={← r.get} nanos={elapsed}"
+  IO.println s!"calls={stats.calls} hits={stats.hits} misses={stats.misses} entries={stats.entries}"
+  if persistent then return 0
+  CerbMemo.reset
+  if (← CerbMemo.snapshot).entries != 0 then
+    throw <| IO.userError "reset retained cache entries"
+  -- Re-enter after a nonempty reset with changed inputs; a stale identity would
+  -- return an earlier value and a shared-default table would report a hit.
+  let again := treeSum (.variable 0) #[991]
+  if again != 991 then throw <| IO.userError "reset retained a stale value"
+  let after ← CerbMemo.snapshot
+  if enabled && after.misses <= stats.misses then
+    throw <| IO.userError "reset failed to invalidate stored results"
+  IO.println "reset_and_recompute=ok"
+  return 0
diff --git a/lean_frontend/test/Unit/BoundaryCensusTest.lean b/lean_frontend/test/Unit/BoundaryCensusTest.lean
new file mode 100644
index 00000000..8da60a99
--- /dev/null
+++ b/lean_frontend/test/Unit/BoundaryCensusTest.lean
@@ -0,0 +1,101 @@
+import CerbBoundaryCensus
+
+set_option autoImplicit false
+
+namespace BoundaryCensusTest
+
+private def ensure (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+
+private def mkSymbol (n : Nat) (name : String) : sym :=
+  .Symbol "boundary-census-test" n (.SD_Id name)
+
+private def insert {α : Type} (key : sym) (value : α) (map : Fmap sym α) :=
+  fmapAddBy (fun a b => Lem_Basic_classes.ordCompare a b) key value map
+
+private def pureUnit : pexpr := .Pexpr [] () (.PEval .Vunit)
+private def symbolValue (s : sym) : pexpr := .Pexpr [] () (.PEsym s)
+private def address (s : sym) : pexpr := .Pexpr [] () (.PEcfunction (symbolValue s))
+private def body (node : generic_expr_ Unit Unit sym) : expr Unit := .Expr [] node
+
+private def fixture : file Unit := Id.run do
+  let run := mkSymbol 1 "main"
+  let declared := mkSymbol 2 "external_call"
+  let defined := mkSymbol 3 "external_call"
+  let unused := mkSymbol 4 "unused_header_declaration"
+  let externalData := mkSymbol 5 "external_data"
+  let callback := mkSymbol 6 "callback_arg"
+  let provider := mkSymbol 7 "dlsym"
+  let builtin := mkSymbol 8 "fs_builtin"
+  let globalInit := mkSymbol 9 "initializer"
+  let saved := mkSymbol 10 "saved_callback"
+  let label := mkSymbol 11 "saved_label"
+  let loc := CerbLocation.other "boundary census fixture"
+  let proc := body (.Eunseq [
+    body (.Eccall () pureUnit (address declared) []),
+    body (.Eccall () pureUnit (symbolValue callback) []),
+    body (.Epure (symbolValue externalData)),
+    body (.Eproc () (.Sym provider) []),
+    body (.Eproc () (.Sym builtin) []),
+    body (.Esave (label, .BTy_unit) [(saved, ((.BTy_unit, none), address provider))]
+      (body (.Eexcluded 0 (.Action loc () (.CompareExchangeStrong
+        pureUnit pureUnit pureUnit pureUnit .Seq_cst .Seq_cst))))) ])
+  let mut funs : fun_map Unit := fmapEmpty
+  funs := insert run (.Proc loc none .BTy_unit [(callback, .BTy_object .OTy_pointer)] proc) funs
+  funs := insert declared (.ProcDecl loc .BTy_unit []) funs
+  funs := insert defined (.Proc loc none .BTy_unit [] (body (.Epure pureUnit))) funs
+  funs := insert unused (.ProcDecl loc .BTy_unit []) funs
+  funs := insert provider (.ProcDecl loc .BTy_unit []) funs
+  funs := insert builtin (.BuiltinDecl loc .BTy_unit []) funs
+  let extern : extern_map := fmapAddBy
+    (fun (a : identifier) b =>
+      let .Identifier _ left := a
+      let .Identifier _ right := b
+      Lem_Basic_classes.ordCompare left right)
+    (.Identifier loc "external_call") ([declared], .LK_normal defined) fmapEmpty
+  return {
+    (default : file Unit) with
+    main := some run
+    funs := funs
+    extern := extern
+    stdlib := fmapEmpty
+    impl0 := fmapEmpty
+    globs := [
+      (externalData, .GlobalDecl (.BTy_object .OTy_integer, signed_int)),
+      (globalInit, .GlobalDef (.BTy_object .OTy_pointer,
+        .Ctype [] (.Pointer no_qualifiers signed_int))
+        (body (.Epure (address provider)))) ] }
+
+def run : IO Unit := do
+  let rows := CerbBoundaryCensus.collect fixture
+  ensure (!(rows.any fun row => row.target == some "unused_header_declaration"))
+    "unused header declaration was counted as a boundary"
+  ensure (rows.any fun row => row.kind == "c-call" &&
+    row.target == some "external_call" && row.resolvedKey == some "boundary-census-test:3" &&
+    row.disposition == "supplied-interpreted-body")
+    "actual extern alias was not resolved to its supplied body"
+  ensure (rows.any fun row => row.kind == "indirect-c-call" &&
+    row.disposition == "unclosed-indirect-targets") "indirect call disappeared"
+  ensure (rows.any fun row => row.target == some "external_data" &&
+    row.disposition == "external-data-declaration") "external data disappeared"
+  ensure (rows.any fun row => row.kind == "dynamic-provider") "dynamic loading disappeared"
+  ensure (rows.any fun row => row.disposition == "builtin-dispatch-obligation")
+    "builtin dispatch disappeared"
+  ensure (rows.any fun row => row.ownerKind == "global-initializer" &&
+    row.target == some "dlsym") "global initializer references disappeared"
+  ensure (rows.any fun row => row.kind == "memory-action")
+    "atomic action under saved/excluded body disappeared"
+  ensure (!(rows.any fun row => row.target == some "callback_arg"))
+    "bound local argument was misclassified as an external symbol"
+  let report := CerbBoundaryCensus.report fixture ["fixture.json"] ["source-digest"] none
+  match report.getObjVal? "completeness" with
+  | .error e => throw (IO.userError e)
+  | .ok completeness =>
+    match completeness.getObjValAs? Bool "claim" with
+    | .ok claim => ensure (!claim) "syntax-only census asserted completeness"
+    | .error e => throw (IO.userError e)
+  IO.println "boundary-census-ok"
+
+end BoundaryCensusTest
+
+def main : IO Unit := BoundaryCensusTest.run
