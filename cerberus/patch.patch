+val gnu_boundary_effects_expression:
+  list (Symbol.sym * list Symbol.sym * list Symbol.sym * list Symbol.sym * list Symbol.sym) -> bool ->
+  list Symbol.sym -> list Symbol.sym -> list Symbol.sym -> bool -> list Symbol.sym -> list Symbol.sym ->
+  list Symbol.sym -> list Symbol.sym -> maybe Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_boundary_effects_expression = gnu_boundary_effects_expression_with gnu_boundary_no_return
+
+val gnu_boundary_effects_statement:
+  list (Symbol.sym * list Symbol.sym * list Symbol.sym * list Symbol.sym * list Symbol.sym) -> bool ->
+  list Symbol.sym -> list Symbol.sym -> list Symbol.sym -> bool -> list Symbol.sym -> list Symbol.sym ->
+  list Symbol.sym -> list Symbol.sym -> maybe Symbol.sym ->
+  A.statement GenTypes.genTypeCategory -> A.statement GenTypes.genTypeCategory -> E.elabM bool
+let gnu_boundary_effects_statement = gnu_boundary_effects_statement_with gnu_boundary_no_return
+
+val gnu_opaque_memory_effects:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_opaque_memory_effects expr =
+  gnu_boundary_capture_origins >>= fun (values, roots) ->
+  gnu_boundary_effects_expression [] false [] [] [] false [] [] values roots Nothing expr >>= fun ordinary ->
+  if ordinary || (List.null values && List.null roots) then E.return ordinary else
+    (* An unhandled comparison may be discharged only by the stricter census,
+       using this call site's existing origins, including every visible body. *)
+    gnu_boundary_effects_expression [] true [] [] [] false [] [] values roots Nothing expr
+
+(* This is stability of a compiler-unknown certificate, not stability of the
+   stored pointer. Calls may replace it with another opaque value. A known
+   override prevents preserving a root's default; indexed expressions may name
+   different elements after a call and are deliberately excluded. *)
+(* The complete private-global write census preserves its compiler-unknown
+   class across a call through plain volatile function-pointer storage. The
+   target may vary, but no function can store a known value into this private
+   global without violating that census. Require each argument to pass the
+   same target-specific effect check; do not infer an executable call target. *)
+val gnu_private_global_volatile_call_preserves:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_private_global_volatile_call_preserves subject
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_private_global_volatile_call_preserves subject in
+  match node with
+    | A.AilEcall callee args ->
+        let volatile = match callee with
+          | A.AnnotatedExpression _ _ _ (A.AilErvalue
+              (A.AnnotatedExpression _ _ _ (A.AilEident _) as pointer_object)) ->
+              let (qs, ty) = qualified_ctype_of pointer_object in
+              qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+                AilTypesAux.is_pointer_to_function ty
+          | _ -> false end in
+        if not volatile then E.return false else
+        E.mapM (gnu_boundary_effects_expression [] false [] [] [] false [] [] [] []
+          (Just subject)) args >>= fun checks ->
+        let admitted = List.all (fun checked -> checked) checks in
+        let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr)
+          (fun () -> "GNU retained volatile call " ^ show subject ^
+            "; safe-arguments=" ^ show checks ^ "; admitted=" ^ show admitted) in
+        E.return admitted
+    | A.AilEannot _ child -> self child
+    | A.AilEcast _ _ child -> self child
+    | _ -> E.return false
+  end
+
+val gnu_private_global_memory_survivors:
+  list (A.expression GenTypes.genTypeCategory) ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_private_global_memory_survivors operands =
+  E.gnu_retained_global_pointer_symbols >>= fun globals ->
+  E.gnu_memory_snapshot >>= fun (facts, _, _) ->
+  E.mapM (fun (slot, fact) -> match slot with
+    | (false, sym, []) ->
+        if fact <> E.GNU_inline_unknown_extent_fact ||
+            not (List.any (fun (global, _) -> sym = global) globals) then E.return Nothing else
+        E.mapM (fun operand ->
+          gnu_boundary_effects_expression [] false [] [] [] false [] [] [] [] (Just sym)
+            operand >>= fun ordinary ->
+          if ordinary then E.return true else
+            gnu_private_global_volatile_call_preserves sym operand) operands >>= fun checks ->
+        let preserves = List.all (fun checked -> checked) checks in
+        let () = if preserves then Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+          "GNU private static slot preserved across effects " ^ show sym) else () in
+        E.return (if preserves then Just (slot, fact) else Nothing)
+    | _ -> E.return Nothing end) facts >>= fun optional ->
+  E.return (List.foldr (fun entry rest -> maybe rest (fun item -> item :: rest) entry) [] optional)
+
+val gnu_opaque_memory_survivors:
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym)
+let gnu_opaque_memory_survivors expr =
+  gnu_opaque_memory_effects expr >>= fun opaque ->
+  E.gnu_memory_snapshot >>= fun (facts, roots, _) ->
+  E.gnu_indexed_memory_symbols >>= fun indexed ->
+  let unknown = function E.GNU_inline_unknown_extent_fact -> true | _ -> false end in
+  if not opaque then
+    E.gnu_memory_caller_frame_parameters >>= fun frame ->
+    E.gnu_memory_disjoint_parameters >>= fun disjoint ->
+    E.mapM (fun root ->
+      if List.elem root indexed || not (List.any
+          (fun ((indirect, sym, _), fact) -> indirect && sym = root && unknown fact) facts)
+      then E.return Nothing else
+      let separate = List.foldr (fun (first, second) rest ->
+        let other = if first = root then Just second else if second = root then Just first else Nothing in
+        maybe rest (fun sym -> if List.elem sym rest then rest else sym :: rest) other) [] disjoint in
+      gnu_boundary_effects_expression [] false [] [] [] true separate [] [] [] Nothing expr >>= fun preserves ->
+      let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+        "GNU caller-frame opaque slot " ^ show root ^ "; preserves=" ^ show preserves) in
+      E.return (if preserves then Just root else Nothing)) frame >>= fun certified ->
+    let certified = List.foldr (fun entry rest -> maybe rest (fun sym -> sym :: rest) entry) [] certified in
+    gnu_private_global_memory_survivors [expr] >>= fun static_facts ->
+    (* The call may change the pointee, but cannot rebind an unescaped
+       automatic pointer object that this expression neither writes nor
+       exposes by address. Retain only its existing opaque root, never a
+       stored member value or a root inferred from a missing fact. *)
+    E.mapM (fun root ->
+      if List.elem root indexed ||
+          not (gnu_inline_parameter_expression_safe root expr)
+      then E.return Nothing else
+      E.gnu_alloc_size_subject_allowed root >>= fun unescaped ->
+      E.lookup_gnu_analysis_object_type root >>= fun object_ty ->
+      let ordinary_pointer = match object_ty with
+        | Just (qs, ty) -> not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+            (match ty with
+              | Ctype.Ctype _ (Ctype.Pointer _ pointed) ->
+                  AilTypesAux.is_struct_or_union pointed || AilTypesAux.is_pointer pointed
+              | _ -> false end)
+        | _ -> false end in
+      if not (unescaped && ordinary_pointer) then E.return Nothing else
+      E.gnu_memory_opaque_subobject root [] >>= fun consistent ->
+      E.return (if consistent then Just root else Nothing)) roots >>= fun private_roots ->
+    E.return (static_facts ++ List.filter (fun ((indirect, sym, _), fact) ->
+      indirect && List.elem sym certified && unknown fact) facts,
+      List.foldr (fun item rest -> maybe rest (fun root -> root :: rest) item) [] private_roots)
+  else
+    E.mapM (fun root ->
+      if List.elem root indexed then E.return Nothing else
+      E.gnu_memory_opaque_subobject root [] >>= fun consistent ->
+      E.return (if consistent then Just root else Nothing)) roots >>= fun kept_roots ->
+    E.return (List.filter (fun ((_, sym, _), fact) -> not (List.elem sym indexed) && unknown fact) facts,
+      List.foldr (fun root rest -> maybe rest (fun sym -> sym :: rest) root) [] kept_roots)
+
+(* This checks operand evaluation only, before the outer call takes effect. *)
+val gnu_memory_certified_call_operands:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_memory_certified_call_operands (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEcall callee args ->
+        E.mapM gnu_memory_certified_readonly (callee :: args) >>= fun results ->
+        E.return (List.all (fun result -> result) results)
+    | A.AilEannot _ child -> gnu_memory_certified_call_operands child
+    | A.AilEcast _ _ child -> gnu_memory_certified_call_operands child
+    | _ -> E.return false
+  end
+
+(* A query in the right operand of && or || is classified after the left
+   guard has been translated. Resolving the whole test beforehand can select
+   an arm using an earlier compiler fact while the translated query observes
+   the guarded fact. Keep both runtime arms in that case. *)
+val gnu_contains_constant_p_query: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_contains_constant_p_query (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_contains_constant_p_query in
+  match node with
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) _ -> true
+    | A.AilEbinary left _ right -> self left || self right
+    | A.AilEcond test yes no -> self test || maybe false self yes || self no
+    | A.AilEunary _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEcall callee args -> self callee || List.any self args
+    | _ -> false
+  end
+
+(* Resolve only already-captured closed integer values for branch analysis.
+   The original condition is still translated/evaluated normally. Unknown,
+   volatile and effectful conditions cannot gain a constant from this path;
+   an O0 body retains its separate syntactic-only compiler profile. *)
+val gnu_resolved_closed_condition:
+  Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe integer)
+let gnu_resolved_closed_condition tagDefs condition =
+  let staged_query = match condition with
+    | A.AnnotatedExpression _ _ _ (A.AilEbinary _ A.And right) ->
+        gnu_contains_constant_p_query right
+    | A.AnnotatedExpression _ _ _ (A.AilEbinary _ A.Or right) ->
+        gnu_contains_constant_p_query right
+    | _ -> false end in
+  if staged_query then E.return Nothing else
+  match gnu_scalar_closed_integer tagDefs condition with
+    | Just value -> E.return (Just value)
+    | Nothing ->
+        E.get_gnu_unoptimized_parameters >>= fun unoptimized ->
+        if isJust unoptimized || not (gnu_memory_expression_readonly condition) then E.return Nothing else
+        resolve_gnu_value_origins true tagDefs condition >>= fun resolved ->
+        match gnu_scalar_closed_integer tagDefs resolved with
+          | Just value -> E.return (Just value)
+          | Nothing ->
+              (* Bounds certify every possible result, not merely a feasible
+                 witness. A singleton can select an arm while the original
+                 condition is still translated and evaluated normally. *)
+              gnu_scalar_analyze true tagDefs resolved >>= fun knowledge ->
+              E.return (match knowledge with
+                | Just (low, high, _) -> if low = high then Just low else Nothing
+                | Nothing -> Nothing end)
+        end
+  end
+
+val gnu_memory_call_arguments_readonly: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_memory_call_arguments_readonly (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_asm _ _ _ _ _ _))) _ -> false
+  | A.AilEcall callee args ->
+      gnu_memory_expression_readonly callee && List.all gnu_memory_expression_readonly args
+  | A.AilEannot _ operand -> gnu_memory_call_arguments_readonly operand
+  | A.AilEcast _ _ operand -> gnu_memory_call_arguments_readonly operand
+  | A.AilEunary A.Plus operand -> gnu_memory_call_arguments_readonly operand
+  | A.AilEunary A.Minus operand -> gnu_memory_call_arguments_readonly operand
+  | A.AilEunary A.Bnot operand -> gnu_memory_call_arguments_readonly operand
+  | A.AilEbinary left _ right ->
+      (gnu_memory_call_arguments_readonly left && gnu_size_effects right = Just false) ||
+      (gnu_size_effects left = Just false && gnu_memory_call_arguments_readonly right)
+  | _ -> false
+end
