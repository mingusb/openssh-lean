+(* A standard formatting directive can read scalar/string/pointer arguments,
+   but only %n writes through one. Decode the literal before checking it; raw
+   source escapes cannot hide a conversion. Keep unknown or incomplete syntax
+   outside the effect certificate. Argument evaluation is checked separately.
+   This does not certify argument types, definedness, output or return values. *)
+val gnu_format_no_count_store: bool -> list integer -> bool
+let rec gnu_format_no_count_store conversion bytes = match bytes with
+  | [] -> not conversion
+  | byte :: rest ->
+      if not conversion then gnu_format_no_count_store (byte = 37) rest else
+      if List.elem byte [37; 100; 105; 111; 117; 120; 88; 102; 70; 101; 69;
+          103; 71; 97; 65; 99; 115; 112]
+      then gnu_format_no_count_store false rest else
+      if (48 <= byte && byte <= 57) ||
+          List.elem byte [35; 32; 43; 45; 42; 46; 104; 108; 106; 122; 116; 76]
+      then gnu_format_no_count_store true rest else false
