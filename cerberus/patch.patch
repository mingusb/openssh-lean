+          (* Once a premise fails, later observations are diagnostic only.
+             Do not carry sequential facts through an unproved effect or
+             establish new facts after it; the failed result remains sticky. *)
+          let live_values = if checked then live_values else origin_values in
+          let live_roots = if checked then live_roots else origin_roots in
+          let keep sym = not (List.elem sym initialized) in
