+(* A fortified header function is not an opaque library boundary merely because
+   of its name. Inspect its complete forwarding body, including the compiler
+   object-size operation; this certificate never replaces that runtime call. *)
+val gnu_fortified_snprintf_forwarder: Symbol.sym -> E.elabM bool
+let gnu_fortified_snprintf_forwarder target =
+  E.gnu_inline_template target >>= fun template ->
+  (if isJust template then E.return template else E.gnu_memory_call_body target) >>= function
+    | Just ([destination; capacity; format], body) ->
+        let same sym (A.AnnotatedExpression _ _ _ node) = match node with
+          | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident actual)) -> sym = actual
+          | _ -> false end in
+        (match gnu_format_return_expression body with
+          | Just (A.AnnotatedExpression _ _ _ (A.AilEcall
+              (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_va_arg_pack_call))
+              [callee; first; second; flags; bound; third])) ->
+              let object_query = match bound with
+                | A.AnnotatedExpression _ _ _ (A.AilEcall
+                    (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_object_size _ _)))
+                    [actual]) -> same destination actual
+                | _ -> false end in
+              let character_pointer ty = match ty with
+                | Ctype.Ctype _ (Ctype.Pointer qs (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)))) ->
+                    not qs.Ctype.volatile
+                | _ -> false end in
+              let signature = match ctype_of callee with
+                | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function (_, result)
+                    [(_, dest_ty, _); (_, capacity_ty, _); (_, flag_ty, _);
+                     (_, bound_ty, _); (_, format_ty, _)] true))) ->
+                      gnu_function_target_type_equal result Ctype.signed_int &&
+                      character_pointer dest_ty && character_pointer format_ty &&
+                      gnu_standard_size_type capacity_ty &&
+                      gnu_standard_size_type bound_ty &&
+                      gnu_function_target_type_equal flag_ty Ctype.signed_int
+                | _ -> false end in
+              if not (signature && object_query && same destination first &&
+                  same capacity second && same format third && gnu_inline_closed_integer_origin flags &&
+                  gnu_memory_expression_readonly flags && gnu_inline_direct_designator callee)
+              then E.return false else
+              gnu_inline_function_target callee >>= (function
+                | Nothing -> E.return false
+                | Just (declared, _) -> E.gnu_inline_target declared >>= fun builtin_target ->
+                    E.gnu_has_source_definition builtin_target >>= fun defined ->
+                    E.linker_name declared >>= fun name ->
+                    E.return (not defined && (name = Just "__builtin___snprintf_chk" ||
