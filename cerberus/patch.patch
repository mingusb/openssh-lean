+(* The checked string-copy ABI returns the source string length on normal
+   return, including truncation. Destination and capacity govern writes and
+   termination, not that returned length. This is only a value-dependency
+   certificate; every call and argument effect remains in the collector. *)
+val gnu_strlcpy_chk_signature: Ctype.ctype -> bool
+let gnu_strlcpy_chk_signature ty =
+  let ty = match ty with Ctype.Ctype _ (Ctype.Pointer _ inner) -> inner | _ -> ty end in
+  let character_pointer writable ty = match ty with
+    | Ctype.Ctype _ (Ctype.Pointer qs (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)))) ->
+        not qs.Ctype.volatile && (not writable || not qs.Ctype.const)
+    | _ -> false end in
+  match ty with
+    | Ctype.Ctype _ (Ctype.Function (_, result)
+        [(_, destination, _); (_, source, _); (_, count, _); (_, bound, _)] false) ->
+          gnu_standard_size_type result && character_pointer true destination &&
+          character_pointer false source && gnu_standard_size_type count &&
+          gnu_standard_size_type bound
+    | _ -> false end
