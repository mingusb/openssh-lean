+private def checkOperands [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : CerbTags.TagDefsMap)
+    (argument : PointerValue) (initial : MemState) : IO Unit := do
+  let absentPointer := nullPtrval void
+  let (unused, unusedReads, _) ← take (CerbHostFilesOperands.prepareOpenArgs
+    .linuxAmd64 enums tags 0 [(void,absentPointer)] initial)
+  ensure (unused.isNone && unusedReads.isEmpty) "unused open varargs must never be loaded"
+  ensure (fails (CerbHostFilesOperands.prepareOpenArgs .linuxAmd64 enums tags 64 [] initial))
+    "missing required Linux mode stays explicit"
+  ensure ((← take (CerbHostFilesOperands.needsMode .linuxAmd64 4259840)) &&
+    !(← take (CerbHostFilesOperands.needsMode .linuxAmd64 4194304)) &&
+    (← take (CerbHostFilesOperands.needsMode .cerberusAbstract 32)) &&
+    !(← take (CerbHostFilesOperands.needsMode .cerberusAbstract 64)))
+    "mode presence must use the selected profile and complete TMPFILE mask"
+  let operandState := initial
+  let modeLease ← take (prepareOutputs enums tags [⟨argument,.signedInt⟩] operandState)
+  let (_, operandState) ← take (commitOutputs enums tags modeLease [-1])
+  let (linuxMode, linuxReads, _) ← take (CerbHostFilesOperands.prepareOpenArgs
+    .linuxAmd64 enums tags 64 [(signed_int,argument)] operandState)
+  let (abstractMode, abstractReads, _) ← take (CerbHostFilesOperands.prepareOpenArgs
+    .cerberusAbstract enums tags 32 [(signed_int,argument)] operandState)
+  ensure (linuxMode == some 4294967295 && abstractMode == some 65535 &&
+    linuxReads.length == 1 && abstractReads.length == 1)
+    "promoted int mode is loaded once and converted to the actual mode_t width"
+  let unsignedLease ← take (prepareOutputs enums tags [⟨argument,.unsignedInt⟩] operandState)
+  let (_, operandState) ← take (commitOutputs enums tags unsignedLease [384])
+  let (unsignedMode, _, _) ← take (CerbHostFilesOperands.prepareOpenArgs
+    .linuxAmd64 enums tags 64 [(unsigned_int,argument)] operandState)
+  ensure (unsignedMode == some 384) "representable corresponding unsigned mode is admitted"
+  for offsetType in [CellKind.signedLong.ty, .Ctype [] (.Basic (.Integer (.Signed .LongLong)))] do
+    let .Ctype _ (.Basic (.Integer integerType)) := offsetType | throw (IO.userError "offset fixture type")
+    let (_, offsetState) ← take (immediate
+      (storeM enums tags (CerbLocation.other "offset fixture") offsetType false argument
+        (.MVinteger integerType (.IV .Prov_none 4294967301))) operandState)
+    let (offset, reads, _) ← take (CerbHostFilesOperands.readOffsetArgument
+      enums tags offsetType argument offsetState)
+    ensure (offset == 4294967301 && reads.length == 1)
+      "lseek must load the complete offset through its original declared type"
+
+private def checkCopiedWrite [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : CerbTags.TagDefsMap)
+    (resolve : Int → Except String UInt32) (errnoPointer output : PointerValue)
+    (state : MemState) : IO MemState := do
+  let bytes := [Char.ofNat 65, Char.ofNat 0, Char.ofNat 255, Char.ofNat 66, Char.ofNat 67]
+  let request ← take (CerbHostFilesFS.decode none (.FS_WRITE 43 bytes 5))
+  ensure (fails (CerbHostFilesFS.decode none (.FS_WRITE 43 bytes 4)))
+    "FS_WRITE rejects mismatched producer span"
+  ensure (fails (CerbHostFilesFS.decode none (.FS_WRITE 43 [Char.ofNat 256] 1)))
+    "FS_WRITE rejects non-byte characters"
+  let prepared ← take (prepare enums tags resolve [] 0 errnoPointer request state)
+  let native ← executeNative prepared
+  let completed ← take (complete enums tags prepared native)
+  ensure (completed.returnValue == 5 && completed.nativeErrnoAfter == 4294967225 &&
+    completed.written.map (fun item => (item.1,item.2.data)) == some (43,#[65,0,255,66,67]))
+    "copied write keeps exact bytes, descriptor and success errno"
+  let read ← take (prepare enums tags resolve [] 0 errnoPointer (.read 42 5 output) completed.memory)
+  let received ← take (complete enums tags read (← executeNative read))
+  let (copied, _, memory) ← take (readBytes enums tags output 5 received.memory)
+  ensure (received.returnValue == 5 && copied.data == #[65,0,255,66,67])
+    "copied write reached the actual native pipe once"
+  return memory
+
+private def run [LemFuel] [CerbGlobal.Switches] : IO Unit := do
+  let enums : EnumDefs := fmapEmpty
+  let tags : CerbTags.TagDefsMap := metadataTags
+  let (base, initial) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 4096))
+    (initialMemState 65536))
+  let locate (offset : Int) (state : MemState) :=
+    immediate (effArrayShiftPtrval enums tags (CerbLocation.other "file guest fixture")
+      base unsigned_char (.IV .Prov_none offset)) state
+  let errnoCell : Cell := ⟨base, .signedInt⟩
+  let lease ← take (prepareOutputs enums tags [errnoCell] initial)
+  let (_, initial) ← take (commitOutputs enums tags lease [-71])
+  let (template, initial) ← take (locate 16 initial)
+  let (input, initial) ← take (locate 128 initial)
+  let (input3, initial) ← take (locate 131 initial)
+  let (output, initial) ← take (locate 256 initial)
+  let (pipeOutput, initial) ← take (locate 2048 initial)
+  let (missing, initial) ← take (locate 3072 initial)
+  let setBytes (pointer : PointerValue) (bytes : ByteArray) (state : MemState) := do
+    let (cells, state) ← arrayCells enums tags .byte pointer bytes.size state
+    let lease ← prepareOutputs enums tags cells state
+    commitOutputs enums tags lease (bytes.data.toList.map fun b => (b.toNat : Int))
+  let (_, initial) ← take (setBytes template (stringBytes "/tmp/cerb-files-guest-XXXXXX") initial)
+  let payload : ByteArray := ⟨#[65,0,255,66,67]⟩
+  let (_, initial) ← take (setBytes input payload initial)
+  let (_, initial) ← take (setBytes output ⟨Array.replicate 16 (170 : UInt8)⟩ initial)
+  let (exact, _, _) ← take (readCString enums tags input 8 initial)
+  ensure (exact.data == #[65,0]) "pathname reading must stop at first NUL"
+  ensure (fails (readCString enums tags input 1 initial)) "NUL fuel exhaustion is explicit"
+  let (unbounded, _, _) ← take (readCStringUnbounded enums tags input initial)
+  ensure (unbounded == exact) "operational pathname reading reaches the same first NUL without fuel"
+  let highByte ← take (copiedCString (String.ofList [Char.ofNat 255]))
+  ensure (highByte.data == #[255,0]) "copied C paths preserve byte values rather than UTF-8 encoding"
+  let emptyPath ← take (copiedCString "")
+  ensure (emptyPath.data == #[0]) "empty copied pathname is the native empty C string"
+  ensure (fails (copiedCString (String.ofList [Char.ofNat 0]))) "embedded NUL is impossible in copied listFromStr output"
+  ensure (fails (copiedCString (String.ofList [Char.ofNat 256]))) "non-byte copied path is rejected before an effect"
+  let (argument, operandState) ← take (locate 3584 initial)
+  checkOperands enums tags argument operandState
+  let rejectFD (_ : Int) : Except String UInt32 := .error "guest descriptor has no live mapping"
+  let owned ← IO.mkRef ([] : List UInt32)
+  let createdPath ← IO.mkRef ByteArray.empty
+  let remember (n : UInt32) := owned.modify (n :: ·)
+  let forget (n : UInt32) := owned.modify (List.filter (· != n))
+  try
+    let pending ← take (prepare enums tags rejectFD [40] 128 base (.mkstemp template) initial)
+    let native ← executeNative pending
+    if native.status.value >= 0 then remember native.status.value.toNat.toUInt32
+    if native.status.value >= 0 then createdPath.set native.bytes
+    let created ← take (complete enums tags pending native)
+    ensure (created.returnValue == 40 && created.descriptorTransfers.length == 1)
+      "mkstemp must return reserved guest fd and one ownership transfer"
+    let nativeFD := created.descriptorTransfers[0]!.2
+    let resolve (guest : Int) : Except String UInt32 :=
+      if guest == 40 then .ok nativeFD else rejectFD guest
+    let (path, _, state) ← take (readCString enums tags template 128 created.memory)
+    ensure (path.data == native.bytes.data) "mkstemp mutated template must be copied into modeled allocation"
+    let access ← take (prepare enums tags resolve [] 128 base (.access template 0) state)
+    let accessed ← take (complete enums tags access (← executeNative access))
+    ensure (accessed.returnValue == 0) "modeled path must name created native file"
+    let write ← take (prepare enums tags resolve [] 128 base
+      (.writev 40 [⟨input,3⟩,⟨input3,2⟩]) accessed.memory)
+    let written ← take (complete enums tags write (← executeNative write))
+    ensure (written.returnValue == 5 && written.written.map (fun x => x.2.data) == some payload.data)
+      "writev must preserve binary spans and report actual prefix"
+    let seek ← take (prepare enums tags resolve [] 128 base (.lseek 40 0 0) written.memory)
+    let sought ← take (complete enums tags seek (← executeNative seek))
+    ensure (sought.returnValue == 0) "lseek must change shared native open-file offset"
+    let read ← take (prepare enums tags resolve [] 128 base (.read 40 10 output) sought.memory)
+    let response ← executeNative read
+    let readResult ← take (complete enums tags read response)
+    ensure (readResult.returnValue == 5) "short read must retain native count"
+    let (bytes, _, state) ← take (readBytes enums tags output 10 readResult.memory)
+    ensure (bytes.data == #[65,0,255,66,67,170,170,170,170,170])
+      "read must write only prefix, preserve embedded zero and avoid trailing NUL"
+    let eof ← take (prepare enums tags resolve [] 128 base (.read 40 10 output) state)
+    let eofResult ← take (complete enums tags eof (← executeNative eof))
+    let (bytes, _, state) ← take (readBytes enums tags output 10 eofResult.memory)
+    ensure (eofResult.returnValue == 0 && bytes.data == #[65,0,255,66,67,170,170,170,170,170])
+      "EOF must leave output bytes untouched"
+    let bad ← take (prepare enums tags resolve [] 128 base (.read (-1) 10 output) state)
+    let badNative ← executeNative bad
+    let badResult ← take (complete enums tags bad badNative)
+    let (bytes, _, state) ← take (readBytes enums tags output 10 badResult.memory)
+    ensure (badResult.returnValue == -1 && badNative.status.error == 9 &&
+      bytes.data == #[65,0,255,66,67,170,170,170,170,170])
+      "EBADF preserves output bytes and is never retried"
+    let (err, _, state) ← take (readInteger enums tags errnoCell state)
+    ensure (err == 9) "native errno must be written through actual modeled store"
+    let readonly := { state with allocations := state.allocations.map fun _ allocation =>
+      { allocation with isReadonly := .IsReadOnly .ReadonlyConstQualified } }
+    ensure (fails (prepare enums tags resolve [] 128 base (.read 40 10 output) readonly))
