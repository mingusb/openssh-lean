+          gnu_alloc_size_subject_unescaped sym whole_body) (List.map fst bindings) in
+        (* The existing global-write census is also a body-local origin
+           certificate. Check every write, including initializers and branches;
+           a caller snapshot or a missing fact is never used for this purpose. *)
+        let candidates = List.filter (fun (sym, (_, _, _, ty)) ->
+          List.elem sym private_bindings && AilTypesAux.is_pointer ty &&
+            not (AilTypesAux.is_pointer_to_function ty)) bindings in
+        E.mapM (fun (sym, _) ->
+          gnu_global_opaque_statement false [] sym whole_body >>= fun result ->
+          E.return (if result = Just true then Just sym else Nothing)) candidates >>= fun certified ->
+        let opaque_locals = List.foldr (fun value rest ->
+          maybe rest (fun sym -> sym :: rest) value) opaque_locals certified in
+        let origin_candidates = List.foldr (fun (sym, (_, _, qs, ty)) rest ->
+          if not (List.elem sym rest) && not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
