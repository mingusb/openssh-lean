+#!/usr/bin/env python3
+import argparse, hashlib, json, re
+from pathlib import Path
+
+NUMBER={"signedInt","unsignedInt","signedLong","unsignedLong"}
+POINTER={"charPointer","constCharPointer","voidPointer","constVoidPointer","intPointer","statPointer","statvfsPointer","constTimevalPointer","constTimespecPointer","constIovecPointer"}
+EXTRA={"conditionalOpenMode":"openMode","conditionalFcntlInt":"fcntlArgument","timevalPair":"times","timespecPair":"times","iovecSpans":"spans","inputBytes":"bytes"}
+
+def clause(api, source):
+    name=api["symbol"]; params=source[name]["parameters"]
+    pats=[]; ts=[]
+    for i,k in enumerate(params):
+        pats.append(f".number n{i}" if k in NUMBER else f".pointer p{i}")
+        ts.append(f"t{i}" if ("statPointer" in k or "statvfsPointer" in k) else "_")
+    extra=api.get("extra")
+    epat="Extra.none" if extra is None else {
+      "conditionalOpenMode":"Extra.openMode mode",
+      "conditionalFcntlInt":"Extra.fcntlArgument argument",
+      "timevalPair":"Extra.times times",
+      "timespecPair":"Extra.times times",
+      "iovecSpans":"Extra.spans spans",
+      "inputBytes":"Extra.bytes bytes"}[extra]
+    expr=api["request"].replace("extra.mode","mode").replace("extra.argument","argument").replace("extra.times","times").replace("extra.spans","spans").replace("extra.bytes","bytes")
+    expr=re.sub(r"\(record (p\d+) (t\d+)\)",r"(← record \1 \2)",expr)
+    return f'  | "{name}", [{", ".join(pats)}], [{", ".join(ts)}], {epat} => return {expr}'
+
+def main():
+    p=argparse.ArgumentParser(); p.add_argument("--source",type=Path,required=True); p.add_argument("--requests",type=Path,required=True); p.add_argument("--output",type=Path,required=True); p.add_argument("--check",action="store_true"); a=p.parse_args()
+    s=json.loads(a.source.read_text()); q=json.loads(a.requests.read_text())
+    source={x["symbol"]:x for x in s["apis"]}; source.update({x["symbol"]:x for x in s["unresolved"] if "parameters" in x})
+    names=[x["symbol"] for x in q["apis"]]
+    if len(names)!=46 or len(set(names))!=46 or q["guest_interface_count"]!=46: raise ValueError("request contract must cover exactly 46 unique guest APIs")
+    missing=[x for x in names if x not in source]
+    if missing: raise ValueError("request APIs lack source contracts: "+repr(missing))
+    rows="\n".join(clause(x,source) for x in q["apis"])
+    template=(Path(__file__).parent/"templates/files_requests.lean.in").read_text()
+    data=template.replace("@REQUESTS@",rows)
+    out=a.output/"CerbHostFilesRequests.lean"; a.output.mkdir(parents=True,exist_ok=True)
+    manifest={"schema":1,"guest_interfaces":46,"fixed_admitted":len(s["apis"]),"typed_variadic_routes":len(s["unresolved"]),"source_sha256":hashlib.sha256(a.source.read_bytes()).hexdigest(),"requests_sha256":hashlib.sha256(a.requests.read_bytes()).hexdigest(),"generator_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),"output_sha256":hashlib.sha256(data.encode()).hexdigest(),"compiled":False,"executed":False}
+    mtext=json.dumps(manifest,indent=2,sort_keys=True)+"\n"; mp=a.output/"files-requests-manifest.json"
+    if a.check:
+      if not out.exists() or out.read_text()!=data or not mp.exists() or mp.read_text()!=mtext: raise SystemExit("stale generated files request artifacts")
+    else: out.write_text(data); mp.write_text(mtext)
+    print(json.dumps({"requests":46,"fixed_admitted":len(s["apis"]),"typed_variadic_routes":len(s["unresolved"]),"checked":a.check}))
+if __name__=="__main__": main()
