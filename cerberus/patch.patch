+(* A specialization compiles after its caller has finished translation;
+   exact cached instances may form recursive edges, while ancestry prevents
+   expansion into uncached facts along a recursive cycle. The queue is drained
+   before collected string literals become globals. *)
+let rec drain_gnu_inline_specializations stdlib core_tagDefs sigm cfuns funinfo =
+  E.take_gnu_inline >>= function
+    | Nothing -> E.return (cfuns, funinfo)
+    | Just (source, facts, aliases, pack_count, captures, target, ancestors) ->
+        (match (List.lookup source sigm.A.declarations,
+                List.lookup source sigm.A.function_definitions) with
+          | (Just (_, attrs, A.Decl_function has_proto (_, ret_ty) params is_variadic is_inline is_Noreturn),
+             Just definition) ->
+              let (definition_loc, marker, storage, param_syms, stmt) = definition in
+              let source_named_count = List.length params in
+              let definition = (definition_loc, marker, storage, param_syms ++ List.map fst captures, stmt) in
+              let params = params ++ List.map (fun (_, ty) -> (Ctype.no_qualifiers, ty, false)) captures in
+              E.with_gnu_inline_call_sites target
+                (E.with_function_scope (source :: ancestors) facts aliases
+                (E.with_gnu_va_pack_count pack_count
+                  (translate_function_definition stdlib core_tagDefs Nothing source attrs
+                    ret_ty params is_variadic is_inline is_Noreturn has_proto source_named_count definition))) >>= fun (proc, info) ->
+              drain_gnu_inline_specializations stdlib core_tagDefs sigm
+                (Map.insert target proc cfuns) (Map.insert target info funinfo)
+          | _ ->
+              E.record_error_at Loc.unknown "GNU inline specialization lost its typed source definition" >>
+              drain_gnu_inline_specializations stdlib core_tagDefs sigm cfuns funinfo
+        end)
+  end
