+(* Ordered disjoint integer intervals retain the holes in a boolean guard's
+   truth set. In particular the complement of n = k is not a dense interval.
+   Arithmetic here is mathematical integer arithmetic, not target C arithmetic. *)
+val gnu_scalar_interval_insert:
+  integer * integer -> list (integer * integer) -> list (integer * integer)
+let rec gnu_scalar_interval_insert (low, high) intervals =
+  if low > high then intervals else match intervals with
+    | [] -> [(low, high)]
+    | (first, last) :: rest ->
+        if high+1 < first then (low, high) :: intervals else
+        if last+1 < low then (first, last) :: gnu_scalar_interval_insert (low, high) rest else
+        gnu_scalar_interval_insert (min low first, max high last) rest
+  end
