+#!/usr/bin/env bash
+# Read-only verification of maintained contracts and exact generated output.
+set -euo pipefail
+task_root="$(cd "$(dirname "$0")/.." && pwd)"
+host_lean_outputs=(
+  CerbHostSystem.lean CerbHostSystemMemory.lean CerbHostSystemOutput.lean CerbHostSystemOutputHandler.lean
+  CerbHostWorkerBootstrap.lean CerbHostAdapters.lean CerbHostFilesAdapters.lean CerbHostFilesGuest.lean
+  CerbHostFilesFS.lean CerbHostFilesOperands.lean CerbHostFilesAdmission.lean
+  CerbHostFilesRequests.lean CerbHostFilesExtras.lean CerbHostMemoryCells.lean
+  CerbHostNetworkGuest.lean CerbHostDescriptors.lean CerbHostDescriptorPolicies.lean
+  CerbHostNetworkAdapters.lean CerbHostNetworkAdmission.lean CerbHostNetworkHandler.lean
+)
+if [[ ${1:-} == --print-lean-outputs ]]; then
+  printf '%s\n' "${host_lean_outputs[@]}"
+  exit 0
+fi
+task_quiet=false
+if [[ $# == 1 && "$1" == "--quiet" ]]; then
+  task_quiet=true
+elif [[ $# != 0 ]]; then
+  echo "check_host_adapters: unknown argument" >&2
+  exit 2
+fi
+check_generator() {
+  if $task_quiet; then
+    python3 "$task_root/$1" --contracts "$task_root/$2" --output "$task_root/lean_frontend/generated" --check >/dev/null
+  else
+    python3 "$task_root/$1" --contracts "$task_root/$2" --output "$task_root/lean_frontend/generated" --check
+  fi
+}
+check_generator lean_frontend/host/bootstrap/generate_worker_bootstrap.py lean_frontend/host/bootstrap/bootstrap-contracts.json
+check_generator scripts/generate_host_adapters.py lean_frontend/host/host-contracts.json
