+val gnu_scalar_guard_object:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe (E.gnu_memory_slot * Ctype.ctype))
+let rec gnu_scalar_guard_object (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_integer ty) then E.return Nothing else
+        gnu_memory_slot_of true operand >>= fun slot -> E.return (maybe Nothing (fun slot -> Just (slot, ty)) slot)
