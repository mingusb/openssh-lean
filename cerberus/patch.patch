+(* A nonconstant guard can correlate its operands. Keep old numerical
+   bounds, withdraw density/attainability, and restore variation only for a
+   separately certified independent subject. This never constructs a missing
+   compiler certificate from the subject's type. *)
+let gnu_scalar_guard_invalidate tagDefs condition =
+  let invalidate =
+    E.gnu_scalar_independent_snapshot (fun sym ->
+      gnu_scalar_query_only_expression sym condition) >>= fun retained ->
+    E.forget_gnu_scalar_variation >>
+    E.restore_gnu_scalar_independent_facts retained in
+  E.retain_gnu_scalar_compiler_nonconstant
+    (fun sym -> gnu_scalar_query_only_expression sym condition) >>
+  gnu_scalar_knowledge_of tagDefs condition >>= function
+    | Just (low, high, _) -> if low = high then E.return () else invalidate
+    | Nothing -> invalidate
+  end
