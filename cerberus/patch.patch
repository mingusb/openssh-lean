+(* Scalar identities may ignore exactly the same spelling/origin metadata as
+   allocation-size rebinding. Numeric representation and other attributes still
+   have to agree; no narrowing or signedness-changing cast becomes an identity. *)
+val gnu_scalar_value_type_equal: Ctype.ctype -> Ctype.ctype -> bool
+let gnu_scalar_value_type_equal left right =
+  gnu_function_target_type_equal left right || gnu_alloc_size_rebind_type_equal left right
