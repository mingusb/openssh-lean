+(* Strip only pointer-preserving syntax around an actual offset. The original
+   argument remains unchanged in executable Core; this classifies metadata. *)
+val gnu_inline_pointer_offset:
+  A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory * A.expression GenTypes.genTypeCategory * Ctype.ctype * bool)
+let rec gnu_inline_pointer_offset (A.AnnotatedExpression _ _ _ node) =
+  let pair pointer index subtract = match ctype_of pointer with
+    | Ctype.Ctype _ (Ctype.Pointer _ element_ty) -> Just (pointer, index, element_ty, subtract)
+    | _ -> Nothing end in
+  match node with
+    | A.AilEbinary left (A.Arithmetic A.Add) right ->
+        if AilTypesAux.is_pointer (ctype_of left) && AilTypesAux.is_integer (ctype_of right)
+        then pair left right false
+        else if AilTypesAux.is_pointer (ctype_of right) && AilTypesAux.is_integer (ctype_of left)
+        then pair right left false else Nothing
+    | A.AilEbinary left (A.Arithmetic A.Sub) right ->
+        if AilTypesAux.is_pointer (ctype_of left) && AilTypesAux.is_integer (ctype_of right)
+        then pair left right true else Nothing
+    | A.AilEannot _ operand -> gnu_inline_pointer_offset operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+        then gnu_inline_pointer_offset operand else Nothing
+    | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEunary A.Indirection operand)) ->
+        gnu_inline_pointer_offset operand
+    | _ -> Nothing
+  end
