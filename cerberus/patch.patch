+    | A.AilEunary A.PostfixIncr left ->
+        gnu_memory_slot_of true left >>= fun written ->
+        E.return (maybe true (fun slot -> not (List.elem slot protected)) written)
+    | A.AilEunary A.PostfixDecr left ->
+        gnu_memory_slot_of true left >>= fun written ->
