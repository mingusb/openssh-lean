+    let closeResult ← take (complete enums tags close (← executeNative close))
+    if closeResult.releasedGuests == [41] then forget duplicateFD
+    ensure (closeResult.returnValue == 0 && closeResult.releasedGuests == [41])
+      "close must release exactly the mapped guest descriptor"
+    ensure (fails (prepare enums tags resolve [] 128 base (.close 41) closeResult.memory))
+      "released nonnegative guest cannot accidentally close a native fd"
+    let (metadataPointer, state) ← take (locate 1024 closeResult.memory)
+    ensure (fails (prepare enums tags resolve [] 128 base
+      (.fstat 40 ⟨metadataPointer, unsigned_int⟩) state))
+      "metadata output must have its complete compatible declared record"
+    let stat ← take (prepare enums tags resolve [] 128 base
+      (.fstat 40 ⟨metadataPointer, statType⟩) state)
+    let statNative ← executeNative stat
+    let statResult ← take (complete enums tags stat statNative)
+    let sizePointer := memberShiftPtrval enums tags metadataPointer statTag
+      (.Identifier CerbLocation.unknown "st_size")
+    let (size, _, state) ← take (readInteger enums tags ⟨sizePointer,.signedLong⟩ statResult.memory)
+    ensure (statResult.returnValue == 0 && size == 5 && statNative.fields[7]! == 5)
+      "typed metadata field must reconstruct through real model memory"
+    let (representation, _, state) ← take (readBytes enums tags metadataPointer 144 state)
+    ensure (representation == statNative.bytes)
+      "complete metadata object bytes, padding and reserved fields must be copied exactly"
+    let (filesystemPointer, state) ← take (locate 1280 state)
+    let filesystem ← take (prepare enums tags resolve [] 128 base
+      (.fstatvfs 40 ⟨filesystemPointer, statvfsType⟩) state)
+    let filesystemNative ← executeNative filesystem
+    let filesystemResult ← take (complete enums tags filesystem filesystemNative)
+    let (representation, _, state) ← take (readBytes enums tags filesystemPointer 112 filesystemResult.memory)
+    ensure (filesystemResult.returnValue == 0 && representation == filesystemNative.bytes &&
+      filesystemNative.fields.size == 12)
+      "full statvfs representation includes modern f_type and all spare bytes"
+    let errnoLease ← take (prepareOutputs enums tags [errnoCell] state)
+    let (_, state) ← take (commitOutputs enums tags errnoLease [-71])
+    let pipe ← take (prepare enums tags resolve [42,43] 128 base (.pipe pipeOutput) state)
+    let pipeNative ← executeNative pipe
+    if pipeNative.status.value == 0 then
+      for fd in pipeNative.fields.toList do remember fd.toUInt32
+    let piped ← take (complete enums tags pipe pipeNative)
+    let (pipeCells, state) ← take (arrayCells enums tags .signedInt pipeOutput 2 piped.memory)
+    let [firstCell, secondCell] := pipeCells | throw (IO.userError "pipe output cell arity")
+    let (first, _, state) ← take (readInteger enums tags firstCell state)
+    let (second, _, state) ← take (readInteger enums tags secondCell state)
+    let (err, _, state) ← take (readInteger enums tags errnoCell state)
+    ensure (first == 42 && second == 43 && piped.descriptorTransfers.length == 2 && err == -71)
+      "pipe writes reserved guest IDs and preserves signed incoming errno on success"
+    let pipeResolve (guest : Int) : Except String UInt32 := do
+      let some (_, native) := piped.descriptorTransfers.find? (fun pair => pair.1 == guest)
+        | .error "unknown pipe guest descriptor"
+      return native
+    let state ← checkCopiedWrite enums tags pipeResolve base output state
+    let missingPath := (String.fromUTF8! (⟨path.data.pop⟩)).toUTF8
+    let missingBytes := (missingPath.data.toList ++ (".missing".toUTF8.data.toList) ++ [0]).toArray
+    let (_, state) ← take (setBytes missing ⟨missingBytes⟩ state)
+    let absent ← take (prepare enums tags resolve [44] 128 base (.«open» missing 0 none) state)
+    let absentNative ← executeNative absent
+    let absentResult ← take (complete enums tags absent absentNative)
+    ensure (absentResult.returnValue == -1 && absentNative.status.error == 2 &&
+      absentResult.descriptorTransfers.isEmpty)
+      "failed open returns ENOENT and cancels its guest reservation"
+    -- Exercise actual Core FS constructors through generated conversion, while
+    -- retaining the preceding pointer-based tests and their original outcomes.
+    let copiedPath := String.ofList ((path.data.toList.take (path.size - 1)).map
+      (fun byte => Char.ofNat byte.toNat))
