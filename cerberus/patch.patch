+(* A literal null object pointer can undergo the ordinary call conversion
+   without introducing an allocation or a differently typed memory view.
+   This value-sensitive exception must not admit arbitrary void pointers. *)
+val gnu_origin_actual_compatible:
+  Ctype.ctype -> A.expression GenTypes.genTypeCategory -> bool
+let gnu_origin_actual_compatible formal actual =
+  gnu_origin_argument_compatible formal (ctype_of actual) ||
+    (gnu_literal_null_pointer actual && match (formal, ctype_of actual) with
+      | (Ctype.Ctype formal_annotations (Ctype.Pointer _ pointed),
+         Ctype.Ctype actual_annotations (Ctype.Pointer _ actual_pointed)) ->
+          not (AilTypesAux.is_function pointed || AilTypesAux.is_function actual_pointed) &&
+          not (AilTypesAux.is_atomic pointed || AilTypesAux.is_atomic actual_pointed) &&
+          gnu_function_target_annotations formal_annotations =
+            gnu_function_target_annotations actual_annotations
+      | _ -> false end)
