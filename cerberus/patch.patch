+(* A branch fact about a pointer object is unsafe if that object's address
+   escaped earlier: even a subsequent no-argument call could then mutate it.
+   Restrict subjects to automatic objects/parameters proven unchanged over the
+   whole function. Initializing a local declaration is allowed; later writes
+   and every address escape are rejected by the existing expression walk. *)
+val gnu_branch_symbol_unchanged: Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_branch_symbol_unchanged sym stmt =
+  let self = gnu_branch_symbol_unchanged sym in
+  let expr = gnu_inline_parameter_expression_safe sym in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSdeclaration declarations -> List.all (fun (_, value) -> maybe true expr value) declarations
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif test left right -> expr test && self left && self right
+    | A.AilSwhile test body _ -> expr test && self body
+    | A.AilSdo body test _ -> self body && expr test
+    | A.AilSswitch test body -> expr test && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSpar statements -> List.all self statements
+    | A.AilSmarker _ body -> self body
+    | _ -> gnu_inline_parameter_unchanged sym stmt
+  end
+
+val gnu_scalar_query_only_statement: Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_scalar_query_only_statement sym stmt =
+  let self = gnu_scalar_query_only_statement sym in
+  let expr = gnu_scalar_query_only_expression sym in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif test yes no -> expr test && self yes && self no
+    | A.AilSwhile test body _ -> expr test && self body
+    | A.AilSdo body test _ -> self body && expr test
+    | A.AilSreturnVoid -> true
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch test body -> expr test && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSdeclaration declarations -> List.all (fun (target, value) ->
+        target <> sym && maybe true expr value) declarations
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+(* Guard-local subjects cannot export their value into another object. Each
+   observing guard mentions only this subject and closed literals/types;
+   every other use must be inside an unevaluated compiler query. Conditional
+   joins still retain only identical certificates. Mixed-object guards,
+   value copies, address escapes and hidden control reject this certificate. *)
+val gnu_scalar_guard_local_expression:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_scalar_guard_local_expression sym (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_scalar_guard_local_expression sym in
+  match node with
+    | A.AilEident other -> sym = other
+    | A.AilEconst _ -> true
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEcast _ ty operand -> AilTypesAux.is_integer ty && self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEsizeof _ ty -> gnu_inline_fixed_object_type ty
+    | A.AilEsizeof_expr operand -> gnu_inline_fixed_object_type (ctype_of operand)
+    | A.AilEalignof _ ty -> gnu_inline_fixed_object_type ty
+    | A.AilEoffsetof ty _ -> gnu_inline_fixed_object_type ty
+    | _ -> false
+  end
+
+val gnu_scalar_independent_statement:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_scalar_independent_statement sym stmt =
+  let self = gnu_scalar_independent_statement sym in
+  let expr = gnu_scalar_query_only_expression sym in
+  let guard operand = expr operand || gnu_scalar_guard_local_expression sym operand in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock bindings statements ->
+        List.all (fun (_, (_, _, _, ty)) -> gnu_inline_fixed_object_type ty) bindings &&
+        gnu_scalar_independent_sequence sym Nothing statements
+    | A.AilSif test yes no -> guard test && self yes && self no
+    | A.AilSwhile test body _ -> guard test && self body
+    | A.AilSdo body test _ -> self body && guard test
+    | A.AilSreturnVoid -> true
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch test body -> guard test && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body Nothing -> self body
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSgoto _ -> true
+    | A.AilSdeclaration declarations -> List.all (fun (target, value) ->
+        target <> sym && maybe true expr value) declarations
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+and gnu_scalar_independent_sequence sym skipping statements = match statements with
+  | [] -> skipping = Nothing
+  | statement :: rest -> match skipping with
+      | Just target -> match statement.A.node with
+          | A.AilSlabel label _ Nothing -> label = target &&
+              gnu_scalar_independent_statement sym statement &&
+              gnu_scalar_independent_sequence sym Nothing rest
+          | _ -> gnu_scalar_independent_sequence sym skipping rest
+        end
+      | Nothing -> match statement.A.node with
+          | A.AilSgoto target -> gnu_closed_forward_target target rest &&
+              gnu_scalar_independent_sequence sym (Just target) rest
+          | _ -> gnu_scalar_independent_statement sym statement &&
+              gnu_scalar_independent_sequence sym Nothing rest
+        end
+    end
+end
