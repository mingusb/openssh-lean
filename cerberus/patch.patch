+val gnu_standard_errno_lvalue: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_standard_errno_lvalue (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs <> Ctype.no_qualifiers || not (gnu_function_target_type_equal ty Ctype.signed_int)
+  then E.return false else match node with
+    | A.AilEunary A.Indirection accessor -> gnu_standard_errno_accessor accessor
+    | A.AilEannot _ operand -> gnu_standard_errno_lvalue operand
+    | _ -> E.return false end
