@@ -0,0 +1,161 @@
+import CerbHostDescriptors
+import CerbHostDescriptorPolicies
+open CerbHostDescriptors
+
+private def expect (condition : Bool) (message : String) : Except String Unit :=
+  if condition then .ok () else .error message
+
+private def refused {α : Type} : Except String α → Bool
+  | .error _ => true
+  | .ok _ => false
+
+private def initial : Except String Table :=
+  create 901 6
+    [⟨0, 40, 0, 100, some 1⟩, ⟨2, 42, 1, 101, some 0⟩]
+    [⟨100, some 2⟩, ⟨101, none⟩]
+
+private def checkTransitions : Except String Unit := do
+  let base ← initial
+  validateIdle base
+  expect (refused (create 1 6
+    [⟨0, 40, 0, 0, none⟩, ⟨1, 40, 1, 1, none⟩]
+    [⟨0, none⟩, ⟨1, none⟩])) "duplicate native ownership accepted"
+  expect (refused (create 1 6 [⟨0, 40, 0, 9, none⟩] []))
+    "missing OFD accepted"
+  expect ((← classify base 1) == .absent) "unbound descriptor classification wrong"
+  expect ((← classify base (-1)) == .absent) "negative descriptor classification wrong"
+  expect (match ← classify base 0 with | .mapped entry => entry.native == 40 | _ => false)
+    "mapped descriptor classification wrong"
+  expect (refused (classify base 2147483648)) "out-of-domain integer classified as ordinary absence"
+  expect (refused (resolve base (-1))) "invalid guest descriptor resolved"
+  expect (refused (resolve base 1)) "unbound guest descriptor resolved"
+  expect (refused (reverseLookup base 999)) "reverse lookup adopted an unowned native fd"
+
+  let (reserved, creation) ← reserveFresh base 2
+  expect (refused (validateIdle reserved)) "pending table admitted for pathname-only effect"
+  expect (creation.guests == [1, 3]) "reservation did not choose lowest free guest IDs"
+  expect (refused (reserveFresh reserved 1)) "concurrent reservation accepted"
+  expect (refused (observeDescriptorFlags reserved 0 0)) "pending snapshot could be mutated"
+  expect (refused (completeFresh reserved creation.ticket
+    (.returned [⟨43, none, none⟩, ⟨43, none, none⟩]))) "duplicate returned ownership accepted"
+  expect (refused (completeFresh reserved creation.ticket
+    (.returned [⟨43, none, none⟩, ⟨42, none, none⟩]))) "owned native collision accepted"
+  expect (refused (completeFresh reserved creation.ticket
+    (.returned [⟨43, none, none⟩]))) "partial array adoption accepted"
+  let created ← completeFresh reserved creation.ticket
+    (.returned [⟨43, some 0, none⟩, ⟨44, some 1, some 2048⟩])
+  expect ((← resolve created 1) == 43 && (← resolve created 3) == 44)
+    "atomic creation mapped wrong descriptors"
+  expect ((← lookup created 1).description != (← lookup created 3).description)
+    "socketpair endpoints incorrectly share an OFD"
+  expect (refused (completeFresh created creation.ticket
+    (.returned [⟨43, none, none⟩, ⟨44, none, none⟩]))) "completed ticket replayed"
+
+  let (toCancel, canceledPlan) ← reserveFresh created 1
+  let canceled ← cancel toCancel canceledPlan.ticket
+  expect (canceled.entries == created.entries) "cancel changed live ownership"
+  let (toFail, failurePlan) ← reserveFresh canceled 1
+  expect (refused (cancel toFail canceledPlan.ticket)) "stale ticket canceled newer operation"
+  let failed ← completeFresh toFail failurePlan.ticket (.failed (-1) 24)
+  expect (failed.entries == created.entries) "native failure changed ownership"
+  let (differentSession, foreignPlan) ← reserveFresh (← create 902 6 [] []) 1
+  expect (refused (cancel differentSession failurePlan.ticket)) "foreign session ticket accepted"
+  let _ ← cancel differentSession foreignPlan.ticket
+
+  let (dupReserved, dupPlan) ← reserveDuplicate failed 0
+  expect (dupPlan.guests == [4]) "dup failed lowest-free placement"
+  let duplicated ← completeDuplicate dupReserved dupPlan.ticket (.returned 45)
+  expect ((← lookup duplicated 4).description == (← lookup duplicated 0).description)
+    "dup did not share the original OFD"
+  expect ((← lookup duplicated 4).descriptorFlags == some 0 &&
+    (← lookup duplicated 0).descriptorFlags == some 1)
+    "dup failed to separate descriptor flags"
+  let changed ← observeStatusFlags duplicated 0 2050
+  expect ((← statusFlags changed 4) == some 2050) "F_GETFL observation did not follow OFD alias"
+  let unknown ← forgetStatusFlags changed 4
+  expect ((← statusFlags unknown 0) == none) "F_SETFL uncertainty did not follow OFD alias"
+
+  let targetBorrow : BorrowKey := ⟨.directory, 77⟩
+  let borrowedTarget ← attachBorrow unknown targetBorrow 2
+  let (exactReserved, exactPlan) ← reserveExactDuplicate borrowedTarget 0 2 .dup2
+  expect (exactPlan.action == .duplicateExact 40 (some 42) .dup2)
+    "dup2 target was not resolved through the table"
+  expect (refused (completeExactDuplicate exactReserved exactPlan.ticket (.returned 99)))
+    "dup2 accepted wrong native target"
+  let replaced ← completeExactDuplicate exactReserved exactPlan.ticket (.returned 42)
+  expect ((← lookup replaced 2).description == (← lookup replaced 0).description)
+    "dup2 target did not share source OFD"
+  expect ((← lookup replaced 2).descriptorFlags == some 0) "dup2 did not clear CLOEXEC"
+  expect ((← originalGuest replaced targetBorrow) == 2) "old object's guest fd identity lost"
+  expect (refused (resolveBorrow replaced targetBorrow)) "old DIR token redirected after dup2"
+  expect (!replaced.descriptions.any (fun d => d.id == 101)) "unreferenced OFD was retained"
+
+  let (sameReserved, samePlan) ← reserveExactDuplicate replaced 0 0 .dup2
+  let same ← completeExactDuplicate sameReserved samePlan.ticket (.returned 40)
+  expect (same.entries == replaced.entries) "dup2 same-fd changed generation or flags"
+  let (same3Reserved, same3Plan) ← reserveExactDuplicate same 0 0 (.dup3 true)
+  expect (refused (completeExactDuplicate same3Reserved same3Plan.ticket (.returned 40)))
+    "dup3 same-fd accepted impossible success"
+  let same3 ← completeExactDuplicate same3Reserved same3Plan.ticket (.failed (-1) 22)
+  let (emptyTarget, emptyPlan) ← reserveExactDuplicate same3 0 5 (.dup3 true)
+  expect (emptyPlan.action == .duplicateExact 40 none (.dup3 true))
+    "unmapped dup3 target invented a native descriptor"
+  let exactNew ← completeExactDuplicate emptyTarget emptyPlan.ticket (.returned 55)
+  expect ((← lookup exactNew 5).descriptorFlags == some 1) "dup3 lost CLOEXEC"
+  expect (refused (reserveFresh exactNew 1)) "guest descriptor exhaustion ignored"
+
+  let fileA : BorrowKey := ⟨.file, 1001⟩
+  let fileB : BorrowKey := ⟨.file, 1002⟩
+  let fileC : BorrowKey := ⟨.file, 1003⟩
+  let borrowedA ← attachBorrow exactNew fileA 0
+  let borrowedBoth ← attachBorrow borrowedA fileB 0
+  expect ((← reverseBorrow borrowedBoth fileA 40) == 0) "borrow reverse lookup wrong"
+  expect (refused (reverseBorrow borrowedBoth fileA 42)) "wrong native borrower accepted"
+  let (closing, closePlan) ← reserveClose borrowedBoth 0
+  expect (refused (linuxCloseOutcome (-1) 9)) "native EBADF drift silently accepted"
+  let closed ← completeClose closing closePlan.ticket (← linuxCloseOutcome (-1) 4)
+  expect (refused (resolve closed 0)) "Linux EINTR close retained ownership"
+  expect ((← originalGuest closed fileA) == 0 && (← originalGuest closed fileB) == 0)
+    "close retired other FILE object identities"
+  let (reopening, reopenPlan) ← reserveFresh closed 1
+  expect (reopenPlan.guests == [0]) "closed lowest descriptor not reused"
+  let reopened ← completeFresh reopening reopenPlan.ticket (.returned [⟨40, some 0, none⟩])
+  expect (refused (reverseBorrow reopened fileA 40)) "reused native fd redirected old FILE"
+  expect (refused (reserveBorrowClose reopened fileA)) "stale FILE close admitted"
+  let newBorrow ← attachBorrow reopened fileC 0
+  let (fileClosing, fileClosePlan) ← reserveBorrowClose newBorrow fileC
+  let fileClosed ← completeBorrowClose fileClosing fileClosePlan.ticket 40
+  expect (refused (originalGuest fileClosed fileC)) "closed FILE token retained"
+  expect ((← originalGuest fileClosed fileA) == 0) "fclose retired a different FILE token"
+  expect (refused (resolve fileClosed 0)) "fclose did not release descriptor"
+  expect ((invalidatedBorrows fileClosed).length == 3) "stale borrow accounting wrong"
+
+  let lowLimit ← observeAllocationLimit fileClosed 1
+  expect ((← resolve lowLimit 5) == 55) "lower RLIMIT discarded existing high descriptor"
+  let (oneReserved, onePlan) ← reserveFresh lowLimit 1
+  expect (onePlan.guests == [0]) "lower-limit allocation ignored available hole"
+  let one ← completeFresh oneReserved onePlan.ticket (.returned [⟨60, none, none⟩])
+  expect (refused (reserveFresh one 1)) "new allocation exceeded lowered limit"
+  expect (refused (reserveExactDuplicate one 5 2 .dup2)) "dup target exceeded lowered limit"
+  expect ((← resolve one 5) == 55) "high source fd lookup stopped working"
+  let (highSameReserved, highSamePlan) ← reserveExactDuplicate one 5 5 .dup2
+  expect (highSamePlan.action == .duplicateExact 55 (some 55) .dup2)
+    "dup2 identity above lowered limit did not preserve exact native target"
+  let highSame ← completeExactDuplicate highSameReserved highSamePlan.ticket (.returned 55)
+  expect (highSame.entries == one.entries) "high dup2 identity mutated descriptor state"
+  let (high3Reserved, high3Plan) ← reserveExactDuplicate highSame 5 5 (.dup3 false)
+  expect (refused (completeExactDuplicate high3Reserved high3Plan.ticket (.returned 55)))
+    "high dup3 identity accepted impossible success"
+  let high3 ← completeExactDuplicate high3Reserved high3Plan.ticket (.failed (-1) 22)
+  expect (high3.entries == one.entries) "high dup3 EINVAL changed ownership"
+  expect (CerbHostDescriptorPolicies.lookup "files" "dup2" == some .exactDuplicate)
+    "generated dup2 transfer policy missing"
+  expect (CerbHostDescriptorPolicies.lookup "system" "fileno" == some .borrowedDescriptor)
+    "generated fileno transfer policy missing"
+  expect (CerbHostDescriptorPolicies.lookup "network" "socketpair" == some .freshPair)
+    "generated socketpair transfer policy missing"
+
+def main : IO Unit :=
+  match checkTransitions with
+  | .ok () => IO.println "descriptors-ok"
+  | .error error => throw (IO.userError error)
