+private abbrev VlaRuntimeBindings :=
+  List (sym × ((CerbLocation.Loc × storageDuration × Bool) × Option alignment × qualifiers × ctype))
+
+private theorem expression_lemSize_pos {a : Type} (e : expression a) :
+    0 < expression.lemSize e := by
+  cases e with
+  | AnnotatedExpression loc desug attrs node =>
+      simp only [expression.lemSize, expression_.lemSize]
+      omega
+
+private theorem statement_lemSize_pos {a : Type} (stmt : statement a) :
+    0 < statement.lemSize stmt := by
+  cases stmt with
+  | mk loc desug attrs node =>
+      simp only [statement.lemSize, statement_.lemSize]
+      omega
+
+macro "vla_size_lt" : tactic => `(tactic| (
+  (try simp only [
+    expression_.lemSize, generic_association.lemSize, expression.lemSize,
+    statement_.lemSize, statement.lemSize,
+    expression_.lemSize_aux1, expression_.lemSize_aux2,
+    expression_.lemSize_aux3, expression_.lemSize_aux4,
+    expression_.lemSize_aux5, expression_.lemSize_aux6,
+    expression_.lemSize_aux7, expression_.lemSize_aux8] at *);
+  omega))
+
+private structure VlaAttachStable (a : Type) (k : Nat) : Prop where
+  attachTail : ∀ (bindings : VlaRuntimeBindings) (stmt : statement a)
+      (tail : List (statement a)) (f g : Nat),
+    statement.lemSize stmt ≤ k → statement.lemSize stmt ≤ f →
+    statement.lemSize stmt ≤ g →
+    vla_attach_declaration_tail_lemFuel f bindings stmt tail =
+      vla_attach_declaration_tail_lemFuel g bindings stmt tail
+  attachFragments : ∀ (bindings : VlaRuntimeBindings)
+      (fragments tail : List (statement a)) (f g : Nat),
+    expression_.lemSize_aux6 fragments + 1 ≤ k →
+    expression_.lemSize_aux6 fragments + 1 ≤ f →
+    expression_.lemSize_aux6 fragments + 1 ≤ g →
+    vla_attach_fragments_lemFuel f bindings fragments tail =
+      vla_attach_fragments_lemFuel g bindings fragments tail
+
+private theorem vla_attach_stable_aux {a : Type} (k : Nat) :
+    VlaAttachStable a k := by
+  induction k with
+  | zero =>
+      constructor
+      · intro bindings stmt tail f g hk hf hg
+        have hpos := statement_lemSize_pos stmt
+        omega
+      · intro bindings fragments tail f g hk hf hg
+        omega
+  | succ k ih =>
+      constructor
+      · intro bindings stmt tail f g hk hf hg
+        have hpos := statement_lemSize_pos stmt
+        cases f with
+        | zero => omega
+        | succ f =>
+          cases g with
+          | zero => omega
+          | succ g =>
+            have keyStmt : ∀ (child : statement a),
+                statement.lemSize child < statement.lemSize stmt →
+                vla_attach_declaration_tail_lemFuel f bindings child tail =
+                  vla_attach_declaration_tail_lemFuel g bindings child tail := by
+              intro child hlt
+              exact ih.attachTail bindings child tail f g (by omega) (by omega) (by omega)
+            have keyFragments : ∀ (children : List (statement a)),
+                expression_.lemSize_aux6 children + 1 < statement.lemSize stmt →
+                vla_attach_fragments_lemFuel f bindings children tail =
+                  vla_attach_fragments_lemFuel g bindings children tail := by
+              intro children hlt
+              exact ih.attachFragments bindings children tail f g
+                (by omega) (by omega) (by omega)
+            cases stmt with
+            | mk loc desug attrs node =>
+              cases node with
+              | AilSblock blockBindings fragments =>
+                  cases blockBindings with
+                  | nil =>
+                      by_cases hguard :
+                        (fragments.any vla_is_raw_scope &&
+                          fragments.all vla_is_declaration_fragment) = true
+                      · simp (disch := vla_size_lt) only [
+                          vla_attach_declaration_tail_lemFuel,
+                          vla_attach_fragments_lemFuel, keyFragments, hguard]
+                      · simp [vla_attach_declaration_tail_lemFuel, hguard]
+                  | cons binding rest =>
+                      simp only [vla_attach_declaration_tail_lemFuel]
+              | _ =>
+                  simp (disch := vla_size_lt) only [
+                    vla_attach_declaration_tail_lemFuel,
+                    vla_attach_fragments_lemFuel, keyStmt, keyFragments]
+      · intro bindings fragments tail f g hk hf hg
+        cases f with
+        | zero => omega
+        | succ f =>
+          cases g with
+          | zero => omega
+          | succ g =>
+            have keyStmt : ∀ (child : statement a) (suffix : List (statement a)),
+                statement.lemSize child < expression_.lemSize_aux6 fragments + 1 →
+                vla_attach_declaration_tail_lemFuel f bindings child suffix =
+                  vla_attach_declaration_tail_lemFuel g bindings child suffix := by
+              intro child suffix hlt
+              exact ih.attachTail bindings child suffix f g (by omega) (by omega) (by omega)
+            have keyFragments : ∀ (children : List (statement a)),
+                expression_.lemSize_aux6 children + 1 <
+                  expression_.lemSize_aux6 fragments + 1 →
+                vla_attach_fragments_lemFuel f bindings children tail =
+                  vla_attach_fragments_lemFuel g bindings children tail := by
+              intro children hlt
+              exact ih.attachFragments bindings children tail f g
+                (by omega) (by omega) (by omega)
+            cases fragments <;>
+              simp (disch := vla_size_lt) only [
+                vla_attach_fragments_lemFuel,
+                vla_attach_declaration_tail_lemFuel, keyStmt, keyFragments]
