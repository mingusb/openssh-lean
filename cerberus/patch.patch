+        (A.AnnotatedExpression _ _ _ (A.AilEbinary base (A.Arithmetic A.Add)
+          (A.AnnotatedExpression index_category index_annots index_loc
+            (A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident subject) as left) original))))) as row) ->
+        let row_ty = ctype_of row in
+        let (qs, ty) = qualified_ctype_of left in
+        if not (gnu_complete_array_decay base && AilTypesAux.is_array row_ty &&
+            gnu_inline_fixed_object_type row_ty && AilTypesAux.is_integer ty &&
+            not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+            isJust (gnu_inline_counter_destination original))
+        then E.return Nothing else
+        E.gnu_alloc_size_subject_allowed subject >>= fun eligible ->
+        if not eligible then E.return Nothing else
+        capture_gnu_inline_fact translate_expr tagDefs (ctype_of base) base >>= function
+          | Just origin ->
+              let index = A.AnnotatedExpression index_category index_annots index_loc
+                (A.AilErvalue left) in
+              E.return (Just (E.GNU_inline_dynamic_bound_fact
+                (E.GNU_inline_offset_extent_fact origin index row_ty false [subject])))
+          | Nothing -> E.return Nothing
+        end
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+        then self operand else E.return Nothing
+    | _ -> E.return Nothing
+  end
+
+val gnu_alloc_argument_snapshot:
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory * bool
+let gnu_alloc_argument_snapshot (A.AnnotatedExpression category annots loc node as expr) =
+  match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident _) as left) _ ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_integer ty)
+        then (expr, false) else
+          (A.AnnotatedExpression category annots loc (A.AilErvalue left), true)
+    | _ -> (expr, false)
+  end
+
+(* AIL call arguments retain their source types until call lowering. Apply the
+   declared integer parameter conversion to metadata as well; testing the raw
+   argument type would reject calloc(1, n), and retaining it would misread a
+   signed-to-size_t conversion. The original call still evaluates arguments. *)
+val gnu_alloc_size_argument_at:
+  integer -> list (A.expression GenTypes.genTypeCategory) ->
+  list (Ctype.qualifiers * Ctype.ctype * bool) -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_alloc_size_argument_at index args params =
+  if index <= 0 then Nothing else match (args, params) with
+    | (argument :: rest, (_, ty, _) :: more) ->
+        if index <> 1 then gnu_alloc_size_argument_at (index - 1) rest more else
+        let argument = fst (gnu_alloc_argument_snapshot argument) in
+        if not (AilTypesAux.is_integer ty && AilTypesAux.is_integer (ctype_of argument)) then Nothing else
+          Just (A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type ty)) [] (Loc.locOf argument)
+            (A.AilEcast Ctype.no_qualifiers ty argument))
+    | _ -> Nothing
+  end
+
+(* Allocation metadata may carry pure integer arithmetic over one immutable
+   scalar. Collect every read before retaining the expression; no pointer load,
+   volatile/atomic read, VLA query, call, or write can enter a reusable size. *)
+
+val gnu_alloc_size_expression:
+  C.core_tag_definitions -> Loc.t -> A.expression GenTypes.genTypeCategory ->
+  list integer -> list (A.expression GenTypes.genTypeCategory) ->
+  E.elabM (maybe (A.expression GenTypes.genTypeCategory))
+let gnu_alloc_size_expression tagDefs loc callee indices args =
+  let params = match ctype_of callee with
+    | Ctype.Ctype _ (Ctype.Function _ params _) -> params
+    | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ params _))) -> params
+    | _ -> [] end in
+  let argument index = gnu_alloc_size_argument_at index args params in
+  match indices with
+    | [index] -> E.return (argument index)
+    | [first; second] ->
+        (match (argument first, argument second) with
+          | (Just left, Just right) ->
+              let is_size_t ty = match (ty, Ctype.size_t) with
+                | (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity)),
+                   Ctype.Ctype _ (Ctype.Basic (Ctype.Integer size_ity))) ->
+                    Implementation.normalise_integerType ity = Implementation.normalise_integerType size_ity
+                | _ -> false end in
+              if not (is_size_t (ctype_of left) && is_size_t (ctype_of right)) then E.return Nothing else
+              gnu_scalar_knowledge_of tagDefs left >>= fun left_range ->
+              gnu_scalar_knowledge_of tagDefs right >>= fun right_range ->
+              (* Failure to derive a narrow arithmetic interval does not lose
+                 the operand's declared integer bounds. These are conservative
+                 bounds only, never witnesses or a nonconstancy certificate. *)
+              let bounds operand inferred = match inferred with
+                | Just (low, high, _) -> Just (low, high)
+                | Nothing -> gnu_scalar_type_bounds (ctype_of operand) end in
+              let no_overflow = match (bounds left left_range, bounds right right_range,
+                  gnu_scalar_type_bounds Ctype.size_t) with
+                | (Just (al, ah), Just (bl, bh), Just (_, high)) ->
+                    al >= 0 && bl >= 0 && ah * bh <= high
+                | _ -> false end in
+              E.return (if not no_overflow then Nothing else
+                Just (A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type Ctype.size_t)) [] loc
+                  (A.AilEbinary left (A.Arithmetic A.Mul) right)))
+          | _ -> E.return Nothing end)
+    | _ -> E.return Nothing
+  end
+
+(* A visible allocation wrapper must have one unconditional allocation origin
+   dominating its single final return. These summaries never replace execution
+   of its guards/calls. Unsupported control and hidden statement expressions
+   decline; parameter and returned-object stability are checked independently. *)
+val gnu_alloc_return_statements:
+  A.statement GenTypes.genTypeCategory -> maybe (list (A.statement GenTypes.genTypeCategory))
+let rec gnu_alloc_return_statements stmt = match stmt.A.node with
+  | A.AilSblock _ statements -> List.foldr (fun child acc ->
+      match (gnu_alloc_return_statements child, acc) with
+        | (Just first, Just rest) -> Just (first ++ rest)
+        | _ -> Nothing end) (Just []) statements
+  | A.AilSmarker _ body -> gnu_alloc_return_statements body
+  | A.AilSvla_scope _ _ _ _ -> Nothing
+  | _ -> Just [stmt]
+end
+
+val gnu_alloc_loop_continuations:
+  nat -> A.statement GenTypes.genTypeCategory -> list Symbol.sym
+let rec gnu_alloc_loop_continuations loop_id stmt =
+  let self = gnu_alloc_loop_continuations loop_id in match stmt.A.node with
+    | A.AilSlabel label body (Just (Annot.LAloop_continue owner)) ->
+        (if owner = loop_id then [label] else []) ++ self body
+    | A.AilSblock _ statements -> List.concat (List.map self statements)
+    | A.AilSif _ yes no -> self yes ++ self no
+    | A.AilSmarker _ body -> self body
+    | _ -> []
+  end
+
+(* Structured bookkeeping may precede or follow the single allocation store.
+   No return, source label, hidden expression control or outward goto can skip
+   that store or replace its result; the pointer object also cannot escape. *)
+val gnu_alloc_return_guard_with:
+  Symbol.sym -> list nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_alloc_return_guard_with subject loops continuations stmt =
+  let self = gnu_alloc_return_guard_with subject loops continuations in
+  let expr value = gnu_inline_parameter_expression_safe subject value &&
+    gnu_dead_arm_expression_closed value in
+  match stmt.A.node with
+    | A.AilSskip -> true
+    | A.AilSexpr value -> expr value
+    | A.AilSdeclaration declarations -> List.all (fun (sym, value) ->
+        (sym <> subject || isNothing value) && maybe true expr value) declarations
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif test yes no -> expr test && self yes && self no
+    | A.AilSwhile test body loop_id -> expr test &&
+        gnu_alloc_return_guard_with subject (loop_id :: loops)
+          (gnu_alloc_loop_continuations loop_id body ++ continuations) body
+    | A.AilSdo body test loop_id -> expr test &&
+        gnu_alloc_return_guard_with subject (loop_id :: loops)
+          (gnu_alloc_loop_continuations loop_id body ++ continuations) body
+    | A.AilSlabel _ body (Just (Annot.LAloop_continue owner)) ->
+        List.elem owner loops && self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_break _)) ->
+        (match body.A.node with A.AilSskip -> true | _ -> false end)
+    | A.AilSgoto target -> List.elem target continuations
+    | A.AilSbreak -> loops <> []
+    | A.AilScontinue -> loops <> []
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+(* Keep sized-allocation inference on its existing, separately validated
+   straight-line admission rule. The broader control proof is used only for
+   positively unsized returns below. *)
+val gnu_alloc_return_guard: Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_alloc_return_guard subject stmt =
+  let self = gnu_alloc_return_guard subject in
+  let expr = gnu_inline_parameter_expression_safe subject in
+  match stmt.A.node with
+    | A.AilSskip -> true
+    | A.AilSexpr value -> expr value
+    | A.AilSdeclaration declarations -> List.all (fun (sym, value) ->
+        (sym <> subject || isNothing value) && maybe true expr value) declarations
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif test yes no -> expr test && self yes && self no
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+val gnu_alloc_return_automatic: Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_alloc_return_automatic subject stmt = match stmt.A.node with
+  | A.AilSblock bindings statements ->
+      List.any (function
+        | (sym, ((_, A.Automatic, _), _, qs, ty)) ->
+            sym = subject && not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && AilTypesAux.is_pointer ty
+        | _ -> false end) bindings || List.any (gnu_alloc_return_automatic subject) statements
+  | A.AilSmarker _ body -> gnu_alloc_return_automatic subject body
+  | _ -> false
+end
+
+val gnu_alloc_return_assignment:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let gnu_alloc_return_assignment subject stmt = match stmt.A.node with
+  | A.AilSexpr (A.AnnotatedExpression _ _ _
+      (A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident sym) as left) value)) ->
+      let (qs, ty) = qualified_ctype_of left in
+      if sym = subject && not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) then Just value else Nothing
+  | A.AilSdeclaration [(sym, Just value)] -> if sym = subject then Just value else Nothing
+  | _ -> Nothing
+end
+
+val gnu_alloc_return_origin_with:
+  (A.statement GenTypes.genTypeCategory -> bool) ->
+  Symbol.sym -> list (A.statement GenTypes.genTypeCategory) -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_alloc_return_origin_with guard subject statements = match statements with
+  | [] -> Nothing
+  | statement :: rest -> (match gnu_alloc_return_assignment subject statement with
+      | Just value -> if List.all guard rest then Just value else Nothing
+      | Nothing -> if guard statement
+          then gnu_alloc_return_origin_with guard subject rest else Nothing
+    end)
+end
+
+val gnu_alloc_return_value_with:
+  (Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool) ->
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let gnu_alloc_return_value_with guard source body =
+  match gnu_alloc_return_statements body with
+    | Nothing -> Nothing
+    | Just statements -> (match List.dest_init statements with
+        | Just (prefix, last) -> (match last.A.node with
+            | A.AilSreturn value -> (match gnu_inline_direct_pointer_symbol value with
+                | Just subject -> if gnu_alloc_return_automatic subject body &&
+                    gnu_alloc_size_subject_unescaped subject body
+                    then gnu_alloc_return_origin_with (guard subject) subject prefix else Nothing
+                | Nothing -> if List.all (guard source) prefix then Just value else Nothing
+              end)
+            | _ -> Nothing end)
+        | Nothing -> Nothing end)
+  end
+
+val gnu_alloc_return_value:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let gnu_alloc_return_value = gnu_alloc_return_value_with gnu_alloc_return_guard
+
+val gnu_alloc_wrapper_substitute:
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) -> A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_alloc_wrapper_substitute bindings (A.AnnotatedExpression category annots loc node as expr) =
+  let self = gnu_alloc_wrapper_substitute bindings in
+  let rebuild node = A.AnnotatedExpression category annots loc node in
+  if gnu_inline_closed_integer_origin expr then Just expr else match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && AilTypesAux.is_integer ty
+        then List.lookup sym bindings else Nothing
+    | A.AilEannot ty operand -> maybe Nothing (fun value -> Just (rebuild (A.AilEannot ty value))) (self operand)
+    | A.AilEcast qs ty operand ->
+        if not (AilTypesAux.is_integer ty) then Nothing else
+        maybe Nothing (fun value -> Just (rebuild (A.AilEcast qs ty value))) (self operand)
+    | A.AilEunary A.Plus operand -> maybe Nothing (fun value -> Just (rebuild (A.AilEunary A.Plus value))) (self operand)
+    | A.AilEunary A.Minus operand -> maybe Nothing (fun value -> Just (rebuild (A.AilEunary A.Minus value))) (self operand)
+    | A.AilEunary A.Bnot operand -> maybe Nothing (fun value -> Just (rebuild (A.AilEunary A.Bnot value))) (self operand)
+    | A.AilEbinary left (A.Arithmetic aop) right -> (match (self left, self right) with
+        | (Just first, Just second) -> Just (rebuild (A.AilEbinary first (A.Arithmetic aop) second))
+        | _ -> Nothing end)
+    | _ -> Nothing
+  end
+
+val gnu_returned_pointer_call:
+  bool ->
+  A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory * list (A.expression GenTypes.genTypeCategory))
+let rec gnu_returned_pointer_call chained (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then Nothing else match node with
+    | A.AilEcall callee args ->
+        if gnu_inline_direct_designator callee then Just (callee, args) else Nothing
+    | A.AilEassign left right ->
+        let (qs, target_ty) = qualified_ctype_of left in
+        if not chained || qs.Ctype.volatile || AilTypesAux.is_atomic target_ty ||
+          not (AilTypesAux.is_pointer target_ty && AilTypesAux.is_pointer (ctype_of right)) ||
+          AilTypesAux.is_pointer_to_function target_ty || AilTypesAux.is_pointer_to_function (ctype_of right) ||
+          not (gnu_memory_expression_readonly left)
+        then Nothing else gnu_returned_pointer_call chained right
+    | A.AilEannot _ operand -> gnu_returned_pointer_call chained operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty then gnu_returned_pointer_call chained operand else Nothing
+    | _ -> Nothing
+  end
+
+val gnu_alloc_wrapper_call:
+  A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory * list (A.expression GenTypes.genTypeCategory))
+let gnu_alloc_wrapper_call = gnu_returned_pointer_call false
+
+(* The pinned GNU profile knows standard allocation sizes even when a user
+   declaration omits alloc_size. Require an exact direct external allocator
+   signature, with no source replacement. This supplies only the size indices;
+   argument conversion, arithmetic bounds, capture and invalidation still use
+   the ordinary allocation-metadata path. The runtime call is unchanged. *)
+val gnu_standard_allocation_indices:
+  A.expression GenTypes.genTypeCategory -> list (A.expression GenTypes.genTypeCategory) ->
+  E.elabM (maybe (list integer))
+let gnu_standard_allocation_indices callee args =
+  if not (Implementation.has_amd64_sysv_abi () && gnu_inline_direct_designator callee)
+  then E.return Nothing else
+  let function_ty = match ctype_of callee with
+    | Ctype.Ctype _ (Ctype.Pointer _ ty) -> ty
+    | ty -> ty end in
+  let signature = match function_ty with
+    | Ctype.Ctype _ (Ctype.Function (result_qs,
+        Ctype.Ctype _ (Ctype.Pointer pointed_qs pointed)) params false) ->
+        result_qs = Ctype.no_qualifiers && pointed_qs = Ctype.no_qualifiers &&
+          AilTypesAux.is_void pointed && List.length params = List.length args &&
+          List.all (fun (qs, ty, _) ->
+            qs = Ctype.no_qualifiers && gnu_standard_size_type ty) params &&
+          List.all (fun argument -> AilTypesAux.is_integer (ctype_of argument)) args
+    | _ -> false end in
+  if not signature then E.return Nothing else
+  gnu_inline_function_target callee >>= function
+    | Nothing -> E.return Nothing
+    | Just (declared, _) ->
+        E.gnu_inline_target declared >>= fun target ->
+        E.gnu_has_source_definition target >>= fun defined ->
+        E.linker_name declared >>= fun name ->
+        E.return (if defined then Nothing else match (name, args) with
+          | (Just "malloc", [_]) -> Just [1]
+          | (Just "calloc", [_; _]) -> Just [1; 2]
+          | (Just "aligned_alloc", [_; _]) -> Just [2]
+          | _ -> Nothing end)
+  end
+
+val gnu_allocation_size_call:
+  C.core_tag_definitions -> list Symbol.sym -> Loc.t -> A.expression GenTypes.genTypeCategory ->
+  list (A.expression GenTypes.genTypeCategory) -> E.elabM (maybe (A.expression GenTypes.genTypeCategory * bool))
+let rec gnu_allocation_size_call tagDefs seen loc callee args =
+  let trace message = Debug.print_debug_located 2 [Debug.DB_elaboration] loc (fun () -> message) in
+  gnu_opaque_call_boundary callee >>= fun (opaque, attrs) ->
+  let allocation = match attrs with
+    | Annot.Attrs values -> List.filter (fun attr ->
+        Cerb_attributes.is_gnu_named_attribute "alloc_size" attr) values end in
+  let decoded_attributes = List.map Cerb_attributes.decode_gnu_allocation_indices allocation in
+  let decoded = match decoded_attributes with
+    | Just indices :: rest -> if List.all (fun candidate -> candidate = Just indices) rest then Just indices else Nothing
+    | _ -> Nothing end in
+  (if opaque && allocation = [] then gnu_standard_allocation_indices callee args
+   else E.return decoded) >>= fun decoded ->
+  let () = trace ("GNU alloc_size boundary callee=" ^ Pp.stringFromAil_expression callee ^
+    "; opaque=" ^ show opaque ^ "; matching_attributes=" ^ show (List.length allocation)) in
+  if opaque then match decoded with
+    | Just indices -> gnu_alloc_size_expression tagDefs loc callee indices args >>= fun bound ->
+        let captured = List.any (fun index -> if index <= 0 then false else
+          maybe false (fun argument -> snd (gnu_alloc_argument_snapshot argument))
+            (List.index args (natFromInteger (index - 1)))) indices in
+        E.return (maybe Nothing (fun bound -> Just (bound, captured)) bound)
+    | Nothing -> E.return Nothing
+  end else
+  if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+  then E.return Nothing else
+  gnu_inline_function_target callee >>= function
+    | Nothing -> E.return Nothing
+    | Just (declared, _) -> E.gnu_inline_target declared >>= fun source ->
+        if List.elem source seen then E.return Nothing else
+        E.gnu_memory_call_body source >>= function
+          | Nothing -> E.return Nothing
+          | Just (params, body) ->
+              let types = match ctype_of callee with
+                | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ types false))) -> types
+                | _ -> [] end in
+              if List.length params <> List.length args || List.length params <> List.length types ||
+                  not (List.all (fun param -> gnu_inline_parameter_unchanged param body) params)
+              then E.return Nothing else
+              let actuals = List.mapi (fun index _ ->
+                gnu_alloc_size_argument_at (integerFromNat index + 1) args types) params in
+              if List.any isNothing actuals then E.return Nothing else
+              let bindings = List.zip params (List.foldr (fun value rest ->
+                maybe rest (fun value -> value :: rest) value) [] actuals) in
+              (match gnu_alloc_return_value source body with
+                | Nothing -> E.return Nothing
+                | Just value -> (match gnu_alloc_wrapper_call value with
+                    | Nothing -> E.return Nothing
+                    | Just (inner_callee, inner_args) ->
+                        let arguments = List.map (gnu_alloc_wrapper_substitute bindings) inner_args in
+                        if List.any isNothing arguments then E.return Nothing else
+                        let arguments = List.foldr (fun value rest ->
+                          maybe rest (fun value -> value :: rest) value) [] arguments in
+                        let () = trace ("GNU visible allocation return source=" ^ show source ^
+                          "; allocator=" ^ Pp.stringFromAil_expression inner_callee) in
+                        gnu_allocation_size_call tagDefs (source :: seen) loc inner_callee arguments
+                  end)
+              end)
+        end
+  end
+
+(* A captured VLA sizeof is evaluated once by the original call. Its immutable
+   bound key can carry a scoped equality to an unchanged source parameter;
+   query that source's current compiler facts, never the capture object's older
+   contents. Only a single saved argument and its ordinary parameter conversion
+   enter here. Other snapshots and allocation-size products stay dynamic-only. *)
+val gnu_alloc_vla_snapshot_knowledge:
+  C.core_tag_definitions -> list (A.expression GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_scalar_knowledge)
+let gnu_alloc_vla_snapshot_knowledge tagDefs args
+    (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEcast _ ty
+        (A.AnnotatedExpression _ _ _ (A.AilErvalue
+          (A.AnnotatedExpression _ _ _ (A.AilEident saved)))) ->
+        let originals = List.foldr (fun argument rest -> match argument with
+          | A.AnnotatedExpression _ _ _ (A.AilEassign
+              (A.AnnotatedExpression _ _ _ (A.AilEident target)) original) ->
+              if target = saved then original :: rest else rest
+          | _ -> rest end) [] args in
+        (match originals with
+          | [original] ->
+              let (A.AnnotatedExpression _ _ _ original_node) = original in
+              let size_ty = match original_node with
+                | A.AilEsizeof _ ty -> Just ty
+                | A.AilEsizeof_expr operand -> Just (ctype_of operand)
+                | _ -> Nothing end in
+              if not (maybe false Vla_types.vla_has_runtime_extent size_ty)
+              then E.return Nothing else
+                gnu_scalar_knowledge_of tagDefs original >>= fun knowledge ->
+                E.return (maybe Nothing (gnu_scalar_cast ty) knowledge)
+          | _ -> E.return Nothing end)
+    | _ -> E.return Nothing
+  end
+
+val gnu_alloc_size_pointer_fact:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)
+let rec gnu_alloc_size_pointer_fact tagDefs (A.AnnotatedExpression _ _ loc node as expr) =
+  let self = gnu_alloc_size_pointer_fact tagDefs in
+  let trace message = Debug.print_debug_located 2 [Debug.DB_elaboration] loc (fun () -> message) in
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return Nothing else
+  match node with
+    | A.AilEcall callee args ->
+        gnu_allocation_size_call tagDefs [] loc callee args >>= function
+          | Nothing -> E.return Nothing
+          | Just (argument, captured) ->
+                    (if captured then gnu_alloc_vla_snapshot_knowledge tagDefs args argument
+                     else E.return Nothing) >>= fun captured_knowledge ->
+                    let runtime_size = match captured_knowledge with
+                      | Just (low, high, true) -> low < high
+                      | _ -> false end in
+                    let package fact = if captured && not runtime_size
+                      then E.GNU_inline_dynamic_bound_fact fact else fact in
+                    let exact_size = match captured_knowledge with
+                      | Just (low, high, _) -> if low = high then Just low else Nothing
+                      | _ -> Nothing end in
+                    (match exact_size with
+                      | Just size ->
+                          let constant = A.AnnotatedExpression
+                            (GenTypes.GenRValueType (GenTypes.inject_type (ctype_of argument)))
+                            [] loc (A.AilEconst (A.ConstantInteger (A.IConstant size A.Decimal Nothing))) in
+                          E.return (Just (E.GNU_inline_constant_alloc_size_fact constant))
+                      | Nothing ->
+                    (* A capture denotes the value stored by this call, not any
+                       older compiler fact for its storage before argument evaluation. *)
+                    (if captured then E.return argument else
+                      resolve_gnu_constant_origins tagDefs argument) >>= fun argument ->
+                    (match gnu_alloc_size_dependencies argument with
+                      | Just [] ->
+                          let () = trace ("GNU alloc_size closed integer argument=" ^ Pp.stringFromAil_expression argument) in
+                          E.return (Just (package (E.GNU_inline_constant_alloc_size_fact argument)))
+                      | Just ((dependency, _) :: rest) ->
+                          if not (List.all (fun (sym, _) -> sym = dependency) rest) then
+                            let () = trace "GNU alloc_size has multiple scalar dependencies" in E.return Nothing
+                          else E.gnu_alloc_size_subject_allowed dependency >>= fun eligible_subject ->
+                            let () = trace ("GNU alloc_size dependency=" ^ show dependency ^
+                              "; unescaped-current-subject=" ^ show eligible_subject ^ "; expression=" ^ Pp.stringFromAil_expression argument) in
+                            E.return (if eligible_subject then Just (package (E.GNU_inline_alloc_size_fact dependency argument)) else Nothing)
+                      | Nothing ->
+                          let () = trace ("GNU alloc_size argument needs an evaluation snapshot: " ^
+                            Pp.stringFromAil_expression argument) in E.return Nothing
+                    end)
+                    end)
+        end
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+        then self operand else E.return Nothing
+    | _ -> E.return Nothing
+  end
+
+val gnu_direct_pointer_object_lvalue:
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_direct_pointer_object_lvalue (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty)
+  then Nothing else match node with
+    | A.AilEident _ -> Just expr
+    | A.AilEannot _ operand -> gnu_direct_pointer_object_lvalue operand
+    | _ -> Nothing
+  end
+
+(* Unlike a generic alloc_size declaration, these standard allocating calls
+   do not write existing caller objects on successful return. Their argument
+   evaluation must be readonly; realloc is excluded because it ends a lifetime. *)
+val gnu_new_allocation_preserves_inputs:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_new_allocation_preserves_inputs (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcall callee args ->
+      if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+      then E.return false else gnu_inline_function_target callee >>= function
+        | Nothing -> E.return false
+        | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+            E.gnu_has_source_definition target >>= fun defined ->
+            E.linker_name declared >>= fun name ->
+            E.return (not defined && match name with
+              | Just "malloc" -> List.length args = 1
+              | Just "calloc" -> List.length args = 2
+              | Just "aligned_alloc" -> List.length args = 2
+              | _ -> false end)
+      end
+  | _ -> E.return false
+end
+
+(* Filter earlier guard facts through every possible effect of the later
+   condition. Fresh allocation preserves caller objects, but its following
+   store must be disjoint and the retained fact must have no mutable dependency.
+   This deliberately does not retain arbitrary state across allocator calls. *)
+val gnu_alloc_guard_survivors:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  list (E.gnu_memory_slot * E.gnu_inline_fact) -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let rec gnu_alloc_guard_survivors tagDefs (A.AnnotatedExpression _ _ _ node as expr) facts =
+  if gnu_memory_expression_readonly expr then E.return facts else match node with
+    | A.AilEassign target right ->
+        let (qs, ty) = qualified_ctype_of target in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not (AilTypesAux.is_pointer ty && gnu_memory_expression_readonly target)
+        then E.return [] else
+        gnu_new_allocation_preserves_inputs right >>= fun fresh ->
+        if not fresh then E.return [] else gnu_memory_slot_of true target >>= function
+          | Nothing -> E.return []
+          | Just (indirect, sym, path) ->
+              E.gnu_indexed_memory_symbols >>= fun indexed ->
+              if List.elem sym indexed then E.return [] else
+              gnu_memory_root_type sym target >>= fun root_ty ->
+              let root_ty = maybe Nothing (fun ty -> if not indirect then Just ty else match ty with
+                | Ctype.Ctype _ (Ctype.Pointer _ pointed) -> Just pointed | _ -> Nothing end) root_ty in
+              E.return (List.filter (fun ((other_indirect, other, other_path), fact) ->
+                not (List.elem other indexed) && gnu_member_fact_closed fact &&
+                ((not indirect && not other_indirect && sym <> other) ||
+                 (indirect = other_indirect && sym = other && maybe false
+                   (fun ty -> gnu_memory_paths_disjoint tagDefs ty path other_path) root_ty))) facts)
+        end
+    | A.AilEbinary left _ right ->
+        gnu_alloc_guard_survivors tagDefs left facts >>= fun after_left ->
+        gnu_alloc_guard_survivors tagDefs right after_left
+    | A.AilEannot _ child -> gnu_alloc_guard_survivors tagDefs child facts
+    | A.AilErvalue child -> gnu_alloc_guard_survivors tagDefs child facts
+    | _ -> E.return []
+  end
+
+(* A guarded alloc_size assignment establishes the stored pointer's extent
+   after the call/store has executed. A member/output root must be unescaped and
+   unchanged throughout the RHS evaluation. Earlier local pointer assignments
+   do not change this current-value guarantee. Later root/dependency writes,
+   calls and branch joins still invalidate the revocable memory fact. *)
+val gnu_branch_alloc_size_assignment_facts:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact) * list (E.gnu_memory_slot * E.gnu_inline_fact))
+let rec gnu_branch_alloc_size_assignment_facts tagDefs (A.AnnotatedExpression _ _ _ node) =
+  let attempt assignment null_value nonnull_when_true =
+    (* Zero cast to a typed pointer is not necessarily a C null pointer
+       constant, but equality with it still distinguishes this allocation's
+       null and nonnull result. Keep literal/profile and effect checks; do not
+       treat arbitrary pointer expressions as null. *)
+    if not (Aaux.is_null_pointer_constant null_value || gnu_literal_null_pointer null_value) ||
+        gnu_size_effects null_value <> Just false
+    then E.return Nothing else
+    match assignment with
+      | A.AnnotatedExpression _ _ _ (A.AilEassign target right) ->
+          let (qs, target_ty) = qualified_ctype_of target in
+          if qs.Ctype.volatile || AilTypesAux.is_atomic target_ty ||
+              not (AilTypesAux.is_pointer target_ty) || AilTypesAux.is_pointer_to_function target_ty ||
+              not (gnu_memory_expression_readonly target) then E.return Nothing else
+          gnu_memory_slot_of true target >>= function
+            | Just ((indirect, sym, _) as slot) ->
+                E.gnu_indexed_memory_symbols >>= fun indexed ->
+                (if List.elem sym indexed then gnu_new_allocation_preserves_inputs right else
+                 if indirect then E.gnu_alloc_size_subject_allowed sym >>= fun unescaped ->
+                  E.return (unescaped && gnu_inline_parameter_expression_safe sym right)
+                else E.get_visible_objects >>= fun visible ->
+                  E.gnu_retained_global_pointer_symbols >>= fun globals ->
+                  E.return (List.elem sym visible ||
+                    List.any (fun (global, _) -> sym = global) globals)) >>= fun stable ->
+                if not stable then E.return Nothing else
+                gnu_alloc_size_pointer_fact tagDefs right >>= function
+                  | Nothing -> E.return Nothing
+                  | Just fact ->
+                      let nonnull = [(slot, fact)] in
+                      let null = [(slot, E.GNU_inline_unknown_extent_fact)] in
+                      E.return (Just (if nonnull_when_true then (nonnull, null) else (null, nonnull)))
+                end
+            | Nothing -> E.return Nothing end
+      | _ -> E.return Nothing
+    end in
+  let wrapped left right swap = match right with
+    | A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant value _ _))) ->
+        if value <> 0 || not (AilTypesAux.is_integer (ctype_of left)) then E.return ([], []) else
+        gnu_branch_alloc_size_assignment_facts tagDefs left >>= fun (yes, no) ->
+        E.return (if swap then (no, yes) else (yes, no))
+    | _ -> E.return ([], []) end in
+  match node with
+    | A.AilEbinary left A.Or right ->
+        gnu_branch_alloc_size_assignment_facts tagDefs left >>= fun (_, first) ->
+        gnu_branch_alloc_size_assignment_facts tagDefs right >>= fun (_, second) ->
+        gnu_alloc_guard_survivors tagDefs right first >>= fun survived ->
+        E.return ([], survived ++ second)
+    | A.AilEbinary left A.And right ->
+        gnu_branch_alloc_size_assignment_facts tagDefs left >>= fun (first, _) ->
+        gnu_branch_alloc_size_assignment_facts tagDefs right >>= fun (second, _) ->
+        gnu_alloc_guard_survivors tagDefs right first >>= fun survived ->
+        E.return (survived ++ second, [])
+    | A.AilEbinary left A.Eq right ->
+        attempt left right false >>= function
+          | Just result -> E.return result
+          | Nothing -> attempt right left false >>= function
+              | Just result -> E.return result
+              | Nothing -> wrapped left right true
+            end
+        end
+    | A.AilEbinary left A.Ne right ->
+        attempt left right true >>= function
+          | Just result -> E.return result
+          | Nothing -> attempt right left true >>= function
+              | Just result -> E.return result
+              | Nothing -> wrapped left right false
+            end
+        end
+    | A.AilEannot _ operand -> gnu_branch_alloc_size_assignment_facts tagDefs operand
+    | A.AilErvalue operand -> gnu_branch_alloc_size_assignment_facts tagDefs operand
+    | _ -> E.return ([], [])
+  end
+
+(* A source-level output summary needs a positive origin on every return.
+   In particular an early error path is included, not assumed unreachable. *)
+val gnu_output_unknown_value:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_output_unknown_value (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_literal_null_pointer expr then E.return true else
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return false else match node with
+    | A.AilEcall callee _ -> gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+        if opaque then gnu_opaque_pointer_call_result expr else E.return false
+    | A.AilEcast _ target operand ->
+        if AilTypesAux.is_pointer target && AilTypesAux.is_pointer (ctype_of operand)
+        then gnu_output_unknown_value operand else E.return false
+    | A.AilEannot _ operand -> gnu_output_unknown_value operand
+    | A.AilEbinary pointer (A.Arithmetic A.Add) offset ->
+        if AilTypesAux.is_pointer (ctype_of pointer) && AilTypesAux.is_integer (ctype_of offset) &&
+            gnu_memory_expression_readonly offset then gnu_output_unknown_value pointer
+        else if AilTypesAux.is_pointer (ctype_of offset) && AilTypesAux.is_integer (ctype_of pointer) &&
+            gnu_memory_expression_readonly pointer then gnu_output_unknown_value offset
+        else E.return false
+    | A.AilEbinary pointer (A.Arithmetic A.Sub) offset ->
+        if AilTypesAux.is_pointer (ctype_of pointer) && AilTypesAux.is_integer (ctype_of offset) &&
+            gnu_memory_expression_readonly offset then gnu_output_unknown_value pointer else E.return false
+    | _ -> E.return false
+  end
+
+val gnu_output_formal_pointer:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_output_formal_pointer formal (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (object_qs, object_ty) = qualified_ctype_of operand in
+        sym = formal && not object_qs.Ctype.volatile && not (AilTypesAux.is_atomic object_ty)
+    | A.AilEannot _ operand -> gnu_output_formal_pointer formal operand
+    | _ -> false
+  end
+
+val gnu_output_store_target:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_output_store_target formal (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && AilTypesAux.is_pointer ty && match node with
+    | A.AilEunary A.Indirection base -> gnu_output_formal_pointer formal base
+    | A.AilEannot _ operand -> gnu_output_store_target formal operand
+    | _ -> false
+  end
+
+val gnu_output_expression:
+  Symbol.sym -> bool -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let gnu_output_expression formal known (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEassign left right ->
+      if gnu_output_store_target formal left then
+        gnu_output_unknown_value right >>= fun unknown ->
+        E.return (if unknown then Just true else Nothing)
+      else gnu_opaque_memory_effects expr >>= fun allowed -> E.return (if allowed then Just known else Nothing)
+  | _ -> gnu_opaque_memory_effects expr >>= fun allowed -> E.return (if allowed then Just known else Nothing)
+end
+
+(* The outer Nothing rejects an unsupported body. The inner Nothing is a path
+   that has returned. A false path means the output has no established origin. *)
+val gnu_output_statement:
+  Symbol.sym -> bool -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (maybe bool * list bool))
+val gnu_output_sequence:
+  Symbol.sym -> bool -> list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (maybe (maybe bool * list bool))
+let rec gnu_output_statement formal known stmt =
+  let self = gnu_output_statement formal in
+  let expression = gnu_output_expression formal in
+  match stmt.A.node with
+    | A.AilSskip -> E.return (Just (Just known, []))
+    | A.AilSexpr expr -> expression known expr >>= fun result ->
+        E.return (maybe Nothing (fun next -> Just (Just next, [])) result)
+    | A.AilSreturnVoid -> E.return (Just (Nothing, [known]))
+    | A.AilSreturn expr -> expression known expr >>= fun result ->
+        E.return (maybe Nothing (fun next -> Just (Nothing, [next])) result)
+    | A.AilSblock bindings statements ->
+        if not (List.all (function
+          | (sym, ((_, A.Automatic, _), _, qs, ty)) -> sym <> formal &&
+              not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings) then E.return Nothing else
+        gnu_output_sequence formal known statements
+    | A.AilSdeclaration declarations ->
+        E.foldlM (fun acc (sym, value) -> match acc with
+          | Nothing -> E.return Nothing
+          | Just incoming -> if sym = formal then E.return Nothing else
+              maybe (E.return (Just incoming)) (expression incoming) value
+          end) (Just known) declarations >>= fun result ->
+        E.return (maybe Nothing (fun next -> Just (Just next, [])) result)
+    | A.AilSif test yes no -> expression known test >>= function
+        | Nothing -> E.return Nothing
+        | Just incoming -> self incoming yes >>= fun first -> self incoming no >>= fun second ->
+            E.return (match (first, second) with
+              | (Just (left, first_exits), Just (right, second_exits)) ->
+                  let joined = match (left, right) with
+                    | (Nothing, other) -> other | (other, Nothing) -> other
+                    | (Just a, Just b) -> Just (a && b) end in
+                  Just (joined, first_exits ++ second_exits)
+              | _ -> Nothing end)
+      end
+    | A.AilSmarker _ body -> self known body
+    | _ -> E.return Nothing
+  end
+and gnu_output_sequence formal known statements = match statements with
+  | [] -> E.return (Just (Just known, []))
+  | first :: rest -> gnu_output_statement formal known first >>= function
+      | Nothing -> E.return Nothing
+      | Just (Nothing, exits) -> E.return (Just (Nothing, exits))
+      | Just (Just next, exits) -> gnu_output_sequence formal next rest >>= fun result ->
+          E.return (maybe Nothing (fun (normal, later_exits) -> Just (normal, exits ++ later_exits)) result)
+    end
+end
+
+val gnu_visible_opaque_outputs:
+  A.expression GenTypes.genTypeCategory -> list (A.expression GenTypes.genTypeCategory) ->
+  E.elabM (list (A.expression GenTypes.genTypeCategory))
+let gnu_visible_opaque_outputs callee args =
+  if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+  then E.return [] else
+  gnu_inline_function_target callee >>= function
+    | Nothing -> E.return []
+    | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+        E.gnu_memory_call_body target >>= function
+          | Nothing -> E.return []
+          | Just (params, body) ->
+              if List.length params <> List.length args then E.return [] else
+              E.mapM (fun (param, actual) -> match actual with
+                | A.AnnotatedExpression _ _ _ (A.AilEunary A.Address operand) ->
+                    (match gnu_direct_pointer_object_lvalue operand with
+                      | Nothing -> E.return Nothing
+                      | Just lvalue ->
+                          if not (gnu_inline_parameter_unchanged param body) then E.return Nothing else
+                          gnu_output_statement param false body >>= fun result ->
+                          E.return (match result with
+                            | Just (normal, exits) ->
+                                let all_exits = maybe exits (fun value -> value :: exits) normal in
+                                if all_exits <> [] && List.all (fun known -> known) all_exits
+                                then Just lvalue else Nothing
+                            | Nothing -> Nothing end)
+                    end)
+                | _ -> E.return Nothing
+              end) (List.zip params args) >>= fun optional ->
+              E.return (List.foldr (fun entry rest -> maybe rest (fun value -> value :: rest) entry) [] optional)
+        end
+  end
+
+(* The output address may itself be an unchanged, positively known formal.
+   The generated indirection is analysis metadata only; the original call
+   remains responsible for evaluating its actual argument exactly once. *)
+val gnu_explicit_opaque_output:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe (A.expression GenTypes.genTypeCategory))
+let gnu_explicit_opaque_output (A.AnnotatedExpression _ annots loc node as actual) =
+  match node with
+    | A.AilEunary A.Address operand -> E.return (gnu_direct_pointer_object_lvalue operand)
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        if gnu_size_effects actual <> Just false then E.return Nothing else
+        (match ctype_of actual with
+          | Ctype.Ctype _ (Ctype.Pointer qs ty) ->
+              if qs.Ctype.const || qs.Ctype.volatile || qs.Ctype.restrict ||
+                  AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty) ||
+                  AilTypesAux.is_pointer_to_function ty then E.return Nothing else
+              E.gnu_compiler_fact sym >>= fun fact ->
+              let positive = match fact with
+                | Just E.GNU_inline_unknown_extent_fact -> true
+                | Just (E.GNU_inline_extent_fact _ _ _ _ _) -> true
+                | Just (E.GNU_inline_constant_alloc_size_fact _) -> true
+                | Just (E.GNU_inline_alloc_size_fact _ _) -> true
+                | Just (E.GNU_inline_dynamic_bound_fact _) -> true
+                | Just (E.GNU_inline_counted_extent_fact _ _) -> true
+                | Just (E.GNU_inline_offset_extent_fact _ _ _ _ _) -> true
+                | _ -> false end in
+              E.return (if positive then Just
+                (A.AnnotatedExpression (GenTypes.GenLValueType qs ty false) annots loc
+                  (A.AilEunary A.Indirection actual)) else Nothing)
+          | _ -> E.return Nothing end)
+    | _ -> E.return Nothing
+  end
+
+val gnu_opaque_call_output_lvalues:
+  A.expression GenTypes.genTypeCategory -> E.elabM (list (A.expression GenTypes.genTypeCategory))
+let rec gnu_opaque_call_output_lvalues (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_opaque_call_output_lvalues in
+  match node with
+    | A.AilEcall callee args ->
+        gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+        gnu_call_attributes callee >>= fun attrs ->
+        gnu_visible_opaque_outputs callee args >>= fun visible_outputs ->
+        let no_writes = Cerb_attributes.has_gnu_noarg_attribute "const" attrs ||
+          Cerb_attributes.has_gnu_noarg_attribute "pure" attrs in
+        (if not opaque || no_writes then E.return [] else
+          E.mapM gnu_explicit_opaque_output args >>= fun optional ->
+          E.return (List.foldr (fun item rest -> maybe rest (fun value -> value :: rest) item) [] optional)
+        ) >>= fun outputs ->
+        E.mapM self (callee :: args) >>= fun nested ->
+        E.return (visible_outputs ++ outputs ++ List.concat nested)
+    | A.AilEbinary left A.And _ -> self left
+    | A.AilEbinary left A.Or _ -> self left
+    | A.AilEbinary left _ right ->
+        self left >>= fun first -> self right >>= fun second -> E.return (first ++ second)
+    | A.AilEcond condition _ _ -> self condition
+    | A.AilEassign left right ->
+        self left >>= fun first -> self right >>= fun second ->
+        (match left with
+          | A.AnnotatedExpression _ _ _ (A.AilEident sym) ->
+              let (qs, ty) = qualified_ctype_of left in
+              if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                  not (AilTypesAux.is_pointer ty) then E.return [] else
+              E.gnu_alloc_size_subject_allowed sym >>= fun unescaped ->
+              E.get_visible_objects >>= fun visible ->
+              if not unescaped || not (List.elem sym visible) then E.return [] else
+              gnu_ordinary_unsized_pointer_result right >>= fun opaque_result ->
+              E.return (if opaque_result then [left] else [])
+          | _ -> E.return [] end) >>= fun assigned ->
+        E.return (first ++ second ++ assigned)
+    | A.AilEcompoundAssign left _ right ->
+        self left >>= fun first -> self right >>= fun second -> E.return (first ++ second)
+    | A.AilEunary _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | _ -> E.return []
+  end
+
+(* An explicitly passed mutable record has a real opaque memory definition
+   after an ordinary external or positively certified opaque indirect call.
+   Missing target analysis alone is never a certificate. This does not require an extent for the
+   record address: only its current pointer fields become compiler-unknown.
+   The lexical pointer object must remain private and stable throughout all
+   operand evaluation. No pointee root or persistent invariant is introduced. *)
+val gnu_explicit_record_call_slots:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list E.gnu_memory_slot)
+let rec gnu_explicit_record_call_slots tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_explicit_record_call_slots tagDefs in
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_memory_expression_readonly callee &&
+          List.all gnu_memory_expression_readonly args) then E.return [] else
+        gnu_ordinary_opaque_memory_call callee >>= fun direct_opaque ->
+        gnu_positive_opaque_indirect_call callee >>= fun indirect_opaque ->
+        let opaque = direct_opaque || indirect_opaque in
+        gnu_call_attributes callee >>= fun attrs ->
+        let restricted = match attrs with Annot.Attrs entries ->
+          List.any (Cerb_attributes.is_gnu_named_attribute "access") entries end in
+        if not opaque || restricted ||
+            Cerb_attributes.has_gnu_noarg_attribute "pure" attrs ||
+            Cerb_attributes.has_gnu_noarg_attribute "const" attrs ||
+            Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs
+        then E.return [] else
+        (match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ formals false))) ->
+              if List.length formals <> List.length args then E.return [] else
+              E.mapM (fun ((formal_qs, formal_ty, _), actual) ->
+                let (qs, ty) = qualified_ctype_of actual in
+                if formal_qs.Ctype.restrict || qs.Ctype.volatile ||
+                    AilTypesAux.is_atomic ty ||
+                    not (gnu_function_target_type_equal formal_ty ty)
+                then E.return [] else
+                match (ty, actual) with
+                  | (Ctype.Ctype _ (Ctype.Pointer pointed_qs
+                        (Ctype.Ctype _ (Ctype.Struct _) as pointed)),
+                     A.AnnotatedExpression _ _ _ (A.AilErvalue
+                        (A.AnnotatedExpression _ _ _ (A.AilEident sym) as pointer_object))) ->
+                      let (object_qs, object_ty) = qualified_ctype_of pointer_object in
+                      if object_qs.Ctype.volatile || object_qs.Ctype.restrict ||
+                          AilTypesAux.is_atomic object_ty ||
+                          not (gnu_inline_parameter_expression_safe sym expr)
+                      then E.return [] else
+                      E.gnu_alloc_size_subject_allowed sym >>= fun private_object ->
+                      if not private_object then E.return [] else
+                      gnu_memory_slot_of false actual >>= function
+                        | Just (indirect, root, prefix) ->
+                            E.gnu_indexed_memory_symbols >>= fun indexed ->
+                            if List.elem root indexed then E.return [] else
+                            E.return (List.map (fun path -> (indirect, root, prefix ++ path))
+                              (gnu_clobberable_pointer_paths tagDefs [] pointed_qs pointed))
+                        | Nothing -> E.return []
+                      end
+                  | _ -> E.return []
+                end) (List.zip formals args) >>= fun slots ->
+              E.return (List.concat slots)
+          | _ -> E.return []
+        end)
+    | A.AilEbinary left A.And _ -> self left
+    | A.AilEbinary left A.Or _ -> self left
+    | A.AilEbinary left _ right ->
+        if gnu_memory_expression_readonly right then self left
+        else if gnu_memory_expression_readonly left then self right
+        else E.return []
+    | A.AilEcond condition _ _ -> self condition
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | _ -> E.return []
+  end
+
+(* A volatile function-pointer load is an actual opaque compiler boundary,
+   not a missing direct-target summary. After its guaranteed call, the mutable
+   pointer fields of an explicitly passed named record have unknown values.
+   Capture no old field value, reachable pointee contents, alias or root. The
+   original volatile load, argument evaluation and call execute unchanged.
+   Restrict this certificate to exact nonvariadic prototypes, stable lexical
+   addresses and readonly other operands; later effects cannot be ignored. *)
+val gnu_volatile_record_call_slots:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list E.gnu_memory_slot)
+let rec gnu_volatile_record_call_slots tagDefs (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_volatile_record_call_slots tagDefs in
+  match node with
+    | A.AilEcall callee args ->
+        if not (Implementation.has_amd64_sysv_abi () &&
+          AilTypesAux.is_pointer_to_function (ctype_of callee) &&
+          gnu_volatile_pointer_value_load (ctype_of callee) callee &&
+          List.all gnu_memory_expression_readonly args) then E.return [] else
+        gnu_call_attributes callee >>= fun attrs ->
+        let restricted = match attrs with Annot.Attrs entries ->
+          List.any (Cerb_attributes.is_gnu_named_attribute "access") entries end in
+        if restricted || Cerb_attributes.has_gnu_noarg_attribute "pure" attrs ||
+            Cerb_attributes.has_gnu_noarg_attribute "const" attrs ||
+            Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs
+        then E.return [] else
+        (match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ formals false))) ->
+              if List.length formals <> List.length args then E.return [] else
+              E.get_visible_objects >>= fun visible ->
+              E.mapM (fun ((formal_qs, formal_ty, _), actual) ->
+                if formal_qs.Ctype.restrict ||
+                    not (gnu_function_target_type_equal formal_ty (ctype_of actual))
+                then E.return [] else match (ctype_of actual, actual) with
+                  | (Ctype.Ctype _ (Ctype.Pointer pointed_qs
+                        (Ctype.Ctype _ (Ctype.Struct _) as pointed)),
+                     A.AnnotatedExpression _ _ _ (A.AilEunary A.Address
+                        (A.AnnotatedExpression _ _ _ (A.AilEident sym) as record_object))) ->
+                      let (object_qs, object_ty) = qualified_ctype_of record_object in
+                      if not (List.elem sym visible) || object_qs.Ctype.const ||
+                          object_qs.Ctype.volatile || object_qs.Ctype.restrict ||
+                          AilTypesAux.is_atomic object_ty ||
+                          not (gnu_inline_fixed_object_type object_ty &&
+                            gnu_function_target_type_equal pointed object_ty)
+                      then E.return [] else
+                      E.return (List.map (fun path -> (false, sym, path))
+                        (gnu_clobberable_pointer_paths tagDefs [] pointed_qs pointed))
+                  | _ -> E.return [] end) (List.zip formals args) >>= fun slots ->
+              E.return (List.concat slots)
+          | _ -> E.return [] end)
+    | A.AilEbinary left A.And right ->
+        if gnu_memory_expression_readonly right then self left else E.return []
+    | A.AilEbinary left A.Or right ->
+        if gnu_memory_expression_readonly right then self left else E.return []
+    | A.AilEbinary left _ right ->
+        if gnu_memory_expression_readonly right then self left
+        else if gnu_memory_expression_readonly left then self right else E.return []
+    | A.AilEcond condition yes no ->
+        if maybe true gnu_memory_expression_readonly yes && gnu_memory_expression_readonly no
+        then self condition else E.return []
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | _ -> E.return []
+  end
+
+(* A guaranteed external call introduces a real opaque memory definition.
+   This differs from reviving a missing fact at a load. Public mutable globals
+   are externally reachable; unrestricted ordinary-entry formal pointees may
+   alias external storage. Only their typed pointer slots are defined, and a
+   formal must still have its positive ordinary-entry pointer certificate.
+   Specializations/private known objects never enter the parameter catalog. *)
+val gnu_register_opaque_memory_definitions:
+  A.expression GenTypes.genTypeCategory -> E.elabM unit
+let gnu_register_opaque_memory_definitions expr =
+  gnu_guaranteed_opaque_call expr >>= fun guaranteed ->
+  if not guaranteed then E.return () else
+  gnu_opaque_memory_effects expr >>= fun supported ->
+  if not supported then E.return () else
+  E.gnu_opaque_clobber_slots >>= fun slots ->
+  E.mapM_ (fun ((indirect, sym, _) as slot) ->
+    (if not indirect then E.return true else
+      E.gnu_compiler_fact sym >>= fun origin ->
+      E.return (gnu_inline_opaque_base origin)) >>= fun eligible ->
+    if eligible then E.register_gnu_memory_fact slot E.GNU_inline_unknown_extent_fact
+    else E.return ()) slots >>
+  (* The same actual opaque definition also covers the ordinary incoming
+     object's contents. Require an opaque base and either a parameter-specific
+     dependency certificate or the whole function's transitive absence of
+     refinement. The latter is the same source certificate used for fresh
+     external returns, without any locally handled-refinement exemption.
+     Globals, absent values and conflicting fields cannot establish a root. *)
+  E.gnu_opaque_return_contents_allowed >>= fun function_unrefined ->
+  E.gnu_current_parameter_subjects >>= fun parameters ->
+  E.gnu_memory_effective_bindings >>= fun effective ->
+  E.mapM_ (fun sym ->
+    if not (List.any (fun (indirect, root, _) -> indirect && root = sym) slots)
+    then E.return () else
+    E.gnu_parameter_contents_unrefined sym >>= fun unrefined ->
+    E.gnu_compiler_fact sym >>= fun origin ->
+    if (not unrefined && not function_unrefined) || not (gnu_inline_opaque_base origin)
+    then E.return () else
+    E.mapM (fun ((indirect, root, _), fact) ->
+      if not indirect || root <> sym then E.return true else match fact with
+        | E.GNU_inline_unknown_extent_fact -> E.return true
+        | E.GNU_inline_integer_fact value -> gnu_boundary_origin_value [] [] value
+        | E.GNU_inline_integer_range_fact _ _ _ -> E.return true
+        | E.GNU_inline_integer_progression_fact _ _ _ -> E.return true
+        | _ -> E.return false end) effective >>= fun compatible ->
+    if not (List.all (fun yes -> yes) compatible) then E.return () else
+    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+      "GNU opaque contents definition " ^ show sym ^
+      "; function-unrefined=" ^ show function_unrefined ^
+      "; parameter-unrefined=" ^ show unrefined) in
+    E.register_gnu_memory_opaque_root sym) parameters
+
+(* A newly returned ordinary external record has positive opaque definitions
+   for its typed pointer slots. A pointer's unknown size alone does not justify
+   this: require the actual unsized call, exact pointee type, private destination
+   and the function-wide absence of pointer refinement. *)
+val gnu_external_pointer_contents:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (list Symbol.identifier))
+let gnu_external_pointer_contents tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  gnu_ordinary_unsized_pointer_result expr >>= fun opaque ->
+  if not opaque then E.return [] else
+  (* Casts can expose a different record layout. Only the direct call result
+     type establishes these fields; general casts retain the size-only fact. *)
+  match node with
+    | A.AilEcall _ _ -> (match ctype_of expr with
+        | Ctype.Ctype _ (Ctype.Pointer qs pointed) ->
+            E.return (gnu_inline_pointer_member_paths tagDefs [] qs pointed)
+        | _ -> E.return [] end)
+    | A.AilEannot _ operand -> (match operand with
+        | A.AnnotatedExpression _ _ _ (A.AilEcall _ _) ->
+            (match ctype_of operand with
+              | Ctype.Ctype _ (Ctype.Pointer qs pointed) ->
+                  E.return (gnu_inline_pointer_member_paths tagDefs [] qs pointed)
+              | _ -> E.return [] end)
+        | _ -> E.return [] end)
+    | _ -> E.return []
+  end
+
+(* Caller-owned positive opaque facts seed a separate return environment.
+   Definite member stores may add closed pointer identities/extents. Missing
+   facts remain absent, and a known extent never becomes an opaque certificate.
+   Every normal return path must agree on each published member fact. *)
+type gnu_pointer_return_info = bool * list (list Symbol.identifier * E.gnu_inline_fact)
+type gnu_pointer_return_env = list (Symbol.sym * gnu_pointer_return_info)
+
+(* A helper's local object address cannot escape its lifetime in a returned
+   fact. Admit only fixed addresses rooted outside its parameters and lexical
+   bindings, including their named subobjects. No pointer load, dynamic index,
+   integer/pointer conversion or callee-local expression is captured here. *)
+val gnu_return_fixed_object_address:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_return_fixed_object_address excluded (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+    gnu_inline_fixed_object_type ty && match node with
+    | A.AilEident sym -> not (List.elem sym excluded)
+    | A.AilEstr _ -> true
+    | A.AilEmemberof base _ -> gnu_return_fixed_object_address excluded base
+    | A.AilEannot _ operand -> gnu_return_fixed_object_address excluded operand
+    | _ -> false
+  end
+
+val gnu_return_fixed_pointer:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_return_fixed_pointer excluded (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_return_fixed_pointer excluded in
+  match node with
+    | A.AilEarray_decay object_expr -> gnu_return_fixed_object_address excluded object_expr
+    | A.AilEunary A.Address object_expr -> gnu_return_fixed_object_address excluded object_expr
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand ->
+        AilTypesAux.is_pointer (ctype_of expr) && AilTypesAux.is_pointer (ctype_of operand) &&
+          not (AilTypesAux.is_pointer_to_function (ctype_of expr)) &&
+          not (AilTypesAux.is_pointer_to_function (ctype_of operand)) && self operand
+    | _ -> false
+  end
+
+val gnu_return_capture_member:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> list Symbol.sym -> Ctype.ctype ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)
+let gnu_return_capture_member translate_expr tagDefs excluded ty value =
+  if not (AilTypesAux.is_pointer ty) || AilTypesAux.is_pointer_to_function ty ||
+      not (gnu_return_fixed_pointer excluded value) then E.return Nothing else
+  fun st ->
+    let (captured, next) = capture_gnu_inline_fact translate_expr tagDefs ty value st in
+    let identity = maybe Nothing gnu_memory_pointer_identity captured in
+    let result = if next.E.errors <> st.E.errors then Nothing else
+      maybe Nothing (fun fact -> if gnu_member_fact_closed fact then Just fact else Nothing) identity in
+    (* Optional metadata cannot leak speculative errors, bindings or memory.
+       Preserve consumed symbol identities in both generated backends. *)
+    (result, <| st with E.fresh_supply= next.E.fresh_supply |>)
+
+val gnu_return_member_path:
+  A.expression GenTypes.genTypeCategory -> maybe (Symbol.sym * list Symbol.identifier)
+let rec gnu_return_member_path (A.AnnotatedExpression _ _ _ node) =
+  let direct (A.AnnotatedExpression _ _ _ node) = match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> Just sym
+    | _ -> Nothing end in
+  match node with
+    (* Address/dereference cancellation identifies the same typed subobject.
+       It supplies a path only, never a pointer extent or an opaque value. *)
+    | A.AilEunary A.Indirection (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address lvalue)) ->
+        gnu_return_member_path lvalue
+    | A.AilEmemberofptr (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address lvalue)) member ->
+        maybe Nothing (fun (sym, path) -> Just (sym, path ++ [member])) (gnu_return_member_path lvalue)
+    | A.AilEunary A.Indirection base -> maybe Nothing (fun sym -> Just (sym, [])) (direct base)
+    | A.AilEmemberofptr base member -> maybe Nothing (fun sym -> Just (sym, [member])) (direct base)
+    | A.AilEmemberof base member -> maybe Nothing
+        (fun (sym, path) -> Just (sym, path ++ [member])) (gnu_return_member_path base)
+    | A.AilEannot _ operand -> gnu_return_member_path operand
+    | _ -> Nothing end
+
+val gnu_pointer_return_value:
+  C.core_tag_definitions -> gnu_pointer_return_env -> A.expression GenTypes.genTypeCategory ->
+  E.elabM gnu_pointer_return_info
+let rec gnu_pointer_return_value tagDefs values (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_pointer_return_value tagDefs values in
+  if gnu_literal_null_pointer expr then E.return (true, []) else
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return (false, []) else match node with
+    | A.AilEcall callee args ->
+        if not (List.all gnu_memory_expression_readonly args) then E.return (false, []) else
+        gnu_ordinary_opaque_memory_call callee >>= fun boundary ->
+        if not boundary then E.return (false, []) else
+        gnu_ordinary_unsized_pointer_result expr >>= fun opaque ->
+        if not opaque then E.return (false, []) else
+          gnu_external_pointer_contents tagDefs expr >>= fun members ->
+          E.return (true, List.map (fun path -> (path, E.GNU_inline_unknown_extent_fact)) members)
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (gnu_memory_expression_readonly expr)
+        then E.return (false, []) else (match operand with
+          | A.AnnotatedExpression _ _ _ (A.AilEident sym) ->
+              E.return (maybe (false, []) (fun info -> info) (List.lookup sym values))
+          | _ -> E.return (match gnu_return_member_path operand with
+              | Just (sym, path) -> (maybe false (fun (_, members) ->
+                    List.lookup path members = Just E.GNU_inline_unknown_extent_fact)
+                  (List.lookup sym values), [])
+              | Nothing -> (false, []) end)
+        end)
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ ty operand -> if gnu_function_target_type_equal ty (ctype_of operand)
+        then self operand else
+          if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand) &&
+              not (AilTypesAux.is_pointer_to_function ty) &&
+              not (AilTypesAux.is_pointer_to_function (ctype_of operand))
+          then self operand >>= fun (opaque, _) -> E.return (opaque, [])
+          else E.return (false, [])
+    | A.AilEbinary pointer (A.Arithmetic A.Add) offset ->
+        if AilTypesAux.is_pointer (ctype_of pointer) && AilTypesAux.is_integer (ctype_of offset) &&
+            gnu_memory_expression_readonly offset then self pointer >>= fun (opaque, _) ->
+          E.return (opaque, []) else E.return (false, [])
+    | A.AilEbinary pointer (A.Arithmetic A.Sub) offset ->
+        if AilTypesAux.is_pointer (ctype_of pointer) && AilTypesAux.is_integer (ctype_of offset) &&
+            gnu_memory_expression_readonly offset then self pointer >>= fun (opaque, _) ->
+          E.return (opaque, []) else E.return (false, [])
+    | _ -> E.return (false, []) end
+
+(* Only the private pointer objects in this environment retain their values
+   across calls. Pointee contents are revoked independently below. No expression
+   with a nested store or hidden statement/control is admitted by this test. *)
+val gnu_return_summary_effect_closed: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_return_summary_effect_closed (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_return_summary_effect_closed in
+  if gnu_memory_expression_readonly expr then true else match node with
+    | A.AilEcall callee args -> self callee && List.all self args
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEcond condition yes no -> self condition && maybe true self yes && self no
+    | A.AilErvalue operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary op operand -> (match op with
+        | A.PostfixIncr -> false | A.PostfixDecr -> false | _ -> self operand end)
+    | _ -> false end
+
+(* Effects that fail the universal opaque-class check may still write only
+   disjoint members of a tracked record. These footprints overapproximate every
+   visible control path. A root binding requires an unchanged, unescaped formal
+   and an exact pointer type; unknown aliases and recursive calls fail closed. *)
+type gnu_return_effect_roots = list (Symbol.sym * Symbol.sym)
+type gnu_return_effect_writes = list (Symbol.sym * list Symbol.identifier)
+
+val gnu_typed_statement_local_types: A.statement GenTypes.genTypeCategory -> list (Symbol.sym * Ctype.ctype)
+let rec gnu_typed_statement_local_types stmt =
+  let self = gnu_typed_statement_local_types in match stmt.A.node with
+    | A.AilSblock bindings statements -> List.map (fun (sym, (_, _, _, ty)) -> (sym, ty)) bindings ++ List.concat (List.map self statements)
+    | A.AilSif _ yes no -> self yes ++ self no
+    | A.AilSmarker _ body -> self body
+    | _ -> [] end
+
+val gnu_return_write_path:
+  A.expression GenTypes.genTypeCategory -> maybe (Symbol.sym * list Symbol.identifier)
+let gnu_return_write_path (A.AnnotatedExpression _ _ _ node as expr) =
+  match gnu_return_member_path expr with
+    | Just path -> Just path
+    | Nothing -> match node with
+        (* A subscript write covers its entire containing array for this
+           footprint. It cannot establish an individual element's value. *)
+        | A.AilEunary A.Indirection
+            (A.AnnotatedExpression _ _ _ (A.AilEbinary
+              (A.AnnotatedExpression _ _ _ (A.AilEarray_decay array))
+              (A.Arithmetic A.Add) offset)) ->
+            if AilTypesAux.is_integer (ctype_of offset) then gnu_return_member_path array else Nothing
+        | _ -> Nothing end
+  end
+
+(* A straight-line assignment can rebind a private pointer object to a
+   certified root. The new alias applies only after this statement. The
+   destination object must remain unchanged and unescaped throughout the
+   suffix; the source root is itself already certified by the caller. *)
+val gnu_return_effect_rebound:
+  list Symbol.sym -> gnu_return_effect_roots ->
+  list (A.statement GenTypes.genTypeCategory) ->
+  A.statement GenTypes.genTypeCategory -> maybe (Symbol.sym * Symbol.sym)
+let rec gnu_return_effect_rebound private_objects roots suffix stmt =
+  match stmt.A.node with
+    | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEassign
+        (A.AnnotatedExpression _ _ _ (A.AilEident target) as left) right)) ->
+        if not (List.elem target private_objects &&
+            AilTypesAux.is_pointer (ctype_of left) &&
+            gnu_memory_expression_readonly right &&
+            gnu_function_target_type_equal (ctype_of left) (ctype_of right) &&
+            List.all (gnu_inline_parameter_unchanged target) suffix &&
+            List.all (gnu_alloc_size_subject_unescaped target) suffix)
+        then Nothing else
+          maybe Nothing (fun source ->
+            maybe Nothing (fun root -> Just (target, root))
+              (List.lookup source roots))
+            (gnu_inline_direct_pointer_symbol right)
+    | A.AilSmarker _ body ->
+        gnu_return_effect_rebound private_objects roots suffix body
+    | A.AilSblock [] [only] ->
+        gnu_return_effect_rebound private_objects roots suffix only
+    | _ -> Nothing
+  end
+
+val gnu_return_effect_expression:
+  bool -> list Symbol.sym -> list Symbol.sym -> list Symbol.sym -> gnu_return_effect_roots ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_return_effect_writes)
+val gnu_return_effect_statement:
+  bool -> list Symbol.sym -> list Symbol.sym -> list Symbol.sym -> gnu_return_effect_roots ->
+  A.statement GenTypes.genTypeCategory -> E.elabM (maybe gnu_return_effect_writes)
+val gnu_return_effect_sequence:
+  bool -> list Symbol.sym -> list Symbol.sym -> list Symbol.sym -> gnu_return_effect_roots ->
+  list (A.statement GenTypes.genTypeCategory) -> E.elabM (maybe gnu_return_effect_writes)
+let rec gnu_return_effect_expression allow_opaque seen private_objects null_formals roots
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_return_effect_expression allow_opaque seen private_objects null_formals roots in
+  let append first second = match (first, second) with
+    | (Just a, Just b) -> Just (a ++ b) | _ -> Nothing end in
+  let every expressions = E.foldlM (fun accumulated operand ->
+    match accumulated with
+      | Nothing -> E.return Nothing
+      | Just _ -> self operand >>= fun writes -> E.return (append accumulated writes)
+    end) (Just []) expressions in
+  let destination (A.AnnotatedExpression _ _ _ node as left) =
+    let (qs, ty) = qualified_ctype_of left in
+    if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (gnu_memory_expression_readonly left)
+    then Nothing else match node with
+      | A.AilEident sym -> if List.elem sym private_objects then Just [] else Nothing
+      | _ -> (match gnu_return_write_path left with
+          | Just (sym, path) -> maybe Nothing (fun root -> Just [(root, path)]) (List.lookup sym roots)
+          | Nothing -> Nothing end)
+    end in
+  let action =
+  if gnu_memory_expression_readonly expr then E.return (Just []) else
+  (if allow_opaque then gnu_opaque_memory_effects expr else E.return false) >>= fun universal ->
+  if universal then E.return (Just []) else match node with
+    | A.AilEassign left right ->
+        self right >>= fun writes -> E.return (append (destination left) writes)
+    | A.AilEcompoundAssign left _ right ->
+        self right >>= fun writes -> E.return (append (destination left) writes)
+    | A.AilEunary A.PostfixIncr left -> E.return (destination left)
+    | A.AilEunary A.PostfixDecr left -> E.return (destination left)
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee) then E.return Nothing else
+        gnu_call_attributes callee >>= fun attrs ->
+        if Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs then E.return Nothing else
+        every args >>= function
+          | Nothing -> E.return Nothing
+          | Just argument_writes -> gnu_inline_function_target callee >>= function
+              | Nothing -> E.return Nothing
+              | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+                  if List.elem target seen then E.return Nothing else
+                  E.gnu_pointer_refinement_possible target >>= fun refines ->
+                  let () = if refines then Debug.print_debug_located 2 [Debug.DB_elaboration]
+                    (Loc.locOf expr) (fun () -> "GNU return effect refinement gate: " ^ show target) else () in
+                  if refines then E.return Nothing else E.gnu_memory_call_body target >>= function
+                    | Nothing -> E.return Nothing
+                    | Just (params, body) ->
+                        let types = match ctype_of callee with
+                          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ types false))) ->
+                              List.map (fun (_, ty, _) -> ty) types
+                          | _ -> [] end in
+                        if List.length params <> List.length args || List.length types <> List.length args
+                        then E.return Nothing else
+                        let formal_roots = List.foldr (fun (param, (ty, actual)) rest ->
+                          if not (AilTypesAux.is_pointer ty && gnu_function_target_type_equal ty (ctype_of actual) &&
+                              gnu_inline_parameter_unchanged param body && gnu_alloc_size_subject_unescaped param body)
+                          then rest else
+                          maybe rest (fun sym -> maybe rest (fun root -> (param, root) :: rest)
+                            (List.lookup sym roots)) (gnu_inline_direct_pointer_symbol actual))
+                          [] (List.zip params (List.zip types args)) in
+                        let callee_private_objects = List.filter (fun sym -> gnu_alloc_size_subject_unescaped sym body)
+                          (params ++ List.map fst (gnu_typed_statement_local_types body)) in
+                        let callee_null_formals = List.foldr (fun (param, (ty, actual)) rest ->
+                          if AilTypesAux.is_pointer ty && gnu_inline_parameter_unchanged param body &&
+                              List.elem param callee_private_objects &&
+                              gnu_boundary_known_null null_formals actual
+                          then param :: rest else rest) [] (List.zip params (List.zip types args)) in
+                        gnu_return_effect_statement allow_opaque (target :: seen) callee_private_objects
+                          callee_null_formals formal_roots body >>= fun writes ->
+                        E.return (maybe Nothing (fun writes -> Just (argument_writes ++ writes)) writes)
+                  end
+            end
+        end
+    | A.AilEbinary left _ right -> every [left; right]
+    | A.AilEcond condition yes no -> every (condition :: no :: maybe [] (fun value -> [value]) yes)
+    | A.AilErvalue operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | _ -> E.return Nothing
+  end in
+  action >>= fun result ->
+  let () = if result = Nothing then
+    Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+      "GNU return effect footprint rejected; roots=" ^ show roots ^
+        "; calls=" ^ show seen ^ "; expression=" ^ Pp.stringFromAil_expression expr)
+    else () in
+  E.return result
+and gnu_return_effect_statement allow_opaque seen private_objects null_formals roots stmt =
+  let self = gnu_return_effect_statement allow_opaque seen private_objects null_formals roots in
+  let expression = gnu_return_effect_expression allow_opaque seen private_objects null_formals roots in
+  let every actions = E.foldlM (fun accumulated action -> match accumulated with
+    | Nothing -> E.return Nothing
+    | Just before -> action >>= fun after ->
+        E.return (maybe Nothing (fun after -> Just (before ++ after)) after)
+    end) (Just []) actions in
+  match stmt.A.node with
+    | A.AilSskip -> E.return (Just [])
+    | A.AilSexpr value -> expression value
+    | A.AilSreturn value -> expression value
+    | A.AilSreturnVoid -> E.return (Just [])
+    | A.AilSdeclaration declarations ->
+        every (List.map (fun (_, value) -> maybe (E.return (Just [])) expression value) declarations)
+    | A.AilSblock bindings statements ->
+        if not (List.all (function
+          | (_, ((_, A.Automatic, _), _, qs, ty)) -> not qs.Ctype.volatile &&
+              not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings) then E.return Nothing else
+        gnu_return_effect_sequence allow_opaque seen private_objects null_formals roots statements
+    | A.AilSif condition yes no ->
+        let known = gnu_boundary_null_condition null_formals condition in
+        let () = if isJust known then Debug.print_debug_located 2 [Debug.DB_elaboration]
+          (Loc.locOf condition) (fun () -> "GNU return effect constant branch; taken=" ^ show known ^
+            "; expression=" ^ Pp.stringFromAil_expression condition) else () in
+        let branches = match known with
+          | Just true -> [self yes] | Just false -> [self no]
+          | Nothing -> [self yes; self no] end in
+        every (expression condition :: branches)
+    | A.AilSwhile condition body _ -> every [expression condition; self body]
+    | A.AilSdo body condition _ -> every [self body; expression condition]
+    | A.AilSlabel _ body (Just (Annot.LAloop_continue _)) -> self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_break _)) -> self body
+    | A.AilSbreak -> E.return (Just [])
+    | A.AilScontinue -> E.return (Just [])
+    | A.AilSmarker _ body -> self body
+    | _ -> E.return Nothing
+  end
+and gnu_return_effect_sequence allow_opaque seen private_objects null_formals roots statements =
+  match statements with
+    | [] -> E.return (Just [])
+    | first :: rest ->
+        gnu_return_effect_statement allow_opaque seen private_objects
+          null_formals roots first >>= fun first_writes ->
+        (match first_writes with
+          | Nothing -> E.return Nothing
+          | Just before ->
+              let roots = match gnu_return_effect_rebound private_objects roots rest first with
+                | Just (target, root) -> (target, root) :: roots
+                | Nothing -> roots end in
+              gnu_return_effect_sequence allow_opaque seen private_objects null_formals
+                roots rest >>= fun after ->
+              E.return (maybe Nothing (fun after -> Just (before ++ after)) after)
+          end)
+  end
+
+val gnu_return_summary_after_effect:
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) -> gnu_pointer_return_env ->
+  A.expression GenTypes.genTypeCategory -> E.elabM gnu_pointer_return_env
+let gnu_return_summary_after_effect tagDefs locals values expr =
+  (* This transfer only filters member lists; private pointer-value flags are
+     unchanged. With no members, its complete result is already known. The
+     caller still translates and executes the expression and checks origins. *)
+  if List.all (fun (_, (_, members)) -> members = []) values then E.return values else
+  (* Unknown-class preservation and known-value preservation have different
+     contracts. The former may cross an ordinary opaque call; the latter needs
+     a complete visible write footprint, with no opaque-call shortcut. A write
+     through another root may alias this record. Private pointer values retain
+     their existing whole-body nonescape gate in either mode. *)
+  let roots = List.foldr (fun (sym, ty) rest ->
+    if AilTypesAux.is_pointer ty then (sym, sym) :: rest else rest) [] locals in
+  gnu_return_effect_expression true [] (List.map fst locals) [] roots expr >>= fun writes ->
+  (if List.any (fun (_, (_, members)) -> List.any (fun (_, fact) ->
+      fact <> E.GNU_inline_unknown_extent_fact) members) values
+   then gnu_return_effect_expression false [] (List.map fst locals) [] roots expr
+   else E.return Nothing) >>= fun known_writes ->
+  let retained = List.map (fun (sym, (opaque, members)) ->
+    let members = match List.lookup sym locals with
+      | Just (Ctype.Ctype _ (Ctype.Pointer _ pointed)) ->
+          List.filter (fun (path, fact) ->
+            let footprint = if fact = E.GNU_inline_unknown_extent_fact then writes else known_writes in
+            maybe false (List.all (fun (root, written) ->
+              root = sym && gnu_memory_paths_disjoint tagDefs pointed written path)) footprint) members
+      | _ -> [] end in
+    (sym, (opaque, members))) values in
+  let count environment = List.foldl (fun total (_, (_, members)) -> total + List.length members) 0 environment in
+  let () = if count retained < count values then
+    Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+      "GNU return-summary member loss; before=" ^ show (count values) ^
+        "; after=" ^ show (count retained) ^ "; complete-footprint=" ^
+        show (maybe false (fun _ -> true) writes) ^ "; complete-known-footprint=" ^
+        show (maybe false (fun _ -> true) known_writes) ^ "; expression=" ^ Pp.stringFromAil_expression expr)
+    else () in
+  E.return retained
+
+(* A pointer assignment or return context applies the ordinary implicit conversion to a
+   literal integer zero. AIL retains that source literal until runtime lowering.
+   This predicate is analysis-only: other integer expressions, nonzero values
+   and arithmetic-return contexts receive no pointer or pointee certificate. *)
+val gnu_return_null_pointer:
+  Ctype.ctype -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_return_null_pointer result_ty (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (Implementation.has_amd64_sysv_abi () && AilTypesAux.is_pointer result_ty)
+  then false else if gnu_literal_null_pointer expr then true else match node with
+    | A.AilEconst (A.ConstantInteger (A.IConstant value _ _)) -> value = 0
+    | A.AilEannot _ operand -> gnu_return_null_pointer result_ty operand
+    | _ -> false
+  end
+
+(* AIL assignments retain their source operand type: the runtime lowering
+   performs the C assignment conversion. The summary need not require identical
+   types for arithmetic bookkeeping or an opaque object-pointer value. It never
+   converts an integer representation into a positive pointer certificate. *)
+val gnu_return_assignment_compatible:
+  Ctype.ctype -> A.expression GenTypes.genTypeCategory -> bool
+let gnu_return_assignment_compatible target value =
+  let source = ctype_of value in
+  gnu_function_target_type_equal target source ||
+    (AilTypesAux.is_arithmetic target && AilTypesAux.is_arithmetic source) ||
+    (AilTypesAux.is_pointer target && not (AilTypesAux.is_pointer_to_function target) &&
+      (gnu_return_null_pointer target value ||
+        (AilTypesAux.is_pointer source && not (AilTypesAux.is_pointer_to_function source))))
+
+val gnu_return_summary_store:
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) -> gnu_pointer_return_env ->
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_pointer_return_env)
+let gnu_return_summary_store tagDefs locals values sym value =
+  match List.lookup sym locals with
+    | Just ty ->
+        if not (gnu_return_assignment_compatible ty value && gnu_return_summary_effect_closed value)
+        then E.return Nothing else
+        gnu_return_summary_after_effect tagDefs locals values value >>= fun values ->
+        gnu_pointer_return_value tagDefs values value >>= fun (opaque, members) ->
+        (if gnu_function_target_type_equal ty (ctype_of value) then E.return members else
+          (* The existing external-storage certificate also covers an ordinary
+             unsized void-pointer result. A typed assignment selects its record
+             layout, but establishes only individual unknown member extents:
+             no allocation bound, initialization value or whole-record root. *)
+          match (ty, ctype_of value, value) with
+            | (Ctype.Ctype _ (Ctype.Pointer pointed_qs pointed),
+                Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ Ctype.Void)),
+                A.AnnotatedExpression _ _ _ (A.AilEcall _ _)) ->
+                if not opaque then E.return [] else
+                gnu_boundary_origin_storage [] [] value >>= fun storage ->
+                E.return (if storage then List.map (fun path ->
+                  (path, E.GNU_inline_unknown_extent_fact))
+                  (gnu_inline_pointer_member_paths tagDefs [] pointed_qs pointed) else [])
+            | _ -> E.return [] end) >>= fun typed_members ->
+        let fact = if not (AilTypesAux.is_pointer ty) then (false, []) else (opaque, typed_members) in
+        let () = if AilTypesAux.is_pointer ty then
+          Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf value) (fun () ->
+            "GNU return-summary pointer store " ^ show sym ^ "; value=" ^ show (fst fact) ^
+              "; members=" ^ show (List.length (snd fact))) else () in
+        E.return (Just ((sym, fact) :: List.filter (fun (other, _) -> other <> sym) values))
+    | Nothing -> E.return Nothing
+  end
+
+(* A typed store can retain disjoint fields of that same record. Other roots
+   might alias it, so their member facts are removed; private pointer values
+   themselves remain unchanged. Unions and overlapping paths do not qualify. *)
+val gnu_return_summary_member_store:
+  (Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)) ->
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) -> gnu_pointer_return_env ->
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe gnu_pointer_return_env)
+let gnu_return_summary_member_store capture_member tagDefs locals values left right =
+  let (qs, ty) = qualified_ctype_of left in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      not (gnu_return_assignment_compatible ty right) ||
+      not (gnu_memory_expression_readonly left && gnu_return_summary_effect_closed right)
+  then E.return Nothing else match gnu_return_member_path left with
+    | Nothing -> E.return Nothing
+    | Just (root, path) -> match List.lookup root locals with
+        | Just (Ctype.Ctype _ (Ctype.Pointer pointed_qs pointed)) ->
+            if pointed_qs.Ctype.volatile || AilTypesAux.is_atomic pointed
+            then E.return Nothing else
+            gnu_return_summary_after_effect tagDefs locals values right >>= fun values ->
+            gnu_pointer_return_value tagDefs values right >>= fun (opaque, _) ->
+            (if not (AilTypesAux.is_pointer ty) then E.return Nothing else
+              if opaque then E.return (Just E.GNU_inline_unknown_extent_fact)
+              else capture_member ty right) >>= fun stored ->
+            let retain (sym, (value_opaque, members)) =
+              let surviving = if sym <> root then [] else
+                List.filter (fun (other, _) ->
+                  gnu_memory_paths_disjoint tagDefs pointed path other) members in
+              let updated = if sym = root then
+                maybe surviving (fun fact -> (path, fact) :: surviving) stored else surviving in
+              (sym, (value_opaque, updated)) in
+            E.return (Just (List.map retain values))
+        | _ -> E.return Nothing end
+  end
+
+(* A dereference on a defined caller path establishes a non-null root.
+   Helper guards may use it only through an exact formal-to-root mapping. *)
+val gnu_return_helper_nonnull_condition:
+  gnu_return_effect_roots -> list Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> maybe bool
+let rec gnu_return_helper_nonnull_condition roots nonnull
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (gnu_memory_expression_readonly expr) then Nothing else
+  let known actual = maybe false (fun formal ->
+    maybe false (fun root -> List.elem root nonnull) (List.lookup formal roots))
+    (gnu_inline_direct_pointer_symbol actual) in
+  match node with
+    | A.AilEbinary left A.Ne right ->
+        if (known left && gnu_literal_null_pointer right) ||
+            (known right && gnu_literal_null_pointer left)
+        then Just true else Nothing
+    | A.AilEbinary left A.Eq right ->
+        if (known left && gnu_literal_null_pointer right) ||
+            (known right && gnu_literal_null_pointer left)
+        then Just false else Nothing
+    | A.AilEannot _ operand -> gnu_return_helper_nonnull_condition roots nonnull operand
+    | _ -> Nothing
+  end
+
+(* A visible helper can establish one closed pointer-member value on the
+   returned record. The walker accepts only exact direct roots, pure argument
+   evaluation, source-ordered local rebound, and a complete recognized body.
+   The ordinary effect footprint must independently name the same write.
+   A conditional branch grants a value only when a preceding definite caller
+   dereference proves its mapped pointer non-null. *)
+val gnu_return_helper_body_stores:
+  (Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)) ->
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) -> list Symbol.sym ->
+  gnu_return_effect_roots -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (Symbol.sym * list Symbol.identifier * E.gnu_inline_fact)))
+val gnu_return_helper_store_sequence:
+  (Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)) ->
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) -> list Symbol.sym ->
+  gnu_return_effect_roots -> list Symbol.sym -> list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (maybe (list (Symbol.sym * list Symbol.identifier * E.gnu_inline_fact)))
+let rec gnu_return_helper_body_stores capture_member tagDefs locals private_objects roots nonnull stmt =
+  let self = gnu_return_helper_body_stores capture_member tagDefs locals private_objects roots nonnull in
+  match stmt.A.node with
+    | A.AilSskip -> E.return (Just [])
+    | A.AilSreturnVoid -> E.return (Just [])
+    | A.AilSmarker _ body -> self body
+    | A.AilSblock bindings statements ->
+        if bindings <> [] then E.return Nothing else
+        gnu_return_helper_store_sequence capture_member tagDefs locals private_objects roots nonnull statements
+    | A.AilSif condition yes no ->
+        if not (gnu_memory_expression_readonly condition) then E.return Nothing else
+        (match gnu_constant_truth tagDefs condition with
+          | Just true -> self yes
+          | Just false -> self no
+          | Nothing -> (match gnu_return_helper_nonnull_condition roots nonnull condition with
+              | Just true -> self yes
+              | Just false -> self no
+              | Nothing -> E.return Nothing end) end)
+    | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEassign left right)) ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not (AilTypesAux.is_pointer ty) ||
+            not (gnu_return_assignment_compatible ty right) ||
+            not (gnu_memory_expression_readonly left && gnu_return_summary_effect_closed right)
+        then E.return Nothing else
+        (match gnu_return_member_path left with
+          | Nothing -> E.return Nothing
+          | Just (formal, path) -> (match List.lookup formal roots with
+              | Nothing -> E.return Nothing
+              | Just root -> (match List.lookup root locals with
+                  | Just (Ctype.Ctype _ (Ctype.Pointer pointed_qs pointed)) ->
+                      if not (List.elem path
+                        (gnu_inline_pointer_member_paths tagDefs [] pointed_qs pointed))
+                      then E.return Nothing else
+                      capture_member ty right >>= fun fact ->
+                      E.return (maybe Nothing (fun fact -> Just [(root, path, fact)]) fact)
+                  | _ -> E.return Nothing end)
+              end)
+          end)
+    | A.AilSexpr expr ->
+        E.return (if gnu_memory_expression_readonly expr then Just [] else Nothing)
+    | _ -> E.return Nothing
+  end
+and gnu_return_helper_store_sequence capture_member tagDefs locals private_objects roots nonnull statements =
+  match statements with
+    | [] -> E.return (Just [])
+    | first :: rest ->
+        (match gnu_return_effect_rebound private_objects roots rest first with
+          | Just (target, root) ->
+              gnu_return_helper_store_sequence capture_member tagDefs locals private_objects
+                ((target, root) :: roots) nonnull rest
+          | Nothing ->
+              gnu_return_helper_body_stores capture_member tagDefs locals private_objects
+                roots nonnull first >>= function
+                | Nothing -> E.return Nothing
+                | Just before ->
+                    gnu_return_helper_store_sequence capture_member tagDefs locals private_objects
+                      roots nonnull rest >>= fun after ->
+                    E.return (maybe Nothing (fun after -> Just (before ++ after)) after)
+              end
+        end)
+  end
+
+val gnu_return_helper_member_transfer:
+  (Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)) ->
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) -> gnu_pointer_return_env ->
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM gnu_pointer_return_env
+let gnu_return_helper_member_transfer capture_member tagDefs locals values nonnull
+    (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEcall callee args ->
+      if not (gnu_inline_direct_designator callee &&
+          gnu_memory_expression_readonly callee &&
+          List.all gnu_memory_expression_readonly args)
+      then E.return values else
+      gnu_call_attributes callee >>= fun attrs ->
+      if not (Cerb_attributes.has_gnu_noarg_attribute "always_inline" attrs) ||
+          Cerb_attributes.has_gnu_noarg_attribute "noipa" attrs ||
+          Cerb_attributes.has_gnu_noarg_attribute "noinline" attrs
+      then E.return values else
+      gnu_inline_function_target callee >>= function
+        | Nothing -> E.return values
+        | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+            E.gnu_memory_call_body target >>= function
+              | Nothing -> E.return values
+              | Just (params, body) ->
+                  if List.length params <> List.length args then E.return values else
+                  let roots = List.foldr (fun (param, actual) acc ->
+                    maybe acc (fun root ->
+                      if isJust (List.lookup root values) &&
+                          isJust (List.lookup root locals) &&
+                          gnu_function_target_type_equal
+                            (ctype_of actual) (maybe (ctype_of actual) (fun ty -> ty)
+                              (List.lookup root locals))
+                      then (param, root) :: acc else acc)
+                      (gnu_inline_direct_pointer_symbol actual))
+                    [] (List.zip params args) in
+                  if roots = [] then E.return values else
+                  let effect_roots = List.foldr (fun (sym, ty) acc ->
+                    if AilTypesAux.is_pointer ty then (sym, sym) :: acc else acc) [] locals in
+                  gnu_return_effect_expression false [] (List.map fst locals) []
+                    effect_roots expr >>= function
+                    | Nothing -> E.return values
+                    | Just footprint ->
+                        gnu_return_helper_body_stores capture_member tagDefs locals params roots nonnull
+                          body >>= function
+                          | Just [(root, path, fact)] ->
+                              if not (List.elem (root, path) footprint) then E.return values else
+                              E.return (List.map (fun (sym, (opaque, members)) ->
+                                if sym <> root then (sym, (opaque, members)) else
+                                match List.lookup root locals with
+                                  | Just (Ctype.Ctype _ (Ctype.Pointer _ pointed)) ->
+                                      (sym, (opaque, (path, fact) ::
+                                        List.filter (fun (other, _) ->
+                                          gnu_memory_paths_disjoint tagDefs pointed path other) members))
+                                  | _ -> (sym, (opaque, members)) end) values)
+                          | _ -> E.return values
+                        end
+                  end
+            end
+      end
+  | _ -> E.return values
+end
+
+val gnu_return_summary_join: gnu_pointer_return_env -> gnu_pointer_return_env -> gnu_pointer_return_env
+let gnu_return_summary_join first second = List.map (fun (sym, (opaque, members)) ->
+  (sym, match List.lookup sym second with
+    | Just (other, paths) -> (opaque && other, List.filter (fun path -> List.elem path paths) members)
+    | Nothing -> (false, []) end)) first
+
+(* A direct complete arithmetic object is distinct from every pointer object.
+   Updating it cannot change a pointer-member identity/extent. This does not
+   retain nested pointee contents or admit indirect/member/union scalar stores;
+   those still require the ordinary typed overlap transfer. *)
+val gnu_return_direct_scalar_update: A.expression GenTypes.genTypeCategory -> bool
+let gnu_return_direct_scalar_update (A.AnnotatedExpression _ _ _ node) =
+  let direct (A.AnnotatedExpression _ _ _ operand as expr) =
+    let (qs, ty) = qualified_ctype_of expr in
+    not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+      AilTypesAux.is_arithmetic ty && match operand with
+      | A.AilEident _ -> true | _ -> false end in
+  match node with
+    | A.AilEassign left right -> direct left && gnu_memory_expression_readonly right
+    | A.AilEcompoundAssign left _ right -> direct left && gnu_memory_expression_readonly right
+    | A.AilEunary A.PostfixIncr operand -> direct operand
+    | A.AilEunary A.PostfixDecr operand -> direct operand
+    | _ -> false
+  end
+
+(* A conservative expression transfer can retain only private pointer objects
+   proved unchanged by every effect. All pointee facts are discarded. *)
+val gnu_return_summary_forget_expression:
+  gnu_pointer_return_env -> A.expression GenTypes.genTypeCategory -> gnu_pointer_return_env
+let gnu_return_summary_forget_expression values expr =
+  let lost = List.foldr (fun (sym, (opaque, _)) rest ->
+    if opaque && not (gnu_inline_parameter_expression_safe sym expr) then sym :: rest else rest) [] values in
+  let () = if lost <> [] then Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+    "GNU return-summary discarded pointer values " ^ show lost ^ "; expression=" ^
+      Pp.stringFromAil_expression expr) else () in
+  List.map (fun (sym, (opaque, _)) ->
+    (sym, (opaque && gnu_inline_parameter_expression_safe sym expr, []))) values
+
+val gnu_return_assignment_terminal:
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory
+let rec gnu_return_assignment_terminal (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEassign _ right -> gnu_return_assignment_terminal right
+  | _ -> expr end
+
+val gnu_return_summary_expression:
+  (Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)) ->
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) -> gnu_pointer_return_env ->
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_pointer_return_env)
+let rec gnu_return_summary_expression capture_member tagDefs locals values nonnull
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let recurse = gnu_return_summary_expression capture_member tagDefs locals in
+  let self values expr = recurse values [] expr in
+  let sequence first second = self values first >>= function
+    | Nothing -> E.return Nothing
+    | Just next -> self next second end in
+  let store next left right = match left with
+    | A.AnnotatedExpression _ _ _ (A.AilEident sym) ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty then E.return Nothing else
+        if isJust (List.lookup sym locals) then
+          gnu_return_summary_store tagDefs locals next sym right
+        else if AilTypesAux.is_pointer ty && not (AilTypesAux.is_pointer_to_function ty) &&
+            gnu_return_assignment_compatible ty right && gnu_return_summary_effect_closed right
+        then
+          (* A direct nonlocal pointer store remains an observable publication.
+             It cannot modify the private pointer bindings, but may invalidate
+             any pointee alias. Keep no member facts across that publication. *)
+          gnu_return_summary_after_effect tagDefs locals next right >>= fun after ->
+          E.return (Just (gnu_return_summary_forget_expression after expr))
+        else E.return Nothing
+    | _ -> gnu_return_summary_member_store capture_member tagDefs locals next left right >>= function
+        | Just next -> E.return (Just next)
+        | Nothing ->
+            let (qs, ty) = qualified_ctype_of left in
+            if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                not (gnu_return_assignment_compatible ty right &&
+                  gnu_memory_expression_readonly left && gnu_return_summary_effect_closed right)
+            then E.return Nothing else
+            (* An indirect store cannot reach the whole-body unescaped pointer
+               objects, but may alias any recorded pointee/member. *)
+            E.return (Just (gnu_return_summary_forget_expression next expr))
+        end
+    end in
+  if gnu_return_direct_scalar_update expr then E.return (Just values) else
+  match node with
+    | A.AilEassign left right ->
+        if gnu_return_summary_effect_closed right then store values left right else
+        (* Rechecking this leaf's origin is sound only for the positive external
+           result class, not for a local/member read changed by an inner store.
+           The original runtime expression still evaluates the call only once. *)
+        let terminal = gnu_return_assignment_terminal right in
+        gnu_ordinary_unsized_pointer_result terminal >>= fun external_result ->
+        if not (external_result && gnu_memory_expression_readonly left &&
+            gnu_return_assignment_compatible (ctype_of left) right)
+        then E.return Nothing else self values right >>= function
+          | Nothing -> E.return Nothing | Just next -> store next left terminal end
+    | A.AilEbinary left A.Comma right -> sequence left right
+    | A.AilEbinary left A.And right -> self values left >>= function
+        | Nothing -> E.return Nothing
+        | Just next -> self next right >>= fun after ->
+            E.return (maybe Nothing (fun final -> Just (gnu_return_summary_join next final)) after)
+        end
+    | A.AilEbinary left A.Or right -> self values left >>= function
+        | Nothing -> E.return Nothing
+        | Just next -> self next right >>= fun after ->
+            E.return (maybe Nothing (fun final -> Just (gnu_return_summary_join next final)) after)
+        end
+    | A.AilEbinary left _ right ->
+        if gnu_memory_expression_readonly left then self values right else
+        if gnu_memory_expression_readonly right then self values left else E.return Nothing
+    | A.AilEcast _ _ operand -> self values operand
+    | A.AilEannot _ operand -> self values operand
+    | A.AilEcompoundAssign left _ right ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not ((AilTypesAux.is_arithmetic ty || AilTypesAux.is_pointer ty) &&
+              gnu_memory_expression_readonly left && gnu_memory_expression_readonly right)
+        then E.return Nothing else E.return (Just (gnu_return_summary_forget_expression values expr))
+    | A.AilEunary A.PostfixIncr operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (gnu_memory_expression_readonly operand)
+        then E.return Nothing else E.return (Just (gnu_return_summary_forget_expression values expr))
+    | A.AilEunary A.PostfixDecr operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (gnu_memory_expression_readonly operand)
+        then E.return Nothing else E.return (Just (gnu_return_summary_forget_expression values expr))
+    | _ -> if not (gnu_return_summary_effect_closed expr) then E.return Nothing else
+        gnu_return_summary_after_effect tagDefs locals values expr >>= fun values ->
+        gnu_return_helper_member_transfer capture_member tagDefs locals values nonnull expr >>= fun values ->
+        E.return (Just values)
+  end
+
+(* A loop without returns or outward control can be crossed conservatively by
+   forgetting every tracked value/member. Generated continue labels stay local;
+   source labels, hidden expression control and escaping jumps are rejected. *)
+val gnu_return_summary_discard_region:
+  list nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_return_summary_discard_region loops continuations stmt =
+  let self = gnu_return_summary_discard_region loops continuations in
+  let expr = gnu_dead_arm_expression_closed in
+  match stmt.A.node with
+    | A.AilSskip -> true
+    | A.AilSexpr value -> expr value
+    | A.AilSdeclaration declarations -> List.all (fun (_, value) -> maybe true expr value) declarations
+    | A.AilSblock bindings statements ->
+        List.all (function
+          | (_, ((_, A.Automatic, _), _, qs, ty)) -> not qs.Ctype.volatile &&
+              not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings && List.all self statements
+    | A.AilSif test yes no -> expr test && self yes && self no
+    | A.AilSwhile test body loop_id -> expr test &&
+        gnu_return_summary_discard_region (loop_id :: loops)
+          (gnu_alloc_loop_continuations loop_id body ++ continuations) body
+    | A.AilSdo body test loop_id -> expr test &&
+        gnu_return_summary_discard_region (loop_id :: loops)
+          (gnu_alloc_loop_continuations loop_id body ++ continuations) body
+    | A.AilSlabel _ body (Just (Annot.LAloop_continue owner)) -> List.elem owner loops && self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_break _)) ->
+        (match body.A.node with A.AilSskip -> true | _ -> false end)
+    | A.AilSgoto target -> List.elem target continuations
+    | A.AilSbreak -> loops <> []
+    | A.AilScontinue -> loops <> []
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+(* A member store through a direct local pointer proves it non-null on every
+   defined normal continuation. Filter the fact whenever that pointer binding
+   may be changed or its address escapes. No value or extent is inferred. *)
+val gnu_return_nonnull_after_expression:
+  list (Symbol.sym * Ctype.ctype) -> list Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> list Symbol.sym
+let gnu_return_nonnull_after_expression locals nonnull
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let retained = List.filter (fun sym -> gnu_inline_parameter_expression_safe sym expr) nonnull in
+  match node with
+    | A.AilEassign left right ->
+        (match gnu_return_member_path left with
+          | Just (root, _) ->
+              if isJust (List.lookup root locals) &&
+                  gnu_memory_expression_readonly left &&
+                  gnu_return_summary_effect_closed right &&
+                  gnu_inline_parameter_expression_safe root expr
+              then root :: retained else retained
+          | Nothing -> retained end)
+    | _ -> retained
+  end
+
+val gnu_return_summary_statement:
+  (Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)) ->
+  Ctype.ctype -> C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) ->
+  gnu_pointer_return_env -> list Symbol.sym ->
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (maybe (gnu_pointer_return_env * list Symbol.sym) * list (maybe gnu_pointer_return_info)))
+val gnu_return_summary_sequence:
+  (Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)) ->
+  Ctype.ctype -> C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) ->
+  gnu_pointer_return_env -> list Symbol.sym ->
+  list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (maybe (maybe (gnu_pointer_return_env * list Symbol.sym) * list (maybe gnu_pointer_return_info)))
+let rec gnu_return_summary_statement capture_member result_ty tagDefs locals values nonnull stmt =
+  let self = gnu_return_summary_statement capture_member result_ty tagDefs locals in match stmt.A.node with
+    | A.AilSskip -> E.return (Just (Just (values, nonnull), []))
+    | A.AilSexpr expr ->
+        gnu_return_summary_expression capture_member tagDefs locals values nonnull expr >>= fun next ->
+        E.return (maybe Nothing (fun next ->
+          Just (Just (next, gnu_return_nonnull_after_expression locals nonnull expr), [])) next)
+    | A.AilSreturn expr ->
+        if not (gnu_return_summary_effect_closed expr) then E.return Nothing else
+        if gnu_return_null_pointer result_ty expr then E.return (Just (Nothing, [Nothing])) else
+        gnu_return_summary_after_effect tagDefs locals values expr >>= fun values ->
+        gnu_pointer_return_value tagDefs values expr >>= fun info ->
+        let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+          "GNU return-summary exit; value=" ^ show (fst info) ^ "; members=" ^ show (List.length (snd info)) ^
+            "; environment=" ^ show (List.map (fun (sym, (opaque, members)) ->
+              show sym ^ ":" ^ show opaque ^ "/" ^ show (List.length members)) values)) in
+        E.return (Just (Nothing, [Just info]))
+    | A.AilSblock bindings statements ->
+        if not (List.all (function
+          | (_, ((_, A.Automatic, _), _, qs, ty)) -> not qs.Ctype.volatile &&
+              not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings) then E.return Nothing
+        else gnu_return_summary_sequence capture_member result_ty tagDefs locals values nonnull statements
+    | A.AilSdeclaration declarations ->
+        E.foldlM (fun current (sym, value) -> match current with
+          | Nothing -> E.return Nothing
+          | Just values -> maybe (E.return (Just values))
+              (gnu_return_summary_store tagDefs locals values sym) value
+          end) (Just values) declarations >>= fun next ->
+        E.return (maybe Nothing (fun next -> Just (Just (next, []), [])) next)
+    | A.AilSif condition yes no ->
+        gnu_return_summary_expression capture_member tagDefs locals values nonnull condition >>= function
+          | Nothing -> E.return Nothing
+          | Just values ->
+            let after_condition = List.filter
+              (fun sym -> gnu_inline_parameter_expression_safe sym condition) nonnull in
+            self values after_condition yes >>= fun first ->
+            self values after_condition no >>= fun second ->
+            E.return (match (first, second) with
+              | (Just (left, first_exits), Just (right, second_exits)) ->
+                  Just ((match (left, right) with
+                    | (Nothing, other) -> other | (other, Nothing) -> other
+                    | (Just (a, a_nonnull), Just (b, b_nonnull)) ->
+                        Just (gnu_return_summary_join a b,
+                          List.filter (fun sym -> List.elem sym b_nonnull) a_nonnull) end),
+                    first_exits ++ second_exits)
+              | _ -> Nothing end)
+        end
+    | A.AilSwhile _ _ _ ->
+        E.return (if gnu_return_summary_discard_region [] [] stmt then
+          Just (Just ([], []), []) else Nothing)
+    | A.AilSdo body test _ ->
+        if gnu_memory_expression_readonly test && gnu_constant_truth tagDefs test = Just false
+        then
+          (* A constant-false do guard follows exactly one normal body exit.
+             The statement walker still rejects unhandled jumps; its explicit
+             return exits remain separate. No runtime effect is removed. *)
+          self values nonnull body >>= fun result ->
+          let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf test) (fun () ->
+            "GNU return-summary single-iteration do; summarized=" ^
+              show (maybe false (fun _ -> true) result)) in
+          E.return (match result with
+            | Just checked -> Just checked
+            | Nothing -> if gnu_return_summary_discard_region [] [] stmt then
+                Just (Just ([], []), []) else Nothing end)
+        else E.return (if gnu_return_summary_discard_region [] [] stmt then
+          Just (Just ([], []), []) else Nothing)
+    | A.AilSlabel _ body (Just (Annot.LAloop_break _)) ->
+        E.return (match body.A.node with
+          | A.AilSskip -> Just (Just (values, nonnull), [])
+          | _ -> Nothing end)
+    | A.AilSmarker _ body -> self values nonnull body
+    | _ -> E.return Nothing end
+and gnu_return_summary_sequence capture_member result_ty tagDefs locals values nonnull statements =
+  match statements with
+    | [] -> E.return (Just (Just (values, nonnull), []))
+    | first :: rest ->
+        gnu_return_summary_statement capture_member result_ty tagDefs locals values nonnull first >>= function
+          | Nothing -> E.return Nothing
+          | Just (Nothing, exits) -> E.return (Just (Nothing, exits))
+          | Just (Just (next_values, next_nonnull), exits) ->
+              gnu_return_summary_sequence capture_member result_ty tagDefs locals
+                next_values next_nonnull rest >>= fun result ->
+              E.return (maybe Nothing (fun (normal, later) ->
+                Just (normal, exits ++ later)) result)
+        end
+  end
+
+(* The ordinary return walker tracks individual stores. A search helper can
+   instead establish a class invariant over all its control paths. This requires
+   the same complete effect census used for loop boundaries, with positive
+   caller origins, and checks every return separately. *)
+val gnu_incoming_return_values:
+  A.statement GenTypes.genTypeCategory -> list (A.expression GenTypes.genTypeCategory)
+let rec gnu_incoming_return_values stmt =
+  let self = gnu_incoming_return_values in
+  match stmt.A.node with
+    | A.AilSreturn value -> [value]
+    | A.AilSblock _ statements -> List.concat (List.map self statements)
+    | A.AilSif _ yes no -> self yes ++ self no
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSswitch _ body -> self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSmarker _ body -> self body
+    | _ -> []
+  end
+
+val gnu_incoming_return_tail: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_incoming_return_tail stmt = match stmt.A.node with
+  | A.AilSreturn _ -> true
+  | A.AilSblock _ statements -> (match List.dest_init statements with
+      | Just (_, last) -> gnu_incoming_return_tail last | Nothing -> false end)
+  | A.AilSif _ yes no -> gnu_incoming_return_tail yes && gnu_incoming_return_tail no
+  | A.AilSlabel _ body _ -> gnu_incoming_return_tail body
+  | A.AilSmarker _ body -> gnu_incoming_return_tail body
+  | _ -> false
+end
+
+val gnu_record_children:
+  A.expression GenTypes.genTypeCategory -> maybe (list (A.expression GenTypes.genTypeCategory))
+let gnu_record_children (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEunary _ value -> Just [value]
+  | A.AilEbinary left _ right -> Just [left; right]
+  | A.AilEassign left right -> Just [left; right]
+  | A.AilEcompoundAssign left _ right -> Just [left; right]
+  | A.AilEcond test yes no -> Just (test :: no :: maybe [] (fun value -> [value]) yes)
+  | A.AilEcall callee args -> Just (callee :: args)
+  | A.AilEcast _ _ value -> Just [value]
+  | A.AilEannot _ value -> Just [value]
+  | A.AilErvalue value -> Just [value]
+  | A.AilEarray_decay value -> Just [value]
+  | A.AilEfunction_decay value -> Just [value]
+  | A.AilEmemberof value _ -> Just [value]
+  | A.AilEmemberofptr value _ -> Just [value]
+  | A.AilEarray _ _ values -> Just (List.foldr (fun value rest -> maybe rest (fun value -> value :: rest) value) [] values)
+  | A.AilEstruct _ fields -> Just (List.foldr (fun (_, value) rest -> maybe rest (fun value -> value :: rest) value) [] fields)
+  | A.AilEunion _ _ value -> Just (maybe [] (fun value -> [value]) value)
+  | A.AilEcompound _ ty value -> if gnu_inline_fixed_object_type ty then Just [value] else Nothing
+  | A.AilEsizeof _ ty -> if gnu_inline_fixed_object_type ty then Just [] else Nothing
+  | A.AilEsizeof_expr value -> if gnu_inline_fixed_object_type (ctype_of value) then Just [value] else Nothing
+  | A.AilEalignof _ _ -> Just []
+  | A.AilEoffsetof _ _ -> Just []
+  | A.AilEassert value -> Just [value]
+  | A.AilEva_start value _ -> Just [value]
+  | A.AilEva_arg value _ -> Just [value]
+  | A.AilEva_copy left right -> Just [left; right]
+  | A.AilEva_end value -> Just [value]
+  | A.AilEbuiltin (A.AilBGNU_asm _ _ _ _ _ _) -> Nothing
+  | A.AilEbuiltin _ -> Just []
+  | A.AilEident _ -> Just []
+  | A.AilEconst _ -> Just []
+  | A.AilEstr _ -> Just []
+  | _ -> Nothing
+end
+
+val gnu_record_statement_children:
+  A.statement GenTypes.genTypeCategory ->
+  maybe (list (A.expression GenTypes.genTypeCategory) * list (A.statement GenTypes.genTypeCategory))
+let gnu_record_statement_children stmt = match stmt.A.node with
+  | A.AilSskip -> Just ([], [])
+  | A.AilSexpr value -> Just ([value], [])
+  | A.AilSreturn value -> Just ([value], [])
+  | A.AilSreturnVoid -> Just ([], [])
+  | A.AilSblock _ statements -> Just ([], statements)
+  | A.AilSif test yes no -> Just ([test], [yes; no])
+  | A.AilSwhile test body _ -> Just ([test], [body])
+  | A.AilSdo body test _ -> Just ([test], [body])
+  | A.AilSswitch test body -> Just ([test], [body])
+  | A.AilScase _ body -> Just ([], [body])
+  | A.AilScase_rangeGNU _ _ body -> Just ([], [body])
+  | A.AilSdefault body -> Just ([], [body])
+  | A.AilSlabel _ body _ -> Just ([], [body])
+  | A.AilSmarker _ body -> Just ([], [body])
+  | A.AilSpar statements -> Just ([], statements)
+  | A.AilSdeclaration declarations ->
+      Just (List.foldr (fun (_, value) rest -> maybe rest (fun value -> value :: rest) value) [] declarations, [])
+  | A.AilSgoto _ -> Just ([], [])
+  | A.AilSbreak -> Just ([], [])
+  | A.AilScontinue -> Just ([], [])
+  | _ -> Nothing
+end
+
+
+(* A helper that only reads selected pointer members needs those positive
+   caller snapshots, not an origin for every field in the containing record.
+   Census every use of the formal before using a restricted root in the return
+   proof. Bare reads, address escapes, writes, casts of the formal and passing
+   it onward are excluded. The root never enters executable translation state. *)
+val gnu_projected_origin_expression:
+  Symbol.sym -> list Symbol.identifier -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_projected_origin_expression formal members (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_projected_origin_expression formal members in
+  match node with
+    | A.AilErvalue
+        (A.AnnotatedExpression _ _ _ (A.AilEmemberofptr
+          (A.AnnotatedExpression _ _ _ (A.AilErvalue
+            (A.AnnotatedExpression _ _ _ (A.AilEident sym)))) member) as field_access) ->
+        if sym = formal then
+          let (qs, ty) = qualified_ctype_of field_access in
+          List.elem member members && not qs.Ctype.volatile &&
+            not (AilTypesAux.is_atomic ty) && AilTypesAux.is_pointer ty &&
+            not (AilTypesAux.is_pointer_to_function ty)
+        else maybe false (List.all self) (gnu_record_children expr)
+    | A.AilEident sym -> sym <> formal
+    | _ -> maybe false (List.all self) (gnu_record_children expr)
+  end
+
+val gnu_projected_origin_statement:
+  Symbol.sym -> list Symbol.identifier -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_projected_origin_statement formal members stmt =
+  match gnu_record_statement_children stmt with
+    | Nothing -> false
+    | Just (expressions, children) ->
+        List.all (gnu_projected_origin_expression formal members) expressions &&
+          List.all (gnu_projected_origin_statement formal members) children
+  end
+
+val gnu_projected_caller_origin:
+  C.core_tag_definitions -> Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_projected_caller_origin tagDefs formal body actual =
+  if not (gnu_inline_parameter_unchanged formal body &&
+    gnu_alloc_size_subject_unescaped formal body) then E.return false else
+  match actual with
+    | A.AnnotatedExpression _ _ _ (A.AilErvalue
+        (A.AnnotatedExpression _ _ _ (A.AilEident _))) ->
+        gnu_memory_slot_of false actual >>= (function
+          | Nothing -> E.return false
+          | Just slot ->
+              gnu_inline_memory_contents tagDefs (ctype_of actual) slot >>= fun facts ->
+              let members = List.foldr (fun (path, fact) rest ->
+                if fact <> E.GNU_inline_unknown_extent_fact then rest else match path with
+                  | [member] -> member :: rest
+                  | _ -> rest end) [] facts in
+              let certified = members <> [] &&
+                gnu_projected_origin_statement formal members body in
+              let () = if certified then Debug.print_debug_located 2 [Debug.DB_elaboration]
+                (Loc.locOf actual) (fun () -> "GNU projected return input " ^ show formal ^
+                  "; members=" ^ show members) else () in
+              E.return certified
+          end)
+    | _ -> E.return false
+  end
+
+val gnu_incoming_return_body:
+  Ctype.ctype -> C.core_tag_definitions -> gnu_boundary_return_resolver -> list Symbol.sym -> list Symbol.sym ->
+  list Symbol.sym -> list (A.expression GenTypes.genTypeCategory) ->
+  A.statement GenTypes.genTypeCategory -> E.elabM (bool * bool)
+let gnu_incoming_return_body result_ty tagDefs resolver caller_values caller_roots params args body =
+  if not (gnu_incoming_return_tail body) then E.return (false, false) else
+  E.mapM (fun (param, actual) ->
+    gnu_boundary_origin_value_with resolver caller_values caller_roots actual >>= fun value ->
+    gnu_boundary_origin_storage_with resolver caller_values caller_roots actual >>= fun storage ->
+    (if storage || not value then E.return storage else
+      gnu_projected_caller_origin tagDefs param body actual) >>= fun storage ->
+    E.return (param, value, storage)) (List.zip params args) >>= fun entries ->
+  let values = List.foldr (fun (param, value, _) rest -> if value then param :: rest else rest) [] entries in
+  let roots = List.foldr (fun (param, _, storage) rest -> if storage then param :: rest else rest) [] entries in
+  let locals = List.map fst (List.filter (fun (local, ty) ->
+    AilTypesAux.is_arithmetic ty || (AilTypesAux.is_pointer ty &&
+      not (AilTypesAux.is_pointer_to_function ty))) (gnu_typed_statement_local_types body)) in
+  gnu_boundary_origin_locals_with resolver (2 * List.length locals + 1) locals body values roots >>= fun (values, roots) ->
+  let null_params = List.foldr (fun (param, actual) rest ->
+    if gnu_literal_null_pointer actual then param :: rest else rest) [] (List.zip params args) in
+  gnu_boundary_effects_statement_with resolver [] true (params ++ locals) params null_params false [] [] values roots Nothing
+    body body >>= fun preserves ->
+  if not preserves then E.return (false, false) else
+  let returns = gnu_incoming_return_values body in
+  E.mapM (gnu_boundary_origin_value_with resolver values roots) returns >>= fun returned_values ->
+  E.mapM (fun value -> if gnu_return_null_pointer result_ty value then E.return true
+    else gnu_boundary_origin_storage_with resolver values roots value) returns >>= fun returned_storage ->
+  let opaque = returns <> [] && List.all (fun checked -> checked) returned_values in
+  let contents = opaque && List.all (fun checked -> checked) returned_storage &&
+    List.any (fun value -> not (gnu_return_null_pointer result_ty value)) returns in
+  E.return (opaque, contents)
+
+(* A visible wrapper may return a positively unsized external result even
+   while its body performs unrelated bookkeeping and initializes members. The
+   dominant return proof concerns the pointer object only: it grants neither a
+   size nor unchanged pointee contents. Declared sized allocators stay distinct. *)
+val gnu_forwarded_opaque_return:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_forwarded_opaque_return (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (AilTypesAux.is_pointer (ctype_of expr)) ||
+    AilTypesAux.is_pointer_to_function (ctype_of expr) then E.return false else
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+        then E.return false else gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_pointer_refinement_possible target >>= fun refinement ->
+              if refinement then E.return false else E.gnu_memory_call_body target >>= function
+                | Nothing -> E.return false
+                | Just (params, body) ->
+                    if List.length params <> List.length args then E.return false else
+                    (match gnu_alloc_return_value_with (fun subject ->
+                        gnu_alloc_return_guard_with subject [] []) target body with
+                      | Nothing -> E.return false
+                      | Just value -> (match gnu_returned_pointer_call true value with
+                          | Nothing -> E.return false
+                          | Just (inner, _) ->
+                              gnu_ordinary_opaque_memory_call inner >>= fun opaque ->
+                              gnu_call_attributes inner >>= fun attrs ->
+                              E.return (opaque && (match attrs with Annot.Attrs entries ->
+                                not (List.any (Cerb_attributes.is_gnu_named_attribute "alloc_size") entries) end))
+                        end)
+                    end)
+              end
+        end
+    | _ -> E.return false
+  end
+
+(* Nested return summaries are acyclic and parameterized by the caller's
+   positive classes. The effect census receives this same resolver, so local
+   helper results and pointer comparisons use the same checked origins. *)
+val gnu_incoming_return_call:
+  list Symbol.sym -> C.core_tag_definitions -> gnu_boundary_return_resolver
+let rec gnu_incoming_return_call seen tagDefs values roots
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  E.with_gnu_return_query_cache (
+  if not (AilTypesAux.is_pointer (ctype_of expr) || AilTypesAux.is_arithmetic (ctype_of expr)) then E.return (false, false) else
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+        then E.return (false, false) else gnu_inline_function_target callee >>= function
+          | Nothing -> E.return (false, false)
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              if List.elem target seen then E.return (false, false) else
+              E.memo_gnu_return_query target (seen, values, roots, expr) (
+              E.gnu_memory_call_body target >>= function
+                | Nothing -> E.return (false, false)
+                | Just (params, body) ->
+                    let types = match ctype_of callee with
+                      | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ types false))) ->
+                          List.map (fun (_, ty, _) -> ty) types
+                      | _ -> [] end in
+                    let exact = List.map (fun (ty, actual) ->
+                      gnu_function_target_type_equal ty (ctype_of actual)) (List.zip types args) in
+                    let compatible = List.map (fun (ty, actual) ->
+                      gnu_origin_actual_compatible ty actual) (List.zip types args) in
+                    let unchanged = List.all (fun param -> gnu_inline_parameter_unchanged param body &&
+                      gnu_alloc_size_subject_unescaped param body) params in
+                    let return_types = not (AilTypesAux.is_arithmetic (ctype_of expr)) ||
+                      List.all (fun value -> AilTypesAux.is_arithmetic (ctype_of value))
+                        (gnu_incoming_return_values body) in
+                    let eligible = List.length params = List.length args && List.length types = List.length args &&
+                      List.all (fun yes -> yes) compatible && unchanged && return_types in
+                    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+                      "GNU incoming return admission " ^ show target ^ "; exact-types=" ^ show exact ^
+                        "; origin-types=" ^ show compatible ^ "; unchanged=" ^ show unchanged ^
+                        "; return-types=" ^ show return_types ^ "; eligible=" ^ show eligible) in
+                    if not eligible then E.return (false, false) else
+                    gnu_incoming_return_body (ctype_of expr) tagDefs (gnu_incoming_return_call (target :: seen) tagDefs)
+                      values roots params args body >>= fun result ->
+                    (if fst result then E.return result else
+                      (* A returned private pointer can retain its ordinary
+                         external origin while unrelated memory changes. Reuse
+                         the dominant-return proof, granting no pointee facts. *)
+                      gnu_forwarded_opaque_return expr >>= fun forwarded ->
+                      let () = if forwarded then Debug.print_debug_located 2 [Debug.DB_elaboration]
+                        (Loc.locOf expr) (fun () -> "GNU incoming return uses forwarded value: " ^ show target) else () in
+                      E.return (if forwarded then (true, false) else result)) >>= fun result ->
+                    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+                      "GNU incoming return result " ^ show target ^ "; value=" ^ show (fst result) ^
+                        "; contents=" ^ show (snd result)) in
+                    E.return result
+              end)
+        end
+    | _ -> E.return (false, false)
+  end)
+
+val gnu_incoming_return_info:
+  C.core_tag_definitions -> Ctype.ctype -> list Symbol.sym ->
+  list (A.expression GenTypes.genTypeCategory) -> A.statement GenTypes.genTypeCategory ->
+  E.elabM gnu_pointer_return_info
+let gnu_incoming_return_info tagDefs result_ty params args body =
+  gnu_boundary_capture_origins >>= fun (values, roots) ->
+  gnu_incoming_return_body result_ty tagDefs (gnu_incoming_return_call [] tagDefs) values roots params args body >>=
+    fun (opaque, contents) ->
+  let members = if not contents then [] else match result_ty with
+    | Ctype.Ctype _ (Ctype.Pointer qs pointed) ->
+        gnu_inline_pointer_member_paths tagDefs [] qs pointed
+    | _ -> [] end in
+  let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+    "GNU incoming helper return; opaque=" ^ show opaque ^
+      "; members=" ^ show (List.length members)) in
+  E.return (opaque, List.map (fun path -> (path, E.GNU_inline_unknown_extent_fact)) members)
+
+val gnu_visible_pointer_return_info:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM gnu_pointer_return_info
+let gnu_visible_pointer_return_info translate_expr tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let action =
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return (false, []) else match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+        then E.return (false, []) else gnu_inline_function_target callee >>= function
+          | Nothing -> E.return (false, [])
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_pointer_refinement_possible target >>= fun refinement ->
+              let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+                "GNU visible return eligibility " ^ show target ^ "; refinement=" ^ show refinement) in
+              if refinement then E.return (false, []) else E.gnu_memory_call_body target >>= function
+                | Nothing -> E.return (false, [])
+                | Just (params, body) ->
+                    let types = match ctype_of callee with
+                      | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ types false))) ->
+                          List.map (fun (_, ty, _) -> ty) types
+                      | _ -> [] end in
+                    if List.length params <> List.length args || List.length types <> List.length args ||
+                        not (List.all (fun (ty, actual) -> gnu_origin_actual_compatible ty actual)
+                          (List.zip types args)) ||
+                        not (List.all (fun param -> gnu_inline_parameter_unchanged param body &&
+                          gnu_alloc_size_subject_unescaped param body) params)
+                    then E.return (false, []) else
+                    E.mapM (fun (param, actual) ->
+                      gnu_memory_unknown_pointer_value actual >>= fun opaque ->
+                      gnu_memory_slot_of false actual >>= fun slot ->
+                      (match slot with
+                        | Just slot -> gnu_inline_memory_contents tagDefs (ctype_of actual) slot
+                        | Nothing -> E.return [] end) >>= fun members ->
+                      E.return (param, (opaque, List.filter (fun (_, fact) ->
+                        fact = E.GNU_inline_unknown_extent_fact) members))
+                    ) (List.zip params args) >>= fun values ->
+                    (* The statement walker checks automatic storage, qualifiers
+                       and fixed object types before processing any block. Private
+                       arithmetic locals are needed for ordinary helper bookkeeping;
+                       their values establish no pointer or member certificates. *)
+                    let locals = List.filter (fun (local, ty) ->
+                      (AilTypesAux.is_pointer ty || AilTypesAux.is_arithmetic ty) &&
+                        gnu_alloc_size_subject_unescaped local body)
+                      (gnu_typed_statement_local_types body) in
+                    let excluded = params ++ List.map fst (gnu_typed_statement_local_types body) in
+                    let capture_member = gnu_return_capture_member translate_expr tagDefs excluded in
+                    gnu_return_summary_statement capture_member (ctype_of expr) tagDefs
+                      ((List.zip params types) ++ locals) values [] body >>= fun result ->
+                    let info = match result with
+                      | Just (Nothing, exits) ->
+                          let nonnull = List.foldr (fun item rest -> maybe rest (fun info -> info :: rest) item) [] exits in
+                          let members = match nonnull with
+                            | [] -> []
+                            | (_, first) :: rest -> List.filter (fun path ->
+                                List.all (fun (_, paths) -> List.elem path paths) rest) first end in
+                          (exits <> [] && List.all (fun item -> maybe true fst item) exits, members)
+                      | _ -> (false, []) end in
+                    let (accepted, members) = info in
+                    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+                      "GNU visible pointer return " ^ show target ^ "; accepted=" ^ show accepted ^
+                      "; summary-complete=" ^ show (isJust result) ^ "; returned-members=" ^ show (List.length members) ^ "; input-member-counts=" ^ show (List.map (fun (_, (_, members)) -> List.length members) values)) in
+                    if accepted then E.return info else
+                    gnu_incoming_return_info tagDefs (ctype_of expr) params args body >>= fun (incoming, incoming_members) ->
+                    E.return (incoming, members ++ List.filter
+                      (fun (path, _) -> isNothing (List.lookup path members)) incoming_members)
+              end
+        end
+    | _ -> E.return (false, []) end in
+  action >>= fun (accepted, members) ->
+  if accepted then E.return (accepted, members) else
+  gnu_forwarded_opaque_return expr >>= fun forwarded ->
+  E.return (if forwarded then (true, []) else (accepted, members))
+
+(* Capture before evaluation, then publish after the guaranteed assignment.
+   No runtime call, pointer load or helper body is replayed by this summary. *)
+val gnu_visible_return_assignment_facts:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let rec gnu_visible_return_assignment_facts translate_expr tagDefs (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_visible_return_assignment_facts translate_expr tagDefs in match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident sym) as left) value ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty)
+        then E.return [] else E.gnu_alloc_size_subject_allowed sym >>= fun private_destination ->
+        if not private_destination then E.return [] else
+        if not (gnu_function_target_type_equal ty (ctype_of value)) then E.return [] else
+        gnu_visible_pointer_return_info translate_expr tagDefs value >>= fun (opaque, members) ->
+        E.return ((if opaque then [((false, sym, []), E.GNU_inline_unknown_extent_fact)] else []) ++
+          List.map (fun (path, fact) -> ((true, sym, path), fact)) members)
+    | A.AilEbinary left bop right ->
+        if not (gnu_scalar_is_equality bop) then E.return [] else
+        if gnu_literal_null_pointer right || gnu_size_literal_offset right then self left
+        else if gnu_literal_null_pointer left || gnu_size_literal_offset left then self right
+        else E.return []
+    | A.AilEannot _ operand -> self operand
+    | _ -> E.return [] end
+
+val gnu_external_result_slot_facts:
+  C.core_tag_definitions -> Symbol.sym -> Ctype.ctype ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_external_result_slot_facts tagDefs target ty value =
+  E.gnu_opaque_return_contents_allowed >>= fun allowed ->
+  E.gnu_alloc_size_subject_allowed target >>= fun private_destination ->
+  if not allowed || not private_destination || not (gnu_function_target_type_equal ty (ctype_of value))
+  then E.return [] else
+    gnu_external_pointer_contents tagDefs value >>= fun paths ->
+    E.return (List.map (fun path -> ((true, target, path), E.GNU_inline_unknown_extent_fact)) paths)
+
+val gnu_guaranteed_result_slot_facts:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let rec gnu_guaranteed_result_slot_facts tagDefs (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_guaranteed_result_slot_facts tagDefs in
+  match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident target) as left) value ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty)
+        then E.return [] else gnu_external_result_slot_facts tagDefs target ty value
+    | A.AilEbinary left A.And _ -> self left
+    | A.AilEbinary left A.Or _ -> self left
+    | A.AilEbinary left _ right ->
+        (* Retain only an assignment with a readonly sibling; no claimed slot
+           can survive an unsequenced or subsequent clobber by guesswork. *)
+        if gnu_memory_expression_readonly right then self left
+        else if gnu_memory_expression_readonly left then self right else E.return []
+    | A.AilEcond condition _ _ -> self condition
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | _ -> E.return []
+  end
+
+val gnu_register_opaque_call_outputs:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM unit
+let gnu_register_opaque_call_outputs tagDefs expr =
+  gnu_opaque_call_output_lvalues expr >>= fun lvalues ->
+  E.mapM_ (fun lvalue ->
+    gnu_memory_slot_of true lvalue >>= function
+      | Just slot ->
+          let (_, sym, _) = slot in
+          E.gnu_indexed_memory_symbols >>= fun indexed ->
+          if List.elem sym indexed then E.return () else
+          gnu_memory_root_type sym lvalue >>= fun root_ty ->
+          gnu_memory_store_survivors_at tagDefs slot root_ty >>= fun (facts, roots, aliases) ->
+          E.with_preserved_gnu_memory facts roots aliases (E.return ()) >>
+          E.register_gnu_memory_fact slot E.GNU_inline_unknown_extent_fact
+      | _ -> E.return ()
+    end) lvalues >>
+  gnu_explicit_record_call_slots tagDefs expr >>= fun record_slots ->
+  E.mapM_ (fun slot -> E.register_gnu_memory_fact slot E.GNU_inline_unknown_extent_fact)
+    record_slots >>
+  gnu_volatile_record_call_slots tagDefs expr >>= fun volatile_record_slots ->
+  E.mapM_ (fun slot -> E.register_gnu_memory_fact slot E.GNU_inline_unknown_value_fact)
+    volatile_record_slots >>
+  gnu_register_opaque_memory_definitions expr >>
+  gnu_guaranteed_result_slot_facts tagDefs expr >>= fun returned_slots ->
+  E.mapM_ (fun (slot, fact) -> E.register_gnu_memory_fact slot fact) returned_slots
+
+(* A false OR and a true AND require their right operand to execute.
+   Recover only the final guaranteed operand; an earlier output may have been
+   clobbered later. Integer zero comparisons account for logical desugaring.
+   Ambiguous outcomes and conditional expressions do not establish outputs. *)
+val gnu_condition_final_operand:
+  bool -> A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_condition_final_operand truth (A.AnnotatedExpression _ _ _ node as expr) =
+  let zero (A.AnnotatedExpression _ _ _ node) = match node with
+    | A.AilEconst (A.ConstantInteger (A.IConstant value _ _)) -> value = 0
+    | _ -> false end in
+  match node with
+    | A.AilEbinary _ A.Or right ->
+        if truth then Nothing else gnu_condition_final_operand false right
+    | A.AilEbinary _ A.And right ->
+        if truth then gnu_condition_final_operand true right else Nothing
+    | A.AilEbinary left A.Eq right ->
+        if zero right && AilTypesAux.is_integer (ctype_of left)
+        then gnu_condition_final_operand (not truth) left
+        else if zero left && AilTypesAux.is_integer (ctype_of right)
+        then gnu_condition_final_operand (not truth) right else Just expr
+    | A.AilEbinary left A.Ne right ->
+        if zero right && AilTypesAux.is_integer (ctype_of left)
+        then gnu_condition_final_operand truth left
+        else if zero left && AilTypesAux.is_integer (ctype_of right)
+        then gnu_condition_final_operand truth right else Just expr
+    | A.AilEannot _ operand -> gnu_condition_final_operand truth operand
+    | A.AilEcond _ _ _ -> Nothing
+    | _ -> Just expr
+  end
+
+val gnu_register_condition_outputs:
+  C.core_tag_definitions -> bool -> A.expression GenTypes.genTypeCategory -> E.elabM unit
+let gnu_register_condition_outputs tagDefs truth condition =
+  match gnu_condition_final_operand truth condition with
+    | Nothing -> E.return ()
+    | Just operand -> gnu_opaque_memory_effects operand >>= fun supported ->
+        if supported then gnu_register_opaque_call_outputs tagDefs operand else E.return ()
+  end
+
+val gnu_memory_write_destination:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe (A.expression GenTypes.genTypeCategory))
+let gnu_memory_write_destination (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEassign left right -> gnu_memory_certified_readonly right >>= fun readonly ->
+      E.return (if readonly then Just left else Nothing)
+  | A.AilEcompoundAssign left _ right -> gnu_memory_certified_readonly right >>= fun readonly ->
+      E.return (if readonly then Just left else Nothing)
+  | A.AilEunary A.PostfixIncr left -> E.return (Just left)
+  | A.AilEunary A.PostfixDecr left -> E.return (Just left)
+  | _ -> E.return Nothing
+end
+
+(* Peel only wrappers which execute the same one store unconditionally.
+   The other binary operand must be syntactically effect-free, so neither
+   permitted evaluation order can change the store's input memory. *)
+val gnu_unconditional_memory_store:
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (A.expression GenTypes.genTypeCategory))
+let rec gnu_unconditional_memory_store (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_unconditional_memory_store in
+  match node with
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEbinary left bop right ->
+        if List.elem bop [A.And; A.Or; A.Comma] then E.return Nothing else
+        if gnu_memory_expression_readonly right then self left
+        else if gnu_memory_expression_readonly left then self right
+        else E.return Nothing
+    | _ -> gnu_memory_write_destination expr >>= fun destination ->
+        E.return (if isJust destination then Just expr else Nothing)
+  end
+
+(* Capture before evaluation and publish only after the guaranteed call returns.
+   The call may replace the pointer-array contents; it cannot replace an unescaped
+   lexical base object. No size, value, range or initialized-element claim follows. *)
+val gnu_opaque_pointer_array_call_roots:
+  A.expression GenTypes.genTypeCategory -> E.elabM (list Symbol.sym)
+let rec gnu_opaque_pointer_array_call_roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_opaque_pointer_array_call_roots in
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_memory_expression_readonly callee && List.all gnu_memory_expression_readonly args)
+        then E.return [] else
+        gnu_ordinary_opaque_memory_call callee >>= fun direct ->
+        gnu_positive_opaque_indirect_call callee >>= fun indirect ->
+        gnu_call_attributes callee >>= fun attrs ->
+        let has_access = match attrs with Annot.Attrs entries ->
+          List.any (Cerb_attributes.is_gnu_named_attribute "access") entries end in
+        if not (direct || indirect) || has_access ||
+            Cerb_attributes.has_gnu_noarg_attribute "const" attrs ||
+            Cerb_attributes.has_gnu_noarg_attribute "pure" attrs then E.return [] else
+        E.mapM (fun arg -> match gnu_pointer_array_root arg with
+          | Nothing -> E.return Nothing
+          | Just sym -> E.gnu_alloc_size_subject_allowed sym >>= fun unescaped ->
+              E.return (if unescaped && gnu_inline_parameter_expression_safe sym expr
+                then Just sym else Nothing)
+          end) args >>= fun roots ->
+        E.return (List.foldr (fun item rest -> maybe rest (fun sym -> sym :: rest) item) [] roots)
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident _) as left) right ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_arithmetic ty)
+        then E.return [] else self right
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | _ -> E.return []
+  end
+
+(* A struct projection keeps the existing boundary on the addressed
+   subobject. No union view, pointer cast or indexed address is inferred here;
+   the slot resolver separately identifies the already-certified source root. *)
+val gnu_opaque_struct_projection:
+  A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_opaque_struct_projection (A.AnnotatedExpression _ _ _ node) =
+  let struct_type = function Ctype.Ctype _ (Ctype.Struct _) -> true | _ -> false end in
+  let pointer_base base = match ctype_of base with
+    | Ctype.Ctype _ (Ctype.Pointer qs ty) ->
+        not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+          struct_type ty && gnu_memory_expression_readonly base
+    | _ -> false end in
+  match node with
+    | A.AilEunary A.Address operand -> gnu_opaque_struct_projection operand
+    | A.AilEmemberof base _ ->
+        struct_type (ctype_of base) && gnu_opaque_struct_projection base
+    | A.AilEmemberofptr base _ -> pointer_base base
+    | A.AilEunary A.Indirection base -> pointer_base base
+    | A.AilEannot _ operand -> gnu_opaque_struct_projection operand
+    | _ -> false
+  end
+
+(* A local pointer can retain a positive pointee-memory boundary from its
+   initializer/copy. This copies the boundary only, never source bounds, stored
+   values, or a missing result. Publish after the ordinary runtime assignment. *)
+val gnu_opaque_pointer_initializer:
+  C.core_tag_definitions -> Symbol.sym -> Ctype.qualifiers -> Ctype.ctype ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_opaque_pointer_initializer tagDefs target qs ty expr =
+  let container = match ty with
+    | Ctype.Ctype _ (Ctype.Pointer _ pointed) ->
+        AilTypesAux.is_struct_or_union pointed || AilTypesAux.is_pointer pointed
+    | _ -> false end in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not container
+  then E.return false else E.gnu_alloc_size_subject_allowed target >>= fun unescaped ->
+  if not unescaped then E.return false else
+  if gnu_size_effects expr <> Just false then
+    (* Immediate member snapshots are weaker than this transitive origin.
+       Preserve a returned root only when the complete incoming-return proof
+       establishes it from actual caller storage. This never upgrades the
+       unsized-value fallback or a merely partial set of member facts. *)
+    if not (gnu_function_target_type_equal ty (ctype_of expr)) then E.return false else
+    (match expr with
+      | A.AnnotatedExpression _ _ _ (A.AilEcall callee _) ->
+          gnu_call_attributes callee >>= fun attrs ->
+          let noipa = Cerb_attributes.has_gnu_noarg_attribute "noipa" attrs in
+          let alloc_size = match attrs with Annot.Attrs entries ->
+            List.any (Cerb_attributes.is_gnu_named_attribute "alloc_size") entries end in
+          if noipa && not alloc_size then E.return true else
+          gnu_inline_function_target callee >>= function
+            | Nothing -> E.return false
+            | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+                E.gnu_pointer_refinement_possible target >>= fun refinement ->
+                if refinement then E.return false else
+                gnu_boundary_capture_origins >>= fun (values, roots) ->
+                gnu_incoming_return_call [] tagDefs values roots expr >>= fun (_, storage) ->
+                E.return storage
+          end
+      | _ -> E.return false
+    end)
+  else let source = match expr with
+    | A.AnnotatedExpression _ _ _ (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym))) ->
+        E.gnu_memory_opaque_subobject sym []
+    | _ -> E.return false end in
+  source >>= fun direct -> if direct then E.return true else
+  gnu_memory_slot_of false expr >>= function
+    | Just (true, root, path) ->
+        if path = [] || gnu_opaque_struct_projection expr
+        then E.gnu_memory_opaque_subobject root path else E.return false
+    | _ -> E.return false
+  end
+
+val gnu_opaque_pointer_assignment_roots:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM (list Symbol.sym)
+let rec gnu_opaque_pointer_assignment_roots tagDefs (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_opaque_pointer_assignment_roots tagDefs in match node with
+  | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident sym) as left) right ->
+      let (qs, ty) = qualified_ctype_of left in
+      gnu_opaque_pointer_initializer tagDefs sym qs ty right >>= fun opaque ->
+      E.return (if opaque then [sym] else [])
+  | A.AilEbinary left bop right ->
+      if not (gnu_scalar_is_equality bop) then E.return [] else
+      if gnu_literal_null_pointer right then self left
+      else if gnu_literal_null_pointer left then self right
+      else E.return []
+  | A.AilEannot _ operand -> self operand
+  | _ -> E.return []
+end
+
+(* Nested assignment has several stores, not one opaque effect.
+   Admit only readonly scalar-member destinations under one unchanged root,
+   with a readonly terminal RHS. The root object itself is never assigned.
+   Intersect the existing typed disjoint-store certificates for EVERY store;
+   this preserves no written field, alias, newly guessed origin or contents. *)
+val gnu_member_assignment_destinations:
+  A.expression GenTypes.genTypeCategory -> maybe (list (A.expression GenTypes.genTypeCategory))
+let rec gnu_member_assignment_destinations (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilEassign left right ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not ((AilTypesAux.is_pointer ty || AilTypesAux.is_arithmetic ty) &&
+              gnu_memory_expression_readonly left)
+        then Nothing else
+          maybe Nothing (fun rest -> Just (left :: rest)) (gnu_member_assignment_destinations right)
+    | _ -> if gnu_memory_expression_readonly expr then Just [] else Nothing
+  end
+
+val gnu_member_assignment_survivors:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot)))
+let gnu_member_assignment_survivors tagDefs expr =
+  match gnu_member_assignment_destinations expr with
+    | Just (first :: second :: rest) ->
+        E.mapM (fun left -> gnu_memory_slot_of true left >>= function
+          | Just ((true, sym, path) as slot) ->
+              if path = [] then E.return Nothing else
+              E.gnu_branch_subject_allowed sym >>= fun stable ->
+              if not stable then E.return Nothing else
+              gnu_memory_root_type sym left >>= function
+                | Just (Ctype.Ctype _ (Ctype.Pointer _ pointed_ty)) ->
+                    E.return (Just (sym, slot, pointed_ty))
+                | _ -> E.return Nothing end
+          | _ -> E.return Nothing end) (first :: second :: rest) >>= fun destinations ->
+        (match destinations with
+          | Just (root, _, _) :: _ ->
+              if not (List.all (function Just (sym, _, _) -> sym = root | _ -> false end) destinations)
+              then E.return Nothing else
+              E.mapM (function
+                | Just (_, slot, ty) -> gnu_memory_store_survivors_at tagDefs slot (Just ty)
+                | Nothing -> E.return ([], [], []) end) destinations >>= fun summaries ->
+              (match summaries with
+                | (facts, _, _) :: others ->
+                    let kept = List.filter (fun entry ->
+                      List.all (fun (survivors, _, _) -> List.elem entry survivors) others) facts in
+                    let pointers = List.foldr (fun (slot, fact) acc ->
+                      maybe acc (fun value -> (slot, value) :: acc) (gnu_memory_pointer_identity fact)) [] kept in
+                    E.return (Just (pointers, [], []))
+                | [] -> E.return Nothing end)
+          | _ -> E.return Nothing end)
+    | _ -> E.return Nothing
+  end
+
+(* Compose two independent effects for a private direct pointer assignment.
+   The call may change memory; the assignment changes its destination object.
+   Preserve only facts surviving BOTH checks. Testing the whole assignment as
+   an arbitrary store loses the callee's valid class certificate. *)
+val gnu_private_call_assignment_survivors:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym *
+    list (Symbol.sym * E.gnu_memory_slot)))
+let gnu_private_call_assignment_survivors tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident sym) as left) right ->
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not (AilTypesAux.is_pointer ty) || AilTypesAux.is_pointer_to_function ty ||
+            gnu_memory_expression_readonly right ||
+            not (gnu_inline_parameter_expression_safe sym right)
+        then E.return Nothing else
+        E.gnu_alloc_size_subject_allowed sym >>= fun private_object ->
+        if not private_object then E.return Nothing else
+        gnu_opaque_memory_survivors right >>= fun (call_facts, call_roots) ->
+        gnu_memory_store_survivors_at tagDefs (false, sym, []) (Just ty) >>=
+          fun (store_facts, store_roots, _) ->
+        gnu_memory_unescaped_value_survivors expr >>= fun private_facts ->
+        let facts = List.filter (fun (slot, fact) -> List.lookup slot store_facts = Just fact) call_facts in
+        let roots = List.filter (fun root -> List.elem root store_roots) call_roots in
+        E.return (Just (private_facts ++ List.filter (fun (slot, _) ->
+          isNothing (List.lookup slot private_facts)) facts, roots, []))
+    | _ -> E.return Nothing
+  end
+
+(* Copying an ordinary pointer-cell value into a named pointer object leaves
+   the source cell's value unchanged: disjoint cells are untouched, and exact
+   overlap writes the same value. Non-exact overlap is not a defined assignment.
+   Require the same pointer type or the standard object-pointer to void-pointer
+   conversion, and an unchanged unescaped parameter holding the source address.
+   No pointee contents, source-address alias, or unknown root is retained. *)
+val gnu_pointer_copy_source_survivor:
+  A.expression GenTypes.genTypeCategory -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_pointer_copy_source_survivor (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident written) as left)
+      (A.AnnotatedExpression _ _ _ (A.AilErvalue source) as right) ->
+      let (left_qs, left_ty) = qualified_ctype_of left in
+      let (source_qs, source_ty) = qualified_ctype_of source in
+      let void_destination = match left_ty with
+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ Ctype.Void)) -> true
+        | _ -> false end in
+      if left_qs.Ctype.volatile || source_qs.Ctype.volatile ||
+          AilTypesAux.is_atomic left_ty || AilTypesAux.is_atomic source_ty ||
+          not (AilTypesAux.is_pointer left_ty && AilTypesAux.is_pointer source_ty) ||
+          AilTypesAux.is_pointer_to_function left_ty || AilTypesAux.is_pointer_to_function source_ty ||
+          not (gnu_function_target_type_equal left_ty source_ty || void_destination) ||
+          not (gnu_memory_expression_readonly right)
+      then E.return [] else
+      gnu_memory_slot_of true source >>= function
+        | Just ((true, root, []) as slot) ->
+            E.gnu_indexed_memory_symbols >>= fun indexed ->
+            E.gnu_alloc_size_subject_allowed root >>= fun unescaped ->
+            E.gnu_branch_parameter_subject_allowed root >>= fun unchanged ->
+            if root = written || List.elem root indexed || not (unescaped && unchanged)
+            then E.return [] else
+              E.gnu_memory_fact slot >>= fun current ->
+              E.return (match maybe Nothing gnu_memory_pointer_identity current with
+                | Just identity -> if gnu_member_fact_closed identity &&
+                    gnu_inline_fact_alloc_size_dependencies identity = []
+                  then [(slot, identity)] else []
+                | Nothing -> [] end)
+        | _ -> E.return [] end
+  | _ -> E.return []
+end
+
+let gnu_memory_store_survivors tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  gnu_memory_write_destination expr >>= function
+    | Nothing -> gnu_private_call_assignment_survivors tagDefs expr >>= function
+        | Just survivors -> E.return survivors
+        | Nothing -> gnu_member_assignment_survivors tagDefs expr >>= function
+        | Just (facts, roots, aliases) ->
+            (* A recognized same-root chain is handled before the fallback.
+               Compose the literal-only class certificate here as well; the
+               stronger identity/alias survivors still come from that handler. *)
+            (if gnu_literal_integer_store_chain expr || gnu_literal_null_store_chain expr
+             then gnu_opaque_memory_survivors expr else E.return ([], []))
+              >>= fun (unknown, opaque_roots) ->
+            E.return (facts ++ List.filter (fun (slot, _) ->
+                not (isJust (List.lookup slot facts))) unknown,
+              roots ++ List.filter (fun root -> not (List.elem root roots)) opaque_roots,
+              aliases)
+        | Nothing -> gnu_memory_unescaped_value_survivors expr >>= fun facts ->
+            gnu_opaque_memory_survivors expr >>= fun (unknown, roots) ->
+            gnu_opaque_pointer_array_call_roots expr >>= fun array_roots ->
+            (* A conditional scalar RHS may call an opaque predicate. It does
+               not justify ordinary store survivors, but its two integer arms
+               may retain this one positively classified pointer-load origin. *)
+            (match node with
+              | A.AilEassign left right -> gnu_opaque_byte_store_survivor left right
+              | _ -> E.return [] end) >>= fun scalar_origins ->
+            E.return (facts ++ unknown ++ scalar_origins, array_roots ++ roots, [])
+        end
+      end
+    | Just left ->
+        let (qs, ty) = qualified_ctype_of left in
+        if AilTypesAux.is_atomic ty then E.return ([], [], []) else
+        if qs.Ctype.volatile then
+          (* A simple store to one named complete arithmetic object cannot
+             replace a distinct private ordinary pointer object. Keep only
+             existing closed pointer identities in such objects or ordinary
+             struct members. No volatile value, mutable size/selector, pointee
+             contents, opaque root or alias certificate crosses this boundary.
+             The original volatile store still executes in ordinary lowering. *)
+          (match node with
+            | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident written)) _ ->
+                if not (AilTypesAux.is_arithmetic ty) then E.return ([], [], []) else
+                gnu_memory_unescaped_pointer_survivors expr >>= fun survivors ->
+                E.mapM (fun (((indirect, sym, path) as slot), fact) ->
+                  if indirect || sym = written || not (gnu_member_fact_closed fact)
+                  then E.return Nothing else
+                  E.lookup_gnu_analysis_object_type sym >>= fun object_ty ->
+                  E.return (match object_ty with
+                    | Just (object_qs, object_ty) ->
+                        if List.elem path (gnu_inline_pointer_member_paths tagDefs [] object_qs object_ty)
+                        then Just (slot, fact) else Nothing
+                    | Nothing -> Nothing end)) survivors >>= fun optional ->
+                E.return (List.foldr (fun item rest ->
+                  maybe rest (fun fact -> fact :: rest) item) [] optional, [], [])
+            | _ -> E.return ([], [], [])
+          end)
+        else
+        (* Evaluating a destination such as *p++ changes p, but cannot write
+           another complete private object. Check every operand and dependency
+           before the effectful-lvalue boundary discards general store facts. *)
+        gnu_memory_unescaped_value_survivors expr >>= fun private_survivors ->
+        if not (gnu_memory_expression_readonly left)
+        then E.return (private_survivors, [], []) else
+        (match node with
+          | A.AilEassign _ right -> gnu_opaque_byte_store_survivor left right
+          | _ -> E.return [] end) >>= fun byte_survivors ->
+        (match node with
+          | A.AilEassign _ right -> gnu_known_byte_array_store_survivors left right
+          | _ -> E.return ([], []) end) >>= fun (array_survivors, array_aliases) ->
+        let byte_survivors = array_survivors ++ List.filter (fun (slot, _) ->
+          isNothing (List.lookup slot array_survivors)) byte_survivors in
+        (if gnu_literal_integer_store_chain expr || gnu_literal_null_store_chain expr
+         then gnu_opaque_memory_survivors expr else E.return ([], []))
+          >>= fun (literal_survivors, literal_roots) ->
+        let byte_survivors = byte_survivors ++ literal_survivors in
+        (* Even an unclassified indirect store cannot reach complete automatic
+           pointer objects whose addresses never escape. Retain their positive
+           identity facts, with contents stripped and every dependency checked. *)
+        let byte_survivors = private_survivors ++ List.filter
+          (fun (slot, _) -> not (isJust (List.lookup slot private_survivors))) byte_survivors in
+        gnu_pointer_copy_source_survivor expr >>= fun copied_source ->
+        let byte_survivors = copied_source ++ List.filter
+          (fun (slot, _) -> isNothing (List.lookup slot copied_source)) byte_survivors in
+        gnu_memory_slot_of true left >>= function
+          | Nothing -> E.return (byte_survivors, literal_roots, array_aliases)
+          | Just (indirect, sym, path) ->
+              gnu_memory_root_type sym left >>= fun root_ty ->
+              let root_ty = maybe Nothing (fun ty -> if not indirect then Just ty else match ty with
+                | Ctype.Ctype _ (Ctype.Pointer _ pointed_ty) -> Just pointed_ty
+                | _ -> Nothing
+              end) root_ty in
+              let root_ty = if isJust (gnu_errno_cell_lvalue left) then Just ty else root_ty in
+              gnu_memory_store_survivors_at tagDefs (indirect, sym, path) root_ty >>= fun (facts, roots, aliases) ->
+              let aliases = aliases ++ List.filter (fun (alias, _) ->
+                isNothing (List.lookup alias aliases)) array_aliases in
+              (* The assignment replaces the pointer's old binding. This
+                 transient alias is restored only after the original store by
+                 with_preserved_gnu_memory, and later writes/calls/joins revoke
+                 it normally; it is not an immutable entry certificate. *)
+              let aliases = maybe aliases (fun (destination, target) ->
+                (destination, target) :: List.filter (fun (prior, _) -> prior <> destination) aliases)
+                (gnu_memory_direct_address_assignment expr) in
+              let roots = roots ++ List.filter (fun root -> not (List.elem root roots)) literal_roots in
+              let facts = facts ++ List.filter (fun (slot, _) -> not (isJust (List.lookup slot facts))) byte_survivors in
+              (match node with
+                | A.AilEassign _ right ->
+                    if not (AilTypesAux.is_pointer ty) || AilTypesAux.is_pointer_to_function ty ||
+                        AilTypesAux.is_pointer_to_function (ctype_of right) ||
+                        not (gnu_memory_expression_readonly right)
+                    then E.return false else gnu_memory_unknown_pointer_value right
+                | _ -> E.return false end) >>= fun unknown ->
+              if not unknown then E.return (facts, roots, aliases) else
+                E.gnu_memory_snapshot >>= fun (prior_facts, prior_roots, _) ->
+                E.gnu_indexed_memory_symbols >>= fun derived ->
+                (* A positively unknown object-pointer value preserves the
+                   same extent class in explicit snapshots as in root defaults.
+                   Retain no known value, bound, contents or derived index. *)
+                let unknown_facts = List.filter (fun (((_, sym, _) as slot), fact) ->
+                  not (List.elem sym derived) && fact = E.GNU_inline_unknown_extent_fact &&
+                    List.lookup slot prior_facts = Just fact && isNothing (List.lookup slot facts))
+                  prior_facts in
+                let facts = facts ++ unknown_facts in
+                E.mapM (fun root ->
+                  if List.elem root derived then E.return Nothing else
+                  E.gnu_memory_opaque_subobject root [] >>= fun consistent ->
+                  E.return (if consistent then Just root else Nothing)) prior_roots >>= fun kept_roots ->
+                E.return (facts, List.foldr (fun root rest ->
+                  maybe rest (fun sym -> sym :: rest) root) [] kept_roots, aliases)
+        end
+  end
+
+(* Expand readonly helper returns for metadata only. The original call and
+   every load/branch still execute. Private locals stand for their initialized
+   values only while there are no stores, volatile accesses or intervening
+   calls. Each switch entry must terminate; a missing default is not exhaustive. *)
+val gnu_readonly_return_no_case_entry: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_readonly_return_no_case_entry stmt =
+  let self = gnu_readonly_return_no_case_entry in match stmt.A.node with
+    | A.AilScase _ _ -> false
+    | A.AilScase_rangeGNU _ _ _ -> false
+    | A.AilSdefault _ -> false
+    | A.AilSlabel _ _ _ -> false
+    | A.AilSif _ yes no -> self yes && self no
+    | A.AilSblock _ children -> List.all self children
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSmarker _ body -> self body
+    | A.AilSpar children -> List.all self children
+    | A.AilSvla_scope _ _ _ _ -> false
+    (* A nested switch owns its case entries. *)
+    | _ -> true end
+
+val gnu_readonly_return_case_paths:
+  list (A.statement GenTypes.genTypeCategory) ->
+  maybe (bool * list (maybe (integer * integer) * list (A.statement GenTypes.genTypeCategory)))
+let rec gnu_readonly_return_case_paths statements = match statements with
+  | [] -> Just (false, [])
+  | first :: rest ->
+      let labelled = match first.A.node with
+        | A.AilScase number body -> Just (Just (number, number), body)
+        | A.AilScase_rangeGNU low high body -> Just (Just (low, high), body)
+        | A.AilSdefault body -> Just (Nothing, body)
+        | _ -> Nothing end in
+      (match (labelled, gnu_readonly_return_case_paths rest) with
+        | (Just (selection, body), Just (has_default, paths)) ->
+            (* Chained case labels share this suffix. Ordinary statements
+               preceding the first label are not entered by the switch. *)
+            (match gnu_readonly_return_case_paths [body] with
+              | Just (nested_default, nested_paths) ->
+                  Just (isNothing selection || has_default || nested_default,
+                    (selection, body :: rest) :: List.map
+                      (fun (key, path) -> (key, path ++ rest)) nested_paths ++ paths)
+              | Nothing -> Nothing end)
+        | (Nothing, Just result) ->
+            if gnu_readonly_return_no_case_entry first then Just result else Nothing
+        | _ -> Nothing end)
+end
+
+val gnu_readonly_return_origins:
+  C.core_tag_definitions ->
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (A.expression GenTypes.genTypeCategory)))
+val gnu_readonly_return_sequence:
+  C.core_tag_definitions -> list (Symbol.sym * Ctype.ctype) ->
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (maybe (list (A.expression GenTypes.genTypeCategory)))
+let rec gnu_readonly_return_origins tagDefs bindings body =
+  match gnu_record_body_parts body with
+    | Nothing -> E.return Nothing
+    | Just (locals, statements) ->
+        if not (List.all (fun (sym, _) -> gnu_alloc_size_subject_unescaped sym body) locals)
+        then E.return Nothing else gnu_readonly_return_sequence tagDefs locals bindings statements
+  end
+and gnu_readonly_return_sequence tagDefs locals bindings statements =
+  let sequence = gnu_readonly_return_sequence tagDefs locals in
+  let branch body = gnu_readonly_return_origins tagDefs bindings body in
+  let substitute expr = match gnu_record_value_substitute bindings expr with
+    | Just value -> if gnu_memory_expression_readonly value &&
+        gnu_function_target_type_equal (ctype_of expr) (ctype_of value)
+        then Just value else Nothing
+    | Nothing -> Nothing end in
+  let merge results = List.foldr (fun result rest -> match (result, rest) with
+    | (Just values, Just later) -> Just (values ++ later)
+    | _ -> Nothing end) (Just []) results in
+  match statements with
+    | [] -> E.return Nothing
+    | first :: rest -> match first.A.node with
+        | A.AilSskip -> sequence bindings rest
+        | A.AilSdeclaration declarations ->
+            let next = List.foldl (fun prior (sym, value) -> match (prior, value) with
+              | (Just known, Just value) ->
+                  if isJust (List.lookup sym known) ||
+                      not (maybe false (fun ty -> gnu_function_target_type_equal ty (ctype_of value))
+                        (List.lookup sym locals)) then Nothing else
+                  (match gnu_record_value_substitute known value with
+                    | Just actual -> if gnu_memory_expression_readonly actual &&
+                        gnu_function_target_type_equal (ctype_of value) (ctype_of actual)
+                        then Just ((sym, actual) :: known) else Nothing
+                    | Nothing -> Nothing end)
+              | (Just known, Nothing) -> Just known
+              | _ -> Nothing end) (Just bindings) declarations in
+            maybe (E.return Nothing) (fun known -> sequence known rest) next
+        | A.AilSreturn value -> E.return (maybe Nothing (fun value -> Just [value]) (substitute value))
+        | A.AilSexpr expr ->
+            (* A hidden statement expression could jump past the call.
+               Noreturn describes the call, not arbitrary argument control. *)
+            if not (gnu_return_summary_effect_closed expr) then E.return Nothing else
+            gnu_expression_calls_noreturn expr >>= fun stops ->
+            if stops then E.return (Just []) else E.return Nothing
+        | A.AilSif condition yes no ->
+            (match substitute condition with
+              | Nothing -> E.return Nothing
+              | Just test -> gnu_scalar_knowledge_of tagDefs test >>= fun known ->
+                  (match known with
+                    | Just (low, high, _) ->
+                        if low = 0 && high = 0 then branch no
+                        else if high < 0 || low > 0 then branch yes
+                        else branch yes >>= fun left -> branch no >>= fun right ->
+                          E.return (merge [left; right])
+                    | _ -> branch yes >>= fun left -> branch no >>= fun right ->
+                        E.return (merge [left; right]) end)
+            end)
+        | A.AilSswitch condition body ->
+            (match (substitute condition, body.A.node) with
+              | (Just test, A.AilSblock [] children) ->
+                  (match gnu_readonly_return_case_paths children with
+                    | Just (true, paths) ->
+                        gnu_scalar_knowledge_of tagDefs test >>= fun known ->
+                        let selected = match known with
+                          | Just (low, high, _) ->
+                              if low <> high then paths else
+                              let matching = List.filter (fun (key, _) -> maybe false
+                                (fun (first, last) -> first <= low && low <= last) key) paths in
+                              if matching = [] then List.filter (fun (key, _) -> isNothing key) paths
+                              else matching
+                          | _ -> paths end in
+                        E.mapM (fun (_, path) -> sequence bindings path) selected >>= fun results ->
+                        E.return (merge results)
+                    | _ -> E.return Nothing end)
+              | _ -> E.return Nothing end)
+        | A.AilScase _ body -> sequence bindings (body :: rest)
+        | A.AilScase_rangeGNU _ _ body -> sequence bindings (body :: rest)
+        | A.AilSdefault body -> sequence bindings (body :: rest)
+        | _ -> E.return Nothing
+      end
+  end
+
+val gnu_readonly_call_origins:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (Symbol.sym * list (A.expression GenTypes.genTypeCategory)))
+let gnu_readonly_call_origins tagDefs (A.AnnotatedExpression _ _ loc node as expr) =
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+        then E.return Nothing else gnu_inline_function_target callee >>= function
+          | Nothing -> E.return Nothing
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_pointer_refinement_possible target >>= fun refinement ->
+              if refinement then E.return Nothing else E.gnu_memory_call_body target >>= function
+                | Nothing -> E.return Nothing
+                | Just (params, body) -> (match ctype_of callee with
+                    | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _
+                        (Ctype.Function (_, result_ty) types false))) ->
+                        if List.length params <> List.length args || List.length params <> List.length types ||
+                            not (gnu_function_target_type_equal result_ty (ctype_of expr)) ||
+                            not (List.all (fun (qs, ty, _) -> not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty)) types) ||
+                            not (List.all (fun param -> gnu_inline_parameter_unchanged param body &&
+                              gnu_alloc_size_subject_unescaped param body) params)
+                        then E.return Nothing else
+                        let bindings = List.map (fun ((sym, (_, ty, _)), actual) ->
+                          (sym, if gnu_function_target_type_equal ty (ctype_of actual) then actual else
+                            A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type ty)) [] loc
+                              (A.AilEcast Ctype.no_qualifiers ty actual)))
+                          (List.zip (List.zip params types) args) in
+                        gnu_readonly_return_origins tagDefs bindings body >>= function
+                          | Just (first :: rest) -> E.return (Just (target, first :: rest))
+                          | _ -> E.return Nothing
+                        end
+                    | _ -> E.return Nothing end)
+              end
+        end
+    | _ -> E.return Nothing
+  end
+
+val gnu_readonly_return_fact:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe E.gnu_inline_fact)
+let gnu_readonly_return_fact translate_expr tagDefs expr =
+  let analyze = gnu_readonly_call_origins tagDefs expr >>= function
+    | Nothing -> E.return Nothing
+    | Just (target, origins) ->
+        E.mapM (capture_gnu_inline_fact translate_expr tagDefs (ctype_of expr))
+          origins >>= fun facts ->
+        let joined = match facts with
+          | Just first :: rest -> List.foldl (fun acc value -> match (acc, value) with
+              | (Just first, Just second) -> E.gnu_join_inline_facts first second
+              | _ -> Nothing end) (Just first) rest
+          | _ -> Nothing end in
+        let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+          "GNU readonly helper return " ^ show target ^ "; alternatives=" ^
+            show (List.length facts) ^ "; fact=" ^ gnu_inline_fact_kind joined) in
+        E.return joined
+    end in
+  fun st ->
+    let (fact, next) = analyze st in
+    (if next.E.errors = st.E.errors then fact else Nothing,
+      <| st with E.fresh_supply= next.E.fresh_supply |>)
+
+val gnu_capture_memory_initializer:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> E.gnu_memory_slot -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let rec gnu_capture_memory_initializer translate_expr tagDefs slot (A.AnnotatedExpression _ _ _ node as expr) =
+  let (indirect, sym, path) = slot in
+  let member ident value = gnu_capture_memory_initializer translate_expr tagDefs
+    (indirect, sym, path ++ [ident]) value in
+  gnu_record_call_value expr >>= function
+  | Just (A.AnnotatedExpression _ _ _ (A.AilEstruct _ members)) ->
+      E.mapM (fun (ident, value) -> maybe (E.return []) (member ident) value) members >>=
+        fun facts -> E.return (List.concat facts)
+  | _ ->
+  if not (gnu_memory_expression_readonly expr) then
+    if AilTypesAux.is_pointer (ctype_of expr) then
+      if gnu_volatile_pointer_value_load (ctype_of expr) expr then
+        E.return [(slot, E.GNU_inline_unknown_value_fact)]
+      else gnu_capture_saved_array_index translate_expr tagDefs expr >>= fun saved_index ->
+      if isJust saved_index then E.return (maybe [] (fun fact -> [(slot, fact)]) saved_index) else
+      gnu_readonly_return_fact translate_expr tagDefs expr >>= fun returned ->
+      if isJust returned then
+        E.gnu_alloc_size_subject_allowed sym >>= fun private_destination ->
+        let contents_safe = not indirect && path = [] && private_destination in
+        E.return (maybe [] (fun fact -> if contents_safe then
+          (slot, fact) :: List.map (fun (member, value) -> ((true, sym, member), value))
+            (E.gnu_extent_member_snapshots fact)
+          else maybe [] (fun identity -> [(slot, identity)]) (gnu_memory_pointer_identity fact)) returned)
+      else gnu_alloc_size_pointer_fact tagDefs expr >>= function
+        | Just fact -> E.return [(slot, fact)]
+        | Nothing -> gnu_opaque_pointer_call_result expr >>= fun external_opaque ->
+            gnu_visible_pointer_return_info translate_expr tagDefs expr >>= fun (incoming, members) ->
+            E.gnu_alloc_size_subject_allowed sym >>= fun private_destination ->
+            (if external_opaque && not indirect && path = [] then
+              gnu_external_result_slot_facts tagDefs sym (ctype_of expr) expr
+             else E.return []) >>= fun external_contents ->
+            let contents = external_contents ++ (if not indirect && path = [] && private_destination then
+              List.map (fun (member, fact) -> ((true, sym, member), fact)) members
+              else []) in
+            E.return ((if external_opaque || incoming then
+              [(slot, E.GNU_inline_unknown_extent_fact)] else []) ++ contents)
+      end
+    else if AilTypesAux.is_integer (ctype_of expr) then
+      gnu_scalar_fact tagDefs (ctype_of expr) expr >>= function
+        | Just fact -> E.return [(slot, fact)] | Nothing -> E.return [] end
+    else E.return []
+  else match node with
+    | A.AilEstruct _ members ->
+        E.mapM (fun (ident, value) -> maybe (E.return []) (member ident) value) members >>=
+          fun facts -> E.return (List.concat facts)
+    | A.AilEunion _ ident value -> maybe (E.return []) (member ident) value
+    | A.AilErvalue operand ->
+        if AilTypesAux.is_struct_or_union (ctype_of operand) then
+          gnu_memory_slot_of true operand >>= function
+            | Just source -> E.gnu_memory_copy_facts source slot
+            | Nothing -> E.return []
+          end
+        else capture_gnu_inline_fact translate_expr tagDefs (ctype_of expr) expr >>= function
+          | Just fact -> E.return [(slot, fact)]
+          | Nothing -> E.return []
+        end
+    | _ ->
+        if not (AilTypesAux.is_pointer (ctype_of expr)) && not (AilTypesAux.is_integer (ctype_of expr)) then E.return [] else
+          capture_gnu_inline_fact translate_expr tagDefs (ctype_of expr) expr >>= function
+            | Just fact -> E.return [(slot, fact)]
+            | Nothing -> E.return []
+          end
+  end
+  end
+
+val gnu_register_memory_facts: list (E.gnu_memory_slot * E.gnu_inline_fact) -> E.elabM unit
+let gnu_register_memory_facts facts =
+  E.mapM_ (fun (slot, fact) ->
+    E.register_gnu_memory_fact slot fact >>
+    if gnu_inline_fact_alloc_size_dependencies fact = [] then E.return () else
+    E.gnu_memory_fact slot >>= fun registered ->
+    let (indirect, sym, path) = slot in
+    let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+      "GNU alloc_size memory registration indirect=" ^ show indirect ^
+      "; symbol=" ^ show sym ^ "; path_length=" ^ show (List.length path) ^
+      "; captured=" ^ gnu_inline_fact_kind (Just fact) ^
+      "; observed=" ^ gnu_inline_fact_kind registered) in
+    E.return ()) facts
+
+(* Union alternatives of the same qualified type occupy the same storage.
+   Propagate a new stored snapshot through those alternate names, after normal
+   overlap invalidation has removed the old snapshots. Different types and
+   merely coincident offsets are deliberately insufficient. A struct path is
+   followed normally, so nested identical struct alternatives work as well. *)
+val gnu_memory_identical_union_paths:
+  C.core_tag_definitions -> Ctype.ctype -> list Symbol.identifier -> list (list Symbol.identifier)
+let rec gnu_memory_identical_union_paths tagDefs ty path = match path with
+  | [] -> [[]]
+  | ident :: rest ->
+      (match ty with
+        | Ctype.Ctype _ (Ctype.Struct tag) -> (match Map.lookup tag tagDefs with
+            | Just (_, Ctype.StructDef _ members _) -> (match List.lookup ident members with
+                | Just (_, _, _, member_ty) -> List.map (fun suffix -> ident :: suffix)
+                    (gnu_memory_identical_union_paths tagDefs member_ty rest)
+                | _ -> [path] end)
+            | _ -> [path] end)
+        | Ctype.Ctype _ (Ctype.Union tag) -> (match Map.lookup tag tagDefs with
+            | Just (_, Ctype.UnionDef _ members) -> (match List.lookup ident members with
+                | Just (_, _, selected_qs, selected_ty) ->
+                    List.concat (List.map (fun (alternative, (_, _, qs, member_ty)) ->
+                      if qs = selected_qs && gnu_function_target_type_equal selected_ty member_ty then
+                        List.map (fun suffix -> alternative :: suffix)
+                          (gnu_memory_identical_union_paths tagDefs member_ty rest)
+                      else []) members)
+                | _ -> [path] end)
+            | _ -> [path] end)
+        | _ -> [path]
+      end)
+end
+
+val gnu_memory_expand_identical_unions:
+  C.core_tag_definitions -> Ctype.ctype ->
+  list (E.gnu_memory_slot * E.gnu_inline_fact) -> list (E.gnu_memory_slot * E.gnu_inline_fact)
+let gnu_memory_expand_identical_unions tagDefs root_ty facts =
+  List.concat (List.map (fun ((indirect, sym, path), fact) ->
+    List.map (fun alias -> ((indirect, sym, alias), fact))
+      (gnu_memory_identical_union_paths tagDefs root_ty path)) facts)
+
+(* Transport only an already positive unknown-extent certificate through a
+   pointer-only assignment chain. All named destinations must be disjoint fields
+   of one stable object. This captures no value, bound, contents or deferred
+   load, and leaves every original evaluation/conversion/store in place. *)
+val gnu_pointer_assignment_terminal:
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_pointer_assignment_terminal (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (AilTypesAux.is_pointer (ctype_of expr)) ||
+      AilTypesAux.is_pointer_to_function (ctype_of expr) then Nothing else
+  match node with
+    | A.AilEassign left right ->
+        if not (AilTypesAux.is_pointer (ctype_of left)) ||
+            AilTypesAux.is_pointer_to_function (ctype_of left) then Nothing
+        else gnu_pointer_assignment_terminal right
+    | _ -> if gnu_memory_expression_readonly expr then Just expr else Nothing
+  end
+
+val gnu_capture_chained_pointer_stores:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_capture_chained_pointer_stores tagDefs expr =
+  match (gnu_member_assignment_destinations expr, gnu_pointer_assignment_terminal expr) with
+    | (Just (first :: second :: rest), Just terminal) ->
+        gnu_memory_unknown_pointer_value terminal >>= fun unknown ->
+        if not unknown then E.return [] else
+        E.mapM (fun left -> gnu_memory_slot_of true left >>= function
+          | Just ((true, sym, path) as slot) ->
+              E.gnu_branch_subject_allowed sym >>= fun stable ->
+              if not stable || path = [] then E.return Nothing else
+              gnu_memory_root_type sym left >>= function
+                | Just (Ctype.Ctype _ (Ctype.Pointer _ pointed_ty)) ->
+                    E.return (Just (slot, pointed_ty))
+                | _ -> E.return Nothing end
+          | _ -> E.return Nothing end) (first :: second :: rest) >>= fun destinations ->
+        (match destinations with
+          | Just ((_, root, _), root_ty) :: _ ->
+              let slots = List.foldr (fun item acc ->
+                maybe acc (fun (slot, _) -> slot :: acc) item) [] destinations in
+              if List.length slots <> List.length destinations ||
+                  not (List.all (fun (_, sym, _) -> sym = root) slots) ||
+                  not (List.all (fun slot ->
+                    List.length (List.filter (fun other -> other = slot) slots) = 1 &&
+                    List.all (fun other -> slot = other ||
+                      gnu_memory_paths_disjoint tagDefs root_ty
+                        (let (_, _, path) = slot in path)
+                        (let (_, _, path) = other in path)) slots) slots)
+              then E.return [] else
+                E.return (List.map (fun slot -> (slot, E.GNU_inline_unknown_extent_fact)) slots)
+          | _ -> E.return [] end)
+    | _ -> E.return []
+  end
+
+val gnu_capture_memory_store:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_capture_memory_store translate_expr tagDefs left right =
+  gnu_memory_slot_of true left >>= function
+    | Nothing -> E.return []
+    | Just ((indirect, sym, _) as slot) ->
+        gnu_capture_memory_initializer translate_expr tagDefs slot right >>= fun facts ->
+        gnu_memory_root_type sym left >>= fun ty ->
+        let root_ty = maybe Nothing (fun ty -> if not indirect then Just ty else match ty with
+          | Ctype.Ctype _ (Ctype.Pointer _ pointed_ty) -> Just pointed_ty
+          | _ -> Nothing end) ty in
+        E.return (maybe facts (fun ty -> gnu_memory_expand_identical_unions tagDefs ty facts) root_ty)
+  end
+
+(* Local extent expressions may name current private integer objects. Unlike
+   caller metadata, they need not be closed, but every read must be represented
+   by a revocable dependency. Core selectors and open Core extents still cannot
+   enter this path. The caller separately checks scope, type and non-escape. *)
+val gnu_local_extent_dependencies_complete: E.gnu_inline_fact -> bool
+let rec gnu_local_extent_dependencies_complete fact = match fact with
+  | E.GNU_inline_alloc_size_fact _ _ -> true
+  | E.GNU_inline_dynamic_bound_fact base -> gnu_local_extent_dependencies_complete base
+  | E.GNU_inline_counted_extent_fact upper exact ->
+      gnu_local_extent_dependencies_complete upper && gnu_local_extent_dependencies_complete exact
+  | E.GNU_inline_offset_extent_fact base index element_ty _ dependencies ->
+      gnu_inline_fixed_object_type element_ty && gnu_memory_expression_readonly index &&
+      gnu_local_extent_dependencies_complete base &&
+        (match gnu_alloc_size_dependencies index with
+          | Just reads -> List.all (fun (sym, ty) ->
+              AilTypesAux.is_integer ty && List.elem sym dependencies) reads &&
+              List.all (fun sym -> List.any (fun (read, _) -> read = sym) reads) dependencies
+          | Nothing -> false end)
+  | E.GNU_inline_extent_join_fact choices ->
+      choices <> [] && List.all gnu_local_extent_dependencies_complete choices
+  | E.GNU_inline_selected_extent_fact _ _ _ -> false
+  | _ -> gnu_member_fact_closed fact
+end
+
+(* A pointer update is a store to its private automatic pointer object as
+   well as, for *p++ = value, a separate store through its old value. Capture
+   a closed extent or fully checked local dependencies before either store;
+   publish it afterward, retaining normal dependency invalidation.
+   The ordinary expression remains the sole executable update. *)
+val gnu_capture_private_pointer_update:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_capture_private_pointer_update translate_expr tagDefs
+    (A.AnnotatedExpression _ _ loc node) =
+  let postfix (A.AnnotatedExpression _ _ _ node) = match node with
+    | A.AilEunary A.PostfixIncr left -> Just (left, A.Add, oneAil_tau)
+    | A.AilEunary A.PostfixDecr left -> Just (left, A.Sub, oneAil_tau)
+    | _ -> Nothing end in
+  let selected = match node with
+    | A.AilEunary A.PostfixIncr left -> Just ((left, A.Add, oneAil_tau), [])
+    | A.AilEunary A.PostfixDecr left -> Just ((left, A.Sub, oneAil_tau), [])
+    | A.AilEcompoundAssign left A.Add right -> Just ((left, A.Add, right), [right])
+    | A.AilEcompoundAssign left A.Sub right -> Just ((left, A.Sub, right), [right])
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEunary A.Indirection pointer) as target) right ->
+        let (qs, ty) = qualified_ctype_of target in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty then Nothing else
+          maybe Nothing (fun update -> Just (update, [right])) (postfix pointer)
+    | _ -> Nothing end in
+  match selected with
+    | Just (((A.AnnotatedExpression _ _ _ (A.AilEident sym) as left), aop, offset), siblings) ->
+        (* The prepass may save a mutable offset inside this original RHS.
+           Check its original computation, then use the captured value only
+           after the executable compound assignment has performed that store. *)
+        let saved_offset = snd (gnu_alloc_argument_snapshot offset) in
+        let siblings = if not saved_offset then siblings else match offset with
+          | A.AnnotatedExpression _ _ _ (A.AilEassign _ original) -> [original]
+          | _ -> siblings end in
+        let (qs, ty) = qualified_ctype_of left in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not (AilTypesAux.is_pointer ty) || AilTypesAux.is_pointer_to_function ty ||
+            not (List.all gnu_memory_expression_readonly siblings) ||
+            not (List.all (gnu_inline_parameter_expression_safe sym) siblings)
+        then E.return [] else
+        E.gnu_alloc_size_subject_allowed sym >>= fun unescaped ->
+        E.gnu_memory_fact (false, sym, []) >>= fun previous ->
+        (* An opaque output can write a pointer whose address escaped the
+           whole-body privacy check. A currently established unknown extent
+           survives a readonly arithmetic step; no known bound is retained. *)
+        let opaque_only = not saved_offset &&
+          previous = Just E.GNU_inline_unknown_extent_fact in
+        E.get_visible_objects >>= fun visible ->
+        if (not unescaped && not opaque_only) || not (List.elem sym visible)
+        then E.return [] else
+        let category = GenTypes.GenRValueType (GenTypes.inject_type ty) in
+        let loaded = A.AnnotatedExpression category [] loc (A.AilErvalue left) in
+        let advanced = A.AnnotatedExpression category [] loc
+          (A.AilEbinary loaded (A.Arithmetic aop) offset) in
+        (if saved_offset then
+          (* This admission also rejects overwriting a dependency of the old
+             base extent; an arbitrary assignment cannot make stale bounds live. *)
+          gnu_capture_saved_array_index translate_expr tagDefs advanced
+        else if opaque_only && not unescaped then
+          E.return (Just E.GNU_inline_unknown_extent_fact)
+        else capture_gnu_inline_fact translate_expr tagDefs ty advanced) >>= fun captured ->
+        let identity = maybe Nothing gnu_memory_pointer_identity captured in
+        (match identity with
+          | Nothing -> E.return []
+          | Just fact ->
+              if not (gnu_local_extent_dependencies_complete fact) then E.return [] else
+              let dependencies = gnu_inline_fact_alloc_size_dependencies fact in
+              E.mapM (fun dependency ->
+                E.gnu_alloc_size_subject_allowed dependency >>= fun private_dependency ->
+                E.lookup_gnu_analysis_object_type dependency >>= fun dependency_type ->
+                E.return (dependency <> sym && private_dependency && List.elem dependency visible &&
+                  List.all (gnu_inline_parameter_expression_safe dependency) siblings &&
+                  (match dependency_type with
+                    | Just (dep_qs, dep_ty) -> not dep_qs.Ctype.volatile &&
+                        not (AilTypesAux.is_atomic dep_ty) && AilTypesAux.is_integer dep_ty
+                    | Nothing -> false end))) dependencies >>= fun valid ->
+              E.return (if List.all (fun ok -> ok) valid then [((false, sym, []), fact)] else [])
+        end)
+    | _ -> E.return []
+  end
+
+(* An executed private scalar copy also copies the value on which an existing
+   local pointer extent depends. Rebind only complete, revocable metadata; the
+   destination remains an ordinary mutable dependency, never a Core constant. *)
+val gnu_replace_scalar_dependencies:
+  list (Symbol.sym * Symbol.sym) -> A.expression GenTypes.genTypeCategory ->
+  A.expression GenTypes.genTypeCategory
+let rec gnu_replace_scalar_dependencies replacements
+    (A.AnnotatedExpression category annots loc node) =
+  let self = gnu_replace_scalar_dependencies replacements in
+  A.AnnotatedExpression category annots loc (match node with
+    | A.AilEident sym -> A.AilEident (maybe sym (fun saved -> saved) (List.lookup sym replacements))
+    | A.AilErvalue operand -> A.AilErvalue (self operand)
+    | A.AilEannot ty operand -> A.AilEannot ty (self operand)
+    | A.AilEcast qs ty operand -> A.AilEcast qs ty (self operand)
+    | A.AilEunary uop operand -> A.AilEunary uop (self operand)
+    | A.AilEbinary left bop right -> A.AilEbinary (self left) bop (self right)
+    | _ -> node
+  end)
+
+val gnu_replace_scalar_dependency:
+  Symbol.sym -> Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  A.expression GenTypes.genTypeCategory
+let gnu_replace_scalar_dependency source saved =
+  gnu_replace_scalar_dependencies [(source, saved)]
+
+val gnu_rebind_extent_dependency:
+  Symbol.sym -> Symbol.sym -> E.gnu_inline_fact -> E.gnu_inline_fact
+let rec gnu_rebind_extent_dependency source saved fact =
+  let self = gnu_rebind_extent_dependency source saved in
+  match fact with
+    | E.GNU_inline_alloc_size_fact sym value ->
+        E.GNU_inline_alloc_size_fact (if sym = source then saved else sym)
+          (gnu_replace_scalar_dependency source saved value)
+    | E.GNU_inline_dynamic_bound_fact base -> E.GNU_inline_dynamic_bound_fact (self base)
+    | E.GNU_inline_counted_extent_fact upper exact -> E.GNU_inline_counted_extent_fact (self upper) (self exact)
+    | E.GNU_inline_offset_extent_fact base index ty subtract dependencies ->
+        E.GNU_inline_offset_extent_fact (self base)
+          (gnu_replace_scalar_dependency source saved index) ty subtract
+          (List.map (fun sym -> if sym = source then saved else sym) dependencies)
+    | E.GNU_inline_extent_join_fact choices ->
+        E.GNU_inline_extent_join_fact (List.map self choices)
+    | _ -> fact
+  end
+
+val gnu_capture_scalar_copy_dependencies:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_capture_scalar_copy_dependencies tagDefs (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident saved) as left)
+        (A.AnnotatedExpression _ _ _
+          (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident source) as right))) ->
+      let (left_qs, ty) = qualified_ctype_of left in
+      let (right_qs, right_ty) = qualified_ctype_of right in
+      if saved = source || ty <> right_ty || not (AilTypesAux.is_integer ty) ||
+          left_qs.Ctype.volatile || right_qs.Ctype.volatile || AilTypesAux.is_atomic ty
+      then E.return [] else
+      E.gnu_alloc_size_subject_allowed source >>= fun private_source ->
+      E.gnu_alloc_size_subject_allowed saved >>= fun private_saved ->
+      E.get_visible_objects >>= fun visible ->
+      if not (private_source && private_saved && List.elem source visible &&
+          List.elem saved visible) then E.return [] else
+      gnu_memory_store_survivors_at tagDefs (false, saved, []) (Just ty) >>= fun (facts, _, _) ->
+      E.mapM (fun (slot, fact) -> match slot with
+        | (false, pointer, []) ->
+          E.gnu_alloc_size_subject_allowed pointer >>= fun private_pointer ->
+          let dependencies = gnu_inline_fact_alloc_size_dependencies fact in
+          let identity = gnu_memory_pointer_identity fact in
+          E.return (if private_pointer && List.elem pointer visible &&
+              List.elem source dependencies && not (List.elem saved dependencies) &&
+              gnu_local_extent_dependencies_complete fact
+            then maybe Nothing (fun fact ->
+              Just (slot, gnu_rebind_extent_dependency source saved fact)) identity
+            else Nothing)
+        | _ -> E.return Nothing end) facts >>= fun rebound ->
+      E.return (List.foldr (fun item rest -> maybe rest (fun fact -> fact :: rest) item) [] rebound)
+    | _ -> E.return []
+  end
+
+val gnu_capture_memory_assignment:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let rec gnu_capture_memory_assignment translate_expr tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  gnu_capture_private_pointer_update translate_expr tagDefs expr >>= fun updated ->
+  gnu_capture_scalar_copy_dependencies tagDefs expr >>= fun rebound ->
+  (match node with
+    | A.AilEassign left right ->
+        gnu_capture_chained_pointer_stores tagDefs expr >>= fun chained ->
+        if chained <> [] then E.return chained else
+          gnu_capture_memory_store translate_expr tagDefs left right
+    (* A null equality test evaluates its pointer operand exactly once and
+       cannot supply a known allocation-address refinement. Recover its real
+       nested store for the existing post-test publication, rather than
+       treating a comparison wrapper as if no assignment occurred. *)
+    | A.AilEbinary left bop right ->
+        if not (bop = A.Eq || bop = A.Ne) then E.return [] else
+        if gnu_literal_null_pointer right && AilTypesAux.is_pointer (ctype_of left)
+        then gnu_capture_memory_assignment translate_expr tagDefs left else
+        if gnu_literal_null_pointer left && AilTypesAux.is_pointer (ctype_of right)
+        then gnu_capture_memory_assignment translate_expr tagDefs right else E.return []
+    | A.AilEannot _ operand -> gnu_capture_memory_assignment translate_expr tagDefs operand
+    | _ -> E.return []
+  end) >>= fun stored ->
+  E.return (stored ++ updated ++ rebound)
+
+(* A limited dependency certificate for recursive integer parameters. If every
+   compiler query names a fixed complete object or a closed integer expression,
+   scalar argument values cannot change its lowering. Calls to other bodies,
+   loaded pointer queries, local scalar aliases in queries, VLA and unknown
+   syntax reject the certificate. Ordinary arithmetic/control/recursion still
+   executes with the original argument values; no opaque value is invented. *)
+val gnu_recursion_fixed_query_address: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_recursion_fixed_query_address (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEarray_decay (A.AnnotatedExpression _ _ _ (A.AilEident _) as operand) ->
+      gnu_inline_fixed_object_type (ctype_of operand)
+  | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident _) as operand) ->
+      gnu_inline_fixed_object_type (ctype_of operand)
+  | A.AilEannot _ operand -> gnu_recursion_fixed_query_address operand
+  | _ -> false
+end
+
+val gnu_recursion_closed_queries_expression:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_recursion_closed_queries_expression targets (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_recursion_closed_queries_expression targets in
+  match node with
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_object_size _ _))) [operand] ->
+        gnu_recursion_fixed_query_address operand
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) [operand] ->
+        gnu_inline_closed_integer_origin operand
+    | A.AilEcall (A.AnnotatedExpression _ _ _
+        (A.AilEfunction_decay (A.AnnotatedExpression _ _ _ (A.AilEident target)))) args ->
+        List.elem target targets && List.all self args
+    | A.AilEcall (A.AnnotatedExpression _ _ _
+        (A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident target)))) args ->
+        List.elem target targets && List.all self args
+    | A.AilEcall _ _ -> false
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEassign left right -> self left && self right
+    | A.AilEcompoundAssign left _ right -> self left && self right
+    | A.AilEcond condition yes no -> self condition && maybe true self yes && self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEassert operand -> self operand
+    | A.AilEarray _ _ values -> List.all (maybe true self) values
+    | A.AilEstruct _ members -> List.all (fun (_, value) -> maybe true self value) members
+    | A.AilEunion _ _ value -> maybe true self value
+    | A.AilEcompound _ ty operand -> gnu_inline_fixed_object_type ty && self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEsizeof _ ty -> gnu_inline_fixed_object_type ty
+    | A.AilEsizeof_expr operand -> gnu_inline_fixed_object_type (ctype_of operand) && self operand
+    | A.AilEalignof _ ty -> gnu_inline_fixed_object_type ty
+    | A.AilEoffsetof ty _ -> gnu_inline_fixed_object_type ty
+    | A.AilEident _ -> true
+    | A.AilEstr _ -> true
+    | A.AilEconst _ -> true
+    | _ -> false
+  end
+
+val gnu_recursion_closed_queries:
+  list Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_recursion_closed_queries targets stmt =
+  let self = gnu_recursion_closed_queries targets in
+  let expr = gnu_recursion_closed_queries_expression targets in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock bindings statements ->
+        List.all (fun (_, (_, _, _, ty)) -> gnu_inline_fixed_object_type ty) bindings && List.all self statements
+    | A.AilSif condition yes no -> expr condition && self yes && self no
+    | A.AilSwhile condition body _ -> expr condition && self body
+    | A.AilSdo body condition _ -> self body && expr condition
+    | A.AilSreturn operand -> expr operand
+    | A.AilSreturnVoid -> true
+    | A.AilSdeclaration declarations -> List.all (fun (_, value) -> maybe true expr value) declarations
+    | A.AilSswitch operand body -> expr operand && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+val gnu_alloc_size_direct_symbol: A.expression GenTypes.genTypeCategory -> maybe Symbol.sym
+let gnu_alloc_size_direct_symbol (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEident sym -> Just sym
+  | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> Just sym
+  | _ -> Nothing
+end
+
+val gnu_alloc_size_rebind_subject:
+  Symbol.sym -> Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_alloc_size_rebind_subject old_sym new_sym
+    (A.AnnotatedExpression category annots loc node as expr) =
+  let self = gnu_alloc_size_rebind_subject old_sym new_sym in
+  let rebuild node = A.AnnotatedExpression category annots loc node in
+  if gnu_inline_closed_integer_origin expr then Just expr else match node with
+    | A.AilEident sym -> if sym = old_sym then Just (rebuild (A.AilEident new_sym)) else Nothing
+    | A.AilErvalue operand -> maybe Nothing (fun value -> Just (rebuild (A.AilErvalue value))) (self operand)
+    | A.AilEannot ty operand -> maybe Nothing (fun value -> Just (rebuild (A.AilEannot ty value))) (self operand)
+    | A.AilEcast qs ty operand -> maybe Nothing (fun value -> Just (rebuild (A.AilEcast qs ty value))) (self operand)
+    | A.AilEunary op operand -> maybe Nothing (fun value -> Just (rebuild (A.AilEunary op value))) (self operand)
+    | A.AilEbinary left bop right ->
+        (match (self left, self right) with
+          | (Just first, Just second) -> Just (rebuild (A.AilEbinary first bop second))
+          | _ -> Nothing end)
+    | _ -> Nothing
+  end
+
+(* A private capture reads only the already-live scalar dependency. Allocation
+   calls and size-expression arithmetic remain at their original evaluation
+   sites; the typed expression is rebound to this unchanged synthetic formal. *)
+val gnu_alloc_size_dependency_read:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_alloc_size_dependency_read dependency (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_alloc_size_dependency_read dependency in
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        if sym = dependency then Just expr else Nothing
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right ->
+        (match self left with Just found -> Just found | Nothing -> self right end)
+    | _ -> Nothing
+  end
+
+val gnu_transfer_inline_fact:
+  (E.gnu_inline_fact -> E.elabM (maybe E.gnu_inline_fact *
+    list ((Symbol.sym * Ctype.ctype) * A.expression GenTypes.genTypeCategory))) ->
+  E.gnu_inline_fact -> E.elabM (maybe E.gnu_inline_fact *
+    list ((Symbol.sym * Ctype.ctype) * A.expression GenTypes.genTypeCategory))
+let rec gnu_transfer_inline_fact leaf fact = match fact with
+  | E.GNU_inline_counted_extent_fact upper exact ->
+      gnu_transfer_inline_fact leaf upper >>= fun (upper, first) ->
+      gnu_transfer_inline_fact leaf exact >>= fun (exact, second) ->
+      E.return (match (upper, exact) with
+        | (Just upper, Just exact) -> (Just (E.GNU_inline_counted_extent_fact upper exact), first ++ second)
+        | _ -> (Nothing, []) end)
+  | E.GNU_inline_dynamic_bound_fact saved ->
+      gnu_transfer_inline_fact leaf saved >>= fun (value, captures) ->
+      E.return (maybe Nothing (fun value -> Just (E.GNU_inline_dynamic_bound_fact value)) value, captures)
+  | E.GNU_inline_offset_extent_fact base index ty subtract dependencies ->
+      let complete = match gnu_alloc_size_dependencies index with
+        | Just reads -> List.all (fun (sym, _) -> List.elem sym dependencies) reads &&
+            List.all (fun sym -> List.any (fun (read, _) -> read = sym) reads) dependencies
+        | Nothing -> false end in
+      if not (complete && gnu_memory_expression_readonly index) then E.return (Nothing, []) else
+      gnu_transfer_inline_fact leaf base >>= fun (base, base_captures) ->
+      (match base with
+        | Nothing -> E.return (Nothing, [])
+        | Just base ->
+          (* Snapshot each live scalar through the existing call-boundary gate.
+             Only bare scalar reads cross as hidden arguments; keep the original
+             typed offset arithmetic and perform simultaneous symbol rebinding. *)
+          let unique = List.foldl (fun seen dependency ->
+            if List.elem dependency seen then seen else seen ++ [dependency]) [] dependencies in
+          E.mapM (fun dependency ->
+            match gnu_alloc_size_dependency_read dependency index with
+              | Nothing -> E.return Nothing
+              | Just actual -> leaf (E.GNU_inline_alloc_size_fact dependency actual) >>= fun (value, captures) ->
+                E.return (match value with
+                  | Just (E.GNU_inline_alloc_size_fact formal rebound) ->
+                      if gnu_alloc_size_direct_symbol rebound = Just formal
+                      then Just ((dependency, formal), captures) else Nothing
+                  | _ -> Nothing end)
+            end) unique >>= fun transferred ->
+          if List.any isNothing transferred then E.return (Nothing, []) else
+          let entries = List.foldr (fun item rest -> maybe rest (fun entry -> entry :: rest) item) [] transferred in
+          let replacements = List.map fst entries in
+          E.return (Just (E.GNU_inline_offset_extent_fact base
+            (gnu_replace_scalar_dependencies replacements index) ty subtract (List.map snd replacements)),
+            base_captures ++ List.concat (List.map snd entries))
+      end)
+  | _ -> leaf fact
+end
+
+val translate_gnu_inline_call:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  Core.core_tag_definitions -> bool -> maybe integer -> A.expression GenTypes.genTypeCategory ->
+  list (A.expression GenTypes.genTypeCategory) ->
+  E.elabM (maybe (Symbol.sym * list (A.expression GenTypes.genTypeCategory)))
+let translate_gnu_inline_call translate_expr tagDefs allow_capture forwarded_count callee args =
+  if allow_capture && not (gnu_inline_direct_designator callee)
+  then E.return Nothing else
+  (* Account for all sibling effects before early metadata discovery. Private
+     pointer identities survive; a positively classified opaque call may also
+     establish a compiler-unknown reload of an existing ordinary formal slot.
+     Unsupported effects and missing origins still discard their facts. *)
+  E.mapM gnu_memory_certified_readonly (callee :: args) >>= fun readonly_operands ->
+  (if allow_capture && not (List.all (fun readonly -> readonly) readonly_operands) &&
+      not (List.all (fun operand -> isJust (gnu_memory_direct_writes operand)) (callee :: args)) then
+    gnu_memory_operand_survivors (callee :: args) >>= fun (facts, roots) ->
+    E.clear_gnu_memory_facts >>
+    E.with_preserved_gnu_memory facts roots [] (E.return ())
+  else E.return ()) >>
+  (* Ordinary callee lowering already retains/evaluates the complete comma
+     expression. The surrounding expression walk invalidates facts affected
+     by its writes, so target discovery may inspect only its resulting value. *)
+  gnu_inline_function_target (gnu_inline_argument_origin callee) >>= fun target ->
+  match target with
+    | Nothing -> E.return Nothing
+    | Just (declared, _) -> E.gnu_inline_target declared >>= fun source ->
+      E.gnu_inline_template source >>= function
+      | Nothing -> E.return Nothing
+      | Just (params, stmt) ->
+          let scalar_independent = gnu_recursion_closed_queries [source; declared] stmt in
+          let parameter_types = match ctype_of callee with
+            | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ types variadic))) ->
+                if (if variadic then List.length types <= List.length args
+                    else List.length types = List.length args) then Just types else Nothing
+            | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.FunctionNoParams _))) ->
+                if params = [] && args = [] then Just [] else Nothing
+            | _ -> Nothing
+          end in
+          (match parameter_types with
+            | Just param_types ->
+                if List.length params <> List.length param_types
+                then E.return Nothing else
+                (* Compute before adding private captures, which are named
+                   parameters. An unknown forwarded pack never means no args. *)
+                let pack_count = match (ctype_of callee, forwarded_count) with
+                  | (Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ _ true))),
+                     Just count) -> if count < 0 then Nothing else
+                      Just (count + integerFromNat (List.length args - List.length params))
+                  | _ -> Nothing
+                end in
+                let fixed_args = fst (List.splitAt (List.length params) args) in
+                (* A direct unsized opaque call is a positive return boundary,
+                   even though evaluating it has effects. Require exactly that
+                   one effectful operand; readonly siblings cannot overwrite the
+                   returned object's contents after it. The original argument
+                   and evaluation order are unchanged. This class supplies no
+                   numeric bound, allocation identity or caller memory snapshot. *)
+                (if List.length (List.filter (fun readonly -> not readonly) readonly_operands) <> 1
+                 then E.return [] else
+                  E.mapM (fun ((param, (qs, ty, _)), actual) ->
+                    if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                        not (AilTypesAux.is_pointer ty) || AilTypesAux.is_pointer_to_function ty ||
+                        not (gnu_function_target_type_equal ty (ctype_of actual)) ||
+                        not (gnu_inline_parameter_unchanged param stmt) ||
+                        not (gnu_alloc_size_subject_unescaped param stmt)
+                    then E.return Nothing else match actual with
+                      | A.AnnotatedExpression _ _ _ (A.AilEcall _ _) ->
+                          gnu_ordinary_unsized_pointer_result actual >>= fun boundary ->
+                          E.return (if boundary then Just param else Nothing)
+                      | _ -> E.return Nothing end
+                  ) (List.zip (List.zip params param_types) fixed_args) >>= fun optional ->
+                  E.return (List.foldr (fun item rest ->
+                    maybe rest (fun param -> param :: rest) item) [] optional)) >>= fun fresh_opaque ->
+                (* Identical side-effect-free actual object addresses establish
+                   equality of unchanged, identically typed formal pointers.
+                   Only the formal-to-formal relation crosses the boundary;
+                   no caller symbol, expression or runtime pointer is stored.
+                   Aliasing belongs in the instance key even when the closed
+                   extent snapshots themselves happen to be equal. *)
+                (if not (gnu_memory_expression_readonly callee && List.all gnu_memory_expression_readonly args)
+                 then E.return ([], [], []) else
+                  E.mapM (fun ((param, (qs, ty, _)), actual) ->
+                    if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty) ||
+                        not (gnu_inline_parameter_unchanged param stmt) then E.return Nothing else
+                    gnu_memory_slot_of false actual >>= fun slot ->
+                    E.return (maybe Nothing (fun slot -> Just (param, ty, slot)) slot)
+                  ) (List.zip (List.zip params param_types) fixed_args) >>= fun entries ->
+                  let (_, aliases) = List.foldl (fun (seen, aliases) entry -> match entry with
+                    | Nothing -> (seen, aliases)
+                    | Just (param, ty, slot) -> (match List.lookup slot seen with
+                        | Just (root, root_ty) ->
+                            if gnu_function_target_type_equal ty root_ty then
+                              (seen, aliases ++ [(param, root)]) else (seen, aliases)
+                        | Nothing -> ((slot, (param, ty)) :: seen, aliases)
+                      end)
+                  end) ([], []) entries in
+                  E.gnu_memory_disjoint_parameters >>= fun incoming_disjoint ->
+                  let disjoint = List.concat (List.map (fun first -> match first with
+                    | Just (param, _, source) -> List.foldr (fun second acc -> match second with
+                        | Just (other, _, other_source) ->
+                            if param <> other && gnu_memory_distinct_roots incoming_disjoint source other_source
+                            then (param, other) :: acc else acc
+                        | _ -> acc end) [] entries
+                    | _ -> [] end) entries) in
+                  E.mapM (function
+                    | Just (param, _, slot) ->
+                        if not (gnu_alloc_size_subject_unescaped param stmt) then E.return Nothing else
+                        E.gnu_memory_caller_frame_root slot >>= fun owned ->
+                        E.return (if owned then Just param else Nothing)
+                    | Nothing -> E.return Nothing end) entries >>= fun owned ->
+                  let caller_frame = List.foldr (fun entry rest ->
+                    maybe rest (fun param -> param :: rest) entry) [] owned in
+                  E.return (aliases, disjoint, caller_frame)) >>= fun aliases ->
+                (* Observe existing caller facts, without another extent
+                   analysis or any evaluation of the original expression. *)
+                E.mapM (fun ((param, (_, ty, _)), actual) ->
+                  if not (AilTypesAux.is_pointer ty) then E.return Nothing else
+                  let origin = gnu_inline_argument_origin actual in
+                  (match gnu_inline_direct_pointer_symbol origin with
+                    | Just subject -> E.gnu_compiler_fact subject
+                    | Nothing -> E.return Nothing end) >>= fun raw ->
+                  E.return (Just (param, "parameter=" ^ show param ^
+                    "; actual=" ^ Pp.stringFromAil_expression actual ^
+                    "; location=" ^ Loc.stringFromLocation (Loc.with_cursor (Loc.locOf actual)) ^
+                    "; caller-fact=" ^ gnu_inline_fact_kind raw))
+                ) (List.zip (List.zip params param_types) fixed_args) >>= fun pointer_call_sites ->
+                E.mapM (fun ((param, (qs, ty, _)), actual) ->
+                  let unchanged = gnu_inline_parameter_unchanged param stmt in
+                  let capture = if (scalar_independent && AilTypesAux.is_integer ty) ||
+                      qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                      not unchanged then E.return Nothing
+                    else capture_gnu_inline_fact translate_expr tagDefs ty actual >>= fun captured ->
+                      E.return (if isNothing captured && List.elem param fresh_opaque
+                        then Just E.GNU_inline_unknown_extent_fact else captured) in
+                  match Symbol.symbol_description param with
+                    | Symbol.SD_ObjectAddress "__dest" ->
+                        let origin = gnu_inline_argument_origin actual in
+                        gnu_inline_closed_size_origin true [] false origin >>= fun closed ->
+                        let effects = match gnu_size_effects origin with
+                          | Just true -> "effectful" | Just false -> "pure" | Nothing -> "unknown" end in
+                        let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                          "GNU inline destination eligibility " ^ show source ^ "; param=" ^ show param ^
+                          "; actual=" ^ Pp.stringFromAil_expression actual ^ "; pointer=" ^
+                          show (AilTypesAux.is_pointer ty) ^ "; unchanged=" ^ show unchanged ^
+                          "; effects=" ^ effects ^ "; closed=" ^ show closed) in
+                        capture >>= fun fact ->
+                        let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                          "GNU inline destination capture result " ^ show source ^ "; param=" ^ show param ^
+                          "=" ^ gnu_inline_fact_kind fact) in
+                        E.return (maybe Nothing (fun value -> Just (param, value)) fact)
+                    | _ -> capture >>= fun fact ->
+                        E.return (maybe Nothing (fun value -> Just (param, value)) fact)
+                  end
+                ) (List.zip (List.zip params param_types) fixed_args) >>= fun optional_facts ->
+                let initial_captured_facts = List.foldr (fun item rest ->
+                  maybe rest (fun fact -> fact :: rest) item) [] optional_facts in
+                let rebind_alloc_size_fact fact = match fact with
+                  | E.GNU_inline_alloc_size_fact dependency size_expr ->
+                      List.foldl (fun result ((formal, (formal_qs, formal_ty, _)), actual) ->
+                        match result with
+                          | Just _ -> result
+                          | Nothing ->
+                              let actual_symbol = gnu_alloc_size_direct_symbol actual in
+                              let integer_formal = AilTypesAux.is_integer formal_ty in
+                              let qualifiers_safe = not formal_qs.Ctype.volatile &&
+                                not (AilTypesAux.is_atomic formal_ty) in
+                              let allocation_type = match gnu_alloc_size_dependencies size_expr with
+                                | Just ((_, ty) :: _) -> ty
+                                | _ -> ctype_of size_expr end in
+                              let same_type = gnu_function_target_type_equal formal_ty allocation_type in
+                              let alloc_size_type_compatible =
+                                gnu_alloc_size_rebind_type_equal formal_ty allocation_type in
+                              let same_integer_representation = match (formal_ty, allocation_type) with
+                                | (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer formal_ity)),
+                                   Ctype.Ctype _ (Ctype.Basic (Ctype.Integer allocation_ity))) ->
+                                    Implementation.normalise_integerType formal_ity =
+                                      Implementation.normalise_integerType allocation_ity
+                                | _ -> false end in
+                              let kept_annotations_match = match (formal_ty, allocation_type) with
+                                | (Ctype.Ctype formal_annotations _, Ctype.Ctype allocation_annotations _) ->
+                                    gnu_function_target_annotations formal_annotations =
+                                      gnu_function_target_annotations allocation_annotations
+                                end in
+                              let without_empty_attributes (Ctype.Ctype annotations node) =
+                                Ctype.Ctype (List.filter (function
+                                  | Annot.Aattrs (Annot.Attrs []) -> false
+                                  | _ -> true
+                                end) annotations) node in
+                              let same_type_without_empty_attributes =
+                                gnu_function_target_type_equal (without_empty_attributes formal_ty)
+                                  (without_empty_attributes allocation_type) in
+                              let retained_annotation_summary ty =
+                                let Ctype.Ctype annotations _ = ty in
+                                List.map (function
+                                  | Annot.Aattrs (Annot.Attrs attributes) ->
+                                      "Aattrs[" ^ String.concat ";" (List.map (fun attribute ->
+                                        show attribute.Annot.attr_id ^ "(" ^
+                                          String.concat "," (List.map (fun (_, text, fragments) ->
+                                            text ^ String.concat "" (List.map snd fragments)
+                                          ) attribute.Annot.attr_args) ^ ")"
+                                      ) attributes) ^ "]"
+                                  | Annot.Astd text -> "Astd(" ^ text ^ ")"
+                                  | Annot.Auid _ -> "Auid"
+                                  | Annot.Amarker _ -> "Amarker"
+                                  | Annot.Amarker_object_types _ -> "Amarker_object_types"
+                                  | Annot.Abmc _ -> "Abmc"
+                                  | Annot.Abitfield _ _ -> "Abitfield"
+                                  | Annot.Atypedef _ -> "Atypedef"
+                                  | Annot.Aparameter_origin _ -> "Aparameter_origin"
+                                  | Annot.Alabel _ -> "Alabel"
+                                  | Annot.Acerb _ -> "Acerb"
+                                  | Annot.Avalue _ -> "Avalue"
+                                  | Annot.Ainlined_label _ -> "Ainlined_label"
+                                  | Annot.Astmt -> "Astmt"
+                                  | Annot.Aexpr -> "Aexpr"
+                                  | Annot.Aloc _ -> "Aloc"
+                                end) (gnu_function_target_annotations annotations) in
+                              let actual_pure = gnu_size_effects actual = Just false in
+                              let formal_unchanged = gnu_inline_parameter_unchanged formal stmt in
+                              let eligible = actual_symbol = Just dependency && integer_formal &&
+                                qualifiers_safe && alloc_size_type_compatible &&
+                                actual_pure && formal_unchanged in
+                              let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                                "GNU alloc_size rebind candidate dependency=" ^ show dependency ^
+                                "; formal=" ^ show formal ^ "; actual=" ^ Pp.stringFromAil_expression actual ^
+                                "; actual-symbol=" ^ show actual_symbol ^
+                                "; formal-type=" ^ Pp.stringFromAil_ctype Ctype.no_qualifiers formal_ty ^
+                                "; allocation-size-type=" ^
+                                  Pp.stringFromAil_ctype Ctype.no_qualifiers (ctype_of size_expr) ^
+                                "; integer=" ^ show integer_formal ^
+                                "; qualifiers-safe=" ^ show qualifiers_safe ^
+                                "; same-type=" ^ show same_type ^
+                                "; same-integer-representation=" ^ show same_integer_representation ^
+                                "; alloc-size-type-compatible-after-origin-filter=" ^
+                                  show alloc_size_type_compatible ^
+                                "; kept-annotations-match=" ^ show kept_annotations_match ^
+                                "; same-type-without-empty-attributes=" ^
+                                  show same_type_without_empty_attributes ^
+                                "; formal-kept-annotations=" ^
+                                  String.concat "," (retained_annotation_summary formal_ty) ^
+                                "; allocation-kept-annotations=" ^
+                                  String.concat "," (retained_annotation_summary allocation_type) ^
+                                "; actual-pure=" ^ show actual_pure ^
+                                "; formal-unchanged=" ^ show formal_unchanged ^
+                                "; eligible=" ^ show eligible) in
+                              if not eligible then Nothing else
+                              match gnu_alloc_size_rebind_subject dependency formal size_expr with
+                                | Just rebound ->
+                                    let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                                      "GNU alloc_size rebind matched formal=" ^ show formal) in
+                                    Just (E.GNU_inline_alloc_size_fact formal rebound)
+                                | Nothing -> Nothing
+                              end
+                        end) Nothing (List.zip (List.zip params param_types) fixed_args)
+                  | _ -> Just fact
+                end in
+                E.gnu_inline_is_active source >>= fun active_capture ->
+                let transfer_leaf fact = (match rebind_alloc_size_fact fact with
+                      | Just rebound -> E.return (Just rebound, [])
+                      | Nothing -> (match fact with
+                          | E.GNU_inline_alloc_size_fact dependency size_expr ->
+                              if not allow_capture || active_capture then
+                                E.return (Nothing, []) else
+                              E.gnu_alloc_size_subject_allowed dependency >>= fun eligible ->
+                              if not eligible || not (List.all
+                                  (gnu_inline_parameter_expression_safe dependency) (callee :: args)) then
+                                E.return (Nothing, []) else
+                              (match gnu_alloc_size_dependency_read dependency size_expr with
+                                | Nothing -> E.return (Nothing, [])
+                                | Just actual ->
+                                    E.fresh_elab_sym (Symbol.SD_ObjectAddress "__cerb_alloc_size_capture") >>= fun formal ->
+                                    (match gnu_alloc_size_rebind_subject dependency formal size_expr with
+                                      | Nothing -> E.return (Nothing, [])
+                                      | Just rebound ->
+                                          let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                                            "GNU alloc_size private parameter dependency=" ^ show dependency ^
+                                              "; formal=" ^ show formal ^
+                                              "; actual=" ^ Pp.stringFromAil_expression actual) in
+                                          E.return (Just (E.GNU_inline_alloc_size_fact formal rebound),
+                                            [((formal, ctype_of actual), actual)])
+                                    end)
+                              end)
+                          | _ -> E.return (Nothing, [])
+                        end)
+                    end)
+                in
+                E.mapM (fun item -> match item with
+                  | Nothing -> E.return (Nothing, [])
+                  | Just (param, fact) -> gnu_transfer_inline_fact transfer_leaf fact >>= fun (fact, captures) ->
+                      E.return (maybe Nothing (fun fact -> Just (param, fact)) fact, captures)
+                end) optional_facts >>= fun captured_facts ->
+                (* A direct call may snapshot a pure integer offset whose
+                   dependency is caller memory, rather than a private scalar.
+                   Every original operand must be readonly: evaluating this
+                   hidden value cannot race a sibling store or move an effect.
+                   Only the typed scalar value crosses the boundary. In
+                   particular, reusable initializer facts never retain a live
+                   member read, and static object-size keeps its offset gate. *)
+                E.mapM (fun (((param, (qs, ty, _)), actual), (fact, captures)) ->
+                  if isJust fact || not allow_capture || active_capture ||
+                      not (List.all (fun readonly -> readonly) readonly_operands) ||
+                      qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                      not (AilTypesAux.is_pointer ty) ||
+                      not (gnu_inline_parameter_unchanged param stmt)
+                  then E.return (fact, captures) else
+                  (* Do not strip a comma prefix here. Even a readonly prefix
+                     can diverge before the offset is reached; its metadata
+                     origin alone cannot justify an earlier extra memory read. *)
+                  gnu_record_member_origin actual >>= fun origin ->
+                  (match gnu_inline_pointer_offset origin with
+                    | Just (pointer, index, element_ty, subtract) ->
+                        let (index_qs, index_ty) = qualified_ctype_of index in
+                        if gnu_size_effects origin <> Just false ||
+                            not (AilTypesAux.is_integer index_ty) ||
+                            index_qs.Ctype.volatile || AilTypesAux.is_atomic index_ty ||
+                            not (gnu_inline_fixed_object_type element_ty)
+                        then E.return (Nothing, []) else
+                        capture_gnu_inline_fact translate_expr tagDefs (ctype_of pointer) pointer >>= function
+                          | Nothing -> E.return (Nothing, [])
+                          | Just base ->
+                              gnu_transfer_inline_fact transfer_leaf base >>= fun (base, base_captures) ->
+                              (match base with
+                                | Nothing -> E.return (Nothing, [])
+                                | Just E.GNU_inline_unknown_extent_fact ->
+                                    E.return (Just (param, E.GNU_inline_unknown_extent_fact), base_captures)
+                                | Just base ->
+                                    E.fresh_elab_sym (Symbol.SD_ObjectAddress "__cerb_offset_capture") >>= fun formal ->
+                                    let loc = Loc.locOf index in
+                                    let rebound = A.AnnotatedExpression
+                                      (GenTypes.GenRValueType (GenTypes.inject_type index_ty)) [] loc
+                                      (A.AilErvalue (A.AnnotatedExpression
+                                        (GenTypes.GenLValueType Ctype.no_qualifiers index_ty false) [] loc
+                                        (A.AilEident formal))) in
+                                    let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                                      "GNU call offset snapshot formal=" ^ show formal ^
+                                      "; actual=" ^ Pp.stringFromAil_expression index) in
+                                    E.return (Just (param, E.GNU_inline_offset_extent_fact
+                                      base rebound element_ty subtract [formal]),
+                                      base_captures ++ [((formal, index_ty), index)])
+                              end)
+                        end
+                    | Nothing -> E.return (Nothing, [])
+                  end)
+                ) (List.zip (List.zip (List.zip params param_types) fixed_args) captured_facts)
+                  >>= fun captured_facts ->
+                let optional_facts = List.map fst captured_facts in
+                let captures = List.concat (List.map snd captured_facts) in
+                (* Preserve a scalar relationship to an existing hidden snapshot.
+                   No caller read is retained and no runtime capture is added.
+                   Require whole-body immutability and readonly siblings. *)
+                let optional_facts = List.map
+                  (fun (((param, (qs, ty, _)), actual), original) ->
+                    if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                        not (AilTypesAux.is_integer ty) ||
+                        not (gnu_inline_parameter_unchanged param stmt) ||
+                        not (List.all (fun readonly -> readonly) readonly_operands) ||
+                        gnu_size_effects actual <> Just false
+                    then original else
+                    List.foldl (fun result ((capture, capture_ty), captured_actual) ->
+                      if result <> original then result else
+                      match captured_actual with
+                        | A.AnnotatedExpression _ _ _
+                            (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident subject))) ->
+                            (match gnu_alloc_size_dependencies actual with
+                              | Just reads ->
+                                  if reads = [] || not (List.all (fun (sym, read_ty) ->
+                                    sym = subject && gnu_scalar_implementation_type_equal read_ty capture_ty) reads)
+                                  then result else
+                                  (match gnu_alloc_size_rebind_subject subject capture actual with
+                                    | Just rebound ->
+                                        Just (param, E.GNU_inline_integer_fact
+                                          (A.AnnotatedExpression
+                                            (GenTypes.GenRValueType (GenTypes.inject_type ty)) [] (Loc.locOf actual)
+                                            (A.AilEcast Ctype.no_qualifiers ty rebound)))
+                                    | Nothing -> result end)
+                              | Nothing -> result end)
+                        | _ -> result end) original captures)
+                  (List.zip (List.zip (List.zip params param_types) fixed_args) optional_facts) in
+                let facts = List.foldr (fun item acc -> match item with
+                  | Just fact -> fact :: acc | Nothing -> acc end) [] optional_facts in
+                (* Hidden scalar parameters snapshot already-admitted reads.
+                   Transport their closed numeric bounds as well as the typed
+                   runtime argument. The usual function-entry memory and
+                   specialization key retain their invalidation and identity. *)
+                E.mapM (fun ((formal, ty), actual) ->
+                  gnu_scalar_fact tagDefs ty actual >>= fun fact ->
+                  E.return (maybe Nothing (fun value -> Just (formal, value)) fact)
+                ) captures >>= fun capture_facts ->
+                let facts = facts ++ List.foldr (fun item acc -> match item with
+                  | Just fact -> fact :: acc | Nothing -> acc end) [] capture_facts in
+                (* Certified globals have a TU-wide opaque write class, but a
+                   specialization still needs the caller's positive certificate.
+                   Include that context in the instance key; never turn a
+                   missing or refined caller value into an unknown extent. *)
+                E.gnu_pointer_refinement_possible source >>= fun global_refinement ->
+                ((if global_refinement then E.gnu_opaque_global_unrefined_symbols
+                  else E.gnu_opaque_global_pointer_symbols) >>= fun globals ->
+                  E.foldlM (fun captured global ->
+                    E.gnu_compiler_fact global >>= fun fact ->
+                    E.return (if fact = Just E.GNU_inline_unknown_extent_fact &&
+                        not (isJust (List.lookup global facts))
+                      then captured ++ [(global, E.GNU_inline_unknown_extent_fact)]
+                      else captured)) [] globals) >>= fun global_facts ->
+                let facts = facts ++ global_facts in
+                let readonly_arguments = List.all (fun readonly -> readonly) readonly_operands in
+                (if readonly_arguments then E.return true else
+                  if not allow_capture then E.return false else
+                  E.mapM gnu_opaque_memory_effects (callee :: args) >>= fun effects ->
+                  E.return (List.all (fun preserves -> preserves) effects)) >>= fun origins_preserved ->
+                let stable_origin_subject subject =
+                  if readonly_arguments then E.return true else
+                  E.gnu_alloc_size_subject_allowed subject >>= fun private_object ->
+                  E.gnu_compiler_fact subject >>= fun origin ->
+                  let stable = origins_preserved && private_object && gnu_inline_opaque_base origin &&
+                    List.all (gnu_inline_parameter_expression_safe subject) (callee :: args) in
+                  let () = if stable then Debug.print_debug_located 2 [Debug.DB_elaboration]
+                    (Loc.locOf callee) (fun () ->
+                      "GNU argument effects preserve origin " ^ show subject)
+                    else () in
+                  E.return stable in
+                (* Storage reachability is stronger than an unknown size. Carry
+                   only an existing ordinary-parameter certificate across a
+                   stable direct argument. Effectful siblings require the full
+                   class-preservation proof above; known-value snapshots below
+                   still require readonly operands. No origin is inferred from
+                   an arbitrary missing or unknown size. *)
+                E.gnu_opaque_clobber_slots >>= fun clobberable ->
+                E.mapM (fun (param, actual) ->
+                  if not (gnu_inline_opaque_base (List.lookup param facts))
+                  then E.return Nothing else
+                  if List.elem param fresh_opaque then E.return (Just param) else
+                  match gnu_inline_direct_pointer_symbol actual with
+                    | Just subject ->
+                        stable_origin_subject subject >>= fun stable ->
+                        E.gnu_compiler_fact subject >>= fun origin ->
+                        E.return (if stable && gnu_inline_opaque_base origin &&
+                          List.any (fun (indirect, root, _) -> indirect && root = subject) clobberable
+                          then Just param else Nothing)
+                    | Nothing -> E.return Nothing end
+                ) (List.zip params fixed_args) >>= fun incoming ->
+                let opaque_origins = List.foldr (fun item rest ->
+                  maybe rest (fun param -> param :: rest) item) [] incoming in
+                let (equal, disjoint, frame) = aliases in
+                (* The size-only fast path intentionally keeps an opaque base as
+                   GNU_inline_unknown_extent_fact. Its independent, already
+                   established member snapshots must not be dropped with it.
+                   Keep them separate from the base class and in the instance
+                   key. Only exact readonly pointer-variable arguments qualify;
+                   casts, offsets and missing member evidence remain gaps.
+                   The independent snapshots also survive when the base extent
+                   is absent; they establish no fact about that base address. *)
+                E.mapM (fun ((param, (_, ty, _)), actual) ->
+                  if (isJust (List.lookup param facts) &&
+                        List.lookup param facts <> Just E.GNU_inline_unknown_extent_fact) ||
+                      not (List.all (fun readonly -> readonly) readonly_operands) ||
+                      not (gnu_function_target_type_equal ty (ctype_of actual))
+                  then E.return Nothing else
+                  match actual with
+                    | A.AnnotatedExpression _ _ _
+                        (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident _))) ->
+                        gnu_memory_slot_of false actual >>= (function
+                          | Just slot ->
+                              gnu_inline_memory_contents tagDefs (ctype_of actual) slot >>= fun members ->
+                              let members = List.filter (fun (_, fact) -> gnu_member_fact_closed fact)
+                                (List.map (fun (path, fact) -> (path, E.gnu_static_extent_fact fact)) members) in
+                              E.return (if members = [] then Nothing else Just (param, members))
+                          | Nothing -> E.return Nothing end)
+                    | _ -> E.return Nothing end
+                ) (List.zip (List.zip params param_types) fixed_args) >>= fun optional_members ->
+                let member_snapshots = List.foldr (fun item rest ->
+                  maybe rest (fun value -> value :: rest) item) [] optional_members in
+                (* A live contents certificate is stronger than reachability
+                   or member snapshots. A callee with comparisons must discharge
+                   the strict complete body census using these actual caller
+                   origins; its generic entry proof cannot justify an arbitrary
+                   specialization. *)
+                gnu_boundary_capture_origins >>= fun (caller_values, caller_contents) ->
+                (if not global_refinement then E.return true else
+                  if not origins_preserved || (caller_contents = [] && fresh_opaque = [])
+                  then E.return false else
+                  E.mapM (fun (param, actual) ->
+                    if not (gnu_inline_parameter_unchanged param stmt &&
+                      gnu_alloc_size_subject_unescaped param stmt)
+                    then E.return (param, false, false) else
+                    gnu_boundary_origin_value caller_values caller_contents actual >>= fun value ->
+                    gnu_boundary_origin_storage caller_values caller_contents actual >>= fun storage ->
+                    E.return (param, value, storage)) (List.zip params fixed_args) >>= fun inputs ->
+                  let values = List.foldr (fun (param, yes, _) rest ->
+                    if yes then param :: rest else rest) [] inputs in
+                  let roots = List.foldr (fun (param, _, yes) rest ->
+                    if yes then param :: rest else rest) [] inputs in
+                  let private_params = List.filter (fun param ->
+                    gnu_alloc_size_subject_unescaped param stmt) params in
+                  gnu_boundary_effects_statement_with (gnu_incoming_return_call [] tagDefs)
+                    [] true private_params params [] false [] []
+                    values roots Nothing stmt stmt) >>= fun contents_preserved ->
+                let () = if global_refinement && contents_preserved then
+                  Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                    "GNU incoming contents transport certified " ^ show source) else () in
+                E.mapM (fun ((param, (qs, ty, _)), actual) ->
+                  if not contents_preserved || qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                      not (gnu_inline_parameter_unchanged param stmt) ||
+                      not (gnu_alloc_size_subject_unescaped param stmt) ||
+                      not (gnu_function_target_type_equal ty (ctype_of actual))
+                  then E.return Nothing else
+                  if List.elem param fresh_opaque then E.return (Just param) else
+                  if readonly_arguments && AilTypesAux.is_pointer ty &&
+                      not (AilTypesAux.is_pointer_to_function ty) &&
+                      not (gnu_literal_null_pointer actual) then
+                    gnu_boundary_origin_storage caller_values caller_contents actual >>= fun storage ->
+                    E.return (if storage then Just param else Nothing)
+                  else match actual with
+                    | A.AnnotatedExpression _ _ _
+                        (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident subject))) ->
+                        stable_origin_subject subject >>= fun stable ->
+                        E.return (if stable && AilTypesAux.is_pointer ty &&
+                          not (AilTypesAux.is_pointer_to_function ty) &&
+                          List.elem subject caller_contents then Just param else Nothing)
+                    | _ -> E.return Nothing end
+                ) (List.zip (List.zip params param_types) fixed_args) >>= fun contents ->
+                let contents_origins = List.foldr (fun item rest ->
+                  maybe rest (fun param -> param :: rest) item) [] contents in
+                (* A fresh unsized call supplies an actual boundary. The new
+                   path certificate grants only independently unrefined member
+                   VALUES. It cannot override a captured member fact or install
+                   a contents root; the original whole-body proof above still
+                   exclusively controls contents_origins. *)
+                E.mapM (fun param ->
+                  E.gnu_parameter_member_value_paths param >>= fun paths ->
+                  let previous = maybe [] (fun members -> members) (List.lookup param member_snapshots) in
+                  let added = List.foldr (fun path rest ->
+                    if isJust (List.lookup path previous) then rest
+                    else (path, E.GNU_inline_unknown_value_fact) :: rest) [] paths in
+                  E.return (param, previous ++ added)) fresh_opaque >>= fun member_values ->
+                let member_snapshots = List.filter (fun (param, _) ->
+                    not (List.elem param fresh_opaque)) member_snapshots ++
+                  List.filter (fun (_, members) -> members <> []) member_values in
+                let aliases = (equal, disjoint, frame, opaque_origins, member_snapshots, contents_origins) in
+                let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                  "GNU inline specialization facts " ^ show source ^ " [" ^
+                    gnu_inline_facts_debug facts ^ "]; aliases=" ^
+                      (let (equal, disjoint, frame, opaque, members, contents) = aliases in show (equal, disjoint) ^
+                        "; caller-frame=" ^ show frame ^ "; opaque-storage=" ^ show opaque ^
+                        "; opaque-member-count=" ^ show (List.length (List.concat (List.map snd members))) ^
+                        "; opaque-contents=" ^ show contents) ^
+                    "; anonymous-count=" ^ show pack_count) in
+                (* The queue registers its target before compiling its body.
+                   Reusing an exact (source, facts) instance closes a recursive
+                   call graph without cloning another procedure. Structural
+                   fact equality is conservative: equivalent expressions that
+                   differ in syntax still require separate analysis. *)
+                let call_site = "callee=" ^ show source ^
+                  "; call=" ^ Loc.stringFromLocation (Loc.with_cursor (Loc.locOf callee)) ^
+                  "; pointer captures=[" ^ stringFromList (fun item -> match item with
+                    | Nothing -> "non-pointer parameter"
+                    | Just (param, site) -> site ^
+                        "; captured=" ^ gnu_inline_fact_kind (List.lookup param initial_captured_facts) ^
+                        "; transferred=" ^ gnu_inline_fact_kind (List.lookup param facts)
+                    end) pointer_call_sites ^ "]" in
+                E.gnu_inline_instance source facts aliases pack_count >>= function
+                  | Just proc -> E.record_gnu_inline_call_site proc call_site >>
+                      E.return (Just (proc, List.map snd captures))
+                  | Nothing ->
+                      E.gnu_inline_is_active source >>= fun active ->
+                      E.gnu_inline_strictly_weaker_instance source facts aliases pack_count >>= fun weaker ->
+                      if active && not weaker then
+                        (* The recursive call has no safe metadata instance.
+                           Do not reuse a different active clone or invent a
+                           fact. Returning Nothing keeps translate_function_call's
+                           ordinary C callee and argument path, so source
+                           evaluation and recursion remain intact. *)
+                        E.return Nothing
+                      else E.fresh_elab_sym Symbol.SD_None >>= fun proc ->
+                        E.enqueue_gnu_inline source facts aliases pack_count (List.map fst captures) proc >>
+                        E.record_gnu_inline_call_site proc call_site >>
+                        (* The private signature includes only certified scalar
+                           captures. Ordinary C-call lowering retains conversion,
+                           variadic pack copying, boundaries and cleanup. *)
+                        E.return (Just (proc, List.map snd captures))
+                end
+            | _ -> E.return Nothing
+          end)
+      end
+  end
+
+type expr_ctx =
+  | ECTX_glob of Symbol.sym * Symbol.sym
+  | ECTX_logical_operator (* when elborating the desugaring of && or || *)
+  | ECTX_other
+
+(* Esave continuations are extracted into the procedure label table and do not
+   retain lexical binders surrounding their source location in every execution
+   path. Explicitly carry the fresh invocation token and anonymous pack through
+   EVERY continuation edge, including those
+   introduced for loops, switch, goto and return. This pass is over one complete
+   translated procedure, before adding its entry token binder. It never rewrites
+   another procedure or changes ordinary C argument evaluation/call boundaries. *)
+val gnu_va_capture_scope: list (Symbol.sym * C.core_base_type) -> C.expr unit -> C.expr unit
+val gnu_va_capture_scope_node:
+  list (Symbol.sym * C.core_base_type) -> C.generic_expr_ unit unit Symbol.sym -> C.generic_expr_ unit unit Symbol.sym
+val gnu_va_capture_scope_alternatives:
+  list (Symbol.sym * C.core_base_type) -> list (C.pattern * C.expr unit) -> list (C.pattern * C.expr unit)
+val gnu_va_capture_scope_list:
+  list (Symbol.sym * C.core_base_type) -> list (C.expr unit) -> list (C.expr unit)
+let rec gnu_va_capture_scope captured (C.Expr annots node) =
+  C.Expr annots (gnu_va_capture_scope_node captured node)
+
+and gnu_va_capture_scope_node captured node =
+  let saved = List.map (fun (sym, bTy) -> (sym, ((bTy, Nothing), Caux.mk_sym_pe sym))) captured in
+  let passed = List.map (fun (sym, _) -> Caux.mk_sym_pe sym) captured in
+  match node with
+    | C.Epure _ -> node
+    | C.Ememop _ _ -> node
+    | C.Eaction _ -> node
+    | C.Ecase pe alternatives ->
+        C.Ecase pe (gnu_va_capture_scope_alternatives captured alternatives)
+    | C.Elet pattern pe body -> C.Elet pattern pe (gnu_va_capture_scope captured body)
+    | C.Eif condition yes no -> C.Eif condition (gnu_va_capture_scope captured yes) (gnu_va_capture_scope captured no)
+    | C.Eccall _ _ _ _ -> node
+    | C.Eproc _ _ _ -> node
+    | C.Eunseq expressions -> C.Eunseq (gnu_va_capture_scope_list captured expressions)
+    | C.Ewseq pattern left right -> C.Ewseq pattern (gnu_va_capture_scope captured left) (gnu_va_capture_scope captured right)
+    | C.Esseq pattern left right -> C.Esseq pattern (gnu_va_capture_scope captured left) (gnu_va_capture_scope captured right)
+    | C.Ebound body -> C.Ebound (gnu_va_capture_scope captured body)
+    | C.Eindivisible region body -> C.Eindivisible region (gnu_va_capture_scope captured body)
+    | C.End expressions -> C.End (gnu_va_capture_scope_list captured expressions)
+    | C.Esave label arguments body ->
+        C.Esave label
+          (arguments ++ saved)
+          (gnu_va_capture_scope captured body)
+    | C.Erun annotation label arguments -> C.Erun annotation label (arguments ++ passed)
+    | C.Epar expressions -> C.Epar (gnu_va_capture_scope_list captured expressions)
+    | C.Ewait _ -> node
+    | C.Eannot annotations body -> C.Eannot annotations (gnu_va_capture_scope captured body)
+    | C.Eexcluded _ _ -> node
+  end
+
+and gnu_va_capture_scope_alternatives captured alternatives =
+  match alternatives with
+    | [] -> []
+    | (pattern, body) :: rest ->
+        (pattern, gnu_va_capture_scope captured body) :: gnu_va_capture_scope_alternatives captured rest
+  end
+
+and gnu_va_capture_scope_list captured expressions =
+  match expressions with
+    | [] -> []
+    | expression :: rest -> gnu_va_capture_scope captured expression :: gnu_va_capture_scope_list captured rest
+  end
+
+declare {lean} termination_argument gnu_va_capture_scope = automatic
+declare {lean} termination_argument gnu_va_capture_scope_node = automatic
+declare {lean} termination_argument gnu_va_capture_scope_alternatives = automatic
+declare {lean} termination_argument gnu_va_capture_scope_list = automatic
+
+(* UNAPPLIED: place before translate_expression. The callback uses the ordinary
+   expression lowering, including volatile loads and temporary-object tracking. *)
+val translate_gnu_va_call:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  (maybe Symbol.sym * maybe Symbol.sym) -> Loc.t -> A.ail_builtin ->
+  list (A.expression GenTypes.genTypeCategory) -> E.elabM (C.expr unit)
+let translate_gnu_va_call self variadic_env loc builtin args =
+  let refuse message = E.record_error_at loc message >> E.return Caux.mk_skip_e in
+  E.get_gnu_va_context >>= function
+    | Nothing -> refuse "GNU variadic builtin outside an ordinary function invocation"
+    | Just context ->
+      let scope_pe = Caux.mk_sym_pe context.E.gnu_scope_sym in
+      let evaluate_pointers operands make_effect =
+        E.mapM (fun operand ->
+          E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_pointer) >>= fun loaded ->
+          E.wrapped_fresh_symbol (C.BTy_object C.OTy_pointer) >>= fun pointer ->
+          self operand >>= fun expression -> E.return (loaded, pointer, expression)
+        ) operands >>= fun evaluated ->
+        make_effect (List.map (fun (_, pointer, _) -> pointer.E.sym_pe) evaluated) >>= fun effect_expr ->
+        let checked = List.foldr (fun (loaded, pointer, _) body ->
+          Caux.mk_case_e loaded.E.sym_pe
+            [(Caux.mk_specified_pat pointer.E.sym_pat, body);
+             (Caux.mk_unspecified_pat (Caux.mk_empty_pat C.BTy_ctype),
+              Caux.mk_pure_e (Caux.mk_undef_exceptional_condition loc))]
+        ) effect_expr evaluated in
+        E.return (Caux.mk_sseq_e
+          (Caux.mk_tuple_pat (List.map (fun (loaded, _, _) -> loaded.E.sym_pat) evaluated))
+          (Caux.mk_unseq (List.map (fun (_, _, expression) -> expression) evaluated)) checked)
+      in
+      let start record_ty ap = match variadic_env with
+        | (Nothing, _) -> refuse "GNU va_start requires a variadic function"
+        | (Just pack, _) ->
+            evaluate_pointers [ap] (function
+              | [pointer] -> E.return (Caux.mk_unit_sseq
+                  [Caux.mk_memop_e Mem_common.GNU_va_frame
+                    [scope_pe; Caux.mk_ctype_pe context.E.gnu_return_type;
+                     Caux.mk_list_pe C.BTy_ctype (List.map Caux.mk_ctype_pe context.E.gnu_named_types);
+                     Caux.mk_sym_pe pack]]
+                  (Caux.mk_memop_e Mem_common.GNU_va_start [scope_pe; Caux.mk_ctype_pe record_ty; pointer]))
+              | _ -> refuse "malformed GNU va_start lowering"
+            end)
+      end in
+      match (builtin, args) with
+        | (A.AilBGNU_va_start true record_ty, ap :: _) -> start record_ty ap
+        | (A.AilBGNU_va_start false record_ty, [ap; last]) ->
+            match (variadic_env, Aaux.strip_expression last) with
+              | ((Just _, Just expected), A.AnnotatedExpression (GenTypes.GenLValueType _ ty is_register) _ _ (A.AilEident supplied)) ->
+                  if supplied <> expected then refuse "legacy GNU va_start requires the last named parameter"
+                  else match ty with Ctype.Ctype annotations _ ->
+                  match Annot.get_parameter_origin annotations with
+                    | Nothing -> refuse "legacy GNU va_start source parameter origin is unavailable"
+                    | Just Annot.Parameter_array -> E.return (Caux.mk_pure_e (Caux.mk_undef_pe loc Undefined.UB143))
+                    | Just Annot.Parameter_function -> E.return (Caux.mk_pure_e (Caux.mk_undef_pe loc Undefined.UB143))
+                    | Just Annot.Parameter_object ->
+                    let promoted = match ty with
+                      | Ctype.Ctype annots (Ctype.Basic (Ctype.Floating (Ctype.RealFloating Ctype.Float))) ->
+                          Ctype.Ctype annots (Ctype.Basic (Ctype.Floating (Ctype.RealFloating Ctype.Double)))
+                      | _ -> match AilTypesAux.promotion (Implementation.integerImpl ()) ty with
+                          | Just promoted -> promoted
+                          | Nothing -> ty
+                        end
+                    end in
+                    if is_register || not (AilTypesAux.are_compatible (Ctype.no_qualifiers, ty) (Ctype.no_qualifiers, promoted)) then
+                      E.return (Caux.mk_pure_e (Caux.mk_undef_pe loc Undefined.UB143))
+                    else start record_ty ap
+                  end
+                  end
+              | _ -> refuse "legacy GNU va_start requires the last named parameter of a variadic function"
+            end
+        | (A.AilBGNU_va_copy record_ty, [destination; source]) ->
+            evaluate_pointers [destination; source] (fun pointers -> E.return
+              (Caux.mk_memop_e Mem_common.GNU_va_copy (scope_pe :: Caux.mk_ctype_pe record_ty :: pointers)))
+        | (A.AilBGNU_va_arg record_ty requested, [ap]) ->
+            evaluate_pointers [ap] (function
+              | [pointer] ->
+                  E.wrapped_fresh_symbol (C.BTy_object C.OTy_pointer) >>= fun result ->
+                  E.return (Caux.mk_sseq_e result.E.sym_pat
+                    (Caux.mk_memop_e Mem_common.GNU_va_arg
+                      [scope_pe; Caux.mk_ctype_pe record_ty; pointer; Caux.mk_ctype_pe requested])
+                    (Caux.pload loc (Caux.mk_ctype_pe requested) result.E.sym_pe Cmm.NA))
+              | _ -> refuse "malformed GNU va_arg lowering"
+            end)
+        | (A.AilBGNU_va_end _, [ap]) ->
+            evaluate_pointers [ap] (fun pointers -> E.return
+              (Caux.mk_memop_e Mem_common.GNU_va_end (scope_pe :: pointers)))
+        | _ -> refuse "GNU variadic builtin has an invalid argument list"
+      end
+  end
+
+(* One asm statement: evaluate operands once without imposing their order,
+   execute the shared register machine, then perform ordinary checked stores.
+   No C call boundary, synthetic object or direct host assembly is introduced. *)
+val translate_gnu_asm_call:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  translation_stdlib -> Loc.t -> bool -> bool -> string -> list (maybe string * string) ->
+  list (maybe string * string) -> list string ->
+  list (A.expression GenTypes.genTypeCategory) -> E.elabM (C.expr unit)
+let translate_gnu_asm_call self stdlib loc is_volatile is_inline template outputs inputs clobbers args =
+  let refuse message = E.record_error_at loc message >> E.return Caux.mk_skip_e in
+  let width_of_type (Ctype.Ctype annotations ty) =
+    if isJust (Annot.get_bitfield annotations) then Nothing else match ty with
+      | Ctype.Basic (Ctype.Integer Ctype.Bool) -> Nothing
+      | Ctype.Basic (Ctype.Integer ity) -> Maybe.map (fun bytes -> 8 * bytes) (Implementation.sizeof_ity ity)
+      | _ -> Nothing
+    end in
+  let output_symbol expression = match Aaux.strip_expression expression with
+    | A.AnnotatedExpression (GenTypes.GenLValueType qs _ _) _ _ (A.AilEident sym) ->
+        if qs.Ctype.volatile then Nothing else Just sym
+    | _ -> Nothing
+  end in
+  if not (Implementation.has_amd64_sysv_abi ()) then refuse "GNU register assembly requires the AMD64 implementation profile"
+  else if outputs = [] || List.length args <> List.length outputs + List.length inputs then
+    refuse "GNU register assembly requires output operands with matching metadata"
+  else
+    let (output_args, input_args) = List.splitAt (List.length outputs) args in
+    let symbols = List.map output_symbol output_args in
+    if List.any isNothing symbols || List.any (fun sym ->
+         List.length (List.filter (fun other -> other = sym) symbols) <> 1) symbols then
+      refuse "GNU asm aliased, indirect or volatile output lvalues require additional writeback semantics"
+    else match output_args with
+      | [] -> refuse "GNU register assembly requires an output width"
+      | first :: _ -> match width_of_type (ctype_of first) with
+          | Nothing -> refuse "GNU asm output is not a supported integer representation"
+          | Just width -> match Gnu_amd64_asm.asm_validate_contract width outputs inputs clobbers template with
+              | Left message -> refuse message
+              | Right (instructions, read_write_flags, count_slot) ->
+                  let (_, bad_width) = List.foldl (fun (index, bad) operand ->
+                    let actual = width_of_type (ctype_of operand) in
+                    let count_only = index >= List.length outputs && List.all (fun instruction ->
+                      match instruction with
+                        | Gnu_amd64_asm.Asm_Shift _ (Gnu_amd64_asm.Asm_Slot source) destination ->
+                            if source = index then destination <> index else
+                              source <> index && destination <> index
+                        | _ -> let (reads, destination, _) = Gnu_amd64_asm.asm_instruction_accesses instruction in
+                            not (List.elem index reads) && destination <> Just index
+                      end) instructions in
+                    let valid = if count_slot = Just index && count_only then
+                        maybe false (fun bits -> List.elem bits [8; 16; 32; 64]) actual
+                      else actual = Just width in
+                    (index + 1, bad || not valid)
+                  ) (0, false) args in
+                  if bad_width then refuse "GNU asm operand widths differ from their register instruction width"
+                  else
+                    E.clear_gnu_flow_facts >> E.clear_gnu_memory_facts >>
+                    E.mapM (fun (operand, read_write) ->
+                      let ty = ctype_of operand in
+                      self operand >>= fun address_expression ->
+                      E.wrapped_fresh_symbol (C.BTy_object C.OTy_pointer) >>= fun pointer ->
+                      E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun loaded ->
+                      E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun integer ->
+                      E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun result ->
+                      let evaluated = Caux.mk_wseq_e pointer.E.sym_pat address_expression
+                        (if read_write then
+                           Caux.mk_wseq_e loaded.E.sym_pat
+                             (Caux.pload loc (Caux.mk_ctype_pe ty) pointer.E.sym_pe Cmm.NA)
+                             (Caux.mk_pure_e (Caux.mk_tuple_pe [pointer.E.sym_pe; loaded.E.sym_pe]))
+                         else Caux.mk_pure_e (Caux.mk_tuple_pe
+                           [pointer.E.sym_pe; Caux.mk_unspecified_pe ty]))
+                      in E.return (ty, read_write, pointer, loaded, integer, result, evaluated)
+                    ) (List.zip output_args read_write_flags) >>= fun evaluated_outputs ->
+                    E.mapM (fun operand ->
+                      self operand >>= fun expression ->
+                      E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun loaded ->
+                      E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun integer ->
+                      E.return (loaded, integer, expression)
+                    ) input_args >>= fun evaluated_inputs ->
+                    (* All mutable analysis facts become stale across the writes.
+                       These resets do not erase or replace runtime effects. *)
+                    E.clear_gnu_flow_facts >> E.clear_gnu_memory_facts >>
+                    let integer_bty = C.BTy_object C.OTy_integer in
+                    let registers = List.map (fun (_, read_write, _, _, integer, _, _) ->
+                      Caux.mk_tuple_pe [Caux.mk_boolean_pe read_write;
+                        if read_write then integer.E.sym_pe else Caux.mk_integer_pe 0]
+                    ) evaluated_outputs ++ List.map (fun (_, integer, _) ->
+                      Caux.mk_tuple_pe [Caux.mk_boolean_pe true; integer.E.sym_pe]) evaluated_inputs in
+                    let program = Caux.mk_list_pe (C.BTy_list integer_bty)
+                      (List.map (fun instruction -> Caux.mk_list_pe integer_bty
+                        (List.map Caux.mk_integer_pe (Gnu_amd64_asm_core.asm_instruction_code instruction))) instructions) in
+                    let machine = C.Expr [Annot.Astd ("GNU extended asm" ^
+                        (if is_volatile then " volatile" else "") ^ (if is_inline then " inline" else ""))]
+                      (C.Eproc default (C.Impl (Implementation.BuiltinFunction "gnu_amd64_register_asm"))
+                        [Caux.mk_integer_pe (integerFromNat width);
+                         Caux.mk_integer_pe (integerFromNat (List.length outputs)); program;
+                         Caux.mk_list_pe (C.BTy_tuple [C.BTy_boolean; integer_bty]) registers]) in
+                    let result_pattern = Caux.mk_list_pat integer_bty
+                      (List.map (fun (_, _, _, _, _, result, _) -> result.E.sym_pat) evaluated_outputs) in
+                    let stores = List.map (fun (ty, _, pointer, _, _, result, _) ->
+                      Caux.pstore loc (Caux.mk_ctype_pe ty) pointer.E.sym_pe
+                        (Caux.mk_specified_pe (stdlib.mkcall_conv_int ty result.E.sym_pe)) Cmm.NA
+                    ) evaluated_outputs in
+                    let stored = Caux.mk_wseq_e
+                      (Caux.mk_tuple_pat (List.map (fun _ -> Caux.mk_empty_pat C.BTy_unit) stores))
+                      (Caux.mk_unseq stores) Caux.mk_skip_e in
+                    let effect_expr = Caux.mk_wseq_e result_pattern machine stored in
+                    let checked_values =
+                      List.map (fun (_, _, _, loaded, integer, _, _) -> (loaded, integer))
+                        (List.filter (fun (_, read_write, _, _, _, _, _) -> read_write) evaluated_outputs) ++
+                      List.map (fun (loaded, integer, _) -> (loaded, integer)) evaluated_inputs in
+                    let checked = List.foldr (fun (loaded, integer) body ->
+                      Caux.mk_case_e loaded.E.sym_pe
+                        [(Caux.mk_specified_pat integer.E.sym_pat, body);
+                         (Caux.mk_unspecified_pat (Caux.mk_empty_pat C.BTy_ctype),
+                          Caux.mk_pure_e (Caux.mk_undef_exceptional_condition loc))]
+                    ) effect_expr checked_values in
+                    let operand_patterns = List.map (fun (_, _, pointer, loaded, _, _, _) ->
+                        Caux.mk_tuple_pat [pointer.E.sym_pat; loaded.E.sym_pat]) evaluated_outputs ++
+                      List.map (fun (loaded, _, _) -> loaded.E.sym_pat) evaluated_inputs in
+                    let operand_expressions = List.map (fun (_, _, _, _, _, _, expression) -> expression) evaluated_outputs ++
+                      List.map (fun (_, _, expression) -> expression) evaluated_inputs in
+                    E.return (Caux.mk_sseq_e (Caux.mk_tuple_pat operand_patterns)
+                      (Caux.mk_unseq operand_expressions) checked)
+            end
+        end
+    end
+
+(* A field lens keeps the containing object address separate from the static
+   member selector. It is never lowered through offsetof/member_shift, and a
+   general C address consumer cannot mistake it for an addressable subobject. *)
+let is_bitfield_expression expr =
+  let Ctype.Ctype annots _ = ctype_of expr in isJust (Annot.get_bitfield annots)
+
+val translate_bitfield_base:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (Symbol.sym * Symbol.identifier * C.expr unit)
+let rec translate_bitfield_base translate_expr (A.AnnotatedExpression _ _ loc node as expr) =
+  let (qs,ty) = qualified_ctype_of expr in
+  (if qs.Ctype.volatile || AilTypesAux.is_atomic ty then
+    E.record_error_at loc "volatile or atomic bit-field access-unit semantics are not yet implemented"
+   else E.return ()) >>
+  let tag_of ty = match Ctype.unatomic_ ty with
+    | Ctype.Struct tag -> tag
+    | Ctype.Union tag -> tag
+    | _ -> illTypedAil loc "bit-field base is not an aggregate"
+  end in
+  match node with
+    | A.AilEmemberof base member ->
+        translate_expr base >>= fun core_base -> E.return (tag_of (ctype_of base),member,core_base)
+    | A.AilEmemberofptr base member ->
+        let referenced = fromJust "bit-field pointer has no referenced type" (AilTypesAux.referenced_type (ctype_of base)) in
+        E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_pointer) >>= fun loaded ->
+        E.wrapped_fresh_symbol (C.BTy_object C.OTy_pointer) >>= fun pointer ->
+        translate_expr base >>= fun core_base ->
+        E.return (tag_of referenced,member,
+          Caux.mk_wseq_e loaded.E.sym_pat core_base
+            (Caux.mk_case_e loaded.E.sym_pe
+              [(Caux.mk_specified_pat pointer.E.sym_pat,Caux.mk_pure_e pointer.E.sym_pe);
+               (Caux.mk_unspecified_pat (Caux.mk_empty_pat C.BTy_ctype),
+                Caux.mk_pure_e (Caux.mk_undef_pe loc (Undefined.UB_CERB004_unspecified Undefined.UB_unspec_memberofptr)))]))
+    | A.AilEannot _ inner -> translate_bitfield_base translate_expr inner
+    | _ -> illTypedAil loc "bit-field lvalue lost its member selector"
+  end
+
+let translate_bitfield_assignment loc translate_expr stdlib left right =
+  translate_bitfield_base translate_expr left >>= fun (tag,member,base_expr) ->
+  let Ctype.Ctype _ kind = ctype_of left in
+  let stored_ty = Ctype.Ctype [] kind in
+  translate_assignment_conversion translate_expr stdlib stored_ty right >>= fun (right_type,right_expr,convert) ->
+  E.wrapped_fresh_symbol (C.BTy_object C.OTy_pointer) >>= fun base ->
+  E.wrapped_fresh_symbol (C.BTy_loaded right_type) >>= fun rhs ->
+  E.return (Caux.mk_wseq_e (Caux.mk_tuple_pat [base.E.sym_pat;rhs.E.sym_pat])
+    (Caux.mk_unseq_e [base_expr;right_expr])
+    (Caux.mk_memop_e (Mem_common.BitfieldStore tag member) [base.E.sym_pe;convert rhs.E.sym_pe]))
+
+(* Hygienic numeric identifiers below name already-bound Core loaded values.
+   Reusing ordinary arithmetic lowering preserves conversions and UB checks
+   while evaluating the C base and right operand exactly once. *)
+let translate_bitfield_update loc translate_expr stdlib return_old left aop right =
+  translate_bitfield_base translate_expr left >>= fun (tag,member,base_expr) ->
+  let left_ty = ctype_of left in
+  let Ctype.Ctype _ left_kind = left_ty in
+  let stored_ty = Ctype.Ctype [] left_kind in
+  let left_gty = GenTypes.inject_type left_ty in
+  let right_gty = GenTypes.inject_type (ctype_of right) in
+  let arithmetic_gty = match aop with
+    | A.Shl -> GenTypesAux.integer_promote left_gty
+    | A.Shr -> GenTypesAux.integer_promote left_gty
+    | _ -> GenTypesAux.usual_arithmetic left_gty right_gty
+  end in
+  E.wrapped_fresh_symbol (C.BTy_object C.OTy_pointer) >>= fun base_inner ->
+  E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun old_inner ->
+  E.wrapped_fresh_symbol (C.BTy_object C.OTy_pointer) >>= fun base ->
+  E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun old ->
+  E.wrapped_fresh_symbol (C.BTy_loaded (force_core_object_type_of_ctype (ctype_of right))) >>= fun rhs ->
+  E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun stored ->
+  let left_value = A.AnnotatedExpression (GenTypes.GenRValueType left_gty) [] loc (A.AilEident old.E.sym_sym) in
+  let right_value = A.AnnotatedExpression (GenTypes.GenRValueType right_gty) [] loc (A.AilEident rhs.E.sym_sym) in
+  let arithmetic = A.AnnotatedExpression (GenTypes.GenRValueType arithmetic_gty) [] loc
+    (A.AilEbinary left_value (A.Arithmetic aop) right_value) in
+  translate_assignment_conversion translate_expr stdlib stored_ty arithmetic >>= fun (arithmetic_type,arithmetic_expr,convert) ->
+  E.wrapped_fresh_symbol (C.BTy_loaded arithmetic_type) >>= fun computed ->
+  translate_expr right >>= fun right_expr ->
+  let left_expr = Caux.mk_wseq_e base_inner.E.sym_pat base_expr
+    (Caux.mk_wseq_e old_inner.E.sym_pat
+      (Caux.mk_memop_e (Mem_common.BitfieldLoad tag member) [base_inner.E.sym_pe])
+      (Caux.mk_pure_e (Caux.mk_tuple_pe [base_inner.E.sym_pe;old_inner.E.sym_pe]))) in
+  E.return (Caux.mk_wseq_e (Caux.mk_tuple_pat
+      [Caux.mk_tuple_pat [base.E.sym_pat;old.E.sym_pat];rhs.E.sym_pat])
+    (Caux.mk_unseq_e [left_expr;right_expr])
+    (Caux.mk_wseq_e computed.E.sym_pat arithmetic_expr
+      (Caux.mk_wseq_e stored.E.sym_pat
+        (Caux.mk_memop_e (Mem_common.BitfieldStore tag member) [base.E.sym_pe;convert computed.E.sym_pe])
+        (Caux.mk_pure_e (if return_old then old.E.sym_pe else stored.E.sym_pe)))))
+
+(* A compiler query can be irrelevant when both continuations perform the
+   identical return. Discard only total, effect-free guards: readonly alone
+   would also admit invalid loads, overflowing arithmetic or divergence. *)
+val gnu_total_query_guard:
+  Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_total_query_guard tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_total_query_guard tagDefs in
+  let both left right = self left >>= fun first -> self right >>= fun second ->
+    E.return (first && second) in
+  if not (AilTypesAux.is_integer (ctype_of expr)) then E.return false else
+  if isJust (gnu_scalar_closed_integer tagDefs expr) then E.return true else match node with
+    | A.AilEconst (A.ConstantInteger _) -> E.return true
+    | A.AilEconst (A.ConstantPredefined A.PConstantFalse) -> E.return true
+    | A.AilEconst (A.ConstantPredefined A.PConstantTrue) -> E.return true
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_va_arg_pack_len)) [] ->
+        E.get_gnu_va_pack_count >>= fun count ->
+        E.return (maybe false (fun value -> value >= 0) count)
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) [operand] ->
+        E.return (gnu_dead_arm_expression_closed operand)
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as object_expr) ->
+        let (qs, ty) = qualified_ctype_of object_expr in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_integer ty)
+        then E.return false else
+        E.gnu_branch_parameter_subject_allowed sym >>= fun parameter ->
+        E.gnu_branch_subject_allowed sym >>= fun unchanged ->
+        E.return (parameter && unchanged)
+    | A.AilEcall (A.AnnotatedExpression _ _ _
+        (A.AilEbuiltin (A.AilBGNU_object_size dynamic mode))) [pointer] ->
+        if mode < 0 || mode > 3 then E.return false else
+        (match pointer with
+          | A.AnnotatedExpression _ _ _ (A.AilErvalue
+              (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand)) ->
+              let (qs, ty) = qualified_ctype_of operand in
+              if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+                  not (AilTypesAux.is_pointer ty) then E.return false else
+              E.gnu_branch_parameter_subject_allowed sym >>= fun parameter ->
+              E.gnu_branch_subject_allowed sym >>= fun unchanged ->
+              E.return (parameter && unchanged)
+          | _ -> E.return false end)
+    | A.AilEbinary left (A.Arithmetic A.Div) right ->
+        (* A positive constant divisor excludes both division by zero and
+           signed MIN / -1. Operands still require independent totality. *)
+        if maybe false (fun value -> value > 0) (gnu_scalar_closed_integer tagDefs right)
+        then both left right else E.return false
+    | A.AilEbinary left bop right ->
+        if bop = A.And || bop = A.Or || gnu_scalar_is_relation bop ||
+            bop = A.Arithmetic A.Band || bop = A.Arithmetic A.Bor || bop = A.Arithmetic A.Bxor
+        then both left right else E.return false
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | _ -> E.return false
+  end
+
+(* Ignore locations only, never types, expression annotations, call operands or
+   their order. This comparison does not assert that the return itself is pure:
+   the shared return executes once, with its original effects and failures. *)
+val gnu_same_return_expression:
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_same_return_expression
+    (A.AnnotatedExpression first_ty first_annots _ first)
+    (A.AnnotatedExpression second_ty second_annots _ second) =
+  let self = gnu_same_return_expression in
+  first_ty = second_ty && first_annots = second_annots && match (first, second) with
+    | (A.AilEident a, A.AilEident b) -> a = b
+    | (A.AilEconst a, A.AilEconst b) -> a = b
+    | (A.AilEbuiltin a, A.AilEbuiltin b) -> a = b
+    | (A.AilErvalue a, A.AilErvalue b) -> self a b
+    | (A.AilEfunction_decay a, A.AilEfunction_decay b) -> self a b
+    | (A.AilEcast aq at a, A.AilEcast bq bt b) -> aq = bq && at = bt && self a b
+    | (A.AilEannot at a, A.AilEannot bt b) -> at = bt && self a b
+    | (A.AilEcall ac aa, A.AilEcall bc ba) ->
+        self ac bc && List.length aa = List.length ba &&
+          List.all (fun (a, b) -> self a b) (List.zip aa ba)
+    | _ -> false
+  end
+
+(* Identical external calls can share one continuation even when declarations
+   use different C names for the same assembler symbol. This is equality of
+   the actual runtime call, not an inference about a compiler-query answer or
+   equivalence between checked and unchecked library functions. *)
+val gnu_same_external_return_call:
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  E.elabM bool
+let gnu_same_external_return_call
+    (A.AnnotatedExpression first_ty first_annots _ first as first_expr)
+    (A.AnnotatedExpression second_ty second_annots _ second as second_expr) =
+  if first_annots <> second_annots ||
+      not (gnu_function_target_type_equal (ctype_of first_expr) (ctype_of second_expr))
+  then E.return false else match (first, second) with
+    | (A.AilEcall first_callee first_args, A.AilEcall second_callee second_args) ->
+        if not (gnu_inline_direct_designator first_callee &&
+            gnu_inline_direct_designator second_callee &&
+            gnu_function_target_type_equal (ctype_of first_callee) (ctype_of second_callee)) ||
+            List.length first_args <> List.length second_args ||
+            not (List.all (fun (a,b) -> gnu_same_return_expression a b)
+              (List.zip first_args second_args))
+        then E.return false else
+        gnu_inline_function_target first_callee >>= fun first_target ->
+        gnu_inline_function_target second_callee >>= fun second_target ->
+        (match (first_target, second_target) with
+          | (Just (first, _), Just (second, _)) ->
+              E.has_external_linker_name first >>= fun first_external ->
+              E.has_external_linker_name second >>= fun second_external ->
+              E.gnu_inline_target first >>= fun first_body ->
+              E.gnu_inline_target second >>= fun second_body ->
+              E.gnu_has_source_definition first_body >>= fun first_defined ->
+              E.gnu_has_source_definition second_body >>= fun second_defined ->
+              if not (first_external && second_external) || first_defined || second_defined
+              then E.return false else
+              E.linker_name first >>= fun first_name ->
+              E.linker_name second >>= fun second_name ->
+              E.return (isJust first_name && first_name = second_name)
+          | _ -> E.return false end)
+    | _ -> E.return false
+  end
+
+val translate_expression:
+  maybe (
+    (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+    A.bindings -> list (A.statement GenTypes.genTypeCategory) -> E.elabM (C.expr unit)
+  ) ->
+  bool -> (* whether the value of the expression is used (i.e. the expression is directly applied to AilSexpr) *)
+  expr_ctx ->
+  (maybe Symbol.sym * maybe Symbol.sym) ->
+  translation_stdlib ->
+  Core.core_tag_definitions ->
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (C.expr unit)
+(* All size expressions in one complete declarator share one full-expression
+   boundary. They are not individually bounded or arbitrarily sequenced.
+   Temporary aggregate objects retain the existing full-expression lifetime. *)
+let wrapped_translate_vla_bounds translate_bound loc operands =
+  let translate_one operand =
+    gnu_memory_prepare_expression operand >> translate_bound operand in
+  let translate_all = match operands with
+    | [] -> E.return []
+    | [operand] -> E.mapM translate_one [operand]
+    | _ -> E.without_gnu_flow_facts (E.mapM translate_one operands)
+  end in
+  E.track_temporary_objects
+    translate_all
+    >>= fun (temporaries, expressions) ->
+  let result_ty = match operands with
+    | [] -> C.BTy_unit
+    | [_] -> C.BTy_loaded C.OTy_integer
+    | _ -> C.BTy_tuple (List.map (fun _ -> C.BTy_loaded C.OTy_integer) operands)
+  end in
+  let core = C.Expr [Annot.Astd "Â§6.7.6#3"] (C.Ebound (Caux.mk_unseq expressions)) in
+  if List.null temporaries then E.return (result_ty, core) else
+  E.wrapped_fresh_symbol result_ty >>= fun result ->
+  let creates_kills = List.map (fun (pointer, ty) ->
+    let cty = Caux.mk_ail_ctype_pe ty in
+    ((pointer.E.sym_pat, Caux.pcreate loc (Caux.mk_alignof_pe cty) cty
+        (Symbol.PrefTemporaryLifetime loc (Symbol.digest_of_sym pointer.E.sym_sym))),
+     Caux.pkill loc (C.Static ty) pointer.E.sym_pe)) temporaries in
+  E.return (result_ty, Caux.mk_sseqs (List.map fst creates_kills)
+    (Caux.mk_sseq_e result.E.sym_pat core
+      (Caux.mk_unit_sseq (List.map snd creates_kills) (Caux.mk_pure_e result.E.sym_pe))))
+
+(* A VLA key is immutable, but a wide entry range is not permanent evidence of
+   variation: a later source guard may refine it. Retain only key-to-parameter
+   equalities proved for this entire scope, with existing source range facts
+   restored in revocable flow state. Whole-function address confinement rules
+   out a source pointer published before entry; scope immutability rules out
+   later writes. Missing certificates and general bound expressions decline. *)
+val gnu_vla_parameter_relations:
+  Symbol.sym -> list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (list (Symbol.sym * E.gnu_inline_fact) * list (Symbol.sym * E.gnu_inline_fact))
+let gnu_vla_parameter_relations function_sym captures body =
+  E.function_attributes function_sym >>= fun attrs ->
+  if not (Cerb_attributes.has_gnu_noarg_attribute "noipa" attrs &&
+      List.length captures = 1 &&
+      List.all (fun (_, bound) -> gnu_memory_expression_readonly bound) captures)
+  then E.return ([], []) else
+  E.gnu_current_parameter_subjects >>= fun parameters ->
+  E.mapM (fun (key, origin) -> match origin with
+    | A.AnnotatedExpression _ _ _ (A.AilErvalue
+        (A.AnnotatedExpression _ _ _ (A.AilEident source) as object_)) ->
+        let (qs, ty) = qualified_ctype_of object_ in
+        if not (List.elem source parameters && AilTypesAux.is_integer ty &&
+            not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+            gnu_inline_parameter_unchanged source body &&
+            gnu_alloc_size_subject_unescaped source body &&
+            List.all (fun (_, bound) -> gnu_inline_parameter_expression_safe source bound) captures)
+        then E.return Nothing else
+        E.gnu_alloc_size_subject_allowed source >>= fun confined ->
+        if not confined then E.return Nothing else
+        E.gnu_compiler_fact source >>= fun fact ->
+        E.return (match fact with
+          | Just fact -> if E.gnu_is_scalar_range fact
+              then Just ((key, E.GNU_inline_integer_fact origin), (source, fact))
+              else Nothing
+          | Nothing -> Nothing end)
+    | _ -> E.return Nothing end) captures >>= fun relations ->
+  E.return (List.unzip (List.foldr (fun item rest ->
+    maybe rest (fun relation -> relation :: rest) item) [] relations))
+
+(* Bound translation precedes body translation in the elaboration state as well
+   as execution. The body may return a GNU statement-expression value; this
+   wrapper never replaces that value with unit. *)
+let wrapped_translate_vla_scope translate_bound loc captures checked relations source_facts body_action =
+  E.clear_gnu_flow_facts >> E.clear_gnu_memory_facts >>
+  wrapped_translate_vla_bounds translate_bound loc (List.map snd captures)
+    >>= fun (capture_ty, capture_code) ->
+  E.clear_gnu_flow_facts >> E.clear_gnu_memory_facts >>
+  E.with_gnu_closed_parameters relations
+    (E.mapM_ (fun (source, fact) -> E.register_gnu_flow_fact source fact) source_facts >>
+      body_action) >>= fun body_code ->
+  let scoped_body = Vla_core.vla_capture_scope (List.map fst captures) body_code in
+  let checked_body = Caux.mk_sseqs (List.map (fun ty ->
+    (Caux.mk_empty_pat C.BTy_ctype, Caux.mk_pure_e (Caux.mk_ail_ctype_pe ty))) checked) scoped_body in
+  if List.null captures then E.return checked_body else
+  E.wrapped_fresh_symbol capture_ty >>= fun captured ->
+  let captured_pattern = Caux.mk_tuple_pat (List.map (fun (symbol, _) ->
+    Caux.mk_specified_pat (Caux.mk_sym_pat symbol (C.BTy_object C.OTy_integer))) captures) in
+  E.return (Caux.mk_sseq_e captured.E.sym_pat capture_code
+    (Caux.mk_case_e captured.E.sym_pe
+      [(captured_pattern, checked_body);
+       (Caux.mk_empty_pat capture_ty, Caux.mk_pure_e (Caux.mk_error_pe
+         "unspecified VLA bound requires nondeterministic extent support" Caux.mk_unit_pe))]))
+
+let rec translate_expression translate_block_opt is_used ctx variadic_env stdlib tagDefs a_expr =
+  let self = translate_expression translate_block_opt true ctx variadic_env stdlib tagDefs in
+  let translate_expression = translate_expression translate_block_opt in
+  let is_lvalue = match GenTypes.genTypeCategoryOf a_expr with
+    | GenTypes.GenLValueType _ _ _ ->
+        true
+    | GenTypes.GenRValueType _ ->
+        false
+  end in
+  let integer_promotion_and_type (ty: Ctype.ctype) : (C.pexpr -> C.pexpr) * Ctype.integerType =
+    let promoted_ty = fromJust "Translation_aux.integer_promotion" (AilTypesAux.promotion (Implementation.integerImpl ()) ty) in
+    let promoted_ity = match promoted_ty with
+      | Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity)) -> ity
+      | _ -> Assert_extra.failwith "impossible"
+    end in
+    (stdlib.mkcall_conv_int promoted_ty, promoted_ity) in
+  let integer_promotion ty e =
+    let (mk_conversion, promoted_type) = integer_promotion_and_type ty in
+    mk_conversion e in
+  (* STD Â§6.3.1.8 *)
+  let usual_arithmetic_conversion_aux is_TMP_new (ty1: Ctype.ctype) (ty2: Ctype.ctype) (e1: C.pexpr) (e2: C.pexpr) : C.pexpr * C.pexpr =
+    match (AilTypesAux.corresponding_real_type ty1, AilTypesAux.corresponding_real_type ty2) with
+      | (Just fty1, Just fty2) ->
+          let common = if fty1 = Ctype.LongDouble || fty2 = Ctype.LongDouble then Ctype.LongDouble
+            else if fty1 = Ctype.Double || fty2 = Ctype.Double then Ctype.Double else Ctype.Float in
+          let type_pe = Caux.mk_ail_ctype_pe (Ctype.Ctype [] (Ctype.Basic (Ctype.Floating (Ctype.RealFloating common)))) in
+          (C.Pexpr [] () (C.PEctor C.Cfvconvert [type_pe; e1]),
+           C.Pexpr [] () (C.PEctor C.Cfvconvert [type_pe; e2]))
+      | (Just fty, _) ->
+          let type_pe = Caux.mk_ail_ctype_pe (Ctype.Ctype [] (Ctype.Basic (Ctype.Floating (Ctype.RealFloating fty)))) in
+          (e1, C.Pexpr [] () (C.PEctor C.Cfvfromint_typed [type_pe; e2]))
+      | (_, Just fty) ->
+          let type_pe = Caux.mk_ail_ctype_pe (Ctype.Ctype [] (Ctype.Basic (Ctype.Floating (Ctype.RealFloating fty)))) in
+          (C.Pexpr [] () (C.PEctor C.Cfvfromint_typed [type_pe; e1]), e2)
+      | (Nothing, Nothing) ->
+          let mk_conv_int ity pe =
+            if is_TMP_new then
+              Caux.mk_conv_int_pe ity pe
+            else
+              stdlib.mkcall_conv_int (Ctype.Ctype [] (Ctype.Basic (Ctype.Integer ity))) pe in
+          (* STD Â§6.3.1.8#1, bullet 4 *)
+          match (AilTypesAux.promotion (Implementation.integerImpl ()) ty1, AilTypesAux.promotion (Implementation.integerImpl ()) ty2) with
+            | (Just (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity1')) as ty1'), Just (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity2')) as ty2')) ->
+                (* "If both operants have the same type, then no further conversion is needed." *)
+                if ty1' = ty2' then
