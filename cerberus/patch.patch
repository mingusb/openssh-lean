+    | C.PEval value -> Just value
+    | C.PEsym sym -> List.lookup sym env
+    | C.PEif condition yes no -> (match self condition with
+        | Just C.Vtrue -> self yes | Just C.Vfalse -> self no | _ -> Nothing end)
+    | C.PEnot operand -> (match self operand with
+        | Just C.Vtrue -> Just C.Vfalse | Just C.Vfalse -> Just C.Vtrue | _ -> Nothing end)
+    | C.PEop bop left right -> (match (self left, self right) with
+        | (Just left, Just right) -> gnu_scalar_core_binary bop left right | _ -> Nothing end)
+    | C.PEctor C.Ctuple operands ->
+        maybe Nothing (fun values -> Just (C.Vtuple values))
+          (List.foldr (fun operand tail -> match (self operand, tail) with
+            | (Just value, Just values) -> Just (value :: values) | _ -> Nothing end) (Just []) operands)
+    | C.PEctor C.Cspecified [operand] -> (match self operand with
+        | Just (C.Vobject value) -> Just (C.Vloaded (C.LVspecified value)) | _ -> Nothing end)
+    | C.PEctor C.Civsizeof [operand] -> (match self operand with
+        | Just (C.Vctype ty) -> maybe Nothing (fun n -> Just (gnu_scalar_core_number n)) (gnu_scalar_sizeof tagDefs ty)
+        | _ -> Nothing end)
+    | C.PEctor C.Civmax [operand] -> (match self operand with
+        | Just (C.Vctype ty) -> maybe Nothing (fun (_, n) -> Just (gnu_scalar_core_number n)) (gnu_scalar_type_bounds ty)
+        | _ -> Nothing end)
+    | C.PEctor C.Civmin [operand] -> (match self operand with
+        | Just (C.Vctype ty) -> maybe Nothing (fun (n, _) -> Just (gnu_scalar_core_number n)) (gnu_scalar_type_bounds ty)
+        | _ -> Nothing end)
+    | C.PEconv_int ity operand -> (match self operand with
+        | Just value -> maybe Nothing (fun number ->
+            maybe Nothing (fun (n, _, _) -> Just (gnu_scalar_core_number n))
+              (gnu_scalar_cast (Ctype.Ctype [] (Ctype.Basic (Ctype.Integer ity))) (number, number, true)))
+            (gnu_scalar_core_integer value)
+        | _ -> Nothing end)
+    | C.PElet pattern operand body -> (match self operand with
+        | Just value -> (match Caux.match_pattern pattern value with
+            | Just bindings -> gnu_scalar_core_formula tagDefs (bindings ++ env) body
+            | Nothing -> Nothing end)
+        | Nothing -> Nothing end)
+    | C.PEcase operand alternatives -> (match self operand with
+        | Just value -> List.foldr (fun (pattern, body) next ->
+            match Caux.match_pattern pattern value with
+              | Just bindings -> gnu_scalar_core_formula tagDefs (bindings ++ env) body
+              | Nothing -> next end) Nothing alternatives
+        | Nothing -> Nothing end)
+    | _ -> Nothing
+  end
+
+(* This gate also excludes Core_aux.to_pure's fail-stop Eannot/Eexcluded
+   cases. Failed projection is an analysis gap, never a replacement value. *)
+val gnu_scalar_core_is_pure: C.expr unit -> bool
+let rec gnu_scalar_core_is_pure (C.Expr _ node) = match node with
+  | C.Epure _ -> true
+  | C.Elet _ _ body -> gnu_scalar_core_is_pure body
+  | C.Eif _ yes no -> gnu_scalar_core_is_pure yes && gnu_scalar_core_is_pure no
+  | C.Ewseq _ first second -> gnu_scalar_core_is_pure first && gnu_scalar_core_is_pure second
+  | C.Esseq _ first second -> gnu_scalar_core_is_pure first && gnu_scalar_core_is_pure second
+  | C.Eunseq operands -> List.all gnu_scalar_core_is_pure operands
+  | C.Ebound body -> gnu_scalar_core_is_pure body
+  | C.Ecase _ alternatives -> List.all (fun (_, body) -> gnu_scalar_core_is_pure body) alternatives
+  | _ -> false
+end
+
+val gnu_scalar_closed_integer:
+  Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> maybe integer
+let rec gnu_scalar_closed_integer tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_scalar_closed_integer tagDefs in
+  let cast number = maybe Nothing (fun (value, _, _) -> Just value)
+    (gnu_scalar_cast (ctype_of expr) (number, number, true)) in
+  match node with
+    | A.AilEconst (A.ConstantInteger (A.IConstant number _ _)) -> cast number
+    | A.AilEsizeof _ ty -> gnu_scalar_sizeof tagDefs ty
+    | A.AilEsizeof_expr operand -> gnu_scalar_sizeof tagDefs (ctype_of operand)
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> maybe Nothing cast (self operand)
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> maybe Nothing
+        (fun value -> maybe Nothing (fun (number, _, _) -> Just number)
+          (gnu_scalar_arithmetic_range (ctype_of expr) (0-value, 0-value, true))) (self operand)
+    | A.AilEbinary left bop right ->
+      let convert common value = maybe Nothing (fun number ->
+        maybe Nothing (fun (n, _, _) -> Just n) (gnu_scalar_cast common (number, number, true))) value in
+      let operands = match gnu_scalar_common_type (ctype_of left) (ctype_of right) with
+        | Just common -> (convert common (self left), convert common (self right))
+        | Nothing -> (Nothing, Nothing) end in
+      (match operands with
+        | (Just first, Just second) ->
+            let checked value = maybe Nothing (fun (n, _, _) -> Just n)
+              (gnu_scalar_arithmetic_range (ctype_of expr) (value, value, true)) in
+            (match bop with
+              | A.Arithmetic A.Add -> checked (first+second)
+              | A.Arithmetic A.Sub -> checked (first-second)
+              | A.Arithmetic A.Mul -> checked (first*second)
+              | A.Arithmetic A.Div -> maybe Nothing (fun (q, _) -> Just q)
+                  (gnu_scalar_integer_division (ctype_of expr) first second)
+              | A.Arithmetic A.Mod -> maybe Nothing (fun (_, r) -> Just r)
+                  (gnu_scalar_integer_division (ctype_of expr) first second)
+              | A.Eq -> checked (if first = second then 1 else 0)
+              | A.Ne -> checked (if first <> second then 1 else 0)
+              | A.Lt -> checked (if first < second then 1 else 0)
+              | A.Le -> checked (if first <= second then 1 else 0)
+              | A.Gt -> checked (if first > second then 1 else 0)
+              | A.Ge -> checked (if first >= second then 1 else 0)
+              | _ -> Nothing end)
+        | _ -> Nothing end)
+    | _ -> Nothing
+  end
+
+(* Implementation aliases such as size_t retain the underlying integer
+   representation. This does not identify merely equal-width signed/unsigned
+   types, and preserves every annotation checked by value-type compatibility. *)
+val gnu_scalar_implementation_type_equal: Ctype.ctype -> Ctype.ctype -> bool
+let gnu_scalar_implementation_type_equal left right =
+  gnu_scalar_value_type_equal left right ||
+  match (left, right) with
+    | (Ctype.Ctype la (Ctype.Basic (Ctype.Integer li)),
+       Ctype.Ctype ra (Ctype.Basic (Ctype.Integer ri))) ->
+        gnu_scalar_value_type_equal
+          (Ctype.Ctype la (Ctype.Basic (Ctype.Integer (Implementation.normalise_integerType li))))
+          (Ctype.Ctype ra (Ctype.Basic (Ctype.Integer (Implementation.normalise_integerType ri))))
+    | _ -> false
+  end
+
+val gnu_alloc_size_dependencies:
+  A.expression GenTypes.genTypeCategory -> maybe (list (Symbol.sym * Ctype.ctype))
+let rec gnu_alloc_size_dependencies (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_alloc_size_dependencies in
+  let (qs, ty) = qualified_ctype_of expr in
+  if not (AilTypesAux.is_integer ty) || qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      gnu_size_effects expr <> Just false then Nothing else
+  if gnu_inline_closed_integer_origin expr then Just [] else match node with
+    | A.AilEident sym -> Just [(sym, ty)]
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident _) as operand) -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEbinary left (A.Arithmetic _) right ->
+        (match (self left, self right) with
+          | (Just first, Just second) -> Just (first ++ second)
+          | _ -> Nothing end)
+    | _ -> Nothing
+  end
+
+(* Dependent integer metadata is permitted only over immutable specialization
+   formals. Ordinary local/member snapshots still require closed expressions. *)
+val gnu_scalar_origin_live:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_scalar_origin_live origin =
+  if gnu_inline_closed_integer_origin origin then E.return true else
+  if gnu_size_effects origin <> Just false then E.return false else
+  E.gnu_current_parameter_subjects >>= fun parameters ->
+  E.return (match gnu_alloc_size_dependencies origin with
+    | Just reads -> reads <> [] && List.all (fun (sym, _) -> List.elem sym parameters) reads
+    | Nothing -> false end)
+
+(* Analysis-only projection of a saved dynamic bound. A closed whole-object
+   extent with an unsigned byte offset has exactly the same boundary clamp as
+   translate_gnu_object_size. Subobject modes, negative/multibyte offsets and
+   nonclosed base formulas retain the ordinary query path. *)
+val gnu_allocation_bound_expression:
+  bool -> Core.core_tag_definitions -> integer -> E.gnu_inline_fact ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_allocation_bound_expression include_offsets tagDefs mode fact = match fact with
+  | E.GNU_inline_alloc_size_fact _ value -> Just value
+  | E.GNU_inline_constant_alloc_size_fact value -> Just value
+  | E.GNU_inline_dynamic_bound_fact saved -> gnu_allocation_bound_expression include_offsets tagDefs mode saved
+  | E.GNU_inline_counted_extent_fact _ exact -> gnu_allocation_bound_expression include_offsets tagDefs mode exact
+  | E.GNU_inline_offset_extent_fact
+      (E.GNU_inline_extent_fact false _ _ extent _) index element_ty false _ ->
+      if not include_offsets || (mode <> 0 && mode <> 2) || gnu_scalar_sizeof tagDefs element_ty <> Just 1 ||
+          not (gnu_scalar_core_is_pure extent) || gnu_size_effects index <> Just false
+      then Nothing else
+      (match (Caux.to_pure extent, gnu_scalar_type_bounds (ctype_of index),
+          gnu_scalar_type_bounds Ctype.size_t) with
+        | (Just formula, Just (low, high), Just (minimum, maximum)) ->
+            if minimum <> 0 || low < 0 || high > maximum then Nothing else
+            (match gnu_scalar_core_formula tagDefs [] formula with
+              | Just (C.Vtuple [size; offset; _; _; _; _; _; _; _; _; _; _]) ->
+                  (match (gnu_scalar_core_integer size, gnu_scalar_core_integer offset) with
+                    | (Just size, Just offset) ->
+                        if offset < 0 || size < offset || size > maximum then Nothing else
+                        let loc = Loc.locOf index in
+                        let typed ty node = A.AnnotatedExpression
+                          (GenTypes.GenRValueType (GenTypes.inject_type ty)) [] loc node in
+                        let constant n = typed Ctype.size_t
+                          (A.AilEconst (A.ConstantInteger (A.IConstant n A.Decimal Nothing))) in
+                        let index = typed Ctype.size_t (A.AilEcast Ctype.no_qualifiers Ctype.size_t index) in
+                        let bound = constant (size-offset) in
+                        let test = typed Ctype.signed_int (A.AilEbinary index A.Ge bound) in
+                        Just (typed Ctype.size_t (A.AilEcond test (Just (constant 0))
+                          (typed Ctype.size_t (A.AilEbinary bound (A.Arithmetic A.Sub) index))))
+                    | _ -> Nothing end)
+              | _ -> Nothing end)
+        | _ -> Nothing end)
+  | _ -> Nothing
+end
+
+val gnu_dynamic_bound_expression:
+  bool -> Core.core_tag_definitions -> integer -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (A.expression GenTypes.genTypeCategory))
+let rec gnu_dynamic_bound_expression include_offsets tagDefs mode (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not (AilTypesAux.is_pointer ty) || gnu_size_effects expr <> Just false
+        then E.return Nothing else
+        (match operand with
+          | A.AnnotatedExpression _ _ _ (A.AilEident sym) -> E.gnu_compiler_fact sym
+          | _ -> gnu_loaded_memory_fact operand end) >>= function
+          | Nothing -> E.return Nothing
+          | Just fact ->
+              E.get_visible_objects >>= fun visible ->
+              E.gnu_current_parameter_subjects >>= fun parameters ->
+              E.return (if gnu_inline_fact_scope_live (visible ++ parameters) fact
+                then gnu_allocation_bound_expression include_offsets tagDefs mode fact else Nothing)
+        end
+    | A.AilEannot _ operand -> gnu_dynamic_bound_expression include_offsets tagDefs mode operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+        then gnu_dynamic_bound_expression include_offsets tagDefs mode operand else E.return Nothing
+    | _ -> E.return Nothing
+  end
+
+(* Substitute only closed compiler metadata from parameter bindings or local
+   initializer snapshots. Runtime calls and initializers still evaluate through
+   their ordinary paths. Preserve conversions and reject unknown/volatile origins. *)
+val resolve_gnu_value_origins:
+  bool -> Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM (A.expression GenTypes.genTypeCategory)
+let rec resolve_gnu_value_origins include_offsets tagDefs (A.AnnotatedExpression ty annots loc expr as e) =
+  let self = resolve_gnu_value_origins include_offsets tagDefs in
+  let rebuild node = A.AnnotatedExpression ty annots loc node in
+  match expr with
+    | A.AilEsizeof_expr operand ->
+        if gnu_inline_fixed_object_type (ctype_of operand) then
+          E.return (rebuild (A.AilEsizeof Ctype.no_qualifiers (ctype_of operand)))
+        else E.return e
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (qs, operand_ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic operand_ty then E.return e
+        else E.gnu_compiler_fact sym >>= function
+          | Just (E.GNU_inline_integer_fact origin) ->
+              gnu_scalar_origin_live origin >>= fun live ->
+              if not live then E.return e else
+              self origin >>= fun resolved ->
+              E.return (rebuild (A.AilEcast Ctype.no_qualifiers (ctype_of e) resolved))
+          | _ -> E.gnu_const_pointer_origin sym >>= function
+              | Nothing -> E.return e
+              | Just origin -> self origin >>= fun resolved ->
+                  if gnu_constant_p_classify tagDefs resolved = Just true then
+                    E.return (rebuild (A.AilEcast Ctype.no_qualifiers (ctype_of e) resolved))
+                  else E.return e
+            end
+        end
+    | A.AilErvalue operand ->
+        let (qs, operand_ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic operand_ty then E.return e else
+          gnu_loaded_memory_fact operand >>= function
+            | Just (E.GNU_inline_integer_fact origin) -> self origin >>= fun resolved ->
+                if gnu_constant_p_classify tagDefs resolved = Just true then
+                  E.return (rebuild (A.AilEcast Ctype.no_qualifiers (ctype_of e) resolved))
+                else E.return e
+            | _ -> E.return e
+          end
+    | A.AilEcall (A.AnnotatedExpression callee_ty callee_annots callee_loc
+        (A.AilEbuiltin (A.AilBGNU_object_size true mode))) [operand] ->
+        (* Only the unevaluated constant query uses this classification.
+           Ordinary dynamic-size calls retain their original execution. *)
+        gnu_dynamic_bound_expression include_offsets tagDefs mode operand >>= function
+          | Just bound ->
+              if mode < 0 || mode > 3 || gnu_size_effects bound <> Just false
+              then E.return e else
+              E.return (if gnu_function_target_type_equal (ctype_of e) (ctype_of bound)
+                then bound else rebuild (A.AilEcast Ctype.no_qualifiers (ctype_of e) bound))
+          | Nothing ->
+              gnu_inline_closed_size_origin false [] false operand >>= fun closed ->
+              if closed && gnu_size_effects operand = Just false then
+                E.return (rebuild (A.AilEcall
+                  (A.AnnotatedExpression callee_ty callee_annots callee_loc
+                    (A.AilEbuiltin (A.AilBGNU_object_size false mode))) [operand]))
+              else E.return e
+        end
+    | A.AilEannot ct operand -> self operand >>= fun operand -> E.return (rebuild (A.AilEannot ct operand))
+    | A.AilEcast qs ct operand -> self operand >>= fun operand -> E.return (rebuild (A.AilEcast qs ct operand))
+    | A.AilEunary uop operand -> self operand >>= fun operand -> E.return (rebuild (A.AilEunary uop operand))
+    | A.AilEbinary left bop right ->
+        self left >>= fun left -> self right >>= fun right -> E.return (rebuild (A.AilEbinary left bop right))
+    | A.AilEcond condition yes no ->
+        self condition >>= fun condition ->
+        (match yes with Nothing -> E.return Nothing | Just operand -> self operand >>= fun operand -> E.return (Just operand) end) >>= fun yes ->
+        self no >>= fun no -> E.return (rebuild (A.AilEcond condition yes no))
+    | _ -> E.return e
+  end
+
+(* A late dynamic-size bound can prove a runtime predicate without proving
+   GCC folds that predicate at constant_p's earlier stage. Keep these contexts
+   separate; a failed compiler-query classification remains an explicit gap. *)
+val resolve_gnu_constant_origins:
+  Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (A.expression GenTypes.genTypeCategory)
+let resolve_gnu_constant_origins tagDefs expr =
+  resolve_gnu_value_origins false tagDefs expr
+
+(* Reduce only value-preserving integer identities before comparing origins.
+   This lets n <= dynamic_size(p)/sizeof(char) observe a saved n relationship.
+   Runtime expressions are unchanged; narrowing casts, effects and arithmetic
+   that might overflow do not enter this normalization. *)
+val gnu_scalar_identity_origin:
+  Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory
+let rec gnu_scalar_identity_origin tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_scalar_identity_origin tagDefs in
+  let keep operand = if gnu_scalar_implementation_type_equal (ctype_of expr) (ctype_of operand)
+    then self operand else expr in
+  if not (AilTypesAux.is_integer (ctype_of expr)) || gnu_size_effects expr <> Just false
+  then expr else match node with
+    | A.AilEannot _ operand -> keep operand
+    | A.AilEunary A.Plus operand -> keep operand
+    | A.AilEcast _ _ operand -> keep operand
+    | A.AilEbinary left (A.Arithmetic A.Div) right ->
+        if gnu_scalar_closed_integer tagDefs right = Just 1 then keep left else expr
+    | A.AilEbinary left (A.Arithmetic A.Add) right ->
+        if gnu_scalar_closed_integer tagDefs right = Just 0 then keep left
+        else if gnu_scalar_closed_integer tagDefs left = Just 0 then keep right else expr
+    | A.AilEbinary left (A.Arithmetic A.Sub) right ->
+        if gnu_scalar_closed_integer tagDefs right = Just 0 then keep left else expr
+    | A.AilEbinary left (A.Arithmetic A.Mul) right ->
+        if gnu_scalar_closed_integer tagDefs right = Just 1 then keep left
+        else if gnu_scalar_closed_integer tagDefs left = Just 1 then keep right else expr
+    | _ -> expr
+  end
+
+(* A comparison selecting its own operands is an extremum, even when the
+   input ranges are only overapproximations. Require the comparison and result
+   to use the same integer representation. Repeated reads must be stable; the
+   caller separately rejects all effects in the complete conditional. *)
+val gnu_scalar_conditional_minimum:
+  Core.core_tag_definitions -> Ctype.ctype -> A.expression GenTypes.genTypeCategory ->
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory -> maybe bool
+let rec gnu_scalar_conditional_minimum tagDefs result_ty
+    (A.AnnotatedExpression _ _ _ node) first second =
+  let same_type = gnu_scalar_implementation_type_equal in
+  let same left right =
+    gnu_scalar_same_origin (gnu_scalar_identity_origin tagDefs left)
+      (gnu_scalar_identity_origin tagDefs right) ||
+    (match (gnu_scalar_closed_integer tagDefs left, gnu_scalar_closed_integer tagDefs right) with
+      | (Just a, Just b) -> a = b && same_type (ctype_of left) (ctype_of right)
+      | _ -> false end) in
+  match node with
+    | A.AilEannot _ nested -> gnu_scalar_conditional_minimum tagDefs result_ty nested first second
+    | A.AilEbinary left bop right ->
+        let lesser = bop = A.Lt || bop = A.Le in
+        let greater = bop = A.Gt || bop = A.Ge in
+        if not (lesser || greater) then Nothing else
+        match gnu_scalar_common_type (ctype_of left) (ctype_of right) with
+          | Just common ->
+              if not (same_type result_ty common) then Nothing
+              else if same first left && same second right then Just lesser
+              else if same first right && same second left then Just greater
+              else Nothing
+          | Nothing -> Nothing
+        end
+    | _ -> Nothing
+  end
+
+(* Labels in GNU statement expressions may be entered without evaluating a
+   surrounding condition. Only omit expression arms with no such entry. This
+   is not a purity test: effects in an unreachable arm are never evaluated. *)
+val gnu_dead_arm_expression_closed: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_dead_arm_expression_closed (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_dead_arm_expression_closed in
+  match node with
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEassign left right -> self left && self right
+    | A.AilEcompoundAssign left _ right -> self left && self right
+    | A.AilEcond condition yes no -> self condition && maybe true self yes && self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEcall callee args -> self callee && List.all self args
+    | A.AilEassert operand -> self operand
+    | A.AilEarray _ _ elements -> List.all (maybe true self) elements
+    | A.AilEstruct _ members -> List.all (fun (_, value) -> maybe true self value) members
+    | A.AilEunion _ _ value -> maybe true self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEsizeof_expr operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEva_start operand _ -> self operand
+    | A.AilEva_arg operand _ -> self operand
+    | A.AilEva_copy left right -> self left && self right
+    | A.AilEva_end operand -> self operand
+    | A.AilEprint_type operand -> self operand
+    | A.AilEbmc_assume operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEatomic operand -> self operand
+    | A.AilEbuiltin _ -> true
+    | A.AilEstr _ -> true
+    | A.AilEconst _ -> true
+    | A.AilEident _ -> true
+    | A.AilEsizeof _ _ -> true
+    | A.AilEalignof _ _ -> true
+    | A.AilEoffsetof _ _ -> true
+    | A.AilEreg_load _ -> true
+    | _ -> false
+  end
+
+val gnu_scalar_object_size:
+  Core.core_tag_definitions -> bool -> integer -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe integer)
+let gnu_scalar_object_size tagDefs dynamic mode pointer =
+  let action =
+    gnu_inline_closed_size_origin (not dynamic) [] false pointer >>= fun closed ->
+    if mode < 0 || mode > 3 || (dynamic && not closed) then E.return Nothing else
+    let offset expr = resolve_gnu_constant_origins tagDefs expr >>= fun resolved ->
+      E.return (match gnu_scalar_closed_integer tagDefs resolved with
+        | Just number -> Caux.mk_pure_e (Caux.mk_specified_pe (Caux.mk_integer_pe number))
+        | Nothing -> Caux.mk_pure_e (Caux.mk_error_pe "nonconstant extent offset" Caux.mk_unit_pe)
+      end) in
+    translate_gnu_object_size offset tagDefs dynamic mode pointer >>= fun expression ->
+    E.return (if not (gnu_scalar_core_is_pure expression) then Nothing else
+      match Caux.to_pure expression with
+        | Just pure_expression -> (match gnu_scalar_core_formula tagDefs [] pure_expression with
+            | Just (C.Vloaded (C.LVspecified (C.OVinteger number))) -> Mem.eval_integer_value number
+            | _ -> Nothing end)
+        | Nothing -> Nothing end)
+  in
+  (* Optional analysis has no emitted code or surviving fresh symbols. Preserve
+     metadata while advancing fresh supply consistently with OCaml's ambient
+     mint. Decline if the ordinary lowering reported a gap.
+     Ordinary execution/translation of the source query still uses its full
+     checked path and diagnostics. *)
+  fun state -> let (value, next) = action state in
+    (if next.E.errors = state.E.errors then value else Nothing,
+     <| state with E.fresh_supply= next.E.fresh_supply |>)
+
+val gnu_scalar_truth: gnu_scalar_knowledge -> gnu_scalar_knowledge
+let gnu_scalar_truth (low, high, dense) =
+  if low = 0 && high = 0 then (0, 0, true)
+  else if low > 0 || high < 0 then (1, 1, true)
+  else (0, 1, dense)
+
+val gnu_scalar_logic:
+  bool -> maybe gnu_scalar_knowledge -> maybe gnu_scalar_knowledge -> maybe gnu_scalar_knowledge
+let gnu_scalar_logic conjunction first second =
+  let first = maybe Nothing (fun info -> Just (gnu_scalar_truth info)) first in
+  let second = maybe Nothing (fun info -> Just (gnu_scalar_truth info)) second in
+  let absorbing = if conjunction then 0 else 1 in
+  let neutral = 1-absorbing in
+  match (first, second) with
+    | (Just (low, high, _), _) ->
+        if low = high && low = absorbing then gnu_scalar_singleton absorbing
+        else if low = high && low = neutral then second else
+          (match second with
+            | Just (a, b, _) -> if a = b && a = absorbing then gnu_scalar_singleton absorbing
+                else if a = b && a = neutral then first else Just (0, 1, false)
+            | Nothing -> Just (0, 1, false) end)
+    | (_, Just (low, high, _)) ->
+        if low = high && low = absorbing then gnu_scalar_singleton absorbing
+        else if low = high && low = neutral then first else Just (0, 1, false)
+    | _ -> Nothing
+  end
+
+(* Normalize a selected clamp arm only when its guard is proven. This is
+   analysis metadata; the original expression is still evaluated normally. *)
+val gnu_scalar_comparison_origin:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_scalar_knowledge)) ->
+  Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (A.expression GenTypes.genTypeCategory)
+let rec gnu_scalar_comparison_origin analyze tagDefs expr =
+  let normalized = gnu_scalar_identity_origin tagDefs expr in
+  match normalized with
+    | A.AnnotatedExpression _ _ _ (A.AilEcond test (Just yes) no) ->
+        analyze test >>= function
+          | Just info -> let (low, high, _) = gnu_scalar_truth info in
+              if low = high then gnu_scalar_comparison_origin analyze tagDefs
+                (if low = 0 then no else yes) else E.return normalized
+          | Nothing -> E.return normalized end
+    | _ -> E.return normalized
+  end
+
+val gnu_scalar_cancel_subtraction:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_scalar_knowledge)) ->
+  Core.core_tag_definitions -> A.binaryOperator ->
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe gnu_scalar_knowledge)
+let gnu_scalar_cancel_subtraction analyze tagDefs bop left right =
+  if not (gnu_scalar_is_relation bop) then E.return Nothing else
+  gnu_scalar_comparison_origin analyze tagDefs left >>= fun left ->
+  gnu_scalar_comparison_origin analyze tagDefs right >>= fun right ->
+  match (left, right, gnu_scalar_common_type (ctype_of left) (ctype_of right)) with
+    | (A.AnnotatedExpression _ _ _ (A.AilEbinary a (A.Arithmetic A.Sub) x),
+       A.AnnotatedExpression _ _ _ (A.AilEbinary b (A.Arithmetic A.Sub) y), Just common) ->
+        let x = gnu_scalar_identity_origin tagDefs x in
+        let y = gnu_scalar_identity_origin tagDefs y in
+        if not (gnu_scalar_same_origin x y &&
+          gnu_scalar_implementation_type_equal (ctype_of left) common &&
+          gnu_scalar_implementation_type_equal (ctype_of right) common &&
+          gnu_size_effects left = Just false && gnu_size_effects right = Just false)
+        then E.return Nothing else
+        analyze x >>= fun shared ->
+        E.return (match (gnu_scalar_closed_integer tagDefs a,
+            gnu_scalar_closed_integer tagDefs b, shared, gnu_scalar_type_bounds common,
+            gnu_scalar_common_type (ctype_of a) (ctype_of x),
+            gnu_scalar_common_type (ctype_of b) (ctype_of y)) with
+          | (Just a, Just b, Just (low, high, _), Just (minimum, maximum), Just first, Just second) ->
+              if not (gnu_scalar_implementation_type_equal first common &&
+                  gnu_scalar_implementation_type_equal second common) ||
+                  low < minimum || high > maximum ||
+                  a < minimum || a > maximum || b < minimum || b > maximum ||
+                  a-high < minimum || a-low > maximum ||
+                  b-high < minimum || b-low > maximum
+              then Nothing else
+                gnu_scalar_comparison bop (a,a,true) (b,b,true)
+          | _ -> Nothing end)
+    | _ -> E.return Nothing
+  end
+
+(* Compiler-only popcount identifiers are direct calls in AIL rather than
+   AilEbuiltin constructors. Certify both their source/linker identity and their
+   declared unsigned parameter; a source body or a changed declaration is not
+   an implementation of this builtin. Pointer loads/casts never enter here. *)
+val gnu_scalar_popcount_parameter:
+  A.expression GenTypes.genTypeCategory -> Ctype.ctype -> E.elabM (maybe Ctype.ctype)
+let gnu_scalar_popcount_parameter (A.AnnotatedExpression _ _ _ node as callee) result_ty =
+  let direct = match node with
+    | A.AilEident sym ->
+        if AilTypesAux.is_function (ctype_of callee) then Just sym else Nothing
+    | A.AilEfunction_decay (A.AnnotatedExpression _ _ _ (A.AilEident sym) as source) ->
+        if AilTypesAux.is_function (ctype_of source) then Just sym else Nothing
+    | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident sym) as source) ->
+        if AilTypesAux.is_function (ctype_of source) then Just sym else Nothing
+    | _ -> Nothing end in
+  match direct with
+    | Nothing -> E.return Nothing
+    | Just declared ->
+        let expected = match Symbol.symbol_description declared with
+          | Symbol.SD_Id "__builtin_popcount" ->
+              Just ("__builtin_popcount", Ctype.Unsigned Ctype.Int_)
+          | Symbol.SD_Id "__builtin_popcountl" ->
+              Just ("__builtin_popcountl", Ctype.Unsigned Ctype.Long)
+          | Symbol.SD_Id "__builtin_popcountll" ->
+              Just ("__builtin_popcountll", Ctype.Unsigned Ctype.LongLong)
+          | _ -> Nothing end in
+        (match expected with
+          | Nothing -> E.return Nothing
+          | Just (name, parameter_kind) ->
+              E.gnu_inline_target declared >>= fun target ->
+              E.gnu_has_source_definition declared >>= fun declared_defined ->
+              E.gnu_has_source_definition target >>= fun target_defined ->
+              E.linker_name declared >>= fun linked_name ->
+              if declared <> target || declared_defined || target_defined ||
+                  linked_name <> Just name then E.return Nothing else
+              let parameter_ty = Ctype.mk_ctype_integer parameter_kind in
+              let int_ty = Ctype.mk_ctype_integer (Ctype.Signed Ctype.Int_) in
+              let function_ty = match ctype_of callee with
+                | Ctype.Ctype _ (Ctype.Pointer _ ty) -> ty
+                | ty -> ty end in
+              E.return (match function_ty with
+                | Ctype.Ctype _ (Ctype.Function (result_qs, result) [(parameter_qs, parameter, _)] false) ->
+                    if result_qs = Ctype.no_qualifiers && not parameter_qs.Ctype.volatile &&
+                        gnu_function_target_type_equal result int_ty &&
+                        gnu_function_target_type_equal result_ty int_ty &&
+                        gnu_function_target_type_equal parameter parameter_ty
+                    then Just parameter_ty else Nothing
+                | _ -> Nothing end)
+        end)
+  end
+
+(* Count the converted unsigned value using the configured precision. The
+   bounded fold introduces no new recursive definition or host-width limit.
+   A range with more than one value cannot become an exact popcount fact. *)
+val gnu_scalar_popcount_value:
+  Ctype.ctype -> Ctype.ctype -> gnu_scalar_knowledge -> maybe gnu_scalar_knowledge
+let gnu_scalar_popcount_value parameter_ty result_ty knowledge =
+  match (parameter_ty, gnu_scalar_cast parameter_ty knowledge) with
+    | (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer kind)), Just (low, high, _)) ->
+        if low <> high || low < 0 then Nothing else
+        (match Implementation.precision_ity kind with
+          | Nothing -> Nothing
+          | Just precision ->
+              let (remaining, count) = List.foldl
+                (fun (remaining, count) () -> (remaining / 2, count + (remaining mod 2)))
+                (low, 0) (List.replicate precision ()) in
+              if remaining <> 0 then Nothing else
+                gnu_scalar_arithmetic_range result_ty (count, count, true)
+        end)
+    | _ -> Nothing
+  end
+
+val gnu_scalar_analyze:
+  bool -> Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_scalar_knowledge)
+let rec gnu_scalar_analyze allow_relations tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_scalar_analyze allow_relations tagDefs in
+  let bound varied ty = maybe Nothing (fun (low, high) -> Just (low, high, varied)) (gnu_scalar_type_bounds ty) in
+  let fact_knowledge fact = match fact with
+    | Just (E.GNU_inline_integer_range_fact low high dense) ->
+        E.return (gnu_scalar_cast (ctype_of expr) (low, high, dense))
+    | Just (E.GNU_inline_integer_progression_fact low high step) ->
+        E.return (if step > 0 && low <= high && (high-low) mod step = 0 then
+          gnu_scalar_cast (ctype_of expr) (low, high, step = 1) else Nothing)
+    | Just (E.GNU_inline_integer_fact origin) ->
+        gnu_scalar_origin_live origin >>= fun live ->
+        if not live then E.return (bound false (ctype_of expr)) else
+        self origin >>= fun info ->
+        E.return (maybe Nothing (gnu_scalar_cast (ctype_of expr)) info)
+    | _ -> E.return (bound false (ctype_of expr))
+  end in
+  (* A captured bound relation contains no permanent range. Read its unchanged
+     parameter's current branch/flow facts; missing variation stays missing.
+     Extent validation already rejects nonpositive or overflowing VLA sizes. *)
+  let sizeof ty = match gnu_scalar_sizeof tagDefs ty with
+    | Just size -> E.return (gnu_scalar_singleton size)
+    | Nothing -> match (ty, gnu_scalar_type_bounds Ctype.size_t) with
+        | (Ctype.Ctype _ (Ctype.VariableArray element key), Just (_, maximum)) ->
+            (match gnu_scalar_sizeof tagDefs element with
+              | Just size -> if size <= 0 then E.return Nothing else
+                  E.gnu_compiler_fact key >>= function
+                    | Just (E.GNU_inline_integer_fact origin) ->
+                        gnu_scalar_origin_live origin >>= fun live ->
+                        if not live then E.return Nothing else
+                        self origin >>= fun knowledge ->
+                        E.return (match knowledge with
+                          | Just (low, high, dense) ->
+                              let low = max 1 low in
+                              let high = min high (maximum / size) in
+                              if low > high then Nothing else
+                                Just (low * size, high * size,
+                                  low = high || (dense && size = 1))
+                          | Nothing -> Nothing end)
+                    | _ -> E.return Nothing
                   end
-                end
-              end
+              | Nothing -> E.return Nothing end)
+        | _ -> E.return Nothing end
+  end in
+  match node with
+    | A.AilEconst (A.ConstantInteger (A.IConstant number _ _)) -> E.return (gnu_scalar_singleton number)
+    | A.AilEconst (A.ConstantPredefined A.PConstantFalse) -> E.return (gnu_scalar_singleton 0)
+    | A.AilEconst (A.ConstantPredefined A.PConstantTrue) -> E.return (gnu_scalar_singleton 1)
+    | A.AilEsizeof _ ty -> sizeof ty
+    | A.AilEsizeof_expr operand -> sizeof (ctype_of operand)
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_va_arg_pack_len)) [] ->
+        E.get_gnu_va_pack_count >>= fun count ->
+        E.return (maybe Nothing gnu_scalar_singleton count)
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_object_size dynamic mode))) [pointer] ->
+        gnu_scalar_object_size tagDefs dynamic mode pointer >>= fun value ->
+        E.return (maybe Nothing gnu_scalar_singleton value)
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) [operand] ->
+        (match gnu_constant_p_classify tagDefs operand with
+          | Just result -> E.return (gnu_scalar_singleton (if result then 1 else 0))
+          | Nothing -> resolve_gnu_constant_origins tagDefs operand >>= fun resolved ->
+              gnu_scalar_analyze false tagDefs resolved >>= fun knowledge -> E.return (match knowledge with
+                | Just (low, high, dense) -> if low = high then gnu_scalar_singleton 1
+                    else if dense then gnu_scalar_singleton 0 else Nothing
+                | Nothing -> Nothing end)
+        end)
+    | A.AilEcall callee [operand] ->
+        if not (AilTypesAux.is_integer (ctype_of operand)) ||
+            gnu_size_effects operand <> Just false then E.return Nothing else
+        gnu_scalar_popcount_parameter callee (ctype_of expr) >>= function
+          | Nothing -> E.return Nothing
+          | Just parameter_ty -> self operand >>= fun knowledge ->
+              E.return (maybe Nothing
+                (gnu_scalar_popcount_value parameter_ty (ctype_of expr)) knowledge)
+        end
+    | A.AilEcond condition yes no ->
+        (* Both arm bounds hold regardless of which arm is selected. Their
+           hull does not establish that either arm, or any intermediate value,
+           is attainable. Only a proved test may select one arm's certificate. *)
+        if gnu_size_effects expr <> Just false then E.return Nothing else
+        self condition >>= fun test ->
+        let first = maybe condition (fun value -> value) yes in
+        let convert info = maybe Nothing (gnu_scalar_cast (ctype_of expr)) info in
+        (match maybe Nothing (fun info ->
+            let (low, high, _) = gnu_scalar_truth info in
+            if low = high then Just (low <> 0) else Nothing) test with
+          | Just true -> self first >>= fun info -> E.return (convert info)
+          | Just false -> self no >>= fun info -> E.return (convert info)
+          | Nothing -> self first >>= fun first_info -> self no >>= fun second_info ->
+              E.return (match (convert first_info, convert second_info) with
+                | (Just (al, ah, _), Just (bl, bh, _)) ->
+                    let extremum = gnu_scalar_conditional_minimum tagDefs (ctype_of expr) condition first no in
+                    let (low, high) = match extremum with
+                      | Just true -> (min al bl, min ah bh)
+                      | Just false -> (max al bl, max ah bh)
+                      | Nothing -> (min al bl, max ah bh)
+                    end in
+                    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+                      "GNU conditional bounds: test=" ^ Pp.stringFromAil_expression condition ^
+                      "; first=" ^ Pp.stringFromAil_expression first ^ "; second=" ^ Pp.stringFromAil_expression no ^
+                      "; result-type-bounds=" ^ show (gnu_scalar_type_bounds (ctype_of expr)) ^ "; extremum=" ^ show extremum ^
+                      "; first-bounds=" ^ show (al, ah) ^ "; second-bounds=" ^ show (bl, bh) ^
+                      "; result-bounds=" ^ show (low, high)) in
+                    Just (low, high, low = high)
+                | _ -> Nothing end)
+        end)
+    | A.AilEbinary left A.And right ->
+        self left >>= fun first -> self right >>= fun second ->
+        E.return (gnu_scalar_logic true first second)
+    | A.AilEbinary left A.Or right ->
+        self left >>= fun first -> self right >>= fun second ->
+        E.return (gnu_scalar_logic false first second)
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ ty operand -> gnu_scalar_progression_of expr >>= function
+        | Just (low, high, step) -> E.return (Just (low, high, step = 1))
+        | Nothing -> self operand >>= fun info -> E.return (maybe Nothing (gnu_scalar_cast ty) info)
+      end
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if AilTypesAux.is_atomic ty then E.return Nothing else
+        if qs.Ctype.volatile then E.return (bound true (ctype_of expr)) else
+        (match operand with
+          | A.AnnotatedExpression _ _ _ (A.AilEident sym) -> E.gnu_compiler_fact sym >>= fact_knowledge
+          | _ -> gnu_loaded_memory_fact operand >>= fact_knowledge
+        end)
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand >>= fun info -> E.return
+        (maybe Nothing (fun (low, high, varied) -> gnu_scalar_arithmetic_range (ctype_of expr) (0 - high, 0 - low, varied)) info)
+    | A.AilEbinary left bop right ->
+        (match bop with
+          | A.Arithmetic A.Mod ->
+              if gnu_size_effects expr <> Just false then E.return Nothing else
+              gnu_scalar_progression_of left >>= fun progression ->
+              self right >>= fun divisor ->
+              E.return (match (progression, divisor,
+                  gnu_scalar_common_type (ctype_of left) (ctype_of right)) with
+                | (Just incoming, Just divisor, Just common) ->
+                    (match (gnu_scalar_progression_cast common incoming,
+                        gnu_scalar_cast common divisor) with
+                      | (Just (low, high, step), Just (first, last, _)) ->
+                          if first <> last || first <= 0 || low < 0 ||
+                             step <= 0 || (high-low) mod step <> 0 ||
+                             step mod first <> 0 then Nothing else
+                          maybe Nothing (fun (_, remainder) ->
+                            gnu_scalar_arithmetic_range (ctype_of expr)
+                              (remainder, remainder, true))
+                            (gnu_scalar_integer_division common low first)
+                      | _ -> Nothing end)
+                | _ -> Nothing end)
+          | _ -> E.return Nothing end) >>= fun exact_modulo ->
+        if isJust exact_modulo then E.return exact_modulo else
+        (if allow_relations then gnu_scalar_cancel_subtraction self tagDefs bop left right
+         else E.return Nothing) >>= fun cancelled ->
+        if isJust cancelled then E.return cancelled else
+        self left >>= fun first -> self right >>= fun second ->
+        let converted = match gnu_scalar_common_type (ctype_of left) (ctype_of right) with
+          | Just common ->
+              (maybe Nothing (gnu_scalar_cast common) first, maybe Nothing (gnu_scalar_cast common) second)
+          | _ -> (Nothing, Nothing)
+        end in
+        E.return (match converted with
+          | (Just (al, ah, av), Just (bl, bh, bv)) ->
+              let same = gnu_scalar_same_origin
+                (gnu_scalar_identity_origin tagDefs left) (gnu_scalar_identity_origin tagDefs right) in
+              let fixed_left = al = ah in
+              let fixed_right = bl = bh in
+              let checked info = gnu_scalar_arithmetic_range (ctype_of expr) info in
+              (match bop with
+                | A.Arithmetic A.Sub -> if same then gnu_scalar_singleton 0 else
+                    checked (al-bh, ah-bl, (av && fixed_right) || (bv && fixed_left))
+                | A.Arithmetic A.Add -> checked (al+bl, ah+bh, (av && fixed_right) || (bv && fixed_left))
+                | A.Arithmetic A.Mul ->
+                    if (fixed_left && al = 0) || (fixed_right && bl = 0) then gnu_scalar_singleton 0 else
+                    let low = min (min (al*bl) (al*bh)) (min (ah*bl) (ah*bh)) in
+                    let high = max (max (al*bl) (al*bh)) (max (ah*bl) (ah*bh)) in
+                    checked (low, high, (av && fixed_right && (bl = 1 || bl = (0 - 1))) ||
+                      (bv && fixed_left && (al = 1 || al = (0 - 1))))
+                | A.Arithmetic A.Div ->
+                    if not fixed_right then Nothing else
+                    (match (gnu_scalar_integer_division (ctype_of expr) al bl,
+                            gnu_scalar_integer_division (ctype_of expr) ah bl) with
+                      | (Just (first, _), Just (last, _)) ->
+                          (* For a fixed nonzero divisor, truncation is monotone
+                             and adjacent numerators cannot skip a quotient. *)
+                          Just (min first last, max first last, av)
+                      | _ -> Nothing
+                    end)
+                | A.Arithmetic A.Mod ->
+                    if fixed_left && fixed_right then
+                      maybe Nothing (fun (_, remainder) -> gnu_scalar_singleton remainder)
+                        (gnu_scalar_integer_division (ctype_of expr) al bl)
+                    else Nothing
+                | A.Arithmetic A.Band ->
+                    if (fixed_left && al = 0) || (fixed_right && bl = 0) then gnu_scalar_singleton 0
+                    else if same then Just (al, ah, av) else bound false (ctype_of expr)
+                | A.Arithmetic A.Bxor -> if same then gnu_scalar_singleton 0 else bound false (ctype_of expr)
+                | A.Arithmetic A.Bor -> if same then Just (al, ah, av) else bound false (ctype_of expr)
+                | A.Eq -> if same then gnu_scalar_singleton 1 else gnu_scalar_comparison bop (al,ah,av) (bl,bh,bv)
+                | A.Ne -> if same then gnu_scalar_singleton 0 else gnu_scalar_comparison bop (al,ah,av) (bl,bh,bv)
+                | A.Le -> if same then gnu_scalar_singleton 1 else gnu_scalar_comparison bop (al,ah,av) (bl,bh,bv)
+                | A.Ge -> if same then gnu_scalar_singleton 1 else gnu_scalar_comparison bop (al,ah,av) (bl,bh,bv)
+                | A.Lt -> if same then gnu_scalar_singleton 0 else gnu_scalar_comparison bop (al,ah,av) (bl,bh,bv)
+                | A.Gt -> if same then gnu_scalar_singleton 0 else gnu_scalar_comparison bop (al,ah,av) (bl,bh,bv)
+                | _ -> Nothing
+              end)
+          | _ -> Nothing
+        end)
+    | _ -> E.return Nothing
+  end
+
+val gnu_scalar_knowledge_of:
+  Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe gnu_scalar_knowledge)
+let gnu_scalar_knowledge_of tagDefs expr =
+  gnu_scalar_analyze false tagDefs expr
+
+val gnu_scalar_fact:
+  Core.core_tag_definitions -> Ctype.ctype -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe E.gnu_inline_fact)
+let gnu_scalar_fact tagDefs ty expr =
+  gnu_scalar_progression_of expr >>= fun progression ->
+  match maybe Nothing (gnu_scalar_progression_cast ty) progression with
+    | Just (low, high, step) -> E.return (Just (E.GNU_inline_integer_progression_fact low high step))
+    | Nothing -> gnu_scalar_knowledge_of tagDefs expr >>= fun info ->
+        E.return (match info with
+          | Nothing -> Nothing
+          | Just info -> (match gnu_scalar_cast ty info with
+              | Just (low, high, varied) ->
+                  Just (E.GNU_inline_integer_range_fact low high varied)
+              | _ -> Nothing end)
+        end)
+  end
+
+(* Witnesses are concrete attainable compiler alternatives, not bounds. They
+   are used only to show a query nonconstant; equal witnesses never establish
+   constancy. An arithmetic combination requires a proved singleton operand,
+   so independent-looking but correlated objects cannot be mixed here. This
+   represents sparse modular images without falsely making their hull dense. *)
+val gnu_scalar_integer_binary:
+  Ctype.ctype -> A.binaryOperator -> integer -> integer -> maybe integer
+let gnu_scalar_integer_binary ty bop left right =
+  let checked number = maybe Nothing (fun (value, _, _) -> Just value)
+    (gnu_scalar_arithmetic_range ty (number, number, true)) in
+  match bop with
+    | A.Arithmetic A.Add -> checked (left+right)
+    | A.Arithmetic A.Sub -> checked (left-right)
+    | A.Arithmetic A.Mul -> checked (left*right)
+    | A.Arithmetic A.Div -> maybe Nothing (fun (quotient, _) -> Just quotient)
+        (gnu_scalar_integer_division ty left right)
+    | A.Arithmetic A.Mod -> maybe Nothing (fun (_, remainder) -> Just remainder)
+        (gnu_scalar_integer_division ty left right)
+    | A.Eq -> Just (if left = right then 1 else 0)
+    | A.Ne -> Just (if left <> right then 1 else 0)
+    | A.Le -> Just (if left <= right then 1 else 0)
+    | A.Ge -> Just (if left >= right then 1 else 0)
+    | A.Lt -> Just (if left < right then 1 else 0)
+    | A.Gt -> Just (if left > right then 1 else 0)
+    | _ -> Nothing
+  end
+
+val gnu_scalar_map_witnesses: (integer -> maybe integer) -> list integer -> list integer
+let gnu_scalar_map_witnesses function_ values = List.foldr (fun value rest ->
+  match function_ value with
+    | Just result -> if List.elem result rest then rest else result :: rest
+    | Nothing -> rest
+  end) [] values
