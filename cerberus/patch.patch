+  let self = gnu_inline_closed_size_origin allow_choices seen in
+  let eligible = gnu_inline_closed_extent_fact allow_choices in
+  match node with
+    | A.AilEannot _ operand -> self address operand
+    | A.AilErvalue operand -> self address operand
+    | A.AilEident sym ->
+        if address then E.return (gnu_inline_fixed_object_type (ctype_of e))
+        else if List.any (fun old -> old = sym) seen then E.return false
