+            else gnu_fortified_snprintf_forwarder target >>= fun forwarding ->
+            let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf callee) (fun () ->
+              "GNU format forwarding; certified=" ^ show forwarding ^
+              "; template=" ^ show (isJust template) ^ "; call-body=" ^ show (isJust body)) in
+            E.return forwarding
+        end)
+  | _ -> E.return false end
+
+(* Standard byte operations have a narrow, declaration-checked summary.
+   A visible implementation is never trusted from its name. Actual operand
+   origins and effects are checked separately before using this summary. *)
+type gnu_standard_byte_kind = GNU_byte_length | GNU_byte_compare | GNU_byte_copy | GNU_byte_swap
+
+val gnu_standard_byte_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_standard_byte_kind)
+let gnu_standard_byte_call (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcall callee args ->
+      if not (gnu_inline_direct_designator callee) then E.return Nothing else
+      let character_pointer ty = match ty with
+        | Ctype.Ctype _ (Ctype.Pointer qs (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)))) ->
+            not qs.Ctype.volatile
+        | _ -> false end in
+      let void_pointer ty = match ty with
+        | Ctype.Ctype _ (Ctype.Pointer qs pointed) -> not qs.Ctype.volatile && AilTypesAux.is_void pointed
+        | _ -> false end in
+      let size_type ty = AilTypesAux.are_compatible (Ctype.no_qualifiers, ty)
+        (Ctype.no_qualifiers, Ctype.size_t) in
+      let int_type ty = AilTypesAux.are_compatible (Ctype.no_qualifiers, ty)
+        (Ctype.no_qualifiers, Ctype.signed_int) in
+      let signature = match ctype_of callee with
+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function (_, result) params false))) ->
+            if List.length params = List.length args
+            then Just (result, List.map (fun (_, ty, _) -> ty) params) else Nothing
+        | _ -> Nothing end in
+      gnu_inline_function_target callee >>= function
+        | Nothing -> E.return Nothing
+        | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+            E.gnu_has_source_definition target >>= fun defined ->
+            E.linker_name declared >>= fun name ->
+            if defined then E.return Nothing else E.return (match (name, signature) with
+              | (Just name, Just (result, [source])) ->
+                  if (name = "strlen" || name = "__builtin_strlen") &&
+                    size_type result && character_pointer source
+                  then Just GNU_byte_length else
+                  let width = match name with
+                    | "__builtin_bswap16" -> Just 16
+                    | "__builtin_bswap32" -> Just 32
+                    | "__builtin_bswap64" -> Just 64
+                    | _ -> Nothing end in
+                  (match width with
+                    | Nothing -> Nothing
+                    | Just bits ->
+                        let expected = Ctype.mk_ctype_integer
+                          (Implementation.normalise_integerType (Ctype.Unsigned (Ctype.IntN_t bits))) in
+                        if gnu_function_target_type_equal result expected &&
+                          gnu_function_target_type_equal source expected
+                        then Just GNU_byte_swap else Nothing end)
+              | (Just name, Just (result, [first; second; length])) ->
+                  if not (void_pointer first && void_pointer second && size_type length)
+                  then Nothing else
+                  if (name = "memcmp" || name = "__builtin_memcmp") && int_type result
+                  then Just GNU_byte_compare else
+                  if List.elem name ["memcpy"; "__builtin_memcpy"; "memmove"; "__builtin_memmove"] &&
+                    void_pointer result then Just GNU_byte_copy else Nothing
+              | (Just name, Just (result, [destination; source; length; bound])) ->
+                  if List.elem name ["__memcpy_chk"; "__builtin___memcpy_chk";
+                      "__memmove_chk"; "__builtin___memmove_chk"] &&
+                    void_pointer result && void_pointer destination && void_pointer source &&
+                    size_type length && size_type bound
+                  then Just GNU_byte_copy else Nothing
+              | _ -> Nothing end)
+      end
+  | _ -> E.return Nothing
+end
+
+(* This domain records absence of a visible allocation-address origin, not
+   a numerical range, pointer identity, bound, or constant_p result. Storage and
+   pointer-value certificates are separate: &incoming->member has opaque
+   contents but can have a known member bound. A caller must positively certify
+   the incoming storage; missing loads and integer/pointer conversions decline.
+   The whole effect proof checks every write and excludes pointer refinement
+   before using these classes in a visible callee. *)
+type gnu_boundary_return_resolver = list Symbol.sym -> list Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (bool * bool)
+
+val gnu_boundary_no_return: gnu_boundary_return_resolver
+let gnu_boundary_no_return _ _ _ = E.return (false, false)
+
+val gnu_boundary_origin_value_with:
+  gnu_boundary_return_resolver ->
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+val gnu_boundary_origin_storage_with:
+  gnu_boundary_return_resolver ->
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+val gnu_boundary_origin_address_with:
+  gnu_boundary_return_resolver ->
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+val gnu_boundary_arithmetic_lvalue_with:
+  gnu_boundary_return_resolver -> list Symbol.sym -> list Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+val gnu_boundary_byte_call_with:
+  gnu_boundary_return_resolver -> list Symbol.sym -> list Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_boundary_origin_value_with returns values roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_boundary_origin_value_with returns values roots in
+  let load_origin operand =
+    gnu_boundary_origin_address_with returns values roots operand >>= fun storage ->
+    if not (AilTypesAux.is_arithmetic (ctype_of operand)) then E.return storage else
+    (* Positive storage contents and an ordinary pointer value are alternative
+       justifications for an arithmetic read. The scalar-only extension must
+       not remove the pre-existing storage proof, including struct addresses. *)
+    gnu_boundary_arithmetic_lvalue_with returns values roots operand >>= fun scalar ->
+    let () = if storage && not scalar then Debug.print_debug_located 2 [Debug.DB_elaboration]
+      (Loc.locOf operand) (fun () -> "GNU arithmetic load keeps storage-origin proof: " ^
+        Pp.stringFromAil_expression operand) else () in
+    E.return (storage || scalar) in
+  let both first second = first >>= fun checked -> if checked then second else E.return false in
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      not (AilTypesAux.is_arithmetic ty || AilTypesAux.is_pointer ty) ||
+      AilTypesAux.is_pointer_to_function ty then E.return false else
+  if gnu_literal_null_pointer expr then E.return true else match node with
+    | A.AilEconst (A.ConstantInteger _) -> E.return true
+    | A.AilEconst (A.ConstantFloating _) -> E.return true
+    | A.AilEident sym -> E.return (List.elem sym values)
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        E.return (List.elem sym values)
+    | A.AilErvalue operand -> gnu_standard_errno_lvalue operand >>= fun errno ->
+        if errno then E.return true else load_origin operand
+    (* Compound assignment reads its lvalue without an AilErvalue wrapper. *)
+    | A.AilEunary A.Indirection _ -> load_origin expr
+    | A.AilEmemberof _ _ -> load_origin expr
+    | A.AilEmemberofptr _ _ -> load_origin expr
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ result operand ->
+        if (AilTypesAux.is_arithmetic result && AilTypesAux.is_arithmetic (ctype_of operand)) ||
+            (AilTypesAux.is_pointer result && AilTypesAux.is_pointer (ctype_of operand))
+        then self operand else E.return false
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEunary A.PostfixIncr operand -> self operand
+    | A.AilEunary A.PostfixDecr operand -> self operand
+    | A.AilEbinary left A.Comma right -> self right
+    | A.AilEbinary left _ right -> both (self left) (self right)
+    | A.AilEcond test yes no -> both (self (maybe test (fun value -> value) yes)) (self no)
+    | A.AilEassign _ right -> self right
+    | A.AilEcompoundAssign left _ right -> both (self left) (self right)
+    | A.AilEcall callee _ ->
+        if AilTypesAux.is_pointer ty then gnu_ordinary_unsized_pointer_result expr >>= fun opaque ->
+          if opaque then E.return true else returns values roots expr >>= fun (value, _) -> E.return value
+        else gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+          if opaque then E.return true else
+          gnu_boundary_byte_call_with returns values roots expr >>= fun bytes ->
+          if bytes then E.return true else returns values roots expr >>= fun (value, _) -> E.return value
+    | A.AilEsizeof _ object_ty -> E.return (gnu_inline_fixed_object_type object_ty)
+    | A.AilEsizeof_expr operand -> E.return (gnu_inline_fixed_object_type (ctype_of operand))
+    | A.AilEalignof _ _ -> E.return true
+    | A.AilEoffsetof _ _ -> E.return true
+    | _ -> E.return false
+  end
+and gnu_boundary_origin_storage_with returns values roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_boundary_origin_storage_with returns values roots in
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      not (AilTypesAux.is_pointer ty) || AilTypesAux.is_pointer_to_function ty
+  then E.return false else
+  if gnu_literal_null_pointer expr then E.return true else match node with
+    | A.AilEident sym -> E.return (List.elem sym roots)
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        E.return (List.elem sym roots)
+    | A.AilErvalue operand -> gnu_boundary_origin_address_with returns values roots operand
+    | A.AilEunary A.Address operand -> gnu_boundary_origin_address_with returns values roots operand
+    | A.AilEarray_decay operand -> gnu_boundary_origin_address_with returns values roots operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ result operand ->
+        if AilTypesAux.is_pointer result && AilTypesAux.is_pointer (ctype_of operand)
+        then self operand else E.return false
+    | A.AilEbinary left (A.Arithmetic A.Add) right ->
+        if AilTypesAux.is_pointer (ctype_of left) then
+          self left >>= fun base -> gnu_boundary_origin_value_with returns values roots right >>= fun offset ->
+          E.return (base && offset)
+        else self right >>= fun base -> gnu_boundary_origin_value_with returns values roots left >>= fun offset ->
+          E.return (base && offset)
+    | A.AilEbinary left (A.Arithmetic A.Sub) right ->
+        self left >>= fun base -> gnu_boundary_origin_value_with returns values roots right >>= fun offset ->
+        E.return (base && offset)
+    | A.AilEcond test yes no ->
+        self (maybe test (fun value -> value) yes) >>= fun first -> self no >>= fun second ->
+        E.return (first && second)
+    | A.AilEassign _ right -> self right
+    | A.AilEcall _ _ -> gnu_ordinary_unsized_pointer_result expr >>= fun opaque ->
+        if opaque then E.return true else returns values roots expr >>= fun (_, storage) -> E.return storage
+    | _ -> E.return false
+  end
+and gnu_boundary_origin_address_with returns values roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_boundary_origin_address_with returns values roots in
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then E.return false else match node with
+    | A.AilEident sym -> E.return (List.elem sym values)
+    | A.AilEunary A.Indirection pointer -> gnu_boundary_origin_storage_with returns values roots pointer
+    | A.AilEmemberof operand _ -> (match ctype_of operand with
+        | Ctype.Ctype _ (Ctype.Struct _) -> self operand
+        | _ -> E.return false end)
+    | A.AilEmemberofptr pointer _ -> (match ctype_of pointer with
+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Struct _))) ->
+            gnu_boundary_origin_storage_with returns values roots pointer
+        | _ -> E.return false end)
+    | A.AilEannot _ operand -> self operand
+    | _ -> E.return false
+  end
+
+(* An arithmetic read cannot itself supply a tracked object address. Its
+   address must still derive from a positive ordinary pointer-value origin:
+   a known local/global address and an integer-to-pointer cast do not qualify.
+   This separate path never certifies a pointer load or the pointee's pointer
+   contents. The caller checks the loaded arithmetic type; recursive struct
+   lvalues only locate that scalar subobject. Reads and all runtime checks remain. *)
+and gnu_boundary_arithmetic_lvalue_with returns values roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_boundary_arithmetic_lvalue_with returns values roots in
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then E.return false else match node with
+    | A.AilEident sym -> E.return (List.elem sym values)
+    | A.AilEunary A.Indirection pointer ->
+        gnu_boundary_origin_value_with returns values roots pointer
+    | A.AilEmemberof operand _ -> (match ctype_of operand with
+        | Ctype.Ctype _ (Ctype.Struct _) -> self operand
+        | _ -> E.return false end)
+    | A.AilEmemberofptr pointer _ -> (match ctype_of pointer with
+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Struct _))) ->
+            gnu_boundary_origin_value_with returns values roots pointer
+        | _ -> E.return false end)
+    | A.AilEannot _ operand -> self operand
+    | _ -> E.return false
+  end
+
+and gnu_boundary_byte_call_with returns values roots (A.AnnotatedExpression _ _ _ node as expr) =
+  gnu_standard_byte_call expr >>= fun operation ->
+  let storage = gnu_boundary_origin_storage_with returns values roots in
+  let value = gnu_boundary_origin_value_with returns values roots in
+  let both first second = first >>= fun checked -> if checked then second else E.return false in
+  match (operation, node) with
+    | (Just GNU_byte_length, A.AilEcall _ [source]) -> storage source
+    | (Just GNU_byte_swap, A.AilEcall _ [source]) -> value source
+    | (Just GNU_byte_compare, A.AilEcall _ [first; second; length]) ->
+        both (both (storage first) (storage second)) (value length)
+    | (Just GNU_byte_copy, A.AilEcall _ (destination :: source :: length :: rest)) ->
+        if List.length rest > 1 then E.return false else
+        both (both (storage destination) (storage source)) (value length)
+    | _ -> E.return false
+  end
+
+val gnu_boundary_origin_value:
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_boundary_origin_value = gnu_boundary_origin_value_with gnu_boundary_no_return
+
+val gnu_boundary_origin_storage:
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_boundary_origin_storage = gnu_boundary_origin_storage_with gnu_boundary_no_return
+
+val gnu_boundary_origin_address:
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_boundary_origin_address = gnu_boundary_origin_address_with gnu_boundary_no_return
+
+(* Require a definition grounded in a previously established origin. This
+   prevents a self-copy or mutually recursive uninitialized copies from creating
+   a certificate. The independent complete-write census below also checks every
+   other initializer/update, including branches and loop bodies. *)
+val gnu_boundary_origin_seed_expression_with:
+  (Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) ->
+  (A.expression GenTypes.genTypeCategory -> E.elabM bool) -> Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_boundary_origin_seed_expression_with output_call classify subject (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_boundary_origin_seed_expression_with output_call classify subject in
+  let any operands = E.mapM self operands >>= fun results -> E.return (List.any (fun yes -> yes) results) in
+  match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident sym)) right ->
+        if sym = subject then classify right else self right
+    | A.AilEassign left right -> any [left; right]
+    | A.AilEbinary left _ right -> any [left; right]
+    | A.AilEcond test yes no -> any (test :: no :: maybe [] (fun x -> [x]) yes)
+    | A.AilEcall callee args -> output_call subject expr >>= fun output ->
+        if output = Just true then E.return true else any (callee :: args)
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | _ -> E.return false
+  end
+
+val gnu_boundary_origin_seed_with:
+  (Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)) ->
+  (A.expression GenTypes.genTypeCategory -> E.elabM bool) -> Symbol.sym ->
+  A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_boundary_origin_seed_with output_call classify subject stmt =
+  let self = gnu_boundary_origin_seed_with output_call classify subject in
+  let expression = gnu_boundary_origin_seed_expression_with output_call classify subject in
+  let any actions = E.mapM (fun action -> action) actions >>= fun results -> E.return (List.any (fun yes -> yes) results) in
+  match stmt.A.node with
+    | A.AilSexpr value -> expression value
+    | A.AilSreturn value -> expression value
+    | A.AilSblock _ statements -> any (List.map self statements)
+    | A.AilSif test yes no -> any [expression test; self yes; self no]
+    | A.AilSwhile test body _ -> any [expression test; self body]
+    | A.AilSdo body test _ -> any [self body; expression test]
+    | A.AilSswitch test body -> any [expression test; self body]
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSmarker _ body -> self body
+    | A.AilSdeclaration declarations -> any (List.map (fun (sym, value) ->
+        maybe (E.return false) (fun value ->
+          if sym = subject then classify value else expression value) value) declarations)
+    | _ -> E.return false
+  end
+
+(* Pointee storage never inherits a value-only external output certificate. *)
+val gnu_boundary_origin_seed:
+  (A.expression GenTypes.genTypeCategory -> E.elabM bool) -> Symbol.sym ->
+  A.statement GenTypes.genTypeCategory -> E.elabM bool
+let gnu_boundary_origin_seed =
+  gnu_boundary_origin_seed_with (fun _ _ -> E.return Nothing)
+
+(* Ground candidates before checking a simultaneous invariant. A least
+   fixed point of fully checked single bindings cannot admit mutually updated
+   arithmetic temporaries. Conversely, assuming every local from the outset
+   would admit uninitialized copy cycles. Grow only from positive definitions,
+   then remove each candidate with any unsupported write, including all of its
+   dependents. This is an origin-class invariant, not a value/definedness proof. *)
+val gnu_boundary_origin_candidates_with:
+  gnu_boundary_return_resolver ->
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym * list Symbol.sym)
+let rec gnu_boundary_origin_candidates_with returns fuel candidates body values roots =
+  if fuel = 0 then E.return (values, roots) else
+  E.foldlM (fun (known_values, known_roots) sym ->
+    (if List.elem sym known_values then E.return true else
+      gnu_boundary_origin_seed_with gnu_origin_output_call
+        (gnu_boundary_origin_value_with returns known_values known_roots) sym body >>= fun seeded ->
+      if seeded then E.return true else
+      gnu_pointer_definition_statement_with gnu_origin_output_call
+        (fun value -> gnu_boundary_origin_value_with returns known_values known_roots value >>= fun yes ->
+          E.return (if yes then Just true else Nothing)) sym body >>= fun writes ->
+      E.return (writes = Just true)) >>= fun value ->
+    (if List.elem sym known_roots then E.return true else
+      gnu_boundary_origin_seed (gnu_boundary_origin_storage_with returns known_values known_roots)
+        sym body) >>= fun content ->
+    E.return ((if value && not (List.elem sym known_values) then sym :: known_values else known_values),
+      (if content && not (List.elem sym known_roots) then sym :: known_roots else known_roots))
+  ) (values, roots) candidates >>= fun (next_values, next_roots) ->
+  if next_values = values && next_roots = roots then E.return (values, roots)
+  else gnu_boundary_origin_candidates_with returns (fuel - 1) candidates body next_values next_roots
+
+val gnu_boundary_origin_prune_with:
+  gnu_boundary_return_resolver ->
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym * list Symbol.sym)
+let rec gnu_boundary_origin_prune_with returns fuel candidates body values roots =
+  if fuel = 0 then E.return ([], []) else
+  let retain content sym =
+    if not (List.elem sym candidates) then E.return true else
+    let classify = if content then gnu_boundary_origin_storage_with returns else gnu_boundary_origin_value_with returns in
+    gnu_pointer_definition_statement_with
+      (if content then (fun _ _ -> E.return Nothing) else gnu_origin_output_call) (fun value ->
+      classify values roots value >>= fun yes ->
+      let () = if yes then () else Debug.print_debug_located 2 [Debug.DB_elaboration]
+        (Loc.locOf value) (fun () -> "GNU boundary origin definition rejected; subject=" ^
+          show sym ^ "; contents=" ^ show content ^ "; rhs=" ^ Pp.stringFromAil_expression value) in
+      E.return (if yes then Just true else Nothing))
+      sym body >>= fun writes ->
+      (* A class imported from loop entry is preserved by zero definitions.
+         New locals already require a grounded seed above. Nothing denotes an
+         unsupported write; Just false denotes a complete unchanged census. *)
+      E.return (isJust writes)
+  in
+  E.mapM (fun sym -> retain false sym >>= fun yes -> E.return (sym, yes)) values >>= fun value_checks ->
+  E.mapM (fun sym -> retain true sym >>= fun yes -> E.return (sym, yes)) roots >>= fun root_checks ->
+  let next_values = List.map fst (List.filter snd value_checks) in
+  let next_roots = List.map fst (List.filter snd root_checks) in
+  if next_values = values && next_roots = roots then E.return (values, roots)
+  else gnu_boundary_origin_prune_with returns (fuel - 1) candidates body next_values next_roots
+
+(* Scalar representation origins can be loop invariants even when their
+   numerical values change. Collect automatic arithmetic objects with explicit
+   qualifier/escape checks; the grounded complete definition census below must
+   then prove every write. A range alone supplies none of this evidence. *)
+val gnu_scalar_origin_locals: A.statement GenTypes.genTypeCategory -> list Symbol.sym
+let rec gnu_scalar_origin_locals stmt =
+  let self = gnu_scalar_origin_locals in match stmt.A.node with
+    | A.AilSblock bindings statements ->
+        List.foldr (fun (sym, ((_, dur, _), _, qs, ty)) rest ->
+          if dur = A.Automatic && AilTypesAux.is_arithmetic ty &&
+            not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty)
+          then sym :: rest else rest) [] bindings ++ List.concat (List.map self statements)
+    | A.AilSif _ yes no -> self yes ++ self no
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSswitch _ body -> self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSmarker _ body -> self body
+    | _ -> []
+  end
+
+val gnu_boundary_origin_locals_with:
+  gnu_boundary_return_resolver ->
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym * list Symbol.sym)
+let gnu_boundary_origin_locals_with returns fuel candidates body values roots =
+  E.with_gnu_return_query_cache (
+    gnu_boundary_origin_candidates_with returns fuel candidates body values roots >>= fun (values, roots) ->
+    gnu_boundary_origin_prune_with returns fuel candidates body values roots)
+
+val gnu_boundary_origin_candidates:
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym * list Symbol.sym)
+let gnu_boundary_origin_candidates = gnu_boundary_origin_candidates_with gnu_boundary_no_return
+
+val gnu_boundary_origin_prune:
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym * list Symbol.sym)
+let gnu_boundary_origin_prune = gnu_boundary_origin_prune_with gnu_boundary_no_return
+
+val gnu_boundary_origin_locals:
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym * list Symbol.sym)
+let gnu_boundary_origin_locals = gnu_boundary_origin_locals_with gnu_boundary_no_return
+
+(* Caller roots are input evidence, never guessed from a missing fact. Also
+   reject encoded address facts hidden in scalar fields before importing the
+   stronger representation-origin invariant used by the effect analysis. *)
+val gnu_boundary_capture_origins: E.elabM (list Symbol.sym * list Symbol.sym)
+let gnu_boundary_capture_origins =
+  E.gnu_memory_snapshot >>= fun (facts, roots, _) ->
+  E.gnu_memory_effective_bindings >>= fun effective ->
+  E.gnu_indexed_memory_symbols >>= fun indexed ->
+  E.mapM (fun root ->
+    if List.elem root indexed then E.return Nothing else
+    E.gnu_memory_opaque_subobject root [] >>= fun consistent ->
+    if not consistent then E.return Nothing else
+    E.mapM (fun ((indirect, sym, _), fact) ->
+      if not (indirect && sym = root) then E.return true else match fact with
+        | E.GNU_inline_integer_fact value -> gnu_boundary_origin_value [] [] value
+        | _ -> E.return true end) effective >>= fun scalar_origins ->
+    E.return (if List.all (fun yes -> yes) scalar_origins then Just root else Nothing)
+  ) roots >>= fun certified ->
+  let roots = List.foldr (fun item rest -> maybe rest (fun root -> root :: rest) item) [] certified in
+  (* A saved opaque pointer may carry typed member snapshots, and an
+     immutable parameter lives outside the mutable slot map. Preserve those
+     positive value origins too. Grounded scalar constants can seed an index
+     induction; a conservative integer range cannot establish this class. *)
+  E.mapM (fun ((indirect, sym, path), fact) ->
+    if indirect || path <> [] then E.return Nothing else
+    (if gnu_inline_plain_opaque_value (Just fact) then E.return true else match fact with
+      | E.GNU_inline_integer_fact value -> gnu_boundary_origin_value [] [] value
+      | _ -> E.return false end) >>= fun eligible ->
+    E.return (if eligible then Just sym else Nothing)) facts >>= fun direct_values ->
+  let values = List.foldr (fun value rest ->
+    maybe rest (fun sym -> sym :: rest) value) [] direct_values in
+  E.gnu_current_parameter_subjects >>= fun parameters ->
+  E.get_visible_objects >>= fun visible ->
+  let subjects = parameters ++ List.filter (fun sym -> not (List.elem sym parameters)) visible in
+  E.foldlM (fun values subject -> E.gnu_compiler_fact subject >>= fun fact ->
+    E.return (if gnu_inline_plain_opaque_value fact && not (List.elem subject values)
+      then subject :: values else values)) values subjects >>= fun values ->
+  E.gnu_incoming_scalar_origins >>= fun incoming_scalars ->
+  E.return (values ++ List.filter (fun sym -> not (List.elem sym values)) incoming_scalars, roots)
+
+(* A stronger, separate use of the effect census checks that incoming
+   representation origins never participate in a known-object refinement.
+   Both operands of a pointer comparison must have positive incoming origins;
+   null tests do not reveal an object bound. Integer/pointer encodings decline.
+   This is a source-origin contract, not a fallback for missing compiler facts. *)
+val gnu_boundary_incoming_refinements:
+  gnu_boundary_return_resolver -> list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_boundary_incoming_refinements returns values roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_boundary_incoming_refinements returns values roots in
+  let every operands = E.foldlM (fun checked operand ->
+    if checked then self operand else E.return false) true operands in
+  match node with
+    | A.AilEbinary left bop right ->
+        every [left; right] >>= fun children ->
+        if not children then E.return false else
+        if not (List.elem bop [A.Eq; A.Ne; A.Lt; A.Le; A.Gt; A.Ge]) ||
+            not (AilTypesAux.is_pointer (ctype_of left) || AilTypesAux.is_pointer (ctype_of right)) ||
+            gnu_literal_null_pointer left || gnu_literal_null_pointer right
+        then E.return true else
+        gnu_boundary_origin_value_with returns values roots left >>= fun first ->
+        gnu_boundary_origin_value_with returns values roots right >>= fun second ->
+        E.return (first && second)
+    | A.AilEcast _ result operand ->
+        if (AilTypesAux.is_pointer result && AilTypesAux.is_integer (ctype_of operand)) ||
+            (AilTypesAux.is_integer result && AilTypesAux.is_pointer (ctype_of operand))
+        then E.return (gnu_literal_null_pointer expr) else self operand
+    | A.AilEcall callee args -> every (callee :: args)
+    | A.AilEassign left right -> every [left; right]
+    | A.AilEcompoundAssign left _ right -> every [left; right]
+    | A.AilEunary _ operand -> self operand
+    | A.AilEcond test yes no -> every (test :: no :: maybe [] (fun value -> [value]) yes)
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEassert operand -> self operand
+    | A.AilEarray _ _ items -> every (List.foldr (fun item rest ->
+        maybe rest (fun value -> value :: rest) item) [] items)
+    | A.AilEstruct _ members -> every (List.foldr (fun (_, item) rest ->
+        maybe rest (fun value -> value :: rest) item) [] members)
+    | A.AilEunion _ _ item -> maybe (E.return true) self item
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEsizeof_expr _ -> E.return true
+    | A.AilEsizeof _ _ -> E.return true
+    | A.AilEalignof _ _ -> E.return true
+    | A.AilEoffsetof _ _ -> E.return true
+    | A.AilEident _ -> E.return true
+    | A.AilEstr _ -> E.return true
+    | A.AilEconst _ -> E.return true
+    | A.AilEbuiltin _ -> E.return true
+    | _ -> E.return false
+  end
+
+(* A visible callee may write through a direct address of the caller's
+   automatic storage without changing an incoming object's contents. Keep this
+   lexical storage class separate from unescaped locals and pointer origins:
+   a pointer stored in an output gets no value/bound certificate from this rule.
+   Forwarding an output address requires its unchanged formal in the context. *)
+val gnu_boundary_output_address:
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+val gnu_boundary_output_lvalue:
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_boundary_output_address frame outputs (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (gnu_memory_expression_readonly expr) then false else match node with
+    | A.AilEunary A.Address object_expr -> gnu_boundary_output_lvalue frame outputs object_expr
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> List.elem sym outputs
+    | A.AilEannot _ operand -> gnu_boundary_output_address frame outputs operand
+    | _ -> false
+  end
+and gnu_boundary_output_lvalue frame outputs (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then false else match node with
+    | A.AilEident sym -> List.elem sym frame
+    | A.AilEmemberof object_expr _ -> gnu_boundary_output_lvalue frame outputs object_expr
+    | A.AilEmemberofptr pointer _ -> gnu_boundary_output_address frame outputs pointer
+    | A.AilEunary A.Indirection pointer -> gnu_boundary_output_address frame outputs pointer
+    | A.AilEannot _ operand -> gnu_boundary_output_lvalue frame outputs operand
+    | _ -> false
+  end
+
+(* A newly zeroed automatic record can supply an origin-class invariant for
+   its contents. Restrict activation to structured source bodies: arbitrary
+   labels and switch entry could otherwise jump past the initializing statement.
+   The original callee templates retain structured break/continue nodes. *)
+val gnu_boundary_record_control: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_boundary_record_control stmt =
+  let self = gnu_boundary_record_control in match stmt.A.node with
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif _ yes no -> self yes && self no
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSmarker _ body -> self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_continue _)) -> self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_break _)) -> self body
+    | A.AilSskip -> true
+    | A.AilSexpr _ -> true
+    | A.AilSdeclaration _ -> true
+    | A.AilSreturn _ -> true
+    | A.AilSreturnVoid -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | _ -> false
+  end
+
+(* A record address is storage evidence, not the scalar output-value
+   certificate supplied by gnu_origin_output_argument. Keep the two disjoint. *)
+val gnu_boundary_record_address:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_boundary_record_address subject (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident sym) as object_expr) ->
+      let (qs, ty) = qualified_ctype_of object_expr in
+      sym = subject && not qs.Ctype.const && not qs.Ctype.volatile &&
+        (match ty with Ctype.Ctype _ (Ctype.Struct _) -> true | _ -> false end)
+  | A.AilEannot _ operand -> gnu_boundary_record_address subject operand
+  | _ -> false
+end
+
+val gnu_boundary_zero_record:
+  list (Symbol.sym * Ctype.ctype) -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe Symbol.sym)
+let gnu_boundary_zero_record records stmt = match stmt.A.node with
+  | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEcall _ args) as expr) ->
+      (* memset returns a pointer. This excludes bzero/chk signatures whose
+         second and third operands mean length/bound rather than fill/length. *)
+      if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return Nothing else
+      (match args with
+        | destination :: fill :: length :: rest ->
+            if List.length rest > 1 || not (gnu_boundary_integer_zero [] fill)
+            then E.return Nothing else
+            let selected = List.filter (fun (sym, ty) ->
+              gnu_boundary_record_address sym destination && (match length with
+                | A.AnnotatedExpression _ _ _ (A.AilEsizeof _ sized) ->
+                    gnu_function_target_type_equal ty sized
+                | A.AnnotatedExpression _ _ _ (A.AilEsizeof_expr sized) ->
+                    gnu_inline_fixed_object_type (ctype_of sized) &&
+                      gnu_function_target_type_equal ty (ctype_of sized)
+                | _ -> false end)) records in
+            (match selected with
+              | [(sym, _)] -> gnu_standard_zero_fill_call [] expr >>= fun clears ->
+                  E.return (if clears then Just sym else Nothing)
+              | _ -> E.return Nothing end)
+        | _ -> E.return Nothing end)
+  | _ -> E.return Nothing
+end
+
+(* Diagnostic conjunctions expose independent failed obligations without
+   changing the returned certificate. Normal runs retain short circuiting.
+   These actions inspect AIL and origin assumptions; they never execute C. *)
+val gnu_boundary_check_all: forall 'a.
+  ('a -> E.elabM bool) -> list 'a -> E.elabM bool
+let gnu_boundary_check_all predicate operands =
+  E.foldlM (fun accepted operand ->
+    if accepted || Debug.get_level () >= 2 then
+      predicate operand >>= fun result -> E.return (accepted && result)
+    else E.return false) true operands
+
+(* Equality can temporarily identify an incoming member with an unrelated
+   pointer. A literal-null store as the very first action of the true arm
+   erases that information before any use; an empty false arm adds no bound.
+   Restrict the other operand to a private pointer not covered by the origin
+   invariant, so the comparison cannot refine another certified value. *)
+val gnu_boundary_first_null_store:
+  A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_boundary_first_null_store stmt = match stmt.A.node with
+  | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEassign left right)) ->
+      if gnu_literal_null_pointer right && gnu_memory_expression_readonly left
+      then Just left else Nothing
+  | A.AilSblock [] (first :: _) -> gnu_boundary_first_null_store first
+  | _ -> Nothing
+end
+
+val gnu_boundary_erased_comparison:
+  gnu_boundary_return_resolver -> list Symbol.sym -> list Symbol.sym -> list Symbol.sym ->
+  A.statement GenTypes.genTypeCategory -> A.statement GenTypes.genTypeCategory ->
+  A.statement GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_boundary_erased_comparison returns private_locals values roots whole_body yes no
+    (A.AnnotatedExpression _ _ _ node as test) =
+  let self = gnu_boundary_erased_comparison returns private_locals values roots whole_body yes no in
+  if not (gnu_memory_expression_readonly test) ||
+      (match no.A.node with A.AilSskip -> false | _ -> true end)
+  then E.return false else match node with
+    | A.AilEbinary prefix A.And final_test ->
+        gnu_boundary_incoming_refinements returns values roots prefix >>= fun checked ->
+        if checked then self final_test else E.return false
+    | A.AilEbinary left A.Eq right ->
+        let erased incoming other = match (incoming, other, gnu_boundary_first_null_store yes) with
+          | (A.AnnotatedExpression _ _ _ (A.AilErvalue lvalue),
+             A.AnnotatedExpression _ _ _ (A.AilErvalue
+               (A.AnnotatedExpression _ _ _ (A.AilEident sym) as pointer_object)),
+             Just destination) ->
+              let (qs, ty) = qualified_ctype_of pointer_object in
+              let (member_qs, member_ty) = qualified_ctype_of lvalue in
+              let ordinary_member = match lvalue with
+                | A.AnnotatedExpression _ _ _ (A.AilEmemberofptr base _) ->
+                    (match ctype_of base with
+                      | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Struct _))) -> true
+                      | _ -> false end)
+                | _ -> false end in
+              if not ordinary_member || qs.Ctype.volatile || member_qs.Ctype.volatile ||
+                  AilTypesAux.is_atomic ty || AilTypesAux.is_atomic member_ty ||
+                  not (AilTypesAux.is_pointer ty && AilTypesAux.is_pointer member_ty) ||
+                  AilTypesAux.is_pointer_to_function ty || AilTypesAux.is_pointer_to_function member_ty ||
+                  not (List.elem sym private_locals) || List.elem sym values || List.elem sym roots ||
+                  not (gnu_alloc_size_subject_unescaped sym whole_body)
+              then E.return false else
+              (match (gnu_memory_indexed_key lvalue, gnu_memory_indexed_key destination) with
+                | (Just first, Just second) ->
+                    if first <> second then E.return false else
+                      gnu_boundary_origin_value_with returns values roots incoming
+                | _ -> E.return false end)
+          | _ -> E.return false end in
+        erased left right >>= fun first ->
+        if first then E.return true else erased right left
+    | A.AilEannot _ inner -> self inner
+    | _ -> E.return false
+  end
+
+(* A cleanup guard may refine one pointer member until the selected record is
+   cleared. This is a bounded observation window, not a blanket permission to
+   ignore pointer comparisons. Inside that window the member cannot be loaded,
+   its record cannot escape as an untyped/aggregate value, and every visible
+   callee is inspected. The separate effect census still checks every write. *)
+val gnu_cleanup_record_pointer: Ctype.ctype -> Ctype.ctype -> bool
+let gnu_cleanup_record_pointer record_ty ty = match ty with
+  | Ctype.Ctype _ (Ctype.Pointer _ pointed) ->
+      gnu_function_target_type_equal record_ty pointed
+  | _ -> false
+end
+
+val gnu_cleanup_unobserved_expression:
+  Ctype.ctype -> Symbol.identifier -> list Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+val gnu_cleanup_unobserved_statement:
+  Ctype.ctype -> Symbol.identifier -> list Symbol.sym -> bool ->
+  A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_cleanup_unobserved_expression record_ty member visited
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_cleanup_unobserved_expression record_ty member visited in
+  let every operands = gnu_boundary_check_all self operands in
+  if gnu_cleanup_record_pointer record_ty (ctype_of expr) ||
+      gnu_function_target_type_equal record_ty (ctype_of expr)
+  then E.return false else match node with
+    | A.AilEmemberofptr base ident ->
+        if gnu_cleanup_record_pointer record_ty (ctype_of base) then
+          (* The only use of a record pointer admitted here selects a different
+             ordinary member. Do not accept casts, arithmetic or alias stores
+             while evaluating that base. *)
+          E.return (ident <> member && isJust (gnu_inline_direct_pointer_symbol base) &&
+            gnu_memory_expression_readonly expr)
+        else self base
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee) then E.return false else
+        every args >>= fun arguments ->
+        if not arguments then E.return false else
+        gnu_call_attributes callee >>= fun attrs ->
+        if Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs
+        then E.return false else
+        gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+        gnu_standard_free_call expr >>= fun deallocates ->
+        gnu_standard_string_comparison_call expr >>= fun compares_strings ->
+        gnu_expression_calls_noreturn expr >>= fun exits ->
+        if opaque || deallocates || compares_strings || exits then E.return true else
+        gnu_inline_function_target callee >>= (function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              if List.elem target visited then E.return false else
+              E.gnu_memory_call_body target >>= function
+                | Just (params, body) ->
+                    if List.length params <> List.length args then E.return false else
+                      gnu_cleanup_unobserved_statement record_ty member (target :: visited) true body
+                | Nothing ->
+                    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr)
+                      (fun () -> "GNU cleanup unresolved call: " ^ Pp.stringFromAil_expression expr) in
+                    E.return false
+              end
+          end)
+    | A.AilEbinary left _ right -> every [left; right]
+    | A.AilEassign left right -> every [left; right]
+    | A.AilEcompoundAssign left _ right -> every [left; right]
+    | A.AilEcond test yes no -> every (test :: no :: maybe [] (fun value -> [value]) yes)
+    | A.AilErvalue operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEsizeof _ ty -> E.return (gnu_inline_fixed_object_type ty)
+    | A.AilEsizeof_expr operand -> E.return (gnu_inline_fixed_object_type (ctype_of operand))
+    | A.AilEalignof _ ty -> E.return (gnu_inline_fixed_object_type ty)
+    | A.AilEoffsetof ty _ -> E.return (gnu_inline_fixed_object_type ty)
+    | A.AilEident _ -> E.return true
+    | A.AilEconst _ -> E.return true
+    | A.AilEstr _ -> E.return true
+    | A.AilEbuiltin _ -> E.return true
+    | _ -> E.return false
+  end
+and gnu_cleanup_unobserved_statement record_ty member visited allow_return stmt =
+  let self = gnu_cleanup_unobserved_statement record_ty member visited allow_return in
+  let expression = gnu_cleanup_unobserved_expression record_ty member visited in
+  match stmt.A.node with
+    | A.AilSskip -> E.return true
+    | A.AilSexpr expr -> expression expr
+    | A.AilSblock [] statements -> gnu_boundary_check_all self statements
+    | A.AilSif test yes no -> expression test >>= fun condition ->
+        if not condition then E.return false else
+          self yes >>= fun first -> self no >>= fun second -> E.return (first && second)
+    | A.AilSreturn value -> if allow_return then expression value else E.return false
+    | A.AilSreturnVoid -> E.return allow_return
+    | A.AilSmarker _ body -> self body
+    | _ -> E.return false
+  end
+
+(* Follow only a straight-line, fixed-arity zeroing wrapper. Substitute its
+   unchanged formals into the first three operands, never into runtime code.
+   The fourth checked-bound operand is still inspected by the existing standard
+   call recognizer and translated normally; it is not a size assumption. *)
+val gnu_cleanup_clear_call:
+  Ctype.ctype -> Symbol.identifier -> A.expression GenTypes.genTypeCategory ->
+  list Symbol.sym -> list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+val gnu_cleanup_clear_sequence:
+  Ctype.ctype -> Symbol.identifier -> A.expression GenTypes.genTypeCategory ->
+  list Symbol.sym -> list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  list (A.statement GenTypes.genTypeCategory) -> E.elabM bool
+let rec gnu_cleanup_clear_call record_ty member pointer visited bindings
+    (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEcall callee args ->
+      if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+      then E.return false else
+      let actual value = if bindings = [] then Just value
+        else gnu_record_value_substitute bindings value in
+      let zeros = List.foldr (fun (sym, value) rest ->
+        if gnu_boundary_integer_zero [] value then sym :: rest else rest) [] bindings in
+      gnu_standard_zero_fill_call zeros expr >>= fun zero_call ->
+      if zero_call then E.return (match args with
+        | destination :: fill :: length :: rest ->
+            (match (actual destination, actual fill, actual length) with
+              | (Just destination, Just fill, Just length) ->
+                  List.length rest <= 1 && gnu_boundary_integer_zero [] fill &&
+                    (match (gnu_inline_direct_pointer_symbol destination,
+                            gnu_inline_direct_pointer_symbol pointer) with
+                      | (Just first, Just second) -> first = second
+                      | _ -> false end) &&
+                    (match length with
+                      | A.AnnotatedExpression _ _ _ (A.AilEsizeof _ sized) ->
+                          gnu_function_target_type_equal record_ty sized
+                      | A.AnnotatedExpression _ _ _ (A.AilEsizeof_expr sized) ->
+                          gnu_inline_fixed_object_type (ctype_of sized) &&
+                            gnu_function_target_type_equal record_ty (ctype_of sized)
+                      | _ -> false end)
+              | _ -> false end)
+        | _ -> false end)
+      else gnu_inline_function_target callee >>= (function
+        | Nothing -> E.return false
+        | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+            if List.elem target visited then E.return false else
+            E.gnu_memory_call_body target >>= function
+              | Nothing -> E.return false
+              | Just (params, body) ->
+                  let fixed = match ctype_of callee with
+                    | Ctype.Ctype _ (Ctype.Pointer _
+                        (Ctype.Ctype _ (Ctype.Function _ signature false))) ->
+                        List.length signature = List.length args
+                    | _ -> false end in
+                  if not fixed || List.length params <> List.length args ||
+                      not (List.all (fun param -> gnu_inline_parameter_unchanged param body &&
+                        gnu_alloc_size_subject_unescaped param body) params)
+                  then E.return false else
+                  let actuals = List.foldr (fun value acc -> match (actual value, acc) with
+                    | (Just value, Just values) -> Just (value :: values)
+                    | _ -> Nothing end) (Just []) args in
+                  (match (actuals, gnu_record_body_parts body) with
+                    | (Just values, Just ([], statements)) ->
+                        gnu_cleanup_clear_sequence record_ty member pointer (target :: visited)
+                          (List.zip params values) statements
+                    | _ -> E.return false end)
+            end
+        end)
