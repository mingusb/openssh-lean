+val gnu_opaque_pointer_updates_expression:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_opaque_pointer_updates_expression sym (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_opaque_pointer_updates_expression sym in
+  let direct operand = match operand with
+    | A.AnnotatedExpression _ _ _ (A.AilEident other) -> other = sym
+    | _ -> false end in
+  let offset operand = AilTypesAux.is_integer (ctype_of operand) &&
+    gnu_inline_parameter_expression_safe sym operand in
+  if gnu_inline_parameter_expression_safe sym expr then true else match node with
+    | A.AilEassign left right ->
+        if direct left then gnu_opaque_pointer_self_offset sym right
+        else self left && self right
+    | A.AilEcompoundAssign left aop right ->
+        if direct left then (aop = A.Add || aop = A.Sub) && offset right
+        else self left && self right
+    | A.AilEunary A.PostfixIncr operand -> direct operand
+    | A.AilEunary A.PostfixDecr operand -> direct operand
+    | A.AilEunary A.Address _ -> false
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEcond test yes no -> self test && maybe true self yes && self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin _)) _ -> false
+    | A.AilEcall callee args -> self callee && List.all self args
+    | _ -> false
+  end
