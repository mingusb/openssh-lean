+      gnu_local_output_memory_summary translate_expr tagDefs expr
+        <| st with E.fresh_supply= next.E.fresh_supply |>
+      else (result, next) in
+    let (result, next) = if isNothing result && next.E.errors = st.E.errors then
+      gnu_private_output_memory_summary translate_expr tagDefs caller expr
+        <| st with E.fresh_supply= next.E.fresh_supply |>
+      else (result, next) in
+    let (result, next) = if isNothing result && next.E.errors = st.E.errors then
+      gnu_conditional_output_memory_summary translate_expr tagDefs caller expr
+        <| st with E.fresh_supply= next.E.fresh_supply |>
+      else (result, next) in
+    (* Publish independent incoming-contents preservation together with the
+       exact output stores. The enclosing statement restores this whole-call
+       summary after translation, so keeping roots only in its inner expression
+       wrapper would immediately discard them again. Audit original entry state,
+       never the speculative output state's already modified facts. *)
+    let (result, next) = if next.E.errors <> st.E.errors then (result, next) else
+      let ((kept, roots), checked) =
+        (maybe (E.return ([], [])) (fun source ->
+          gnu_confined_output_call_survivors source expr) caller)
+          <| st with E.fresh_supply= next.E.fresh_supply |> in
+      let result = if roots = [] then result else
+        let (facts, existing, aliases) = maybe ([], [], []) (fun summary -> summary) result in
+        Just (facts ++ List.filter (fun (slot, _) ->
+          isNothing (List.lookup slot facts)) kept,
+          existing ++ List.filter (fun root -> not (List.elem root existing)) roots,
+          aliases) in
+      (result, checked) in
+    (* An independently confined caller-frame record cannot be reached by a
+       call that omits its borrowed formal. Compose only already-live, closed
+       pointer-member identities with the original whole-call summary. *)
+    let (result, next) = if next.E.errors <> st.E.errors then (result, next) else
+      let (kept, checked) = gnu_caller_frame_member_call_survivors tagDefs expr
+        <| st with E.fresh_supply= next.E.fresh_supply |> in
+      let result = if kept = [] then result else
+        let (facts, roots, aliases) = maybe ([], [], []) (fun summary -> summary) result in
+        Just (facts ++ List.filter (fun (slot, _) ->
+          isNothing (List.lookup slot facts)) kept, roots, aliases) in
+      (result, checked) in
+    (* Check current-point privacy against the original incoming state.
+       Opaque RHS calls may clear a speculative path even though they cannot
+       access this fresh caller object. Restore only its pointer identity;
+       static knowledge requires the independent whole-body survivor
+       certificate, and pointee contents remain absent. *)
+    let (result, next) = if next.E.errors <> st.E.errors then (result, next) else
+      let (kept, checked) = gnu_current_private_pointer_call_survivors tagDefs expr
+        <| st with E.fresh_supply= next.E.fresh_supply |> in
+      let result = if kept = [] then result else
+        let (facts, roots, aliases) = maybe ([], [], []) (fun summary -> summary) result in
+        Just (facts ++ List.filter (fun (slot, _) ->
+          isNothing (List.lookup slot facts)) kept, roots, aliases) in
+      (result, checked) in
+    (* Even a partial call summary replaces the caller's complete memory
+       snapshot. Compose it with independently certified whole-call survivors
+       from the original entry state: adding a current-private string pointer
+       must not erase an unrelated allocation bound or private scalar value.
+       The existing certificate checks every original operand and dependency,
+       strips pointee contents and drops non-singleton scalar density. New
+       output facts take precedence; no missing slot becomes an unknown fact. *)
+    let (result, next) = if next.E.errors <> st.E.errors || isNothing result
+      then (result, next) else
+      let (kept, checked) = gnu_memory_unescaped_value_survivors expr
+        <| st with E.fresh_supply= next.E.fresh_supply |> in
+      let (facts, roots, aliases) = fromJust "Translation.gnu_call_memory_summary" result in
+      (Just (facts ++ List.filter (fun (slot, _) ->
+        isNothing (List.lookup slot facts)) kept, roots, aliases), checked) in
+    (* Only closed facts leave the speculative transfer. Keep consumed fresh
+       identities unique in both backends; no errors, bindings or runtime code
+       produced by an unsuccessful optional analysis escape into the caller. *)
+    (if next.E.errors = st.E.errors then result else Nothing,
+     <| st with E.fresh_supply= next.E.fresh_supply |>)
+
+(* Argument evaluation remains in the original runtime call. For a single
+   comma argument with one direct integer update and a fixed pointer result,
+   transfer the update through the ordinary loop-store invalidation first.
+   All sibling argument values must be closed: their unspecified evaluation
+   order cannot change the captured call values. No arbitrary prefix, loaded
+   pointer, atomic access or conditional effect is summarized by this view. *)
+val gnu_loop_call_argument_view:
+  A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory * maybe (A.expression GenTypes.genTypeCategory))
+let rec gnu_loop_call_argument_view (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_memory_expression_readonly expr then Just (expr, Nothing) else match node with
+    | A.AilEbinary prefix A.Comma value ->
+        if not (gnu_loop_address_constant value &&
+            gnu_function_target_type_equal (ctype_of expr) (ctype_of value)) then Nothing else
+        let update left =
+          let (qs, ty) = qualified_ctype_of left in
+          if not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+              AilTypesAux.is_integer ty && gnu_loop_direct_lvalue left
+          then Just (value, Just left) else Nothing in
+        (match prefix with
+          | A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixIncr left) -> update left
+          | A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixDecr left) -> update left
+          | _ -> Nothing end)
+    | A.AilEannot _ operand ->
+        if gnu_function_target_type_equal (ctype_of expr) (ctype_of operand)
+        then gnu_loop_call_argument_view operand else Nothing
+    | _ -> Nothing
+  end
+
+val gnu_loop_call_transfer:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory -> gnu_closed_loop_state ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe gnu_closed_loop_state)
+let gnu_loop_call_transfer translate_expr tagDefs loop state
+    (A.AnnotatedExpression expr_ty annots loc node as expr) =
+  gnu_memory_certified_readonly expr >>= fun readonly ->
+  if readonly then E.return (Just state) else match node with
+    | A.AilEcall callee original_args ->
+        let views = List.map gnu_loop_call_argument_view original_args in
+        if List.any isNothing views then E.return Nothing else
+        let views = List.map (fromJust "Translation.gnu_loop_call_transfer") views in
+        let args = List.map fst views in
+        let updates = List.concat (List.map (fun (_, update) ->
+          maybe [] (fun left -> [left]) update) views) in
+        (match updates with
+          | [] -> E.return (Just state)
+          | [left] ->
+              if gnu_inline_direct_designator callee &&
+                  List.all (fun actual -> gnu_loop_address_constant actual ||
+                    gnu_inline_closed_integer_origin actual) args
+              then gnu_loop_store translate_expr tagDefs loop state left Nothing
+              else E.return Nothing
+          | _ -> E.return Nothing
+        end) >>= function
+          | Nothing -> E.return Nothing
+          | Just (facts, aliases) ->
+              gnu_inline_function_target callee >>= fun target ->
+              (match target with
+                | Just (declared, _) -> E.gnu_inline_target declared >>= fun sym -> E.gnu_memory_call_body sym
+                | Nothing -> E.return Nothing end) >>= fun body ->
+              let stable_destinations = match body with
+                | Just (params, body) -> List.length params = List.length args &&
+                    (match gnu_call_store_statements body with
+                      | Just (_, stores) -> List.all (fun (left, _) ->
+                          not (gnu_call_store_global_pointer (List.zip params args) left)) stores
+                      | _ -> false end)
+                | Nothing -> false end in
+              if not stable_destinations then E.return Nothing else
+              E.mapM (fun actual -> gnu_loop_invariant_pointer loop actual >>= fun invariant ->
+                E.return (gnu_loop_address_constant actual || gnu_inline_closed_integer_origin actual || invariant)) args >>= fun stable ->
+              if not (List.all (fun value -> value) stable) then E.return Nothing else
+              (* This expression is an abstract transfer input only. The source
+                 call, including its comma update, is still lowered once. *)
+              let summary_expr = A.AnnotatedExpression expr_ty annots loc (A.AilEcall callee args) in
+              fun st ->
+                let (summary, next) = gnu_call_memory_summary translate_expr tagDefs Nothing summary_expr
+                  <| st with E.gnu_memory_facts= facts; E.gnu_memory_opaque_roots= [];
+                    E.gnu_memory_root_invariants= []; E.gnu_memory_aliases= Map.fromList aliases |> in
+                let result = match summary with
+                  | Just (updated, _, updated_aliases) -> if List.all (fun ((indirect,_,_),fact) ->
+                      not indirect && gnu_member_fact_closed fact) updated
+                    then Just (List.map (fun (slot,fact) -> (slot,gnu_loop_without_contents fact)) updated,
+                      List.filter (fun (_, (indirect, _, _)) -> not indirect) updated_aliases) else Nothing
+                  | Nothing -> Nothing end in
+                (result, <| st with E.fresh_supply= next.E.fresh_supply |>)
+        end
+    | _ -> E.return Nothing
+  end
+
+val gnu_loop_transfer_expression:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory -> gnu_closed_loop_state ->
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe gnu_closed_loop_state)
+let gnu_loop_transfer_expression translate_expr tagDefs loop ((facts, aliases) as state)
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let analyze = if gnu_memory_expression_readonly expr then E.return (Just state) else match node with
+    | A.AilEassign left right -> gnu_loop_store translate_expr tagDefs loop state left (Just right)
+    | A.AilEcall _ _ -> gnu_loop_call_transfer translate_expr tagDefs loop state expr
+    | A.AilEcompoundAssign left _ right ->
+        if gnu_memory_expression_readonly right then gnu_loop_store translate_expr tagDefs loop state left Nothing
+        else E.return Nothing
+    | A.AilEunary A.PostfixIncr left -> gnu_loop_store translate_expr tagDefs loop state left Nothing
+    | A.AilEunary A.PostfixDecr left -> gnu_loop_store translate_expr tagDefs loop state left Nothing
+    | A.AilEbinary (A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixDecr left)) A.Gt
+        (A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant number _ _)))) ->
+        if number = 0 then gnu_loop_store translate_expr tagDefs loop state left Nothing else E.return Nothing
+    | _ -> E.return Nothing
+  end in
+  fun st ->
+    let (result, next) = analyze <| st with E.gnu_memory_facts= facts;
+      E.gnu_memory_aliases= Map.fromList aliases |> in
+    (if next.E.errors = st.E.errors then result else Nothing,
+      <| st with E.fresh_supply= next.E.fresh_supply |>)
+
+type gnu_loop_paths =
+  maybe (list (E.gnu_memory_slot * E.gnu_inline_fact)) *
+  maybe (list (E.gnu_memory_slot * E.gnu_inline_fact)) *
+  maybe (list (E.gnu_memory_slot * E.gnu_inline_fact))
+
+(* None means no path, not an unknown memory state. Unsupported analysis is
+   the outer Nothing; a reachable path with no certified slots is Just []. *)
+let gnu_loop_merge_path first second = match (first, second) with
+  | (Nothing, other) -> other
+  | (other, Nothing) -> other
+  | (Just left, Just right) -> Just (gnu_loop_join left right)
+end
+
+let gnu_loop_merge_paths (normal1, break1, continue1) (normal2, break2, continue2) =
+  (gnu_loop_merge_path normal1 normal2, gnu_loop_merge_path break1 break2,
+    gnu_loop_merge_path continue1 continue2)
+
+val gnu_loop_transfer_paths:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory -> Symbol.sym -> list Symbol.sym ->
+  gnu_closed_loop_state -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe gnu_closed_loop_paths)
+let rec gnu_loop_transfer_paths translate_expr tagDefs loop break_sym continue_syms facts stmt =
+  let self = gnu_loop_transfer_paths translate_expr tagDefs loop break_sym continue_syms in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> E.return Nothing
+    | A.AilSskip -> E.return (Just (Just facts, Nothing, Nothing))
+    | A.AilSexpr expr ->
+        if not (gnu_dead_arm_expression_closed expr) then E.return Nothing else
+        gnu_loop_transfer_expression translate_expr tagDefs loop facts expr >>= fun result ->
+        E.return (maybe Nothing (fun facts -> Just (Just facts, Nothing, Nothing)) result)
+    | A.AilSblock [] statements ->
+        State.foldlM (fun state child -> match state with
+          | Nothing -> E.return Nothing
+          | Just (normal, breaks, continues) ->
+              (* Even unreachable lexical tails must contain no hidden entry
+                 labels or transfers. Validate them, but add no exit paths. *)
+              self (maybe ([], []) (fun facts -> facts) normal) child >>= fun result ->
+              E.return (match (normal, result) with
+                | (_, Nothing) -> Nothing
+                | (Nothing, Just _) -> Just (Nothing, breaks, continues)
+                | (Just _, Just (next, new_breaks, new_continues)) ->
+                    Just (next, gnu_closed_loop_merge_path breaks new_breaks,
+                      gnu_closed_loop_merge_path continues new_continues)
+                end)
+          end) (Just (Just facts, Nothing, Nothing)) statements
+    | A.AilSif test left right ->
+        if not (gnu_dead_arm_expression_closed test) then E.return Nothing else
+        (* The condition executes before either arm. The same bounded
+           transfer used for the loop test admits a direct scalar update
+           while invalidating its old value; arbitrary calls/effects still
+           fail that transfer. Never select an arm using a pre-update value. *)
+        gnu_loop_transfer_expression translate_expr tagDefs loop facts test >>= function
+          | Nothing -> E.return Nothing
+          | Just after_test ->
+          self after_test left >>= fun first -> self after_test right >>= fun second ->
+          E.return (match (first, second) with
+            | (Just yes, Just no) -> Just (match (if gnu_memory_expression_readonly test
+                then gnu_constant_truth tagDefs test else Nothing) with
+                | Just true -> yes | Just false -> no | Nothing -> gnu_closed_loop_merge_paths yes no end)
+            | _ -> Nothing end)
+        end
+    | A.AilSgoto target ->
+        E.return (if target = break_sym then Just (Nothing, Just facts, Nothing)
+          else if List.elem target continue_syms then Just (Nothing, Nothing, Just facts)
+          else Nothing)
+    | A.AilSlabel target body (Just (Annot.LAloop_continue _)) ->
+        E.return (if List.elem target continue_syms && (match body.A.node with A.AilSskip -> true | _ -> false end)
+          then Just (Just facts, Nothing, Nothing) else Nothing)
+    | A.AilSmarker _ body -> self facts body
+    | _ -> E.return Nothing
+  end
+
+(* Cabs already introduces a trailing continue label; loop-control erasure
+   can add another transparent wrapper. Only annotated skip labels in the
+   trailing block chain are equivalent to this loop's backedge. A for-step
+   label with an increment body is not such a continuation. *)
+val gnu_loop_tail_continue_labels: nat -> A.statement GenTypes.genTypeCategory -> list Symbol.sym
+let rec gnu_loop_tail_continue_labels loop_id stmt = match stmt.A.node with
+  | A.AilSvla_scope _ _ _ _ -> []
+  | A.AilSlabel target body (Just (Annot.LAloop_continue continue_id)) ->
+      if loop_id = continue_id && (match body.A.node with A.AilSskip -> true | _ -> false end)
+      then [target] else []
+  | A.AilSblock [] statements ->
+      let (_, labels) = List.foldl (fun (open_tail, labels) child ->
+        if not open_tail then (false, labels) else
+        let found = gnu_loop_tail_continue_labels loop_id child in
+        let transparent = match child.A.node with
+          | A.AilSskip -> true
+          | A.AilSlabel _ _ _ -> not (List.null found)
+          | _ -> false end in
+        (transparent, found ++ labels)
+      ) (true, []) (List.reverse statements) in labels
+  | A.AilSmarker _ body -> gnu_loop_tail_continue_labels loop_id body
+  | _ -> []
+end
+
+val gnu_loop_continue_label: nat -> A.statement GenTypes.genTypeCategory -> maybe (list Symbol.sym)
+let gnu_loop_continue_label loop_id body = match body.A.node with
+  | A.AilSblock [] [_; label] -> match label.A.node with
+      | A.AilSlabel _ tail (Just (Annot.LAloop_continue continue_id)) ->
+          if loop_id = continue_id && (match tail.A.node with A.AilSskip -> true | _ -> false end)
+          then Just (gnu_loop_tail_continue_labels loop_id body) else Nothing
+      | _ -> Nothing end
+  | _ -> Nothing
+end
+
+val gnu_loop_straightline: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_loop_straightline stmt = match stmt.A.node with
+  | A.AilSvla_scope _ _ _ _ -> false
+  | A.AilSskip -> true
+  | A.AilSexpr expr -> gnu_dead_arm_expression_closed expr
+  | A.AilSblock [] statements -> List.all gnu_loop_straightline statements
+  | A.AilSlabel _ body (Just (Annot.LAloop_continue _)) ->
+      (match body.A.node with A.AilSskip -> true | _ -> false end)
+  | A.AilSmarker _ body -> gnu_loop_straightline body
+  | _ -> false
+end
+
+(* Source labels may be entered from outside the loop. Compare their incoming
+   jumps with the whole, expression-control-closed function before allowing an
+   unchanged private object's loop-entry fact at those labels. Compiler-created
+   loop labels keep their existing owner checks. *)
+val gnu_loop_internal_source_labels:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM (list Symbol.sym)
+let gnu_loop_internal_source_labels function_sym loop =
+  let labels = gnu_source_statement_labels loop in
+  if labels = [] then E.return [] else
+  E.gnu_memory_call_body function_sym >>= function
+    | Nothing -> E.return []
+    | Just (_, body) ->
+        if not (gnu_labels_expressions_closed body && gnu_labels_expressions_closed loop)
+        then E.return [] else
+        let inside = gnu_statement_goto_targets loop in
+        let whole = gnu_statement_goto_targets body in
+        let whole_labels = gnu_source_statement_labels body in
+        let occurrences target values = List.length (List.filter (fun value -> value = target) values) in
+        E.return (List.filter (fun label ->
+          occurrences label labels = 1 && occurrences label whole_labels = 1 &&
+          occurrences label inside = occurrences label whole) labels)
+  end
+
+(* These invariants do not depend on iteration count. Exclude alternate entry
+   and hidden control; a generated for-loop increment label remains ordinary
+   body code and must belong to this loop. Mutable-copy summaries stay separate. *)
+val gnu_loop_invariant_body_closed: list Symbol.sym -> nat -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_loop_invariant_body_closed labels loop_id stmt =
+  let self = gnu_loop_invariant_body_closed labels loop_id in match stmt.A.node with
+    | A.AilSskip -> true
+    | A.AilSexpr expr -> gnu_dead_arm_expression_closed expr
+    | A.AilSblock [] [loop; exit_label] ->
+        let owner = match (loop.A.node, exit_label.A.node) with
+          | (A.AilSwhile _ _ nested_id,
+             A.AilSlabel _ tail (Just (Annot.LAloop_break break_id))) ->
+              if nested_id = break_id && (match tail.A.node with A.AilSskip -> true | _ -> false end)
+              then Just nested_id else Nothing
+          | (A.AilSdo _ _ nested_id,
+             A.AilSlabel _ tail (Just (Annot.LAloop_break break_id))) ->
+              if nested_id = break_id && (match tail.A.node with A.AilSskip -> true | _ -> false end)
+              then Just nested_id else Nothing
+          | _ -> Nothing end in
+        (match owner with
+          | Just nested_id -> gnu_loop_invariant_body_closed labels nested_id loop
+          | Nothing -> self loop && self exit_label end)
+    | A.AilSblock bindings statements ->
+        List.all (function
+          | (_, ((_, A.Automatic, _), _, qs, ty)) -> not qs.Ctype.volatile &&
+              not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings && List.all self statements
+    | A.AilSdeclaration declarations ->
+        List.all (fun (_, value) -> maybe true gnu_dead_arm_expression_closed value) declarations
+    | A.AilSif test yes no -> gnu_dead_arm_expression_closed test && self yes && self no
+    | A.AilSwhile test body nested_id ->
+        gnu_dead_arm_expression_closed test && gnu_loop_invariant_body_closed labels nested_id body
+    | A.AilSdo body test nested_id ->
+        gnu_loop_invariant_body_closed labels nested_id body && gnu_dead_arm_expression_closed test
+    | A.AilSswitch test body -> gnu_dead_arm_expression_closed test && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_continue continue_id)) ->
+        continue_id = loop_id && self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_break break_id)) ->
+        break_id = loop_id && self body
+    | A.AilSlabel _ body (Just Annot.LAswitch) -> self body
+    | A.AilSlabel label body Nothing -> List.elem label labels && self body
+    (* The independent certificate rules out outside entries at these labels.
+       Outward exits cannot invalidate an unchanged private object's identity. *)
+    | A.AilSgoto _ -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSreturnVoid -> true
+    | A.AilSreturn value -> gnu_dead_arm_expression_closed value
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+(* A case belonging to a switch outside this body is an alternate entry.
+   Cases under a nested switch are reached only after this body's own entry. *)
+val gnu_loop_outer_case_entry: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_loop_outer_case_entry stmt =
+  let self = gnu_loop_outer_case_entry in match stmt.A.node with
+    | A.AilScase _ _ -> true
+    | A.AilScase_rangeGNU _ _ _ -> true
+    | A.AilSdefault _ -> true
+    | A.AilSswitch _ _ -> false
+    | A.AilSblock _ statements -> List.any self statements
+    | A.AilSif _ yes no -> self yes || self no
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+val gnu_opaque_single_return:
+  A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_opaque_single_return stmt = match stmt.A.node with
+  | A.AilSreturn value -> Just value
+  | A.AilSblock [] [child] -> gnu_opaque_single_return child
+  | A.AilSmarker _ child -> gnu_opaque_single_return child
+  | _ -> Nothing
+end
+
+(* An unavailable-body call contributes the full compiler-visible integer
+   result domain. Forwarding wrappers may only select among such results; a
+   constant, conversion, arithmetic transform or recursive call declines. *)
+val gnu_opaque_integer_result:
+  list Symbol.sym -> Ctype.ctype -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_opaque_integer_result seen result_ty (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_opaque_integer_result seen result_ty in
+  let reject = fun reason ->
+    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+      "GNU opaque result rejected; gate=" ^ reason ^ "; expression=" ^ Pp.stringFromAil_expression expr) in
+    E.return false in
+  if not (AilTypesAux.is_integer result_ty &&
+    gnu_function_target_type_equal result_ty (ctype_of expr)) then reject "result-type" else
+  match node with
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcond test (Just yes) no ->
+        if not (gnu_memory_expression_readonly test) then reject "conditional-effects" else
+        self yes >>= fun first -> self no >>= fun second -> E.return (first && second)
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee &&
+          List.all gnu_memory_expression_readonly args) then reject "direct-call-or-argument-effects" else
+        gnu_call_attributes callee >>= fun attrs ->
+        if Cerb_attributes.has_gnu_noarg_attribute "noreturn" attrs ||
+          Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs then reject "nonreturning-control" else
+        gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+        (* The pinned fortified read symbol is an external result boundary, not
+           a compiler-folded value builtin. The generic reserved-name filter
+           intentionally excludes it, so require its complete source-free ABI
+           certificate separately. This is compiler-visible result uncertainty,
+           not a claim that every integer is a feasible runtime read result. *)
+        (if opaque then E.return true else gnu_standard_fortified_read_call expr) >>= fun opaque_result ->
+        if opaque_result then E.return true else gnu_inline_function_target callee >>= function
+          | Nothing -> reject "direct-target"
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              if List.elem target seen then reject "recursive-wrapper" else
+              (* A registered GNU-inline body is also an explicit body
+                 authority. Its attributes can exclude the ordinary memory-call
+                 census without making the forwarded result unavailable. *)
+              E.gnu_inline_template target >>= fun template ->
+              (match template with
+                | Just body -> E.return (Just body)
+                | Nothing -> E.gnu_memory_call_body target end) >>= function
+                | Nothing -> reject "wrapper-body-authority"
+                | Just (params, body) ->
+                    let types = match ctype_of callee with
+                      | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ types false))) ->
+                          List.map (fun (_, ty, _) -> ty) types
+                      | _ -> [] end in
+                    (* This proof transports only the forwarded opaque result,
+                       never argument values, ranges or pointee facts. AIL keeps
+                       pre-conversion argument types, so use the existing origin
+                       relation here. The result type/domain equality above and
+                       the real runtime argument conversions remain unchanged. *)
+                    let exact = List.map (fun (ty, actual) ->
+                      gnu_function_target_type_equal ty (ctype_of actual)) (List.zip types args) in
+                    let compatible = List.map (fun (ty, actual) ->
+                      gnu_origin_actual_compatible ty actual ||
+                         (* This transports only the opaque integer result,
+                            never pointee facts. Keep actual call conversions. *)
+                         match (ty, ctype_of actual) with
+                           | (Ctype.Ctype formal_annotations
+                               (Ctype.Pointer formal_qs (Ctype.Ctype _ Ctype.Void)),
+                              Ctype.Ctype actual_annotations
+                               (Ctype.Pointer actual_qs pointed)) ->
+                               not (AilTypesAux.is_function pointed || AilTypesAux.is_atomic pointed) &&
+                               not (formal_qs.Ctype.volatile || actual_qs.Ctype.volatile) &&
+                               (formal_qs.Ctype.const || not actual_qs.Ctype.const) &&
+                               gnu_function_target_annotations formal_annotations =
+                                 gnu_function_target_annotations actual_annotations
+                           | _ -> false end) (List.zip types args) in
+                    let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+                      "GNU opaque wrapper argument admission; parameters=" ^ show (List.length params) ^
+                      "; arguments=" ^ show (List.length args) ^
+                      "; formal-types=" ^ show (List.map (Pp.stringFromAil_ctype Ctype.no_qualifiers) types) ^
+                      "; actual-types=" ^ show (List.map (fun actual ->
+                        Pp.stringFromAil_ctype Ctype.no_qualifiers (ctype_of actual)) args) ^
+                      "; exact=" ^ show exact ^ "; origin-compatible=" ^ show compatible) in
+                    if List.length params <> List.length args ||
+                      List.length types <> List.length args || not (List.all (fun yes -> yes) compatible)
+                    then reject "wrapper-signature" else match gnu_opaque_single_return body with
+                      | Just value -> gnu_opaque_integer_result (target :: seen) result_ty value
+                      | Nothing -> reject "wrapper-return-shape" end
+              end
+        end
+    | _ -> reject "expression-shape"
+  end
+
+(* Discard only lexical wrappers and this loop's trailing skip continuation.
+   Keep declarations, guards and updates in source evaluation order. *)
+val gnu_opaque_step_statements:
+  nat -> A.statement GenTypes.genTypeCategory -> maybe (list (A.statement GenTypes.genTypeCategory))
+let rec gnu_opaque_step_statements loop_id stmt =
+  let self = gnu_opaque_step_statements loop_id in match stmt.A.node with
+    | A.AilSskip -> Just []
+    | A.AilSblock _ statements -> List.foldr (fun child rest ->
+        match (self child, rest) with
+          | (Just first, Just second) -> Just (first ++ second)
+          | _ -> Nothing end) (Just []) statements
+    | A.AilSmarker _ body -> self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_continue continue_id)) ->
+        if continue_id = loop_id && (match body.A.node with A.AilSskip -> true | _ -> false end)
+        then Just [] else Nothing
+    | A.AilSdeclaration _ -> Just [stmt]
+    | A.AilSif _ _ _ -> Just [stmt]
+    | A.AilSexpr _ -> Just [stmt]
+    | _ -> Nothing
+  end
+
+(* The false path must be side-effect free. A false left operand permits an
+   unevaluated right operand, as in result == -1 && errno == EINTR. *)
+val gnu_opaque_step_guard_false:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_opaque_step_guard_false tagDefs (A.AnnotatedExpression _ _ _ node as test) =
+  let ordinary = if not (gnu_memory_expression_readonly test) then E.return false else
+    gnu_scalar_knowledge_of tagDefs test >>= fun info ->
+      E.return (maybe false (fun (low, high, _) -> low = 0 && high = 0) info) in
+  match node with
+    | A.AilEbinary left A.And right ->
+        gnu_opaque_step_guard_false tagDefs left >>= fun first ->
+        if first then E.return true else ordinary
+    | _ -> ordinary
+  end
+
+(* This certificate is for compiler alternatives at an opaque-call boundary,
+   not concrete witnesses for an unavailable function implementation. Starting
+   at zero, each positive result up to upper reaches the next entry without
+   overflow; zero is the initial entry. No interval bound alone is promoted. *)
+val gnu_opaque_step_loop_dense:
+  C.core_tag_definitions -> Symbol.sym -> Ctype.ctype -> integer ->
+  nat -> A.statement GenTypes.genTypeCategory -> E.elabM bool
+let gnu_opaque_step_loop_dense tagDefs counter counter_ty upper loop_id body =
+  let flattened = gnu_opaque_step_statements loop_id body in
+  let () = Debug.print_debug_located 2 [Debug.DB_elaboration] body.A.loc (fun () ->
+    "GNU opaque step candidate; counter=" ^ show counter ^ "; upper=" ^ show upper ^
+    "; flattened=" ^ show (maybe Nothing (fun statements -> Just (List.length statements)) flattened)) in
+  match flattened with
+    | Just (declaration :: rest) -> (match (declaration.A.node, List.dest_init rest) with
+        | (A.AilSdeclaration [(result, Just value)], Just (guards, update)) ->
+            (match update.A.node with
+              | A.AilSexpr (A.AnnotatedExpression _ _ _
+                  (A.AilEcompoundAssign
+                    (A.AnnotatedExpression _ _ _ (A.AilEident target)) A.Add
+                    (A.AnnotatedExpression _ _ _
+                      (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident source)))))) ->
+                  let result_ty = List.lookup result (gnu_typed_statement_local_types body) in
+                  let () = Debug.print_debug_located 2 [Debug.DB_elaboration] body.A.loc (fun () ->
+                    "GNU opaque step shape; target-match=" ^ show (target = counter) ^
+                    "; source-match=" ^ show (source = result) ^
+                    "; result-unescaped=" ^ show (gnu_alloc_size_subject_unescaped result body) ^
+                    "; counter-value-safe=" ^ show (gnu_inline_parameter_expression_safe counter value) ^
+                    "; result-value-safe=" ^ show (gnu_inline_parameter_expression_safe result value) ^
+                    "; result-type=" ^ maybe "absent" (Pp.stringFromAil_ctype Ctype.no_qualifiers) result_ty ^
+                    "; initializer-type=" ^ Pp.stringFromAil_ctype Ctype.no_qualifiers (ctype_of value)) in
+                  if target <> counter || source <> result || result = counter ||
+                    not (gnu_alloc_size_subject_unescaped result body &&
+                      gnu_inline_parameter_expression_safe counter value &&
+                      gnu_inline_parameter_expression_safe result value)
+                  then E.return false else (match result_ty with
+                    | Just result_ty ->
+                        if not (gnu_function_target_type_equal result_ty (ctype_of value)) then E.return false else
+                        (match (gnu_scalar_type_bounds counter_ty, gnu_scalar_type_bounds result_ty,
+                          gnu_scalar_common_type counter_ty result_ty) with
+                          | (Just (counter_min, counter_max), Just (result_min, result_max), Just common) ->
+                              let () = Debug.print_debug_located 2 [Debug.DB_elaboration] body.A.loc (fun () ->
+                                "GNU opaque step integer ranges; counter=" ^ show (counter_min, counter_max) ^
+                                "; result=" ^ show (result_min, result_max) ^
+                                "; common-cast-preserves-range=" ^ show (gnu_scalar_cast common (0, upper, true) = Just (0, upper, true))) in
+                              if counter_min <> 0 || upper <= 0 || upper > counter_max ||
+                                result_min > 1 || upper > result_max ||
+                                gnu_scalar_cast common (0, upper, true) <> Just (0, upper, true)
+                              then E.return false else
+                              gnu_opaque_integer_result [] result_ty value >>= fun opaque ->
+                              let () = Debug.print_debug_located 2 [Debug.DB_elaboration] body.A.loc (fun () ->
+                                "GNU opaque step initializer boundary; accepted=" ^ show opaque) in
+                              if not opaque then E.return false else
+                              E.with_gnu_closed_parameters
+                                [(result, E.GNU_inline_integer_range_fact 1 upper true)]
+                                (E.mapM (fun guard -> match guard.A.node with
+                                  | A.AilSif test _ no ->
+                                      if (match no.A.node with A.AilSskip -> true | _ -> false end) &&
+                                        gnu_inline_parameter_expression_safe counter test &&
+                                        gnu_inline_parameter_expression_safe result test
+                                      then gnu_opaque_step_guard_false tagDefs test else E.return false
+                                  | _ -> E.return false end) guards) >>= fun checked ->
+                              let () = Debug.print_debug_located 2 [Debug.DB_elaboration] body.A.loc (fun () ->
+                                "GNU opaque step positive-result guards; accepted=" ^ show checked) in
+                              E.return (List.all (fun yes -> yes) checked)
+                          | _ -> E.return false end)
+                    | Nothing -> E.return false end)
+              | _ -> E.return false end)
+        | _ -> E.return false end)
+    | _ -> E.return false
+  end
+
+(* A body-entry range is not a loop invariant: ordinary stores revoke it.
+   Every while entry follows the pure guard. A do-loop additionally needs its
+   initial incoming range inside that guard domain. Reject source labels and
+   hidden control, and never infer density or an attainable value from a bound. *)
+val gnu_loop_body_scalar_facts:
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_loop_body_scalar_facts tagDefs stmt =
+  let loop = match stmt.A.node with
+    | A.AilSwhile test body loop_id -> Just (false, test, body, loop_id)
+    | A.AilSdo body test loop_id -> Just (true, test, body, loop_id)
+    | _ -> Nothing end in
+  match loop with
+    | Nothing -> E.return []
+    | Just (is_do, test, body, loop_id) ->
+        if not (gnu_memory_expression_readonly test &&
+          gnu_loop_invariant_body_closed [] loop_id body) ||
+            gnu_loop_outer_case_entry body then E.return [] else
+        let attempt subject constant bop =
+          gnu_scalar_guard_object subject >>= fun stored ->
+          match (stored, gnu_scalar_closed_integer tagDefs constant,
+            gnu_scalar_common_type (ctype_of subject) (ctype_of constant)) with
+            | (Just (((false, sym, []) as slot), stored_ty), Just number, Just common) ->
+                E.gnu_alloc_size_subject_allowed sym >>= fun unescaped ->
+                if not unescaped then E.return [] else
+                (match (gnu_scalar_type_bounds stored_ty, gnu_scalar_type_bounds common,
+                  gnu_scalar_cast common (number, number, true)) with
+                  | (Just (low, high), Just (minimum, maximum), Just (value, same, _)) ->
+                      if minimum > low || maximum < high || value <> same then E.return [] else
+                      let bounds = match bop with
+                        | A.Lt -> Just (low, min high (value-1))
+                        | A.Le -> Just (low, min high value)
+                        | A.Gt -> Just (max low (value+1), high)
+                        | A.Ge -> Just (max low value, high)
+                        | A.Eq -> Just (max low value, min high value)
+                        | _ -> Nothing end in
+                      (match bounds with
+                        | Nothing -> E.return []
+                        | Just (lower, upper) ->
+                            if lower > upper then E.return [] else
+                            (if is_do then gnu_scalar_knowledge_of tagDefs subject >>= fun incoming ->
+                              E.return (match incoming with
+                                | Just (first, last, _) -> lower <= first && last <= upper
+                                | Nothing -> false end)
+                             else E.return true) >>= fun entry_safe ->
+                            (if entry_safe && is_do && lower = 0 then
+                              gnu_scalar_knowledge_of tagDefs subject >>= fun incoming ->
+                              if maybe false (fun (first, last, _) -> first = 0 && last = 0) incoming
+                              then gnu_opaque_step_loop_dense tagDefs sym stored_ty upper loop_id body
+                              else E.return false
+                             else E.return false) >>= fun dense ->
+                            E.return (if entry_safe then
+                              [(slot, E.GNU_inline_integer_range_fact lower upper dense)] else [])
+                      end)
+                  | _ -> E.return [] end)
+            | _ -> E.return []
           end
+        in
+        match test with
+          | A.AnnotatedExpression _ _ _ (A.AilEbinary left bop right) ->
+              attempt left right bop >>= fun first ->
+              if first <> [] then E.return first else
+              let bop_flipped = match bop with
+                | A.Lt -> A.Gt | A.Le -> A.Ge | A.Gt -> A.Lt | A.Ge -> A.Le
+                | bop_other -> bop_other end in
+              attempt right left bop_flipped
+          | _ -> E.return []
+        end
+  end
+
+(* This exit relation covers the counted pointer walk, not a fixed-point
+   approximation to arbitrary pointer loops. Each completed iteration must have
+   exactly one literal pointee store/advance followed by one counter increment. *)
+val gnu_counted_pointer_body:
+  nat -> A.statement GenTypes.genTypeCategory ->
+  maybe (list (A.expression GenTypes.genTypeCategory))
+let rec gnu_counted_pointer_body loop_id stmt =
+  let self = gnu_counted_pointer_body loop_id in
+  match stmt.A.node with
+    | A.AilSskip -> Just []
+    | A.AilSexpr expr -> Just [expr]
+    | A.AilSblock [] statements ->
+        List.foldr (fun child rest -> match (self child, rest) with
+          | (Just first, Just second) -> Just (first ++ second)
+          | _ -> Nothing end) (Just []) statements
+    | A.AilSmarker _ child -> self child
+    | A.AilSlabel _ child (Just (Annot.LAloop_continue continue_id)) ->
+        if continue_id = loop_id then self child else Nothing
+    | _ -> Nothing
+  end
+
+(* This syntactic certificate is shared by the executable snapshot prepass
+   and the exit fact. An unsigned counter cannot wrap while it is less than a
+   same-type bound. No other body shape is admitted by this certificate. *)
+val gnu_counted_pointer_loop:
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory ->
+  maybe (Symbol.sym * Ctype.ctype * A.expression GenTypes.genTypeCategory *
+    Symbol.sym * Ctype.ctype)
+let gnu_counted_pointer_loop tagDefs stmt = match stmt.A.node with
+  | A.AilSwhile (A.AnnotatedExpression _ _ _
+      (A.AilEbinary
+        (A.AnnotatedExpression _ _ _
+          (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident counter) as counter_lvalue)) as index)
+        A.Lt bound)) body loop_id ->
+    (match gnu_counted_pointer_body loop_id body with
+      | Just [A.AnnotatedExpression _ _ _
+          (A.AilEassign
+            (A.AnnotatedExpression _ _ _ (A.AilEunary A.Indirection
+              (A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixIncr
+                (A.AnnotatedExpression _ _ _ (A.AilEident pointer) as pointer_lvalue)))) as destination)
+            value);
+          A.AnnotatedExpression _ _ _
+            (A.AilEunary A.PostfixIncr (A.AnnotatedExpression _ _ _ (A.AilEident updated_counter)))] ->
+        let (counter_qs, counter_ty) = qualified_ctype_of counter_lvalue in
+        let (pointer_qs, pointer_ty) = qualified_ctype_of pointer_lvalue in
+        let (destination_qs, destination_ty) = qualified_ctype_of destination in
+        if counter <> updated_counter || counter = pointer ||
+            counter_qs.Ctype.volatile || pointer_qs.Ctype.volatile || destination_qs.Ctype.volatile ||
+            AilTypesAux.is_atomic counter_ty || AilTypesAux.is_atomic pointer_ty ||
+            AilTypesAux.is_atomic destination_ty || not (AilTypesAux.is_pointer pointer_ty) ||
+            not (gnu_memory_expression_readonly bound) ||
+            not (counter_ty = ctype_of bound ||
+              (match (gnu_scalar_type_bounds counter_ty, gnu_scalar_closed_integer tagDefs bound) with
+                | (Just (minimum, maximum), Just value) -> minimum = 0 && 0 <= value && value <= maximum
+                | _ -> false end)) ||
+            not (gnu_inline_closed_integer_origin value) || gnu_size_effects value <> Just false ||
+            not (gnu_inline_fixed_object_type destination_ty) ||
+            not (match gnu_scalar_type_bounds counter_ty with
+              | Just (low, _) -> low = 0 | _ -> false end)
+        then Nothing else Just (counter, counter_ty, index, pointer, destination_ty)
+      | _ -> Nothing end)
+  | _ -> Nothing
+end
+
+(* GCC's maximum-size pass takes the maximum of the counted loop header's
+   entry and decreasing backedge extents. This is a compiler upper-bound
+   profile, not a claim that zero iterations or every counter bound is
+   attainable. A guard may remove density while retaining those numeric
+   bounds. Keep the closed allocation, nonnegative constant displacement,
+   zero initial counter and zero-inclusive nonconstant unsigned bound gates.
+   The dynamic result still uses the original executed counter difference;
+   other loops and static modes retain their previous handling. *)
+val gnu_counted_closed_allocation_origin: C.core_tag_definitions -> E.gnu_inline_fact -> bool
+let rec gnu_counted_closed_allocation_origin tagDefs fact = match fact with
+  | E.GNU_inline_constant_alloc_size_fact size ->
+      (match gnu_scalar_closed_integer tagDefs size with Just n -> n >= 0 | _ -> false end)
+  | E.GNU_inline_offset_extent_fact base index element_ty false dependencies ->
+      dependencies = [] && gnu_inline_fixed_object_type element_ty &&
+        (match gnu_scalar_closed_integer tagDefs index with Just n -> n >= 0 | _ -> false end) &&
+        gnu_counted_closed_allocation_origin tagDefs base
+  | _ -> false
+end
+
+val gnu_counted_static_upper_allowed:
+  C.core_tag_definitions -> E.gnu_inline_fact -> A.expression GenTypes.genTypeCategory ->
+  Ctype.ctype -> A.statement GenTypes.genTypeCategory -> E.elabM bool
+let gnu_counted_static_upper_allowed tagDefs fact index element_ty stmt =
+  if not (Implementation.has_amd64_sysv_abi () &&
+      gnu_counted_closed_allocation_origin tagDefs fact &&
+      gnu_inline_closed_extent_fact false fact &&
+      gnu_scalar_sizeof tagDefs element_ty = Just 1)
+  then E.return false else match stmt.A.node with
+    | A.AilSwhile (A.AnnotatedExpression _ _ _ (A.AilEbinary _ A.Lt bound)) _ _ ->
+        gnu_scalar_knowledge_of tagDefs index >>= fun entry ->
+        gnu_scalar_knowledge_of tagDefs bound >>= fun limit ->
+        (match (entry, limit) with
+          | (Just (entry_low, entry_high, _), Just (bound_low, high, dense)) ->
+              if not (entry_low = 0 && entry_high = 0 && bound_low = 0 && high > 0)
+              then E.return false else if dense then E.return true else
+              (* Numerical bounds still require live positive certificates.
+                 A missing scalar fact's type-range fallback is insufficient.
+                 Restrict this additional profile to unchanged private scalar
+                 reads; no unknown/member/call result is reconstructed. *)
+              (match gnu_alloc_size_dependencies bound with
+                | Just reads ->
+                    if reads = [] then E.return false else
+                    E.mapM (fun (sym, _) ->
+                      E.gnu_alloc_size_subject_allowed sym >>= fun private_subject ->
+                      E.gnu_compiler_fact sym >>= fun current ->
+                      E.return (private_subject && gnu_inline_parameter_unchanged sym stmt &&
+                        (match current with
+                          | Just (E.GNU_inline_integer_range_fact low high _) -> low <= high
+                          | Just (E.GNU_inline_integer_progression_fact low high step) ->
+                              step > 0 && low <= high && (high-low) mod step = 0
+                          | _ -> false end))) reads >>= fun certified ->
+                    E.return (List.all (fun ok -> ok) certified)
+                | Nothing -> E.return false end)
+          | _ -> E.return false end)
+    | _ -> E.return false
+  end
+
+val gnu_counted_pointer_exit_facts:
+  C.core_tag_definitions -> list (nat * (Symbol.sym * Ctype.ctype)) ->
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_counted_pointer_exit_facts tagDefs snapshots stmt =
+  match (gnu_counted_pointer_loop tagDefs stmt, stmt.A.node) with
+    | (Just (counter, counter_ty, index, pointer, destination_ty), A.AilSwhile _ _ loop_id) ->
+      E.gnu_alloc_size_subject_allowed counter >>= fun private_counter ->
+      E.gnu_alloc_size_subject_allowed pointer >>= fun private_pointer ->
+      E.get_visible_objects >>= fun visible ->
+      if not (private_counter && private_pointer && List.elem counter visible &&
+          List.elem pointer visible) then E.return [] else
+      (match List.lookup loop_id snapshots with
+        | Just (saved, ty) ->
+          E.gnu_alloc_size_subject_allowed saved >>= fun private_saved ->
+          E.lookup_gnu_analysis_object_type saved >>= fun saved_ty ->
+          E.return (if private_saved && List.elem saved visible && ty = counter_ty &&
+              saved_ty = Just (Ctype.no_qualifiers, counter_ty)
+            then Just (A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type counter_ty))
+              [] (Loc.locOf index) (A.AilEbinary index (A.Arithmetic A.Sub)
+                (gnu_replace_scalar_dependency counter saved index)), [counter; saved])
+            else Nothing)
+        | Nothing ->
+          gnu_scalar_knowledge_of tagDefs index >>= fun entry_counter ->
+          E.return (if (match entry_counter with
+            | Just (low, high, _) -> low = 0 && high = 0 | _ -> false end)
+            then Just (index, [counter]) else Nothing)
+      end) >>= fun counted ->
+      (match counted with
+        | Nothing -> E.return []
+        | Just (offset, exit_dependencies) ->
+          E.gnu_compiler_fact pointer >>= fun incoming ->
+          (match maybe Nothing gnu_memory_pointer_identity incoming with
+            | Nothing -> E.return []
+            | Just fact ->
+              if not (gnu_local_extent_dependencies_complete fact) then E.return [] else
+              let dependencies = gnu_inline_fact_alloc_size_dependencies fact in
+              E.mapM (fun dependency ->
+                E.gnu_alloc_size_subject_allowed dependency >>= fun private_dependency ->
+                E.lookup_gnu_analysis_object_type dependency >>= fun dependency_ty ->
+                E.return (dependency <> counter && dependency <> pointer &&
+                  private_dependency && List.elem dependency visible &&
+                  gnu_inline_parameter_unchanged dependency stmt &&
+                  (match dependency_ty with
+                    | Just (qs, ty) -> not qs.Ctype.volatile &&
+                        not (AilTypesAux.is_atomic ty) && AilTypesAux.is_integer ty
+                    | Nothing -> false end))) dependencies >>= fun safe ->
+              (if List.all (fun ok -> ok) safe
+               then gnu_counted_static_upper_allowed tagDefs fact index destination_ty stmt
+               else E.return false) >>= fun static_upper ->
+              E.return (if not (List.all (fun ok -> ok) safe) then [] else
+                let exact = E.GNU_inline_offset_extent_fact fact offset destination_ty false exit_dependencies in
+                let exit = if fact = E.GNU_inline_unknown_extent_fact then fact else
+                  if static_upper then E.GNU_inline_counted_extent_fact fact exact
+                  else E.GNU_inline_dynamic_bound_fact exact in
+                [((false, pointer, []), exit)])
+          end)
+      end)
+    | _ -> E.return []
+  end
+
+val gnu_loop_stable_pointer_facts:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM (list (Symbol.sym * E.gnu_inline_fact))
+let gnu_loop_stable_pointer_facts function_sym stmt =
