+      else sym :: st.gnu_scalar_compiler_nonconstant |>
+    else st)
+
+val set_gnu_scalar_independent_subjects: list Symbol.sym -> elabM unit
+let set_gnu_scalar_independent_subjects subjects = fun st ->
+  ((), <| st with gnu_scalar_independent_subjects= subjects |>)
+
+(* Retain only existing certificates for subjects whose function-wide use
+   analysis excludes data correlations, and whose value the guard does not
+   read. No type-range fallback is introduced when a certificate is absent. *)
+val gnu_scalar_independent_snapshot:
+  (Symbol.sym -> bool) -> elabM (list (Symbol.sym * gnu_inline_fact))
+let gnu_scalar_independent_snapshot keep = fun st ->
+  (if not st.gnu_flow_enabled then [] else List.foldr (fun sym acc ->
+    if not (keep sym) then acc else
+    let (fact, _) = gnu_compiler_fact sym st in
+    match fact with
+      | Just fact -> if gnu_is_scalar_range fact then (sym, fact) :: acc else acc
+      | Nothing -> acc end) [] st.gnu_scalar_independent_subjects, st)
+
+(* Restored variation must outrank the downgraded branch fact left by
+   forget_gnu_scalar_variation. The caller has certified that the guard neither
+   reads nor correlates these unchanged subjects. Ordinary writes still revoke
+   both stores through the existing invalidation path. *)
+val restore_gnu_scalar_independent_facts:
+  list (Symbol.sym * gnu_inline_fact) -> elabM unit
+let restore_gnu_scalar_independent_facts facts = fun st ->
+  let insert original = List.foldl (fun current (sym, fact) ->
+    Map.insert sym fact current) original facts in
+  ((), if st.gnu_flow_enabled then <| st with
+    gnu_flow_facts= insert st.gnu_flow_facts;
+    gnu_branch_facts= insert st.gnu_branch_facts |>
+    else st)
+
+val gnu_branch_subject_allowed: Symbol.sym -> elabM bool
+let gnu_branch_subject_allowed sym = fun st ->
+  (List.any (fun subject -> subject = sym) st.gnu_branch_subjects, st)
+
+(* Unlike branch subjects, allocation-size dependencies may have earlier
+   direct assignments. They must remain unescaped automatic objects, and their
+   facts live only in revocable memory state until a dependency write/escape. *)
+val set_gnu_alloc_size_subjects: list Symbol.sym -> elabM unit
+let set_gnu_alloc_size_subjects subjects = fun st ->
+  ((), <| st with gnu_alloc_size_subjects= subjects |>)
+
+val gnu_alloc_size_subject_allowed: Symbol.sym -> elabM bool
+let gnu_alloc_size_subject_allowed sym = fun st ->
+  (List.elem sym st.gnu_alloc_size_subjects, st)
+
+val set_gnu_current_private_objects: list Symbol.sym -> elabM unit
+let set_gnu_current_private_objects subjects = fun st ->
+  ((), <| st with gnu_current_private_objects= subjects |>)
+
+val retain_gnu_current_private_objects: (Symbol.sym -> bool) -> elabM unit
+let retain_gnu_current_private_objects keep = fun st ->
+  ((), <| st with gnu_current_private_objects= List.filter keep st.gnu_current_private_objects |>)
+
+val gnu_current_private_object: Symbol.sym -> elabM bool
+let gnu_current_private_object sym = fun st ->
+  (st.gnu_flow_enabled && List.elem sym st.gnu_current_private_objects &&
+    List.elem sym (List.concat st.visible_objects), st)
+
+(* An unchanged incoming pointer cannot designate the fresh storage of a
+   current-activation automatic object. This certificate says nothing about
+   the pointee of that automatic pointer, nor about static local storage. *)
+val set_gnu_incoming_frame_separation: list Symbol.sym -> list Symbol.sym -> elabM unit
+let set_gnu_incoming_frame_separation incoming objects = fun st ->
+  ((), <| st with gnu_incoming_pointer_subjects= incoming;
+    gnu_current_frame_pointers= objects |>)
+
+val gnu_incoming_disjoint_frame_pointers: Symbol.sym -> elabM (list Symbol.sym)
+let gnu_incoming_disjoint_frame_pointers sym = fun st ->
+  (if not st.gnu_flow_enabled || not (List.elem sym st.gnu_incoming_pointer_subjects)
+   then [] else List.filter (fun local -> List.elem local (List.concat st.visible_objects))
+     st.gnu_current_frame_pointers, st)
+
+(* Automatic-object lifetime is separate from the pointer-cell and non-escape
+   inventories. It includes arrays, but never static locals or caller pointees. *)
+val set_gnu_current_automatic_objects: list Symbol.sym -> elabM unit
+let set_gnu_current_automatic_objects objects = fun st ->
+  ((), <| st with gnu_current_automatic_objects= objects |>)
+
+val gnu_visible_current_frame_objects: elabM (list Symbol.sym)
+let gnu_visible_current_frame_objects = fun st ->
+  (if not st.gnu_flow_enabled then [] else
+    List.filter (fun sym -> List.elem sym (List.concat st.visible_objects))
+      st.gnu_current_automatic_objects, st)
+
+(* Only lexical automatic pointer objects with no address escape anywhere in
+   the current function may be used as private lvalues by a nested effect proof. *)
+val gnu_private_current_frame_pointers: elabM (list Symbol.sym)
+let gnu_private_current_frame_pointers = fun st ->
+  (if not st.gnu_flow_enabled then [] else List.filter (fun sym ->
+    List.elem sym st.gnu_alloc_size_subjects &&
+      List.elem sym (List.concat st.visible_objects ++ st.gnu_branch_parameter_subjects))
+    st.gnu_current_frame_pointers, st)
+
+val set_gnu_nonnull_allocation_facts: list (Symbol.sym * gnu_inline_fact) -> elabM unit
+let set_gnu_nonnull_allocation_facts facts = fun st ->
+  ((), <| st with gnu_nonnull_allocation_facts= Map.fromList facts |>)
+
+val gnu_nonnull_allocation_fact: Symbol.sym -> elabM (maybe gnu_inline_fact)
+let gnu_nonnull_allocation_fact sym = fun st ->
+  (if st.gnu_flow_enabled && List.elem sym (List.concat st.visible_objects)
+   then Map.lookup sym st.gnu_nonnull_allocation_facts else Nothing, st)
+
+(* Source-origin invariants are separate from scalar ranges. The producer
+   certifies unchanged generic integer inputs and private automatic integer
+   locals using a grounded complete-write census. No range, witness, storage or
+   effect certificate follows. Specialized inputs are never assumed opaque;
+   locals can still be grounded in their own checked definitions. *)
+val set_gnu_incoming_scalar_origins: list Symbol.sym -> elabM unit
+let set_gnu_incoming_scalar_origins subjects = fun st ->
+  ((), <| st with gnu_incoming_scalar_origins= subjects |>)
+
+val gnu_incoming_scalar_origins: elabM (list Symbol.sym)
+let gnu_incoming_scalar_origins = fun st ->
+  (if not st.gnu_flow_enabled then [] else
+    List.filter (fun sym -> List.elem sym st.gnu_branch_parameter_subjects ||
+      List.elem sym (List.concat st.visible_objects))
+      st.gnu_incoming_scalar_origins, st)
+
+val gnu_current_parameter_subjects: elabM (list Symbol.sym)
+let gnu_current_parameter_subjects = fun st -> (st.gnu_branch_parameter_subjects, st)
+
+(* This function-scope permission is a source certificate, not a fact about
+   a particular pointer. Call-result slots still need their own positive
+   external boundary and are revoked by normal memory invalidation. *)
+val set_gnu_opaque_return_contents_enabled: bool -> elabM unit
+let set_gnu_opaque_return_contents_enabled enabled = fun st ->
+  ((), <| st with gnu_opaque_return_contents_enabled= enabled |>)
+
+val gnu_opaque_return_contents_allowed: elabM bool
+let gnu_opaque_return_contents_allowed = fun st ->
+  (st.gnu_opaque_return_contents_enabled, st)
+
+val set_gnu_ordinary_parameter_clobber_slots: list gnu_memory_slot -> elabM unit
+let set_gnu_ordinary_parameter_clobber_slots slots = fun st ->
+  ((), <| st with gnu_ordinary_parameter_clobber_slots= slots |>)
+
+val set_gnu_external_global_clobber_slots: list gnu_memory_slot -> elabM unit
+let set_gnu_external_global_clobber_slots slots = fun st ->
+  ((), <| st with gnu_external_global_clobber_slots= slots |>)
+
+(* Whole-TU write/escape certificates, not mutable values or known bounds.
+   Function-entry translation separately checks refinement and specialization. *)
+val set_gnu_opaque_global_pointer_symbols: list Symbol.sym -> elabM unit
+let set_gnu_opaque_global_pointer_symbols symbols = fun st ->
+  ((), <| st with gnu_opaque_global_pointer_symbols= symbols |>)
+
+val gnu_opaque_global_pointer_symbols: elabM (list Symbol.sym)
+let gnu_opaque_global_pointer_symbols = fun st -> (st.gnu_opaque_global_pointer_symbols, st)
+
+(* Declaration census for globals whose pointer value can hold a local cell
+   address. This grants no extent or alias by itself. *)
+val set_gnu_addressable_global_pointers: list Symbol.sym -> elabM unit
+let set_gnu_addressable_global_pointers symbols = fun st ->
+  ((), <| st with gnu_addressable_global_pointers= symbols |>)
+
+val gnu_addressable_global_pointers: elabM (list Symbol.sym)
+let gnu_addressable_global_pointers = fun st -> (st.gnu_addressable_global_pointers, st)
+
+(* Optional stronger certificate: no dependent global value reaches a pointer
+   refinement or hidden alias anywhere in the checked translation unit. *)
+val set_gnu_opaque_global_unrefined_symbols: list Symbol.sym -> elabM unit
+let set_gnu_opaque_global_unrefined_symbols symbols = fun st ->
+  ((), <| st with gnu_opaque_global_unrefined_symbols= symbols |>)
+
+val gnu_opaque_global_unrefined_symbols: elabM (list Symbol.sym)
+let gnu_opaque_global_unrefined_symbols = fun st -> (st.gnu_opaque_global_unrefined_symbols, st)
+
+
+val gnu_incoming_opaque_parameter_origins: elabM (list Symbol.sym)
+let gnu_incoming_opaque_parameter_origins = fun st ->
+  (st.gnu_incoming_opaque_parameter_origins, st)
+
+val gnu_opaque_clobber_slots: elabM (list gnu_memory_slot)
+let gnu_opaque_clobber_slots = fun st ->
+  (st.gnu_ordinary_parameter_clobber_slots ++ st.gnu_external_global_clobber_slots, st)
+
+val gnu_branch_parameter_subject_allowed: Symbol.sym -> elabM bool
+let gnu_branch_parameter_subject_allowed sym = fun st ->
+  (List.elem sym st.gnu_branch_parameter_subjects, st)
+
+(* A forward label entry is captured at a proved unique incoming goto, never
+   reconstructed from lexical code that the jump bypasses. It stores only scalar
+   facts for unchanged, address-unescaped objects. *)
+val set_gnu_scalar_unique_labels: list Symbol.sym -> elabM unit
+let set_gnu_scalar_unique_labels labels = fun st -> ((), <| st with gnu_scalar_unique_labels= labels |>)
+
+val gnu_scalar_label_is_unique: Symbol.sym -> elabM bool
+let gnu_scalar_label_is_unique label = fun st -> (List.elem label st.gnu_scalar_unique_labels, st)
+
+val gnu_scalar_label_snapshot: elabM (list (Symbol.sym * gnu_inline_fact))
+let gnu_scalar_label_snapshot = fun st ->
+  (if not st.gnu_flow_enabled then [] else List.foldr (fun sym acc ->
+    let (fact, _) = gnu_compiler_fact sym st in
+    match fact with
+      | Just fact -> if gnu_is_scalar_range fact then (sym,fact) :: acc else acc
+      | Nothing -> acc end) [] st.gnu_branch_subjects, st)
+
+val with_gnu_scalar_label_entry: forall 'a.
+  Symbol.sym -> list (Symbol.sym * gnu_inline_fact) -> elabM 'a -> elabM 'a
+let with_gnu_scalar_label_entry label facts action = fun st ->
+  let (value, next) = action <| st with gnu_scalar_label_entries= Map.insert label facts st.gnu_scalar_label_entries |> in
+  (value, <| next with gnu_scalar_label_entries= st.gnu_scalar_label_entries |>)
+
+val restore_gnu_scalar_label_entry: Symbol.sym -> elabM unit
+let restore_gnu_scalar_label_entry label = fun st ->
+  let facts = if not st.gnu_flow_enabled then [] else
+    maybe [] (fun facts -> facts) (Map.lookup label st.gnu_scalar_label_entries) in
+  ((), <| st with
+    gnu_branch_facts= List.foldl (fun acc (sym,fact) -> Map.insert sym fact acc) st.gnu_branch_facts facts;
+    gnu_scalar_label_entries= Map.delete label st.gnu_scalar_label_entries |>)
+
+(* Explicit snapshots override scoped invariants and an opaque root's default.
+   The same effective lookup is used by readers and branch joins. An absent
+   slot without a positive root remains absent; no root is inferred here. *)
+val gnu_memory_snapshot_fact:
+  list (gnu_memory_slot * gnu_inline_fact) ->
+  list (gnu_memory_slot * gnu_inline_fact) -> list Symbol.sym ->
+  gnu_memory_slot -> maybe gnu_inline_fact
+let gnu_memory_snapshot_fact facts invariants roots ((indirect, sym, path) as slot) =
+  match List.lookup slot facts with
+    | Just fact -> Just fact
+    | Nothing -> (match List.lookup slot invariants with
+        | Just fact -> Just fact
+        | Nothing -> if indirect && path <> [] && List.elem sym roots
+            then Just GNU_inline_unknown_extent_fact else Nothing end)
+  end
+
+(* Compile both arms from the same incoming metadata, while threading emitted
+   code, fresh symbols, globals and pending procedures normally. At the join,
+   retain only facts that agree exactly on both outgoing paths. Unknown or
+   unequal facts are dropped; no runtime branch is chosen by this analysis. *)
+val gnu_select_branch_facts: forall 'a.
+  bool -> bool -> 'a -> ('a -> 'a -> 'a) -> 'a -> 'a -> 'a
+let gnu_select_branch_facts left_falls right_falls fallback combine first second =
+  if left_falls then (if right_falls then combine first second else first)
+  else if right_falls then second else fallback
+
+val with_gnu_selected_conditional_facts: forall 'a 'b.
+  maybe C.pexpr ->
+  bool -> bool ->
+  list (Symbol.sym * gnu_inline_fact) -> list (Symbol.sym * gnu_inline_fact) ->
+  elabM 'a -> elabM 'b -> elabM ('a * 'b)
+let with_gnu_selected_conditional_facts selector left_falls right_falls left_facts right_facts left right = fun st ->
+  let extend facts = if not st.gnu_flow_enabled then Map.empty else
+    List.foldl (fun acc (sym, fact) -> Map.insert sym fact acc) st.gnu_branch_facts facts in
+  let meet first second = List.foldl (fun acc (sym, fact) ->
+    if Map.lookup sym second = Just fact then Map.insert sym fact acc else acc
+  ) Map.empty (Map_extra.toList first) in
+  let (left_value, after_left) = left <| st with gnu_branch_facts= extend left_facts |> in
+  let (right_value, after_right) = right <| after_left with
+    gnu_branch_facts= extend right_facts;
+    gnu_forward_memory_reachable= st.gnu_forward_memory_reachable;
+    gnu_current_private_objects= st.gnu_current_private_objects;
+    gnu_incoming_pointer_subjects= st.gnu_incoming_pointer_subjects;
+    gnu_current_frame_pointers= st.gnu_current_frame_pointers;
+    gnu_current_automatic_objects= st.gnu_current_automatic_objects;
+    gnu_nonnull_allocation_facts= st.gnu_nonnull_allocation_facts;
+    gnu_scalar_equalities= st.gnu_scalar_equalities;
+    gnu_scalar_compiler_nonconstant= st.gnu_scalar_compiler_nonconstant;
+    gnu_memory_facts= st.gnu_memory_facts; gnu_memory_aliases= st.gnu_memory_aliases;
+    gnu_memory_opaque_roots= st.gnu_memory_opaque_roots;
+    gnu_flow_facts= st.gnu_flow_facts;
+    gnu_const_pointer_origins= st.gnu_const_pointer_origins;
+    gnu_flow_enabled= st.gnu_flow_enabled |> in
+  let fact_meet first second = List.foldl (fun acc (sym, fact) ->
+    match Map.lookup sym second with
+      | Just other -> (match gnu_join_selected_inline_facts selector fact other with
+          | Just joined -> Map.insert sym joined acc | Nothing -> acc end)
+      | Nothing -> acc
+    end) Map.empty (Map_extra.toList first) in
+  let memory_meet first second = List.foldr (fun (slot, _) acc ->
+    let left_fact = gnu_memory_snapshot_fact first after_left.gnu_memory_invariants
+      (gnu_memory_root_union after_left.gnu_memory_opaque_roots after_left.gnu_memory_root_invariants) slot in
+    let right_fact = gnu_memory_snapshot_fact second after_right.gnu_memory_invariants
+      (gnu_memory_root_union after_right.gnu_memory_opaque_roots after_right.gnu_memory_root_invariants) slot in
+    match (left_fact, right_fact) with
+      | (Just fact, Just other) -> (match gnu_join_selected_inline_facts selector fact other with
+          | Just joined -> (slot, joined) :: List.filter (fun (other_slot, _) -> other_slot <> slot) acc
+          | Nothing -> acc end)
+      | _ -> acc
+    end) [] (first ++ second) in
+  let opaque_meet first second = List.filter (fun sym -> List.elem sym second) first in
+  let inherited_nonconstant =
+    gnu_select_branch_facts left_falls right_falls [] opaque_meet
+      after_left.gnu_scalar_compiler_nonconstant after_right.gnu_scalar_compiler_nonconstant in
+  let lost_relation_nonconstant =
+    if left_falls && right_falls then
+      List.foldl (fun acc (a,b,_,_) ->
+        if not (List.elem a st.gnu_branch_parameter_subjects &&
+                List.elem b st.gnu_branch_parameter_subjects) then acc else
+        let with_a = if List.elem a acc then acc else a :: acc in
+        if List.elem b with_a then with_a else b :: with_a)
+        inherited_nonconstant
+        (after_left.gnu_scalar_equalities ++ after_right.gnu_scalar_equalities)
+    else inherited_nonconstant in
+  (* A returning arm has no ordinary successor at this join. Runtime control
+     still uses the original conditional and return; only compiler knowledge
+     is selected here. Both returning arms leave no normal continuation fact. *)
+  ((left_value, right_value), <| after_right with
+    gnu_forward_memory_reachable= if not st.gnu_forward_memory_track_reachability
+      then st.gnu_forward_memory_reachable else
+      (left_falls && after_left.gnu_forward_memory_reachable) ||
+      (right_falls && after_right.gnu_forward_memory_reachable);
+    gnu_current_private_objects= gnu_select_branch_facts left_falls right_falls [] opaque_meet
+      after_left.gnu_current_private_objects after_right.gnu_current_private_objects;
+    gnu_branch_facts= gnu_select_branch_facts left_falls right_falls Map.empty fact_meet after_left.gnu_branch_facts after_right.gnu_branch_facts;
+    (* GCC's O2 constant query does not necessarily preserve equality knowledge
+       across two reconverging guard blocks, even when logically common. *)
+    gnu_scalar_equalities= gnu_select_branch_facts left_falls right_falls [] (fun _ _ -> [])
+      after_left.gnu_scalar_equalities after_right.gnu_scalar_equalities;
+    gnu_scalar_compiler_nonconstant= lost_relation_nonconstant;
+    gnu_memory_facts= gnu_select_branch_facts left_falls right_falls [] memory_meet after_left.gnu_memory_facts after_right.gnu_memory_facts;
+    gnu_memory_aliases= gnu_select_branch_facts left_falls right_falls Map.empty meet after_left.gnu_memory_aliases after_right.gnu_memory_aliases;
+    gnu_memory_opaque_roots= gnu_select_branch_facts left_falls right_falls [] opaque_meet after_left.gnu_memory_opaque_roots after_right.gnu_memory_opaque_roots;
+    gnu_flow_facts= gnu_select_branch_facts left_falls right_falls Map.empty fact_meet after_left.gnu_flow_facts after_right.gnu_flow_facts;
+    gnu_const_pointer_origins= st.gnu_const_pointer_origins;
+    gnu_flow_enabled= st.gnu_flow_enabled |>)
+
+val with_gnu_conditional_facts: forall 'a 'b.
+  bool -> bool ->
+  list (Symbol.sym * gnu_inline_fact) -> list (Symbol.sym * gnu_inline_fact) ->
+  elabM 'a -> elabM 'b -> elabM ('a * 'b)
+let with_gnu_conditional_facts left_falls right_falls left_facts right_facts left right =
+  with_gnu_selected_conditional_facts Nothing left_falls right_falls left_facts right_facts left right
+
+val close_gnu_selected_extent_scope: elabM unit
+let close_gnu_selected_extent_scope = fun st ->
+  ((), <| st with
+    gnu_flow_facts= Map.map gnu_static_extent_fact st.gnu_flow_facts;
+    gnu_branch_facts= Map.map gnu_static_extent_fact st.gnu_branch_facts;
+    gnu_memory_facts= List.map (fun (slot, fact) -> (slot, gnu_static_extent_fact fact)) st.gnu_memory_facts |>)
+
+(* Parallel statement siblings have no declaration sequencing guarantee. Do
+   not infer local snapshots inside them or carry snapshots across the join. *)
+val without_gnu_flow_facts: forall 'a. elabM 'a -> elabM 'a
+let without_gnu_flow_facts ma = fun st ->
+  let (value, next) = ma <| st with gnu_flow_facts= Map.empty; gnu_branch_facts= Map.empty;
+    gnu_scalar_equalities= []; gnu_scalar_compiler_nonconstant= [];
+    gnu_memory_facts= []; gnu_memory_aliases= Map.empty; gnu_memory_opaque_roots= [];
+    gnu_flow_enabled= false |> in
+  (value, <| next with gnu_flow_facts= Map.empty; gnu_branch_facts= Map.empty;
+    gnu_scalar_equalities= []; gnu_scalar_compiler_nonconstant= [];
+    gnu_memory_facts= []; gnu_memory_aliases= Map.empty; gnu_memory_opaque_roots= [];
+    gnu_flow_enabled= st.gnu_flow_enabled |>)
+
+(* Memory knowledge must be invalidated separately from facts about the
+   pointer object itself: *p=... does not modify p, but can invalidate any
+   member slot reached by an alias. No runtime effect is suppressed here. *)
+val clear_gnu_memory_facts: elabM unit
+let clear_gnu_memory_facts = fun st ->
+  ((), <| st with gnu_scalar_equalities= []; gnu_scalar_compiler_nonconstant= []; gnu_memory_facts= []; gnu_memory_aliases= Map.empty; gnu_memory_opaque_roots= [] |>)
+
+val retain_gnu_memory_facts: (gnu_memory_slot -> gnu_inline_fact -> bool) -> elabM unit
+let retain_gnu_memory_facts keep = fun st ->
+  ((), <| st with gnu_memory_facts= List.filter (fun (slot, fact) -> keep slot fact) st.gnu_memory_facts |>)
+
+val lookup_gnu_indexed_memory_slot:
+  AilSyntax.expression GenTypes.genTypeCategory -> elabM (maybe Symbol.sym)
+let lookup_gnu_indexed_memory_slot key = fun st ->
+  (List.lookup key st.gnu_indexed_memory_slots, st)
+
+val register_gnu_indexed_memory_slot:
+  AilSyntax.expression GenTypes.genTypeCategory -> Symbol.sym -> elabM unit
+let register_gnu_indexed_memory_slot key sym = fun st ->
+  ((), <| st with gnu_indexed_memory_slots= (key, sym) :: st.gnu_indexed_memory_slots |>)
+
+(* Recover the exact typed key of an existing synthetic slot. This read-only
+   lookup creates no slot, memory fact, alias, root or dependency certificate. *)
+val gnu_indexed_memory_key:
+  Symbol.sym -> elabM (maybe (AilSyntax.expression GenTypes.genTypeCategory))
+let gnu_indexed_memory_key sym = fun st ->
+  (List.foldr (fun (key, slot) found -> if slot = sym then Just key else found)
+    Nothing st.gnu_indexed_memory_slots, st)
+
+val gnu_indexed_memory_symbols: elabM (list Symbol.sym)
+let gnu_indexed_memory_symbols = fun st -> (List.map snd st.gnu_indexed_memory_slots, st)
+
+val gnu_memory_snapshot:
+  elabM (list (gnu_memory_slot * gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * gnu_memory_slot))
+let gnu_memory_snapshot = fun st ->
+  ((st.gnu_memory_facts, gnu_memory_root_union st.gnu_memory_opaque_roots st.gnu_memory_root_invariants,
+    Map_extra.toList st.gnu_memory_aliases), st)
+
+(* Count every inventoried syntactic edge. In a proven acyclic region, an
+   unreachable edge contributes no predecessor, whereas a reachable edge with
+   no facts contributes an empty set. Never identify these two states. Outside
+   that region retain the original conservative all-edges/fallthrough join. *)
+val set_gnu_forward_memory_labels: bool -> list (Symbol.sym * nat) -> elabM unit
+let set_gnu_forward_memory_labels track labels = fun st ->
+  ((), <| st with gnu_forward_memory_labels= labels; gnu_forward_memory_entries= Map.empty;
+    gnu_forward_memory_track_reachability= track; gnu_forward_memory_reachable= true |>)
+
+val restrict_gnu_forward_memory_reachability: bool -> elabM unit
+let restrict_gnu_forward_memory_reachability possible = fun st ->
+  ((), <| st with gnu_forward_memory_reachable=
+    if st.gnu_forward_memory_track_reachability then
+      st.gnu_forward_memory_reachable && possible else st.gnu_forward_memory_reachable |>)
+
+val gnu_explicit_opaque_slots: elabM (list gnu_memory_slot)
+let gnu_explicit_opaque_slots = fun st ->
+  (if not st.gnu_flow_enabled then [] else
+    List.foldr (fun (slot, fact) acc ->
+      if fact = GNU_inline_unknown_extent_fact &&
+          List.lookup slot st.gnu_memory_facts = Just fact && not (List.elem slot acc)
+      then slot :: acc else acc) [] st.gnu_memory_facts, st)
+
+val gnu_forward_memory_meet:
+  maybe (list gnu_memory_slot * list Symbol.sym *
+    list (Symbol.sym * gnu_inline_fact) * list Symbol.sym) ->
+  maybe (list gnu_memory_slot * list Symbol.sym *
+    list (Symbol.sym * gnu_inline_fact) * list Symbol.sym) ->
+  maybe (list gnu_memory_slot * list Symbol.sym *
+    list (Symbol.sym * gnu_inline_fact) * list Symbol.sym)
+let gnu_forward_memory_meet first second = match (first, second) with
+  | (Nothing, _) -> second
+  | (_, Nothing) -> first
+  | (Just (slots, roots, scalars, varying),
+     Just (other_slots, other_roots, other_scalars, other_varying)) ->
+      Just (List.filter (fun slot -> List.elem slot other_slots) slots,
+        List.filter (fun root -> List.elem root other_roots) roots,
+        List.filter (fun (sym, fact) -> List.lookup sym other_scalars = Just fact) scalars,
+        List.foldl (fun acc sym -> if List.elem sym acc then acc else sym :: acc)
+          varying other_varying)
+end
+
+val gnu_forward_scalar_variation:
+  list (Symbol.sym * gnu_inline_fact) -> list Symbol.sym -> list Symbol.sym
+let gnu_forward_scalar_variation scalars inherited =
+  List.foldl (fun acc (sym, fact) ->
+    let varying = match fact with
+      | GNU_inline_integer_range_fact low high dense -> dense && low < high
+      | GNU_inline_integer_progression_fact low high step ->
+          step > 0 && low < high && (high-low) mod step = 0
+      | _ -> false end in
+    if varying && not (List.elem sym acc) then sym :: acc else acc)
+    inherited scalars
+
+val record_gnu_forward_memory_edge: Symbol.sym -> elabM unit
+let record_gnu_forward_memory_edge target =
+  gnu_explicit_opaque_slots >>= fun slots ->
+  gnu_memory_snapshot >>= fun (_, roots, _) ->
+  gnu_scalar_label_snapshot >>= fun scalars -> fun st ->
+  let roots = if st.gnu_flow_enabled then roots else [] in
+  let varying = if st.gnu_flow_enabled then
+    gnu_forward_scalar_variation scalars st.gnu_scalar_compiler_nonconstant else [] in
+  let incoming = if st.gnu_forward_memory_track_reachability &&
+      not st.gnu_forward_memory_reachable then Nothing
+    else Just (slots, roots, scalars, varying) in
+  let entries = match List.lookup target st.gnu_forward_memory_labels with
+    | Nothing -> st.gnu_forward_memory_entries
+    | Just _ ->
+        let entry = match Map.lookup target st.gnu_forward_memory_entries with
+          | Nothing -> (1, incoming)
+          | Just (count, prior) -> (count + 1, gnu_forward_memory_meet prior incoming)
+        end in
+        Map.insert target entry st.gnu_forward_memory_entries
+  end in
+  let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+    "GNU forward memory edge " ^ show target ^ "; flow=" ^ show st.gnu_flow_enabled ^
+    "; reachable=" ^ show (isJust incoming) ^ "; roots=" ^ show roots ^
+    "; scalars=" ^ show (List.length scalars) ^ "; varying=" ^ show varying) in
+  ((), <| st with gnu_forward_memory_entries= entries;
+    gnu_forward_memory_reachable= if st.gnu_forward_memory_track_reachability
+      then false else st.gnu_forward_memory_reachable |>)
+
+val gnu_forward_memory_label_entry:
+  Symbol.sym -> elabM
+    (list (gnu_memory_slot * gnu_inline_fact) * list Symbol.sym * list Symbol.sym)
+let gnu_forward_memory_label_entry label =
+  gnu_explicit_opaque_slots >>= fun fallthrough ->
+  gnu_memory_snapshot >>= fun (_, fallthrough_roots, _) ->
+  gnu_scalar_label_snapshot >>= fun fallthrough_scalars -> fun st ->
+  let fallthrough_roots = if st.gnu_flow_enabled then fallthrough_roots else [] in
+  let fallthrough_varying = if st.gnu_flow_enabled then
+    gnu_forward_scalar_variation fallthrough_scalars st.gnu_scalar_compiler_nonconstant
+    else [] in
+  let fallthrough_entry = if st.gnu_forward_memory_track_reachability &&
+      not st.gnu_forward_memory_reachable then Nothing
+    else Just (fallthrough, fallthrough_roots, fallthrough_scalars, fallthrough_varying) in
+  let entry = Map.lookup label st.gnu_forward_memory_entries in
+  let captured = match List.lookup label st.gnu_forward_memory_labels with
+    | Nothing -> Just ([], [], [], [])
+    | Just expected -> match entry with
+        | Nothing -> if expected = 0 then fallthrough_entry else Just ([], [], [], [])
+        | Just (count, prior) -> if count = expected then
+            gnu_forward_memory_meet prior fallthrough_entry else Just ([], [], [], [])
+      end
+  end in
+  (* Parameters outlive the label too. Incomplete edge visitation remains a
+     reachable predecessor without certificates; it cannot prove unreachability. *)
+  let visible = List.concat st.visible_objects ++ st.gnu_branch_parameter_subjects in
+  let (captured_slots, captured_roots, captured_scalars, captured_varying) =
+    maybe ([], [], [], []) (fun facts -> facts) captured in
+  let slots = List.filter (fun (_, sym, _) -> List.elem sym visible) captured_slots in
+  let roots = List.filter (fun root -> List.elem root visible) captured_roots in
+  let scalars = List.filter (fun (sym, _) -> List.elem sym visible) captured_scalars in
+  let varying = List.filter (fun sym -> List.elem sym visible) captured_varying in
+  let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+    "GNU forward memory label " ^ show label ^ "; expected=" ^
+    show (List.lookup label st.gnu_forward_memory_labels) ^ "; captured=" ^
+    show (maybe 0 fst entry) ^ "; reachable=" ^ show (isJust captured) ^
+    "; retained=" ^ show (List.length slots) ^ "; roots=" ^ show roots ^
+    "; scalars=" ^ show (List.length scalars) ^ "; varying=" ^ show varying) in
+  ((List.map (fun slot -> (slot, GNU_inline_unknown_extent_fact)) slots ++
+      List.map (fun (sym, fact) -> ((false, sym, []), fact)) scalars,
+    roots, varying),
+    <| st with gnu_forward_memory_entries= Map.delete label st.gnu_forward_memory_entries;
+      gnu_forward_memory_reachable= if st.gnu_forward_memory_track_reachability
+        then isJust captured else st.gnu_forward_memory_reachable |>)
+
+val gnu_memory_disjoint_parameters: elabM (list (Symbol.sym * Symbol.sym))
+let gnu_memory_disjoint_parameters = fun st -> (st.gnu_parameter_disjoint, st)
+
+(* This relation requires an actual object address; an ordinary pointer value,
+   known extent, or absent fact cannot manufacture an automatic storage origin.
+   Source admission separately requires unchanged, unescaped receiver formals. *)
+val gnu_memory_caller_frame_root: gnu_memory_slot -> elabM bool
+let gnu_memory_caller_frame_root (indirect, sym, path) = fun st ->
+  let confined_record =
+    path = [] && List.elem sym st.gnu_current_automatic_objects &&
+    List.elem sym st.gnu_alloc_size_subjects &&
+    (match Map.lookup sym st.visible_objects_types with
+      | Just (qs, ty) ->
+          not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+            AilTypesAux.is_struct_or_union ty
+      | Nothing -> false end) in
+  (st.gnu_flow_enabled &&
+    (if indirect then List.elem sym st.gnu_parameter_caller_frame
+     else (List.elem sym st.gnu_current_frame_pointers || confined_record) &&
+       List.elem sym (List.concat st.visible_objects)), st)
+
+val gnu_memory_caller_frame_parameters: elabM (list Symbol.sym)
+let gnu_memory_caller_frame_parameters = fun st ->
+  (if st.gnu_flow_enabled then st.gnu_parameter_caller_frame else [], st)
+
+(* Memory environments have one effective binding per slot. Several independent
+   preservation rules can retain the same incoming fact. Keep the first binding,
+   exactly as List.lookup does, rather than duplicating it on every subsequent
+   call/branch. All distinct slots and the complete first facts are preserved. *)
+val gnu_memory_fact_bindings:
+  list (gnu_memory_slot * gnu_inline_fact) -> list (gnu_memory_slot * gnu_inline_fact)
+let gnu_memory_fact_bindings facts = List.foldr (fun ((slot, _) as binding) rest ->
+  binding :: List.filter (fun (other, _) -> other <> slot) rest) [] facts
+
+(* Read the same shadowed bindings as memory lookup when auditing stored
+   representations. A loop invariant must not hide an encoded address from a
+   caller-origin certificate merely because the ordinary snapshot omits it. *)
+val gnu_memory_effective_bindings: elabM (list (gnu_memory_slot * gnu_inline_fact))
+let gnu_memory_effective_bindings = fun st ->
+  (if st.gnu_flow_enabled then
+     gnu_memory_fact_bindings (st.gnu_memory_facts ++ st.gnu_memory_invariants)
+   else [], st)
+
+(* The caller has proved these slots disjoint from the sole runtime write.
+   Translation still executes that write, and still performs normal pointer
+   flow invalidation. Only its independently checked memory survivors return. *)
+val with_preserved_gnu_memory: forall 'a.
+  list (gnu_memory_slot * gnu_inline_fact) -> list Symbol.sym ->
+  list (Symbol.sym * gnu_memory_slot) -> elabM 'a -> elabM 'a
+let with_preserved_gnu_memory facts roots aliases ma = fun st ->
+  let (value, next) = ma st in
+  (value, if not next.gnu_flow_enabled then next else <| next with
+    gnu_memory_facts= gnu_memory_fact_bindings facts; gnu_memory_opaque_roots= roots;
+    gnu_memory_aliases= Map.fromList aliases |>)
+
+(* This is positive evidence of an opaque ordinary argument at function entry,
+   not a fallback for an arbitrary failed analysis. Writes/calls/joins revoke it;
+   specialized callers and functions with refinement risks never receive it. *)
+(* Only a whole-region inductive certificate may enter this scope. Restore
+   the invariant list alone: ordinary writes and branch changes are retained. *)
+val with_gnu_memory_invariants: forall 'a.
+  list (gnu_memory_slot * gnu_inline_fact) -> elabM 'a -> elabM 'a
+let with_gnu_memory_invariants facts action = fun st ->
+  let (value, next) = action <| st with gnu_memory_invariants= facts ++ st.gnu_memory_invariants |> in
+  (value, <| next with gnu_memory_invariants= st.gnu_memory_invariants |>)
+
+(* Only the whole-region origin proof may install these roots. Ordinary
+   writes keep their normal state; after leaving the region, only the outer
+   invariant context remains. Callers explicitly publish certified exit roots. *)
+val with_gnu_memory_root_invariants: forall 'a.
+  list Symbol.sym -> elabM 'a -> elabM 'a
+let with_gnu_memory_root_invariants roots action = fun st ->
+  let (value, next) = action <| st with
+    gnu_memory_root_invariants= gnu_memory_root_union roots st.gnu_memory_root_invariants |> in
+  (value, <| next with gnu_memory_root_invariants= st.gnu_memory_root_invariants |>)
+
+val register_gnu_memory_opaque_root: Symbol.sym -> elabM unit
+let register_gnu_memory_opaque_root sym = fun st ->
+  ((), if st.gnu_flow_enabled then <| st with gnu_memory_opaque_roots=
+    gnu_memory_root_union [sym] st.gnu_memory_opaque_roots |> else st)
+
+(* Read only a live positive memory boundary. An absent slot never creates one. *)
+val gnu_memory_has_opaque_root: Symbol.sym -> elabM bool
+let gnu_memory_has_opaque_root sym = fun st ->
+  (st.gnu_flow_enabled && List.elem sym
+    (gnu_memory_root_union st.gnu_memory_opaque_roots st.gnu_memory_root_invariants), st)
+
+val gnu_memory_fact: gnu_memory_slot -> elabM (maybe gnu_inline_fact)
+let gnu_memory_fact slot = fun st ->
+  (if not st.gnu_flow_enabled then Nothing else
+    gnu_memory_snapshot_fact st.gnu_memory_facts st.gnu_memory_invariants
+      (gnu_memory_root_union st.gnu_memory_opaque_roots st.gnu_memory_root_invariants) slot, st)
+
+val register_gnu_memory_fact: gnu_memory_slot -> gnu_inline_fact -> elabM unit
+let register_gnu_memory_fact slot fact = fun st ->
+  let related = match (slot, gnu_scalar_propagated_fact fact) with
+    | ((false, sym, []), Just propagated) ->
+        List.map (fun target -> (target, propagated)) (gnu_scalar_equality_class st.gnu_scalar_equalities sym)
+    | _ -> [] end in
+  let branch_facts = match related with
+    | [(sym, GNU_inline_integer_range_fact low high _)] ->
+        if low = high then Map.delete sym st.gnu_branch_facts else st.gnu_branch_facts
+    | _ -> st.gnu_branch_facts end in
+  ((), if st.gnu_flow_enabled then <| st with
+    gnu_branch_facts= List.foldl (fun acc (sym, value) -> Map.insert sym value acc) branch_facts
+      (if List.length related > 1 then related else []);
+    gnu_memory_facts= (slot, fact) :: List.filter (fun (old, _) -> old <> slot) st.gnu_memory_facts |> else st)
+
+val gnu_scalar_relation_holds: Symbol.sym -> Symbol.sym -> elabM bool
+let gnu_scalar_relation_holds first second = fun st ->
+  (first <> second &&
+    List.elem second (gnu_scalar_equality_class st.gnu_scalar_equalities first), st)
+
+val register_gnu_scalar_equalities: list gnu_scalar_equality -> elabM unit
+let register_gnu_scalar_equalities edges = fun st ->
+  let next = if st.gnu_flow_enabled then <| st with gnu_scalar_equalities= edges ++ st.gnu_scalar_equalities |> else st in
+  let subjects = List.concat (List.map (fun (left,right,_,_) -> [left;right]) edges) in
+  let facts = List.foldl (fun acc sym -> match gnu_scalar_equality_bound next.gnu_scalar_equalities sym with
+    | Just fact -> Map.insert sym fact acc | Nothing -> acc end) next.gnu_branch_facts subjects in
+  ((), <| next with gnu_branch_facts= if st.gnu_flow_enabled then facts else st.gnu_branch_facts |>)
+
+val gnu_memory_alias: Symbol.sym -> elabM (maybe gnu_memory_slot)
+let gnu_memory_alias sym = fun st ->
+  (if not st.gnu_flow_enabled then Nothing else match Map.lookup sym st.gnu_memory_aliases with
+    | Just slot -> Just slot
+    | Nothing -> match Map.lookup sym st.gnu_entry_aliases with
+        | Just slot -> Just slot
+        | Nothing -> maybe Nothing (fun root -> Just (true, root, []))
+            (Map.lookup sym st.gnu_parameter_aliases)
+      end
+  end, st)
+
+val forget_gnu_memory_alias: Symbol.sym -> elabM unit
+let forget_gnu_memory_alias sym = fun st ->
+  ((), <| st with gnu_memory_aliases= Map.delete sym st.gnu_memory_aliases |>)
+
+val register_gnu_memory_alias: Symbol.sym -> gnu_memory_slot -> elabM unit
+let register_gnu_memory_alias sym slot = fun st ->
+  ((), if st.gnu_flow_enabled then <| st with
+    gnu_memory_aliases= Map.insert sym slot st.gnu_memory_aliases;
+    gnu_entry_aliases= if List.elem sym st.gnu_entry_alias_subjects &&
+        (let (indirect, root, _) = slot in not indirect || List.elem root st.gnu_branch_subjects)
+      then Map.insert sym slot st.gnu_entry_aliases else st.gnu_entry_aliases |> else st)
+
+(* The producer proves unconditional entry initialization and whole-body
+   pointer-object immutability. This exposes that existing certificate only. *)
+val gnu_entry_alias_subject_allowed: Symbol.sym -> elabM bool
+let gnu_entry_alias_subject_allowed sym = fun st ->
+  (List.elem sym st.gnu_entry_alias_subjects, st)
+
+val set_gnu_entry_alias_subjects: list Symbol.sym -> elabM unit
+let set_gnu_entry_alias_subjects subjects = fun st ->
+  ((), <| st with gnu_entry_alias_subjects= subjects; gnu_entry_aliases= Map.empty |>)
+
+val gnu_memory_path_suffix: list Symbol.identifier -> list Symbol.identifier -> maybe (list Symbol.identifier)
+let rec gnu_memory_path_suffix prefix path = match (prefix, path) with
+  | ([], rest) -> Just rest
+  | (first :: tail, next :: rest) ->
+      if first = next then gnu_memory_path_suffix tail rest else Nothing
+  | _ -> Nothing
+end
+
+val gnu_memory_copy_facts: gnu_memory_slot -> gnu_memory_slot -> elabM (list (gnu_memory_slot * gnu_inline_fact))
+let gnu_memory_copy_facts (source_indirect, source_sym, source_path) (dest_indirect, dest_sym, dest_path) = fun st ->
+  (if not st.gnu_flow_enabled then [] else List.foldr
+    (fun ((indirect, sym, path), fact) acc ->
+      if indirect <> source_indirect || sym <> source_sym then acc else
+        match gnu_memory_path_suffix source_path path with
+          | Nothing -> acc
+          | Just suffix -> ((dest_indirect, dest_sym, dest_path ++ suffix), fact) :: acc
+        end
+    ) [] st.gnu_memory_facts, st)
+
+(* An empty relative path is the value of the directly pointed-to object.
+   Preserve it too: specialization installs it at (true, formal, []), separate
+   from the formal pointer object itself. No fact is synthesized here. *)
+val gnu_memory_contents: gnu_memory_slot -> elabM (list (list Symbol.identifier * gnu_inline_fact))
+let gnu_memory_contents (source_indirect, source_sym, source_path) = fun st ->
+  (if not st.gnu_flow_enabled then [] else List.foldr
+    (fun ((indirect, sym, path), fact) acc ->
+      if indirect <> source_indirect || sym <> source_sym then acc else
+        match gnu_memory_path_suffix source_path path with
+          | Just suffix -> (suffix, fact) :: acc
+          | Nothing -> acc
+        end
+    ) [] st.gnu_memory_facts, st)
+
+(* Copying a pointee-memory boundary must not hide a known pointer override.
+   Check effective current and invariant bindings, including overlapping prefix
+   paths. Scalar facts do not supply allocation origins. No absent root becomes
+   opaque, and the caller must separately justify its typed address projection. *)
+val gnu_memory_opaque_subobject:
+  Symbol.sym -> list Symbol.identifier -> elabM bool
+let gnu_memory_opaque_subobject root prefix = fun st ->
+  let ordinary = function
+    | GNU_inline_unknown_extent_fact -> true
+    | GNU_inline_integer_fact _ -> true
+    | GNU_inline_integer_range_fact _ _ _ -> true
+    | GNU_inline_integer_progression_fact _ _ _ -> true
+    | _ -> false end in
+  let overlaps ((indirect, sym, path), _) =
+    indirect && sym = root &&
+      (isJust (gnu_memory_path_suffix prefix path) ||
+       isJust (gnu_memory_path_suffix path prefix)) in
+  (* Shadowing depends only on slot identity. Filter the relevant slots before
+     deduplicating, so unrelated roots do not incur quadratic work per query. *)
+  (st.gnu_flow_enabled && List.elem root
+      (gnu_memory_root_union st.gnu_memory_opaque_roots st.gnu_memory_root_invariants) &&
+    List.all (fun (_, fact) -> ordinary fact)
+      (gnu_memory_fact_bindings (List.filter overlaps
+        (st.gnu_memory_facts ++ st.gnu_memory_invariants))), st)
+
+val register_gnu_const_pointer_origin:
+  Symbol.sym -> AilSyntax.expression GenTypes.genTypeCategory -> elabM unit
+let register_gnu_const_pointer_origin sym expr =
+  fun st -> ((), <| st with gnu_const_pointer_origins=
+    Map.insert sym expr st.gnu_const_pointer_origins |>)
+
+val gnu_const_pointer_origin:
+  Symbol.sym -> elabM (maybe (AilSyntax.expression GenTypes.genTypeCategory))
+let gnu_const_pointer_origin sym =
+  fun st -> (Map.lookup sym st.gnu_const_pointer_origins, st)
+
+val set_gnu_inline_bodies: map Symbol.sym Symbol.sym -> elabM unit
+let set_gnu_inline_bodies bodies =
+  fun st -> ((), <| st with gnu_inline_bodies= bodies |>)
+
+val set_gnu_inline_templates:
+  map Symbol.sym (list Symbol.sym * AilSyntax.statement GenTypes.genTypeCategory) -> elabM unit
+let set_gnu_inline_templates templates =
+  fun st -> ((), <| st with gnu_inline_templates= templates |>)
+
+(* These helpers are reserved for the read-only incoming-return analysis.
+   An outer query opens a fresh cache and closes it before returning to ordinary
+   translation. Nested queries share only completed results; recursive cycles
+   are rejected by the resolver before consulting this cache. *)
+val with_gnu_return_query_cache: forall 'a. elabM 'a -> elabM 'a
+let with_gnu_return_query_cache action = fun st ->
+  match st.gnu_return_query_cache with
+    | Just _ -> action st
+    | Nothing ->
+        let (value, next) = action <| st with gnu_return_query_cache= Just Map.empty |> in
+        (value, <| next with gnu_return_query_cache= Nothing |>)
+  end
+
+val memo_gnu_return_query:
+  Symbol.sym -> gnu_return_query_key -> elabM (bool * bool) -> elabM (bool * bool)
+let memo_gnu_return_query target key action = fun st ->
+  match st.gnu_return_query_cache with
+    | Nothing -> action st
+    | Just cache ->
+        let entries = maybe [] (fun entries -> entries) (Map.lookup target cache) in
+        match List.lookup key entries with
+          | Just result ->
+              let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                "GNU incoming return cache hit " ^ show target) in
+              (result, st)
+          | Nothing ->
+              let (result, next) = action st in
+              let cached = match next.gnu_return_query_cache with
+                | Nothing -> Nothing
+                | Just cache ->
+                    let entries = maybe [] (fun entries -> entries) (Map.lookup target cache) in
+                    Just (Map.insert target ((key, result) :: entries) cache)
+              end in
+              (result, <| next with gnu_return_query_cache= cached |>)
+        end
+  end
+
