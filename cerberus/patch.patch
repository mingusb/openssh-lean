+  | A.AilEident sym -> Just sym
+  | A.AilErvalue operand -> gnu_loop_profile_counter operand
+  | A.AilEunary A.PostfixDecr (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> Just sym
+  | A.AilEannot _ operand -> gnu_loop_profile_counter operand
+  | A.AilEbinary operand A.Gt
+      (A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant number _ _)))) ->
+      if number = 0 then gnu_loop_profile_counter operand else Nothing
+  | _ -> Nothing
