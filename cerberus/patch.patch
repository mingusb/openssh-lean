diff --git a/tests/openssh-gnu-modes/zero-array-init.c b/tests/openssh-gnu-modes/zero-array-init.c
new file mode 100644
index 00000000..0ca8800a
--- /dev/null
+++ b/tests/openssh-gnu-modes/zero-array-init.c
@@ -0,0 +1,17 @@
+/* GCC diagnoses excess entries and ignores their evaluations. */
+static int effects;
+static int nested_static[2][0];
+static int tick(void) { ++effects; return 9; }
+struct tail { int tag; int empty[0]; };
+struct middle { int before; int empty[0]; int after; };
+int main(void) {
+    int empty[0] = { tick() };
+    int nested[2][0] = { { tick() }, { tick() } };
+    struct tail a = { 7, { tick() } };
+    struct middle b = { 11, 23 };
+    if (effects != 0 || a.tag != 7) return 1;
+    if (sizeof empty != 0 || sizeof nested != 0 || sizeof nested_static != 0) return 2;
+    /* Brace elision does not skip the zero member: 23 is excess. */
+    if (b.before != 11 || b.after != 0) return 3;
+    return 0;
+}
diff --git a/tests/openssh-gnu-modes/zero-array-layout.c b/tests/openssh-gnu-modes/zero-array-layout.c
new file mode 100644
index 00000000..ed257208
--- /dev/null
+++ b/tests/openssh-gnu-modes/zero-array-layout.c
@@ -0,0 +1,31 @@
+/* GNU zero-length arrays on the configured AMD64 ABI. */
+struct tail { char tag; int words[0]; };
+struct wide_tail { char tag; double words[0]; };
+struct file_handle { unsigned int handle_bytes; int handle_type; unsigned char f_handle[0]; };
+union aligned_zero { double empty[0]; char byte; };
+typedef int zero_array[0];
+static zero_array empty;
+static struct tail initial = { 7 };
+_Static_assert(sizeof(zero_array) == 0, "zero size");
+_Static_assert(_Alignof(zero_array) == _Alignof(int), "element alignment");
+_Static_assert(sizeof(struct tail) == 4, "tail padding");
+_Static_assert(__builtin_offsetof(struct tail, words) == 4, "tail offset");
+_Static_assert(sizeof(struct wide_tail) == 8, "wide tail padding");
+_Static_assert(__builtin_offsetof(struct wide_tail, words) == 8, "wide tail offset");
+_Static_assert(sizeof(struct file_handle) == 8, "system header layout");
+_Static_assert(__builtin_offsetof(struct file_handle, f_handle) == 8, "system header offset");
+_Static_assert(sizeof(union aligned_zero) == 8, "union alignment rounding");
+_Static_assert(_Alignof(union aligned_zero) == 8, "union element alignment");
+_Static_assert(__builtin_types_compatible_p(zero_array, int[]), "incomplete compatibility");
+_Static_assert(!__builtin_types_compatible_p(zero_array, int[1]), "zero is not one");
+int main(void) {
+    zero_array local;
+    struct tail a = { 9 }, b = initial;
+    union aligned_zero u = { .byte = 11 };
+    if (sizeof empty != 0 || sizeof local != 0) return 1;
+    if (sizeof a.words != 0 || a.tag != 9 || b.tag != 7) return 2;
+    if (u.byte != 11) return 3;
+    /* Forming the array's base address is valid; no zero-storage read. */
+    if ((void *)a.words != (void *)((char *)&a + 4)) return 4;
+    return 0;
+}
