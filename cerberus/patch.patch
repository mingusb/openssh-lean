+        | C.OpSub -> Just (gnu_scalar_core_number (first-second))
+        | C.OpMul -> Just (gnu_scalar_core_number (first*second))
+        | C.OpEq -> Just (gnu_scalar_core_bool (first = second))
+        | C.OpLt -> Just (gnu_scalar_core_bool (first < second))
+        | C.OpLe -> Just (gnu_scalar_core_bool (first <= second))
+        | C.OpGt -> Just (gnu_scalar_core_bool (first > second))
+        | C.OpGe -> Just (gnu_scalar_core_bool (first >= second))
