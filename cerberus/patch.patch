+import CerbSavedProgram
+import CerbRuntimeInit
+import CerbSavedRegion
+import Unit.SymbolResolutionTest
+import Unit.FastLocationTest
+
+private def check (value : Bool) (message : String) : IO Unit := do
+  unless value do throw (IO.userError message)
+
+def main (args : List String) : IO UInt32 := do
+  let [directory] := args | throw (IO.userError "test output directory required")
+  CerbRuntimeInit.prepare
+  FastLocationTest.run
+  @SymbolResolutionTest.run ⟨100⟩
+  check (← CerbMemo.nativeConfigured) "model-data caches were not initialized"
+  let bindingPath := directory ++ "/binding.json"
+  let artifactPath := directory ++ "/core.json"
+  let producer := String.ofList (List.replicate 64 'a')
+  let binding := Lean.Json.mkObj [
+    ("scope", Lean.toJson "configured-openssh-target-link-input-provenance"),
+    ("receipt_mode", Lean.toJson "target-inputs-only"),
+    ("host_abi", Lean.toJson "linux-amd64"),
+    ("semantic_switches", Lean.toJson ["gnu_pointer_conversions"]),
+    ("frontend_order", Lean.toJson [Lean.Json.null]),
+    ("translator", Lean.Json.mkObj [("sha256", Lean.toJson producer)]),
+    ("input_provenance_verified", Lean.toJson true),
+    ("linked_core_certified", Lean.toJson false),
+    ("lean_argv_executed", Lean.toJson false),
+    ("fuel", Lean.toJson (100 : Nat)),
+    ("address_space_top", Lean.toJson (281474976710655 : Nat))]
+  IO.FS.writeFile bindingPath binding.compress
+  let parameters ← CerbSavedProgram.readParameters bindingPath producer
+  let snapshot : CerbCoreQuote.CoreSnapshot := {
+    main := none
+    callingConvention := .Normal_callconv
+    tagDefs := [], enumDefs := [], stdlib := [], impl0 := [], globs := []
+    funs := [], extern := [], funinfo := [], loopAttributes := [], visibleObjects := [] }
+  let artifact : CerbCoreData.Artifact := {
+    schemaVersion := 1
+    sourceBindingPath := bindingPath
+    sourceBindingSHA256 := parameters.bindingSHA256
+    translatorSHA256 := producer
+    semanticSwitches := "gnu_pointer_conversions"
+    fieldNames := CerbCoreQuote.linkedCoreFieldNames
+    supply := 1
+    executionDigest := "codec-fixture"
+    orderedDigests := ["codec-fixture"]
+    linkedFunctionCount := 0
+    linkedGlobalCount := 0
+    snapshot := snapshot }
+  check (CerbSavedProgram.validateHeader artifact bindingPath parameters) "valid old producer rejected"
+  for invalid in [
+      { artifact with schemaVersion := 2 },
+      { artifact with translatorSHA256 := "wrong" },
+      { artifact with sourceBindingSHA256 := "wrong" },
+      { artifact with semanticSwitches := "different" },
+      { artifact with fieldNames := #[] },
+      { artifact with orderedDigests := [] },
+      { artifact with linkedFunctionCount := 1 },
+      { artifact with linkedGlobalCount := 1 }] do
+    check (!CerbSavedProgram.validateHeader invalid bindingPath parameters) "invalid artifact accepted"
+  IO.FS.writeFile artifactPath (Lean.toJson artifact).compress
+  let hash ← CerbCoreQuote.hashFile "sha256sum" artifactPath 64
+  let loaded ← CerbSavedProgram.load bindingPath artifactPath hash producer
+  check (loaded.coreFile.main == none && loaded.supply == 1) "typed data load differs"
+  check ((← CerbCoreQuote.hashFile "sha256sum" (← IO.appPath).toString 64) != producer)
+    "test must exercise an independent consumer binary"
+  let region := directory ++ "/data.olean"
+  let manifest := directory ++ "/region.json"
+  let layout := String.ofList (List.replicate 64 'b')
+  CerbSavedRegion.prepare bindingPath artifactPath hash producer region layout
+  let regionHash ← CerbCoreQuote.hashFile "sha256sum" region 64
+  let metadata := Lean.Json.mkObj [
+    ("schema", Lean.toJson (1 : Nat)), ("raw_sha256", Lean.toJson hash),
+    ("binding_sha256", Lean.toJson parameters.bindingSHA256),
+    ("producer_sha256", Lean.toJson producer), ("layout_sha256", Lean.toJson layout),
+    ("region", Lean.toJson region), ("region_sha256", Lean.toJson regionHash)]
+  IO.FS.writeFile manifest metadata.compress
+  let restored ← CerbSavedRegion.load bindingPath manifest hash producer
+  check (restored.coreFile.main == none && restored.supply == 1 &&
+    restored.executionDigest == loaded.executionDigest) "binary region differs from JSON"
+  -- Corrupt an unmapped copy. Never truncate a region with live references.
+  let corruptRegion := region ++ ".bad"
+  IO.FS.writeFile corruptRegion "corrupted"
+  IO.FS.writeFile manifest (metadata.compress.replace region corruptRegion)
+  let corrupt ← (CerbSavedRegion.load bindingPath manifest hash producer).toBaseIO
+  check (match corrupt with | .error _ => true | .ok _ => false)
+    "corrupt region reached type-erased decoding"
+  IO.FS.writeFile manifest metadata.compress
+  IO.FS.writeFile (directory ++ "/cache-fixture.json") (Lean.Json.mkObj [
+    ("binding", Lean.toJson bindingPath), ("manifest", Lean.toJson manifest),
+    ("raw_sha256", Lean.toJson hash), ("producer_sha256", Lean.toJson producer)]).compress
+  let badHash ← (CerbSavedProgram.load bindingPath artifactPath "bad" producer).toBaseIO
+  check (match badHash with | .error _ => true | .ok _ => false) "bad content digest accepted"
+  IO.FS.writeFile bindingPath (binding.compress ++ " ")
+  let changedBinding ← (CerbSavedProgram.load bindingPath artifactPath hash producer).toBaseIO
+  check (match changedBinding with | .error _ => true | .ok _ => false) "changed binding accepted"
+  IO.FS.writeFile bindingPath binding.compress
+  IO.println "saved Core producer/consumer and typed-codec checks passed (synthetic data only)"
+  return 0
diff --git a/lean_frontend/test/Unit/StatementRegionTest.lean b/lean_frontend/test/Unit/StatementRegionTest.lean
new file mode 100644
index 00000000..26386694
--- /dev/null
+++ b/lean_frontend/test/Unit/StatementRegionTest.lean
@@ -0,0 +1,135 @@
+import Core_reduction
+import Driver
+import CoreParser
+
+/- Direct Core controls complement the native/three-engine C corpus. In
+   particular, malformed Core can bypass C's prohibition on inward jumps. -/
+namespace StatementRegionTest
+
+def symbol (n : Nat) : sym := sym.Symbol "statement-region-test" n SD_None
+def outer := symbol 1
+def inner := symbol 2
+def sibling := symbol 3
+def proc := symbol 4
+def label := symbol 5
+def argument := symbol 6
+
+def unitPe : pexpr := Pexpr [] () (PEval Vunit)
+def unitBody : expr core_run_annotation := Expr [] (Epure unitPe)
+def pureBody : expr Unit := Expr [] (Epure unitPe)
+def context0 : context := Cbound [] CTX
+def frame : stack core_run_annotation := Stack_cons2 (some proc) CTX Stack_empty
+def outerStack := Stack_region outer context0 frame
+def innerStack := Stack_region inner CTX outerStack
+
+def initialThread (arena : expr core_run_annotation)
+    (sk : stack core_run_annotation) : thread_state :=
+  { (default : thread_state) with
+    arena := arena, stack0 := sk, env := [Lem_Map.fromList [(argument, Vtrue)]],
+    current_proc_opt := some proc }
+
+def steps (fuel : Nat) (thread : thread_state) : List core_step2 :=
+  letI := LemFuel.mk fuel
+  step_ctx fmapEmpty fmapEmpty (CerbMem.initialMemState 0x10000)
+    (default : generic_file Unit core_run_annotation) fmapEmpty 0 (none, thread)
+
+def continuationState (path : List sym) : core_run_state :=
+  { (default : core_run_state) with
+    labeled := Lem_Map.fromList [(proc, Lem_Map.fromList [(label, ([], unitBody, path))])] }
+
+def jumpResult (fuel : Nat) (path : List sym) (sk : stack core_run_annotation) :
+    Except String thread_state :=
+  let thread := initialThread (Expr [] (Erun empty_annotation label [])) sk
+  match steps fuel thread with
+  | [Step_with_runstate2 (RSK_eval "Erun") action] =>
+    match action (continuationState path) with
+    | Exception (Illformed_program message) => .error message
+    | Result (Defined result, _) => .ok result
+    | _ => .error "unexpected run result"
+  | _ => .error "unexpected step kind"
+
+def refused (fuel : Nat) (path : List sym) (sk : stack core_run_annotation) : Bool :=
+  match jumpResult fuel path sk with
+  | .error "Erun: jump into an inactive indivisible region" => true
+  | _ => false
+
+def transferred (fuel : Nat) (path : List sym) (before after : stack core_run_annotation) : Bool :=
+  match jumpResult fuel path before with
+  | .ok result =>
+    result.stack0 == after &&
+    result.arena == (if path.isEmpty then unitBody else Expr [] (Ebound unitBody)) &&
+    result.env == (initialThread unitBody before).env && result.current_proc_opt == some proc
+  | .error _ => false
+
+def entered (fuel : Nat) : Bool :=
+  let thread := initialThread (Expr [] (Eindivisible outer unitBody)) frame
+  match steps fuel thread with
+  | [step@(Step_ccall2 0 action)] =>
+    !can_advance step && match action (default : core_run_state) with
+      | Result (Defined (Sum.inr result), _) =>
+        result.arena == Expr [] (Ebound unitBody) &&
+        result.stack0 == Stack_region outer CTX frame &&
+        result.env == thread.env && result.current_proc_opt == thread.current_proc_opt
+      | _ => false
+  | _ => false
+
+def exited (fuel : Nat) : Bool :=
+  let thread := initialThread unitBody outerStack
+  match steps fuel thread with
+  | [Step_tau2 "end of indivisible region" _ result] =>
+    result.arena == Expr [] (Ebound unitBody) && result.stack0 == frame &&
+    result.env == thread.env && result.current_proc_opt == thread.current_proc_opt
+  | _ => false
+
+def saved (name : sym) : expr Unit := Expr [] (Esave (name, BTy_unit) [] pureBody)
+def region (name : sym) (body : expr Unit) : expr Unit := Expr [] (Eindivisible name body)
+def lookupPath (name : sym) (body : expr Unit) : Option (List sym) :=
+  match fmapLookupBy (@Lem_Map.MapKeyType.mapKeyCompare sym _) name (collect_saves body) with
+  | some (_, _, path) => some path
+  | none => none
+def measuredHasLabel (name : sym) (body : expr Unit) : Bool :=
+  (fmapLookupBy (@Lem_Map.MapKeyType.mapKeyCompare sym _) name (m_collect_saves body)).isSome
+
+def parserSeparatesRegions : Bool :=
+  match CoreParser.pExpr.run
+      "nd(indivisible(same, pure(Unit)), indivisible(same, pure(Unit)))" with
+  | .ok (Expr _ (End [Expr _ (Eindivisible a _), Expr _ (Eindivisible b _)])) => a != b
+  | _ => false
+
+def checks (fuel : Nat) : List (String × Bool) := [
+  ("active region path is innermost first", active_region_path innerStack == [inner, outer]),
+  ("call frame hides caller regions", active_region_path (Stack_cons2 (some proc) CTX innerStack) == []),
+  ("jump helper preserves current region", exit_regions_for_jump [inner, outer] innerStack == some innerStack),
+  ("jump helper leaves inner region", exit_regions_for_jump [outer] innerStack == some outerStack),
+  ("jump helper leaves all regions", exit_regions_for_jump [] innerStack == some frame),
+  ("inactive region is refused", refused fuel [outer] frame),
+  ("sibling region is refused", refused fuel [sibling] outerStack),
+  ("missing outer path is refused", refused fuel [inner] innerStack),
+  ("callee cannot enter caller region", refused fuel [outer] (Stack_cons2 (some proc) CTX outerStack)),
+  ("same-region transfer preserves environment", transferred fuel [inner, outer] innerStack innerStack),
+  ("outward transfer preserves enclosing region", transferred fuel [outer] innerStack outerStack),
+  ("fully outward transfer restores procedure frame", transferred fuel [] innerStack frame),
+  ("entry is a scheduling barrier and preserves environment", entered fuel),
+  ("completion restores saved context and environment", exited fuel),
+  ("nested region continuation path", lookupPath label (region outer (region inner (saved label))) == some [inner, outer]),
+  ("closed region label under nondeterministic choice", lookupPath label (Expr [] (End [region outer (saved label)])) == some [outer]),
+  ("measured collector visits nondeterministic choice", measuredHasLabel label (Expr [] (End [region outer (saved label)]))),
+  ("ordinary unsupported choice label is not invented", lookupPath label (Expr [] (End [saved label])) == none),
+  ("full-expression boundary retains closed region", lookupPath label (Expr [] (Ebound (region outer (saved label)))) == some [outer]),
+  ("spawned thread starts an independent region path", lookupPath label (region outer (Expr [] (Epar [region inner (saved label)]))) == some [inner]),
+  ("repeated Core display names have distinct lexical identities", parserSeparatesRegions)
+]
+
+end StatementRegionTest
+
+def main (args : List String) : IO UInt32 := do
+  let some fuel := args.head?.bind String.toNat?
+    | IO.eprintln "statement-region-test: expected caller-selected fuel"; return 2
+  let checks := StatementRegionTest.checks fuel
+  let mut failed := false
+  for (name, passed) in checks do
+    IO.println s!"{if passed then "PASS" else "FAIL"} {name}"
+    failed := failed || !passed
+  if failed then return 1
+  IO.println s!"Statement regions: {checks.length} checks passed"
+  return 0
diff --git a/lean_frontend/test/Unit/SymbolResolutionTest.lean b/lean_frontend/test/Unit/SymbolResolutionTest.lean
new file mode 100644
index 00000000..2213cc9b
--- /dev/null
+++ b/lean_frontend/test/Unit/SymbolResolutionTest.lean
@@ -0,0 +1,78 @@
+import Core_eval
+
+namespace SymbolResolutionTest
+
+private def ensure (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError ("symbol resolution: " ++ message))
+
+private def insert {α : Type} (key : sym) (value : α) (map : Fmap sym α) : Fmap sym α :=
+  fmapAddBy (fun a b => Lem_Basic_classes.ordCompare a b) key value map
+
+private def symbol (n : Nat) (digest : String := "resolution") : sym :=
+  .Symbol digest n .SD_None
+
+private def emptyFile : file core_run_annotation := {
+  main := none, calling_convention0 := .Normal_callconv
+  tagDefs := fmapEmpty, enumDefs := fmapEmpty, stdlib := fmapEmpty
+  impl0 := fmapEmpty, globs := [], funs := fmapEmpty, extern := fmapEmpty
+  funinfo := fmapEmpty, loop_attributes1 := fmapEmpty, visible_objects_env0 := fmapEmpty }
+
+private def site := CerbLocation.other "symbol resolution call site"
+
+private def resolve [LemFuel] (program : file core_run_annotation) (key : sym)
+    (aliases : Fmap sym sym := fmapEmpty) (env : List (Fmap sym value) := []) :=
+  step_eval_pexpr fmapEmpty fmapEmpty 0 site none aliases env none program false
+    (.Pexpr [] () (.PEsym key))
+
+private def result (v : value) : t1 pexpr core_run_cause :=
+  .Result (.Defined (.Pexpr [] () (.PEval v)))
+
+private def pointer (key : sym) : t1 pexpr core_run_cause :=
+  result (.Vobject (.OVpointer (CerbMem.funPtrval key)))
+
+private def unresolved (key : sym) : t1 pexpr core_run_cause :=
+  .Exception (.Unresolved_symbol site key)
+
+-- Exercise the actual generated evaluator, including failure cases and distinct
+-- program maps. These are common interpreter contracts, independent of OpenSSH.
+def run [LemFuel] : IO Unit := do
+  let key := symbol 7
+  let alias := symbol 8
+  let third := symbol 9
+  let info : file core_run_annotation := {
+    emptyFile with funinfo := insert key (site, no_attributes, signed_int, [], false, true) fmapEmpty }
+  ensure (resolve info key == pointer key) "declaration without body"
+  ensure (resolve emptyFile key == unresolved key) "missing symbol must fail with original location"
+  ensure (resolve info key fmapEmpty [insert key .Vtrue fmapEmpty] == result .Vtrue)
+    "local value must shadow function declaration"
+  ensure (resolve info key fmapEmpty [insert key .Vfalse fmapEmpty, insert key .Vtrue fmapEmpty]
+    == result .Vfalse) "innermost local scope"
+  let aliases := insert alias key fmapEmpty
+  ensure (resolve info alias aliases == pointer key) "external symbol resolves to canonical pointer"
+  ensure (resolve info alias aliases [insert key .Vtrue fmapEmpty, insert alias .Vfalse fmapEmpty]
+    == result .Vtrue) "alias resolution precedes environment lookup"
+  ensure (resolve info alias (insert key third aliases) == pointer key)
+    "external aliases resolve exactly once"
+  ensure (resolve emptyFile alias aliases == unresolved key) "failure reports resolved symbol"
+  let proc : generic_fun_map_decl Unit core_run_annotation :=
+    .Proc site none default [] (.Expr [] (.Epure (.Pexpr [] () (.PEval .Vunit))))
+  ensure (resolve { emptyFile with funs := insert key proc fmapEmpty } key == pointer key)
+    "procedure body fallback"
+  for declaration in [generic_fun_map_decl.Fun default [] (.Pexpr [] () (.PEval .Vunit)),
+      .ProcDecl site default [], .BuiltinDecl site default []] do
+    ensure (resolve { emptyFile with funs := insert key declaration fmapEmpty } key == unresolved key)
+      "non-procedure definitions cannot become function pointers"
+  let peer := symbol 7 "different translation unit"
+  ensure (resolve info peer == unresolved peer) "symbol digest distinguishes identical serials"
+  let peerFile := { emptyFile with funinfo := insert peer (site, no_attributes, signed_int, [], false, true) fmapEmpty }
+  ensure (resolve peerFile peer == pointer peer && resolve peerFile key == unresolved key)
+    "another program cannot inherit the first program's declaration"
+  let mut large := emptyFile
+  for n in List.range 4096 do
+    large := { large with funinfo := insert (symbol n) (site, no_attributes, signed_int, [], false, true) large.funinfo }
+  for n in [0, 7, 2048, 4095] do
+    ensure (resolve large (symbol n) == pointer (symbol n)) "large declaration table hit"
+  ensure (resolve large (symbol 4096) == unresolved (symbol 4096)) "large declaration table miss"
+  IO.println "shared symbol resolution controls passed: declarations, scopes, aliases, procedures, failures, distinct programs and 4096-entry table"
+
+end SymbolResolutionTest
