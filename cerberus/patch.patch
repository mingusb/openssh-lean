@@ -0,0 +1,515 @@
+import CerbMemoPass
+import Std
+
+/- Pure descriptor state for the pinned Linux host boundary.
+No definition in this module performs IO or interprets an unbound guest number
+as a native descriptor. The single process owner publishes a returned table
+atomically with modeled memory after one native effect; it must not replay an
+old pure state, retry that effect, or run concurrent effects using one ticket. -/
+namespace CerbHostDescriptors
+
+structure Description where
+  id : Nat
+  /-- Actual F_GETFL observation, or unknown. Never an F_SETFL request. -/
+  statusFlags : Option UInt32 := none
+  deriving BEq, Repr
+
+structure Entry where
+  guest : Nat
+  native : UInt32
+  generation : Nat
+  description : Nat
+  /-- Actual descriptor flags, or a value established by an exact API contract. -/
+  descriptorFlags : Option UInt32 := none
+  deriving BEq, Repr
+
+inductive BorrowKind where
+  | file | directory
+  deriving BEq, Repr
+
+structure BorrowKey where
+  kind : BorrowKind
+  token : UInt64
+  deriving BEq, Repr
+
+structure Borrow where
+  key : BorrowKey
+  guest : Nat
+  generation : Nat
+  deriving BEq, Repr
+
+inductive DupKind where
+  | dup2
+  /-- The call's flags have already been validated as 0 or O_CLOEXEC. -/
+  | dup3 (closeOnExec : Bool)
+  deriving BEq, Repr
+
+structure Ticket where
+  private mk ::
+  session : Nat
+  serial : Nat
+  deriving BEq, Repr
+
+private inductive Operation where
+  | fresh (guests : List Nat)
+  | duplicate (source : Entry) (guest : Nat) (closeOnExec : Bool)
+  | exact (source : Entry) (target : Nat) (oldTarget : Option Entry) (kind : DupKind)
+  | close (entry : Entry)
+  | closeBorrow (key : BorrowKey) (entry : Entry)
+  deriving BEq, Repr
+
+private structure Pending where
+  ticket : Ticket
+  operation : Operation
+  deriving BEq, Repr
+
+structure Table where
+  private mk ::
+  session : Nat
+  limit : Nat
+  entries : List Entry
+  descriptions : List Description
+  borrows : List Borrow
+  private nextGeneration : Nat
+  private nextDescription : Nat
+  private nextSerial : Nat
+  private pending : Option Pending
+  deriving BEq, Repr
+
+inductive NativeAction where
+  | create (count : Nat)
+  | duplicate (source : UInt32) (closeOnExec : Bool)
+  /-- none is an unbound native destination, NOT the numeric guest target.
+  It requires a backend that preserves exact-target errors and ownership.
+  The current raw dup2 adapter cannot execute that case. -/
+  | duplicateExact (source : UInt32) (target : Option UInt32) (kind : DupKind)
+  | close (descriptor : UInt32)
+  | closeBorrow (key : BorrowKey) (descriptor : UInt32)
+  deriving BEq, Repr
+
+structure Plan where
+  private mk ::
+  ticket : Ticket
+  guests : List Nat
+  action : NativeAction
+  deriving BEq, Repr
+
+structure Returned where
+  native : UInt32
+  descriptorFlags : Option UInt32 := none
+  statusFlags : Option UInt32 := none
+  deriving BEq, Repr
+
+/-- Failure preserves its actual return and errno as evidence. This module
+never synthesizes an errno result on behalf of the guest. -/
+inductive CreateOutcome where
+  | failed (returnValue : Int) (nativeErrnoAfter : UInt32)
+  | returned (descriptors : List Returned)
+  deriving BEq, Repr
+
+inductive DupOutcome where
+  | failed (returnValue : Int) (nativeErrnoAfter : UInt32)
+  | returned (native : UInt32)
+  deriving BEq, Repr
+
+inductive CloseDisposition where
+  | consumed | retained
+  deriving BEq, Repr
+
+structure CloseOutcome where
+  returnValue : Int
+  nativeErrnoAfter : UInt32
+  disposition : CloseDisposition
+  deriving BEq, Repr
+
+private def fail {α : Type} (message : String) : Except String α := .error message
+private def unique {α : Type} [BEq α] : List α → Bool
+  | [] => true
+  | a :: rest => !rest.contains a && unique rest
+private def nativeValid (fd : UInt32) : Bool := fd.toNat ≤ 2147483647
+private def entry? (table : Table) (guest : Nat) : Option Entry :=
+  table.entries.find? (fun entry => entry.guest == guest)
+
+private def validate (table : Table) : Except String Unit := do
+  if table.limit > 2147483648 then fail "guest descriptor limit exceeds signed-int domain"
+  if !unique (table.entries.map (·.guest)) then fail "duplicate guest descriptor"
+  if !unique (table.entries.map (·.native)) then fail "duplicate native descriptor ownership"
+  if !unique (table.entries.map (·.generation)) then fail "duplicate descriptor generation"
+  if !unique (table.descriptions.map (·.id)) then fail "duplicate open-description identity"
+  if !unique (table.borrows.map (·.key)) then fail "duplicate borrowed-object identity"
+  for entry in table.entries do
+    if entry.guest ≥ 2147483648 then fail "guest descriptor is outside signed-int domain"
+    if !nativeValid entry.native then fail "native descriptor is outside signed-int domain"
+    if !table.descriptions.any (fun description => description.id == entry.description) then
+      fail "descriptor has no open-description record"
+    if entry.generation ≥ table.nextGeneration then fail "descriptor generation allocator collision"
+  for description in table.descriptions do
+    if description.id ≥ table.nextDescription then fail "description allocator collision"
+
+private def idle (table : Table) : Except String Unit := do
+  validate table
+  if table.pending.isSome then fail "another descriptor operation is already reserved"
+
+/-- Validate the complete table and require no reserved operation before any host effect. -/
+def validateIdle (table : Table) : Except String Unit := idle table
+
+private def checked (table : Table) : Except String Table := do
+  validate table
+  return table
+
+/-- The caller must supply the COMPLETE initial guest table under the declared
+process profile, including inherited descriptors and actual alias relationships.
+Unknown flags remain unknown; neither native numbers nor equal flags establish
+open-description identity. A session id must be unique in the host worker. -/
+def create (session limit : Nat) (entries : List Entry)
+    (descriptions : List Description) : Except String Table := do
+  checked {
+    session := session
+    limit := limit
+    entries := entries
+    descriptions := descriptions
+    borrows := []
+    nextGeneration := entries.foldl (fun n entry => max n (entry.generation + 1)) 0
+    nextDescription := descriptions.foldl (fun n description => max n (description.id + 1)) 0
+    nextSerial := 0
+    pending := none
+  }
+
+/-- Inventory membership only. The complete-table assumption belongs to
+create's host-session contract, not to a failed lookup or exception string. -/
+inductive Resolution where
+  | mapped (entry : Entry)
+  | absent
+  deriving BEq, Repr
+
+def classify (table : Table) (guest : Int) : Except String Resolution := do
+  validate table
+  if guest < -2147483648 || guest > 2147483647 then
+    fail "guest descriptor argument is outside signed-int domain"
+  if guest < 0 then return .absent
+  match entry? table guest.toNat with
+  | some entry => return .mapped entry
+  | none => return .absent
+
+def lookup (table : Table) (guest : Int) : Except String Entry := do
+  match ← classify table guest with
+  | .mapped entry => return entry
+  | .absent => fail "unresolved invalid or unmapped guest descriptor outcome and error ordering"
+
+def resolve (table : Table) (guest : Int) : Except String UInt32 := do
+  return (← lookup table guest).native
+
+def statusFlags (table : Table) (guest : Int) : Except String (Option UInt32) := do
+  let entry ← lookup table guest
+  match table.descriptions.find? (fun d => d.id == entry.description) with
+  | none => fail "missing open description"
+  | some description => return description.statusFlags
+
+/-- Bounded by occupied-count+1: among that many candidates one is free.
+This does not scan to a potentially huge RLIMIT_NOFILE value. -/
+private def firstFree (occupied : List Nat) (limit start : Nat) : Nat → Option Nat
+  | 0 => none
+  | remaining + 1 =>
+    if start ≥ limit then none
+    else if occupied.contains start then firstFree occupied limit (start + 1) remaining
+    else some start
+
+private def chooseGuests (occupied : List Nat) (limit minimum : Nat) :
+    Nat → Except String (List Nat)
+  | 0 => .ok []
+  | count + 1 => do
+    let some guest := firstFree occupied limit minimum (occupied.length + 1)
+      | fail "unresolved guest descriptor exhaustion and native error ordering"
+    let rest ← chooseGuests (guest :: occupied) limit minimum count
+    return guest :: rest
+
+private def beginOperation (table : Table) (operation : Operation)
+    (guests : List Nat) (action : NativeAction) : Except String (Table × Plan) := do
+  idle table
+  let ticket : Ticket := ⟨table.session, table.nextSerial⟩
+  let next := { table with
+    nextSerial := table.nextSerial + 1
+    pending := some ⟨ticket, operation⟩ }
+  return (next, ⟨ticket, guests, action⟩)
+
+def reserveFresh (table : Table) (count : Nat) : Except String (Table × Plan) := do
+  idle table
+  if count == 0 then fail "a descriptor-producing operation requires a nonempty reservation"
+  if count > table.limit - (table.entries.filter (fun entry => entry.guest < table.limit)).length then
+    fail "unresolved guest descriptor exhaustion and native error ordering"
+  let guests ← chooseGuests (table.entries.map (·.guest)) table.limit 0 count
+  beginOperation table (.fresh guests) guests (.create count)
+
+def reserveDuplicate (table : Table) (source : Int) (minimum : Nat := 0)
+    (closeOnExec : Bool := false) : Except String (Table × Plan) := do
+  idle table
+  let sourceEntry ← lookup table source
+  let guests ← chooseGuests (table.entries.map (·.guest)) table.limit minimum 1
+  match guests with
+  | [guest] =>
+    beginOperation table (.duplicate sourceEntry guest closeOnExec) guests
+      (.duplicate sourceEntry.native closeOnExec)
+  | _ => fail "internal duplicate reservation arity"
+
+def reserveExactDuplicate (table : Table) (source target : Int) (kind : DupKind) :
+    Except String (Table × Plan) := do
+  idle table
+  let sourceEntry ← lookup table source
+  -- Linux handles oldfd==newfd before checking RLIMIT_NOFILE: dup2 is
+  -- identity, while dup3 reports EINVAL. Existing high descriptors survive
+  -- limit reduction, so the reservation must still admit that native outcome.
+  if target < 0 || (source != target && target ≥ table.limit) then
+    fail "unresolved exact-target descriptor error and error ordering"
+  let oldTarget := entry? table target.toNat
+  beginOperation table (.exact sourceEntry target.toNat oldTarget kind) [target.toNat]
+    (.duplicateExact sourceEntry.native (oldTarget.map (·.native)) kind)
+
+def reserveClose (table : Table) (guest : Int) : Except String (Table × Plan) := do
+  idle table
+  let entry ← lookup table guest
+  beginOperation table (.close entry) [] (.close entry.native)
+
+private def current (table : Table) (ticket : Ticket) : Except String Operation := do
+  validate table
+  match table.pending with
+  | some pending =>
+    if pending.ticket == ticket then return pending.operation
+    else fail "stale or foreign descriptor operation ticket"
+  | none => fail "descriptor operation is already completed or was never reserved"
+
+/-- Cancel only before effect, or after an observed native failure with no
+descriptor ownership transfer. Returned live handles require terminal cleanup;
+cancellation alone must never be used to discard them. -/
+def cancel (table : Table) (ticket : Ticket) : Except String Table := do
+  let _ ← current table ticket
+  return { table with pending := none }
+
+private def gcDescriptions (entries : List Entry) (descriptions : List Description) :
+    List Description :=
+  descriptions.filter (fun description => entries.any (fun entry => entry.description == description.id))
+
+private def finish (table : Table) (entries : List Entry) (descriptions : List Description)
+    (nextGeneration nextDescription : Nat) : Except String Table :=
+  checked {
+    table with
+    entries := entries
+    descriptions := gcDescriptions entries descriptions
+    nextGeneration := nextGeneration
+    nextDescription := nextDescription
+    pending := none
+  }
+
+private def requireFailure (result : Int) : Except String Unit := do
+  if result != -1 then fail "native failure outcome must carry the actual -1 result"
+
+private def validateReturned (table : Table) (returned : List Returned) : Except String Unit := do
+  if !unique (returned.map (·.native)) then fail "duplicate returned native ownership"
+  for item in returned do
+    if !nativeValid item.native then fail "invalid returned native descriptor"
+    if table.entries.any (fun entry => entry.native == item.native) then
+      fail "returned descriptor aliases already-owned native handle"
+
+private def addFresh (table : Table) : List Nat → List Returned → Except String Table
+  | [], [] => return table
+  | guest :: guests, item :: returned => do
+    let description : Description := ⟨table.nextDescription, item.statusFlags⟩
+    let entry : Entry := ⟨guest, item.native, table.nextGeneration,
+      description.id, item.descriptorFlags⟩
+    addFresh {
+      table with
+      entries := table.entries ++ [entry]
+      descriptions := table.descriptions ++ [description]
+      nextGeneration := table.nextGeneration + 1
+      nextDescription := table.nextDescription + 1
+    } guests returned
+  | _, _ => fail "descriptor reservation/result arity mismatch"
+
+def completeFresh (table : Table) (ticket : Ticket) (outcome : CreateOutcome) :
+    Except String Table := do
+  let operation ← current table ticket
+  let .fresh guests := operation | fail "ticket is not a fresh-descriptor operation"
+  match outcome with
+  | .failed result _ =>
+    requireFailure result
+    cancel table ticket
+  | .returned returned =>
+    if guests.length != returned.length then fail "descriptor reservation/result arity mismatch"
+    validateReturned table returned
+    let added ← addFresh table guests returned
+    finish added added.entries added.descriptions added.nextGeneration added.nextDescription
+
+private def closeExecBits (enabled : Bool) : UInt32 := if enabled then 1 else 0
+
+def completeDuplicate (table : Table) (ticket : Ticket) (outcome : DupOutcome) :
+    Except String Table := do
+  let operation ← current table ticket
+  let .duplicate source guest closeOnExec := operation
+    | fail "ticket is not a duplicate-descriptor operation"
+  match outcome with
+  | .failed result _ =>
+    requireFailure result
+    cancel table ticket
+  | .returned native =>
+    validateReturned table [⟨native, none, none⟩]
+    let entry : Entry := ⟨guest, native, table.nextGeneration, source.description,
+      some (closeExecBits closeOnExec)⟩
+    finish table (table.entries ++ [entry]) table.descriptions
+      (table.nextGeneration + 1) table.nextDescription
+
+def completeExactDuplicate (table : Table) (ticket : Ticket) (outcome : DupOutcome) :
+    Except String Table := do
+  let operation ← current table ticket
+  let .exact source target oldTarget kind := operation
+    | fail "ticket is not an exact-target duplicate operation"
+  match outcome with
+  | .failed result _ =>
+    requireFailure result
+    cancel table ticket
+  | .returned native =>
+    if source.guest == target then
+      match kind with
+      | .dup3 _ => fail "dup3 cannot succeed when source and target are identical"
+      | .dup2 =>
+        if native != source.native then fail "dup2 identity returned a different native descriptor"
+        return ← cancel table ticket
+    if !nativeValid native then fail "invalid returned native descriptor"
+    match oldTarget with
+    | some old =>
+      if native != old.native then fail "exact-target replacement returned a different native target"
+    | none =>
+      if table.entries.any (fun entry => entry.native == native) then
+        fail "unbound exact-target result collides with an owned native descriptor"
+    let closeOnExec := match kind with
+      | .dup2 => false
+      | .dup3 enabled => enabled
+    let entry : Entry := ⟨target, native, table.nextGeneration, source.description,
+      some (closeExecBits closeOnExec)⟩
+    let entries := table.entries.filter (fun old => old.guest != target) ++ [entry]
+    finish table entries table.descriptions (table.nextGeneration + 1) table.nextDescription
+
+/-- Linux close releases the fd before EINTR/EIO and other late failures.
+EBADF against a validated owned mapping signals host-state drift; do not pretend
+that this proves a live mapping, or translate it into a successful guest close. -/
+def linuxCloseOutcome (result : Int) (errno : UInt32) : Except String CloseOutcome := do
+  if result == 0 then return ⟨result, errno, .consumed⟩
+  requireFailure result
+  if errno == 9 then fail "native EBADF for owned descriptor requires host-state reconciliation"
+  return ⟨result, errno, .consumed⟩
+
+def completeClose (table : Table) (ticket : Ticket) (outcome : CloseOutcome) :
+    Except String Table := do
+  let operation ← current table ticket
+  let .close entry := operation | fail "ticket is not a close operation"
+  let expected ← linuxCloseOutcome outcome.returnValue outcome.nativeErrnoAfter
+  if expected.disposition != outcome.disposition then fail "close disposition contradicts pinned Linux semantics"
+  match outcome.disposition with
+  | .retained =>
+    if outcome.returnValue == 0 then fail "successful close cannot retain descriptor ownership"
+    cancel table ticket
+  | .consumed =>
+    let entries := table.entries.filter (fun old => old.guest != entry.guest)
+    finish table entries table.descriptions table.nextGeneration table.nextDescription
+
+/-- Borrowing adds no native ownership and performs no native duplicate.
+Distinct FILE objects may legally retain the same original descriptor number. -/
+def attachBorrow (table : Table) (key : BorrowKey) (guest : Int) : Except String Table := do
+  idle table
+  let entry ← lookup table guest
+  if table.borrows.any (fun borrow => borrow.key == key) then fail "borrow token is already registered"
+  checked { table with borrows := table.borrows ++ [⟨key, entry.guest, entry.generation⟩] }
+
+def detachBorrow (table : Table) (key : BorrowKey) : Except String Table := do
+  idle table
+  if !table.borrows.any (fun borrow => borrow.key == key) then fail "unknown borrow token"
+  checked { table with borrows := table.borrows.filter (fun borrow => borrow.key != key) }
+
+private def borrowed (table : Table) (key : BorrowKey) : Except String Borrow := do
+  validate table
+  match table.borrows.find? (fun borrow => borrow.key == key) with
+  | some borrow => return borrow
+  | none => fail "unregistered borrowed-object identity"
+
+/-- fileno/dirfd may expose an object's original guest number even after close.
+This does not prove that native effects through that object remain safe. -/
+def originalGuest (table : Table) (key : BorrowKey) : Except String Nat := do
+  return (← borrowed table key).guest
+
+def resolveBorrow (table : Table) (key : BorrowKey) : Except String Entry := do
+  let borrow ← borrowed table key
+  let entry ← lookup table borrow.guest
+  if entry.generation != borrow.generation then
+    fail "borrowed object refers to a closed/replaced descriptor generation"
+  return entry
+
+/-- Reserve before fclose/pclose/closedir. A stale FILE-to-fd binding is an
+explicit boundary, because the native FILE embeds a reused native fd integer. -/
+def reserveBorrowClose (table : Table) (key : BorrowKey) : Except String (Table × Plan) := do
+  idle table
+  let entry ← resolveBorrow table key
+  beginOperation table (.closeBorrow key entry) [] (.closeBorrow key entry.native)
+
+/-- The family decoder has established that its actual native close consumed
+this object and reported its pre-close fd. This is not a second native close.
+Return value and errno stay with the original family completion, including
+pclose wait failures. Only this object token is retired; aliases remain stale. -/
+def completeBorrowClose (table : Table) (ticket : Ticket) (nativeBefore : UInt32) :
+    Except String Table := do
+  let operation ← current table ticket
+  let .closeBorrow key entry := operation | fail "ticket is not a borrowed-object close"
+  if nativeBefore != entry.native then fail "object close reported a different pre-close descriptor"
+  let entries := table.entries.filter (fun old => old.guest != entry.guest)
+  let next := { table with borrows := table.borrows.filter (fun borrow => borrow.key != key) }
+  finish next entries table.descriptions table.nextGeneration table.nextDescription
+
+/-- Reverse lookup is read-only. The supplied object token must still refer to
+this generation; otherwise native integer reuse must not redirect the object. -/
+def reverseBorrow (table : Table) (key : BorrowKey) (native : UInt32) : Except String Nat := do
+  let entry ← resolveBorrow table key
+  if entry.native != native then fail "borrowed native descriptor differs from registered generation"
+  return entry.guest
+
+def reverseLookup (table : Table) (native : UInt32) : Except String Entry := do
+  validate table
+  match table.entries.find? (fun entry => entry.native == native) with
+  | some entry => return entry
+  | none => fail "native descriptor has no existing guest identity; reverse lookup cannot adopt it"
+
+def invalidatedBorrows (table : Table) : List Borrow :=
+  table.borrows.filter (fun borrow =>
+    match entry? table borrow.guest with
+    | some entry => entry.generation != borrow.generation
+    | none => true)
+
+/-- Called only for an actual successful observation or a contract-established
+postcondition. F_SETFD's ignored bits must not be copied here from its argument. -/
+def observeDescriptorFlags (table : Table) (guest : Int) (actual : UInt32) :
+    Except String Table := do
+  idle table
+  let entry ← lookup table guest
+  checked { table with entries := table.entries.map (fun old =>
+    if old.generation == entry.generation then { old with descriptorFlags := some actual } else old) }
+
+/-- Update the shared open description from actual F_GETFL/post-call evidence.
+A successful F_SETFL argument is not such evidence and must not use this API. -/
+def observeStatusFlags (table : Table) (guest : Int) (actual : UInt32) :
+    Except String Table := do
+  idle table
+  let entry ← lookup table guest
+  checked { table with descriptions := table.descriptions.map (fun old =>
+    if old.id == entry.description then { old with statusFlags := some actual } else old) }
+
+/-- Invalidate cached status after an unobserved successful F_SETFL. Native fd
+state remains authoritative; no ignored or mutable bit is guessed here. -/
+def forgetStatusFlags (table : Table) (guest : Int) : Except String Table := do
+  idle table
+  let entry ← lookup table guest
+  checked { table with descriptions := table.descriptions.map (fun old =>
+    if old.id == entry.description then { old with statusFlags := none } else old) }
+
+/-- A successful RLIMIT_NOFILE change constrains future allocation. Existing
+descriptors above a newly lowered limit stay valid and must not be discarded. -/
+def observeAllocationLimit (table : Table) (actualLimit : Nat) : Except String Table := do
+  idle table
+  checked { table with limit := actualLimit }
+
+end CerbHostDescriptors
diff --git a/lean_frontend/host/families/files/HostFilesTest.lean b/lean_frontend/host/families/files/HostFilesTest.lean
new file mode 100644
index 00000000..5faf20a2
--- /dev/null
+++ b/lean_frontend/host/families/files/HostFilesTest.lean
@@ -0,0 +1,201 @@
+import CerbHostFilesAdapters
+open CerbHostFilesAdapters
+
+def ensure (condition : Bool) (message : String) : IO Unit :=
+  unless condition do throw (IO.userError message)
+
+def call (request : ResolvedRequest) : IO FilesResult := do
+  let result ← executeResolved 33 request
+  ensure result.boundaryError.isEmpty result.boundaryError
+  return result
+
+def successful (request : ResolvedRequest) : IO FilesResult := do
+  let result ← call request
+  ensure (result.status.value ≥ 0 && result.status.error == 0) "unexpected native failure"
+  return result
+
+def path (s : String) : ByteArray := s.toUTF8.push 0
+
+def child (parent : ByteArray) (suffix : String) : ByteArray :=
+  ((parent.extract 0 (parent.size - 1)) ++ suffix.toUTF8).push 0
+
+private def checkWrite : IO Unit := do
+  let pair ← successful (.pipe)
+  ensure (pair.fields.size == 2) "write fixture pipe arity"
+  let reader := pair.fields[0]!.toUInt32
+  let writer := pair.fields[1]!.toUInt32
+  let incoming : UInt32 := 4294967225
+  let payload : ByteArray := ⟨#[65,0,255,66,67]⟩
+  try
+    let result ← executeResolved incoming (.write writer payload)
+    ensure (result.boundaryError.isEmpty && result.status.value == 5 &&
+      result.status.error == 0 && result.nativeErrnoAfter == incoming)
+      "write count or success errno snapshot"
+    let read ← successful (.read reader 5)
+    ensure (read.bytes == payload) "write preserved binary bytes"
+    let empty ← executeResolved incoming (.write writer ByteArray.empty)
+    ensure (empty.status.value == 0 && empty.nativeErrnoAfter == incoming)
+      "zero-length write still records actual errno"
+    let bad ← executeResolved incoming (.write 4294967295 payload)
+    ensure (bad.status.value == -1 && bad.status.error == 9 && bad.nativeErrnoAfter == 9)
+      "write EBADF"
+  finally
+    discard <| executeResolved incoming (.close reader)
+    discard <| executeResolved incoming (.close writer)
+
+def main : IO Unit := do
+  let template := path "/tmp/cerb-files-lean-XXXXXX"
+  let created ← successful (.mkdtemp template)
+  ensure (created.bytes.size == template.size && created.bytes != template) "template copyback"
+  let root := created.bytes
+  let file := child root "/data"
+  let absent := child root "/missing"
+  let opened ← successful (.«open» file 194 384 1)
+  let fd := opened.status.value.toNat.toUInt32
+  let payload : ByteArray := ⟨#[0, 255, 65, 0, 66]⟩
+  let written ← successful (.writev fd #[2, 3] payload)
+  ensure (written.status.value == 5) "writev binary count"
+  discard <| successful (.lseek fd 0 0)
+  let fortifiedBoundary ← executeResolved 33 (.__read_chk fd 3 2)
+  ensure (!fortifiedBoundary.boundaryError.isEmpty) "fortify failure must not abort host"
+  let fortified ← successful (.__read_chk fd 3 5)
+  ensure (fortified.status.value == 3 && fortified.bytes == payload.extract 0 3) "fortified read"
+  discard <| successful (.lseek fd 0 0)
+  let first ← successful (.read fd 3)
+  ensure (first.status.value == 3 && first.bytes == payload.extract 0 3) "read binary prefix"
+  let short ← successful (.read fd 8)
+  ensure (short.status.value == 2 && short.bytes == payload.extract 3 5) "short read"
+  let eof ← successful (.read fd 8)
+  ensure (eof.status.value == 0 && eof.bytes.isEmpty) "EOF"
+  discard <| successful (.lseek fd 0 0)
+  let vector ← successful (.readv fd #[2, 3])
+  ensure (vector.status.value == 5 && vector.bytes == payload) "readv binary prefix"
+  let metadata ← successful (.fstat fd)
+  let pathMetadata ← successful (.stat file)
+  ensure (metadata.fields.size == 16 && metadata.fields[7]! == 5) "stat size"
+  ensure (metadata.fields == pathMetadata.fields) "fstat/stat fields"
+  ensure (metadata.bytes.size == 144 && metadata.bytes == pathMetadata.bytes) "complete stat bytes, including padding"
+  let filesystem ← successful (.fstatvfs fd)
+  ensure (filesystem.fields.size == 12 && filesystem.bytes.size == 112) "complete statvfs including f_type"
+  ensure ((filesystem.bytes.extract 92 112).data.all (· == 0)) "statvfs reserved bytes"
+
+  let copied ← successful (.dup fd)
+  let copy := copied.status.value.toNat.toUInt32
+  ensure (copy != fd) "dup creates a distinct descriptor"
+  discard <| successful (.lseek copy 0 0)
+  let shared ← successful (.read fd 1)
+  ensure (shared.bytes == payload.extract 0 1) "dup shares file offset"
+  let replaced ← successful (.dup2 fd copy)
+  ensure (replaced.status.value == copied.status.value) "dup2 target identity"
+  discard <| successful (.close copy)
+  let bad ← call (.close copy)
+  ensure (bad.status.value == -1 && bad.status.error == 9 && bad.nativeErrnoAfter == 9) "EBADF"
+  let missing ← call (.«open» absent 0 0 0)
+  ensure (missing.status.value == -1 && missing.status.error == 2 &&
+    missing.nativeErrnoAfter == 2) "ENOENT"
+  discard <| successful (.ftruncate fd 3)
+  let truncated ← successful (.fstat fd)
+  ensure (truncated.fields[7]! == 3) "truncate"
+  discard <| successful (.futimes fd #[12345, 100, 23456, 200])
+  let timestamps ← successful (.fstat fd)
+  ensure (timestamps.fields[10]! == 12345 && timestamps.fields[12]! == 23456) "timestamp fields"
+  let ranged ← successful (.dup fd)
+  let rangeFd := ranged.status.value.toNat.toUInt32
+  let uncertified ← executeResolved 33 (.close_range rangeFd rangeFd 0 0)
+  ensure (!uncertified.boundaryError.isEmpty) "close_range requires ownership"
+  discard <| successful (.close_range rangeFd rangeFd 4 1)
+  let closeFlags ← successful (.fcntl rangeFd 1 0)
+  ensure (closeFlags.status.value == 1) "close_range CLOEXEC"
+  discard <| successful (.close_range rangeFd rangeFd 0 1)
+  let rangeClosed ← call (.close rangeFd)
+  ensure (rangeClosed.status.error == 9) "close_range actually closes"
+  let fileMapped ← successful (.mmap 3 1 2 fd 0)
+  let fileToken := fileMapped.fields[0]!
+  let fileContents ← successful (.mapping_read fileToken 0 3)
+  ensure (fileContents.bytes == payload.extract 0 3) "file-backed mapping"
+  let readonly ← executeResolved 33 (.mapping_write fileToken 0 (payload.extract 0 3))
+  ensure (!readonly.boundaryError.isEmpty) "readonly mapping"
+  discard <| successful (.munmap fileToken 0 3)
+  discard <| successful (.close fd)
+  discard <| successful (.unlink file)
+  let directory ← successful (.opendir root)
+  ensure (directory.fields.size == 1) "directory token"
+  let token := directory.fields[0]!
+  discard <| successful (.dirfd token)
+  let mut dot := false
+  let mut dotdot := false
+  let mut done := false
+  -- The empty test directory contains exactly . and ..; bounded test loop only.
+  for _ in [:3] do
+    if !done then
+      let entry ← executeResolved 0 (.readdir token)
+      ensure entry.boundaryError.isEmpty entry.boundaryError
+      if entry.status.value == 0 then
+        ensure (entry.nativeErrnoAfter == 0) "directory EOF errno"
+        done := true
+      else
+        ensure (entry.status.value == 1 && entry.fields.size == 5 && entry.fields[4]! != 0) "dirent"
+        dot := dot || entry.bytes == path "."
+        dotdot := dotdot || entry.bytes == path ".."
+  ensure (dot && dotdot && done) "directory listing"
+  discard <| successful (.closedir token)
+  let closed ← executeResolved 33 (.dirfd token)
+  ensure (!closed.boundaryError.isEmpty) "closed DIR token"
+  discard <| successful (.rmdir root)
+  let unsupported ← executeResolved 33 (.fcntl 0 2147483647 0)
+  ensure (!unsupported.boundaryError.isEmpty) "unsupported command must remain explicit"
+  let malformed ← executeResolved 33 (.access ⟨#[120, 0, 121, 0]⟩ 0)
+  ensure (!malformed.boundaryError.isEmpty) "interior-NUL path must remain explicit"
+  let pair ← successful .pipe
+  ensure (pair.fields.size == 2 && pair.fields[0]! != pair.fields[1]!) "pipe descriptors"
+  let reader := pair.fields[0]!.toUInt32
+  let writer := pair.fields[1]!.toUInt32
+  discard <| successful (.writev writer #[5] payload)
+  discard <| successful (.close writer)
+  let pipeRead ← successful (.read reader 8)
+  ensure (pipeRead.status.value == 5 && pipeRead.bytes == payload) "pipe binary bytes"
+  let pipeEOF ← successful (.read reader 8)
+  ensure (pipeEOF.status.value == 0) "pipe EOF"
+  discard <| successful (.close reader)
+  let directoryName ← successful (.dirname (path "/tmp/alpha//"))
+  ensure (directoryName.fields.size == 4) "dirname shape"
+  let returned := directoryName.bytes.extract directoryName.fields[0]!.toNat directoryName.bytes.size
+  ensure (returned == path "/tmp") "dirname result"
+  let baseName ← successful (.__xpg_basename (path "/tmp/alpha//"))
+  let baseReturned := baseName.bytes.extract baseName.fields[0]!.toNat baseName.bytes.size
+  ensure (baseReturned == path "alpha") "basename result"
+  let staticName ← successful (.dirname ByteArray.empty)
+  let staticAgain ← successful (.dirname ByteArray.empty)
+  ensure (staticName.fields[2]! == 1 && staticName.fields[3]! == staticAgain.fields[3]!) "static alias identity"
+  let mapped ← successful (.mmap 4096 3 34 4294967295 0)
+  let mapToken := mapped.fields[0]!
+  discard <| successful (.mapping_write mapToken 0 payload)
+  let mappedBytes ← successful (.mapping_read mapToken 0 5)
+  ensure (mappedBytes.bytes == payload) "coherent mapped bytes"
+  discard <| successful (.madvise mapToken 0 4096 16)
+  discard <| successful (.madvise mapToken 0 4096 4)
+  let discarded ← successful (.mapping_read mapToken 0 5)
+  ensure (discarded.bytes == (⟨Array.replicate 5 0⟩ : ByteArray)) "MADV_DONTNEED effect"
+  let partialResult ← executeResolved 33 (.munmap mapToken 0 1)
+  ensure (!partialResult.boundaryError.isEmpty) "partial unmap remains explicit"
+  discard <| successful (.munmap mapToken 0 4096)
+  let stale ← executeResolved 33 (.mapping_read mapToken 0 1)
+  ensure (!stale.boundaryError.isEmpty) "unmapped token"
+  let tty ← successful (.«open» (path "/dev/ptmx") 258 0 0)
+  let ttyFd := tty.status.value.toNat.toUInt32
+  discard <| successful (.ioctl ttyFd 21524 ByteArray.empty #[24,80,640,480])
+  let window ← successful (.ioctl ttyFd 21523 ByteArray.empty #[])
+  ensure (window.fields == #[24,80,640,480]) "ioctl winsize"
+  discard <| successful (.close ttyFd)
+  let ioctlError ← call (.ioctl 4294967295 21523 ByteArray.empty #[])
+  ensure (ioctlError.status.error == 9) "ioctl EBADF"
+  let unknown ← executeResolved 33 (.ioctl 4294967295 18446744073709551615 ByteArray.empty #[])
+  ensure (!unknown.boundaryError.isEmpty) "unreviewed ioctl"
+  let seed : ByteArray := ⟨Array.replicate 4096 165⟩
+  let resolved ← successful (.__realpath_chk (path "/tmp") seed 4096 0)
+  let allocated ← successful (.__realpath_chk (path "/tmp") ByteArray.empty 4096 1)
+  ensure (resolved.bytes.extract 0 resolved.fields[1]!.toNat == allocated.bytes) "realpath result"
+  let fortify ← executeResolved 33 (.__realpath_chk (path "/tmp") (seed.extract 0 16) 16 0)
+  ensure (!fortify.boundaryError.isEmpty) "realpath fortify boundary"
+  checkWrite
+  IO.println "files-ok"
