+def verifyIdentity (id : CertIdentity) : IO Unit := do
+  unless id.semanticSwitches == "default:[]" do
+    throw <| IO.userError "Core certificate semantic switch set is not canonical default"
+  requireAbsolute id.originalSourcePath
+  requireAbsolute id.translationInputPath
+  requireAbsolute id.cabsPath
+  requireAbsolute id.translatorPath
+  let originalSourceSHA ← hashFile "sha256sum" id.originalSourcePath 64
+  let sourceSHA ← hashFile "sha256sum" id.translationInputPath 64
+  let sourceMD5 ← hashFile "md5sum" id.translationInputPath 32
+  let cabsSHA ← hashFile "sha256sum" id.cabsPath 64
+  let translatorSHA ← hashFile "sha256sum" id.translatorPath 64
+  unless originalSourceSHA == id.originalSourceSHA256 &&
+      sourceSHA == id.translationInputSHA256 &&
+      sourceMD5 == id.translationInputDigestMD5 &&
+      cabsSHA == id.cabsSHA256 &&
+      translatorSHA == id.translatorSHA256 do
+    throw <| IO.userError "Core certificate source/Cabs/translator drift"
