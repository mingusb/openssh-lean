diff --git a/lean_frontend/inject_expression_runtime.py b/lean_frontend/inject_expression_runtime.py
new file mode 100644
index 00000000..419302a8
--- /dev/null
+++ b/lean_frontend/inject_expression_runtime.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Select unbounded Lem expression loops for compiled execution.
+
+The original fuelled definitions remain transparent to Lean proofs. The
+runtime equations are copied from the same maintained Lem source and generated
+by Lem. This transformation is byte-checked and fails if its target changes.
+"""
+from pathlib import Path
+import sys
+
+
+def inject(path: Path, names: tuple[str, ...]) -> None:
+    source = path.read_text(encoding="utf-8")
+    for name in names:
+        runtime = "partial def " + name + "_runtime"
+        anchor = "\ndef " + name + " "
+        marker = "@[implemented_by " + name + "_operational]"
+        if source.count(runtime) != 1 or source.count(anchor) != 1:
+            raise SystemExit(f"missing or duplicated runtime loop {name} in {path}")
+        if marker in source:
+            raise SystemExit(f"duplicate runtime binding {name} in {path}")
+        start = source.index(anchor) + 1
+        end = source.index(" :=", start)
+        signature = source[start:end]
+        operational = signature.replace("def " + name, "private def " + name + "_operational", 1)
+        if operational == signature:
+            raise SystemExit(f"cannot copy generated type for {name}")
+        source = (source[:start] + operational + " :=\n  " + name + "_runtime\n\n" +
+                  marker + "\n" + source[start:])
+    path.write_text(source, encoding="utf-8")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: inject_expression_runtime.py <generated directory>")
+    directory = Path(sys.argv[1])
+    loops = {
+        "Core_eval.lean": ("eval_pexpr_aux2", "eval_pexpr_aux_broken"),
+        "Core_reduction.lean": ("full_eval_pexpr",),
+        "Core_aux.lean": ("zeros_aux",),
+        "Defacto_memory_aux.lean": ("simplify_integer_value_base",),
+        "Formatted.lean": ("load_character_array_aux", "gnu_format_read_chars"),
+        "Defacto_memory.lean": ("mkUnspec",),
+        "Driver.lean": ("print_eval_conv_aux",),
+        "Gnu_amd64_vformat.lean": ("gnuvformat_read_chars",),
+        "Utils.lean": ("list_unfoldr_aux",),
+    }
+    for filename, names in loops.items():
+        inject(directory / filename, names)
