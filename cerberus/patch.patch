index 00000000..6fc0cecd
--- /dev/null
+++ b/tests/openssh-gnu-modes/alignment-natural.c
@@ -0,0 +1,56 @@
+/* Linux's aligned-u64 idiom, checked against the selected AMD64 ABI. */
+typedef unsigned long long u64;
+typedef u64 aligned_u64 __attribute__((aligned(8)));
+typedef aligned_u64 alias1;
+typedef alias1 alias2 __attribute__((__aligned__(0x8ULL)));
+typedef unsigned int aligned_u32 __attribute__((aligned(04U)));
+typedef unsigned short aligned_u16 __attribute__((aligned(0b10)));
+typedef unsigned __int128 aligned_u128 __attribute__((aligned));
+typedef unsigned __int128 explicit_u128 __attribute__((aligned(16)));
+typedef long pair[2] __attribute__((aligned(8)));
+typedef long (*long_ptr) __attribute__((aligned(8)));
+typedef int mode_first __attribute__((mode(DI), aligned(8)));
+
+struct record { char kind; alias2 value; char end; };
+struct member { char kind; unsigned long long value __attribute__((aligned(8))); };
+union explicit_union { _Alignas(16) int value; char byte; };
+struct explicit_struct { char tag; _Alignas(16) int value; };
+typedef union explicit_union union_alias __attribute__((aligned(16)));
+typedef struct explicit_struct struct_alias __attribute__((aligned(16)));
+static aligned_u64 saved = 17;
+static int ordinary __attribute__((aligned(4))) = 11;
+
+_Static_assert(sizeof(aligned_u64) == 8, "u64 size");
+_Static_assert(_Alignof(aligned_u64) == 8, "u64 alignment");
+_Static_assert(_Alignof(alias2) == 8, "alias alignment");
+_Static_assert(_Alignof(aligned_u32) == 4, "octal and suffix");
+_Static_assert(_Alignof(aligned_u16) == 2, "binary literal");
+_Static_assert(_Alignof(aligned_u128) == 16, "default maximum alignment");
+_Static_assert(sizeof(aligned_u128) == sizeof(explicit_u128), "default and explicit");
+_Static_assert(sizeof(pair) == 16 && _Alignof(pair) == 8, "array type");
+_Static_assert(sizeof(long_ptr) == 8 && _Alignof(long_ptr) == 8, "pointer type");
+_Static_assert(sizeof(mode_first) == 8 && _Alignof(mode_first) == 8, "mode before aligned");
+_Static_assert(__builtin_types_compatible_p(aligned_u64, u64), "compatible scalar");
+_Static_assert(__builtin_offsetof(struct record, value) == 8, "member offset");
+_Static_assert(__builtin_offsetof(struct record, end) == 16, "following member");
+_Static_assert(sizeof(struct record) == 24, "tail padding");
+_Static_assert(sizeof(struct member) == 16, "member attribute");
+_Static_assert(_Alignof(union_alias) == 16 && sizeof(union_alias) == 16, "explicit union member alignment");
+_Static_assert(_Alignof(struct_alias) == 16 && sizeof(struct_alias) == 32, "explicit struct member alignment");
+
+static alias2 identity(alias2 x) { return x; }
+int main(void) {
+    alias2 local = 23;
+    struct record r = { 3, 29, 5 };
+    struct member m = { 7, 31 };
+    pair p = { 37, 41 };
+    long_ptr ptr = &p[1];
+    int x __attribute__((aligned(4))) = 43;
+    _Static_assert(_Alignof(__typeof__(local)) == 8, "typeof lvalue");
+    _Static_assert(_Alignof(__typeof__(+local)) == 8, "typeof unary");
+    _Static_assert(_Alignof(__typeof__(identity(local))) == 8, "typeof call");
+    if (identity(local) != 23 || saved != 17 || ordinary != 11) return 1;
+    if (r.value != 29 || r.end != 5 || m.value != 31) return 2;
+    if (*ptr != 41 || x != 43) return 3;
+    return 0;
+}
