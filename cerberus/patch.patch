+++ b/lean_frontend/host/families/network/handler/NetworkHandlerTest.lean
@@ -0,0 +1,212 @@
+import CerbHostNetworkHandler
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+@[extern "cerb_network_handler_test_close"]
+opaque fixtureClose : UInt32 → BaseIO UInt32
+@[extern "cerb_network_handler_test_fdflags"]
+opaque fixtureFDFlags : UInt32 → BaseIO UInt32
+
+private def ensure (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+private def take {α : Type} (value : Except Failure α) : IO α :=
+  match value with
+  | .ok value => pure value
+  | .error (.boundary message) => throw (IO.userError message)
+  | .error (.memory _) => throw (IO.userError "unexpected modeled memory failure")
+private def takeString {α : Type} (value : Except String α) : IO α :=
+  match value with
+  | .ok value => pure value
+  | .error message => throw (IO.userError message)
+private def fails {ε α : Type} (value : Except ε α) : Bool :=
+  match value with | .error _ => true | .ok _ => false
+private def takeHandler (value : Except CerbHostNetworkHandler.FailureReceipt
+    CerbHostNetworkHandler.Result) : IO CerbHostNetworkHandler.Result :=
+  match value with
+  | .ok value => pure value
+  | .error (.boundary message,_,_) => throw (IO.userError message)
+  | .error (.memory _,_,_) => throw (IO.userError "unexpected handler memory failure")
+private def mapInsert {α : Type} (key : sym) (value : α) (map : Fmap sym α) : Fmap sym α :=
+  fmapAddBy (fun a b => Lem_Basic_classes.ordCompare a b) key value map
+private def compareIdentifier : identifier → identifier → LemOrdering
+  | .Identifier _ a,.Identifier _ b => Lem_Basic_classes.ordCompare a b
+private def callType (result : ctype) (parameters : List ctype) :
+    generic_pexpr Unit sym :=
+  .Pexpr [] () (.PEval (.Vctype (.Ctype [] (.Pointer no_qualifiers
+    (.Ctype [] (.Function (no_qualifiers,result)
+      (parameters.map fun type => (no_qualifiers,type,false)) false))))))
+
+private structure Fixture where
+  state : driver_state
+  request : host_request
+  errnoPointer : PointerValue
+  output : PointerValue
+
+private def argumentObject [LemFuel] [CerbGlobal.Switches]
+    (type : ctype) (contents : MemValue) (state : MemState) :
+    IO (PointerValue × MemState) := do
+  let (object, state) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 16)) state)
+  let (_, state) ← take (immediate (storeM fmapEmpty fmapEmpty
+    (CerbLocation.other "network handler argument") type false object contents) state)
+  return (object, state)
+
+private def fixture [LemFuel] [CerbGlobal.Switches] (domain : Int) : IO Fixture := do
+  let symbol : sym := .Symbol "network-handler-test" 8001 (.SD_Id "socketpair")
+  let location := CerbLocation.other "socketpair original call site"
+  let integerPointer : ctype := .Ctype [] (.Pointer no_qualifiers signed_int)
+  let parameters := [signed_int,signed_int,signed_int,integerPointer]
+  let program : generic_file Unit core_run_annotation := {
+    default with
+    calling_convention0 := .Normal_callconv
+    stdlib := fmapEmpty
+    enumDefs := fmapEmpty
+    tagDefs := fmapEmpty
+    funs := mapInsert symbol (.ProcDecl location (.BTy_loaded .OTy_integer)
+      (List.replicate 4 (.BTy_object .OTy_pointer))) fmapEmpty
+    funinfo := mapInsert symbol (location,no_attributes,signed_int,
+      parameters.map (fun type => (none,type)),false,true) fmapEmpty
+    extern := fmapAddBy compareIdentifier (.Identifier location "socketpair")
+      ([symbol],.LK_none) fmapEmpty
+  }
+  let (base, memory) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 64))
+    (initialMemState 65536))
+  let (output, memory) ← take (immediate (effArrayShiftPtrval fmapEmpty fmapEmpty
+    location base unsigned_char (.IV .Prov_none 16)) memory)
+  let errnoLease ← take (prepareOutputs fmapEmpty fmapEmpty [⟨base,.signedInt⟩] memory)
+  let (_, memory) ← take (commitOutputs fmapEmpty fmapEmpty errnoLease [-71])
+  let (domainArg, memory) ← argumentObject signed_int
+    (.MVinteger CellKind.signedInt.ity (.IV .Prov_none domain)) memory
+  let (typeArg, memory) ← argumentObject signed_int
+    (.MVinteger CellKind.signedInt.ity (.IV .Prov_none 524289)) memory
+  let (protocolArg, memory) ← argumentObject signed_int
+    (.MVinteger CellKind.signedInt.ity (.IV .Prov_none 0)) memory
+  let (outputArg, memory) ← argumentObject integerPointer (.MVpointer signed_int output) memory
+  let thread : thread_state := { default with errno := base, current_loc := location }
+  let state : driver_state := {
+    default with
+    core_file := program
+    core_extern := fmapEmpty
+    core_state0 := { default with thread_states := [(0,(none,thread))] }
+    layout_state := memory
+    host_enabled := true
+    host_sequence := 1
+    host_reply := none
+  }
+  let arguments := [domainArg,typeArg,protocolArg,outputArg].map
+    (fun object => value.Vobject (.OVpointer object))
+  return ⟨state,.Host_external 0 location base symbol (callType signed_int parameters) arguments,
+    base,output⟩
+
+private def outputs [LemFuel] [CerbGlobal.Switches] (pointer : PointerValue) (memory : MemState) :
+    IO (Int × Int) := do
+  let (cells, memory) ← take (arrayCells fmapEmpty fmapEmpty .signedInt pointer 2 memory)
+  let [first,second] := cells | throw (IO.userError "expected pair output cells")
+  let (a,_,memory) ← take (readInteger fmapEmpty fmapEmpty first memory)
+  let (b,_,_) ← take (readInteger fmapEmpty fmapEmpty second memory)
+  return (a,b)
+
+private def selectionChecks [LemFuel] (f : Fixture) : IO Unit := do
+  let .Host_external _ location _ symbol _ _ := f.request
+    | throw (IO.userError "expected external selection fixture")
+  let selected ← take (CerbHostNetworkHandler.select f.state.core_file fmapEmpty symbol)
+  ensure (selected == .supported "socketpair") "supported family identity"
+  let rename (name : String) := { f.state.core_file with
+    extern := fmapAddBy compareIdentifier (.Identifier location name) ([symbol],.LK_none) fmapEmpty
+  }
+  let missing ← take (CerbHostNetworkHandler.select (rename "getaddrinfo") fmapEmpty symbol)
+  ensure (match missing with | .unsupported "getaddrinfo" reason => !reason.isEmpty | _ => false)
+    "known native-only API must remain explicitly unsupported"
+  let other ← take (CerbHostNetworkHandler.select (rename "open") fmapEmpty symbol)
+  ensure (other == .other "open") "other family selection remains pure and composable"
+  let defined := { f.state.core_file with
+    funs := mapInsert symbol (.Proc location none (.BTy_loaded .OTy_integer) [] default)
+      f.state.core_file.funs
+  }
+  ensure (fails (CerbHostNetworkHandler.select defined fmapEmpty symbol))
+    "family selection must preserve modeled/user procedure bodies"
+  let ambiguous := { f.state.core_file with
+    extern := fmapAddBy compareIdentifier (.Identifier location "connect")
+      ([symbol],.LK_none) f.state.core_file.extern
+  }
+  ensure (fails (CerbHostNetworkHandler.select ambiguous fmapEmpty symbol))
+    "family selection rejects ambiguous linker identities"
+
+private def run [LemFuel] [CerbGlobal.Switches] : IO Unit := do
+  -- A controlled guest with no inherited descriptors. This fixture does not
+  -- establish an automatic real-worker inherited inventory.
+  let table ← takeString (CerbHostDescriptors.create 48001 10240 [] [])
+  let f ← fixture 1
+  selectionChecks f
+  let calls ← IO.mkRef (0 : Nat)
+  let perform (prepared : CerbHostNetworkGuest.Prepared) :
+      BaseIO CerbHostNetworkAdapters.NetworkResult := do
+    calls.modify (·+1)
+    CerbHostNetworkGuest.executeNative prepared
+  let preflight ← CerbHostNetworkHandler.performRequest 0 table perform
+    { f.state with host_sequence := 2 } f.request
+  ensure (fails preflight && (← calls.get) == 0) "stale sequence must not execute native call"
+  let wrongConvention := { f.state with
+    core_file := { f.state.core_file with calling_convention0 := .Inner_arg_callconv } }
+  let rejected ← CerbHostNetworkHandler.performRequest 0 table perform wrongConvention f.request
+  ensure (fails rejected && (← calls.get) == 0) "invalid admission must not execute native call"
+  let (pendingTable,_) ← takeString (CerbHostDescriptors.reserveFresh table 1)
+  let reservedReject ← CerbHostNetworkHandler.performRequest 0 pendingTable perform f.state f.request
+  ensure (fails reservedReject && (← calls.get) == 0) "pending table must not start another effect"
+
+  let (after,adopted,reply) ← takeHandler
+    (← CerbHostNetworkHandler.performRequest 0 table perform f.state f.request)
+  ensure ((← calls.get) == 1 && adopted.entries.length == 2)
+    "socketpair must perform once and atomically adopt both descriptors"
+  ensure (adopted.entries.map (·.guest) == [0,1] &&
+    adopted.entries.all (fun entry => entry.descriptorFlags == some 1))
+    "guest IDs and observed CLOEXEC postcondition must follow generated policy"
+  ensure ((← outputs f.output after.layout_state) == (0,1))
+    "original guest pointer must receive reserved guest descriptors"
+  let (actualErrno,_,_) ← take (readInteger fmapEmpty fmapEmpty
+    ⟨f.errnoPointer,.signedInt⟩ after.layout_state)
+  ensure (actualErrno == -71) "successful call must publish full signed errno bits"
+  ensure (match reply with | .Host_memory 0 footprints => footprints.length == 8 | _ => false)
+    "reply must retain argument, errno and output access footprints"
+  ensure (after.host_reply.isNone && after.host_sequence == 1)
+    "shared runner alone publishes and consumes protocol reply"
+  for entry in adopted.entries do
+    ensure ((← fixtureFDFlags entry.native) == 1) "native F_GETFD agrees with modeled CLOEXEC flags"
+    ensure ((← fixtureClose entry.native) == 0) "close owned successful fixture socket"
+
+  let invalid ← fixture (-1)
+  let (failedMemory,cancelled,failureReply) ← takeHandler
+    (← CerbHostNetworkHandler.performRequest 0 table perform invalid.state invalid.request)
+  ensure ((← calls.get) == 2 && cancelled.entries.isEmpty &&
+    !fails (CerbHostDescriptors.validateIdle cancelled))
+    "native failure cancels reservation without adopting released handles"
+  ensure ((← outputs invalid.output failedMemory.layout_state) == (0,1))
+    "failed socketpair retains observed guest output writes"
+  ensure (match failureReply with | .Host_memory value _ => value == -1 | _ => false)
+    "native failure remains original scalar return"
+
+  let corrupt (prepared : CerbHostNetworkGuest.Prepared) :
+      BaseIO CerbHostNetworkAdapters.NetworkResult := do
+    calls.modify (·+1)
+    let response ← CerbHostNetworkGuest.executeNative prepared
+    return { response with boundaryError := "fixture post-effect failure" }
+  let terminal ← CerbHostNetworkHandler.performRequest 0 table corrupt f.state f.request
+  match terminal with
+  | .ok _ => throw (IO.userError "post-effect failure unexpectedly committed")
+  | .error (_,retained,some receipt) =>
+    ensure ((← calls.get) == 3 && fails (CerbHostDescriptors.validateIdle retained))
+      "post-effect failure retains pending table without retry"
+    ensure (receipt.sequence == 0 && receipt.response.fields.size == 2)
+      "terminal receipt must retain both actual returned native handles"
+    for native in receipt.response.fields do
+      ensure ((← fixtureClose native.toUInt32) == 0) "terminal receipt fixture cleanup"
+  | .error (_,_,none) => throw (IO.userError "post-effect failure lost its receipt")
+  IO.println "network-handler-ok"
+
+def main (args : List String) : IO Unit := do
+  match args with
+  | [fuel] =>
+    match fuel.toNat? with
+    | some budget => @run ⟨budget⟩ ⟨CerbGlobal.defaultSwitches⟩
+    | none => throw (IO.userError "expected checked-runner fuel argument")
+  | _ => throw (IO.userError "expected checked-runner fuel argument")
