+    let fsReadResult ← take (complete enums tags fsRead (← executeNative fsRead))
+    let (fsByte, _, fsState) ← take (readBytes enums tags output 1 fsReadResult.memory)
+    ensure (fsReadResult.returnValue == 1 && fsByte.data == #[65])
