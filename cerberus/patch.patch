+val gnu_region_scan_type: list nat -> maybe (list nat) -> gnu_region_label_scan -> type_name -> gnu_region_label_scan
+val gnu_region_scan_tspec: list nat -> maybe (list nat) -> gnu_region_label_scan -> cabs_type_specifier -> gnu_region_label_scan
+val gnu_region_scan_align: list nat -> maybe (list nat) -> gnu_region_label_scan -> alignment_specifier -> gnu_region_label_scan
+val gnu_region_scan_declarator: list nat -> maybe (list nat) -> gnu_region_label_scan -> declarator -> gnu_region_label_scan
+val gnu_region_scan_direct: list nat -> maybe (list nat) -> gnu_region_label_scan -> direct_declarator -> gnu_region_label_scan
+val gnu_region_scan_abstract: list nat -> maybe (list nat) -> gnu_region_label_scan -> abstract_declarator -> gnu_region_label_scan
+val gnu_region_scan_direct_abstract: list nat -> maybe (list nat) -> gnu_region_label_scan -> direct_abstract_declarator -> gnu_region_label_scan
+val gnu_region_scan_array: list nat -> maybe (list nat) -> gnu_region_label_scan -> array_declarator -> gnu_region_label_scan
+val gnu_region_scan_params: list nat -> maybe (list nat) -> gnu_region_label_scan -> parameter_type_list -> gnu_region_label_scan
