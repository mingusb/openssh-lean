+  guest : Int
+  native : UInt32
+  deriving Repr, BEq, Inhabited
+
+/-- Borrow inherited standard descriptors only in an explicitly selected host run. -/
+def standardDescriptors : List DescriptorBinding :=
+  [{guest := 0, native := 0}, {guest := 1, native := 1}, {guest := 2, native := 2}]
+
+inductive Request where
+"""+ "\n".join(requests)+"""
+
+"""+ "\n\n".join(lean_extern)+"""
+
+/-- Registry emitted from reviewed zero-argument uint32 contracts.
+    The driver must first validate declaration linkage and source C types. -/
+def credentialRequest : String → Option Request
+"""+ "\n".join(credential_cases)+"""
+  | _ => none
+
+/-- Execute once. Missing mappings are unsupported boundaries, not invented EBADF.
+    Native failures carry their exact errno; successes must not overwrite modeled errno. -/
+def execute (descriptors : List DescriptorBinding) : Request → BaseIO (Except String NativeResult)
+"""+ "\n".join(lean_cases)+"""
+
+end CerbHostAdapters
+"""
+    return {"host_adapters.h":header,"host_adapters.c":c,"CerbHostAdapters.lean":lean}
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--contracts",type=Path,required=True)
+    ap.add_argument("--output",type=Path,required=True)
+    ap.add_argument("--check",action="store_true")
+    a=ap.parse_args()
+    source=a.contracts.read_text()
+    files=generate(json.loads(source))
+    out=a.output.resolve()
+    if not a.check: out.mkdir(parents=True,exist_ok=True)
+    for name,text in files.items():
+        p=out/name
+        if a.check:
+            if not p.is_file() or p.read_text()!=text:
+                raise SystemExit("Stale generated host adapter: "+str(p))
+        elif not p.is_file() or p.read_text()!=text:
+            p.write_text(text)
+    manifest={"schema":1,"contracts_sha256":digest(source),
+              "generator_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "outputs":{n:digest(t) for n,t in files.items()},
+              "scope":"Generated first-slice host adapters; driver dispatch not integrated"}
+    if not a.check:
+        (out/"manifest.json").write_text(json.dumps(manifest,indent=2,sort_keys=True)+"\n")
+    else:
+        p=out/"manifest.json"
+        if not p.is_file() or json.loads(p.read_text())!=manifest:
+            raise SystemExit("Stale host adapter generation manifest")
+    print(json.dumps({"generated_apis":len(json.loads(source)["apis"]),"output":str(out),"checked":a.check}))
+
+if __name__=="__main__":
+    main()
diff --git a/scripts/prepare_gnu_amd64_libc.py b/scripts/prepare_gnu_amd64_libc.py
