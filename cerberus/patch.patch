+        (match (gnu_guard_substitute formal actual left, gnu_guard_substitute formal actual right) with
+          | (Just lhs, Just rhs) -> Just (A.AnnotatedExpression ty annots loc (A.AilEbinary lhs bop rhs))
+          | _ -> Nothing end)
+    | _ -> Nothing
+  end
