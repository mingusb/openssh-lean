diff --git a/lean_frontend/host/families/network/admission/generate_network_admission.py b/lean_frontend/host/families/network/admission/generate_network_admission.py
new file mode 100644
index 00000000..1bf86d68
--- /dev/null
+++ b/lean_frontend/host/families/network/admission/generate_network_admission.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+import argparse,json
+from pathlib import Path
+
+def generate(spec,template):
+    contracts=[];decodes=[]
+    for api in spec["apis"]:
+        name=api["symbol"];kind=api["decode"]
+        params=[".scalar ."+p if p in ["signedInt","unsignedInt","unsignedLong"] else "."+p for p in api["parameters"]]
+        contracts.append('  | "'+name+'" => some ['+", ".join(params)+']')
+        if kind=="socket":
+            pat=".number a, .number b, .number c";body="return ⟨.socket a b c, footprints, after⟩"
+        elif kind=="socketpair":
+            pat=".number a, .number b, .number c, .pointer p";body="return ⟨.socketpair a b c p, footprints, after⟩"
+        elif kind=="address":
+            pat=".number a, .pointer p, .number n";body="return ⟨."+name+" a p n, footprints, after⟩"
+        elif kind=="fdInt":
+            pat=".number a, .number b";body="return ⟨."+name+" a b, footprints, after⟩"
+        elif kind=="poll":
+            pat=".pointer p, .number n, .number timeout"
+            body="""let some type := admitted.parameterTypes.head? | stop "poll prototype lost its pointer"
+    let shape ← pollShape program type
+    match ← planPollCount n verifiedDescriptorLimit with
+    | .withoutArray => return ⟨.poll_no_array n timeout, footprints, after⟩
+    | .array count =>
+      let (rows, finalMemory) ← records location program shape p count after
+      return ⟨.poll rows timeout, footprints, finalMemory⟩"""
+        else:raise ValueError(kind)
+        decodes.append('  | "'+name+'", ['+pat+'] =>\n    '+body)
+    contracts.append("  | _ => none")
+    return template.replace("@CONTRACTS@","\n".join(contracts)).replace("@DECODES@","\n".join(decodes))
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument("--contracts",type=Path,required=True)
+    p.add_argument("--output",type=Path,required=True);p.add_argument("--check",action="store_true")
+    a=p.parse_args();spec=json.loads(a.contracts.read_text())
+    if spec["schema"]!=1:raise ValueError("unsupported schema")
+    data=generate(spec,(Path(__file__).parent/"templates/admission.lean.in").read_text())
+    path=a.output/"CerbHostNetworkAdmission.lean"
+    if a.check:
+        if not path.exists() or path.read_text()!=data:raise SystemExit("stale admission module")
+    else:
+        a.output.mkdir(parents=True,exist_ok=True);path.write_text(data)
+    print(json.dumps({"admitted_symbols":len(spec["apis"]),"integrated_symbols":0,"check":a.check}))
+if __name__=="__main__":main()
diff --git a/lean_frontend/host/families/network/admission/templates/admission.lean.in b/lean_frontend/host/families/network/admission/templates/admission.lean.in
new file mode 100644
index 00000000..ed8dc22b
--- /dev/null
+++ b/lean_frontend/host/families/network/admission/templates/admission.lean.in
@@ -0,0 +1,253 @@
+/- Generated exact-prototype admission and argument-object decoder.
+No symbol-only dispatch and no assumption that Core cvals are scalar arguments. -/
+import Core_run
+import CerbHostNetworkGuest
+
+namespace CerbHostNetworkAdmission
+open CerbMem CerbHostMemoryCells CerberusImpl
+abbrev Program := generic_file Unit core_run_annotation
+
+private def stop {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+
+private def lookup {α : Type} (key : sym) (values : Fmap sym α) : Option α :=
+  fmapLookupBy (fun a b => Lem_Basic_classes.ordCompare a b) key values
+
+private def integer (kind : CellKind) : ctype → Bool
+  | .Ctype _ (.Basic (.Integer ity)) => ity == kind.ity
+  | _ => false
+
+-- Requires the parent-validated shared CType repair: recursive Pointer
+-- qualifiers/referents and function parameter count before zipped comparison.
+private def sameType (a b : ctype) : Bool := ctypeEqual a b
+
+private def identifierText : identifier → String
+  | .Identifier _ text => text
+
+private def offset [LemFuel] (program : Program) (tag : sym) (field : identifier) : Int :=
+  let .IV _ value := offsetofIval program.enumDefs program.tagDefs program.tagDefs tag field
+  value
+
+structure PollShape where
+  tag : sym
+  recordType : ctype
+  fdField : identifier
+  eventsField : identifier
+  reventsField : identifier
+
+private def pollShape [LemFuel] (program : Program) (type : ctype) : Except Failure PollShape := do
+  let .Ctype _ (.Pointer qualifiers recordType@(.Ctype _ (.Struct tag))) := type
+    | stop "poll parameter must point to its declared record type"
+  if !qualifiersEqual qualifiers no_qualifiers then stop "poll pointee qualifiers differ from its contract"
+  match lookup tag program.tagDefs with
+  | some (_, .StructDef _ [(fdField, (_, _, fq, ft)), (eventsField, (_, _, eq, et)),
+        (reventsField, (_, _, rq, rt))] none) =>
+    if !qualifiersEqual fq no_qualifiers || !qualifiersEqual eq no_qualifiers ||
+        !qualifiersEqual rq no_qualifiers || !integer .signedInt ft ||
+        !integer .signedShort et || !integer .signedShort rt ||
+        identifierText fdField != "fd" || identifierText eventsField != "events" ||
+        identifierText reventsField != "revents" ||
+        sizeofCtype program.enumDefs program.tagDefs recordType != 8 ||
+        alignofCtype program.enumDefs program.tagDefs recordType != 4 ||
+        offset program tag fdField != 0 || offset program tag eventsField != 4 ||
+        offset program tag reventsField != 6 then
+      stop "linked pollfd record differs from pinned Linux AMD64 layout"
+    return ⟨tag, recordType, fdField, eventsField, reventsField⟩
+  | _ => stop "poll record is incomplete, flexible or has a different field sequence"
+
+private def sockaddrShape [LemFuel] (program : Program) (type : ctype) : Except Failure Unit := do
+  let .Ctype _ (.Pointer qualifiers recordType@(.Ctype _ (.Struct tag))) := type
+    | stop "sockaddr parameter is not its lowered canonical struct pointer"
+  if !qualifiersEqual qualifiers { no_qualifiers with const := true } then
+    stop "sockaddr declaration must have const-qualified pointee"
+  match lookup tag program.tagDefs with
+  | some (_, .StructDef _ [(family, (_, _, fq, ft)), (data, (_, _, dq, dt))] none) =>
+    let isData := match dt with
+      | .Ctype _ (.Array0 (.Ctype _ (.Basic (.Integer .Char0))) (some 14)) => true
+      | _ => false
+    if !qualifiersEqual fq no_qualifiers || !qualifiersEqual dq no_qualifiers ||
+        !integer .unsignedShort ft || !isData ||
+        identifierText family != "sa_family" || identifierText data != "sa_data" ||
+        sizeofCtype program.enumDefs program.tagDefs recordType != 16 ||
+        alignofCtype program.enumDefs program.tagDefs recordType != 2 ||
+        offset program tag family != 0 || offset program tag data != 2 then
+      stop "linked sockaddr record differs from pinned Linux AMD64 layout"
+    pure ()
+  | _ => stop "sockaddr declaration has a different record shape"
+
+inductive Parameter where
+  | scalar (kind : CellKind)
+  | intPointer | sockaddrPointer | pollPointer
+
+private def parameter [LemFuel] (program : Program) (expected : Parameter)
+    (actual : ctype) : Except Failure Unit := do
+  match expected with
+  | .scalar kind =>
+    if !integer kind actual then stop "external scalar parameter has an incompatible CType"
+  | .intPointer =>
+    match actual with
+    | .Ctype _ (.Pointer qualifiers element) =>
+      if !qualifiersEqual qualifiers no_qualifiers || !integer .signedInt element then
+        stop "external output parameter is not int pointer"
+    | _ => stop "external output parameter is not a pointer"
+  | .sockaddrPointer => sockaddrShape program actual
+  | .pollPointer => let _ ← pollShape program actual; pure ()
+
+private def contract : String → Option (List Parameter)
+@CONTRACTS@
+
+structure Admitted where
+  private mk ::
+  location : CerbLocation.Loc
+  program : Program
+  name : String
+  symbol : sym
+  parameterTypes : List ctype
+  argumentObjects : List PointerValue
+  nonnullParameters : List Nat
+
+/-- The only supported source convention is the one actually emitted by the
+pinned frontend: parameter temporary object pointers, not loaded scalars. -/
+def admit [LemFuel] (location : CerbLocation.Loc) (program : Program) (links : Fmap sym sym)
+    (original : sym) (callType : generic_pexpr Unit sym) (arguments : List value) :
+    Except Failure Admitted := do
+  if program.calling_convention0 != .Normal_callconv then
+    stop "host external decoding requires the pinned normal argument-object convention"
+  if (lookup_proc_body links program original).isSome then
+    stop "host decoding cannot bypass a model or user procedure definition"
+  let resolved := resolve_linked_function links original
+  let names := Lem_Map_extra.fold (fun ident binding found =>
+    let (symbols, linkage) := binding
+    if linkage == .LK_none && symbols.any (fun symbol => symbol == resolved)
+      then identifierText ident :: found else found) program.extern []
+  let [name] := names | stop "external target has no unique unresolved linker name"
+  let some expected := contract name | stop "external linker name has no generated network contract"
+  let some (.ProcDecl _ resultType parameters) := lookup resolved program.funs
+    | stop "host target must remain a real procedure declaration"
+  if resultType != .BTy_loaded .OTy_integer ||
+      parameters != List.replicate expected.length (.BTy_object .OTy_pointer) then
+    stop "external Core signature disagrees with normal argument-object convention"
+  let some (_, _, declaredResult, declaredParameters, variadic, prototype) :=
+      lookup resolved program.funinfo
+    | stop "host target lacks its original C prototype"
+  if variadic || !prototype || !integer .signedInt declaredResult ||
+      declaredParameters.length != expected.length || arguments.length != expected.length then
+    stop "external C prototype has wrong return, arity, varargs or no-prototype status"
+  let .Pexpr _ _ (.PEval (.Vctype (.Ctype _ (.Pointer functionQual
+      (.Ctype _ (.Function (returnQual, callResult) callParameters false)))))) := callType
+    | stop "call expression does not carry a fixed function-pointer prototype"
+  if !qualifiersEqual functionQual no_qualifiers ||
+      !qualifiersEqual returnQual no_qualifiers ||
+      !sameType declaredResult callResult || callParameters.length != expected.length then
+    stop "call and declaration result prototypes differ"
+  let types := declaredParameters.map Prod.snd
+  for ((required, declared), (qualifiers, called, _)) in
+      (expected.zip types).zip callParameters do
+    if !qualifiersEqual qualifiers no_qualifiers || !sameType declared called then
+      stop "call and declaration parameter prototypes differ"
+    parameter program required declared
+    parameter program required called
+  let mut objects := []
+  for argument in arguments do
+    match argument with
+    | .Vobject (.OVpointer pointer) => objects := pointer :: objects
+    | _ => stop "normal external argument is not a pointer to its parameter object"
+  let required := (gnu_nonnull_parameters links program original).map Prod.fst
+  if required.any (fun index => index >= types.length) then
+    stop "linked nonnull contract refers to a missing argument"
+  return ⟨location, program, name, resolved, types, objects.reverse, required⟩
+
+inductive Argument where
+  | number (value : Int)
+  | pointer (value : PointerValue)
+
+def loadArgument [LemFuel] [CerbGlobal.Switches]
+    (location : CerbLocation.Loc) (program : Program)
+    (type : ctype) (pointer : PointerValue) (nonnull : Bool) (state : MemState) :
+    Except Failure (Argument × Footprint × MemState) := do
+  match pointer with
+  | .PV (.Prov_some _) (.PVconcrete _ _) => pure ()
+  | _ => stop "parameter temporary needs ordinary concrete allocation provenance"
+  let (valid, checked) ← immediate
+    (validForDerefPtrval program.enumDefs program.tagDefs type pointer) state
+  if !valid then stop "parameter object fails model lifetime/alignment checks"
+  let ((footprint, value), after) ← immediate
+    (loadM program.enumDefs program.tagDefs location type pointer) checked
+  if !memValueHasType type value then stop "parameter object has incompatible stored type"
+  match value with
+  | .MVinteger _ (.IV _ number) => return (.number number, footprint, after)
+  | .MVpointer _ pointer =>
+    if nonnull then
+      let (isNull, checked) ← immediate (eqPtrval location pointer (nullPtrval void)) after
+      if isNull then throw (.memory (.Undef0 location
+        [.DUMMY "GNU nonnull argument is null or unspecified"]))
+      return (.pointer pointer, footprint, checked)
+    else return (.pointer pointer, footprint, after)
+  | .MVunspecified _ =>
+    if nonnull then throw (.memory (.Undef0 location
+      [.DUMMY "GNU nonnull argument is null or unspecified"]))
+    else stop "parameter object is unspecified"
+  | _ => stop "parameter object has unsupported value kind"
+
+structure Decoded where
+  request : CerbHostNetworkGuest.Request
+  inputFootprints : List Footprint
+  memory : MemState
+
+/-- Linux receives nfds as unsigned int even though glibc nfds_t is unsigned long.
+The supplied limit must be the current observed process RLIMIT_NOFILE, under
+the same serialized worker session used for execution. Unknown is not zero. -/
+inductive PollCountPlan where
+  | withoutArray
+  | array (count : Nat)
+  deriving BEq, Repr
+
+def planPollCount (count : Int) (verifiedDescriptorLimit : Option Nat) :
+    Except Failure PollCountPlan := do
+  if count < 0 || count > 18446744073709551615 then
+    stop "nfds_t is outside the pinned unsigned-long domain"
+  let narrowed := (count % 4294967296).toNat
+  if narrowed == 0 then return .withoutArray
+  let some limit := verifiedDescriptorLimit
+    | stop "poll array admission requires the observed process descriptor limit"
+  if narrowed > limit then return .withoutArray
+  return .array narrowed
+
+private def records [LemFuel] [CerbGlobal.Switches]
+    (location : CerbLocation.Loc) (program : Program)
+    (shape : PollShape) (pointer : PointerValue) (count : Nat) (state : MemState) :
+    Except Failure (List CerbHostNetworkGuest.PollRecord × MemState) := do
+  let mut after := state
+  let mut result := []
+  for index in List.range count do
+    let (element, next) ← immediate (effArrayShiftPtrval program.enumDefs program.tagDefs
+      location pointer shape.recordType (.IV .Prov_none (index : Int))) after
+    result := {
+      fd := memberShiftPtrval program.enumDefs program.tagDefs element shape.tag shape.fdField,
+      events := memberShiftPtrval program.enumDefs program.tagDefs element shape.tag shape.eventsField,
+      revents := memberShiftPtrval program.enumDefs program.tagDefs element shape.tag shape.reventsField
+    } :: result
+    after := next
+  return (result.reverse, after)
+
+def decode [LemFuel] [CerbGlobal.Switches]
+    (admitted : Admitted) (state : MemState) (verifiedDescriptorLimit : Option Nat := none) :
+    Except Failure Decoded := do
+  let program := admitted.program
+  let location := admitted.location
+  let mut arguments := []
+  let mut footprints := []
+  let mut after := state
+  for ((type, pointer), index) in
+      (admitted.parameterTypes.zip admitted.argumentObjects).zipIdx do
+    let (argument, footprint, next) ← loadArgument location program type pointer
+      (admitted.nonnullParameters.contains index) after
+    arguments := argument :: arguments
+    footprints := footprint :: footprints
+    after := next
+  arguments := arguments.reverse
+  footprints := footprints.reverse
+  match admitted.name, arguments with
+@DECODES@
+  | _, _ => stop "decoded parameter objects disagree with admitted prototype"
+
+end CerbHostNetworkAdmission
