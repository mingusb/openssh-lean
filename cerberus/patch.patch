+/-- The data fields of `Core.generic_file`. The constructor pattern in
+`CoreSnapshot.fromFile` also catches newly added fields at compilation. -/
+def linkedCoreFieldNames : Array String := #[
+  "main", "calling_convention", "tagDefs", "enumDefs", "stdlib", "impl",
+  "globs", "funs", "extern", "funinfo", "loop_attributes",
+  "visible_objects_env"
+]
+
+structure LinkedCoreIdentity where
+  sourceBindingPath : String
+  sourceBindingSHA256 : String
+  translatorPath : String
+  translatorSHA256 : String
+  semanticSwitches : String
+  scope : String
+  fieldNames : Array String
+  linkedFunctionCount : Nat
+  linkedGlobalCount : Nat
+  deriving Lean.ToJson, Lean.FromJson, Lean.ToExpr
+
+structure LinkedCoreFile where
+  identity : LinkedCoreIdentity
+  snapshot : Lean.Json
+  references : Lean.Json
