+(* Provenance follows the value of a comma expression. Its left operand is
+   still evaluated once by the ordinary call-argument path, not by this query. *)
+val gnu_inline_argument_origin:
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory
+let rec gnu_inline_argument_origin (A.AnnotatedExpression ty annots loc expr as e) =
+  let self = gnu_inline_argument_origin in
+  match expr with
+    | A.AilEbinary _ A.Comma right -> self right
+    | A.AilEcast qs ct operand -> A.AnnotatedExpression ty annots loc (A.AilEcast qs ct (self operand))
+    | A.AilEannot ct operand -> A.AnnotatedExpression ty annots loc (A.AilEannot ct (self operand))
+    | A.AilEbinary left bop right -> A.AnnotatedExpression ty annots loc (A.AilEbinary (self left) bop (self right))
+    | _ -> e
+  end
