+(* The complete retained-global census proves internal linkage and that
+   this pointer object's address never escapes anywhere in the TU. Therefore
+   a readonly indirect destination cannot name its storage. A direct store to
+   the protected symbol must still pass the ordinary value-origin proof. *)
+val gnu_boundary_private_global_lvalue:
+  maybe Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_boundary_private_global_lvalue protected (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      not (gnu_memory_expression_readonly expr) then false else match protected with
+    | Nothing -> false
+    | Just subject -> match node with
+        | A.AilEident target -> target <> subject
+        | A.AilEmemberof operand _ -> gnu_boundary_private_global_lvalue protected operand
+        | A.AilEmemberofptr _ _ -> true
+        | A.AilEunary A.Indirection _ -> true
+        | A.AilEannot _ operand -> gnu_boundary_private_global_lvalue protected operand
+        | _ -> false end
+  end
+
+(* GNU variadic builtins write their va_list, not arbitrary C storage. Only
+   preserve the already-certified private global slot here. Its complete
+   address-use census and a distinct direct array/record object establish
+   separation; neither va_list contents nor unrelated indirect roots survive.
+   The caller separately checks every operand that the builtin evaluates. *)
+val gnu_boundary_va_list_disjoint:
+  maybe Symbol.sym -> Ctype.ctype -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_boundary_va_list_disjoint protected record_ty
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  if isNothing protected || not (gnu_memory_expression_readonly expr) then false else
+  let same ty = AilTypesAux.are_compatible
+    (Ctype.no_qualifiers, ty) (Ctype.no_qualifiers, record_ty) in
+  match node with
+    | A.AilEarray_decay object_expr ->
+        (match ctype_of object_expr with
+          | Ctype.Ctype _ (Ctype.Array element _) ->
+              same element && gnu_boundary_private_global_lvalue protected object_expr
+          | _ -> false end)
+    | A.AilEunary A.Address object_expr ->
+        same (ctype_of object_expr) &&
+          gnu_boundary_private_global_lvalue protected object_expr
+    | A.AilEannot _ operand -> gnu_boundary_va_list_disjoint protected record_ty operand
+    | _ -> false
+  end
