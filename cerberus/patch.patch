+(* Only the initial straight-line declarations necessarily run before every
+   later label/branch. Retaining a pointer value initialized inside a branch,
+   after a goto, or in an expression with hidden control would be unsound. *)
+val gnu_entry_alias_declarations:
+  list (A.statement GenTypes.genTypeCategory) -> list Symbol.sym
+let rec gnu_entry_alias_declarations statements = match statements with
+  | [] -> []
+  | stmt :: rest -> match stmt.A.node with
+      | A.AilSskip -> gnu_entry_alias_declarations rest
+      | A.AilSdeclaration declarations ->
+          if List.all (fun (_, value) -> maybe true (fun expr ->
+              gnu_memory_expression_readonly expr && gnu_dead_arm_expression_closed expr) value) declarations
+          then List.map fst (List.filter (fun (_, value) -> isJust value) declarations) ++
+            gnu_entry_alias_declarations rest else []
+      | _ -> [] end
+end
+
+val gnu_entry_alias_candidates: A.statement GenTypes.genTypeCategory -> list Symbol.sym
+let gnu_entry_alias_candidates stmt = match stmt.A.node with
+  | A.AilSvla_scope _ _ _ _ -> []
+  | A.AilSblock bindings statements ->
+      let initialized = gnu_entry_alias_declarations statements in
+      List.map fst (List.filter (fun (sym, ((_, entry_dur, _), _, qs, ty)) ->
+        entry_dur = A.Automatic && List.elem sym initialized &&
+        not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+        AilTypesAux.is_pointer ty && gnu_branch_symbol_unchanged sym stmt) bindings)
+  | _ -> []
+end
+
+(* A private in/out pointer can preserve an opaque extent without writing on
+   every return. This is an inductive class certificate: start at a dominating
+   null initializer, account for every address use, and require each helper to
+   preserve the class for every write. It never supplies a missing call fact.
+   Both caller and helper must be free of pointer-refining control. *)
+val gnu_private_output_opaque_value:
+  Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_private_output_opaque_value formal locals (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_private_output_opaque_value formal locals in
+  if gnu_literal_null_pointer expr then E.return true else
+  if not (AilTypesAux.is_pointer (ctype_of expr)) ||
+      AilTypesAux.is_pointer_to_function (ctype_of expr) then E.return false else
+  match node with
+    | A.AilErvalue operand ->
+        if gnu_output_store_target formal operand then E.return true else
+        let (qs, ty) = qualified_ctype_of operand in
+        E.return (not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+          maybe false (fun sym -> List.elem sym locals) (gnu_inline_direct_pointer_symbol expr))
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+        then self operand else E.return false
+    | A.AilEbinary pointer (A.Arithmetic A.Add) offset ->
+        if AilTypesAux.is_pointer (ctype_of pointer) && AilTypesAux.is_integer (ctype_of offset) &&
+            gnu_memory_expression_readonly offset then self pointer
+        else if AilTypesAux.is_integer (ctype_of pointer) && AilTypesAux.is_pointer (ctype_of offset) &&
+            gnu_memory_expression_readonly pointer then self offset else E.return false
+    | A.AilEbinary pointer (A.Arithmetic A.Sub) offset ->
+        if AilTypesAux.is_pointer (ctype_of pointer) && AilTypesAux.is_integer (ctype_of offset) &&
+            gnu_memory_expression_readonly offset then self pointer else E.return false
+    | _ -> gnu_ordinary_unsized_pointer_result expr
+  end
+
+(* Only a load of the output object or a certified store may consume the
+   output-address formal. Returning it, passing it to another call, copying its
+   address or accessing it through an unrecognized cast rejects the proof.
+   Unrelated stores cannot reach the caller's confined automatic output. *)
+val gnu_private_output_expression:
+  Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_private_output_expression formal locals (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_private_output_expression formal locals in
+  let every operands = E.mapM self operands >>= fun values -> E.return (List.all (fun ok -> ok) values) in
+  match node with
+    | A.AilEident sym -> E.return (sym <> formal)
+    | A.AilErvalue operand ->
+        if gnu_output_store_target formal operand then E.return true else self operand
+    | A.AilEassign left right ->
+        if gnu_output_store_target formal left then
+          gnu_private_output_opaque_value formal locals right >>= fun opaque ->
+          if opaque then self right else E.return false
+        else every [left; right]
+    | A.AilEcompoundAssign left _ right -> every [left; right]
+    | A.AilEcall callee args -> every (callee :: args)
+    | A.AilEbinary left _ right -> every [left; right]
+    | A.AilEcond test yes no -> every (test :: no :: maybe [] (fun value -> [value]) yes)
+    | A.AilEunary _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEsizeof_expr operand -> self operand
+    | A.AilEconst _ -> E.return true
+    | A.AilEstr _ -> E.return true
+    | A.AilEsizeof _ _ -> E.return true
+    | A.AilEalignof _ _ -> E.return true
+    | A.AilEoffsetof _ _ -> E.return true
+    | A.AilEbuiltin (A.AilBGNU_asm _ _ _ _ _ _) -> E.return false
+    | A.AilEbuiltin _ -> E.return true
+    | _ -> E.return false
+  end
+
+val gnu_private_output_statement:
+  Symbol.sym -> list Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_private_output_statement formal locals stmt =
+  let self = gnu_private_output_statement formal locals in
+  let expr = gnu_private_output_expression formal locals in
+  let every actions = E.mapM (fun action -> action) actions >>= fun values -> E.return (List.all (fun ok -> ok) values) in
+  match stmt.A.node with
+    | A.AilSskip -> E.return true
+    | A.AilSexpr value -> expr value
+    | A.AilSblock bindings children ->
+        if not (List.all (function
+          | (_, ((_, A.Automatic, _), _, qs, ty)) -> not qs.Ctype.volatile &&
+              not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+          | _ -> false end) bindings) then E.return false else every (List.map self children)
+    | A.AilSdeclaration declarations -> every (List.map (fun (_, value) -> maybe (E.return true) expr value) declarations)
+    | A.AilSif test yes no -> every [expr test; self yes; self no]
+    | A.AilSwhile test body _ -> every [expr test; self body]
+    | A.AilSdo body test _ -> every [self body; expr test]
+    | A.AilSswitch test body -> every [expr test; self body]
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body (Just _) -> self body
+    | A.AilSreturn value -> expr value
+    | A.AilSreturnVoid -> E.return true
+    | A.AilSbreak -> E.return true
+    | A.AilScontinue -> E.return true
+    | A.AilSgoto _ -> E.return true
+    | A.AilSmarker _ body -> self body
+    | _ -> E.return false
+  end
+
+val gnu_private_output_helper:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_private_output_helper subject caller_body (A.AnnotatedExpression _ _ _ node as call) =
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+        then E.return false else
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_pointer_refinement_possible target >>= fun refinement ->
+              if refinement then E.return false else
+              E.gnu_memory_call_body target >>= function
+                | Nothing -> E.return false
+                | Just (params, body) ->
+                    if List.length params <> List.length args || gnu_source_statement_labels body <> []
+                    then E.return false else
+                    let parameters = List.zip params args in
+                    let selected = List.filter (fun (_, (_, arg)) -> match gnu_call_output_address arg with
+                      | Just (sym, _) -> sym = subject | Nothing -> false end)
+                        (List.mapi (fun index pair -> (index, pair)) parameters) in
+                    (match selected with
+                      | [(index, (formal, _))] ->
+                          if not (gnu_inline_parameter_unchanged formal body &&
+                            List.all (fun (param, arg) -> param = formal ||
+                              gnu_alloc_size_subject_expression subject arg) parameters)
+                          then E.return false else
+                          (* Repeated calls may borrow the same private cell, but
+                             every address occurrence must use this exact helper
+                             and formal position. Integer result comparisons do
+                             not export the cell; unrelated escapes still fail. *)
+                          gnu_output_actual_confined_statement subject target index caller_body >>= fun confined ->
+                          if not confined then E.return false else
+                          (match body.A.node with
+                            | A.AilSblock bindings statements ->
+                                let initialized = gnu_entry_alias_declarations statements in
+                                let private_locals = List.map fst (List.filter (fun (sym, ((_, dur, _), _, qs, ty)) ->
+                                  dur = A.Automatic && List.elem sym initialized && not qs.Ctype.volatile &&
+                                  not (AilTypesAux.is_atomic ty) && AilTypesAux.is_pointer ty &&
+                                  not (AilTypesAux.is_pointer_to_function ty) &&
+                                  gnu_alloc_size_subject_unescaped sym body) bindings) in
+                                let declarations = List.concat (List.map (fun child -> match child.A.node with
+                                  | A.AilSdeclaration values -> values | _ -> [] end) statements) in
+                                E.mapM (fun (sym, value) ->
+                                  if not (List.elem sym private_locals) then E.return Nothing else
+                                  maybe (E.return Nothing) (fun initial ->
+                                    gnu_private_output_opaque_value formal [] initial >>= fun opaque ->
+                                    E.return (if opaque then Just sym else Nothing)) value) declarations >>= fun initial ->
+                                let candidates = List.foldr (fun item rest -> maybe rest (fun sym -> sym :: rest) item) [] initial in
+                                (* Each candidate has its own dominating positive initializer.
+                                   Remove dependencies on any candidate whose later definitions fail. *)
+                                E.foldlM (fun members _ ->
+                                  E.mapM (fun sym ->
+                                    gnu_pointer_definition_statement (fun value ->
+                                      gnu_private_output_opaque_value formal members value >>= fun opaque ->
+                                      E.return (if opaque then Just true else Nothing)) sym body >>= fun result ->
+                                    E.return (if isJust result then Just sym else Nothing)) members >>= fun results ->
+                                  E.return (List.foldr (fun item rest -> maybe rest (fun sym -> sym :: rest) item) [] results)
+                                ) candidates candidates >>= fun members ->
+                                gnu_private_output_statement formal members body >>= fun accepted ->
+                                let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf call) (fun () ->
+                                  "GNU private inout class helper " ^ show target ^ "; subject=" ^ show subject ^
+                                  "; local-origins=" ^ show members ^ "; accepted=" ^ show accepted) in
+                                E.return accepted
+                            | _ -> E.return false end)
+                      | _ -> E.return false end)
               end
+        end
+    | _ -> E.return false
+  end
+
+(* Integer result wrappers do not change a helper's pointer-output class.
+   Check each operand and every original call without evaluating it. Restrict
+   decomposition to integer comparisons/identity-preserving wrappers: a failed
+   pointer assignment or address escape must never become acceptable merely by
+   recursively forgetting the operation that made it invalid. *)
+val gnu_private_output_caller_expression:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_private_output_caller_expression subject whole
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_private_output_caller_expression subject whole in
+  if gnu_opaque_pointer_updates_expression subject expr then E.return true else
+  match node with
+    | A.AilEcall _ _ -> gnu_private_output_helper subject whole expr
+    | A.AilEbinary left bop right ->
+        if not ((bop = A.Eq || bop = A.Ne) &&
+            AilTypesAux.is_integer (ctype_of left) && AilTypesAux.is_integer (ctype_of right))
+        then E.return false else
+        self left >>= fun first -> if first then self right else E.return false
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_integer ty && AilTypesAux.is_integer (ctype_of operand)
+        then self operand else E.return false
+    | _ -> E.return false
+  end
+
+val gnu_private_output_caller:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> A.statement GenTypes.genTypeCategory ->
+  A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_private_output_caller subject initial whole stmt =
+  let self = gnu_private_output_caller subject initial whole in
+  let expression = gnu_private_output_caller_expression subject whole in
+  let every actions = E.mapM (fun action -> action) actions >>= fun values -> E.return (List.all (fun ok -> ok) values) in
+  match stmt.A.node with
+    | A.AilSskip -> E.return true
+    | A.AilSexpr value -> expression value
+    | A.AilSblock _ children -> every (List.map self children)
+    | A.AilSdeclaration declarations -> every (List.map (fun (sym, value) ->
+        if sym = subject then E.return (value = Just initial)
+        else maybe (E.return true) expression value) declarations)
+    | A.AilSif test yes no -> every [expression test; self yes; self no]
+    | A.AilSwhile test body _ -> every [expression test; self body]
+    | A.AilSdo body test _ -> every [self body; expression test]
+    | A.AilSswitch test body -> every [expression test; self body]
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSreturn value -> expression value
+    | A.AilSreturnVoid -> E.return true
+    | A.AilSbreak -> E.return true
+    | A.AilScontinue -> E.return true
+    | A.AilSgoto _ -> E.return true
+    | A.AilSmarker _ body -> self body
+    | _ -> E.return false
+  end
+
+val gnu_register_entry_opaque_output_locals:
+  A.statement GenTypes.genTypeCategory -> E.elabM unit
+let gnu_register_entry_opaque_output_locals stmt =
+  if not (Implementation.has_amd64_sysv_abi ()) then E.return () else match stmt.A.node with
+    | A.AilSblock bindings statements ->
+        let initialized = gnu_entry_alias_declarations statements in
+        let eligible = List.map fst (List.filter (fun (sym, ((_, dur, _), _, qs, ty)) ->
+          dur = A.Automatic && List.elem sym initialized && not qs.Ctype.volatile &&
+          not (AilTypesAux.is_atomic ty) && AilTypesAux.is_pointer ty &&
+          not (AilTypesAux.is_pointer_to_function ty)) bindings) in
+        let declarations = List.concat (List.map (fun child -> match child.A.node with
+          | A.AilSdeclaration values -> values | _ -> [] end) statements) in
+        E.mapM_ (fun (sym, value) -> match value with
+          | Just initial -> if not (List.elem sym eligible && gnu_literal_null_pointer initial)
+              then E.return () else
+              gnu_private_output_caller sym initial stmt stmt >>= fun preserved ->
+              let () = Debug.print_debug_located 2 [Debug.DB_elaboration] stmt.A.loc (fun () ->
+                "GNU private inout entry " ^ show sym ^ "; preserved=" ^ show preserved) in
+              if preserved then E.register_gnu_opaque_advance_fact sym else E.return ()
+          | Nothing -> E.return () end) declarations
+    | _ -> E.return ()
+  end
+
+(* Initial declarations dominate every later query in this body. A local copy
+   of an opaque formal may retain that extent class under the same advancement
+   certificate. Only direct formal copies qualify; no missing fact is promoted
+   to opacity and no local pointer value/alias is treated as immutable. *)
+val gnu_register_entry_opaque_advancing_locals:
+  list Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM unit
+let gnu_register_entry_opaque_advancing_locals parameters stmt = match stmt.A.node with
+  | A.AilSblock bindings statements ->
+      let initialized = gnu_entry_alias_declarations statements in
+      let eligible = List.map fst (List.filter (fun (sym, ((_, entry_dur, _), _, qs, ty)) ->
+        entry_dur = A.Automatic && List.elem sym initialized &&
+        not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && AilTypesAux.is_pointer ty &&
+        gnu_alloc_size_subject_unescaped sym stmt) bindings) in
+      let declarations = List.concat (List.map (fun child -> match child.A.node with
+        | A.AilSdeclaration values -> values | _ -> [] end) statements) in
+      E.mapM_ (fun (sym, value) -> if not (List.elem sym eligible) then E.return () else match value with
+        | Nothing -> E.return ()
+        | Just initial_value ->
+            if not (gnu_opaque_pointer_updates_statement sym (Just initial_value) stmt) then E.return () else
+            (match gnu_inline_direct_pointer_symbol initial_value with
+              | Just source -> if not (List.elem source parameters) then E.return () else
+                  E.gnu_inline_fact source >>= function
+                    | Just E.GNU_inline_unknown_extent_fact -> E.register_gnu_opaque_advance_fact sym
+                    | _ -> E.return ()
+                  end
+              | Nothing -> E.return () end)
+        end) declarations
+  | _ -> E.return ()
+end
+
+(* An unrelated indirect call need not make every pointer parameter a
+   refinement risk. This certificate admits a subject only in a direct
+   object-size query, never in runtime data/control, pointer arithmetic or
+   arguments. The original ordinary boundary and all runtime calls remain. *)
+val gnu_pointer_query_operand: Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_query_operand sym (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident other) as operand) ->
+      let (qs, ty) = qualified_ctype_of operand in
+      sym = other && not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty)
+  | A.AilEcast _ _ operand -> AilTypesAux.is_pointer (ctype_of expr) && gnu_pointer_query_operand sym operand
+  | A.AilEannot _ operand -> gnu_pointer_query_operand sym operand
+  | _ -> false
+end
+
+val gnu_pointer_query_only_expression:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_query_only_expression sym (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_pointer_query_only_expression sym in
+  match node with
+    | A.AilEident other -> sym <> other
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_object_size _ _))) [operand] ->
+        gnu_pointer_query_operand sym operand || self operand
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEassign left right -> self left && self right
+    | A.AilEcompoundAssign left _ right -> self left && self right
+    | A.AilEcond test yes no -> self test && maybe true self yes && self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEcall callee args -> self callee && List.all self args
+    | A.AilEassert operand -> self operand
+    | A.AilEarray _ _ values -> List.all (maybe true self) values
+    | A.AilEstruct _ members -> List.all (fun (_, value) -> maybe true self value) members
+    | A.AilEunion _ _ value -> maybe true self value
+    | A.AilEcompound _ ty operand -> gnu_inline_fixed_object_type ty && self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEsizeof _ ty -> gnu_inline_fixed_object_type ty
+    | A.AilEsizeof_expr operand -> gnu_inline_fixed_object_type (ctype_of operand) && self operand
+    | A.AilEalignof _ _ -> true
+    | A.AilEoffsetof _ _ -> true
+    | A.AilEbuiltin (A.AilBGNU_asm _ _ _ _ _ _) -> false
+    | A.AilEbuiltin _ -> true
+    | A.AilEstr _ -> true
+    | A.AilEconst _ -> true
+    | _ -> false
+  end
+
+val gnu_pointer_query_only_statement: Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_query_only_statement sym stmt =
+  let self = gnu_pointer_query_only_statement sym in
+  let expr = gnu_pointer_query_only_expression sym in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif test yes no -> expr test && self yes && self no
+    | A.AilSwhile test body _ -> expr test && self body
+    | A.AilSdo body test _ -> self body && expr test
+    | A.AilSreturnVoid -> true
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch test body -> expr test && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSdeclaration declarations -> List.all (fun (target, value) ->
+        target <> sym && maybe true expr value) declarations
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+(* Capture only allocation arguments whose original storage cannot remain a
+   reusable immutable dependency. The assignment remains inside that argument,
+   so no source computation is duplicated or sequenced ahead of its siblings.
+   Compiler builtins/unevaluated operands and hidden statement syntax are left
+   intact for their existing, separate translation boundaries. *)
+val gnu_alloc_argument_needs_capture:
+  (A.statement GenTypes.genTypeCategory * A.statement GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory -> bool
+let gnu_alloc_argument_needs_capture (body, continuation) argument =
+  match gnu_alloc_size_dependencies argument with
+    | Nothing -> true
+    | Just [] -> false
+    | Just ((first, _) :: rest as dependencies) ->
+        (* The current allocation fact has one dependency slot. Even stable
+           multi-input arithmetic needs its original evaluated-value snapshot. *)
+        not (List.all (fun (subject, _) -> subject = first) rest) ||
+        not (List.all (fun (subject, _) ->
+          gnu_alloc_size_subject_unescaped subject body &&
+          (gnu_branch_symbol_unchanged subject body ||
+            (List.elem subject (gnu_branch_local_symbols body) &&
+              gnu_branch_symbol_unchanged subject continuation))) dependencies)
+  end
+
+(* A stored pointer outlives the scalar used to form its offset. Save only
+   mutable, pure integer offsets at that value-production point. The assignment
+   stays inside the original operand; ordinary indexing, unevaluated operands,
+   pointer evaluation order and all original effects are unchanged. *)
+val gnu_snapshot_stored_pointer_offset:
+  (A.statement GenTypes.genTypeCategory * A.statement GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (A.expression GenTypes.genTypeCategory * A.bindings)
+let rec gnu_snapshot_stored_pointer_offset body
+    (A.AnnotatedExpression category annots loc node as expr) =
+  let self = gnu_snapshot_stored_pointer_offset body in
+  match node with
+    | A.AilEbinary left bop right ->
+        let selected = match bop with
+          | A.Arithmetic A.Add ->
+              if AilTypesAux.is_pointer (ctype_of left) && AilTypesAux.is_integer (ctype_of right)
+              then Just (true, left, right)
+              else if AilTypesAux.is_integer (ctype_of left) && AilTypesAux.is_pointer (ctype_of right)
+              then Just (false, right, left) else Nothing
+          | A.Arithmetic A.Sub ->
+              if AilTypesAux.is_pointer (ctype_of left) && AilTypesAux.is_integer (ctype_of right)
+              then Just (true, left, right) else Nothing
+          | _ -> Nothing end in
+        (match selected with
+          | Just (pointer_first, pointer, index) ->
+              if not (gnu_size_effects pointer = Just false && gnu_size_effects index = Just false &&
+                  isJust (gnu_alloc_size_dependencies index) && gnu_alloc_argument_needs_capture body index)
+              then E.return (expr, []) else
+              let ty = ctype_of index in
+              E.fresh_elab_sym (Symbol.SD_ObjectAddress "__cerb_pointer_offset") >>= fun capture ->
+              let destination = A.AnnotatedExpression
+                (GenTypes.GenLValueType Ctype.no_qualifiers ty false) [] (Loc.locOf index)
+                (A.AilEident capture) in
+              let saved = A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type ty))
+                [] (Loc.locOf index) (A.AilEassign destination index) in
+              let node = if pointer_first then A.AilEbinary pointer bop saved
+                         else A.AilEbinary saved bop pointer in
+              E.return (A.AnnotatedExpression category annots loc node,
+                [(capture, ((Loc.locOf index, A.Automatic, false), Nothing, Ctype.no_qualifiers, ty))])
+          | Nothing -> E.return (expr, [])
+        end)
+    | A.AilEcast qs ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand) then
+          self operand >>= fun (value, bindings) ->
+          E.return (A.AnnotatedExpression category annots loc (A.AilEcast qs ty value), bindings)
+        else E.return (expr, [])
+    | A.AilEannot ty operand ->
+        self operand >>= fun (value, bindings) ->
+        E.return (A.AnnotatedExpression category annots loc (A.AilEannot ty value), bindings)
+    | _ -> E.return (expr, [])
+  end
+
+val gnu_snapshot_alloc_expression:
+  (A.statement GenTypes.genTypeCategory * A.statement GenTypes.genTypeCategory) -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (A.expression GenTypes.genTypeCategory * A.bindings)
+let rec gnu_snapshot_alloc_expression body (A.AnnotatedExpression category annots loc node as expr) =
+  let self = gnu_snapshot_alloc_expression body in
+  let rebuild node bindings = E.return (A.AnnotatedExpression category annots loc node, bindings) in
+  let unary make operand = self operand >>= fun (value, bindings) -> rebuild (make value) bindings in
+  let binary make left right = self left >>= fun (left, first) ->
+    self right >>= fun (right, second) -> rebuild (make left right) (first ++ second) in
+  let optional value = match value with
+    | Nothing -> E.return (Nothing, [])
+    | Just value -> self value >>= fun (value, bindings) -> E.return (Just value, bindings) end in
+  match node with
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin _)) _ -> E.return (expr, [])
+    | A.AilEcall callee args ->
+        self callee >>= fun (callee, callee_bindings) ->
+        E.mapM self args >>= fun rewritten ->
+        let args = List.map fst rewritten in
+        let bindings = callee_bindings ++ List.concat (List.map snd rewritten) in
+        gnu_opaque_call_boundary callee >>= fun (opaque, attrs) ->
+        let allocated = match attrs with Annot.Attrs values -> List.filter (fun attr ->
+          Cerb_attributes.is_gnu_named_attribute "alloc_size" attr) values end in
+        let decoded = List.map Cerb_attributes.decode_gnu_allocation_indices allocated in
+        let indices = match decoded with
+          | Just indices :: rest -> if List.all (fun candidate -> candidate = Just indices) rest then indices else []
+          | _ -> [] end in
+        (* Match allocation fact production for plain standard declarations.
+           The shared lookup checks the pinned ABI, exact signature, direct
+           designator and absence of a source definition. Explicit malformed
+           or conflicting alloc_size attributes never take this fallback. *)
+        (if opaque && allocated = [] then
+           gnu_standard_allocation_indices callee args >>= fun standard ->
+           E.return (maybe [] (fun indices -> indices) standard)
+         else E.return indices) >>= fun indices ->
+        let params = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function _ params false))) -> params
+          | _ -> [] end in
+        let valid = opaque && gnu_inline_direct_designator callee &&
+          AilTypesAux.is_pointer (ctype_of expr) && indices <> [] &&
+          List.all (fun index -> index > 0 && index <= integerFromNat (List.length args) &&
+            index <= integerFromNat (List.length params)) indices in
+        if not valid then rebuild (A.AilEcall callee args) bindings else
+        E.mapM (fun (index, argument) ->
+          let ty = ctype_of argument in
+          let parameter_integer = maybe false (fun (_, ty, _) -> AilTypesAux.is_integer ty)
+            (List.index params index) in
+          if not (List.elem (integerFromNat index + 1) indices && AilTypesAux.is_integer ty &&
+              parameter_integer && gnu_alloc_argument_needs_capture body argument)
+          then E.return (argument, []) else
+          E.fresh_elab_sym (Symbol.SD_ObjectAddress "__cerb_allocation_argument") >>= fun capture ->
+          let left = A.AnnotatedExpression (GenTypes.GenLValueType Ctype.no_qualifiers ty false)
+            [] (Loc.locOf argument) (A.AilEident capture) in
+          let value = A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type ty))
+            [] (Loc.locOf argument) (A.AilEassign left argument) in
+          E.return (value, [(capture, ((Loc.locOf argument, A.Automatic, false),
+            Nothing, Ctype.no_qualifiers, ty))])
+        ) (List.mapi (fun index argument -> (index, argument)) args) >>= fun captured ->
+        rebuild (A.AilEcall callee (List.map fst captured))
+          (bindings ++ List.concat (List.map snd captured))
+    | A.AilEunary uop operand -> unary (fun value -> A.AilEunary uop value) operand
+    | A.AilEbinary left bop right -> binary (fun left right -> A.AilEbinary left bop right) left right
+    | A.AilEassign left right ->
+        self left >>= fun (left, first) -> self right >>= fun (right, second) ->
+        (if AilTypesAux.is_pointer (ctype_of left) then gnu_snapshot_stored_pointer_offset body right
+         else E.return (right, [])) >>= fun (right, captures) ->
+        rebuild (A.AilEassign left right) (first ++ second ++ captures)
+    | A.AilEcompoundAssign left aop right ->
+        self left >>= fun (left, first) -> self right >>= fun (right, second) ->
+        let direct = match left with
+          | A.AnnotatedExpression _ _ _ (A.AilEident _) -> true
+          | _ -> false end in
+        if not (direct && AilTypesAux.is_pointer (ctype_of left) &&
+            (aop = A.Add || aop = A.Sub))
+        then rebuild (A.AilEcompoundAssign left aop right) (first ++ second) else
+        let loaded = A.AnnotatedExpression category [] loc (A.AilErvalue left) in
+        let advanced = A.AnnotatedExpression category [] loc
+          (A.AilEbinary loaded (A.Arithmetic aop) right) in
+        gnu_snapshot_stored_pointer_offset body advanced >>= fun (saved, captures) ->
+        let (A.AnnotatedExpression _ _ _ saved_node) = saved in
+        (match saved_node with
+          | A.AilEbinary _ _ offset ->
+              rebuild (A.AilEcompoundAssign left aop offset) (first ++ second ++ captures)
+          | _ -> rebuild (A.AilEcompoundAssign left aop right) (first ++ second)
+        end)
+    | A.AilEcond test yes no -> self test >>= fun (test, first) ->
+        optional yes >>= fun (yes, second) -> self no >>= fun (no, third) ->
+        rebuild (A.AilEcond test yes no) (first ++ second ++ third)
+    | A.AilEcast qs ty operand -> unary (fun value -> A.AilEcast qs ty value) operand
+    | A.AilEannot ty operand -> unary (fun value -> A.AilEannot ty value) operand
+    | A.AilErvalue operand -> unary (fun value -> A.AilErvalue value) operand
+    | A.AilEarray_decay (A.AnnotatedExpression row_category row_annots row_loc
+        (A.AilEunary A.Indirection (A.AnnotatedExpression pointer_category pointer_annots pointer_loc
+          (A.AilEbinary base (A.Arithmetic A.Add) index))) as row) ->
+        let index_ty = ctype_of index in
+        if not (gnu_complete_array_decay base && AilTypesAux.is_array (ctype_of row) &&
+            gnu_inline_fixed_object_type (ctype_of row) &&
+            isJust (gnu_inline_counter_destination index))
+        then unary (fun value -> A.AilEarray_decay value) row else
+        E.fresh_elab_sym (Symbol.SD_ObjectAddress "__cerb_array_index") >>= fun capture ->
+        let left = A.AnnotatedExpression (GenTypes.GenLValueType Ctype.no_qualifiers index_ty false)
+          [] (Loc.locOf index) (A.AilEident capture) in
+        let saved = A.AnnotatedExpression
+          (GenTypes.GenRValueType (GenTypes.inject_type index_ty)) [] (Loc.locOf index)
+          (A.AilEassign left index) in
+        let pointer = A.AnnotatedExpression pointer_category pointer_annots pointer_loc
+          (A.AilEbinary base (A.Arithmetic A.Add) saved) in
+        let row = A.AnnotatedExpression row_category row_annots row_loc
+          (A.AilEunary A.Indirection pointer) in
+        rebuild (A.AilEarray_decay row) [(capture, ((Loc.locOf index, A.Automatic, false),
+          Nothing, Ctype.no_qualifiers, index_ty))]
+    | A.AilEarray_decay operand -> unary (fun value -> A.AilEarray_decay value) operand
+    | A.AilEfunction_decay operand -> unary (fun value -> A.AilEfunction_decay value) operand
+    | A.AilEmemberof operand ident -> unary (fun value -> A.AilEmemberof value ident) operand
+    | A.AilEmemberofptr operand ident -> unary (fun value -> A.AilEmemberofptr value ident) operand
+    | A.AilEassert operand -> unary (fun value -> A.AilEassert value) operand
+    | A.AilEcompound qs ty operand -> unary (fun value -> A.AilEcompound qs ty value) operand
+    | A.AilEarray from_string ty values -> E.mapM optional values >>= fun values ->
+        rebuild (A.AilEarray from_string ty (List.map fst values)) (List.concat (List.map snd values))
+    | A.AilEstruct tag members -> E.mapM (fun (ident, value) -> optional value >>= fun (value, bindings) ->
+        E.return ((ident, value), bindings)) members >>= fun members ->
+        rebuild (A.AilEstruct tag (List.map fst members)) (List.concat (List.map snd members))
+    | A.AilEunion tag ident value -> optional value >>= fun (value, bindings) ->
+        rebuild (A.AilEunion tag ident value) bindings
+    | _ -> E.return (expr, [])
+  end
+
+val gnu_snapshot_alloc_statement:
+  (A.statement GenTypes.genTypeCategory * A.statement GenTypes.genTypeCategory) -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (A.statement GenTypes.genTypeCategory * A.bindings)
+let rec gnu_snapshot_alloc_statement body stmt =
+  let self = gnu_snapshot_alloc_statement body in
+  let expr = gnu_snapshot_alloc_expression body in
+  let rebuild node bindings = E.return (<| stmt with A.node= node |>, bindings) in
+  let unary make child = self child >>= fun (child, bindings) -> rebuild (make child) bindings in
+  let expression make value = expr value >>= fun (value, bindings) -> rebuild (make value) bindings in
+  match stmt.A.node with
+    | A.AilSexpr value -> expression (fun value -> A.AilSexpr value) value
+    | A.AilSreturn value -> expression (fun value -> A.AilSreturn value) value
+    | A.AilSblock bindings statements -> E.mapM self statements >>= fun statements ->
+        rebuild (A.AilSblock bindings (List.map fst statements)) (List.concat (List.map snd statements))
+    | A.AilSif test yes no -> expr test >>= fun (test, first) -> self yes >>= fun (yes, second) ->
+        self no >>= fun (no, third) -> rebuild (A.AilSif test yes no) (first ++ second ++ third)
+    | A.AilSwhile test child loop_id -> expr test >>= fun (test, first) -> self child >>= fun (child, second) ->
+        rebuild (A.AilSwhile test child loop_id) (first ++ second)
+    | A.AilSdo child test loop_id -> self child >>= fun (child, first) -> expr test >>= fun (test, second) ->
+        rebuild (A.AilSdo child test loop_id) (first ++ second)
+    | A.AilSswitch test child -> expr test >>= fun (test, first) -> self child >>= fun (child, second) ->
+        rebuild (A.AilSswitch test child) (first ++ second)
+    | A.AilScase number child -> unary (fun child -> A.AilScase number child) child
+    | A.AilScase_rangeGNU low high child -> unary (fun child -> A.AilScase_rangeGNU low high child) child
+    | A.AilSdefault child -> unary (fun child -> A.AilSdefault child) child
+    | A.AilSlabel label child annotation -> unary (fun child -> A.AilSlabel label child annotation) child
+    | A.AilSmarker marker child -> unary (fun child -> A.AilSmarker marker child) child
+    | A.AilSvla_scope scope captures checked child ->
+        unary (fun child -> A.AilSvla_scope scope captures checked child) child
+    | A.AilSdeclaration declarations ->
+        E.mapM (fun (sym, value) -> match value with
+          | Nothing -> E.return ((sym, Nothing), [])
+          | Just value -> expr value >>= fun (value, bindings) ->
+              (if AilTypesAux.is_pointer (ctype_of value) then gnu_snapshot_stored_pointer_offset body value
+               else E.return (value, [])) >>= fun (value, captures) ->
+              E.return ((sym, Just value), bindings ++ captures)
+        end) declarations >>= fun declarations ->
+        rebuild (A.AilSdeclaration (List.map fst declarations)) (List.concat (List.map snd declarations))
+    | _ -> E.return (stmt, [])
+  end
+
+(* Earlier completed scalar assignments do not require a later allocation
+   to save that scalar again. A completed prefix must have no possible entry;
+   future source labels remain in the full suffix and cannot jump backwards
+   into that prefix. Nested statements retain their complete enclosing context,
+   including all loop backedges. Unknown entries restore whole-body analysis. *)
+val gnu_snapshot_alloc_top_sequence:
+  A.statement GenTypes.genTypeCategory -> bool -> list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (list (A.statement GenTypes.genTypeCategory) * A.bindings)
+let rec gnu_snapshot_alloc_top_sequence body prefix_closed statements = match statements with
+  | [] -> E.return ([], [])
+  | first :: rest ->
+      let continuation = if prefix_closed then
+        <| body with A.node= A.AilSblock [] statements |> else body in
+      gnu_snapshot_alloc_statement (body, continuation) first >>= fun (rewritten, bindings) ->
+      let next_closed = prefix_closed && gnu_labels_expressions_closed first &&
+        not (gnu_statement_has_entry_label first) in
+      gnu_snapshot_alloc_top_sequence body next_closed rest >>= fun (rest, more) ->
+      E.return (rewritten :: rest, bindings ++ more)
+end
+
+val gnu_snapshot_allocation_arguments:
+  A.statement GenTypes.genTypeCategory -> E.elabM (A.statement GenTypes.genTypeCategory)
+let gnu_snapshot_allocation_arguments stmt =
+  (match stmt.A.node with
+    | A.AilSblock bindings statements ->
+        gnu_snapshot_alloc_top_sequence stmt true statements >>= fun (statements, captures) ->
+          E.return (<| stmt with A.node= A.AilSblock bindings statements |>, captures)
+    | _ -> gnu_snapshot_alloc_statement (stmt, stmt) stmt
+  end) >>= fun (rewritten, captures) ->
+  if captures = [] then E.return rewritten else
+  let declarations = <| stmt with A.node= A.AilSdeclaration (List.map (fun (sym, _) -> (sym, Nothing)) captures);
+    A.attrs= Annot.no_attributes |> in
+  E.return (match rewritten.A.node with
+    | A.AilSblock bindings statements -> <| rewritten with
+        A.node= A.AilSblock (captures ++ bindings) (declarations :: statements) |>
+    | _ -> <| rewritten with A.node= A.AilSblock captures [declarations; rewritten] |>
+  end)
+
+(* Complete source-write census for a guarded allocation invariant. It does
+   not infer values from missing metadata. Reject writes under repeated or hidden
+   control; unchanged subtrees need no traversal beyond the existing safe check. *)
+val gnu_unique_origin_expression_writes:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  maybe (list (A.expression GenTypes.genTypeCategory))
+let rec gnu_unique_origin_expression_writes subject (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_unique_origin_expression_writes subject in
+  let every operands = List.foldl (fun acc operand -> match (acc, self operand) with
+    | (Just first, Just second) -> Just (first ++ second) | _ -> Nothing end) (Just []) operands in
+  if gnu_inline_parameter_expression_safe subject expr then Just [] else match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident target)) right ->
+        if target <> subject then self right else
+        if gnu_inline_parameter_expression_safe subject right then Just [right] else Nothing
+    | A.AilEassign left right -> every [left; right]
+    | A.AilEbinary left _ right -> every [left; right]
+    | A.AilEcond test yes no -> every (test :: maybe [] (fun value -> [value]) yes ++ [no])
+    | A.AilEcall callee args -> every (callee :: args)
+    | A.AilErvalue child -> self child
+    | A.AilEcast _ _ child -> self child
+    | A.AilEannot _ child -> self child
+    | _ -> Nothing
+  end
+
+val gnu_unique_origin_statement_writes:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  maybe (list (A.expression GenTypes.genTypeCategory))
+let rec gnu_unique_origin_statement_writes subject stmt =
+  let self = gnu_unique_origin_statement_writes subject in
+  let expr = gnu_unique_origin_expression_writes subject in
+  let merge values = List.foldl (fun acc value -> match (acc, value) with
+    | (Just first, Just second) -> Just (first ++ second) | _ -> Nothing end) (Just []) values in
+  if gnu_inline_parameter_unchanged subject stmt then Just [] else match stmt.A.node with
+    | A.AilSexpr value -> expr value
+    | A.AilSreturn value -> expr value
+    | A.AilSblock _ statements -> merge (List.map self statements)
+    | A.AilSif test yes no -> merge [expr test; self yes; self no]
+    | A.AilSlabel _ body Nothing -> self body
+    | A.AilSmarker _ body -> self body
+    | A.AilSdeclaration declarations -> merge (List.map (fun (target, value) ->
+        maybe (Just []) (fun value -> if target = subject then
+          if gnu_inline_parameter_expression_safe subject value then Just [value] else Nothing
+          else expr value) value) declarations)
+    | _ -> Nothing
+  end
+
+val gnu_register_nonnull_allocation_invariants:
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory -> E.elabM unit
+let gnu_register_nonnull_allocation_invariants tagDefs stmt =
+  let forwards = List.map fst (gnu_forward_memory_label_targets stmt) in
+  if not (gnu_labels_expressions_closed stmt &&
+      List.all (fun target -> List.elem target forwards) (gnu_statement_goto_targets stmt))
+  then E.set_gnu_nonnull_allocation_facts [] else
+  let candidates = match stmt.A.node with
+    | A.AilSblock _ statements -> List.filter (fun subject ->
+        gnu_alloc_return_automatic subject stmt && gnu_alloc_size_subject_unescaped subject stmt)
+        (gnu_entry_alias_declarations statements)
+    | _ -> [] end in
+  E.mapM (fun subject -> match gnu_unique_origin_statement_writes subject stmt with
+    | Just (initial :: later) ->
+        if not (gnu_literal_null_pointer initial) then E.return Nothing else
+        (match List.filter (fun value -> not (gnu_literal_null_pointer value)) later with
+          | [allocation] -> gnu_alloc_size_pointer_fact tagDefs allocation >>= function
+              | Just (E.GNU_inline_dynamic_bound_fact (E.GNU_inline_alloc_size_fact dependency _) as fact) ->
+                  let writes = gnu_unique_origin_statement_writes dependency stmt in
+                  let in_allocation = gnu_unique_origin_expression_writes dependency allocation in
+                  let unique = match (writes, in_allocation) with
+                    | (Just [one], Just [same]) -> one = same
+                    | _ -> false end in
+                  if not (unique && gnu_alloc_size_subject_unescaped dependency stmt)
+                  then E.return Nothing else
+                  let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+                    "GNU nonnull allocation invariant " ^ show subject ^ "; dependency=" ^ show dependency) in
+                  E.return (Just (subject, fact))
+              | _ -> E.return Nothing end
+          | _ -> E.return Nothing end)
+    | _ -> E.return Nothing end) candidates >>= fun facts ->
+  E.set_gnu_nonnull_allocation_facts
+    (List.foldr (fun value rest -> maybe rest (fun fact -> fact :: rest) value) [] facts)
+
+(* Allocate snapshots in the function's ordinary AIL scope, so all existing
+   label/loop lifetime and Core lowering paths see them. The copies execute
+   immediately around the original certified loop, never in an unevaluated
+   operand. Reading its private counter adds no new observable access. *)
+val gnu_snapshot_counted_loop_statement:
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (A.statement GenTypes.genTypeCategory * A.bindings *
+    list (nat * (Symbol.sym * Ctype.ctype)))
+let rec gnu_snapshot_counted_loop_statement tagDefs whole stmt =
+  let self = gnu_snapshot_counted_loop_statement tagDefs whole in
+  let rebuild node bindings snapshots =
+    E.return (<| stmt with A.node= node |>, bindings, snapshots) in
+  let unary make child = self child >>= fun (child, bindings, snapshots) ->
+    rebuild (make child) bindings snapshots in
+  (match stmt.A.node with
+    | A.AilSblock binds statements -> E.mapM self statements >>= fun rewritten ->
+        rebuild (A.AilSblock binds (List.map (fun (child, _, _) -> child) rewritten))
+          (List.concat (List.map (fun (_, bindings, _) -> bindings) rewritten))
+          (List.concat (List.map (fun (_, _, snapshots) -> snapshots) rewritten))
+    | A.AilSif test yes no -> self yes >>= fun (yes, first, first_snapshots) ->
+        self no >>= fun (no, second, second_snapshots) ->
+        rebuild (A.AilSif test yes no) (first ++ second) (first_snapshots ++ second_snapshots)
+    | A.AilSwhile test child loop_id -> unary (fun child -> A.AilSwhile test child loop_id) child
+    | A.AilSdo child test loop_id -> unary (fun child -> A.AilSdo child test loop_id) child
+    | A.AilSswitch test child -> unary (fun child -> A.AilSswitch test child) child
+    | A.AilScase number child -> unary (fun child -> A.AilScase number child) child
+    | A.AilScase_rangeGNU low high child -> unary (fun child -> A.AilScase_rangeGNU low high child) child
+    | A.AilSdefault child -> unary (fun child -> A.AilSdefault child) child
+    | A.AilSlabel label child annotation -> unary (fun child -> A.AilSlabel label child annotation) child
+    | A.AilSmarker marker child -> unary (fun child -> A.AilSmarker marker child) child
+    | A.AilSvla_scope scope captures checked child ->
+        unary (fun child -> A.AilSvla_scope scope captures checked child) child
+    | _ -> E.return (stmt, [], [])
+  end) >>= fun (rewritten, bindings, snapshots) ->
+  match (gnu_counted_pointer_loop tagDefs stmt, stmt.A.node) with
+    | (Just (counter, ty, index, pointer, _), A.AilSwhile _ _ loop_id) ->
+      if not (gnu_alloc_size_subject_unescaped counter whole &&
+          gnu_alloc_size_subject_unescaped pointer whole)
+      then E.return (rewritten, bindings, snapshots) else
+      E.fresh_elab_sym (Symbol.SD_ObjectAddress "__cerb_loop_counter_entry") >>= fun entry ->
+      E.fresh_elab_sym (Symbol.SD_ObjectAddress "__cerb_loop_counter_exit") >>= fun exit ->
+      let copy target =
+        let left = A.AnnotatedExpression (GenTypes.GenLValueType Ctype.no_qualifiers ty false)
+          [] stmt.A.loc (A.AilEident target) in
+        A.mk_statement stmt.A.loc (A.AilSexpr
+          (A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type ty))
+            [] stmt.A.loc (A.AilEassign left index))) in
+      let captures = List.map (fun sym -> (sym, ((stmt.A.loc, A.Automatic, false),
+        Nothing, Ctype.no_qualifiers, ty))) [entry; exit] in
+      E.return (<| stmt with A.node= A.AilSblock [] [copy entry; rewritten; copy exit] |>,
+        bindings ++ captures, (loop_id, (entry, ty)) :: snapshots)
+    | _ -> E.return (rewritten, bindings, snapshots)
+  end
+
+val gnu_snapshot_counted_loops:
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (A.statement GenTypes.genTypeCategory * list (nat * (Symbol.sym * Ctype.ctype)))
+let gnu_snapshot_counted_loops tagDefs stmt =
+  gnu_snapshot_counted_loop_statement tagDefs stmt stmt >>= fun (rewritten, captures, snapshots) ->
+  if captures = [] then E.return (rewritten, snapshots) else
+  let declarations = A.mk_statement stmt.A.loc
+    (A.AilSdeclaration (List.map (fun (sym, _) -> (sym, Nothing)) captures)) in
+  E.return ((match rewritten.A.node with
+    | A.AilSblock bindings statements -> <| rewritten with
