+  E.gnu_memory_snapshot >>= fun (entry, _, aliases) ->
+  gnu_loop_transfer_paths translate_expr tagDefs loop break_sym continues (entry, aliases) body >>= fun paths ->
+  let stopped path = maybe true (fun (facts, _) -> gnu_loop_test_value tagDefs facts test = Just 0) path in
+  E.return (match paths with
+    | Just (normal, _, continues) -> stopped normal && stopped continues
