+typedef union { int *integer; long *wide; } PointerArg
+    __attribute__((__transparent_union__));
+typedef union __attribute__((transparent_union)) Tagged { int *p; long *q; } Tagged;
+typedef union { int signed_value; unsigned int unsigned_value; } IntegerArg
+    __attribute__((transparent_union));
+typedef union { int *p; long bits; } BitsArg __attribute__((transparent_union));
+static int calls;
+static void *take(PointerArg p) { ++calls; return p.integer; }
+static void *tagged(union Tagged p) { return p.p; }
+static int integer(IntegerArg n) { return n.signed_value; }
+static long bits(BitsArg n) { return n.bits; }
+static PointerArg identity(PointerArg p) { return p; }
+int main(void) {
