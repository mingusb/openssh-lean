+  (Ctype.ctype -> bool -> V.gnuva_runtimeM (Ctype.ctype * Mem.pointer_value)) ->
+  maybe Mem.pointer_value -> Mem.pointer_value -> integer -> list char -> F.format -> V.gnuva_runtimeM (list char)
