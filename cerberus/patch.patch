+val gnu_guard_expand:
+  (Symbol.sym * A.expression GenTypes.genTypeCategory) -> A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let gnu_guard_expand (formal, A.AnnotatedExpression ty annots loc node) actual =
+  if gnu_size_effects actual <> Just false then Nothing else match node with
+    | A.AilEbinary left bop right ->
