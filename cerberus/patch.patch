+let rec gnu_region_scan_stmt path switch_path st (CabsStatement loc _ node) =
+  let expr acc e = gnu_region_scan_expr path switch_path acc e in
+  let stmt acc s = gnu_region_scan_stmt path switch_path acc s in
+  let case_state = match switch_path with
+    | Just outer -> if path = outer then st else <| st with gnu_region_bad_cases= loc :: st.gnu_region_bad_cases |>
+    | Nothing -> st (* The ordinary constraint checker reports case outside switch. *)
+  end in
+  match node with
+    | CabsSlabel ident body -> stmt <| st with gnu_region_labels= (ident,path) :: st.gnu_region_labels |> body
+    | CabsScase e body -> stmt (expr case_state e) body
+    | CabsScaseGNU lo hi body -> stmt (expr (expr case_state lo) hi) body
+    | CabsSdefault body -> stmt case_state body
+    | CabsSblock statements -> List.foldl (fun acc s -> stmt acc s) st statements
+    | CabsSdecl decl -> gnu_region_scan_decl path switch_path st decl
+    | CabsSnull -> st
+    | CabsSexpr e -> expr st e
+    | CabsSif e yes no -> let acc = stmt (expr st e) yes in maybe acc (fun s -> stmt acc s) no
+    | CabsSswitch e body -> gnu_region_scan_stmt path (Just path) (expr st e) body
+    | CabsSwhile e body -> stmt (expr st e) body
+    | CabsSdo e body -> expr (stmt st body) e
+    | CabsSfor initial condition increment body ->
+        let acc = match initial with
+          | Nothing -> st
+          | Just (FC_expr e) -> expr st e
+          | Just (FC_decl _ decl) -> gnu_region_scan_decl path switch_path st decl
+        end in
+        let acc = maybe acc (fun e -> expr acc e) condition in
+        let acc = maybe acc (fun e -> expr acc e) increment in
+        stmt acc body
