+(* Certify effects on an evaluated path, rather than treating an unknown call
+   or an unevaluated/dead operand as an effect. Constant queries never execute
+   this path: a required assignment, increment or volatile read makes GCC's
+   query false, even if its resulting value could otherwise be folded. *)
+val gnu_constant_required_effect: Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_constant_required_effect tagDefs (A.AnnotatedExpression _ _ _ expr) =
+  let self = gnu_constant_required_effect tagDefs in
+  match expr with
+    | A.AilEassign _ _ -> true
+    | A.AilEcompoundAssign _ _ _ -> true
+    | A.AilEunary A.PostfixIncr _ -> true
+    | A.AilEunary A.PostfixDecr _ -> true
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        qs.Ctype.volatile || AilTypesAux.is_atomic ty || self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left A.And right ->
+        self left || (gnu_constant_truth tagDefs left = Just true && self right)
+    | A.AilEbinary left A.Or right ->
+        self left || (gnu_constant_truth tagDefs left = Just false && self right)
+    | A.AilEbinary left _ right -> self left || self right
+    | A.AilEcond condition yes no ->
+        self condition || (match gnu_constant_truth tagDefs condition with
+          | Just true -> maybe false self yes
+          | Just false -> self no
+          | Nothing -> maybe false self yes && self no
+        end)
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) _ -> false
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin (A.AilBGNU_object_size false _))) _ -> false
+    (* Intrinsics and optimizer-known calls may discard their argument effects
+       before constant classification. Do not infer an effect across a call. *)
+    | A.AilEcall _ _ -> false
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | _ -> false
+  end
