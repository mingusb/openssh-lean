+   it is proved false, never to turn missing analysis into a zero-trip loop. *)
+val gnu_loop_test_value:
+  C.core_tag_definitions -> list (E.gnu_memory_slot * E.gnu_inline_fact) ->
+  A.expression GenTypes.genTypeCategory -> maybe integer
+let rec gnu_loop_test_value tagDefs facts (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_loop_test_value tagDefs facts in
+  let fact_value = fun fact -> match fact with
+    | E.GNU_inline_integer_fact origin -> gnu_scalar_closed_integer tagDefs origin
+    | E.GNU_inline_integer_range_fact low high _ -> if low = high then Just low else Nothing
+    | E.GNU_inline_integer_progression_fact low high _ -> if low = high then Just low else Nothing
+    | _ -> Nothing end in
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_integer ty)
+  then Nothing else match node with
+    | A.AilEident sym -> maybe Nothing fact_value (List.lookup (false, sym, []) facts)
+    | A.AilErvalue operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEunary A.PostfixDecr operand -> self operand
+    | A.AilEbinary left A.Gt
+        (A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant number _ _)))) ->
+        if number = 0 then maybe Nothing (fun value -> Just (if value > 0 then 1 else 0))
