+#include <unistd.h>
+#include <lean/lean.h>
+/* Linked only into the separately spawned Lean fixture executable. */
+LEAN_EXPORT uint32_t cerb_system_test_enable_worker(void) {
+    return (uint32_t)cerb_system_enable_worker((int32_t)getpid());
+}
+LEAN_EXPORT uint32_t cerb_system_test_temporary_fd(void) {
+    char path[]="/tmp/cerb-lean-file-XXXXXX";
+    int fd=mkstemp(path);
+    if(fd<0) return UINT32_MAX;
+    if(unlink(path)) { close(fd); return UINT32_MAX; }
+    return (uint32_t)fd;
+}
+LEAN_EXPORT uint32_t cerb_system_test_close_fd(uint32_t fd) {
+    if(fd>INT32_MAX) return UINT32_MAX;
+    return (uint32_t)close((int)fd);
+}
+
+#include "SystemStreamFixtures.h"
+LEAN_EXPORT uint64_t cerb_system_test_stream_fixture(uint32_t fixture) {
+    return system_register_fixture(system_fixture_stream(fixture));
+}
