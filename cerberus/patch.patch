@@ -0,0 +1,191 @@
+/- Generated exact files declaration admission and once-only parameter-object loads.
+This does not execute the native request or replace existing guest memory/resource checks. -/
+import Core_run
+import CerbHostFilesGuest
+import CerbHostDescriptors
+set_option autoImplicit false
+
+namespace CerbHostFilesAdmission
+open CerbMem CerbHostMemoryCells CerberusImpl
+abbrev Program := generic_file Unit core_run_annotation
+
+private def stop {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+private def lookup {α : Type} (key : sym) (values : Fmap sym α) : Option α :=
+  fmapLookupBy (fun a b => Lem_Basic_classes.ordCompare a b) key values
+private def identifierText : identifier → String | .Identifier _ text => text
+private def integer (expected : CellKind) : ctype → Bool
+  | .Ctype _ (.Basic (.Integer actual)) => actual == expected.ity
+  | _ => false
+private def charType : ctype → Bool | .Ctype _ (.Basic (.Integer .Char0)) => true | _ => false
+private def sameType (a b : ctype) : Bool := ctypeEqual a b
+
+inductive CTypeClass where
+  | signedInt | unsignedInt | signedLong | unsignedLong
+  | charPointer | constCharPointer | voidPointer | constVoidPointer | intPointer
+  | statPointer | statvfsPointer | constTimevalPointer | constTimespecPointer | constIovecPointer
+
+structure SourceAPI where
+  result : CTypeClass
+  parameters : List CTypeClass
+  variadic : Bool
+
+private def contract : String → Option SourceAPI
+@CONTRACTS@
+
+/-- Pure family selection. Admission still validates the actual call and definition. -/
+def supportsName (name : String) : Bool := (contract name).isSome
+
+/-- The current integer host reply cannot carry these original source results. -/
+def requiresPointerReply (name : String) : Bool :=
+  match contract name with
+  | some expected => match expected.result with
+    | .charPointer => true
+    | _ => false
+  | none => false
+
+private def pointer (qualifiers : qualifiers) (pointee : ctype → Bool) : ctype → Bool
+  | .Ctype _ (.Pointer q t) => qualifiersEqual q qualifiers && pointee t
+  | _ => false
+private def basicVoid : ctype → Bool | .Ctype _ .Void0 => true | _ => false
+private def recordSize [LemFuel] (program : Program) (size align : Int) : ctype → Bool
+  | t@(.Ctype _ (.Struct tag)) =>
+      (lookup tag program.tagDefs).isSome && sizeofCtype program.enumDefs program.tagDefs t == size &&
+        alignofCtype program.enumDefs program.tagDefs t == align
+  | _ => false
+
+private def accepts [LemFuel] (program : Program) (expected : CTypeClass) (actual : ctype) : Bool :=
+  match expected with
+  | .signedInt => integer .signedInt actual
+  | .unsignedInt => integer .unsignedInt actual
+  | .signedLong => integer .signedLong actual
+  | .unsignedLong => integer .unsignedLong actual
+  | .charPointer => pointer no_qualifiers charType actual
+  | .constCharPointer => pointer { no_qualifiers with const := true } charType actual
+  | .voidPointer => pointer no_qualifiers basicVoid actual
+  | .constVoidPointer => pointer { no_qualifiers with const := true } basicVoid actual
+  | .intPointer => pointer no_qualifiers (integer .signedInt) actual
+  | .statPointer => pointer no_qualifiers (recordSize program 144 8) actual
+  | .statvfsPointer => pointer no_qualifiers (recordSize program 112 8) actual
+  | .constTimevalPointer | .constTimespecPointer | .constIovecPointer =>
+      pointer { no_qualifiers with const := true } (recordSize program 16 8) actual
+
+def decodeVariadicPack (value : value) : Except Failure (List (ctype × PointerValue)) := do
+  match value with
+  | .Vlist (.BTy_tuple [.BTy_ctype, .BTy_object .OTy_pointer]) packed =>
+      let mut typed := []
+      for item in packed do match item with
+        | .Vtuple [.Vctype type, .Vobject (.OVpointer pointer)] =>
+            typed := (type, pointer) :: typed
+        | _ => stop "files variadic pack item lacks exact CType/object-pointer shape"
+      return typed.reverse
+  | _ => stop "files variadic call lacks its exact typed argument pack"
+
+structure Admitted where
+  location : CerbLocation.Loc
+  program : Program
+  name : String
+  symbol : sym
+  parameterTypes : List ctype
+  argumentObjects : List PointerValue
+  nonnullParameters : List Nat
+  variadicObjects : List (ctype × PointerValue)
+
+def admit [LemFuel] (location : CerbLocation.Loc) (program : Program) (links : Fmap sym sym)
+    (original : sym) (callType : generic_pexpr Unit sym) (arguments : List value) : Except Failure Admitted := do
+  if program.calling_convention0 != .Normal_callconv then stop "files admission requires normal argument-object convention"
+  if (lookup_proc_body links program original).isSome then stop "files admission cannot bypass a modeled or user procedure body"
+  let resolved := resolve_linked_function links original
+  let names := Lem_Map_extra.fold (fun ident binding found =>
+    let (symbols, linkage) := binding
+    if linkage == .LK_none && symbols.any (fun symbol => symbol == resolved) then identifierText ident :: found else found) program.extern []
+  let [name] := names | stop "files target lacks one unique unresolved linker name"
+  let some expected := contract name | stop "external name lacks a generated files source contract"
+  let some (.ProcDecl _ resultType parameters) := lookup resolved program.funs | stop "files target is not a procedure declaration"
+  let resultOK := match expected.result with
+    | .charPointer => resultType == .BTy_loaded .OTy_pointer
+    | _ => resultType == .BTy_loaded .OTy_integer
+  if !resultOK then stop "Core result convention disagrees with files contract"
+  if parameters != List.replicate expected.parameters.length (.BTy_object .OTy_pointer) then stop "Core parameters are not normal argument objects"
+  let some (_, _, declaredResult, declaredParameters, variadic, prototype) := lookup resolved program.funinfo
+    | stop "files target lacks its original C prototype"
+  if variadic != expected.variadic || !prototype || declaredParameters.length != expected.parameters.length then
+    stop "files prototype has wrong arity, varargs, or no-prototype status"
+  let (fixedArguments, trailing) := arguments.splitAt expected.parameters.length
+  let variadicObjects ← if expected.variadic then
+    match trailing with
+    | [pack] => decodeVariadicPack pack
+    | _ => stop "files variadic call has multiple trailing pack values"
+  else
+    if trailing.isEmpty then pure [] else stop "fixed files call has trailing arguments"
+  if !accepts program expected.result declaredResult then stop "files declaration return CType differs from contract"
+  let .Pexpr _ _ (.PEval (.Vctype (.Ctype _ (.Pointer fq (.Ctype _ (.Function (rq, callResult) callParameters callVariadic)))))) := callType
+    | stop "files call lacks a fixed function-pointer prototype"
+  if !qualifiersEqual fq no_qualifiers || !qualifiersEqual rq no_qualifiers || callVariadic != expected.variadic ||
+      !sameType declaredResult callResult || callParameters.length != expected.parameters.length then stop "files call and declaration result/arity differ"
+  let types := declaredParameters.map Prod.snd
+  for ((required, declared), (q, called, _)) in (expected.parameters.zip types).zip callParameters do
+    if !qualifiersEqual q no_qualifiers || !sameType declared called || !accepts program required declared then
+      stop "files call/declaration parameter CType differs from contract"
+  let mut objects := []
+  for argument in fixedArguments do match argument with
+    | .Vobject (.OVpointer p) => objects := p :: objects
+    | _ => stop "files normal-call argument is not a parameter-object pointer"
+  let required := (gnu_nonnull_parameters links program original).map Prod.fst
+  if required.any (fun i => i >= types.length) then stop "files nonnull index exceeds declared arity"
+  return ⟨location, program, name, resolved, types, objects.reverse, required, variadicObjects⟩
+
+inductive Argument where | number (value : Int) | pointer (value : PointerValue)
+structure Decoded where
+  arguments : List Argument
+  inputFootprints : List Footprint
+  memory : MemState
+
+private def loadArgument [LemFuel] [CerbGlobal.Switches] (location : CerbLocation.Loc) (program : Program)
+    (type : ctype) (object : PointerValue) (nonnull : Bool) (state : MemState) : Except Failure (Argument × Footprint × MemState) := do
+  let .PV (.Prov_some _) (.PVconcrete _ _) := object | stop "parameter object lacks concrete provenance"
+  let (valid, checked) ← immediate (validForDerefPtrval program.enumDefs program.tagDefs type object) state
+  if !valid then stop "parameter object fails lifetime/alignment checks"
+  let ((footprint, value), after) ← immediate (loadM program.enumDefs program.tagDefs location type object) checked
+  if !memValueHasType type value then stop "parameter object stored value has incompatible CType"
+  match value with
+  | .MVinteger _ (.IV _ n) => return (.number n, footprint, after)
+  | .MVpointer _ p =>
+    if nonnull then
+      let (isNull, next) ← immediate (eqPtrval location p (nullPtrval void)) after
+      if isNull then throw (.memory (.Undef0 location [.DUMMY "GNU nonnull files argument is null"]))
+      return (.pointer p, footprint, next)
+    return (.pointer p, footprint, after)
+  | .MVunspecified _ => if nonnull then throw (.memory (.Undef0 location [.DUMMY "nonnull files argument is unspecified"])) else stop "parameter object is unspecified"
+  | _ => stop "unsupported files parameter-object value"
+
+def decode [LemFuel] [CerbGlobal.Switches] (admitted : Admitted) (state : MemState) : Except Failure Decoded := do
+  let mut values := []; let mut footprints := []; let mut after := state
+  for ((type, object), index) in (admitted.parameterTypes.zip admitted.argumentObjects).zipIdx do
+    let (value, footprint, next) ← loadArgument admitted.location admitted.program type object
+      (admitted.nonnullParameters.contains index) after
+    values := value :: values; footprints := footprint :: footprints; after := next
+  return ⟨values.reverse, footprints.reverse, after⟩
+
+/-- A range with no guest-owned descriptor has no close effect. This checked
+    subset never calls native close_range on interpreter-private descriptors.
+    Other range cases stay explicit until the descriptor-table operation exists. -/
+def emptyCloseRange [LemFuel] [CerbGlobal.Switches]
+    (table : CerbHostDescriptors.Table) (admitted : Admitted) (memory : MemState) :
+    Except Failure Decoded := do
+  if admitted.name != "close_range" then stop "not a close_range admission"
+  match CerbHostDescriptors.validateIdle table with
+  | .error reason => stop reason
+  | .ok () => pure ()
+  let decoded ← decode admitted memory
+  match decoded.arguments with
+  | [.number first, .number last, .number flags] =>
+      if first < 0 || last < 0 || first > 4294967295 || last > 4294967295 ||
+          first > last || flags != 0 then
+        stop "close_range arguments require the outstanding native error/flag semantics"
+      if table.entries.any (fun entry =>
+          entry.guest >= first.toNat && entry.guest <= last.toNat) then
+        stop "close_range over owned guest descriptors requires range-close integration"
+      return decoded
+  | _ => stop "close_range arguments differ from its admitted integer prototype"
+
+end CerbHostFilesAdmission
