@@ -0,0 +1,654 @@
+/* Included only by memo_runtime.c. Native-only persistence for the private
+   ShareCommon/result tables, using the pinned Lean compacted-region format.
+   Persistence errors are cache misses; they never alter the computed result. */
+extern lean_object *lean_compacted_region_save(b_lean_obj_arg, b_lean_obj_arg,
+    b_lean_obj_arg, b_lean_obj_arg, lean_obj_arg, uint8_t);
+extern lean_object *lean_compacted_region_read(b_lean_obj_arg, b_lean_obj_arg);
+extern lean_object *lean_name_mk_string(lean_obj_arg, lean_obj_arg);
+extern char **environ;
+
+static pthread_mutex_t memo_disk_mutex = PTHREAD_MUTEX_INITIALIZER;
+static memo_table *memo_tables, **memo_tables_tail = &memo_tables;
+static lean_object *memo_loaded; /* Array of (root, region), retained until exit. */
+static lean_object *memo_regions;
+static char **memo_part_paths, **memo_part_hashes;
+static size_t memo_part_count;
+static char memo_meta_digest[65];
+static int memo_meta_existed, memo_disk_reset;
+static size_t memo_table_count, memo_loaded_count;
+static uint64_t memo_restored_hits;
+static int memo_disk_initialized, memo_disk_enabled, memo_dirty, memo_saved;
+static char *memo_directory, *memo_manifest, *memo_cache_path, *memo_meta_path;
+static char *memo_lock_path;
+
+static void memo_trace(const char *fmt, ...) {
+    const char *path = getenv("CERB_MEMO_TRACE");
+    if (!path || !*path) return;
+    int fd = open(path, O_WRONLY | O_APPEND | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) return;
+    va_list args;
+    va_start(args, fmt);
+    vdprintf(fd, fmt, args);
+    va_end(args);
+    close(fd);
+}
+
+static char *memo_format(const char *fmt, ...) {
+    char *s = NULL;
+    va_list args;
+    va_start(args, fmt);
+    int n = vasprintf(&s, fmt, args);
+    va_end(args);
+    if (n < 0) abort();
+    return s;
+}
+
+/* No shell, inherited stdin, or PATH lookup. File hashing is outside hot
+   lookups. /proc/<parent>/exe hashes this executable, not sha256sum itself. */
+static int memo_sha256(const char *path, char hex[65]) {
+    int pipes[2], status = 0;
+    pid_t child;
+    if (pipe2(pipes, O_CLOEXEC)) return 0;
+    posix_spawn_file_actions_t acts;
+    if (posix_spawn_file_actions_init(&acts)) {
+        close(pipes[0]); close(pipes[1]); return 0;
+    }
+    posix_spawn_file_actions_adddup2(&acts, pipes[1], STDOUT_FILENO);
+    posix_spawn_file_actions_addopen(&acts, STDERR_FILENO, "/dev/null", O_WRONLY, 0);
+    posix_spawn_file_actions_addclose(&acts, pipes[0]);
+    posix_spawn_file_actions_addclose(&acts, pipes[1]);
+    char *argv[] = {"/usr/bin/sha256sum", "--", (char *)path, NULL};
+    int rc = posix_spawn(&child, argv[0], &acts, NULL, argv, environ);
+    posix_spawn_file_actions_destroy(&acts);
+    close(pipes[1]);
+    if (rc) { close(pipes[0]); return 0; }
+    size_t used = 0;
+    char buf[4096];
+    ssize_t n;
+    while ((n = read(pipes[0], buf, sizeof(buf))) > 0 || (n < 0 && errno == EINTR)) {
+        if (n < 0) continue;
+        for (ssize_t i = 0; i < n && used < 64; ++i) hex[used++] = buf[i];
+    }
+    close(pipes[0]);
+    while (waitpid(child, &status, 0) < 0) {
+        if (errno != EINTR) return 0;
+    }
+    if (used != 64 || !WIFEXITED(status) || WEXITSTATUS(status)) return 0;
+    hex[64] = 0;
+    return strspn(hex, "0123456789abcdef") == 64;
+}
+
+typedef struct { char **items; size_t count; int valid; } memo_libs;
+static int memo_library(struct dl_phdr_info *info, size_t size, void *raw) {
+    (void)size;
+    memo_libs *libs = raw;
+    const char *path = info->dlpi_name;
+    if (!path || !*path || strncmp(path, "linux-vdso.", 11) == 0) return 0;
+    char *actual = realpath(path, NULL);
+    if (!actual) { libs->valid = 0; return 1; }
+    libs->items = realloc(libs->items, (libs->count + 1) * sizeof(char *));
+    if (!libs->items) abort();
+    libs->items[libs->count++] = actual;
+    return 0;
+}
+static int memo_path_compare(const void *a, const void *b) {
+    return strcmp(*(char *const *)a, *(char *const *)b);
+}
+static char *memo_identity(void) {
+    memo_libs libs = {.valid = 1};
+    dl_iterate_phdr(memo_library, &libs);
+    qsort(libs.items, libs.count, sizeof(char *), memo_path_compare);
+    char exe[64], hash[65];
+    snprintf(exe, sizeof(exe), "/proc/%ld/exe", (long)getpid());
+    char *result = NULL;
+    size_t length = 0;
+    FILE *out = open_memstream(&result, &length);
+    if (!out) libs.valid = 0;
+    if (out) {
+        fputs("cerb-memo-v2\n", out);
+        if (!memo_sha256(exe, hash)) libs.valid = 0;
+        else fprintf(out, "exe %s\n", hash);
+        for (size_t i = 0; i < libs.count; ++i) {
+            if (!memo_sha256(libs.items[i], hash)) libs.valid = 0;
+            else fprintf(out, "%zu:%s %s\n", strlen(libs.items[i]), libs.items[i], hash);
+        }
+        if (fclose(out)) libs.valid = 0;
+    }
+    for (size_t i = 0; i < libs.count; ++i) free(libs.items[i]);
+    free(libs.items);
+    if (!libs.valid) { free(result); return NULL; }
+    return result;
+}
+
+static int memo_owned_directory(const char *path) {
+    struct stat st;
+    if (mkdir(path, 0700) && errno != EEXIST) return 0;
+    return !lstat(path, &st) && S_ISDIR(st.st_mode) &&
+        st.st_uid == getuid() && !(st.st_mode & 0077);
+}
+static int memo_regular_owned(const char *path) {
+    struct stat st;
+    return !lstat(path, &st) && S_ISREG(st.st_mode) &&
+        st.st_uid == getuid() && !(st.st_mode & 0022);
+}
+static int memo_lock(void) {
+    int fd = open(memo_lock_path, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd < 0) return -1;
+    struct stat st;
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != getuid() ||
+        (st.st_mode & 0022) || flock(fd, LOCK_EX)) { close(fd); return -1; }
+    return fd;
+}
+
+/* At shutdown reject mutable/runtime handles without evaluating them. The
+   memoized DFS visits each object once even when many entries share subgraphs.
+   A grey node denotes a cycle, also excluded from the compacted graph. */
+typedef struct memo_visit {
+    struct memo_visit *next;
+    lean_object *object;
+    uint8_t state; /* 1 visiting; 2 immutable; 3 unsupported */
+} memo_visit;
+typedef struct { memo_visit **slots; size_t capacity, count; } memo_walk;
+static memo_visit *memo_visit_get(memo_walk *w, lean_object *object, int *fresh) {
+    if (!w->capacity) {
+        w->capacity = 1024;
+        w->slots = memo_alloc(w->capacity, sizeof(*w->slots));
+    }
+    size_t hash = memo_avalanche((uintptr_t)object);
+    size_t slot = hash & (w->capacity - 1);
+    for (memo_visit *v = w->slots[slot]; v; v = v->next)
+        if (v->object == object) { *fresh = 0; return v; }
+    if (w->count >= w->capacity) {
+        size_t cap = w->capacity * 2;
+        memo_visit **slots = memo_alloc(cap, sizeof(*slots));
+        for (size_t i = 0; i < w->capacity; ++i) {
+            memo_visit *v = w->slots[i];
+            while (v) {
+                memo_visit *next = v->next;
+                size_t j = memo_avalanche((uintptr_t)v->object) & (cap - 1);
+                v->next = slots[j]; slots[j] = v; v = next;
+            }
+        }
+        free(w->slots); w->slots = slots; w->capacity = cap;
+        slot = hash & (cap - 1);
+    }
+    memo_visit *v = memo_alloc(1, sizeof(*v));
+    v->object = object; v->state = 1;
+    v->next = w->slots[slot]; w->slots[slot] = v; ++w->count;
+    *fresh = 1;
+    return v;
+}
+typedef struct {
+    lean_object *object;
+    memo_visit *visit;
+    size_t next, count;
+    uint8_t tag;
