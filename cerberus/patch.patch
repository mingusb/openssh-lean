+/- Generated from the files family FS contracts. Existing libc bodies and Core
+evaluation produce FS operations; this module only admits their resulting
+effect descriptions. It does not intercept symbols or replace a modeled body. -/
+import Core_run
+import CerbHostBoundary
+import CerbHostFilesGuest
+
+namespace CerbHostFilesFS
+open CerbHostFilesGuest CerbHostMemoryCells
+
+/-- statPointee is the actual declared output CType captured before its FS
+builtin discards type information. The memory codec checks its complete layout;
+a tag selected by spelling alone is not an admissible substitute.
+Every admitted operation returns a specified Core integer, including native
+failure -1. FS_WRITE accepts the byte-valued span already read by its interpreted producer. -/
+def decode (statPointee : Option ctype) (operation : fs_oper) :
+    Except Failure Request := do
+  match operation with
+@@FS_CASES@@
+  | _ => .error (.boundary "filesystem effect has no integrated files guest contract")
+
+end CerbHostFilesFS
diff --git a/lean_frontend/host/families/files/guest/templates/files_guest.lean.in b/lean_frontend/host/families/files/guest/templates/files_guest.lean.in
new file mode 100644
index 00000000..36aa27e5
--- /dev/null
+++ b/lean_frontend/host/families/files/guest/templates/files_guest.lean.in
@@ -0,0 +1,494 @@
+/- Generated from files-guest-contracts.json. These codecs load and store the
+actual Cerberus memory model. External symbol/type admission, process isolation,
+descriptor ownership and effect scheduling belong to the shared host driver. -/
+import CerbHostMemoryCells
+import CerbHostFilesAdapters
+
+namespace CerbHostFilesGuest
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+/-- The external ABI gate obtains these from real modeled iovec field loads.
+They are not native addresses or caller-supplied byte snapshots. -/
+structure Span where
+  pointer : PointerValue
+  count : Int
+
+/-- The exact declared pointee CType is checked against every pinned member
+before native execution. Its original pointer/provenance is retained. -/
+structure OutputRecord where
+  pointer : PointerValue
+  recordType : ctype
+
+inductive Request where
+@@REQUESTS@@
+
+private inductive Policy where
+  | zero
+  | signed64
+  | unsigned32
+  | descriptor (closeOnExec : Bool)
+  | close (guest : Int)
+  | fcntl (guest command argument : Int)
+  | read (count : Nat)
+  | write (guest : Int) (input : ByteArray)
+  | metadata (size : Nat) (kinds : List CellKind) (offsets : List Nat)
+  | templateDescriptor (size : Nat)
+  | templatePointer (pointer : PointerValue) (size : Nat)
+  | cwd (pointer : PointerValue) (size : Nat)
+  | pipe
+
+structure Prepared where
+  private mk ::
+  native : CerbHostFilesAdapters.ResolvedRequest
+  modeledErrno : UInt32
+  outputs : PreparedOutputs
+  inputFootprints : List Footprint
+  reservedGuests : List Int
+  private policy : Policy
+
+/-- The process-owned descriptor table applies these changes exactly once,
+atomically with publishing the returned modeled memory. Returned native handles
+remain owned by the runner until that commit completes; boundary errors require
+terminal cleanup, never native replay. -/
+structure Completion where
+  returnValue : Int
+  returnPointer : Option PointerValue := none
+  nativeErrnoAfter : UInt32
+  descriptorTransfers : List (Int × UInt32) := []
+  closeOnExec : List (Int × Bool) := []
+  releasedGuests : List Int := []
+  descriptorFlagUpdates : List (Int × Int) := []
+  /-- Successful F_SETFL requests, not a replacement flag snapshot. The shared
+  open-file-description model must apply Linux mutable bits or defer to native
+  F_GETFL; access-mode and ignored bits are never replaced by the argument. -/
+  statusFlagRequests : List (Int × Int) := []
+  written : Option (Int × ByteArray) := none
+  memory : MemState
+  outputFootprints : List Footprint
+
+private def fail {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+
+private def i32 (number : Int) : Except Failure UInt32 := do
+  if number < -2147483648 || number > 2147483647 then fail "int argument is outside pinned ABI"
+  return (number % 4294967296).toNat.toUInt32
+
+private def u32 (number : Int) : Except Failure UInt32 := do
+  if number < 0 || number > 4294967295 then fail "unsigned int argument is outside pinned ABI"
+  return number.toNat.toUInt32
+
+private def i64 (number : Int) : Except Failure UInt64 := do
+  if number < -9223372036854775808 || number > 9223372036854775807 then
+    fail "signed long argument is outside pinned ABI"
+  return (number % 18446744073709551616).toNat.toUInt64
+
+private def u64 (number : Int) : Except Failure UInt64 := do
+  if number < 0 || number > 18446744073709551615 then fail "size_t argument is outside pinned ABI"
+  return number.toNat.toUInt64
+
+private def count64 (number : Int) : Except Failure UInt64 := do
+  if number < 0 || number > 9223372036854775807 then
+    fail "byte span requires a nonnegative ssize_t-representable extent"
+  return number.toNat.toUInt64
+
+private def sign32 (number : UInt32) : Int :=
+  if number.toNat < 2147483648 then number.toNat else (number.toNat : Int) - 4294967296
+
+private def sign64 (number : UInt64) : Int :=
+  if number.toNat < 9223372036854775808 then number.toNat
+  else (number.toNat : Int) - 18446744073709551616
+
+private def isNull : PointerValue → Bool
+  | .PV _ (.PVnull _) => true
+  | _ => false
+
+private def resolveDescriptor (resolve : Int → Except String UInt32)
+    (allowCwd : Bool) (guest : Int) : Except Failure UInt32 := do
+  let wire ← i32 guest
+  if allowCwd && guest == -100 then return wire
+  -- Every negative native fd is intrinsically invalid, independent of the
+  -- worker table. Nonnegative missing guest bindings remain a boundary error.
+  if guest < 0 then return wire
+  match resolve guest with
+  | .error message => fail message
+  | .ok native =>
+    if native.toNat > 2147483647 then fail "native descriptor binding is outside int domain"
+    return native
+
+private def appendBytes (left right : ByteArray) : ByteArray :=
+  right.data.foldl (fun out byte => out.push byte) left
+
+private def prefixBytes (bytes : ByteArray) (count : Nat) : ByteArray :=
+  ⟨(bytes.data.toList.take count).toArray⟩
+
+/-- Stop at the actual first NUL and retain the model's read footprints. Exhausting
+the caller's semantic fuel is a boundary failure before the native call, never
+ENAMETOOLONG or a guessed string. Byte zero and binary path bytes stay exact. -/
+def readCString [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (pointer : PointerValue) (fuel : Nat) (state : MemState) :
+    Except Failure (ByteArray × List Footprint × MemState) := do
+  let rec loop (remaining index : Nat) (bytes : ByteArray)
+      (reads : List Footprint) (after : MemState) :
+      Except Failure (ByteArray × List Footprint × MemState) := do
+    match remaining with
+    | 0 => fail "pathname reading exhausted supplied semantic fuel before NUL"
+    | remaining + 1 =>
+      let (element, shifted) ← immediate
+        (effArrayShiftPtrval enums tags (CerbLocation.other "host pathname")
+          pointer unsigned_char (.IV .Prov_none (index : Int))) after
+      let (value, footprint, next) ← readInteger enums tags ⟨element, .byte⟩ shifted
+      let bytes := bytes.push value.toNat.toUInt8
+      let reads := footprint :: reads
+      if value == 0 then return (bytes, reads.reverse, next)
+      loop remaining (index + 1) bytes reads next
+  loop fuel 0 ByteArray.empty [] state
+
+/-- Operational pathname loading ends only at a modeled NUL or a model-memory
+failure. The bounded reader above remains available for explicit proof tests. -/
+partial def readCStringUnbounded [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : TagDefs) (pointer : PointerValue)
+    (state : MemState) : Except Failure (ByteArray × List Footprint × MemState) := do
+  let rec loop (index : Nat) (bytes : ByteArray)
+      (reads : List Footprint) (after : MemState) :
+      Except Failure (ByteArray × List Footprint × MemState) := do
+    let (element, shifted) ← immediate
+      (effArrayShiftPtrval enums tags (CerbLocation.other "host pathname")
+        pointer unsigned_char (.IV .Prov_none (index : Int))) after
+    let (value, footprint, next) ← readInteger enums tags ⟨element, .byte⟩ shifted
+    let bytes := bytes.push value.toNat.toUInt8
+    let reads := footprint :: reads
+    if value == 0 then return (bytes, reads.reverse, next)
+    loop (index + 1) bytes reads next
+  loop 0 ByteArray.empty [] state
+
+private def readCStringWithBudget [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : TagDefs) (pointer : PointerValue)
+    (budget : Option Nat) (state : MemState) :
+    Except Failure (ByteArray × List Footprint × MemState) :=
+  match budget with
+  | some fuel => readCString enums tags pointer fuel state
+  | none => readCStringUnbounded enums tags pointer state
+
+/-- Core listFromStr has already loaded these one-byte characters and removed
+the terminating NUL. Preserve that byte domain instead of UTF-8 re-encoding it.
+No guest load or fabricated allocation occurs; earlier read footprints stay in
+the interpreted caller's trace. Embedded NUL cannot arise from listFromStr. -/
+def copiedCString (text : String) : Except Failure ByteArray := do
+  let mut bytes := ByteArray.empty
+  for char in text.toList do
+    if char.toNat == 0 || char.toNat > 255 then
+      fail "copied pathname is not a NUL-free sequence of C bytes"
+    bytes := bytes.push char.toNat.toUInt8
+  return bytes.push 0
+
+private def readOptionalCStringWithBudget [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : TagDefs) (pointer : PointerValue)
+    (budget : Option Nat) (state : MemState) :
+    Except Failure (ByteArray × List Footprint × MemState) :=
+  if isNull pointer then .ok (ByteArray.empty, [], state)
+  else readCStringWithBudget enums tags pointer budget state
+
+private def readTimes [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : TagDefs) (cells : Option (List Cell)) (state : MemState) :
+    Except Failure (Array UInt64 × List Footprint × MemState) := do
+  match cells with
+  | none => return (#[], [], state)
+  | some fields =>
+    if fields.length != 4 || fields.any (fun cell => cell.kind != .signedLong) then
+      fail "timestamps need both exact signed-long fields from both modeled records"
+    let mut words : Array UInt64 := #[]
+    let mut reads := []
+    let mut after := state
+    for cell in fields do
+      let (value, footprint, next) ← readInteger enums tags cell after
+      words := words.push (← i64 value)
+      reads := footprint :: reads
+      after := next
+    return (words, reads.reverse, after)
+
+private inductive FieldShape where
+  | scalar (kind : CellKind)
+  | array (kind : CellKind) (count : Int)
+  | timespec
+
+private def identifierText : identifier → String
+  | .Identifier _ text => text
+
+private def integerTypeIs (kind : CellKind) : ctype → Bool
+  | .Ctype _ (.Basic (.Integer actual)) => actual == kind.ity
+  | _ => false
+
+private def membersOf (tags : TagDefs) (recordType : ctype) :
+    Except Failure (sym × List CerbTagsWf.Member) := do
+  let .Ctype _ (.Struct tag) := recordType | fail "metadata output is not its declared struct"
+  match CerbTagsWf.lookup tags tag with
+  | some (_, .StructDef _ members none) => return (tag, members)
+  | _ => fail "metadata record is missing, flexible or not a struct"
+
+private def checkTimespec [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (recordType : ctype) : Except Failure Unit := do
+  let (tag, members) ← membersOf tags recordType
+  match members with
+  | [(sec, (_, _, qs, ts)), (nsec, (_, _, qn, tn))] =>
+    if identifierText sec != "tv_sec" || identifierText nsec != "tv_nsec" ||
+        !qualifiersEqual qs no_qualifiers || !qualifiersEqual qn no_qualifiers ||
+        !integerTypeIs .signedLong ts || !integerTypeIs .signedLong tn then
+      fail "timespec fields differ from pinned signed-long ABI"
+    let offsets := (bitOffsetsof enums tags tag).map fun (_,_,offset) => offset
+    if offsets != [0,64] || sizeofCtype enums tags recordType != 16 ||
+        alignofCtype enums tags recordType != 8 then
+      fail "timespec layout differs from native representation"
+  | _ => fail "timespec must contain exactly tv_sec and tv_nsec"
+
+private def checkField [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (shape : FieldShape) (actual : ctype) : Except Failure Unit := do
+  match shape with
+  | .scalar kind => if !integerTypeIs kind actual then fail "metadata scalar type mismatch"
+  | .array kind count =>
+    match actual with
+    | .Ctype _ (.Array0 element (some length)) =>
+      if length != count || !integerTypeIs kind element then fail "metadata reserved array type mismatch"
+    | _ => fail "metadata reserved field is not its complete array"
+  | .timespec => checkTimespec enums tags actual
+
+private def statLayout : List (String × Nat × FieldShape) :=
+  [("st_dev",0,.scalar .unsignedLong), ("st_ino",8,.scalar .unsignedLong),
+   ("st_nlink",16,.scalar .unsignedLong), ("st_mode",24,.scalar .unsignedInt),
+   ("st_uid",28,.scalar .unsignedInt), ("st_gid",32,.scalar .unsignedInt),
+   ("__pad0",36,.scalar .signedInt), ("st_rdev",40,.scalar .unsignedLong),
+   ("st_size",48,.scalar .signedLong), ("st_blksize",56,.scalar .signedLong),
+   ("st_blocks",64,.scalar .signedLong), ("st_atim",72,.timespec),
+   ("st_mtim",88,.timespec), ("st_ctim",104,.timespec),
+   ("__glibc_reserved",120,.array .signedLong 3)]
+
+private def statvfsLayout : List (String × Nat × FieldShape) :=
+  [("f_bsize",0,.scalar .unsignedLong), ("f_frsize",8,.scalar .unsignedLong),
+   ("f_blocks",16,.scalar .unsignedLong), ("f_bfree",24,.scalar .unsignedLong),
+   ("f_bavail",32,.scalar .unsignedLong), ("f_files",40,.scalar .unsignedLong),
+   ("f_ffree",48,.scalar .unsignedLong), ("f_favail",56,.scalar .unsignedLong),
+   ("f_fsid",64,.scalar .unsignedLong), ("f_flag",72,.scalar .unsignedLong),
+   ("f_namemax",80,.scalar .unsignedLong), ("f_type",88,.scalar .unsignedInt),
+   ("__f_spare",92,.array .signedInt 5)]
+
+private def metadataCells [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : TagDefs) (filesystem : Bool)
+    (output : OutputRecord) (state : MemState) :
+    Except Failure (List Cell × MemState) := do
+  let (tag, members) ← membersOf tags output.recordType
+  let expected := if filesystem then statvfsLayout else statLayout
+  let size := if filesystem then 112 else 144
+  if members.length != expected.length then fail "metadata complete member count mismatch"
+  -- Check all nested types before invoking layout, which assumes complete tags.
+  for ((name, _, shape), (identifier, (_, _, qualifiers, actual))) in expected.zip members do
+    if identifierText identifier != name || !qualifiersEqual qualifiers no_qualifiers then
+      fail "metadata member identity/qualifiers mismatch"
+    checkField enums tags shape actual
+  if (bitOffsetsof enums tags tag).map (fun (_,_,offset) => offset) !=
+        expected.map (fun (_,offset,_) => offset * 8) ||
+      sizeofCtype enums tags output.recordType != size ||
+      alignofCtype enums tags output.recordType != 8 then
+    fail "modeled metadata layout differs from pinned native record bytes"
+  let (valid, checked) ← immediate
+    (validForDerefPtrval enums tags output.recordType output.pointer) state
+  if !valid then fail "metadata output fails model record lifetime/alignment checks"
+  arrayCells enums tags .byte output.pointer size checked
+
+def descriptorCount : Request → Nat
+@@DESCRIPTOR_COUNTS@@
+
+private def verifyReservations (request : Request) (guests : List Int) : Except Failure Unit := do
+  if guests.length != descriptorCount request || guests.eraseDups.length != guests.length ||
+      guests.any (fun n => n < 0 || n > 2147483647) then
+    fail "descriptor reservation does not match file request"
+
+/-- All input loads finish before output preparation. The private prepared record
+retains the exact resulting memory snapshot. No model action may intervene before
+complete, and no native call may be retried after an error or short result. -/
+private def prepareWithBudget [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (resolve : Int → Except String UInt32) (reserved : List Int)
+    (pathFuel : Option Nat) (errnoPointer : PointerValue) (request : Request) (state : MemState) :
+    Except Failure Prepared := do
+  verifyReservations request reserved
+  let errnoCell : Cell := ⟨errnoPointer, .signedInt⟩
+  let (errnoValue, errnoRead, initial) ← readInteger enums tags errnoCell state
+  let modeledErrno ← i32 errnoValue
+  match request with
+@@PREPARE@@
+
+def prepare [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (resolve : Int → Except String UInt32) (reserved : List Int)
+    (pathFuel : Nat) (errnoPointer : PointerValue) (request : Request) (state : MemState) :
+    Except Failure Prepared :=
+  prepareWithBudget enums tags resolve reserved (some pathFuel) errnoPointer request state
+
+def prepareUnbounded [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (resolve : Int → Except String UInt32) (reserved : List Int)
+    (errnoPointer : PointerValue) (request : Request) (state : MemState) :
+    Except Failure Prepared :=
+  prepareWithBudget enums tags resolve reserved none errnoPointer request state
+
+def executeNative (prepared : Prepared) : BaseIO CerbHostFilesAdapters.FilesResult :=
+  CerbHostFilesAdapters.executeResolved prepared.modeledErrno prepared.native
+
+private def nativeFD (number : Int) : Except Failure UInt32 := do
+  if number < 0 || number > 2147483647 then fail "native descriptor result is outside int domain"
+  return number.toNat.toUInt32
+
+private def noPayload (response : CerbHostFilesAdapters.FilesResult) : Except Failure Unit := do
+  if !response.bytes.isEmpty || !response.fields.isEmpty then fail "scalar native result contains unexpected payload"
+
+private def zeroStatus (value : Int) : Except Failure Unit := do
+  if value != -1 && value != 0 then fail "native status must be zero or minus one"
+
+private def byteWrites (bytes : ByteArray) : List (Option Int) :=
+  bytes.data.toList.map (fun byte => some (byte.toNat : Int))
+
+private def fieldValue (kind : CellKind) (word : UInt64) : Except Failure Int := do
+  let value := match kind with
+    | .signedLong => sign64 word
+    | .signedInt => sign32 word.toUInt32
+    | .signedShort => if word.toNat < 32768 then (word.toNat : Int) else (word.toNat : Int) - 65536
+    | _ => word.toNat
+  if !kind.accepts value then fail "native metadata field does not fit modeled field type"
+  if kind == .signedInt && word.toNat > 4294967295 then fail "native int word is not a 32-bit wire value"
+  return value
+
+private structure Outcome where
+  value : Int
+  pointer : Option PointerValue := none
+  natives : List UInt32 := []
+  closeOnExec : Bool := false
+  released : List Int := []
+  descriptorFlags : List (Int × Int) := []
+  statusFlags : List (Int × Int) := []
+  written : Option (Int × ByteArray) := none
+  writes : List (Option Int) := []
+
+def complete [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (prepared : Prepared) (response : CerbHostFilesAdapters.FilesResult) :
+    Except Failure Completion := do
+  if !response.boundaryError.isEmpty then fail response.boundaryError
+  let value := response.status.value
+  let failed := value == -1
+  if failed && response.status.error == 0 then fail "native failure omitted its error number"
+  if !failed && response.status.error != 0 then fail "native success carries a failure status"
+  let outcome : Outcome ← match prepared.policy with
+  | .zero => do
+    noPayload response
+    zeroStatus value
+    pure { value := value }
+  | .signed64 => do
+    noPayload response
+    let _ ← i64 value
+    pure { value := value }
+  | .unsigned32 => do
+    noPayload response
+    let _ ← u32 value
+    pure { value := value }
+  | .descriptor cloexec => do
+    noPayload response
+    if failed then pure { value := -1 }
+    else
+      match prepared.reservedGuests with
+      | [guest] => pure { value := guest, natives := [← nativeFD value], closeOnExec := cloexec }
+      | _ => fail "descriptor result lost its exact guest reservation"
+  | .close guest => do
+    noPayload response
+    zeroStatus value
+    -- Linux releases the fd before reporting EINTR/EIO/most late failures.
+    -- EBADF is the exception; never retry close or close the native fd again.
+    pure { value := value, released := if response.status.error == 9 then [] else [guest] }
+  | .fcntl guest command argument => do
+    noPayload response
+    if failed then pure { value := -1 }
+    else do
+      let _ ← i32 value
+      if value < 0 then fail "fcntl returned an unexpected negative success"
+      if (command == 2 || command == 4) && value != 0 then fail "fcntl setter must return zero"
+      pure {
+        value := value,
+        descriptorFlags := if command == 2 then [(guest, argument % 2)] else [],
+        statusFlags := if command == 4 then [(guest, argument)] else [] }
+  | .read count => do
+    if !response.fields.isEmpty then fail "byte read returned unexpected scalar fields"
+    if failed then
+      if !response.bytes.isEmpty then fail "failed read returned bytes without a write-mask contract"
+      pure { value := -1, writes := List.replicate count none }
+    else
+      if value < 0 || value > (count : Int) || response.bytes.size != value.toNat then
+        fail "native byte count/payload differs from prepared output capacity"
+      pure { value := value, writes := byteWrites response.bytes ++ List.replicate (count - value.toNat) none }
+  | .write guest input => do
+    noPayload response
+    if failed then pure { value := -1 }
+    else
+      if value < 0 || value > (input.size : Int) then fail "native write count exceeds copied input"
+      pure { value := value, written := some (guest, prefixBytes input value.toNat) }
+  | .metadata size kinds offsets => do
+    zeroStatus value
+    if failed then
+      if !response.fields.isEmpty || !response.bytes.isEmpty then
+        fail "failed metadata call returned unexplained outputs"
+      pure { value := -1, writes := List.replicate size none }
+    else
+      if response.fields.size != kinds.length || response.bytes.size != size ||
+          offsets.length != kinds.length then fail "metadata representation shape mismatch"
+      for ((kind, offset), field) in (kinds.zip offsets).zip response.fields.toList do
+        let mut word : UInt64 := 0
+        for index in List.range kind.width do
+          word := word ||| (response.bytes[offset+index]!.toUInt64 <<< (8*index).toUInt64)
+        let expected ← fieldValue kind field
+        let actual ← fieldValue kind word
+        if expected != actual then fail "native metadata fields disagree with serialized representation"
+      pure { value := value, writes := byteWrites response.bytes }
+
+  | .templateDescriptor size => do
+    if response.bytes.size != size || !response.fields.isEmpty then fail "template mutation has the wrong shape"
+    if failed then pure { value := -1, writes := byteWrites response.bytes }
+    else
+      match prepared.reservedGuests with
+      | [guest] => pure { value := guest, natives := [← nativeFD value], writes := byteWrites response.bytes }
+      | _ => fail "template creation lost guest descriptor reservation"
+  | .templatePointer pointer size => do
+    zeroStatus value
+    if response.bytes.size != size || !response.fields.isEmpty then fail "template mutation has the wrong shape"
+    pure {
+      value := value, pointer := some (if failed then nullPtrval unsigned_char else pointer),
+      writes := byteWrites response.bytes }
+  | .cwd pointer size => do
+    zeroStatus value
+    if failed then fail "getcwd failure needs its native partial-output write-mask contract; do not retry"
+    if !response.fields.isEmpty || response.bytes.isEmpty || response.bytes.size > size ||
+        response.bytes.data.toList.getLast? != some 0 then
+      fail "getcwd output violates prepared capacity or NUL contract"
+    pure {
+      value := value, pointer := some pointer,
+      writes := byteWrites response.bytes ++ List.replicate (size - response.bytes.size) none }
+  | .pipe => do
+    zeroStatus value
+    if !response.bytes.isEmpty then fail "pipe response has unexpected bytes"
+    if failed then
+      if !response.fields.isEmpty then fail "failed pipe returned descriptors"
+      pure { value := -1, writes := [none, none] }
+    else
+      match prepared.reservedGuests, response.fields.toList with
+      | [ga, gb], [na, nb] =>
+        let a ← nativeFD na.toNat
+        let b ← nativeFD nb.toNat
+        if a == b then fail "pipe returned duplicate native descriptors"
+        pure { value := 0, natives := [a,b], writes := [some ga, some gb] }
+      | _, _ => fail "pipe descriptor result/reservation arity is incorrect"
+  if outcome.natives.length != (if failed then 0 else prepared.reservedGuests.length) then
+    fail "returned descriptors do not match pre-effect guest reservations"
+  let (writes, memory) ← commitSelectedOutputs enums tags prepared.outputs
+    (outcome.writes ++ [some (sign32 response.nativeErrnoAfter)])
+  return {
+    returnValue := outcome.value, returnPointer := outcome.pointer,
+    nativeErrnoAfter := response.nativeErrnoAfter,
+    descriptorTransfers := prepared.reservedGuests.zip outcome.natives,
+    closeOnExec := if outcome.natives.isEmpty then []
+      else prepared.reservedGuests.map (fun guest => (guest, outcome.closeOnExec)),
+    releasedGuests := outcome.released, descriptorFlagUpdates := outcome.descriptorFlags,
+    statusFlagRequests := outcome.statusFlags, written := outcome.written,
+    memory := memory, outputFootprints := writes }
+
+end CerbHostFilesGuest
diff --git a/lean_frontend/host/families/files/guest/templates/files_operands.lean.in b/lean_frontend/host/families/files/guest/templates/files_operands.lean.in
new file mode 100644
index 00000000..e434224b
--- /dev/null
+++ b/lean_frontend/host/families/files/guest/templates/files_operands.lean.in
@@ -0,0 +1,83 @@
+/- Generated file-effect operand decoding. Profile selection belongs to the
+runner; neither the Core proxy nor this helper guesses it from flag values. -/
+import CerbHostMemoryCells
+
+namespace CerbHostFilesOperands
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+inductive Profile where
+  | linuxAmd64
+  | cerberusAbstract
+  deriving BEq, Inhabited
+
+private def fail {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+
+private def readDeclaredInteger [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : TagDefs) (type : ctype) (pointer : PointerValue)
+    (expectedWidth : Nat) (state : MemState) :
+    Except Failure (Int × Footprint × MemState) := do
+  let .Ctype _ (.Basic (.Integer expected)) := type |
+    fail "file operand is not an integer object"
+  if sizeofCtype enums tags type != expectedWidth then
+    fail "file operand width differs from its selected ABI"
+  let (valid, checked) ← immediate (validForDerefPtrval enums tags type pointer) state
+  if !valid then fail "file operand pointer fails model lifetime/alignment checks"
+  let ((footprint, value), after) ← immediate
+    (loadM enums tags (CerbLocation.other "file operand") type pointer) checked
+  match value with
+  | .MVinteger actual (.IV _ number) =>
+    if actual != expected then fail "file operand has incompatible stored integer type"
+    return (number, footprint, after)
+  | _ => fail "file operand is unspecified or not a concrete integer"
+
+/-- Native Linux open consumes a promoted int exactly when O_CREAT or the
+complete O_TMPFILE mask is present. The bundled abstract fcntl.h uses O_CREAT32
+and has no O_TMPFILE. Extra variadic objects are untouched when mode is unused. -/
+def needsMode (profile : Profile) (flags : Int) : Except Failure Bool := do
+  if flags < -2147483648 || flags > 2147483647 then fail "open flags exceed signed int"
+  let bits := (flags % 4294967296).toNat.toUInt32
+  return match profile with
+    | .linuxAmd64 => (bits &&& 64) != 0 || (bits &&& 4259840) == 4259840
+    | .cerberusAbstract => (bits &&& 32) != 0
+
+/-- Called only after a profile was explicitly selected. Load just the required
+first promoted integer through its actual declared CType, retain its footprint,
+and convert to the selected mode_t. Extra objects remain unread. -/
+def prepareOpenArgs [LemFuel] [CerbGlobal.Switches]
+    (profile : Profile) (enums : EnumDefs) (tags : TagDefs) (flags : Int)
+    (arguments : List (ctype × PointerValue)) (state : MemState) :
+    Except Failure (Option Int × List Footprint × MemState) := do
+  if !(← needsMode profile flags) then return (none, [], state)
+  let (type, pointer) :: _ := arguments | fail "open requires a missing mode argument"
+  let .Ctype _ (.Basic (.Integer actual)) := type |
+    fail "open mode is not a promoted integer argument"
+  if actual != .Signed .Int_ && actual != .Unsigned .Int_ then
+    fail "open mode does not have the promoted int argument type"
+  let (number, footprint, after) ← readDeclaredInteger enums tags type pointer 4 state
+  if actual == .Signed .Int_ then
+    if number < -2147483648 || number > 2147483647 then fail "open signed mode representation is invalid"
+  else
+    -- glibc consumes int; the signed/unsigned variadic compatibility exception
+    -- only covers a value representable in both types.
+    if number < 0 || number > 2147483647 then
+      fail "open unsigned variadic mode exceeds signed-int compatibility"
+  let modulus := if profile == .linuxAmd64 then 4294967296 else 65536
+  return (some (number % modulus), [footprint], after)
+
+/-- The supplied type must come from the actual lseek declaration. Pinned Linux
+uses signed long; the bundled abstract header uses signed long long. Loading
+either as int, or replacing one CType by the other, loses the original contract. -/
+def readOffsetArgument [LemFuel] [CerbGlobal.Switches]
+    (enums : EnumDefs) (tags : TagDefs) (declared : ctype)
+    (pointer : PointerValue) (state : MemState) :
+    Except Failure (Int × List Footprint × MemState) := do
+  let .Ctype _ (.Basic (.Integer actual)) := declared |
+    fail "lseek offset declaration is not an integer type"
+  if actual != .Signed .Long && actual != .Signed .LongLong then
+    fail "lseek offset does not match an admitted declared off_t"
+  let (number, footprint, after) ← readDeclaredInteger enums tags declared pointer 8 state
+  if number < -9223372036854775808 || number > 9223372036854775807 then
+    fail "lseek offset is outside its signed 64-bit representation"
+  return (number, [footprint], after)
+
+end CerbHostFilesOperands
