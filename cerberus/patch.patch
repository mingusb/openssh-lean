+      (gnu_memory_expression_readonly expr || match node with
+        | A.AilEassign left right ->
+            gnu_loop_direct_lvalue left && gnu_memory_expression_readonly right
+        | A.AilEcompoundAssign left _ right ->
+            gnu_loop_direct_lvalue left && gnu_memory_expression_readonly right
+        | A.AilEunary A.PostfixIncr left -> gnu_loop_direct_lvalue left
+        | A.AilEunary A.PostfixDecr left -> gnu_loop_direct_lvalue left
+        | _ -> false end)
