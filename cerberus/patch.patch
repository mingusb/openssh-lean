+  let ty acc t = gnu_region_scan_type path switch_path acc t in
+  match node with
+    | CabsEident _ -> st
+    | CabsEconst _ -> st
+    | CabsEstring _ -> st
+    | CabsEgeneric e associations -> List.foldl (fun acc association -> match association with
+        | GA_type t value -> expr (ty acc t) value
+        | GA_default value -> expr acc value
+      end) (expr st e) associations
+    | CabsEsubscript a b -> expr (expr st a) b
+    | CabsEcall callee arguments _ -> List.foldl (fun acc e -> expr acc e) (expr st callee) arguments
+    | CabsEmemberof e _ -> expr st e
+    | CabsEmemberofptr e _ -> expr st e
+    | CabsEpostincr e -> expr st e
+    | CabsEpostdecr e -> expr st e
+    | CabsEcompound t items -> List.foldl (fun acc (designators,value) ->
+        let acc = maybe acc (fun ds -> List.foldl (fun acc d -> gnu_region_scan_designator path switch_path acc d) acc ds) designators in
