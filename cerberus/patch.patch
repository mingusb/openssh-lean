+   regions remain on the stack and are restored by the ordinary call return. *)
+val active_region_path: forall 'a. stack 'a -> list Symbol.sym
+let rec active_region_path sk = match sk with
+  | Stack_region region _ rest -> region :: active_region_path rest
+  | _ -> []
+end
