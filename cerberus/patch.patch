+/* GCC 15 AMD64 SysV oracle. This checks the type, not va_start/va_arg. */
+typedef __builtin_va_list args_type;
+typedef __typeof__(((args_type *)0)[0][0]) args_record;
+#define SAME(T,U) _Static_assert(__builtin_types_compatible_p(T,U), #T)
+_Static_assert(sizeof(args_type) == 24, "va_list size");
+_Static_assert(_Alignof(args_type) == 8, "va_list alignment");
+_Static_assert(sizeof(args_type) == sizeof(args_record), "one-element array");
+_Static_assert(__builtin_offsetof(args_record, gp_offset) == 0, "GP offset");
+_Static_assert(__builtin_offsetof(args_record, fp_offset) == 4, "FP offset");
+_Static_assert(__builtin_offsetof(args_record, overflow_arg_area) == 8, "stack area offset");
+_Static_assert(__builtin_offsetof(args_record, reg_save_area) == 16, "register area offset");
+SAME(__typeof__(((args_record *)0)->gp_offset), unsigned int);
+SAME(__typeof__(((args_record *)0)->fp_offset), unsigned int);
+SAME(__typeof__(((args_record *)0)->overflow_arg_area), void *);
+SAME(__typeof__(((args_record *)0)->reg_save_area), void *);
+_Static_assert(!__builtin_types_compatible_p(args_type, args_record *), "array identity");
+struct enclosing { char a; args_type b; char c; };
+_Static_assert(sizeof(struct enclosing) == 40, "enclosing layout");
+
+static int set_offsets(__builtin_va_list arg) {
+    arg[0].gp_offset = 24;
+    arg[0].fp_offset = 80;
+    return 0;
+}
+static int use_same_type(void) {
+    __builtin_va_list local = {{0, 0, 0, 0}};
+    _Static_assert(__builtin_types_compatible_p(__typeof__(local), args_type), "canonical builtin type");
+    set_offsets(local);
+    return local[0].gp_offset == 24 && local[0].fp_offset == 80;
+}
+int main(void) {
+    args_type a = {{0, 0, 0, 0}}, b;
+    int stack = 3, registers = 7;
+    args_type *pointer = &a;
+    set_offsets(a);
+    a[0].overflow_arg_area = &stack;
+    a[0].reg_save_area = &registers;
+    b[0] = a[0];
+    if (b[0].gp_offset != 24 || b[0].fp_offset != 80) return 1;
+    if (b[0].overflow_arg_area != &stack || b[0].reg_save_area != &registers) return 2;
+    if ((*pointer)[0].gp_offset != 24) return 3;
+    if (!use_same_type()) return 4;
+    { typedef int __builtin_va_list; __builtin_va_list shadow = 5;
+      if (sizeof(shadow) != sizeof(int) || shadow != 5) return 5; }
+    return 0;
+}
