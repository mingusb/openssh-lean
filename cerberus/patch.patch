index 00000000..91d57158
--- /dev/null
+++ b/scripts/prepare_gnu_amd64_libc.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""Prepare an explicitly selected physical-va_list libc and matching Lean metadata.
+
+Run only after a coordinated compiler build, with no concurrent source edits.
+This does not install, select, or replace the default integer-cursor library.
+The generated bundle remains an unverified candidate until both engines pass.
+"""
+import argparse
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+TUS = ('ctype', 'stdio', 'stdlib', 'string', 'time', 'utime', 'unistd',
+       'stat', 'uio', 'internal', 'vfscanf', 'signal')
+IMPL = 'gcc_4.9.0_x86_64-apple-darwin10.8.0'
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--repository', type=Path, default=Path(__file__).resolve().parents[1])
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--gnu-pointer-conversions', action='store_true')
+    parser.add_argument('--plan-only', action='store_true')
+    parser.add_argument('--timeout', type=int, default=300,
+                        help='Per-step seconds; 0 waits without a wall-clock deadline')
+    args = parser.parse_args()
+    if args.timeout < 0:
+        parser.error('timeout must be nonnegative (0 disables the wall-clock deadline).')
+    if sys.platform != 'linux':
+        parser.error('Run this bounded preparation inside the coordinated Linux build environment.')
+    repo, out = args.repository.resolve(), args.output.resolve()
+    if out == repo or out.is_relative_to(repo):
+        parser.error('Output must be a fresh directory outside the compiler repository.')
+    out.mkdir(parents=True, exist_ok=False)
+    libc = repo/'runtime/libc'
+    runtime = repo/'_build/install/default'
+    compiler = repo/'_build/default/backend/driver/main.exe'
+    lean = repo/'lean_frontend/.lake/build/bin/cerberus-lean'
+    installed = runtime/'lib/cerberus-lib/runtime'
+    switches = ['--switches=gnu_pointer_conversions'] if args.gnu_pointer_conversions else []
+    cpp = ['--nostdinc', '-I', str(installed/'libc/include'), '-I', str(installed/'libc/include/posix'),
+           '-DCERB_GNU_AMD64_LIBC=1']
+    common = [str(compiler), '--runtime='+str(runtime), '--impl='+IMPL, '--nolibc', *switches]
+    object_path, core = out/'libc_gnu_amd64.co', out/'libc_gnu_amd64.core'
+    sources = [libc/'src'/f'{tu}.c' for tu in TUS]
+    jsons = [out/f'libc_gnu_amd64_{tu}.json' for tu in TUS]
+    headers = sorted((libc/'include').rglob('*.h'))
+    # The existing install rules place Cerberus and CHERI headers in
+    # separate include trees. Resolve that declared mapping for all headers;
+    # never invent a libc/include destination or silently omit an input.
+    install_rules = repo/'runtime/dune'
+    header_pairs = re.findall(r'\((libc/include/[^()\s]+\.h)\s+as\s+(runtime/[^()\s]+\.h)\)',
+                              install_rules.read_text(encoding='utf-8'))
+    header_map = dict(header_pairs)
+    maintained_names = {p.relative_to(repo/'runtime').as_posix() for p in headers}
+    if len(header_map) != len(header_pairs) or set(header_map) != maintained_names:
+        parser.error('Runtime header inventory does not match the declared installation mapping')
+    installed_headers = [installed/Path(header_map[p.relative_to(repo/'runtime').as_posix()]).relative_to('runtime')
+                         for p in headers]
+    inputs = sorted(set(sources + headers + installed_headers + [install_rules] +
+                        [libc/'src/internal.h', repo/'runtime/libcore/std.core',
+                         repo/'runtime/libcore/impls'/f'{IMPL}.impl']))
+    defaults = [repo/'_build/default/runtime/libc/libc.co',
+                repo/'_build/default/runtime/libc/libc_inner_arg_temps.co',
+                runtime/'lib/cerberus/runtime/libc/libc.co']
+    def identities():
+        return {'compiler_sha256':sha(compiler), 'lean_sha256':sha(lean),
+                'inputs':{str(p.relative_to(repo)):sha(p) for p in inputs},
+                'defaults':{str(p.relative_to(repo)):sha(p) if p.exists() else None for p in defaults}}
+    before = identities()
+    steps = [dict(name='library-object', argv=common+cpp+['--sequentialise', '--rewrite',
+                 '-o',str(object_path), *map(str,sources)], output=None),
+             dict(name='library-core', argv=common+['--pp=core','--pp_core_out='+str(core),
+                 str(object_path)], output=None)]
+    steps += [dict(name='metadata-'+tu, argv=common+cpp+['--cabs-json',str(src)],output=str(dst))
+              for tu,src,dst in zip(TUS,sources,jsons)]
+    report = dict(profile='gnu-amd64-physical-va-list', plan_only=args.plan_only,
+                  preparer_sha256=sha(Path(__file__)),
+                  artifacts_prepared=False, engine_verified=False,
+                  build_source_match_verified=False, before=before, steps=steps,
+                  commands={
+                    'ocaml_prefix':common+cpp+['-L',str(out),'-l','c_gnu_amd64'],
+                    'parse_prefix':common+cpp+['--cabs-json'],
+                    'lean_prefix':[str(lean),'--runtime',str(runtime),
+                        *(['--switches','gnu_pointer_conversions'] if switches else []),
+                        '--libc',str(core), *[arg for p in jsons for arg in ('--libc-tu',str(p))]]},
+                  limitations=['No public-name proxy is added; ordinary C definitions and linking remain.',
+                    'Ordinary duplicate strong definitions are linker errors, not silently overridden.',
+                    'The default integer-cursor profile is not rebuilt or installed by this script.',
+                    'FILE layout/buffering/error/locale behavior is not established; only descriptor 1/2 hooks execute.',
+                    'Float/pointer/locale/positional formatting, abort/errno and concurrency remain explicit.',
+                    'The bundle needs current-source build receipts and differential engine checks before publication.'])
+    receipt = out/'profile.json'
+    def save():
+        receipt.write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8')
+    save()
+    if args.plan_only:
+        print(json.dumps({'plan':str(receipt),'steps':len(steps),'executed':False}))
+        return 0
+    # Both interpreters classify library locations against this installed
+    # runtime. Check the actual include inputs instead of rewriting locations
+    # or relaxing Main's exact-directory admission boundary.
+    for maintained, selected in zip(headers, installed_headers):
+        if sha(maintained) != sha(selected):
+            report['error']='Installed header does not match maintained '+str(maintained.relative_to(repo))
+            save()
+            return 1
+    for relative in ['libcore/std.core','libc/include/builtins.h']:
+        if sha(installed/relative) != sha(repo/'runtime'/relative):
+            report['error']='Installed runtime does not match maintained '+relative
+            save()
+            return 1
+    for step in steps:
+        stdout = Path(step['output']) if step['output'] else out/(step['name']+'.stdout')
+        stderr = out/(step['name']+'.stderr')
+        start = time.monotonic()
+        with stdout.open('wb') as so, stderr.open('wb') as se:
+            process = subprocess.Popen(step['argv'],cwd=libc,stdout=so,stderr=se,start_new_session=True)
+            step['pid']=process.pid
+            save()
+            try:
+                code=process.wait(timeout=args.timeout or None)
+                step['timeout']=False
+            except subprocess.TimeoutExpired:
+                os.killpg(process.pid,signal.SIGKILL)
+                code=process.wait()
+                step['timeout']=True
+        step.update(exit_code=code,elapsed_seconds=time.monotonic()-start,
+                    stdout_sha256=sha(stdout),stderr_sha256=sha(stderr),terminal=True)
+        save()
+        if code != 0:
+            print(json.dumps({'failed':step['name'],'receipt':str(receipt)}))
+            return 1
+    for p in jsons:
+        json.loads(p.read_text(encoding='utf-8'))
+    artifacts=[object_path,core,*jsons]
+    if not all(p.exists() and p.stat().st_size > 0 for p in artifacts):
+        report['error']='Missing or empty profile artifact'
+        save()
+        return 1
+    report['after']=identities()
+    report['artifact_sha256']={p.name:sha(p) for p in artifacts}
+    report['artifacts_prepared']=report['before']==report['after']
+    if not report['artifacts_prepared']:
+        report['error']='Compiler, source inputs or default library changed during preparation'
+    save()
+    print(json.dumps({'artifacts_prepared':report['artifacts_prepared'],'engine_verified':False,
+                      'receipt':str(receipt)}))
+    return 0 if report['artifacts_prepared'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
