diff --git a/lean_frontend/host/families/system/generate_system_adapters.py b/lean_frontend/host/families/system/generate_system_adapters.py
new file mode 100644
index 00000000..0bec0066
--- /dev/null
+++ b/lean_frontend/host/families/system/generate_system_adapters.py
@@ -0,0 +1,598 @@
+#!/usr/bin/env python3
+"""Generate system transports from explicit contracts; never infer pointer policy."""
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+
+IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+SCALARS = {"i32":("int32_t","UInt32"),"u32":("uint32_t","UInt32"),
+ "fd":("int32_t","UInt32"),"pid":("int32_t","UInt32"),"wchar":("int32_t","UInt32"),
+ "i64":("int64_t","UInt64"),"u64":("uint64_t","UInt64")}
+SHAPES = {"scalar","output_bytes","string_result","account","groups_out","groups_in",
+ "grouplist","clock","timeofday","time","rlimit_get","rlimit_set","uname",
+ "termios_get","termios_set","termios_speed_get","termios_speed_set","sigset_init",
+ "sigset_add","nanosleep","file_open","file_close","file_scalar","file_write","file_getline","file_setvbuf_null"}
+ERRORS = {"never","minus_one_errno","zero_errno","nonzero_errno",
+ "minus_one_maybe_errno","null_maybe_errno","minus_one_no_errno"}
+
+HELPERS = r"""
+/* This entry is the external libc API, not a fortified inline expansion.
+   Negative int size is a valid failing libc request; access annotations on the
+   glibc fortified wrapper cannot describe it. Original interpreted fortified
+   calls keep their own checks before reaching an external adapter. */
+extern int cerb_system_getgroups_libc(int, gid_t *) __asm__("getgroups");
+/* Exact installed glibc helper used by its own fgets implementation.
+   Versioned binding prevents resolution to an unversioned replacement. */
+extern size_t cerb_system_glibc_getline(FILE *,char *,size_t,int,int);
+__asm__(".symver cerb_system_glibc_getline,_IO_getline@GLIBC_2.2.5");
+_Static_assert(__GLIBC__==2 && __GLIBC_MINOR__==43,"pinned glibc fgets contract");
+_Static_assert(offsetof(FILE,_flags)==0 && _IO_ERR_SEEN==0x20 &&
+    _IO_USER_LOCK==0x8000,"pinned FILE flags");
+
+static pid_t cerb_system_worker_pid;
+/* Driver calls this only after establishing its dedicated interpreted-process
+   worker. The check invalidates inherited authorization in a forked child.
+   This does not create a worker, clone guest state or install a signal driver. */
+int cerb_system_enable_worker(int32_t expected_pid) {
+    if (expected_pid <= 0 || getpid() != expected_pid) return 0;
+    cerb_system_worker_pid = getpid();
+    return 1;
+}
+static int worker_ready(void) {
+    return cerb_system_worker_pid > 0 && getpid() == cerb_system_worker_pid;
+}
+
+struct cerb_system_file_reservation {
+    uint64_t token;
+    FILE *stream;
+    int kind;
+    struct cerb_system_file_reservation *next;
+};
+static cerb_system_file_reservation *file_registry;
+static uint64_t next_file_token=1;
+int cerb_system_worker_ready(void) { return worker_ready(); }
+cerb_system_file_reservation *cerb_system_file_reserve(void) {
+    if(!worker_ready() || !next_file_token) return NULL;
+    cerb_system_file_reservation *entry=calloc(1,sizeof *entry);
+    if(!entry) return NULL;
+    entry->token=next_file_token++;
+    return entry;
+}
+void cerb_system_file_cancel(cerb_system_file_reservation *entry) {
+    free(entry);
+}
+uint64_t cerb_system_file_commit(cerb_system_file_reservation *entry,FILE *stream,int kind) {
+    entry->stream=stream; entry->kind=kind;
+    entry->next=file_registry; file_registry=entry;
+    return entry->token;
+}
+static cerb_system_file_reservation *file_entry(uint64_t token) {
+    if(!worker_ready() || !token) return NULL;
+    for(cerb_system_file_reservation *p=file_registry;p;p=p->next)
+        if(p->token==token) return p;
+    return NULL;
+}
+FILE *cerb_system_file_lookup(uint64_t token) {
+    cerb_system_file_reservation *entry=file_entry(token);
+    return entry ? entry->stream : NULL;
+}
+int cerb_system_file_forget(uint64_t token) {
+    if(!worker_ready() || !token) return 0;
+    cerb_system_file_reservation **p=&file_registry;
+    while(*p) {
+        if((*p)->token==token) {
+            cerb_system_file_reservation *old=*p; *p=old->next; free(old); return 1;
+        }
+        p=&(*p)->next;
+    }
+    return 0;
+}
+static cerb_system_result empty_result(void) {
+    cerb_system_result r;
+    memset(&r, 0, sizeof r);
+    return r;
+}
+static cerb_system_result boundary(const char *why) {
+    cerb_system_result r = empty_result();
+    r.boundary_error = why;
+    return r;
+}
+void cerb_system_dispose(cerb_system_result *r) {
+    free(r->bytes);
+    r->bytes = NULL;
+    r->bytes_count = 0;
+}
+static int exact_string(const unsigned char *p, size_t n, int nullable) {
+    if (!n) return nullable;
+    return p && p[n-1] == 0 && !memchr(p, 0, n-1);
+}
+static cerb_system_result boundary_saved(const char *why,int saved_errno) {
+    errno=saved_errno;
+    return boundary(why);
+}
+static void status(cerb_system_result *r, int64_t value, uint32_t error) {
