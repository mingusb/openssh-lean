+val gnu_constant_truth: Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> maybe bool
+let rec gnu_constant_truth tagDefs (A.AnnotatedExpression _ _ _ expr) =
+  match expr with
+    | A.AilEconst (A.ConstantInteger (A.IConstant n _ _)) -> Just (n <> 0)
+    | A.AilEconst (A.ConstantPredefined A.PConstantFalse) -> Just false
+    | A.AilEconst (A.ConstantPredefined A.PConstantTrue) -> Just true
+    | A.AilEconst (A.ConstantPredefined A.PConstantNullptr) -> Just false
+    | A.AilEconst A.ConstantNull -> Just false
+    | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident _)) -> Just true
+    | A.AilEfunction_decay (A.AnnotatedExpression _ _ _ (A.AilEident _)) -> Just true
+    | A.AilEarray_decay (A.AnnotatedExpression _ _ _ (A.AilEident _)) -> Just true
+    | A.AilEarray_decay (A.AnnotatedExpression _ _ _ (A.AilEstr _)) -> Just true
+    | A.AilEsizeof _ ty -> gnu_sizeof_truth tagDefs ty
+    | A.AilEsizeof_expr e -> gnu_sizeof_truth tagDefs (ctype_of e)
+    | A.AilEannot _ e -> gnu_constant_truth tagDefs e
+    | A.AilEunary A.Plus e -> gnu_constant_truth tagDefs e
+    | A.AilEunary A.Minus e -> gnu_constant_truth tagDefs e
+    | A.AilEcast _ ty e ->
+        if ty = ctype_of e then gnu_constant_truth tagDefs e else Nothing
+    | _ -> Nothing
+  end
