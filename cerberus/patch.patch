diff --git a/lean_frontend/CerbAutoSummary.lean b/lean_frontend/CerbAutoSummary.lean
new file mode 100644
index 00000000..7f59ad02
--- /dev/null
+++ b/lean_frontend/CerbAutoSummary.lean
@@ -0,0 +1,252 @@
+import CerbCoreQuote
+import CerbMemoPass
+
+set_option cerbMemo.enabled false
+
+set_option autoImplicit false
+
+namespace CerbAutoSummary
+
+/-- Classifications of Core syntax, not execution or reachability results. -/
+inductive Kind where
+  | pureCall | coreCall | cCall
+  | pureBranch | effectBranch | pureMemoryOperation
+  | memoryOperation | memoryAction | memoryPrimitive
+  | undefinedNode | staticErrorNode | bmcAssume
+  | unsequenced | nondeterministic | parallel | wait
+  | weakSequence | strongSequence | save | run
+  | externalDeclaration | builtinDeclaration
+  | implementationConstant | functionPointerFormation | constrainedValue
+  deriving BEq, DecidableEq, Repr, Lean.ToExpr
+
+/-- The named and expression targets remain exact Core values. -/
+structure Event where
+  kind : Kind
+  namedTarget : Option (generic_name sym) := none
+  cTarget : Option (generic_pexpr Unit sym) := none
+  /-- Exact reason and location for an explicit PEundef node. -/
+  undefinedReason : Option undefined_behaviour := none
+  undefinedLocation : Option CerbLocation.Loc := none
+  deriving Lean.ToExpr
+
+private def event (kind : Kind) : Event := { kind }
+private def named (kind : Kind) (target : generic_name sym) : Event :=
+  { kind, namedTarget := some target }
+private def ccall (target : generic_pexpr Unit sym) : Event :=
+  { kind := .cCall, cTarget := some target }
+
+mutual
+private def pure (term : generic_pexpr Unit sym) : List Event :=
+  match term with
+  | .Pexpr _ _ node => pureNode node
+
+private def pureNode (node : generic_pexpr_ Unit sym) : List Event :=
+  match node with
+  | .PEsym _ | .PEval _ => []
+  | .PEimpl _ => [event .implementationConstant]
+  | .PEconstrained alternatives =>
+    event .constrainedValue :: pureConstrained alternatives
+  | .PEundef loc reason =>
+    [{ kind := .undefinedNode, undefinedReason := some reason,
+       undefinedLocation := some loc }]
+  | .PEerror _ p => event .staticErrorNode :: pure p
+  | .PEctor _ args => pureList args
+  | .PEcase subject branches =>
+    event .pureBranch :: (pure subject ++ pureBranches branches)
+  | .PEarray_shift a _ b => pure a ++ pure b
+  | .PEmember_shift p _ _ => pure p
+  | .PEmemop _ args => event .pureMemoryOperation :: pureList args
+  | .PEnot p => pure p
+  | .PEop _ a b => pure a ++ pure b
+  | .PEconv_int _ p => pure p
+  | .PEwrapI _ _ a b | .PEcatch_exceptional_condition _ _ a b =>
+    pure a ++ pure b
+  | .PEstruct _ fields => pureFields fields
+  | .PEunion _ _ p => pure p
+  | .PEcfunction p => event .functionPointerFormation :: pure p
+  | .PEmemberof _ _ p => pure p
+  | .PEcall target args => named .pureCall target :: pureList args
+  | .PElet _ value body => pure value ++ pure body
+  | .PEif condition yes no =>
+    event .pureBranch :: (pure condition ++ pure yes ++ pure no)
+  | .PEis_scalar p | .PEis_integer p | .PEis_signed p
+  | .PEis_unsigned p => pure p
+  | .PEbmc_assume p => event .bmcAssume :: pure p
+  | .PEare_compatible a b | .PEare_compatible_parameter a b =>
+    pure a ++ pure b
+
+private def pureList (terms : List (generic_pexpr Unit sym)) : List Event :=
+  match terms with
+  | [] => []
+  | p :: rest => pure p ++ pureList rest
+
+private def pureConstrained
+    (terms : List (mem_iv_constraint × generic_pexpr Unit sym)) : List Event :=
+  match terms with
+  | [] => []
+  | (_, p) :: rest => pure p ++ pureConstrained rest
+
+private def pureBranches
+    (terms : List (generic_pattern sym × generic_pexpr Unit sym)) : List Event :=
+  match terms with
+  | [] => []
+  | (_, p) :: rest => pure p ++ pureBranches rest
+
+private def pureFields
+    (terms : List (identifier × generic_pexpr Unit sym)) : List Event :=
+  match terms with
+  | [] => []
+  | (_, p) :: rest => pure p ++ pureFields rest
+end
+
+private def actionKind : generic_action_ Unit sym → Kind
+  | .Create .. | .CreateReadOnly .. | .Alloc0 .. | .Kill ..
+  | .Store0 .. | .Load0 .. | .SeqRMW .. | .RMW0 ..
+  | .Fence0 .. | .CompareExchangeStrong .. | .CompareExchangeWeak ..
+  | .LinuxFence .. | .LinuxLoad .. | .LinuxStore .. | .LinuxRMW .. =>
+    .memoryPrimitive
+
+private def actionArgs : generic_action_ Unit sym → List Event
+  | .Create a b _ | .Alloc0 a b _ => pure a ++ pure b
+  | .CreateReadOnly a b c _ => pure a ++ pure b ++ pure c
+  | .Kill _ p => pure p
+  | .Store0 _ a b c _ | .LinuxStore a b c _ =>
+    pure a ++ pure b ++ pure c
+  | .Load0 a b _ | .LinuxLoad a b _ => pure a ++ pure b
+  | .SeqRMW _ a b _ c => pure a ++ pure b ++ pure c
+  | .RMW0 a b c d _ _ | .CompareExchangeStrong a b c d _ _
+  | .CompareExchangeWeak a b c d _ _ =>
+    pure a ++ pure b ++ pure c ++ pure d
+  | .Fence0 _ | .LinuxFence _ => []
+  | .LinuxRMW a b c _ => pure a ++ pure b ++ pure c
+
+private def actionEvents (a : generic_action Unit Unit sym) : List Event :=
+  match a with
+  | .Action _ _ node => event (actionKind node) :: actionArgs node
+
+private def polarizedActionEvents (p : generic_paction Unit Unit sym) : List Event :=
+  match p with
+  | .Paction _ a => actionEvents a
+
+mutual
+private def effect (term : generic_expr Unit Unit sym) : List Event :=
+  match term with
+  | .Expr _ node => effectNode node
+
+private def effectNode (node : generic_expr_ Unit Unit sym) : List Event :=
+  match node with
+  | .Epure p => pure p
+  | .Ememop _ args => event .memoryOperation :: pureList args
+  | .Eaction a => event .memoryAction :: polarizedActionEvents a
+  | .Ecase subject branches =>
+    event .effectBranch :: (pure subject ++ effectBranches branches)
+  | .Elet _ value body => pure value ++ effect body
+  | .Eif condition yes no =>
+    event .effectBranch :: (pure condition ++ effect yes ++ effect no)
+  | .Eccall _ ty callee args =>
+    ccall callee :: (pure ty ++ pure callee ++ pureList args)
+  | .Eproc _ target args => named .coreCall target :: pureList args
+  | .Eunseq bodies => event .unsequenced :: effectList bodies
+  | .Ewseq _ first second =>
+    event .weakSequence :: (effect first ++ effect second)
+  | .Esseq _ first second =>
+    event .strongSequence :: (effect first ++ effect second)
+  | .Ebound body | .Eindivisible _ body | .Eannot _ body => effect body
+  | .End bodies => event .nondeterministic :: effectList bodies
+  | .Esave _ saved body =>
+    event .save :: (savedInitializers saved ++ effect body)
+  | .Erun _ _ args => event .run :: pureList args
+  | .Epar bodies => event .parallel :: effectList bodies
+  | .Ewait _ => [event .wait]
+  | .Eexcluded _ a => event .memoryAction :: actionEvents a
+
+private def effectList (terms : List (generic_expr Unit Unit sym)) : List Event :=
+  match terms with
+  | [] => []
+  | e :: rest => effect e ++ effectList rest
+
+private def effectBranches
+    (terms : List (generic_pattern sym × generic_expr Unit Unit sym)) : List Event :=
+  match terms with
+  | [] => []
+  | (_, e) :: rest => effect e ++ effectBranches rest
+
+private def savedInitializers
+    (terms : List (sym × ((core_base_type × Option (ctype × pass_by_value_or_pointer)) ×
+      generic_pexpr Unit sym))) : List Event :=
+  match terms with
+  | [] => []
+  | (_, (_, initial)) :: rest => pure initial ++ savedInitializers rest
+end
+
+/-- Total transparent summary of one imported Core function declaration. -/
+def summarizeDecl (body : generic_fun_map_decl Unit Unit) : List Event :=
+  match body with
+  | .Fun _ _ p => pure p
+  | .Proc _ _ _ _ e => effect e
+  | .ProcDecl _ _ _ => [event .externalDeclaration]
+  | .BuiltinDecl _ _ _ => [event .builtinDeclaration]
+
+/-- Traverse the implementation-constant bodies in the linked Core file. -/
+def summarizeImpl (body : generic_impl_decl Unit) : List Event :=
+  match body with
+  | .Def _ p | .IFun _ _ p => pure p
+
+/-- Traverse every global initializer; declarations contain no expression. -/
+def summarizeGlobal (body : generic_globs Unit Unit) : List Event :=
+  match body with
+  | .GlobalDef _ e => effect e
+  | .GlobalDecl _ => []
+
+inductive ObligationKind where
+  | resolveCall | defineEffect | checkBranch | investigateUndefined
+  | defineScheduling | defineControlTransfer | provideDeclaration
+  deriving BEq, DecidableEq, Repr, Lean.ToExpr
+
+structure Obligation where
+  siteOrdinal : Nat
+  kind : ObligationKind
+  deriving BEq, DecidableEq, Repr, Lean.ToExpr
+
+def obligationKind : Kind → ObligationKind
+  | .pureCall | .coreCall | .cCall => .resolveCall
+  | .pureMemoryOperation | .memoryOperation | .memoryAction
+  | .memoryPrimitive => .defineEffect
+  | .pureBranch | .effectBranch | .bmcAssume => .checkBranch
+  | .undefinedNode | .staticErrorNode => .investigateUndefined
+  | .unsequenced | .nondeterministic | .parallel | .wait
+  | .weakSequence | .strongSequence => .defineScheduling
+  | .save | .run => .defineControlTransfer
+  | .externalDeclaration | .builtinDeclaration
+  | .implementationConstant | .functionPointerFormation
+  | .constrainedValue => .provideDeclaration
+
+/-- Requests generated from every recorded site; none is automatically proved. -/
+def obligationsFromSummary (summary : List Event) : List Obligation :=
+  summary.zipIdx.map fun (e, ordinal) =>
+    { siteOrdinal := ordinal, kind := obligationKind e.kind }
+
+def obligations (body : generic_fun_map_decl Unit Unit) : List Obligation :=
+  obligationsFromSummary (summarizeDecl body)
+
+def SummaryMatches (body : generic_fun_map_decl Unit Unit)
+    (expected : List Event) : Prop :=
+  summarizeDecl body = expected
+
+/-- This is syntax-only and does not imply freedom from runtime UB. -/
+def HasNoExplicitUndefinedNode (body : generic_fun_map_decl Unit Unit) : Prop :=
+  ∀ e ∈ summarizeDecl body, e.kind ≠ .undefinedNode
+
+private def valueNode : generic_pexpr Unit sym :=
+  .Pexpr [] () (.PEval .Vtrue)
+
+private def branchBody : generic_fun_map_decl Unit Unit :=
+  .Fun default [] (.Pexpr [] () (.PEif valueNode valueNode valueNode))
+
+example : (summarizeDecl branchBody).length = 1 := by rfl
+example : (obligations branchBody).length = 1 := by rfl
+example : HasNoExplicitUndefinedNode branchBody := by
+  simp [HasNoExplicitUndefinedNode, summarizeDecl, branchBody, pure,
+    pureNode, valueNode, event]
+
+end CerbAutoSummary
diff --git a/lean_frontend/CerbBoundaryCensus.lean b/lean_frontend/CerbBoundaryCensus.lean
new file mode 100644
index 00000000..7bfbf2c7
--- /dev/null
+++ b/lean_frontend/CerbBoundaryCensus.lean
@@ -0,0 +1,467 @@
+import Core
+import Core_linking
+import Lean
+
+set_option autoImplicit false
+
+/-! Constructor census of the actual linked Core AST. This is conservative
+    reference evidence, not reachability, adapter implementation, or equivalence.
+    Unused declarations are excluded; every supplied body is traversed.
+    Keep patterns exhaustive when Core gains a constructor. -/
+namespace CerbBoundaryCensus
+
+private def sameSym (a b : sym) : Bool :=
+  Lem_Basic_classes.ordCompare a b == .EQ
+
+private def lookup {α : Type} (s : sym) (m : Fmap sym α) : Option α :=
+  fmapLookupBy (fun a b => Lem_Basic_classes.ordCompare a b) s m
+
+private def symbolName : sym → String
+  | .Symbol _ n desc => match desc with
+    | .SD_Id name | .SD_ObjectAddress name | .SD_FunArgValue name
+    | .SD_CN_Id name => name
+    | _ => s!"anonymous-{n}"
+
+private def symbolKey : sym → String
+  | .Symbol digest n _ => s!"{digest}:{n}"
+
+structure Reference where
+  owner : String
+  ownerKind : String
+  location : String
+  kind : String
+  target : Option String := none
+  targetKey : Option String := none
+  resolvedKey : Option String := none
+  disposition : String
+  detail : String := ""
+  deriving Inhabited, Lean.ToJson
+
+structure Context where
+  program : file Unit
+  aliases : Fmap sym sym
+  owner : String
+  ownerKind : String
+  bound : List sym := []
+  selected : Option (List sym) := none
+
+private structure SymbolEvidence where
+  resolved : sym
+  names : List String
+  disposition : String
+
+private structure CollectState where
+  rows : Array Reference := #[]
+  evidence : Fmap sym SymbolEvidence := fmapEmpty
+
+private abbrev Collect := StateM CollectState
+
+private def emit (ctx : Context) (location kind disposition : String)
+    (detail : String := "") : Collect Unit :=
+  modify fun state => { state with rows := state.rows.push {
+    owner := ctx.owner
+    ownerKind := ctx.ownerKind
+    location := location
+    kind := kind
+    disposition := disposition
+    detail := detail } }
+
+private def resolve (ctx : Context) (s : sym) : sym :=
+  (lookup s ctx.aliases).getD s
+
+private def declaration (ctx : Context) (s : sym) : Option (fun_map_decl Unit) :=
+  match lookup s ctx.program.funs with
+  | some d => some d
+  | none => lookup s ctx.program.stdlib
+
+private def globalDecl (ctx : Context) (s : sym) : Option (generic_globs Unit Unit) :=
+  (ctx.program.globs.find? fun entry => sameSym entry.1 s).map Prod.snd
+
+private def externNames (ctx : Context) (s : sym) : List String :=
+  (fmapElements ctx.program.extern).filterMap fun (ident, (decls, lk)) =>
+    let owns := decls.any (sameSym s) || match lk with
+      | .LK_none => false
+      | .LK_tentative defn | .LK_normal defn => sameSym s defn
+    if owns then
+      let .Identifier _ name := ident
+      some name
+    else none
+
+private def inSelectedScope (ctx : Context) (s : sym) : Bool :=
+  match ctx.selected with
+  | none => true
+  | some selected => selected.any (sameSym s)
+
+private def symbolDisposition (ctx : Context) (resolved : sym)
+    (names : List String) : String :=
+  match declaration ctx resolved with
+  | some (.Fun _ _ _) | some (.Proc _ _ _ _ _) =>
+    if inSelectedScope ctx resolved then "supplied-interpreted-body"
+    else "translated-body-outside-selected-slice"
+  | some (.ProcDecl _ _ _) => "external-procedure-declaration"
+  | some (.BuiltinDecl _ _ _) => "builtin-dispatch-obligation"
+  | none => match globalDecl ctx resolved with
+    | some (.GlobalDef _ _) =>
+      if inSelectedScope ctx resolved then "supplied-global-definition"
+      else "translated-global-outside-selected-slice"
+    | some (.GlobalDecl _) => "external-data-declaration"
+    | none =>
+      if (lookup resolved ctx.program.funinfo).isSome then "function-metadata-without-body"
+      else if !names.isEmpty then "external-symbol-without-body"
+      else "unclassified-symbol"
+
+/-- Reference classifications depend on the symbol and the fixed linked
+program, not on which syntax node mentions it. Cache that shared lookup once
+per collection; the emitted row still retains each exact location and kind. -/
+private def symbolEvidence (ctx : Context) (s : sym) : Collect SymbolEvidence := do
+  let state ← get
+  if let some known := lookup s state.evidence then
+    return known
+  let resolved := resolve ctx s
+  let names := externNames ctx s
+  let result : SymbolEvidence := {
+    resolved, names, disposition := symbolDisposition ctx resolved names
+  }
+  modify fun state => { state with
+    evidence := fmapAddBy (fun a b => Lem_Basic_classes.ordCompare a b)
+      s result state.evidence }
+  return result
+
+private def emitSym (ctx : Context) (location kind : String) (s : sym) : Collect Unit := do
+  let known ← symbolEvidence ctx s
+  modify fun state => { state with rows := state.rows.push {
+    owner := ctx.owner
+    ownerKind := ctx.ownerKind
+    location := location
+    kind := kind
+    target := some (symbolName s)
+    targetKey := some (symbolKey s)
+    resolvedKey := some (symbolKey known.resolved)
+    disposition := known.disposition
+    detail := String.intercalate "," known.names } }
+  if known.names.any (fun name => name == "dlsym" || name == "dlopen") ||
+      symbolName s == "dlsym" || symbolName s == "dlopen" then
+    emit ctx location "dynamic-provider" "unclosed-dynamic-targets" (symbolName s)
+
+private def locationOf (annots : List annot) : String :=
+  CerbLocation.stringFromLocation (get_loc_ annots)
+
+private partial def bindings : pattern → List sym
+  | .Pattern _ (.CaseBase (some s, _)) => [s]
+  | .Pattern _ (.CaseBase (none, _)) => []
+  | .Pattern _ (.CaseCtor _ ps) => ps.flatMap bindings
+
+private def bindPattern (ctx : Context) (pat : pattern) : Context :=
+  { ctx with bound := bindings pat ++ ctx.bound }
+
+private def pointerSymbol : CerbMem.PointerValue → Option sym
+  | .PV _ (.PVfunction s) => some s
+  | .PV _ (.PVnull _) | .PV _ (.PVconcrete _ _) => none
+
+private def valuePointer : value → Option sym
+  | .Vobject (.OVpointer p) | .Vloaded (.LVspecified (.OVpointer p)) => pointerSymbol p
+  | _ => none
+
+/-- Only syntactically fixed function-address forms are recognized. A local
+    pointer variable, branch, load or integer conversion remains indirect. -/
+private def fixedCallee (ctx : Context) : pexpr → Option sym
+  | .Pexpr _ _ (.PEcfunction (.Pexpr _ _ (.PEsym s))) =>
+      if ctx.bound.any (sameSym s) then none else some s
+  | .Pexpr _ _ (.PEval v) => valuePointer v
+  | _ => none
+
+private partial def memoryValue (ctx : Context) (loc : String) : CerbMem.MemValue → Collect Unit
+  | .MVunspecified _ | .MVinteger _ _ | .MVfloating _ _ => pure ()
+  | .MVpointer _ pv => match pointerSymbol pv with
+      | some s => emitSym ctx loc "embedded-function-address" s
+      | none => emit ctx loc "embedded-object-pointer" "pointer-value-not-a-named-symbol"
+  | .MVarray values => values.forM (memoryValue ctx loc)
+  | .MVstruct _ fields => fields.forM fun (_, _, v) => memoryValue ctx loc v
+  | .MVunion _ _ v => memoryValue ctx loc v
+
+mutual
+private partial def objectValue (ctx : Context) (loc : String) : object_value → Collect Unit
+  | .OVinteger _ | .OVfloating _ => pure ()
+  | .OVpointer pv => match pointerSymbol pv with
+      | some s => emitSym ctx loc "function-address" s
+      | none => pure ()
+  | .OVarray values => values.forM (loadedValue ctx loc)
+  | .OVstruct _ fields => fields.forM fun (_, _, v) => memoryValue ctx loc v
+  | .OVunion _ _ v => memoryValue ctx loc v
+private partial def loadedValue (ctx : Context) (loc : String) : loaded_value → Collect Unit
+  | .LVspecified v => objectValue ctx loc v
+  | .LVunspecified _ => pure ()
+end
+
+private partial def coreValue (ctx : Context) (loc : String) : value → Collect Unit
+  | .Vobject v => objectValue ctx loc v
+  | .Vloaded v => loadedValue ctx loc v
+  | .Vunit | .Vtrue | .Vfalse | .Vctype _ => pure ()
+  | .Vlist _ values | .Vtuple values => values.forM (coreValue ctx loc)
+
+private def namedCall (ctx : Context) (loc kind : String) : name → Collect Unit
+  | .Sym s => emitSym ctx loc kind s
+  | .Impl c => emit ctx loc "implementation-call" "implementation-body-reviewed-separately"
+      (toString (string_of_implementation_constant c))
+
+private def pureMemopName : pure_memop → String
+  | .DeriveCap _ _ => "DeriveCap"
+  | .CapAssignValue => "CapAssignValue"
+  | .Ptr_tIntValue => "Ptr_tIntValue"
+  | .ByteFromInt => "ByteFromInt"
+  | .IntFromByte => "IntFromByte"
+
+private def constructorName : ctor → String
+  | .Cnil _ => "Cnil"
+  | .Ccons => "Ccons"
+  | .Ctuple => "Ctuple"
+  | .Carray => "Carray"
+  | .Cinstantiate_type _ => "Cinstantiate_type"
+  | .Cptr_array_shift => "Cptr_array_shift"
+  | .Cnull_pointer => "Cnull_pointer"
+  | .Civmax => "Civmax"
+  | .Civmin => "Civmin"
+  | .Civsizeof => "Civsizeof"
+  | .Civalignof => "Civalignof"
+  | .CivCOMPL => "CivCOMPL"
+  | .CivAND => "CivAND"
+  | .CivOR => "CivOR"
+  | .CivXOR => "CivXOR"
+  | .Cspecified => "Cspecified"
+  | .Cunspecified => "Cunspecified"
+  | .Cfvfromint => "Cfvfromint"
+  | .Cfvfromint_typed => "Cfvfromint_typed"
+  | .Cfvnegate => "Cfvnegate"
+  | .Cfvconvert => "Cfvconvert"
+  | .Cfvfrombits => "Cfvfrombits"
+  | .Civfromfloat => "Civfromfloat"
+  | .CivNULLcap _ => "CivNULLcap"
+
+private partial def pureExpr (ctx : Context) : pexpr → Collect Unit
+  | .Pexpr annots _ node => do
+    let loc := locationOf annots
+    let visit := pureExpr ctx
+    match node with
+    | .PEsym s =>
+      unless ctx.bound.any (sameSym s) do emitSym ctx loc "symbol-reference" s
+    | .PEimpl _ => emit ctx loc "implementation-constant" "implementation-definition-obligation"
+    | .PEval v => coreValue ctx loc v
+    | .PEconstrained alternatives => alternatives.forM fun (_, p) => visit p
+    | .PEundef _ _ => emit ctx loc "undefined-behavior-node" "not-host-adapter"
+    | .PEerror message p => emit ctx loc "static-error-node" "explicit-error" message; visit p
+    | .PEctor constructor args =>
+      emit ctx loc "core-constructor" "model-constructor-domain-obligation" (constructorName constructor)
+      args.forM visit
+    | .PEcase subject alternatives =>
+      visit subject
+      alternatives.forM fun (pat, body) => pureExpr (bindPattern ctx pat) body
+    | .PEarray_shift a _ b | .PEop _ a b | .PEwrapI _ _ a b
+    | .PEcatch_exceptional_condition _ _ a b
+    | .PEare_compatible a b | .PEare_compatible_parameter a b => visit a; visit b
+    | .PEmember_shift p _ _ | .PEnot p | .PEconv_int _ p
+    | .PEunion _ _ p | .PEmemberof _ _ p | .PEis_scalar p
+    | .PEis_integer p | .PEis_signed p | .PEis_unsigned p => visit p
+    | .PEmemop op args =>
+      emit ctx loc "pure-memory-effect" "model-effect-domain-obligation" (pureMemopName op)
+      args.forM visit
+    | .PEstruct _ fields => fields.forM fun (_, p) => visit p
+    | .PEcfunction p =>
+      match p with
+      | .Pexpr _ _ (.PEsym s) =>
+          if ctx.bound.any (sameSym s) then
+            emit ctx loc "function-address-expression" "unresolved-function-pointer"
+          else emitSym ctx loc "function-address-expression" s
+      | _ => emit ctx loc "function-address-expression" "unresolved-function-pointer"
+      visit p
+    | .PEcall callee args => namedCall ctx loc "pure-call" callee; args.forM visit
+    | .PElet pat value body => visit value; pureExpr (bindPattern ctx pat) body
+    | .PEif condition yes no => visit condition; visit yes; visit no
+    | .PEbmc_assume p => emit ctx loc "bmc-assumption" "analysis-assumption-obligation"; visit p
+
+private def memoryAction (ctx : Context) : action0 Unit → Collect Unit
+  | .Action location _ node => do
+    let loc := CerbLocation.stringFromLocation location
+    let visit := pureExpr ctx
+    match node with
+    | .Create a b _ | .Alloc0 a b _ =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "allocation"; visit a; visit b
+    | .CreateReadOnly a b c _ =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "readonly-allocation"
+      visit a; visit b; visit c
+    | .Kill _ p => emit ctx loc "memory-action" "model-effect-domain-obligation" "kill"; visit p
+    | .Store0 _ a b c _ | .LinuxStore a b c _ =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "store"; visit a; visit b; visit c
+    | .Load0 a b _ | .LinuxLoad a b _ =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "load"; visit a; visit b
+    | .SeqRMW _ a b s c =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "sequential-rmw"
+      visit a; visit b; pureExpr { ctx with bound := s :: ctx.bound } c
+    | .RMW0 a b c d _ _ | .CompareExchangeStrong a b c d _ _
+    | .CompareExchangeWeak a b c d _ _ =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "atomic-rmw"
+      visit a; visit b; visit c; visit d
+    | .Fence0 _ | .LinuxFence _ =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "fence"
+    | .LinuxRMW a b c _ =>
+      emit ctx loc "memory-action" "model-effect-domain-obligation" "linux-rmw"
+      visit a; visit b; visit c
+
+private def memoryOpName : generic_memop sym → String
+  | .PtrEq => "PtrEq"
+  | .PtrNe => "PtrNe"
+  | .PtrLt => "PtrLt"
+  | .PtrGt => "PtrGt"
+  | .PtrLe => "PtrLe"
+  | .PtrGe => "PtrGe"
+  | .Ptrdiff => "Ptrdiff"
+  | .IntFromPtr => "IntFromPtr"
+  | .PtrFromInt => "PtrFromInt"
+  | .PtrValidForDeref => "PtrValidForDeref"
+  | .PtrWellAligned => "PtrWellAligned"
+  | .PtrArrayShift => "PtrArrayShift"
+  | .PtrMemberShift _ _ => "PtrMemberShift"
+  | .BitfieldLoad _ _ => "BitfieldLoad"
+  | .BitfieldStore _ _ => "BitfieldStore"
+  | .Memcpy => "Memcpy"
+  | .Memcmp => "Memcmp"
+  | .Realloc => "Realloc"
+  | .Va_start => "Va_start"
+  | .Va_copy => "Va_copy"
+  | .Va_arg => "Va_arg"
+  | .Va_end => "Va_end"
+  | .GNU_va_scope_enter => "GNU_va_scope_enter"
+  | .GNU_va_scope_leave => "GNU_va_scope_leave"
+  | .GNU_va_call_enter => "GNU_va_call_enter"
+  | .GNU_va_call_leave => "GNU_va_call_leave"
+  | .GNU_va_frame => "GNU_va_frame"
+  | .GNU_va_start => "GNU_va_start"
+  | .GNU_va_copy => "GNU_va_copy"
+  | .GNU_va_arg => "GNU_va_arg"
+  | .GNU_va_end => "GNU_va_end"
+  | .Copy_alloc_id => "Copy_alloc_id"
+  | .CHERI_intrinsic _ _ => "CHERI_intrinsic"
+
+private partial def effectExpr (ctx : Context) : expr Unit → Collect Unit
+  | .Expr annots node => do
+    let loc := locationOf annots
+    let p := pureExpr ctx
+    let e := effectExpr ctx
+    match node with
+    | .Epure value => p value
+    | .Ememop op args =>
+      emit ctx loc "memory-operation" "model-effect-domain-obligation" (memoryOpName op)
+      args.forM p
+    | .Eaction (.Paction _ act) => memoryAction ctx act
+    | .Ecase subject alternatives =>
+      p subject
+      alternatives.forM fun (pat, body) => effectExpr (bindPattern ctx pat) body
+    | .Elet pat value body => p value; effectExpr (bindPattern ctx pat) body
+    | .Eif condition yes no => p condition; e yes; e no
+    | .Eccall _ type callee args =>
+      match fixedCallee ctx callee with
+      | some s => emitSym ctx loc "c-call" s
+      | none => emit ctx loc "indirect-c-call" "unclosed-indirect-targets"
+      p type; p callee; args.forM p
+    | .Eproc _ callee args => namedCall ctx loc "procedure-call" callee; args.forM p
+    | .Eunseq bodies | .End bodies => bodies.forM e
+    | .Ewseq pat first second | .Esseq pat first second =>
+      e first; effectExpr (bindPattern ctx pat) second
+    | .Ebound body | .Eindivisible _ body | .Eannot _ body => e body
+    | .Esave (label, _) saved body =>
+      saved.forM fun (_, (_, initial)) => p initial
+      effectExpr { ctx with bound := label :: saved.map Prod.fst ++ ctx.bound } body
+    | .Erun _ _ args => args.forM p
+    | .Epar bodies => emit ctx loc "parallel-execution" "scheduler-domain-obligation"; bodies.forM e
+    | .Ewait _ => emit ctx loc "wait-execution" "scheduler-domain-obligation"
+    | .Eexcluded _ act => memoryAction ctx act
+
+private def aliases (program : file Unit) : Fmap sym sym := Id.run do
+  let mut result := fmapEmpty
+  for (_, (decls, link)) in fmapElements program.extern do
+    match link with
+    | .LK_none => pure ()
+    | .LK_tentative target | .LK_normal target =>
+      for source in decls do
+        result := fmapAddBy (fun a b => Lem_Basic_classes.ordCompare a b) source target result
+  return result
+
+private def walkDeclaration (ctx : Context) (s : sym) : fun_map_decl Unit → Collect Unit
+  | .Fun _ params body => pureExpr { ctx with
+      owner := symbolKey s ++ ":" ++ symbolName s
+      bound := params.map Prod.fst } body
+  | .Proc _ _ _ params body => effectExpr { ctx with
+      owner := symbolKey s ++ ":" ++ symbolName s
+      bound := params.map Prod.fst } body
+  | .ProcDecl _ _ _ | .BuiltinDecl _ _ _ => pure ()
+
+/-- Selected quoted symbols only; the full collect/report remains available. -/
+def collectSelected (program : file Unit) (selected : List sym) : Array Reference := Id.run do
+  let ctx : Context := {
+    program := program, aliases := aliases program, owner := "",
+    ownerKind := "", selected := some selected
+  }
+  let computation : Collect Unit := do
+    for (s, decl) in fmapElements program.funs do
+      if selected.any (sameSym s) then
+        walkDeclaration { ctx with ownerKind := "selected-function" } s decl
+    for (s, decl) in fmapElements program.stdlib do
+      if selected.any (sameSym s) then
+        walkDeclaration { ctx with ownerKind := "selected-core-standard-library" } s decl
+    for (s, decl) in program.globs do
+      if selected.any (sameSym s) then
+        match decl with
+        | .GlobalDef _ body =>
+          effectExpr { ctx with
+            owner := symbolKey s ++ ":" ++ symbolName s
+            ownerKind := "selected-global-initializer" } body
+        | .GlobalDecl _ => pure ()
+  return (computation.run {}).2.rows
+
+def collect (program : file Unit) : Array Reference := Id.run do
+  let ctx : Context := { program := program, aliases := aliases program, owner := "", ownerKind := "" }
+  let computation : Collect Unit := do
+    for (s, decl) in fmapElements program.funs do
+      walkDeclaration { ctx with ownerKind := "supplied-function" } s decl
+    for (s, decl) in fmapElements program.stdlib do
+      walkDeclaration { ctx with ownerKind := "core-standard-library" } s decl
+    for (s, decl) in program.globs do
+      match decl with
+      | .GlobalDef _ body => effectExpr { ctx with
+          owner := symbolKey s ++ ":" ++ symbolName s
+          ownerKind := "global-initializer" } body
+      | .GlobalDecl _ => pure ()
+    for (_, decl) in fmapElements program.impl0 do
+      match decl with
+      | .Def _ body => pureExpr { ctx with owner := "implementation", ownerKind := "implementation" } body
+      | .IFun _ params body => pureExpr { ctx with
+          owner := "implementation"
+          ownerKind := "implementation"
+          bound := params.map Prod.fst } body
+  return (computation.run {}).2.rows
+
+def report (program : file Unit) (inputNames sourceDigests : List String)
+    (libcInput : Option (String × List String)) : Lean.Json :=
+  let refs := collect program
+  Lean.Json.mkObj [
+    ("schema", Lean.toJson (1 : Nat)),
+    ("scope", Lean.toJson "actual-linked-supplied-Core-bodies-conservative-all-bodies"),
+    ("inputs", Lean.toJson inputNames),
+    ("source_digests", Lean.toJson sourceDigests),
+    ("source_digest_kind", Lean.toJson "oracle Digest.file carried by Cabs JSON; external receipt must hash all inputs"),
+    ("translation_unit_count", Lean.toJson inputNames.length),
+    ("configured_program_input_set_verified", Lean.toJson false),
+    ("libc_input", Lean.toJson libcInput),
+    ("main_symbol", Lean.toJson (program.main.map symbolName)),
+    ("reference_count", Lean.toJson refs.size),
+    ("references", Lean.toJson refs),
+    ("completeness", Lean.Json.mkObj [
+      ("claim", Lean.toJson false),
+      ("reasons", Lean.toJson ([
+        "supplied input set has not been certified as the complete configured executable",
+        "indirect targets and dynamic provider contracts are not closed by syntax walking",
+        "model and adapter argument, error, state, callback and effect domains require separate validation",
+        "external data initialization and lifetime obligations require separate validation",
+        "alternate build configurations are outside this input set",
+        "native ELF and runtime unhandled-boundary cross-checks remain independent obligations"] : List String))])]
+
+end CerbBoundaryCensus
