+  let expression = gnu_opaque_array_cleanup_expression roots in
+  match stmt.A.node with
+    | A.AilSskip -> E.return true
+    | A.AilSexpr expr -> expression expr
+    | A.AilSblock [] statements -> E.mapM self statements >>= fun checked ->
+        E.return (List.all (fun value -> value) checked)
+    | A.AilSif test yes no -> expression test >>= fun guard ->
