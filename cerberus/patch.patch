+        gnu_boundary_origin_locals_with returns (2 * List.length origin_candidates + 1)
+          origin_candidates whole_body origin_values origin_roots >>= fun (origin_values, origin_roots) ->
+        let records = if not incoming_only || not (gnu_boundary_record_control whole_body)
+          then [] else List.foldr (fun (sym, (_, _, qs, ty)) rest -> match ty with
+            | Ctype.Ctype _ (Ctype.Struct _) ->
