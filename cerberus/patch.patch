index 00000000..35fbe49d
--- /dev/null
+++ b/lean_frontend/CerbSavedRegion.lean
@@ -0,0 +1,83 @@
+import CerbSavedProgram
+import Lean.CompactedRegion
+
+namespace CerbSavedRegion
+
+/-- This record is layout-bound by the runner to the actual compiled import
+    closure of this module and the pinned toolchain. It contains no closures. -/
+structure Image where
+  rawSHA256 : String
+  layoutSHA256 : String
+  artifact : CerbCoreData.Artifact
+
+private def sameArtifact (a b : CerbCoreData.Artifact) : Bool :=
+  a.schemaVersion == b.schemaVersion && a.sourceBindingPath == b.sourceBindingPath &&
+  a.sourceBindingSHA256 == b.sourceBindingSHA256 && a.translatorSHA256 == b.translatorSHA256 &&
+  a.semanticSwitches == b.semanticSwitches && a.fieldNames == b.fieldNames &&
+  a.supply == b.supply && a.executionDigest == b.executionDigest &&
+  a.orderedDigests == b.orderedDigests && a.linkedFunctionCount == b.linkedFunctionCount &&
+  a.linkedGlobalCount == b.linkedGlobalCount && a.snapshot == b.snapshot
+
+private unsafe def writeImage (path : System.FilePath) (image : Image) : IO Unit := do
+  -- v2 deliberately rejects closures. No native addresses cross runtime builds.
+  let _ ← Lean.CompactedRegion.save path (`CerbSavedRegion ++ Lean.Name.mkSimple image.rawSHA256)
+    image #[] none false
+  let (loaded, _region) ← Lean.CompactedRegion.read (α := Image) path #[]
+  unless loaded.rawSHA256 == image.rawSHA256 && loaded.layoutSHA256 == image.layoutSHA256 &&
+      sameArtifact loaded.artifact image.artifact do
+    throw (IO.userError "saved data region failed exact round trip")
+  -- Regions remain mapped for process lifetime; freeing with live references
+  -- would be unsound. The preparing process exits before program execution.
+
+@[implemented_by writeImage]
+private def writeVerifiedImage (_path : System.FilePath) (_image : Image) : IO Unit :=
+  throw (IO.userError "native region writer required")
+
+private unsafe def readImage (path : System.FilePath) : IO Image := do
+  let (image, _region) ← Lean.CompactedRegion.read (α := Image) path #[]
+  return image
+
+@[implemented_by readImage]
+private def readVerifiedImage (_path : System.FilePath) : IO Image :=
+  throw (IO.userError "native region reader required")
+
+/-- Called only by the checked runner under its lease. It records the cache
+    manifest after this process has exited successfully and hashes its bytes. -/
+def prepare (binding artifact digest producer output layout : String) : IO Unit := do
+  CerbCoreQuote.requireAbsolute output
+  unless layout.length == 64 && !(← (System.FilePath.mk output).pathExists) do
+    throw (IO.userError "region layout identity or fresh output path required")
+  let (data, parameters) ← CerbSavedProgram.decode binding artifact digest producer
+  let _ ← CerbSavedProgram.reconstruct data parameters
+  writeVerifiedImage output { rawSHA256 := digest, layoutSHA256 := layout, artifact := data }
+
+/-- The runner verifies the current layout before selecting this manifest.
+    Recheck bytes before the type-erased read and metadata after it. This cache
+    is local trusted build output, never an untrusted input format. -/
+def load (binding manifest expectedRaw producer : String) : IO CerbSavedProgram.Loaded := do
+  let parameters ← CerbSavedProgram.readParameters binding producer
+  let json ← match Lean.Json.parse (← IO.FS.readFile manifest) with
+    | .ok value => pure value
+    | .error error => throw (IO.userError error)
+  let get (name : String) : IO String := match json.getObjValAs? String name with
+    | .ok value => pure value
+    | .error error => throw (IO.userError error)
+  unless (match json.getObjValAs? Nat "schema" with | .ok 1 => true | _ => false) do
+    throw (IO.userError "unsupported saved region manifest schema")
+  let region ← get "region"
+  CerbCoreQuote.requireAbsolute region
+  let hash ← get "region_sha256"
+  let layout ← get "layout_sha256"
+  unless (← get "raw_sha256") == expectedRaw && (← get "binding_sha256") == parameters.bindingSHA256 &&
+      (← get "producer_sha256") == producer &&
+      (← CerbCoreQuote.hashFile "sha256sum" region 64) == hash do
+    throw (IO.userError "saved data region manifest or bytes differ")
+  let image ← readVerifiedImage region
+  unless image.rawSHA256 == expectedRaw && image.layoutSHA256 == layout &&
+      CerbSavedProgram.validateHeader image.artifact binding parameters &&
+      (← CerbCoreQuote.hashFile "sha256sum" region 64) == hash &&
+      (← CerbCoreQuote.hashFile "sha256sum" binding 64) == parameters.bindingSHA256 do
+    throw (IO.userError "saved data region identity changed")
+  CerbSavedProgram.reconstruct image.artifact parameters
+
+end CerbSavedRegion
