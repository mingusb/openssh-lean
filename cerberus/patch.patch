@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Generate guest codecs from an audited small primitive vocabulary."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+def generate(contracts, templates):
+    requests=[]; natives=[]; counts=[]; prepares=[]; executes=[]; completes=[]
+    for api in contracts["apis"]:
+        name,kind,count=api["symbol"],api["kind"],api["new_descriptors"]
+        if kind in ("socket","socketpair"):
+            fields="(domain socketType protocol : Int)"+(" (output : PointerValue)" if kind=="socketpair" else "")
+            nf="(domain socketType protocol : UInt32)"
+            pat="domain socketType protocol"+(" output" if kind=="socketpair" else "")
+            prep=["    let d ← i32 domain","    let t ← i32 socketType","    let p ← i32 protocol"]
+            if kind=="socketpair":
+                prep+=["    let (cells, after) ← arrayCells enums tags .signedInt output 2 initial",
+                       "    let outputs ← prepareOutputs enums tags (cells ++ [errnoCell]) after"]
+            else:prep+=["    let outputs ← prepareOutputs enums tags [errnoCell] initial"]
+            prep+=["    return ⟨."+name+" d t p, nativeErrno, outputs, [errnoRead], reserved⟩"]
+            exe="domain socketType protocol"
+            if kind=="socket":
+                complete="""    if response.bytes.size != 0 || !response.fields.isEmpty then fail "socket result has unexpected payload"
+    if failed then pure (-1, [], [])
+    else do
+      let native ← nativeFD response.status.value
+      match prepared.reservedGuests with
+      | [guest] => pure (guest, [native], [])
+      | _ => fail "socket lost its guest reservation" """
+            else:
+                complete="""    if response.bytes.size != 0 then fail "socketpair response has unexpected bytes"
+    if failed then
+      if response.fields.isEmpty then pure (-1, [], [none, none])
+      else do
+        let _ ← pairFields response.fields
+        -- These numbers were written before native failure and released by the
+        -- kernel. Write reserved guest numbers but transfer NO handle ownership.
+        pure (-1, [], prepared.reservedGuests.map some)
+    else do
+      if response.status.value != 0 then fail "socketpair returned an invalid status"
+      let natives ← pairFields response.fields
+      pure (0, natives, prepared.reservedGuests.map some)"""
+        elif kind=="address":
+            fields="(guestFD : Int) (address : PointerValue) (length : Int)"
+            nf="(nativeFD : UInt32) (address : ByteArray)"
+            pat="guestFD address length";exe="nativeFD address"
+            prep=["    if length < 0 || length > 4294967295 then fail \"sockaddr length is out of range\"",
+                  "    let native ← fd resolve guestFD",
+                  "    let (bytes, reads, after) ← if knownInvalid native then",
+                  "      pure (ByteArray.empty, [], initial)",
+                  "      else readBytes enums tags address length.toNat initial",
+                  "    let outputs ← prepareOutputs enums tags [errnoCell] after",
+                  "    return ⟨."+name+" native bytes, nativeErrno, outputs, errnoRead :: reads, reserved⟩"]
+            complete="""    if response.bytes.size != 0 || !response.fields.isEmpty then fail "status result has unexpected payload"
+    if !failed && response.status.value != 0 then fail "native status must be zero or minus one"
+    pure (response.status.value, [], [])"""
+        elif kind=="fd_int":
+            fields="(guestFD argument : Int)";nf="(nativeFD argument : UInt32)"
+            pat="guestFD argument";exe="nativeFD argument"
+            prep=["    let native ← fd resolve guestFD","    let argument ← i32 argument",
+                  "    let outputs ← prepareOutputs enums tags [errnoCell] initial",
+                  "    return ⟨."+name+" native argument, nativeErrno, outputs, [errnoRead], reserved⟩"]
+            complete="""    if response.bytes.size != 0 || !response.fields.isEmpty then fail "status result has unexpected payload"
+    if !failed && response.status.value != 0 then fail "native status must be zero or minus one"
+    pure (response.status.value, [], [])"""
+        elif kind=="poll_no_array":
+            fields="(count timeout : Int)";nf="(count : UInt64) (timeout : UInt32)"
+            pat="count timeout";exe="count timeout"
+            prep=["    if count < 0 || count > 18446744073709551615 then fail \"nfds_t is out of range\"",
+                  "    let timeout ← i32 timeout",
+                  "    let outputs ← prepareOutputs enums tags [errnoCell] initial",
+                  "    return ⟨.poll_no_array count.toNat.toUInt64 timeout, nativeErrno, outputs, [errnoRead], reserved⟩"]
+            complete="""    if response.bytes.size != 0 || response.fields != #[0] then
+      fail "no-array poll result has unexpected array writeback"
+    if !failed && response.status.value != 0 then
+      fail "no-array poll cannot return ready descriptors"
+    pure (response.status.value, [], [])"""
+        elif kind=="poll":
+            fields="(records : List PollRecord) (timeout : Int)";nf="(entries : ByteArray) (timeout : UInt32)"
+            pat="records timeout";exe="entries timeout"
+            prep=["    let timeout ← i32 timeout",
+                  "    let mut after := initial", "    let mut bytes := ByteArray.empty",
+                  "    let mut reads := [errnoRead]", "    let mut cells : List Cell := []",
+                  "    for record in records do",
+                  "      let (guest, fdRead, s1) ← readInteger enums tags ⟨record.fd, .signedInt⟩ after",
+                  "      let (events, eventsRead, s2) ← readInteger enums tags ⟨record.events, .signedShort⟩ s1",
+                  "      let native ← if guest < 0 then i32 guest else fd resolve guest",
+                  "      bytes := append bytes (word native.toUInt64 4)",
+                  "      bytes := append bytes (word (events % 65536).toNat.toUInt64 2)",
+                  "      bytes := append bytes (word 0 2)",
+                  "      reads := reads ++ [fdRead, eventsRead]",
+                  "      cells := cells ++ [⟨record.revents, .signedShort⟩]",
+                  "      after := s2",
+                  "    let outputs ← prepareOutputs enums tags (cells ++ [errnoCell]) after",
+                  "    return ⟨.poll bytes timeout, nativeErrno, outputs, reads, reserved⟩"]
+            complete="""    let count := entries.size / 8
+    if (!failed && (response.status.value < 0 || response.status.value > (count : Int))) ||
+        response.bytes.size != entries.size || response.fields.size != 1 ||
+        response.fields[0]! > 1 then
+      fail "poll result shape violates its record contract"
+    let wrote := response.fields[0]! == 1
+    if !failed && !wrote then fail "successful poll lacks its complete writeback mask"
+    let mut writes := []
+    let mut ready : Nat := 0
+    for i in List.range count do
+      let oldFD ← readWord entries (8*i) 4
+      let newFD ← readWord response.bytes (8*i) 4
+      let oldEvents ← readWord entries (8*i+4) 2
+      let newEvents ← readWord response.bytes (8*i+4) 2
+      if oldFD != newFD || oldEvents != newEvents then fail "poll changed an input-only field"
+      let revents ← readWord response.bytes (8*i+6) 2
+      if revents != 0 then ready := ready + 1
+      if failed && wrote && revents != 0 then fail "failed poll claims ready events"
+      writes := writes ++ [if wrote then some (sign16 revents) else none]
+    if !failed && response.status.value != (ready : Int) then fail "poll ready count differs from returned revents"
+    pure (response.status.value, [], writes)"""
+        else:raise ValueError(kind)
+        requests.append("  | "+name+" "+fields)
+        natives.append("  | "+name+" "+nf)
+        arity={"socket":3,"socketpair":4,"address":3,"fd_int":2,"poll":2,"poll_no_array":2}[kind]
+        counts.append("  | ."+name+" "+" ".join(["_"]*arity)+" => "+str(count))
+        prepares.append("  | ."+name+" "+pat+" =>\n"+"\n".join(prep))
+        executes.append("  | ."+name+" "+exe+" => CerbHostNetworkAdapters."+name+" prepared.modeledErrno "+exe)
+        n_arity={"socket":3,"socketpair":3,"address":2,"fd_int":2,"poll":2,"poll_no_array":2}[kind]
+        npat="entries _" if kind=="poll" else " ".join(["_"]*n_arity)
+        completes.append("  | ."+name+" "+npat+" => do\n"+complete)
+    out=templates.joinpath("network_guest.lean.in").read_text()
+    for key,val in {"REQUESTS":requests,"NATIVE_REQUESTS":natives,"COUNTS":counts,"PREPARES":prepares,"EXECUTES":executes,"COMPLETES":completes}.items():
+        out=out.replace("@"+key+"@","\n".join(val))
+    return {"CerbHostMemoryCells.lean":templates.joinpath("memory_cells.lean.in").read_text(),
+            "CerbHostNetworkGuest.lean":out}
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument("--contracts",type=Path,required=True)
+    parser.add_argument("--output",type=Path,required=True)
+    parser.add_argument("--check",action="store_true")
+    args=parser.parse_args()
+    contracts=json.loads(args.contracts.read_text())
+    if contracts["schema"]!=1:raise ValueError("unsupported guest schema")
+    names=[x["symbol"] for x in contracts["apis"]]
+    if len(names)!=len(set(names)):raise ValueError("duplicate guest API")
+    outputs=generate(contracts,Path(__file__).parent/"templates")
+    for name,data in outputs.items():
+        path=args.output/name
+        if args.check:
+            if not path.exists() or path.read_text()!=data:raise SystemExit("stale generated file: "+str(path))
+        else:
+            args.output.mkdir(parents=True,exist_ok=True)
+            path.write_text(data)
+    print(json.dumps({"generated_modules":len(outputs),"guest_codec_apis":sum(not api.get("helper",False) for api in contracts["apis"]),"codec_helpers":sum(bool(api.get("helper",False)) for api in contracts["apis"]),"integrated_apis":0,"check":args.check}))
+if __name__=="__main__":main()
