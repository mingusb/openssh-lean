@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Reproducible pure descriptor table and contract-derived family policy table."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+POLICIES = [
+    "freshScalar", "freshPair", "duplicate", "exactDuplicate",
+    "releaseDescriptor", "borrowedDescriptor", "streamCreate", "streamAttach",
+    "streamClose", "directoryCreatePending", "directoryClose",
+    "commandDependent", "rangePending", "ancillaryPending", "limitChange",
+]
+
+def generate(contracts_path):
+    root = contracts_path.resolve().parent
+    contracts = json.loads(contracts_path.read_text())
+    if contracts["schema"] != 1 or contracts["profile"] != "x86_64-linux-gnu":
+        raise ValueError("unsupported descriptor contract profile")
+    sources = {}
+    for source in contracts["sources"]:
+        path = root / source["path"]
+        raw = path.read_bytes()
+        if hashlib.sha256(raw).hexdigest() != source["sha256"]:
+            raise ValueError("source contract snapshot changed: " + str(path))
+        sources[source["family"]] = {item["symbol"]: item for item in json.loads(raw)["apis"]}
+    seen = set()
+    lines = [
+        "import CerbHostDescriptors",
+        "",
+        "-- Generated transfer policies: declaration admission must precede symbol dispatch.",
+        "-- These entries account for ownership only; they do not implement native effects.",
+        "namespace CerbHostDescriptorPolicies",
+        "",
+        "inductive Policy where",
+    ]
+    lines += ["  | " + policy for policy in POLICIES]
+    lines += ["  deriving BEq, Repr", "", "def lookup (family symbol : String) : Option Policy :=",
+              "  match family, symbol with"]
+    for item in contracts["policies"]:
+        key = item["family"], item["symbol"]
+        if key in seen or item["policy"] not in POLICIES:
+            raise ValueError("duplicate or unrecognized policy")
+        seen.add(key)
+        source = sources[key[0]][key[1]]
+        digest = hashlib.sha256(json.dumps(source, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+        if digest != item["source_record_sha256"]:
+            raise ValueError("policy source contract changed: " + repr(key))
+        lines += ["  | " + json.dumps(key[0]) + ", " + json.dumps(key[1]) +
+                  " => some ." + item["policy"]]
+    lines += ["  | _, _ => none", "", "end CerbHostDescriptorPolicies", ""]
+    return {
+        "CerbHostDescriptors.lean": (root / "templates/descriptors.lean.in").read_text(),
+        "CerbHostDescriptorPolicies.lean": "\n".join(lines),
+        "descriptor-accounting.json": json.dumps({
+            "schema": 1, "generated_policy_count": len(seen),
+            "families": {family: sum(item["family"] == family for item in contracts["policies"])
+                         for family in sources},
+            "policies": contracts["policies"], "unresolved": contracts["unresolved"],
+            "execution_status": "pure generation only; checked execution receipt required",
+            "main_dispatcher_status": "not integrated"
+        }, indent=2) + "\n",
+    }
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--contracts", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--check", action="store_true")
+    args = parser.parse_args()
+    outputs = generate(args.contracts)
+    if not args.check:
+        args.output.mkdir(parents=True, exist_ok=True)
+    for name, content in outputs.items():
+        path = args.output / name
+        if args.check:
+            if not path.exists() or path.read_text() != content:
+                raise SystemExit("stale generated descriptor artifact: " + str(path))
+        else:
+            path.write_text(content)
+    print("descriptor-generation-ok")
+if __name__ == "__main__":
+    main()
