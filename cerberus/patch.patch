+  let write operand = not (gnu_inline_parameter_lvalue sym operand) && self operand in
+  match expr with
+    | A.AilEassign left right -> write left && self right
+    | A.AilEcompoundAssign left _ right -> write left && self right
+    | A.AilEunary A.Address operand -> write operand
+    | A.AilEunary A.PostfixIncr operand -> write operand
+    | A.AilEunary A.PostfixDecr operand -> write operand
+    (* The address is consumed by this exact lvalue operation. An outer
+       address/array decay still checks the complete lvalue for escape. *)
+    | A.AilEunary A.Indirection (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address operand)) -> self operand
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEcond test yes no -> self test && maybe true self yes && self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEcall (A.AnnotatedExpression _ _ _
+        (A.AilEbuiltin (A.AilBGNU_asm _ _ _ outputs inputs clobbers))) args ->
+        if List.length args <> List.length outputs + List.length inputs ||
+            not (List.all (fun clobber -> clobber = "cc") clobbers) then false else
+          let (output_args, input_args) = List.splitAt (List.length outputs) args in
