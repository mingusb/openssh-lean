@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Generate network interpreter handling from the checked guest constructor inventory."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+def generate(contracts, root):
+    path=root/contracts["guest_contracts"]
+    if hashlib.sha256(path.read_bytes()).hexdigest()!=contracts["guest_contracts_sha256"]:
+        raise ValueError("guest constructor inventory hash changed")
+    guest=json.loads(path.read_text())
+    native_path=root/contracts["native_contracts"]
+    if hashlib.sha256(native_path.read_bytes()).hexdigest()!=contracts["native_contracts_sha256"]:
+        raise ValueError("native catalog snapshot changed")
+    native=json.loads(native_path.read_text())
+    catalog=[api["symbol"] for api in native["apis"] if not api.get("helper",False)]
+    unavailable=contracts["unavailable_apis"]
+    missing=[item["symbol"] for item in unavailable]
+    if len(catalog)!=len(set(catalog)) or len(missing)!=len(set(missing)):
+        raise ValueError("duplicate native catalog or unavailable API")
+    if any(not item["reason"] for item in unavailable):
+        raise ValueError("unavailable API needs an explicit reason")
+    names=[]; flags=[]
+    arities={"socket":3,"socketpair":4,"address":3,"fd_int":2,"poll":2,"poll_no_array":2}
+    for api in guest["apis"]:
+        name=api["symbol"]; kind=api["kind"]
+        if kind not in arities:raise ValueError("unreviewed guest constructor "+kind)
+        if not api.get("helper",False):names.append(name)
+        if api["new_descriptors"]:
+            if kind not in ("socket","socketpair"):
+                raise ValueError("unreviewed descriptor ownership policy")
+            pattern="_ socketType _"+(" _" if kind=="socketpair" else "")
+            expression="some (if (socketType.toNat / 524288) % 2 == 1 then 1 else 0)"
+        else:
+            pattern=" ".join(["_"]*arities[kind]);expression="none"
+        flags.append("  | ."+name+" "+pattern+" => "+expression)
+    if len(names)!=len(set(names)):raise ValueError("duplicate catalog symbol")
+    if set(names)&set(missing) or set(names)|set(missing)!=set(catalog):
+        raise ValueError("every catalog API must have exactly one supported/unavailable disposition")
+    selections=['  | '+json.dumps(name)+' => .supported '+json.dumps(name) for name in names]
+    selections += ['  | '+json.dumps(item["symbol"])+' => .unsupported '+json.dumps(item["symbol"])+' '+json.dumps(item["reason"]) for item in unavailable]
+    data=(root/"templates/network_handler.lean.in").read_text()
+    return data.replace("@SYMBOLS@",json.dumps(names)).replace("@FLAGS@","\n".join(flags)).replace("@SELECTIONS@","\n".join(selections))
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--contracts",required=True,type=Path)
+    p.add_argument("--output",required=True,type=Path)
+    p.add_argument("--check",action="store_true")
+    a=p.parse_args();contracts=json.loads(a.contracts.read_text())
+    if contracts["schema"]!=1:raise ValueError("unsupported schema")
+    data=generate(contracts,Path(__file__).parent)
+    path=a.output/"CerbHostNetworkHandler.lean"
+    if a.check:
+        if not path.exists() or path.read_text()!=data:raise SystemExit("stale generated network handler")
+    else:
+        a.output.mkdir(parents=True,exist_ok=True);path.write_text(data)
+    print(json.dumps({"generated_modules":1,"shared_driver_integrated":False,"check":a.check}))
+if __name__=="__main__":main()
