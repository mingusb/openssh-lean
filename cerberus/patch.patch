+int main(void) {
+    union Number first = {17};
+    union Number selected = {.second = next()};
+    union Number array[3] = {{.second = 10000000002L}, {23}, {.second = 29L}};
+    struct Container nested = {.before = 3, .choice.pair.y = 7, .after = 11};
+    union Choice switched = {.pair.x = 19, .whole = 23L, .pair.y = 31};
+    union Choice same = {.pair.x = 37, .pair.y = 41};
+    union Choice reverse = {.pair.y = 43, .whole = 10000000003L};
+    union Choice nested_array[2] = {{.pair.x = 47}, {.pair.y = 53}};
+    if (saved.second != 10000000000L || zero.first != 0) return 1;
+    if (first.first != 17 || selected.second != 10000000001L || calls != 1) return 2;
+    if (array[0].second != 10000000002L || array[1].first != 23 || array[2].second != 29L) return 3;
+    if (nested.before != 3 || nested.choice.pair.x != 0 || nested.choice.pair.y != 7 || nested.after != 11) return 4;
+    if (switched.pair.x != 0 || switched.pair.y != 31) return 5;
+    if (same.pair.x != 37 || same.pair.y != 41) return 6;
+    if (reverse.whole != 10000000003L) return 7;
+    if (nested_array[0].pair.x != 47 || nested_array[0].pair.y != 0 ||
+        nested_array[1].pair.x != 0 || nested_array[1].pair.y != 53) return 8;
+    return 0;
+}
