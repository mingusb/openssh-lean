+(* A private function whose address survives ordinary call lowering needs its
+   original executable body as well as any direct-call specializations. Only
+   actual Core references request that body; GNU extern-inline aliases are
+   excluded by the caller because their address names the external definition.
+   Translation starts with no caller facts and retains every normal analysis
+   refusal. In particular this does not invent opaque parameter bounds.
+
+   At most one body is installed per candidate. A pass with new work resolves
+   at least one candidate, so N passes compute the finite reference closure of
+   N candidates, including references introduced by newly drained instances.
+   This is a finite graph traversal, not a limit on program execution. *)
+let materialize_gnu_private_addresses stdlib core_tagDefs sigm candidates globs cfuns funinfo =
+  E.foldlM (fun state _ ->
+    E.foldlM (fun (cfuns, funinfo) source ->
+      let already_defined = match Map.lookup source cfuns with
+        | Just (C.Proc _ _ _ _ _) -> true | _ -> false end in
+      if already_defined || gnu_inline_references_clear [source] globs cfuns then
+        E.return (cfuns, funinfo)
+      else match (List.lookup source sigm.A.declarations,
+                  List.lookup source sigm.A.function_definitions) with
+        | (Just (_, attrs, A.Decl_function has_proto (_, ret_ty) params is_variadic is_inline is_Noreturn),
+           Just definition) ->
+            E.with_function_scope [] [] ([], [], [], [], [], [])
+              (translate_function_definition stdlib core_tagDefs Nothing source attrs
+                ret_ty params is_variadic is_inline is_Noreturn has_proto (List.length params) definition) >>= fun (proc, info) ->
+            drain_gnu_inline_specializations stdlib core_tagDefs sigm
+              (Map.insert source proc cfuns) (Map.insert source info funinfo)
+        | _ -> E.record_error_at Loc.unknown
+            "GNU private function address lost its typed source definition" >>
+            E.return (cfuns, funinfo)
+      end
+    ) state candidates
+  ) (cfuns, funinfo) candidates
+
+(* A visible direct callee needs the same compiler-fact view as a GNU inline
+   body when it contains an object-size query, or reaches one through a
+   deferred inline wrapper.  This is deliberately a syntactic, finite call
+   closure: function-pointer uses remain ordinary calls. Externally callable
+   definitions retain an ordinary body; genuinely deferred private bodies
+   remain guarded by [validate_gnu_inline_references]. *)
+val gnu_template_direct_target:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_template_direct_target targets (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_template_direct_target targets in
+  match node with
+    | A.AilEident sym -> List.any (fun target -> target = sym) targets
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEunary A.Address operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | _ -> false
+  end
+
+(* A direct GNU-inline query needs its caller context when a pointer or
+   integer argument is forwarded from a formal. Integer flags and lengths
+   need the same call-site snapshots as pointer extents. A member subobject
+   such as [&p->member] already has a closed closest-member extent and must
+   remain usable through an ordinary function pointer. *)
+val gnu_template_forwarded_value_parameter:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_template_forwarded_value_parameter params (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_template_forwarded_value_parameter params in
+  match node with
+    | A.AilEident sym ->
+        (AilTypesAux.is_pointer (ctype_of expr) || AilTypesAux.is_integer (ctype_of expr)) &&
+        List.any (fun param -> param = sym) params
+    | A.AilErvalue operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | _ -> false
+  end
+
+val gnu_template_requires_forwarded_value_facts_expr:
+  list Symbol.sym -> list (Symbol.sym * list bool) -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_template_requires_forwarded_value_facts_expr inline_targets scalar_targets params
+    (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_template_requires_forwarded_value_facts_expr inline_targets scalar_targets params in
+  match node with
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left || self right
+    | A.AilEassign left right -> self left || self right
+    | A.AilEcompoundAssign left _ right -> self left || self right
+    | A.AilEcond test yes no -> self test || maybe false self yes || self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEcall callee args ->
+        (gnu_template_direct_target inline_targets callee &&
+          List.any (fun actual -> AilTypesAux.is_pointer (ctype_of actual) &&
+            gnu_template_forwarded_value_parameter params actual) args) ||
+        List.any (fun (target, queried) ->
+          gnu_template_direct_target [target] callee &&
+          List.length queried <= List.length args &&
+          List.any (fun (actual, relevant) -> relevant &&
+            AilTypesAux.is_integer (ctype_of actual) &&
+            gnu_template_forwarded_value_parameter params actual)
+            (List.zip (fst (List.splitAt (List.length queried) args)) queried)) scalar_targets ||
+        self callee || List.any self args
+    | A.AilEassert operand -> self operand
+    | A.AilEgeneric operand _ associations -> self operand || List.any (fun association ->
+        match association with
+          | A.AilGAtype _ _ value -> self value
+          | A.AilGAdefault value -> self value
+        end) associations
+    | A.AilEarray _ _ elements -> List.any (maybe false self) elements
+    | A.AilEstruct _ members -> List.any (fun (_, value) -> maybe false self value) members
+    | A.AilEunion _ _ value -> maybe false self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEva_start operand _ -> self operand
+    | A.AilEva_arg operand _ -> self operand
+    | A.AilEva_copy left right -> self left || self right
+    | A.AilEva_end operand -> self operand
+    | A.AilEprint_type operand -> self operand
+    | A.AilEbmc_assume operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEatomic operand -> self operand
+    | A.AilEgcc_statement _ statements ->
+        List.any (gnu_template_requires_forwarded_value_facts_stmt inline_targets scalar_targets params) statements
+    | _ -> false
+  end
+
+and gnu_template_requires_forwarded_value_facts_stmt inline_targets scalar_targets params stmt =
+  let self = gnu_template_requires_forwarded_value_facts_stmt inline_targets scalar_targets params in
+  let expr = gnu_template_requires_forwarded_value_facts_expr inline_targets scalar_targets params in
+  match stmt.A.node with
+    | A.AilSvla_scope _ captures _ body -> List.any (fun (_, value) -> expr value) captures || self body
+    | A.AilSskip -> false
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.any self statements
+    | A.AilSif test yes no -> expr test || self yes || self no
+    | A.AilSwhile test body _ -> expr test || self body
+    | A.AilSdo body test _ -> self body || expr test
+    | A.AilSbreak -> false
+    | A.AilScontinue -> false
+    | A.AilSreturnVoid -> false
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch operand body -> expr operand || self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> false
+    | A.AilSdeclaration declarations -> List.any (fun (_, value) -> maybe false expr value) declarations
+    | A.AilSpar statements -> List.any self statements
+    | A.AilSreg_store _ operand -> expr operand
+    | A.AilSmarker _ body -> self body
+  end
+
+(* Syntactic query dependence selects a call context, never a value fact.
+   Unknown syntax conservatively reports dependence. *)
+val gnu_query_mentions_parameter:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_query_mentions_parameter subject (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_query_mentions_parameter subject in
+  match node with
+    | A.AilEident sym -> sym = subject
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left || self right
+    | A.AilEassign left right -> self left || self right
+    | A.AilEcompoundAssign left _ right -> self left || self right
+    | A.AilEcond test yes no -> self test || maybe false self yes || self no
+    | A.AilEcall callee args -> self callee || List.any self args
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEsizeof_expr operand -> self operand
+    | A.AilEconst _ -> false
+    | A.AilEstr _ -> false
+    | A.AilEbuiltin _ -> false
+    | A.AilEsizeof _ ty -> AilTypesAux.is_vla ty
+    | A.AilEalignof _ _ -> false
+    | A.AilEoffsetof _ _ -> false
+    | _ -> true
+  end
+
+val gnu_template_sensitive_expr:
+  bool -> maybe Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_template_sensitive_expr include_object_size query_parameter targets (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_template_sensitive_expr include_object_size query_parameter targets in
+  match node with
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left || self right
+    | A.AilEassign left right -> self left || self right
+    | A.AilEcompoundAssign left _ right -> self left || self right
+    | A.AilEcond test yes no -> self test || maybe false self yes || self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) args ->
+        maybe true (fun param -> List.any (gnu_query_mentions_parameter param) args) query_parameter
+    | A.AilEcall callee args ->
+        gnu_template_direct_target targets callee || self callee || List.any self args
+    | A.AilEassert operand -> self operand
+    | A.AilEgeneric operand _ associations -> self operand || List.any (fun association ->
+        match association with
+          | A.AilGAtype _ _ value -> self value
+          | A.AilGAdefault value -> self value
+        end) associations
+    | A.AilEarray _ _ elements -> List.any (maybe false self) elements
+    | A.AilEstruct _ members -> List.any (fun (_, value) -> maybe false self value) members
+    | A.AilEunion _ _ value -> maybe false self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEbuiltin (A.AilBGNU_object_size _ _) -> include_object_size
+    | A.AilEbuiltin A.AilBGNU_constant_p -> isNothing query_parameter
+    | A.AilEsizeof_expr operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEva_start operand _ -> self operand
+    | A.AilEva_arg operand _ -> self operand
+    | A.AilEva_copy left right -> self left || self right
+    | A.AilEva_end operand -> self operand
+    | A.AilEprint_type operand -> self operand
+    | A.AilEbmc_assume operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEatomic operand -> self operand
+    | A.AilEgcc_statement _ statements -> List.any (gnu_template_sensitive_stmt include_object_size query_parameter targets) statements
+    | _ -> false
+  end
+
+and gnu_template_sensitive_stmt include_object_size query_parameter targets stmt =
+  let self = gnu_template_sensitive_stmt include_object_size query_parameter targets in
+  let expr = gnu_template_sensitive_expr include_object_size query_parameter targets in
+  match stmt.A.node with
+    | A.AilSvla_scope _ captures _ body -> List.any (fun (_, value) -> expr value) captures || self body
+    | A.AilSskip -> false
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.any self statements
+    | A.AilSif test yes no -> expr test || self yes || self no
+    | A.AilSwhile test body _ -> expr test || self body
+    | A.AilSdo body test _ -> self body || expr test
+    | A.AilSbreak -> false
+    | A.AilScontinue -> false
+    | A.AilSreturnVoid -> false
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch operand body -> expr operand || self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> false
+    | A.AilSdeclaration declarations -> List.any (fun (_, value) -> maybe false expr value) declarations
+    | A.AilSpar statements -> List.any self statements
+    | A.AilSreg_store _ operand -> expr operand
+    | A.AilSmarker _ body -> self body
+  end
+
+(* A visible direct call may pass a compiler-query function as a callback.
+   Mark only that named callee for fact specialization; an arbitrary unknown
+   callback parameter does not make every callback-taking body a template.
+   Normal call lowering still evaluates the original callee and arguments. *)
+val gnu_template_named_target: A.expression GenTypes.genTypeCategory -> maybe Symbol.sym
+let rec gnu_template_named_target (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEident sym -> Just sym
+  | A.AilEfunction_decay operand -> gnu_template_named_target operand
+  | A.AilEunary A.Address operand -> gnu_template_named_target operand
+  | A.AilEannot _ operand -> gnu_template_named_target operand
+  | A.AilEcast _ _ operand -> gnu_template_named_target operand
+  | _ -> Nothing
+end
+
+(* Collect all receivers in one traversal per body, rather than rescanning
+   every body for every candidate. The same fixed-point membership test and
+   excluded-function set below still govern which receivers become templates. *)
+val gnu_template_query_receivers_expr:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> list Symbol.sym
+let rec gnu_template_query_receivers_expr targets (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_template_query_receivers_expr targets in
+  let many expressions = List.concat (List.map self expressions) in
+  match node with
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left ++ self right
+    | A.AilEassign left right -> self left ++ self right
+    | A.AilEcompoundAssign left _ right -> self left ++ self right
+    | A.AilEcond test yes no -> self test ++ maybe [] self yes ++ self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEcall callee args ->
+        (if List.any (gnu_template_direct_target targets) args then
+          maybe [] (fun target -> [target]) (gnu_template_named_target callee) else []) ++
+        self callee ++ many args
+    | A.AilEassert operand -> self operand
+    | A.AilEgeneric operand _ associations -> self operand ++ List.concat (List.map (fun association ->
+        match association with
+          | A.AilGAtype _ _ value -> self value
+          | A.AilGAdefault value -> self value
+        end) associations)
+    | A.AilEarray _ _ elements -> List.concat (List.map (maybe [] self) elements)
+    | A.AilEstruct _ members -> List.concat (List.map (fun (_, value) -> maybe [] self value) members)
+    | A.AilEunion _ _ value -> maybe [] self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEsizeof_expr operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEva_start operand _ -> self operand
+    | A.AilEva_arg operand _ -> self operand
+    | A.AilEva_copy left right -> self left ++ self right
+    | A.AilEva_end operand -> self operand
+    | A.AilEprint_type operand -> self operand
+    | A.AilEbmc_assume operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEatomic operand -> self operand
+    | A.AilEgcc_statement _ statements -> List.concat (List.map (gnu_template_query_receivers_stmt targets) statements)
+    | _ -> []
+  end
+
+and gnu_template_query_receivers_stmt targets stmt =
+  let self = gnu_template_query_receivers_stmt targets in
+  let expr = gnu_template_query_receivers_expr targets in
+  match stmt.A.node with
+    | A.AilSvla_scope _ captures _ body -> List.concat (List.map (fun (_, value) -> expr value) captures) ++ self body
+    | A.AilSskip -> []
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.concat (List.map self statements)
+    | A.AilSif test yes no -> expr test ++ self yes ++ self no
+    | A.AilSwhile test body _ -> expr test ++ self body
+    | A.AilSdo body test _ -> self body ++ expr test
+    | A.AilSbreak -> []
+    | A.AilScontinue -> []
+    | A.AilSreturnVoid -> []
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch operand body -> expr operand ++ self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> []
+    | A.AilSdeclaration declarations -> List.concat (List.map (fun (_, value) -> maybe [] expr value) declarations)
+    | A.AilSpar statements -> List.concat (List.map self statements)
+    | A.AilSreg_store _ operand -> expr operand
+    | A.AilSmarker _ body -> self body
+  end
+
+val gnu_direct_template_closure:
+  list Symbol.sym -> list Symbol.sym ->
+  list (Symbol.sym * (Loc.t * nat * Annot.attributes * list Symbol.sym * A.statement GenTypes.genTypeCategory)) ->
+  list Symbol.sym
+let rec gnu_direct_template_closure excluded targets definitions =
+  let receivers = List.concat (List.map (fun (_, (_, _, _, _, body)) ->
+    gnu_template_query_receivers_stmt targets body) definitions) in
+  let grown = List.foldr (fun (sym, (_, _, _, _, body)) acc ->
+    if List.any (fun entry -> entry = sym) excluded ||
+        List.any (fun target -> target = sym) acc ||
+        not (gnu_template_sensitive_stmt true Nothing targets body ||
+          List.elem sym receivers)
+    then acc else sym :: acc
+  ) targets definitions in
+  if List.length grown = List.length targets then targets
+  else gnu_direct_template_closure excluded grown definitions
+
+(* An unchanged pointer can nevertheless acquire compiler-known bounds
+   from a branch equality (including an inlined predicate). Until branch facts
+   are represented, such bodies must not seed every ordinary formal with an
+   unknown-size result. This summary is deliberately conservative and does not
+   alter source control flow or runtime call evaluation. *)
+val gnu_pointer_refinement_null: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_refinement_null (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEconst A.ConstantNull -> true
+  | A.AilEconst (A.ConstantInteger (A.IConstant value _ _)) -> value = 0
+  | A.AilEcast _ _ operand -> gnu_pointer_refinement_null operand
+  | A.AilEannot _ operand -> gnu_pointer_refinement_null operand
+  | _ -> false
+end
+
+val gnu_pointer_refinement_origin: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_refinement_origin (A.AnnotatedExpression _ _ _ node as expr) =
+  AilTypesAux.is_pointer (ctype_of expr) || match node with
+    | A.AilEcast _ _ operand -> gnu_pointer_refinement_origin operand
+    | A.AilEannot _ operand -> gnu_pointer_refinement_origin operand
+    | _ -> false
+  end
+
+val gnu_pointer_refinement_direct: A.expression GenTypes.genTypeCategory -> maybe Symbol.sym
+let rec gnu_pointer_refinement_direct (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEident sym -> if AilTypesAux.is_function (ctype_of expr) then Just sym else Nothing
+  | A.AilEfunction_decay operand -> gnu_pointer_refinement_direct operand
+  | A.AilEunary A.Address operand -> gnu_pointer_refinement_direct operand
+  | A.AilEcast _ _ operand -> gnu_pointer_refinement_direct operand
+  | A.AilEannot _ operand -> gnu_pointer_refinement_direct operand
+  | _ -> Nothing
+end
+
+val gnu_pointer_refinement_expr:
+  maybe (list Ctype.ctype) ->
+  (A.expression GenTypes.genTypeCategory -> nat -> maybe (list Symbol.sym)) ->
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_refinement_expr types indirect_bodies targets (A.AnnotatedExpression _ _ loc node as expr) =
+  let self = gnu_pointer_refinement_expr types indirect_bodies targets in
+  let diagnostic reason = Debug.print_debug_located 2 [Debug.DB_elaboration] loc (fun () ->
+    "GNU pointer refinement cause=" ^ reason ^ "; expression=" ^ Pp.stringFromAil_expression expr) in
+  let comparison left right =
+    let risk = not (gnu_pointer_refinement_null left || gnu_pointer_refinement_null right) &&
+      (gnu_pointer_refinement_origin left || gnu_pointer_refinement_origin right) in
+    let () = if risk then diagnostic "comparison" else () in risk in
+  match node with
+    | A.AilEbinary left A.Eq right -> comparison left right || self left || self right
+    | A.AilEbinary left A.Ne right -> comparison left right || self left || self right
+    | A.AilEcall (A.AnnotatedExpression _ _ _
+        (A.AilEbuiltin (A.AilBGNU_asm _ _ _ _ _ clobbers))) args ->
+        not (List.all (fun clobber -> clobber = "cc") clobbers) ||
+        List.any gnu_pointer_refinement_origin args || List.any self args
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin _)) args -> List.any self args
+    | A.AilEcall callee args ->
+        (match gnu_pointer_refinement_direct callee with
+          | Just sym -> List.any (fun target -> target = sym) targets
+          (* Reuse only the complete exact-signature visible-body census.
+             Every represented body participates in this same monotone closure;
+             a recursive component containing a comparison is discovered on a
+             later iteration. This says nothing about writes or readonly calls.
+             Missing/inexact targets retain the original conservative boundary. *)
+          | Nothing -> (match indirect_bodies callee (List.length args) with
+              | Just candidates -> List.any (fun target -> List.elem target targets) candidates
+              | Nothing -> if gnu_indirect_target_types_disjoint types callee then false
+                  else let () = diagnostic "unresolved callee" in true
+              end)
+        end) || self callee || List.any self args
+    | A.AilEassign left right -> self left || self right
+    | A.AilEcompoundAssign left _ right -> self left || self right
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> self left || self right
+    | A.AilEcond condition yes no -> self condition || maybe false self yes || self no
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEassert operand -> self operand
+    | A.AilEarray _ _ values -> List.any (maybe false self) values
+    | A.AilEstruct _ members -> List.any (fun (_, value) -> maybe false self value) members
+    | A.AilEunion _ _ value -> maybe false self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEsizeof_expr _ -> false
+    | A.AilEsizeof _ _ -> false
+    | A.AilEalignof _ _ -> false
+    | A.AilEoffsetof _ _ -> false
+    | A.AilEident _ -> false
+    | A.AilEstr _ -> false
+    | A.AilEconst _ -> false
+    | A.AilEbuiltin _ -> false
+    | _ -> let () = diagnostic "unhandled expression" in true
+  end
+
+val gnu_pointer_refinement_stmt:
+  maybe (list Ctype.ctype) ->
+  (A.expression GenTypes.genTypeCategory -> nat -> maybe (list Symbol.sym)) ->
+  list Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_refinement_stmt types indirect_bodies targets stmt =
+  let self = gnu_pointer_refinement_stmt types indirect_bodies targets in
+  let expr = gnu_pointer_refinement_expr types indirect_bodies targets in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> true
+    | A.AilSskip -> false
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.any self statements
+    | A.AilSif test yes no -> expr test || self yes || self no
+    | A.AilSwhile test body _ -> expr test || self body
+    | A.AilSdo body test _ -> self body || expr test
+    | A.AilSbreak -> false
+    | A.AilScontinue -> false
+    | A.AilSreturnVoid -> false
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch operand body -> expr operand || self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> false
+    | A.AilSdeclaration declarations -> List.any (fun (_, value) -> maybe false expr value) declarations
+    | A.AilSpar statements -> List.any self statements
+    | A.AilSmarker _ body -> self body
+    | _ -> true
+  end
+
+val gnu_pointer_refinement_closure:
+  maybe (list Ctype.ctype) ->
+  (A.expression GenTypes.genTypeCategory -> nat -> maybe (list Symbol.sym)) ->
+  map Symbol.sym Symbol.sym -> list Symbol.sym -> list Symbol.sym ->
+  list (Symbol.sym * (Loc.t * nat * Annot.attributes * list Symbol.sym * A.statement GenTypes.genTypeCategory)) ->
+  list Symbol.sym
+let rec gnu_pointer_refinement_closure types indirect_bodies aliases opaque targets definitions =
+  let add sym acc = if List.any (fun old -> old = sym) acc then acc else sym :: acc in
+  let aliased = Map_extra.fold (fun declared body acc ->
+    if List.any (fun target -> target = body) acc then add declared acc else acc
+  ) aliases targets in
+  (* A noipa body's own comparisons still need intraprocedural handling.
+     They cannot refine a direct caller through the unavailable IPA body.
+     No-inline functions remain visible here; argument expressions are still
+     scanned by the ordinary expression walker. *)
+  let callable = List.filter (fun declared ->
+    let target = maybe declared (fun target -> target) (Map.lookup declared aliases) in
+    not (List.elem target opaque)) aliased in
+  let grown = List.foldr (fun (sym, (_, _, _, _, body)) acc ->
+    if gnu_pointer_refinement_stmt types indirect_bodies callable body then add sym acc else acc
+  ) aliased definitions in
+  if List.length grown = List.length targets then targets
+  else gnu_pointer_refinement_closure types indirect_bodies aliases opaque grown definitions
+
+(* The ordinary-entry gate can be discharged locally when every potentially
+   refining condition is one the statement branch handler actually captures.
+   Keep this separate from the transitive predicate summary: a helper that
+   returns the result of such a condition can still refine its caller. *)
+val gnu_pointer_handled_root: A.expression GenTypes.genTypeCategory -> bool
+let gnu_pointer_handled_root expr = gnu_branch_fixed_address expr
+
+val gnu_pointer_handled_condition:
+  map Symbol.sym (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let gnu_pointer_handled_condition predicates subjects condition =
+  let (A.AnnotatedExpression _ _ _ node as expr) = gnu_guard_normalize predicates condition in
+  let attempt pointer address = match gnu_branch_pointer_object pointer with
+    | Just (sym, _) -> List.elem sym subjects && gnu_pointer_handled_root address
+    | Nothing -> false end in
+  gnu_size_effects expr = Just false && match node with
+    | A.AilEbinary left bop right -> gnu_scalar_is_equality bop &&
+        (attempt left right || attempt right left)
+    | _ -> false
+  end
+
+(* GCC's object-size pass has already run when an integer-only comparison or
+   a local function-pointer predicate exposes its pointer equality. These
+   certified forms preserve ordinary-entry opacity instead of inventing a
+   pointer refinement. The indirect target must have the same closed pure
+   predicate summary used for direct calls. *)
+val gnu_guard_integer_pointer:
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory * Ctype.ctype)
+let gnu_guard_integer_pointer (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcast _ ty operand ->
+      if AilTypesAux.is_integer ty && AilTypesAux.is_pointer (ctype_of operand) &&
+          maybe false (fun bytes -> gnu_scalar_fixed_size ty = Just (integerFromNat bytes))
+            Implementation.sizeof_pointer then Just (operand, ty) else Nothing
+  | _ -> Nothing
+end
+
+val gnu_guard_local_targets:
+  A.statement GenTypes.genTypeCategory -> list (Symbol.sym * Symbol.sym)
+let rec gnu_guard_local_targets stmt =
+  let self = gnu_guard_local_targets in match stmt.A.node with
+    | A.AilSvla_scope _ _ _ body -> self body
+    | A.AilSdeclaration declarations -> List.foldr (fun (sym, value) acc -> match value with
+        | Just expr -> (match gnu_guard_direct_function expr with
+            | Just target -> (sym, target) :: acc | Nothing -> acc end)
+        | Nothing -> acc end) [] declarations
+    | A.AilSblock _ children -> List.concat (List.map self children)
+    | A.AilSif _ yes no -> self yes ++ self no
+    | A.AilSmarker _ body -> self body
+    | _ -> []
+  end
+
+val gnu_guard_stage_opaque:
+  map Symbol.sym (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  list (Symbol.sym * Symbol.sym) -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let gnu_guard_stage_opaque predicates local_targets subjects condition =
+  let attempt pointer address = match gnu_branch_pointer_object pointer with
+    | Just (sym, _) -> List.elem sym subjects && gnu_pointer_handled_root address
+    | Nothing -> false end in
+  let (A.AnnotatedExpression _ _ _ node as expr) = gnu_guard_normalize predicates condition in
+  match node with
+    | A.AilEbinary left bop right ->
+        gnu_scalar_is_equality bop && gnu_size_effects expr = Just false &&
+        (match (gnu_guard_integer_pointer left, gnu_guard_integer_pointer right) with
+          | (Just (lhs, lt), Just (rhs, rt)) -> lt = rt && (attempt lhs rhs || attempt rhs lhs)
+          | _ -> false end)
+    | A.AilEcall (A.AnnotatedExpression _ _ _
+        (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand))) [actual] ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty then false else
+        (match List.lookup sym local_targets with
+          | Just target -> (match Map.lookup target predicates with
+              | Just predicate -> (match gnu_guard_expand predicate actual with
+                  | Just expanded -> gnu_pointer_handled_condition predicates subjects expanded
+                  | Nothing -> false end)
+              | Nothing -> false end)
+          | Nothing -> false end)
+    | _ -> false
+  end
+
+(* Forward jumps may bypass a guard, but label translation clears branch
+   knowledge before translating the target. Reject backward/unknown labels
+   and hidden expression control: an earlier query must never be smuggled
+   around the query-staging check by a new control-flow cycle. *)
+val gnu_pointer_control_events:
+  A.statement GenTypes.genTypeCategory -> maybe (list (bool * Symbol.sym))
+let rec gnu_pointer_control_events stmt =
+  let self = gnu_pointer_control_events in
+  let append first second = match (first,second) with
+    | (Just a,Just b) -> Just (a ++ b) | _ -> Nothing end in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> Nothing
+    | A.AilSlabel sym body _ -> maybe Nothing (fun events -> Just ((true,sym)::events)) (self body)
+    | A.AilSgoto sym -> Just [(false,sym)]
+    | A.AilSblock _ statements -> List.foldl (fun acc child -> append acc (self child)) (Just []) statements
+    | A.AilSif _ yes no -> append (self yes) (self no)
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSmarker _ body -> self body
+    | A.AilSskip -> Just []
+    | A.AilSexpr _ -> Just []
+    | A.AilSreturn _ -> Just []
+    | A.AilSreturnVoid -> Just []
+    | A.AilSdeclaration _ -> Just []
+    | A.AilSbreak -> Just []
+    | A.AilScontinue -> Just []
+    | _ -> Nothing
+  end
+
+val gnu_pointer_forward_events: list Symbol.sym -> list (bool * Symbol.sym) -> bool
+let rec gnu_pointer_forward_events seen events = match events with
+  | [] -> true
+  | (is_label,sym)::rest ->
+      if is_label then not (List.elem sym seen) && gnu_pointer_forward_events (sym::seen) rest
+      else not (List.elem sym seen) &&
+        List.length (List.filter (fun (label,target) -> label && target=sym) rest) = 1 &&
+        gnu_pointer_forward_events seen rest
+end
+
+val gnu_pointer_forward_control: A.statement GenTypes.genTypeCategory -> bool
+let gnu_pointer_forward_control stmt = gnu_labels_expressions_closed stmt &&
+  maybe false (gnu_pointer_forward_events []) (gnu_pointer_control_events stmt)
+
+val gnu_pointer_loop_test: A.expression GenTypes.genTypeCategory -> bool
+let gnu_pointer_loop_test (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_memory_expression_readonly expr then not (gnu_template_sensitive_expr true Nothing [] expr)
+  else gnu_guard_scalar_update expr || match node with
+    | A.AilEbinary left _ right ->
+        (gnu_guard_scalar_update left && gnu_inline_closed_integer_origin right) ||
+        (gnu_inline_closed_integer_origin left && gnu_guard_scalar_update right)
+    | _ -> false end
+
+(* In the admitted loop subset every compiler query exits through return.
+   No query-bearing path reaches a back edge, so repeated guard entry cannot
+   reuse a query from an earlier iteration. Actual loop control is unchanged. *)
+val gnu_pointer_loop_queries_exit: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_pointer_loop_queries_exit stmt =
+  let self = gnu_pointer_loop_queries_exit in
+  let no_query expr = gnu_memory_expression_readonly expr && not (gnu_template_sensitive_expr true Nothing [] expr) in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSreturn _ -> true
+    | A.AilSreturnVoid -> true
+    | A.AilSskip -> true
+    | A.AilSexpr expr -> no_query expr
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif condition yes no -> no_query condition && self yes && self no
+    | A.AilSdeclaration declarations -> List.all (fun (_, value) -> maybe true no_query value) declarations
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+val gnu_pointer_locally_handled:
+  map Symbol.sym (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  list (Symbol.sym * Symbol.sym) ->
+  list Symbol.sym -> list Symbol.sym -> bool -> A.statement GenTypes.genTypeCategory -> maybe bool
+let rec gnu_pointer_locally_handled predicates local_targets targets subjects queried stmt =
+  let self = gnu_pointer_locally_handled predicates local_targets targets subjects in
+  let safe expr = not (gnu_pointer_refinement_expr Nothing (fun _ _ -> Nothing) targets expr) in
+  (* GCC can reuse an earlier object-size query inside a later equality arm.
+     Until query identity/staging is represented, do not enable this exemption
+     across any earlier query or effectful expression that may hide one. *)
+  let staged expr = gnu_template_sensitive_expr true Nothing [] expr || not (gnu_memory_expression_readonly expr) in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> Nothing
+    | A.AilSskip -> Just queried
+    | A.AilSexpr expr -> if safe expr then Just (queried || staged expr) else Nothing
+    | A.AilSblock _ statements -> List.foldl (fun state child -> match state with
+        | Just before -> self before child | Nothing -> Nothing end) (Just queried) statements
+    | A.AilSif condition yes no ->
+        if not (safe condition || (not queried &&
+            (gnu_pointer_handled_condition predicates subjects condition ||
+             gnu_guard_stage_opaque predicates local_targets subjects condition))) then Nothing else
+        let before = queried || staged condition in
+        (match (self before yes, self before no) with
+          | (Just first, Just second) -> Just (first || second)
+          | _ -> Nothing end)
+    | A.AilSreturnVoid -> Just queried
+    | A.AilSreturn expr -> if safe expr then Just (queried || staged expr) else Nothing
+    | A.AilSdeclaration declarations ->
+        if List.all (fun (_, value) -> maybe true safe value) declarations then
+          Just (queried || List.any (fun (_, value) -> maybe false staged value) declarations)
+        else Nothing
+    | A.AilSwhile condition body _ ->
+        if safe condition && gnu_pointer_loop_test condition && gnu_pointer_loop_queries_exit body
+        then self queried body else Nothing
+    | A.AilSdo body condition _ ->
+        if safe condition && gnu_pointer_loop_test condition && gnu_pointer_loop_queries_exit body
+        then self queried body else Nothing
+    | A.AilSlabel _ body _ -> self queried body
+    | A.AilSgoto _ -> Just queried
+    | A.AilSbreak -> Just queried
+    | A.AilScontinue -> Just queried
+    | A.AilSmarker _ body -> self queried body
+    (* Switch and parallel continuations retain the unsupported boundary. *)
+    | _ -> Nothing
+  end
+
+(* Only a private one-argument predicate with an effect-free Boolean return may
+   refine a direct caller. Attribute contracts outside the ordinary/inline
+   subset deny the summary; calls and argument evaluation are never replaced. *)
+val gnu_guard_boolean_returns:
+  A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory) -> maybe (A.expression GenTypes.genTypeCategory) ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let gnu_guard_boolean_returns (A.AnnotatedExpression ty annots loc node as condition) yes no =
+  let constant = maybe Nothing (gnu_scalar_closed_integer Map.empty) in
+  if gnu_size_effects condition <> Just false then Nothing else match node with
+    | A.AilEbinary left bop right ->
+        if not (gnu_scalar_is_equality bop) then Nothing else
+        if constant yes = Just 1 && constant no = Just 0 then Just condition
+        else if constant yes = Just 0 && constant no = Just 1 then
+          Just (A.AnnotatedExpression ty annots loc
+            (A.AilEbinary left (if bop = A.Eq then A.Ne else A.Eq) right))
+        else Nothing
+    | _ -> Nothing
+  end
+
+val gnu_guard_return:
+  A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_guard_return stmt = match stmt.A.node with
+  | A.AilSvla_scope _ _ _ _ -> Nothing
+  | A.AilSreturn expr -> Just expr
+  | A.AilSblock [] [body] -> gnu_guard_return body
+  | A.AilSif condition yes no ->
+      gnu_guard_boolean_returns condition (gnu_guard_return yes) (gnu_guard_return no)
+  | A.AilSblock [] [branch; fallback] ->
+      (match branch.A.node with
+        | A.AilSif condition yes no -> (match no.A.node with
+            | A.AilSskip -> gnu_guard_boolean_returns condition
+                (gnu_guard_return yes) (gnu_guard_return fallback)
+            | _ -> Nothing end)
+        | _ -> Nothing end)
+  | A.AilSmarker _ body -> gnu_guard_return body
+  | _ -> Nothing
+end
+
+val gnu_guard_predicate_map:
+  A.sigma GenTypes.genTypeCategory -> map Symbol.sym (Symbol.sym * A.expression GenTypes.genTypeCategory)
+let gnu_guard_predicate_map sigm =
+  (* Require the actual one-formal definition and declaration types below;
+     a prototype flag alone cannot establish this predicate's body contract. *)
+  let has_external_name sym = Map_extra.fold (fun _ declarations found ->
+    found || List.any (fun (declared, _) -> declared = sym) declarations) sigm.A.extern_idmap false in
+  Map.fromList (List.foldr (fun (sym, (_, _, _, params, body)) acc ->
+    if has_external_name sym then acc else match (params, gnu_guard_return body, List.lookup sym sigm.A.declarations) with
+      | ([formal], Just expr, Just (_, (Annot.Attrs attrs), A.Decl_function _ (_, return_ty) [_] false _ false)) ->
+          let attrs_ok = List.all (fun attr -> Cerb_attributes.is_typeof_expr_origin attr || List.any (fun name ->
+            Cerb_attributes.has_gnu_noarg_attribute name (Annot.Attrs [attr]))
+              ["always_inline"; "gnu_inline"; "artificial"]) attrs in
+          if attrs_ok && return_ty = ctype_of expr && gnu_size_effects expr = Just false then
+            (sym, (formal, expr)) :: acc else acc
+      | _ -> acc end
+  ) [] sigm.A.function_definitions)
+
+(* Closed private noinline IPA facts require a complete typed-use census.
+   A non-call reference, unknown AIL form or inline assembly denies the census.
+   No caller expression is retained in a formal's fact. *)
+val gnu_ipa_merge_uses: forall 'a. list (maybe (list 'a)) -> maybe (list 'a)
+let gnu_ipa_merge_uses results = List.foldr (fun result acc -> match (result, acc) with
+  | (Just first, Just rest) -> Just (first ++ rest)
+  | _ -> Nothing end) (Just []) results
+
+val gnu_ipa_direct_target: Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_ipa_direct_target target (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEident sym -> sym = target
+  | A.AilEfunction_decay operand -> gnu_ipa_direct_target target operand
+  | A.AilEannot _ operand -> gnu_ipa_direct_target target operand
+  | _ -> false
+end
+
+(* A literal C condition has no runtime-dependent edge. Count only the
+   selected arm in the private callsite census; unknown tests keep both. *)
+val gnu_ipa_literal_truth: A.expression GenTypes.genTypeCategory -> maybe bool
+let rec gnu_ipa_literal_truth (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEconst (A.ConstantInteger (A.IConstant value _ _)) -> Just (value <> 0)
+    | A.AilEannot _ operand -> gnu_ipa_literal_truth operand
+    | _ -> Nothing
+  end
+
+val gnu_ipa_uses_expr: Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  maybe (list (list (A.expression GenTypes.genTypeCategory)))
+let rec gnu_ipa_uses_expr target (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_ipa_uses_expr target in
+  let merge = gnu_ipa_merge_uses in match node with
+    | A.AilEident sym -> if sym = target then Nothing else Just []
+    | A.AilEcall callee args ->
+        let nested = merge (List.map self args) in
+        if gnu_ipa_direct_target target callee then
+          maybe Nothing (fun uses -> Just (args :: uses)) nested
+        else merge [self callee; nested]
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> merge [self left; self right]
+    | A.AilEassign left right -> merge [self left; self right]
+    | A.AilEcompoundAssign left _ right -> merge [self left; self right]
+    | A.AilEcond test yes no -> merge [self test; maybe (Just []) self yes; self no]
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEassert operand -> self operand
+    | A.AilEgeneric operand _ associations -> merge (self operand :: List.map (fun association ->
+        match association with
+          | A.AilGAtype _ _ value -> self value
+          | A.AilGAdefault value -> self value end) associations)
+    | A.AilEarray _ _ elements -> merge (List.map (maybe (Just []) self) elements)
+    | A.AilEstruct _ members -> merge (List.map (fun (_, value) -> maybe (Just []) self value) members)
+    | A.AilEunion _ _ value -> maybe (Just []) self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEsizeof_expr operand -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEva_start operand _ -> self operand
+    | A.AilEva_arg operand _ -> self operand
+    | A.AilEva_copy left right -> merge [self left; self right]
+    | A.AilEva_end operand -> self operand
+    | A.AilEprint_type operand -> self operand
+    | A.AilEbmc_assume operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEatomic operand -> self operand
+    | A.AilEgcc_statement _ statements -> merge (List.map (gnu_ipa_uses_stmt target) statements)
+    | A.AilEbuiltin (A.AilBGNU_asm _ _ _ _ _ _) -> Nothing
+    | A.AilEbuiltin _ -> Just []
+    | A.AilEstr _ -> Just []
+    | A.AilEconst _ -> Just []
+    | A.AilEsizeof _ _ -> Just []
+    | A.AilEalignof _ _ -> Just []
+    | A.AilEoffsetof _ _ -> Just []
+    | A.AilEreg_load _ -> Just []
+    | A.AilEinvalid _ _ -> Nothing
+  end
+and gnu_ipa_uses_stmt target stmt =
+  let self = gnu_ipa_uses_stmt target in
+  let expr = gnu_ipa_uses_expr target in
+  let merge = gnu_ipa_merge_uses in match stmt.A.node with
+    | A.AilSvla_scope _ captures _ body -> merge (List.map (fun (_, value) -> expr value) captures ++ [self body])
+    | A.AilSskip -> Just []
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> merge (List.map self statements)
+    | A.AilSif test yes no ->
+        (match gnu_ipa_literal_truth test with
+          | Just true -> merge [expr test; self yes]
+          | Just false -> merge [expr test; self no]
+          | Nothing -> merge [expr test; self yes; self no]
+        end)
+    | A.AilSwhile test body _ -> merge [expr test; self body]
+    | A.AilSdo body test _ -> merge [self body; expr test]
+    | A.AilSbreak -> Just []
+    | A.AilScontinue -> Just []
+    | A.AilSreturnVoid -> Just []
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch operand body -> merge [expr operand; self body]
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> Just []
+    | A.AilSdeclaration declarations -> merge (List.map (fun (_, value) -> maybe (Just []) expr value) declarations)
+    | A.AilSpar statements -> merge (List.map self statements)
+    | A.AilSreg_store _ operand -> expr operand
+    | A.AilSmarker _ body -> self body
+  end
+
+val gnu_ipa_closed_integer: Core.core_tag_definitions -> A.expression GenTypes.genTypeCategory -> maybe integer
+let rec gnu_ipa_closed_integer tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_ipa_closed_integer tagDefs in
+  let cast ty value = maybe Nothing (fun (value, _, _) -> Just value)
+    (gnu_scalar_cast ty (value, value, true)) in
+  match node with
+    | A.AilEconst (A.ConstantInteger (A.IConstant value _ _)) -> cast (ctype_of expr) value
+    | A.AilEconst (A.ConstantPredefined A.PConstantFalse) -> Just 0
+    | A.AilEconst (A.ConstantPredefined A.PConstantTrue) -> Just 1
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ ty operand -> maybe Nothing (cast ty) (self operand)
+    | A.AilEunary A.Plus operand -> maybe Nothing (cast (ctype_of expr)) (self operand)
+    | A.AilEunary A.Minus operand -> maybe Nothing
+        (gnu_scalar_integer_binary (ctype_of expr) (A.Arithmetic A.Sub) 0) (self operand)
+    | A.AilEbinary left bop right ->
+        (match (self left, self right, gnu_scalar_common_type (ctype_of left) (ctype_of right)) with
+          | (Just a, Just b, Just common) -> (match (cast common a, cast common b) with
+              | (Just first, Just second) -> gnu_scalar_integer_binary (ctype_of expr) bop first second
+              | _ -> Nothing end)
+          | _ -> Nothing end)
+    | A.AilEsizeof _ ty -> gnu_scalar_sizeof tagDefs ty
+    | A.AilEsizeof_expr operand -> gnu_scalar_sizeof tagDefs (ctype_of operand)
+    | _ -> Nothing
+  end
+
+val gnu_ipa_noinline_attributes: Annot.attributes -> bool
+let gnu_ipa_noinline_attributes (Annot.Attrs attrs as all_attrs) =
+  Cerb_attributes.has_gnu_noarg_attribute "noinline" all_attrs &&
+  List.all (fun attr -> Cerb_attributes.is_typeof_expr_origin attr ||
+    match (attr.Annot.attr_ns, attr.Annot.attr_id, attr.Annot.attr_args) with
+    | (Just (Symbol.Identifier _ "gnu"), Symbol.Identifier _ name, []) ->
+        name = "noinline" || name = "__noinline__" || name = "noclone" || name = "__noclone__"
+    | _ -> false end) attrs
+
+(* An assembler declaration is relevant only if its target spelling could
+   denote this function (or its declared GNU inline identity). Hidden compiler
+   builtins have ordinary library aliases, so a TU-wide asm-label ban disables
+   every summary even in source with no assembler declarations. Undecodable
+   aliases and unnameable candidates remain conservative refusals. *)
+val gnu_asm_label_declarations:
+  A.sigma GenTypes.genTypeCategory -> list (Symbol.sym * Annot.attribute)
+let gnu_asm_label_declarations sigm =
+  List.foldr (fun (sym, (_, Annot.Attrs attrs, _)) found ->
+    List.foldr (fun attr found ->
+      if Cerb_attributes.is_gnu_asm_label attr then (sym, attr) :: found
+      else found) found attrs) [] sigm.A.declarations
+
+val gnu_function_asm_census_safe_with:
+  map Symbol.sym string -> A.sigma GenTypes.genTypeCategory ->
+  list (Symbol.sym * Annot.attribute) -> Symbol.sym -> bool
+let gnu_function_asm_census_safe_with linker_names sigm asm_decls target =
+  let owners = target :: List.map fst (List.filter (fun (_, body) -> body = target)
+    (Map_extra.toList sigm.A.gnu_inline_bodies)) in
+  let names = List.foldl (fun names sym ->
+    let names = match Symbol.symbol_description sym with
+      | Symbol.SD_Id name -> name :: names
+      | Symbol.SD_ObjectAddress name -> name :: names
+      | _ -> names end in
+    maybe names (fun name -> name :: names) (Map.lookup sym linker_names)) [] owners in
+  List.all (fun (sym, attr) ->
+    if names = [] || List.elem sym owners then false else
+    match Cerb_attributes.decode_gnu_asm_label attr with
+      | Nothing -> false
+      | Just (Symbol.Identifier _ name) -> not (List.elem name names)
+    end) asm_decls
+
+val gnu_function_asm_census_safe:
+  map Symbol.sym string -> A.sigma GenTypes.genTypeCategory -> Symbol.sym -> bool
+let gnu_function_asm_census_safe linker_names sigm target =
+  gnu_function_asm_census_safe_with linker_names sigm
+    (gnu_asm_label_declarations sigm) target
+
+
+(* The effective GNU-inline map excludes an owner with an ordinary definition.
+   A declaration-only assembler alias of that owner's external symbol does not
+   replace its selected inline body. Keep this narrower certificate separate
+   from the ordinary function-summary alias census: every alias must decode,
+   and an alias with a body or its own inline mapping defeats the certificate.
+   The alias call inside the admitted body is still analyzed independently. *)
+val gnu_forced_inline_body_aliases_safe:
+  map Symbol.sym string -> A.sigma GenTypes.genTypeCategory -> Symbol.sym -> bool
+let gnu_forced_inline_body_aliases_safe linker_names sigm target =
+  let owners = List.map fst (List.filter (fun (_, body) -> body = target)
+    (Map_extra.toList sigm.A.gnu_inline_bodies)) in
+  let names = List.foldl (fun names sym ->
+    let names = match Symbol.symbol_description sym with
+      | Symbol.SD_Id name -> name :: names
+      | _ -> names end in
+    maybe names (fun name -> name :: names) (Map.lookup sym linker_names)) [] owners in
+  not (List.null owners) && not (List.null names) &&
+  not (Map.member target linker_names) &&
+  List.all (fun sym -> not (isJust (List.lookup sym sigm.A.function_definitions))) owners &&
+  List.all (fun (sym, (_, Annot.Attrs attrs, declaration)) ->
+    List.all (fun attr ->
+      if not (Cerb_attributes.is_gnu_asm_label attr) then true else
+      if sym = target || List.elem sym owners then false else
+      match Cerb_attributes.decode_gnu_asm_label attr with
+        | Nothing -> false
+        | Just (Symbol.Identifier _ name) ->
+            if not (List.elem name names) then true else
+            not (isJust (List.lookup sym sigm.A.function_definitions)) &&
+            not (Map.member sym sigm.A.gnu_inline_bodies) &&
+            match declaration with
+              | A.Decl_function _ _ _ _ _ _ -> true
+              | _ -> false end
+      end) attrs) sigm.A.declarations
+
+(* Ordinary private bodies reached only through explicitly volatile function
+   pointer storage have an opaque call boundary in the configured GNU profile.
+   The census must account for every reference: direct calls retain their
+   separate specialization, and every other reference denies certification.
+   This is a compiler-stage certificate, not a runtime pointer-value rewrite. *)
+val gnu_volatile_function_pointer: Ctype.qualifiers -> Ctype.ctype -> bool
+let gnu_volatile_function_pointer qs ty =
+  qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && match ty with
+    | Ctype.Ctype _ (Ctype.Pointer _ pointed) -> AilTypesAux.is_function pointed
+    | _ -> false end
+
+(* Passing an exact function address to a direct ordinary external receiver
+   establishes a compiler-opaque callback boundary. This certifies an actual
+   address use, never an unresolved indirect-call lookup or a missing fact. *)
+val gnu_registered_callback_address:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_registered_callback_address target (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_registered_callback_address target in
+  let ty = ctype_of expr in
+  if not (AilTypesAux.is_function ty || AilTypesAux.is_pointer_to_function ty)
+  then false else match node with
+    | A.AilEident sym -> sym = target && AilTypesAux.is_function ty
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEunary A.Address operand -> AilTypesAux.is_function (ctype_of operand) && self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> gnu_compatible_function_pointer ty (ctype_of operand) && self operand
+    | _ -> false
+  end
+
+val gnu_volatile_address_expression:
+  list Symbol.sym -> Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> maybe (list bool)
+let rec gnu_volatile_address_expression receivers target objects (A.AnnotatedExpression _ _ _ node) =
+  let self = gnu_volatile_address_expression receivers target objects in
+  let no_registration = gnu_volatile_address_expression [] target objects in
+  let merge = gnu_ipa_merge_uses in match node with
+    | A.AilEident sym -> if sym = target then Nothing else Just []
+    | A.AilEcall callee args ->
+        let receiver = List.any (fun sym -> gnu_ipa_direct_target sym callee) receivers &&
+          List.all gnu_memory_expression_readonly args in
+        let builtin = match callee with
+          | A.AnnotatedExpression _ _ _ (A.AilEbuiltin _) -> true
+          | _ -> false end in
+        let nested = merge (List.map (fun operand ->
+          if receiver && gnu_registered_callback_address target operand then Just [true]
+          else if builtin then no_registration operand else self operand) args) in
+        if gnu_ipa_direct_target target callee then nested else merge [self callee; nested]
+    | A.AilEassign left right ->
+        (* The assignment value can escape without a volatile load. Only a
+           discarded plain expression statement admits the store below. *)
+        merge [self left; self right]
+    | A.AilEunary _ operand -> self operand
+    | A.AilEbinary left _ right -> merge [no_registration left; no_registration right]
+    | A.AilEcompoundAssign left _ right -> merge [self left; self right]
+    | A.AilEcond test yes no -> merge [no_registration test; maybe (Just []) no_registration yes; no_registration no]
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEassert operand -> self operand
+    | A.AilEgeneric operand _ associations -> merge (no_registration operand :: List.map (fun association ->
+        match association with
+          | A.AilGAtype _ _ value -> no_registration value
+          | A.AilGAdefault value -> no_registration value end) associations)
+    | A.AilEarray _ _ values -> merge (List.map (maybe (Just []) self) values)
+    | A.AilEstruct _ members -> merge (List.map (fun (_, value) -> maybe (Just []) self value) members)
+    | A.AilEunion _ _ value -> maybe (Just []) self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEsizeof_expr operand -> no_registration operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEva_start operand _ -> self operand
+    | A.AilEva_arg operand _ -> self operand
+    | A.AilEva_copy left right -> merge [self left; self right]
+    | A.AilEva_end operand -> self operand
+    | A.AilEprint_type operand -> self operand
+    | A.AilEbmc_assume operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEarray_decay operand -> self operand
+    | A.AilEfunction_decay operand -> self operand
+    | A.AilEatomic operand -> self operand
+    | A.AilEgcc_statement _ statements ->
+        (* The tail expression can return its assignment value. Until result
+           contexts are certified, admit direct calls but no target addresses. *)
+        maybe Nothing (fun _ -> Just [])
+          (gnu_ipa_merge_uses (List.map (gnu_ipa_uses_stmt target) statements))
+    | A.AilEbuiltin (A.AilBGNU_asm _ _ _ _ _ _) -> Nothing
+    | A.AilEbuiltin _ -> Just []
+    | A.AilEstr _ -> Just []
+    | A.AilEconst _ -> Just []
+    | A.AilEsizeof _ _ -> Just []
+    | A.AilEalignof _ _ -> Just []
+    | A.AilEoffsetof _ _ -> Just []
+    | A.AilEreg_load _ -> Just []
+    | A.AilEinvalid _ _ -> Nothing
+  end
+and gnu_volatile_address_statement receivers target objects stmt =
+  let self = gnu_volatile_address_statement receivers target objects in
+  let nested = gnu_volatile_address_statement [] target objects in
+  let expr = gnu_volatile_address_expression [] target objects in
+  let merge = gnu_ipa_merge_uses in match stmt.A.node with
+    | A.AilSvla_scope _ captures _ body ->
+        merge (List.map (fun (_, value) -> expr value) captures ++ [self body])
+    | A.AilSskip -> Just []
+    | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEassign left right) as operand) ->
+        let (qs, ty) = qualified_ctype_of left in
+        if gnu_volatile_function_pointer qs ty && gnu_ipa_direct_target target right
+        then merge [expr left; Just [true]] else expr operand
+    | A.AilSexpr operand -> gnu_volatile_address_expression receivers target objects operand
+    | A.AilSblock bindings statements ->
+        let locals = List.map fst (List.filter (fun (_, (_, _, qs, ty)) ->
+          gnu_volatile_function_pointer qs ty) bindings) in
+        merge (List.map (gnu_volatile_address_statement receivers target (locals ++ objects)) statements)
+    | A.AilSif test yes no -> merge [expr test; nested yes; nested no]
+    | A.AilSwhile test body _ -> merge [expr test; nested body]
+    | A.AilSdo body test _ -> merge [nested body; expr test]
+    | A.AilSbreak -> Just []
+    | A.AilScontinue -> Just []
+    | A.AilSreturnVoid -> Just []
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch operand body -> merge [expr operand; nested body]
+    | A.AilScase _ body -> nested body
+    | A.AilScase_rangeGNU _ _ body -> nested body
+    | A.AilSdefault body -> nested body
+    | A.AilSlabel _ body _ -> nested body
+    | A.AilSgoto _ -> Just []
+    | A.AilSdeclaration declarations -> merge (List.map (fun (sym, value) ->
+        match value with
+          | Just operand -> if List.elem sym objects && gnu_ipa_direct_target target operand
+              then Just [true] else expr operand
+          | Nothing -> Just [] end) declarations)
+    | A.AilSpar statements -> merge (List.map nested statements)
+    | A.AilSreg_store _ operand -> expr operand
+    | A.AilSmarker _ body -> self body
+  end
+
+(* A private inline, zero-argument wrapper that only returns one function
+   address preserves that exact address. A volatile function-pointer store of
+   its result is an opaque call boundary for the returned function. *)
+val gnu_ipa_direct_address_return:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_ipa_direct_address_return target stmt = match stmt.A.node with
+  | A.AilSreturn value ->
+      gnu_ipa_direct_target target value && gnu_size_effects value = Just false
+  | A.AilSblock [] [body] -> gnu_ipa_direct_address_return target body
+  | _ -> false
+end
+
+val gnu_ipa_zero_arg_wrapper_call:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_ipa_zero_arg_wrapper_call wrappers (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEcall callee [] ->
+        List.any (fun wrapper -> gnu_ipa_direct_target wrapper callee) wrappers
+    | A.AilEannot _ operand -> gnu_ipa_zero_arg_wrapper_call wrappers operand
+    | A.AilEcast _ _ operand -> gnu_ipa_zero_arg_wrapper_call wrappers operand
+    | _ -> false
+  end
+
+val gnu_volatile_inline_wrapper_use:
+  list Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let gnu_volatile_inline_wrapper_use wrappers stmt = match stmt.A.node with
+  | A.AilSblock bindings statements ->
+      let locals = List.map fst (List.filter (fun (_, (_, _, qs, ty)) ->
+        gnu_volatile_function_pointer qs ty) bindings) in
+      List.any (fun statement -> match statement.A.node with
+        | A.AilSdeclaration declarations ->
+            List.any (fun (sym, value) -> List.elem sym locals &&
+              maybe false (gnu_ipa_zero_arg_wrapper_call wrappers) value)
+              declarations
+        | _ -> false end) statements
+  | _ -> false
+end
+
+val gnu_volatile_address_targets:
+  map Symbol.sym string -> A.sigma GenTypes.genTypeCategory -> list Symbol.sym
+let gnu_volatile_address_targets linker_names sigm =
+  if not (Implementation.has_amd64_sysv_abi ()) then [] else
+  let asm_decls = gnu_asm_label_declarations sigm in
+  (* Only ordinary typed, undefined external functions may receive callbacks.
+     Attributes, compiler-known library calls, aliases and variadic signatures
+     do not establish this certificate. Registration is admitted only as a
+     straight-line expression statement, never in unevaluated/control operands. *)
+  let receivers = List.foldr (fun (sym, (_, Annot.Attrs attrs, declaration)) acc ->
+    match (declaration, Map.lookup sym linker_names) with
+      | (A.Decl_function _ _ _ false false false, Just name) ->
+          if isJust (List.lookup sym sigm.A.function_definitions) ||
+              Map.member sym sigm.A.gnu_inline_bodies || gnu_compiler_library_name name ||
+              not (List.all Cerb_attributes.is_typeof_expr_origin attrs) ||
+              not (gnu_function_asm_census_safe_with linker_names sigm asm_decls sym)
+          then acc else sym :: acc
+      | _ -> acc
+    end) [] sigm.A.declarations in
+  List.foldr (fun (target, _) acc ->
+    if Map.member target linker_names || Map.member target sigm.A.gnu_inline_bodies ||
+        List.elem target (List.map snd (Map_extra.toList sigm.A.gnu_inline_bodies)) ||
+        not (gnu_function_asm_census_safe_with linker_names sigm asm_decls target) then acc else
+    match List.lookup target sigm.A.declarations with
+      | Just (_, Annot.Attrs attrs, A.Decl_function _ _ _ false false false) ->
+          if not (List.all Cerb_attributes.is_typeof_expr_origin attrs ||
+              gnu_ipa_noinline_attributes (Annot.Attrs attrs)) then acc else
+          let wrappers = List.foldr (fun (wrapper, (_, _, _, params, body)) found ->
+            if params <> [] || Map.member wrapper linker_names ||
+               not (gnu_function_asm_census_safe_with linker_names sigm asm_decls wrapper) ||
+               not (gnu_ipa_direct_address_return target body) then found else
+            match List.lookup wrapper sigm.A.declarations with
+              | Just (_, Annot.Attrs wrapper_attrs,
+                  A.Decl_function _ (_, return_ty) [] false true false) ->
+                  if AilTypesAux.is_pointer_to_function return_ty &&
+                     List.all Cerb_attributes.is_typeof_expr_origin wrapper_attrs
+                  then wrapper :: found else found
+              | _ -> found end) [] sigm.A.function_definitions in
+          let wrapper_volatile_use = wrappers <> [] &&
+            List.any (fun (_, (_, _, _, _, body)) ->
+              gnu_volatile_inline_wrapper_use wrappers body)
+              sigm.A.function_definitions in
+          let results =
+            List.map (fun (sym, value) ->
+              let volatile = match List.lookup sym sigm.A.declarations with
+                | Just (_, _, A.Decl_object _ _ qs ty) -> gnu_volatile_function_pointer qs ty
+                | _ -> false end in
+              if volatile && gnu_ipa_direct_target target value then Just [true]
+              else gnu_volatile_address_expression [] target [] value) sigm.A.object_definitions ++
+            List.map (fun (value, _) -> gnu_volatile_address_expression [] target [] value) sigm.A.static_assertions ++
+            List.map (fun (owner, (_, _, _, _, body)) ->
+              if List.elem owner wrappers then Just [] else
+                gnu_volatile_address_statement receivers target [] body)
+              sigm.A.function_definitions ++
+            [if wrapper_volatile_use then Just [true] else Just []] in
+          (match gnu_ipa_merge_uses results with
+            | Just (_ :: _) -> target :: acc
+            | _ -> acc end)
+      | _ -> acc end
+  ) [] sigm.A.function_definitions
+
+
+val gnu_private_ipa_facts:
+  Core.core_tag_definitions -> map Symbol.sym string -> A.sigma GenTypes.genTypeCategory ->
+  list (Symbol.sym * list (Symbol.sym * E.gnu_inline_fact))
+let gnu_private_ipa_facts tagDefs linker_names sigm =
+  (* A typed definition need not have a separate prototype declaration.
+     Its formal names and completed parameter types are checked below. *)
+  if not (Implementation.has_amd64_sysv_abi ()) ||
+      not (List.all (fun (_, body) -> isJust (List.lookup body sigm.A.function_definitions))
+        (Map_extra.toList sigm.A.gnu_inline_bodies)) then [] else
+  let unused_private = List.foldr (fun (candidate, _) found ->
+    if Map.member candidate linker_names ||
+       not (gnu_function_asm_census_safe linker_names sigm candidate) then found else
+    match List.lookup candidate sigm.A.declarations with
+      | Just (_, attrs, A.Decl_function _ _ _ false false false) ->
+          if not (Cerb_attributes.has_gnu_noarg_attribute "unused" attrs) then found else
+          let uses = gnu_ipa_merge_uses (
+            List.map (fun (_, value) -> gnu_ipa_uses_expr candidate value)
+              sigm.A.object_definitions ++
+            List.map (fun (value, _) -> gnu_ipa_uses_expr candidate value)
+              sigm.A.static_assertions ++
+            List.map (fun (_, (_, _, _, _, stmt)) -> gnu_ipa_uses_stmt candidate stmt)
+              sigm.A.function_definitions) in
+          if uses = Just [] then candidate :: found else found
+      | _ -> found end) [] sigm.A.function_definitions in
+  List.foldr (fun (target, (_, _, _, names, body)) acc ->
+    if not (gnu_function_asm_census_safe linker_names sigm target) ||
+       Map.member target linker_names || Map.member target sigm.A.gnu_inline_bodies ||
+       List.elem target (List.map snd (Map_extra.toList sigm.A.gnu_inline_bodies)) then acc else
+    match List.lookup target sigm.A.declarations with
+      | Just (_, attrs, A.Decl_function _ _ params false false false) ->
+          if not (gnu_ipa_noinline_attributes attrs) || List.length names <> List.length params then acc else
+          let function_uses = List.map (fun (caller, (_, _, _, _, stmt)) ->
+            (caller, if List.elem caller unused_private then Just [] else
+              gnu_ipa_uses_stmt target stmt)) sigm.A.function_definitions in
+          let census = gnu_ipa_merge_uses (
+            List.map (fun (_, expr) -> gnu_ipa_uses_expr target expr) sigm.A.object_definitions ++
+            List.map (fun (expr, _) -> gnu_ipa_uses_expr target expr) sigm.A.static_assertions ++
+            List.map snd function_uses) in
+          let main_calls = gnu_ipa_merge_uses (List.map (fun (caller, uses) ->
+            if Map.lookup caller linker_names = Just "main" then uses else Just [])
+            function_uses) in
+          (match census with
+            | Just (first :: rest) ->
+                let calls = first :: rest in
+                if not (List.all (fun args -> List.length args = List.length params) calls) then acc else
+                let facts = List.foldr (fun (index, (name, (qs, ty, _))) facts ->
+                  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_integer ty) ||
+                      not (gnu_branch_symbol_unchanged name body) then facts else
+                  let values = List.map (fun args -> match List.index args index with
+                    | Nothing -> Nothing
+                    | Just arg -> maybe Nothing (fun value ->
+                        maybe Nothing (fun (converted, _, _) -> Just converted)
+                          (gnu_scalar_cast ty (value, value, true))) (gnu_ipa_closed_integer tagDefs arg)
+                    end) calls in
+                  let sole_volatile_actual = match (calls, values) with
+                    | ([args], [Nothing]) ->
+                        (match List.index args index with
+                          | Just (A.AnnotatedExpression _ _ _ (A.AilErvalue operand)) ->
+                              let (actual_qs, actual_ty) = qualified_ctype_of operand in
+                              actual_qs.Ctype.volatile && AilTypesAux.is_integer actual_ty
+                          | _ -> false end)
+                    | _ -> false end in
+                  if sole_volatile_actual then
+                    (match gnu_scalar_type_bounds ty with
+                      | Just (low, high) ->
+                          (name, E.GNU_inline_integer_range_fact low high true) :: facts
+                      | Nothing -> facts end)
+                  else match values with
+                    | Just value :: rest_values ->
+                        let bounds = List.foldl (fun bounds other -> match (bounds, other) with
+                          | (Just (low, high), Just n) -> Just (min low n, max high n)
+                          | _ -> Nothing end) (Just (value, value)) rest_values in
+                        (match bounds with
+                          | Just (low, high) ->
+                              if low = high then
+                                (* The complete census and unchanged-formal check
+                                   justify a closed literal with no caller loads.
+                                   Unrelated effects cannot alter that formal. *)
+                                (name, E.GNU_inline_integer_fact
+                                  (A.AnnotatedExpression (GenTypes.GenRValueType (GenTypes.inject_type ty))
+                                    [] Loc.unknown (A.AilEconst
+                                      (A.ConstantInteger (A.IConstant low A.Decimal Nothing))))) :: facts
+                              else
+                                let distinct = List.foldr (fun item found -> match item with
+                                  | Just n -> if List.elem n found then found else n :: found
+                                  | Nothing -> found end) [] values in
+                                let step = List.foldl (fun candidate n ->
+                                  let gap = n-low in
+                                  if gap <= 0 then candidate else min candidate gap)
+                                  (high-low) distinct in
+                                (* Only a complete progression of direct callsites
+                                   in main supplies compiler alternatives. Other
+                                   callers and dead functions retain the hull. *)
+                                let exact_main_calls = match main_calls with
+                                  | Just main -> List.length main = List.length calls
+                                  | Nothing -> false end in
+                                if exact_main_calls && step > 0 &&
+                                   (high-low) mod step = 0 &&
+                                   List.all (fun n -> (n-low) mod step = 0 &&
+                                     (n = high || List.elem (n+step) distinct)) distinct
+                                then (name, E.GNU_inline_integer_progression_fact low high step) :: facts
+                                else (name, E.GNU_inline_integer_range_fact low high false) :: facts
+                          | Nothing -> facts end)
+                    | _ -> facts
+                    end
+                ) [] (List.mapi (fun index pair -> (index, pair)) (List.zip names params)) in
+                if facts = [] then acc else (target, facts) :: acc
+            | _ -> acc end)
+      | _ -> acc end
+  ) [] sigm.A.function_definitions
+
+(* Visible-body summaries use the same fixed GNU native executable profile
+   as direct-call specialization. Do not extend this to interposable/PIC or
+   optimization-attribute profiles: only unadorned/always-inline definitions
+   and declarations qualify; assembler aliases to the candidate deny the census. *)
+val gnu_call_store_attributes: Annot.attributes -> bool
+let gnu_call_store_attributes (Annot.Attrs attrs) = List.all (fun attr ->
+  Cerb_attributes.is_typeof_expr_origin attr || match (attr.Annot.attr_ns, attr.Annot.attr_id, attr.Annot.attr_args) with
+    | (Just (Symbol.Identifier _ "gnu"), Symbol.Identifier _ name, []) ->
+        name = "always_inline" || name = "__always_inline__"
+    | _ -> false end) attrs
+
+(* A forced GNU-inline body has a separate source identity from its external
+   public symbol. These annotations do not hide body effects: artificial and
+   warn_unused_result concern diagnostics, and leaf/nothrow promises are not
+   used as effect facts. This admits the actual body for analysis only; callers
+   still check every expression and statement. Other attributes remain absent. *)
+val gnu_forced_inline_body_attributes: Annot.attributes -> bool
+let gnu_forced_inline_body_attributes (Annot.Attrs entries as attrs) =
+  Cerb_attributes.has_gnu_noarg_attribute "always_inline" attrs &&
+  Cerb_attributes.has_gnu_noarg_attribute "gnu_inline" attrs &&
+  List.all (fun attr -> Cerb_attributes.is_typeof_expr_origin attr ||
+    (* Prototype annotations supply no value or effect facts here.
+       Every body branch is still checked without assuming nonnull. *)
+    isJust (Cerb_attributes.decode_gnu_nonnull attr) ||
+    (Cerb_attributes.is_gnu_named_attribute "format" attr && List.length attr.Annot.attr_args = 3) ||
+    (Cerb_attributes.is_gnu_named_attribute "access" attr &&
+      List.elem (List.length attr.Annot.attr_args) [2; 3]) ||
+    match (attr.Annot.attr_ns, attr.Annot.attr_id, attr.Annot.attr_args) with
+      | (Just (Symbol.Identifier _ "gnu"), Symbol.Identifier _ name, []) ->
+          List.elem name ["always_inline"; "__always_inline__"; "gnu_inline"; "__gnu_inline__";
+            "artificial"; "__artificial__"; "warn_unused_result"; "__warn_unused_result__";
+            "nothrow"; "__nothrow__"; "leaf"; "__leaf__"]
+      | _ -> false end) entries
+
+(* This boundary certifies only memory writes. A noipa body can establish
+   their complete footprint without yielding caller-visible return/value IPA.
+   Keep gnu_ipa_noinline_attributes unchanged for return-summary consumers. *)
+val gnu_noinline_output_attributes: Annot.attributes -> bool
+let gnu_noinline_output_attributes (Annot.Attrs attrs as all_attrs) =
+  (Cerb_attributes.has_gnu_noarg_attribute "noinline" all_attrs ||
+   Cerb_attributes.has_gnu_noarg_attribute "noipa" all_attrs) &&
+  List.all (fun attr -> Cerb_attributes.is_typeof_expr_origin attr ||
+    match (attr.Annot.attr_ns, attr.Annot.attr_id, attr.Annot.attr_args) with
+      | (Just (Symbol.Identifier _ "gnu"), Symbol.Identifier _ name, []) ->
+          List.elem name ["noinline"; "__noinline__"; "noipa"; "__noipa__";
+            "noclone"; "__noclone__"]
+      | _ -> false end) attrs
+
+(* An unchanged by-value formal is captured before the body begins. Recognize
+   its source identity only; this memory-output census never propagates its
+   object size or contents through a non-inlined compiler boundary. *)
+val gnu_noinline_store_input:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_noinline_store_input params (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> List.elem sym params
+    | A.AilEannot _ operand -> gnu_noinline_store_input params operand
+    | A.AilEcast _ _ operand ->
+        gnu_function_target_type_equal (ctype_of expr) (ctype_of operand) &&
+          gnu_noinline_store_input params operand
+    | _ -> false
+  end
+
+(* A direct volatile integer load is a compiler-visible dynamic source.
+   It is still evaluated by the original callee; this classifier only audits
+   the source of a definite scalar output store. *)
+val gnu_noinline_scalar_volatile_input:
+  A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_noinline_scalar_volatile_input (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident _) as object_expr) ->
+        let (qs, ty) = qualified_ctype_of object_expr in
+        qs.Ctype.volatile && AilTypesAux.is_integer ty
+    | A.AilEannot _ operand -> gnu_noinline_scalar_volatile_input operand
+    | _ -> false
+  end
+
+val gnu_noinline_store_path:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  maybe (Symbol.sym * list Symbol.identifier)
+let rec gnu_noinline_store_path params (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEunary A.Indirection (A.AnnotatedExpression _ _ _ (A.AilErvalue
+        (A.AnnotatedExpression _ _ _ (A.AilEident sym)))) ->
+        if List.elem sym params then Just (sym, []) else Nothing
+    | A.AilEmemberofptr (A.AnnotatedExpression _ _ _ (A.AilErvalue
+        (A.AnnotatedExpression _ _ _ (A.AilEident sym)))) member ->
+        if List.elem sym params then Just (sym, [member]) else Nothing
+    | A.AilEmemberof base member -> maybe Nothing
+        (fun (sym, path) -> Just (sym, path ++ [member])) (gnu_noinline_store_path params base)
+    | A.AilEannot _ base -> gnu_noinline_store_path params base
+    | _ -> Nothing
+  end
+
+val gnu_noinline_store_outputs:
+  list Symbol.sym -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  maybe (list (Symbol.sym * list Symbol.identifier * bool))
+let gnu_noinline_store_outputs params output_params body =
+  if not (List.all (fun param -> gnu_inline_parameter_unchanged param body &&
+      gnu_alloc_size_subject_unescaped param body) params) then Nothing else
+  match gnu_call_store_statements body with
+    | Just (_, stores) ->
+        let outputs = List.map (fun (left, right) ->
+          let (qs, ty) = qualified_ctype_of left in
+          if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+              not (AilTypesAux.is_pointer ty || AilTypesAux.is_arithmetic ty) ||
+              not (maybe false (fun value ->
+                (gnu_memory_expression_readonly value &&
+                 (gnu_loop_address_constant value || gnu_inline_closed_integer_origin value ||
+                  (gnu_noinline_store_input params value &&
+                   gnu_function_target_type_equal ty (ctype_of value)))) ||
+                (AilTypesAux.is_integer ty &&
+                 gnu_function_target_type_equal ty (ctype_of value) &&
+                 gnu_noinline_scalar_volatile_input value)) right)
+          then Nothing else maybe Nothing
+            (fun (param, path) -> Just (param, path, AilTypesAux.is_pointer ty))
+            (gnu_noinline_store_path output_params left)) stores in
+        if outputs = [] || List.any isNothing outputs then Nothing else
+          Just (List.map (fromJust "Translation.gnu_noinline_store_outputs") outputs)
+    | _ -> Nothing
+  end
+
+(* Include every visible body, even those rejected by optional body summaries.
+   Attributed declarations and compiler-recognized library functions can expose
+   information without a body, so they must also be excluded by type. A missing
+   definition declaration invalidates the whole census instead of disappearing. *)
+val gnu_indirect_callable_census:
+  map Symbol.sym string -> A.sigma GenTypes.genTypeCategory -> maybe (list (Symbol.sym * Ctype.ctype))
+let gnu_indirect_callable_census linker_names sigm =
+  let defined sym = List.any (fun (target, _) -> target = sym) sigm.A.function_definitions in
+  let complete = List.all (fun (sym, _) -> match List.lookup sym sigm.A.declarations with
+    | Just (_, _, A.Decl_function _ _ _ _ _ _) -> true
+    | _ -> false end) sigm.A.function_definitions in
+  if not complete then Nothing else
+  Just (List.foldr (fun (sym, (_, attrs, declaration)) acc -> match declaration with
+    | A.Decl_function has_proto result params variadic _ _ ->
+        let recognized = maybe true gnu_compiler_library_name (Map.lookup sym linker_names) in
+        if defined sym || recognized || not (gnu_call_store_attributes attrs) then
+          let () = if not has_proto then Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+            "GNU indirect census nonprototype: " ^ show sym ^ "; parameters=" ^ show (List.length params) ^
+            "; definition=" ^ show (defined sym)) else () in
+          (sym, Ctype.Ctype [] (if has_proto then Ctype.Function result params variadic
+            else Ctype.FunctionNoParams result)) :: acc
+        else acc
+    | _ -> acc end) [] sigm.A.declarations)
+
+(* A retained incoming array element is a mutable fact at a later generic
+   entry, never a bound at the assignment. Certify the writer's boundary,
+   grounded value classes and the control/effect prefix of every store. *)
+val gnu_incoming_pointer_array_type: Ctype.ctype -> bool
+let gnu_incoming_pointer_array_type ty = match ty with
+  | Ctype.Ctype _ (Ctype.Pointer qs element) ->
+      not qs.Ctype.const && not qs.Ctype.volatile && not qs.Ctype.restrict &&
+        not (AilTypesAux.is_atomic element) && AilTypesAux.is_pointer element &&
+        not (AilTypesAux.is_pointer_to_function element)
+  | _ -> false
+end
+
+val gnu_incoming_array_mentions: Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_incoming_array_mentions subject (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilEident sym -> sym = subject
+    | _ -> maybe true (List.any (gnu_incoming_array_mentions subject)) (gnu_record_children expr)
+  end
+
+val gnu_incoming_array_body_mentions: Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_incoming_array_body_mentions subject stmt =
+  match gnu_record_statement_children stmt with
+    | Nothing -> true
+    | Just (expressions, children) ->
+        List.any (gnu_incoming_array_mentions subject) expressions ||
+          List.any (gnu_incoming_array_body_mentions subject) children
+  end
+
+(* An externally linked writer may have a compiler-visible address use through
+   volatile function-pointer storage. Its whole-TU use census must exclude
+   direct calls, ordinary aliases, callback escapes and unsupported syntax. *)
+val gnu_incoming_array_no_direct_call_expression:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_incoming_array_no_direct_call_expression source (A.AnnotatedExpression _ _ _ node as expr) =
+  let children = maybe false (List.all (gnu_incoming_array_no_direct_call_expression source))
+    (gnu_record_children expr) in
+  match node with
+    | A.AilEcall callee _ -> not (gnu_ipa_direct_target source callee) && children
+    | _ -> children
+  end
+
+val gnu_incoming_array_no_direct_call_statement:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_incoming_array_no_direct_call_statement source stmt =
+  match gnu_record_statement_children stmt with
+    | Nothing -> false
+    | Just (expressions, children) ->
+        List.all (gnu_incoming_array_no_direct_call_expression source) expressions &&
+          List.all (gnu_incoming_array_no_direct_call_statement source) children
+  end
+
+val gnu_incoming_array_source_uses_safe:
+  A.sigma GenTypes.genTypeCategory -> Symbol.sym -> bool
+let gnu_incoming_array_source_uses_safe sigm source =
+  List.all (fun (_, (_, _, _, _, body)) ->
+    if not (gnu_incoming_array_body_mentions source body) then true else
+    Implementation.has_amd64_sysv_abi () &&
+      gnu_incoming_array_no_direct_call_statement source body &&
+      (match gnu_volatile_address_statement [] source [] body with
+        | Just uses -> not (List.null uses) && List.all (fun found -> found) uses
+        | Nothing -> false end)) sigm.A.function_definitions
+
+(* Snapshot undefined external array pointers only in dominating readonly entry
+   declarations. Later writes to the external pointer cannot retarget the
+   unchanged private copy; the local's own address must never escape. *)
+val gnu_incoming_array_entry_copies:
+  list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list (A.statement GenTypes.genTypeCategory) -> list Symbol.sym
+let rec gnu_incoming_array_entry_copies external_arrays body statements = match statements with
+  | [] -> []
+  | stmt :: rest -> match stmt.A.node with
+      | A.AilSskip -> gnu_incoming_array_entry_copies external_arrays body rest
+      | A.AilSdeclaration declarations ->
+          if not (List.all (fun (_, value) ->
+              maybe true gnu_memory_expression_readonly value) declarations)
+          then [] else
+          List.foldr (fun (sym, value) acc ->
+            if not (gnu_alloc_return_automatic sym body &&
+                gnu_branch_symbol_unchanged sym body &&
+                gnu_alloc_size_subject_unescaped sym body) then acc else
+            match value with
+              | Just value -> (match gnu_pointer_array_root value with
+                  | Just global -> if List.elem global external_arrays then sym :: acc else acc
+                  | Nothing -> acc end)
+              | Nothing -> acc end) [] declarations ++
+            gnu_incoming_array_entry_copies external_arrays body rest
+      | _ -> [] end
+end
+
+(* Reject known addresses and integer/pointer encodings. A standard strlen
+   result supplies an integer displacement into its positively classified
+   input, without introducing a known object address. *)
+val gnu_incoming_array_value:
+  list Symbol.sym -> list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_incoming_array_value values roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_incoming_array_value values roots in
+  let every operands = E.mapM self operands >>= fun answers -> E.return (List.all (fun x -> x) answers) in
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      not (AilTypesAux.is_integer ty || AilTypesAux.is_pointer ty) ||
+      AilTypesAux.is_pointer_to_function ty then E.return false else
+  if gnu_literal_null_pointer expr then E.return true else match node with
+    | A.AilEconst (A.ConstantInteger _) -> E.return true
+    | A.AilEident sym -> E.return (List.elem sym values)
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        E.return (List.elem sym values)
+    | A.AilErvalue operand -> E.return
+        (maybe false (fun root -> List.elem root roots) (gnu_pointer_array_load_root operand))
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ result operand ->
+        if (AilTypesAux.is_integer result && AilTypesAux.is_integer (ctype_of operand)) ||
+            (AilTypesAux.is_pointer result && AilTypesAux.is_pointer (ctype_of operand))
+        then self operand else E.return false
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEunary A.PostfixIncr operand -> self operand
+    | A.AilEunary A.PostfixDecr operand -> self operand
+    | A.AilEbinary left _ right -> every [left; right]
+    | A.AilEcond test yes no -> every (test :: no :: maybe [] (fun x -> [x]) yes)
+    | A.AilEassign _ right -> self right
+    | A.AilEcompoundAssign left _ right -> every [left; right]
+    | A.AilEsizeof _ object_ty -> E.return (gnu_inline_fixed_object_type object_ty)
+    | A.AilEsizeof_expr operand -> E.return (gnu_inline_fixed_object_type (ctype_of operand))
+    | A.AilEcall callee [actual] ->
+        let char_pointer arg_ty = match arg_ty with
+          | Ctype.Ctype _ (Ctype.Pointer pointed_qs
+              (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)))) ->
+              not pointed_qs.Ctype.volatile
+          | _ -> false end in
+        let signature = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _
+              (Ctype.Function (_, result) [(_, arg_ty, _)] false))) ->
+              char_pointer arg_ty && isJust (gnu_scalar_type_bounds result) &&
+                gnu_scalar_type_bounds result = gnu_scalar_type_bounds Ctype.size_t
+          | _ -> false end in
+        if not (signature && char_pointer (ctype_of actual) &&
+            gnu_inline_direct_designator callee) then E.return false else
+        self actual >>= fun input ->
+        if not input then E.return false else
+        gnu_inline_function_target callee >>= (function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_has_source_definition target >>= fun defined ->
+              E.linker_name declared >>= fun name ->
+              E.return (not defined && name = Just "strlen")
+        end)
+    | _ -> E.return false
+  end
+
+val gnu_incoming_array_grow:
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym)
+let rec gnu_incoming_array_grow fuel candidates body values roots =
+  if fuel = 0 then E.return values else
+  E.foldlM (fun known sym ->
+    if List.elem sym known then E.return known else
+    gnu_boundary_origin_seed (gnu_incoming_array_value known roots) sym body >>= fun seeded ->
+    E.return (if seeded then sym :: known else known)) values candidates >>= fun next ->
+  if next = values then E.return values else
+    gnu_incoming_array_grow (fuel - 1) candidates body next roots
+
+val gnu_incoming_array_prune:
+  nat -> list Symbol.sym -> A.statement GenTypes.genTypeCategory ->
+  list Symbol.sym -> list Symbol.sym -> E.elabM (list Symbol.sym)
+let rec gnu_incoming_array_prune fuel candidates body values roots =
+  if fuel = 0 then E.return [] else
+  E.mapM (fun sym ->
+    if not (List.elem sym candidates) then E.return (sym, true) else
+    gnu_pointer_definition_statement (fun value ->
+      gnu_incoming_array_value values roots value >>= fun valid ->
+      E.return (if valid then Just true else Nothing)) sym body >>= fun writes ->
+    E.return (sym, isJust writes)) values >>= fun checks ->
+  let next = List.map fst (List.filter snd checks) in
+  if next = values then E.return values else
+    gnu_incoming_array_prune (fuel - 1) candidates body next roots
+
+(* A readonly comparison can still refine an address: both non-null operands
+   require positive origin classes. Visible callees are excluded even when
+   readonly, because their return predicate can constrain an input. *)
+val gnu_incoming_array_effects_expression:
+  list Symbol.sym -> list Symbol.sym -> list Symbol.sym ->
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_incoming_array_effects_expression values roots private_scalars
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_incoming_array_effects_expression values roots private_scalars in
+  let every operands = E.mapM self operands >>= fun answers -> E.return (List.all (fun x -> x) answers) in
+  match node with
+    | A.AilEbinary left bop right ->
+        let comparison = match bop with
+          | A.Eq -> true | A.Ne -> true | A.Lt -> true | A.Le -> true | A.Gt -> true | A.Ge -> true
+          | _ -> false end in
+        let null_test =
+          (gnu_pointer_refinement_null left && AilTypesAux.is_pointer (ctype_of right)) ||
+          (gnu_pointer_refinement_null right && AilTypesAux.is_pointer (ctype_of left)) in
+        (if comparison && not null_test then
+          gnu_incoming_array_value values roots left >>= fun a ->
+          gnu_incoming_array_value values roots right >>= fun b -> E.return (a && b)
+        else E.return true) >>= fun admitted ->
+        if admitted then every [left; right] else E.return false
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident _)) right -> self right
+    | A.AilEassign left right ->
+        gnu_incoming_array_value values roots right >>= fun origin ->
+        if origin then every [left; right] else E.return false
+    | A.AilEcompoundAssign (A.AnnotatedExpression _ _ _ (A.AilEident sym) as left) _ right ->
+        if List.elem sym private_scalars then every [left; right] else
+        gnu_incoming_array_value values roots expr >>= fun origin ->
+        if origin then every [left; right] else E.return false
+    | A.AilEcompoundAssign left _ right ->
+        gnu_incoming_array_value values roots expr >>= fun origin ->
+        if origin then every [left; right] else E.return false
+    | A.AilEunary A.Address operand -> E.return (AilTypesAux.is_function (ctype_of operand))
+    | A.AilEcast _ result operand ->
+        if gnu_literal_null_pointer expr ||
+            (AilTypesAux.is_integer result && AilTypesAux.is_integer (ctype_of operand)) ||
+            (AilTypesAux.is_pointer result && AilTypesAux.is_pointer (ctype_of operand))
+        then self operand else E.return false
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee) then E.return false else
+        gnu_inline_function_target callee >>= (function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_has_source_definition target >>= fun defined ->
+              if defined then E.return false else
+              every args >>= fun operands ->
+              if not operands then E.return false else
+              gnu_memory_certified_readonly expr >>= fun readonly ->
+              gnu_retained_sized_pointer_result expr >>= fun allocation ->
+              gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+              E.return (readonly || allocation || opaque)
+        end)
+    | _ -> match gnu_record_children expr with
+        | Nothing -> E.return false
+        | Just operands -> every operands end
+  end
+
+val gnu_incoming_array_effects_statement:
+  list Symbol.sym -> list Symbol.sym -> list Symbol.sym ->
+  A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_incoming_array_effects_statement values roots private_scalars stmt =
+  match stmt.A.node with
+    | A.AilSgoto _ -> E.return false
+    | _ -> match gnu_record_statement_children stmt with
+        | Nothing -> E.return false
+        | Just (expressions, children) ->
+            E.mapM (fun expr ->
+              gnu_incoming_array_effects_expression values roots private_scalars expr >>= fun accepted ->
+              let () = if not accepted then Debug.print_debug_located 2 [Debug.DB_elaboration]
+                (Loc.locOf expr) (fun () ->
+                  "GNU incoming array effect rejected: " ^ Pp.stringFromAil_expression expr)
+                else () in
+              E.return accepted) expressions >>= fun first ->
+            E.mapM (gnu_incoming_array_effects_statement values roots private_scalars) children >>= fun second ->
+            E.return (List.all (fun x -> x) (first ++ second))
+      end
+  end
+
+val gnu_incoming_array_element:
+  A.expression GenTypes.genTypeCategory -> maybe (Symbol.sym * integer)
+let rec gnu_incoming_array_element (A.AnnotatedExpression _ _ _ node as expr) =
+  let indexed base index = match (gnu_pointer_array_root base, index) with
+    | (Just root, A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant offset _ _)))) ->
+        if offset >= 0 then Just (root, offset) else Nothing
+    | _ -> Nothing end in
+  match node with
+    | A.AilErvalue operand -> gnu_incoming_array_element operand
+    | A.AilEunary A.Indirection (A.AnnotatedExpression _ _ _
+        (A.AilEbinary base (A.Arithmetic A.Add) index)) ->
+        if AilTypesAux.is_pointer (ctype_of base) then indexed base index else indexed index base
+    | A.AilEannot _ operand -> gnu_incoming_array_element operand
+    | A.AilEcast _ _ operand ->
+        if AilTypesAux.is_pointer (ctype_of expr) && AilTypesAux.is_pointer (ctype_of operand)
+        then gnu_incoming_array_element operand else Nothing
+    | _ -> Nothing
+  end
+
+val gnu_incoming_array_null_guard:
+  A.expression GenTypes.genTypeCategory -> list (Symbol.sym * integer)
+let rec gnu_incoming_array_null_guard (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEbinary left A.Or right ->
+      gnu_incoming_array_null_guard left ++ gnu_incoming_array_null_guard right
+  | A.AilEbinary left A.Eq right ->
+      let key = if gnu_pointer_refinement_null left then gnu_incoming_array_element right
+        else if gnu_pointer_refinement_null right then gnu_incoming_array_element left else Nothing in
+      maybe [] (fun value -> [value]) key
+  | A.AilEannot _ operand -> gnu_incoming_array_null_guard operand
+  | _ -> []
+end
+
+val gnu_incoming_array_returns: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_incoming_array_returns stmt = match stmt.A.node with
+  | A.AilSreturnVoid -> true
+  | A.AilSblock [] [child] -> gnu_incoming_array_returns child
+  | A.AilSmarker _ child -> gnu_incoming_array_returns child
+  | _ -> false
+end
+
+(* A null write to a different constant index is harmless for this selected
+   element. Any other indirect write may overwrite it (including through a
+   second, potentially aliased incoming array), so the load is not admitted.
+   The separate effect census handles calls and value refinements. *)
+val gnu_incoming_array_preserves_expression:
+  (Symbol.sym * integer) -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_incoming_array_preserves_expression key (A.AnnotatedExpression _ _ _ node as expr) =
