+++ b/lean_frontend/host/families/system/output/templates/output-bytes-handler.lean.in
@@ -0,0 +1,53 @@
+import Driver
+import CerbHostSystemOutput
+import CerbHostDescriptors
+set_option autoImplicit false
+namespace CerbHostSystemOutputHandler
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+def supportsName := CerbHostSystemOutput.supportsName
+structure EffectReceipt where
+  sequence : Nat
+  original : host_request
+  admitted : CerbHostSystemOutput.Admitted
+  prepared : CerbHostSystemOutput.Prepared
+  response : CerbHostSystem.SystemResult
+
+def performRequest [LemFuel] [CerbGlobal.Switches] (sequence : Nat)
+    (table : CerbHostDescriptors.Table)
+    (perform : CerbHostSystemOutput.Prepared → BaseIO CerbHostSystem.SystemResult)
+    (state : driver_state) (original : host_request) :
+    BaseIO (Except (Failure × CerbHostDescriptors.Table × Option EffectReceipt)
+      (driver_state × CerbHostDescriptors.Table × host_response)) := do
+  if !state.host_enabled || state.host_reply.isSome || state.host_sequence != sequence+1 then
+    return .error (.boundary "invalid output-byte request state or sequence",table,none)
+  match CerbHostDescriptors.validateIdle table with
+  | .error reason => return .error (.boundary reason,table,none)
+  | .ok () => pure ()
+  let .Host_external tid location errnoPointer symbol callType arguments := original
+    | return .error (.boundary "output-byte handler requires an external request",table,none)
+  if state.core_state0.thread_states.length != 1 then
+    return .error (.boundary "concurrent output-byte host execution is not implemented",table,none)
+  let some (_,(_,thread)) := state.core_state0.thread_states.find? (fun entry => entry.1 == tid)
+    | return .error (.boundary "output-byte request has no current thread",table,none)
+  if thread.errno != errnoPointer || thread.current_loc != location then
+    return .error (.boundary "output-byte request changed errno identity or location",table,none)
+  let admitted ← match CerbHostSystemOutput.admit location state.core_file state.core_extern
+      symbol callType arguments with
+    | .error failure => return .error (failure,table,none)
+    | .ok admitted => pure admitted
+  let prepared ← match CerbHostSystemOutput.prepare admitted errnoPointer state.layout_state with
+    | .error failure => return .error (failure,table,none)
+    | .ok prepared => pure prepared
+  let response ← perform prepared
+  let receipt : EffectReceipt := ⟨sequence,original,admitted,prepared,response⟩
+  match CerbHostSystemOutput.complete state.core_file prepared response with
+  | .error failure => return .error (failure,table,some receipt)
+  | .ok completion =>
+    return .ok ({state with layout_state := completion.memory},table,
+      .Host_void (prepared.inputFootprints ++ completion.outputFootprints))
+
+def execute [LemFuel] [CerbGlobal.Switches] (sequence : Nat)
+    (table : CerbHostDescriptors.Table) (state : driver_state) (request : host_request) :=
+  performRequest sequence table CerbHostSystemOutput.executeNative state request
+end CerbHostSystemOutputHandler
diff --git a/lean_frontend/host/families/system/output/templates/output-bytes.lean.in b/lean_frontend/host/families/system/output/templates/output-bytes.lean.in
new file mode 100644
index 00000000..09794b9f
--- /dev/null
+++ b/lean_frontend/host/families/system/output/templates/output-bytes.lean.in
@@ -0,0 +1,170 @@
+/- Generated normal-call bridge for existing output_bytes contracts.
+Destinations are preflighted without loading their old (possibly unspecified)
+contents. Only returned native bytes become modeled initialized bytes. -/
+import Core_run
+import CerbHostSystem
+import CerbHostMemoryCells
+set_option autoImplicit false
+namespace CerbHostSystemOutput
+open CerbMem CerbHostMemoryCells CerberusImpl
+abbrev Program := generic_file Unit core_run_annotation
+
+private def fail {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+private def lookup {α : Type} (key : sym) (map : Fmap sym α) : Option α :=
+  fmapLookupBy (fun a b => Lem_Basic_classes.ordCompare a b) key map
+private def identifierText : identifier → String
+  | .Identifier _ name => name
+private def sameType (a b : ctype) := ctypeEqual a b
+private def pointerType (type : ctype) : ctype := .Ctype [] (.Pointer no_qualifiers type)
+
+structure Contract where
+  native : UInt64 → CerbHostSystem.Request
+
+private def contract : String → Option Contract
+@CONTRACTS@
+  | _ => none
+
+def symbols : List String := @SYMBOLS@
+def supportsName (name : String) : Bool := (contract name).isSome
+
+structure Admitted where
+  private mk ::
+  location : CerbLocation.Loc
+  program : Program
+  name : String
+  contract : Contract
+  types : List ctype
+  objects : List PointerValue
+  nonnull : List Nat
+
+def admit [LemFuel] (location : CerbLocation.Loc) (program : Program)
+    (links : Fmap sym sym) (original : sym) (callType : generic_pexpr Unit sym)
+    (arguments : List value) : Except Failure Admitted := do
+  if program.calling_convention0 != .Normal_callconv then
+    fail "system host call requires normal parameter-object convention"
+  if (lookup_proc_body links program original).isSome then
+    fail "host system call cannot bypass a model or user body; choose the explicit host libc profile"
+  let resolved := resolve_linked_function links original
+  let names := Lem_Map_extra.fold (fun ident binding found =>
+    let (symbols, linkage) := binding
+    if linkage == .LK_none && symbols.any (fun symbol => symbol == resolved)
+      then identifierText ident :: found else found) program.extern []
+  let [name] := names | fail "system external target has no unique unresolved linker name"
+  let some expected := contract name | fail "system external target has no byte-output contract"
+  let arity := 2
+  let some (.ProcDecl _ coreResult parameters) := lookup resolved program.funs
+    | fail "host system target must remain a real procedure declaration"
+  if coreResult != .BTy_unit ||
+      parameters != List.replicate arity (.BTy_object .OTy_pointer) then
+    fail "system Core signature differs from normal parameter-object convention"
+  let some (_, _, result, declared, variadic, prototype) := lookup resolved program.funinfo
+    | fail "system target lacks its actual source C prototype"
+  if variadic || !prototype || !sameType result void ||
+      declared.length != arity || arguments.length != arity then
+    fail "system source prototype has incompatible result, arity or variadic status"
+  let .Pexpr _ _ (.PEval (.Vctype (.Ctype _ (.Pointer functionQual
+      (.Ctype _ (.Function (returnQual, callResult) called false)))))) := callType
+    | fail "system call lacks its fixed function-pointer prototype"
+  if !qualifiersEqual functionQual no_qualifiers ||
+      !qualifiersEqual returnQual no_qualifiers ||
+      !sameType result callResult || called.length != arity then
+    fail "system call/declaration result or arity differs"
+  let types := declared.map Prod.snd
+  for ((type, required), (_, callParameter, _)) in (types.zip [pointerType void, unsigned_long]).zip called do
+    if !sameType type callParameter then fail "system call/declaration parameter CType differs"
+    if !sameType type required || !sameType callParameter required then
+      fail "output buffer/count parameter differs from void pointer and size_t"
+  if sizeofCtype program.enumDefs program.tagDefs signed_int != 4 ||
+      sizeofCtype program.enumDefs program.tagDefs signed_long != 8 ||
+      sizeofCtype program.enumDefs program.tagDefs (pointerType void) != 8 then
+    fail "system source ABI differs from pinned LP64"
+  let mut objects := []
+  for argument in arguments do
+    match argument with
+    | .Vobject (.OVpointer object) => objects := object :: objects
+    | _ => fail "system Core argument is not its actual parameter temporary"
+  let nonnull := (gnu_nonnull_parameters links program original).map Prod.fst
+  if nonnull.any (fun index => index >= arity) then fail "nonnull parameter index exceeds arity"
+  return ⟨location,program,name,expected,types,objects.reverse,nonnull⟩
+
+inductive Argument where
+  | number (value : Int)
+  | pointer (value : PointerValue)
+
+private def loadArgument [LemFuel] [CerbGlobal.Switches] (location : CerbLocation.Loc)
+    (program : Program) (type : ctype) (object : PointerValue) (nonnull : Bool)
+    (state : MemState) : Except Failure (Argument × Footprint × MemState) := do
+  match object with
+  | .PV (.Prov_some _) (.PVconcrete _ _) => pure ()
+  | _ => fail "system parameter temporary lacks ordinary allocation provenance"
+  let (valid, checked) ← immediate (validForDerefPtrval program.enumDefs program.tagDefs type object) state
+  if !valid then fail "system parameter temporary fails model lifetime/alignment checks"
+  let ((footprint,value), after) ← immediate
+    (loadM program.enumDefs program.tagDefs location type object) checked
+  if !memValueHasType type value then fail "system parameter temporary has incompatible stored type"
+  match value with
+  | .MVinteger _ (.IV _ number) => return (.number number,footprint,after)
+  | .MVpointer _ pointer =>
+    if nonnull then
+      let (isNull,next) ← immediate (eqPtrval location pointer (nullPtrval void)) after
+      if isNull then throw (.memory (.Undef0 location [.DUMMY "GNU nonnull argument is null or unspecified"]))
+      return (.pointer pointer,footprint,next)
+    else return (.pointer pointer,footprint,after)
+  | _ => fail "system parameter temporary is unspecified or unsupported"
+
+private def signed32 (bits : UInt32) : Int :=
+  if bits.toNat < 2147483648 then bits.toNat else (bits.toNat : Int)-4294967296
+
+structure Prepared where
+  private mk ::
+  native : CerbHostSystem.Request
+  modeledErrno : UInt32
+  outputs : PreparedOutputs
+  count : Nat
+  inputFootprints : List Footprint
+
+def prepare [LemFuel] [CerbGlobal.Switches] (admitted : Admitted)
+    (errnoPointer : PointerValue) (state : MemState) : Except Failure Prepared := do
+  let [destinationType, countType] := admitted.types
+    | fail "output-byte admission lost its exact two source parameter types"
+  let [destinationObject, countObject] := admitted.objects
+    | fail "output-byte admission lost its two parameter objects"
+  let program := admitted.program
+  let (destination, destinationRead, state1) ← loadArgument admitted.location program
+    destinationType destinationObject (admitted.nonnull.contains 0) state
+  let (length, lengthRead, state2) ← loadArgument admitted.location program
+    countType countObject (admitted.nonnull.contains 1) state1
+  let .pointer pointer := destination | fail "output-byte destination argument is not a pointer"
+  let .number count := length | fail "output-byte count argument is not an integer"
+  if !CellKind.unsignedLong.accepts count then fail "output-byte count does not fit pinned size_t"
+  -- Count zero produces no shift, validity check or destination load/store.
+  -- A source nonnull attribute was checked independently by loadArgument.
+  let (cells, state3) ← arrayCells program.enumDefs program.tagDefs .byte pointer count.toNat state2
+  let errnoCell : Cell := ⟨errnoPointer,.signedInt⟩
+  let (oldErrno, errnoRead, state4) ← readInteger program.enumDefs program.tagDefs errnoCell state3
+  if !CellKind.signedInt.accepts oldErrno then fail "modeled errno is not signed int"
+  let outputs ← prepareOutputs program.enumDefs program.tagDefs (errnoCell :: cells) state4
+  return ⟨admitted.contract.native count.toNat.toUInt64,
+    (oldErrno % 4294967296).toNat.toUInt32, outputs, count.toNat,
+    [destinationRead,lengthRead,errnoRead]⟩
+
+def executeNative (prepared : Prepared) : BaseIO CerbHostSystem.SystemResult :=
+  CerbHostSystem.execute prepared.modeledErrno prepared.native
+
+structure Completion where
+  memory : MemState
+  outputFootprints : List Footprint
+
+def complete [LemFuel] (program : Program) (prepared : Prepared)
+    (response : CerbHostSystem.SystemResult) : Except Failure Completion := do
+  if !response.boundaryError.isEmpty then fail response.boundaryError
+  if response.status.value != 0 || response.status.error != 0 ||
+      !response.status.errorName.isEmpty || !response.fields.isEmpty ||
+      response.bytes.size != prepared.count then
+    fail "void output-byte transport returned a malformed status, fields or byte count"
+  let values := some (signed32 response.nativeErrnoAfter) ::
+    response.bytes.data.toList.map (fun byte => some (byte.toNat : Int))
+  let (footprints, memory) ← commitSelectedOutputs program.enumDefs program.tagDefs prepared.outputs values
+  return ⟨memory,footprints⟩
+
+end CerbHostSystemOutput
