new file mode 100644
index 00000000..37da8e67
--- /dev/null
+++ b/lean_frontend/host/families/system/output/generate_system_output.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Generate exact normal-call byte-output routes from verified native contracts."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+def generate(path):
+    spec=json.loads(path.read_bytes())
+    if type(spec.get("schema")) is not int or spec["schema"]!=1 or spec.get("family")!="system-output-bytes":
+        raise ValueError("Unknown output-byte contract schema")
+    templates=["output-bytes.lean.in","output-bytes-handler.lean.in"]
+    if spec.get("templates")!=templates:
+        raise ValueError("Unsupported output-byte template inventory")
+    native_data=(path.parent/spec["native_contracts"]).read_bytes()
+    if sha(native_data)!=spec["native_contracts_sha256"]:
+        raise ValueError("Native contract file identity differs")
+    native=json.loads(native_data)
+    if native.get("target")!="x86_64-linux-gnu":
+        raise ValueError("Native contract target differs")
+    entries=native["apis"]
+    if len({x["symbol"] for x in entries})!=len(entries):
+        raise ValueError("Duplicate native symbols")
+    source={x["symbol"]:x for x in entries}
+    routes=spec["routes"]
+    names=[x["symbol"] for x in routes]
+    if len(set(names))!=len(names) or not names or any(not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*",x) for x in names):
+        raise ValueError("Invalid or duplicate generated symbol")
+    candidates={x["symbol"] for x in entries if x["shape"]=="output_bytes"}
+    if set(names)!=candidates:
+        raise ValueError("Every native output_bytes contract must be accounted for")
+    lines=[]
+    for row in routes:
+        name=row["symbol"]; api=source[name]
+        if sha(json.dumps(api,sort_keys=True).encode())!=row["native_contract_sha256"]:
+            raise ValueError("Native API contract differs: "+name)
+        if (api["shape"]!="output_bytes" or api["native_return"]!="void" or api["error"]!="never"
+                or api["params"]!=[{"name":"count","kind":"u64"}] or api["dedicated_worker"]):
+            raise ValueError("Native transport needs additional state/return/parameter semantics")
+        if (row["result"]!="void" or row["parameters"]!=["voidPointer","unsignedLong"]
+                or type(row["output_argument"]) is not int or row["output_argument"]!=0
+                or type(row["count_argument"]) is not int or row["count_argument"]!=1
+                or row["copyback"]!="all-requested-bytes-on-return"):
+            raise ValueError("Source signature or output semantics are unsupported")
+        policies={
+            "zero_count":"no destination access; preserve source nonnull constraints",
+            "memory_aliasing":"errno/output overlap rejected before effect by shared output lease",
+            "termination":"normal returned native response only; nonreturning RNG failure is worker termination",
+        }
+        if any(row.get(field)!=value for field,value in policies.items()):
+            raise ValueError("Output-byte lifetime/alias/termination policy is unsupported")
+        lines.append("  | "+json.dumps(name)+" => some ⟨CerbHostSystem.Request."+name+"⟩")
+    template=(path.parent/"templates/output-bytes.lean.in").read_text()
+    for marker,replacement in {"@CONTRACTS@":"\n".join(lines),
+            "@SYMBOLS@":"["+", ".join(json.dumps(n) for n in names)+"]"}.items():
+        if template.count(marker)!=1: raise ValueError("Missing/duplicate generator marker "+marker)
+        template=template.replace(marker,replacement)
+    files={"CerbHostSystemOutput.lean":template,
+       "CerbHostSystemOutputHandler.lean":(path.parent/"templates/output-bytes-handler.lean.in").read_text()}
+    files["system-output-manifest.json"]=json.dumps({"schema":1,
+        "contract_sha256":sha(path.read_bytes()),"native_contract_sha256":sha(native_data),
+        "generator_sha256":sha(Path(__file__).read_bytes()),
+        "routes":names,"outputs":{n:sha(t.encode()) for n,t in files.items()},
+        "scope":"Generated source, not execution verification, semantic equivalence or whole ssh support",
+        "compiled":False,"executed":False,"unresolved":spec["unresolved"]},indent=2)+"\n"
+    return files
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--contracts",type=Path,required=True)
+    p.add_argument("--output",type=Path,required=True)
+    p.add_argument("--check",action="store_true")
+    a=p.parse_args()
+    for name,text in generate(a.contracts).items():
+        dest=a.output/name
+        if a.check:
+            if not dest.is_file() or dest.read_text()!=text:
+                raise SystemExit("Stale generated output: "+name)
+        elif not dest.is_file() or dest.read_text()!=text:
+            dest.parent.mkdir(parents=True,exist_ok=True);dest.write_text(text)
+if __name__=="__main__":
+    main()
