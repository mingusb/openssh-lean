@@ -0,0 +1,51 @@
+import Nondeterminism
+
+def M := ndM Nat Nat Unit Unit Nat
+
+def active : M := ND (fun s => (NDactive 1, s))
+def killed : M := ND (fun s => (NDkilled (Other ()), s))
+
+def samples : List M := [
+  active,
+  killed,
+  ND (fun s => (NDnd 7 [(8, active)], s)),
+  ND (fun s => (NDguard 3 () active, s)),
+  ND (fun s => (NDbranch 4 () active killed, s)),
+  ND (fun s => (NDstep 5 [(6, active)], s))
+]
+
+partial def observe (depth : Nat) (m : M) : List Nat :=
+  if depth == 0 then [] else
+  match m with
+  | ND run =>
+    match (run 10).1 with
+    | NDactive x => [1, x]
+    | NDkilled _ => [2]
+    | NDnd i xs => [3, i] ++ xs.flatMap (fun (j, n) => [j] ++ observe (depth - 1) n)
+    | NDguard i _ n => [4, i] ++ observe (depth - 1) n
+    | NDbranch i _ x y => [5, i] ++ observe (depth - 1) x ++ observe (depth - 1) y
+    | NDstep i xs => [6, i] ++ xs.flatMap (fun (j, n) => [j] ++ observe (depth - 1) n)
+
+def cont (x : Nat) : M := nd_return (x + 1)
+
+def main : IO Unit := do
+  letI : LemFuel := { fuel := 0 }
+  for m in samples do
+    let actual := observe 4 (nd_bind m cont)
+    let expected := observe 4 (nd_bind_lemFuel 6 m cont)
+    if actual != expected then
+      throw (IO.userError s!"bind divergence: {actual} vs {expected}")
+    let get2 : Nat -> Nat := id
+    let put1 : Nat -> Nat -> Nat := fun _ s => s
+    let liftInfo : Nat -> Nat := fun i => i + 10
+    let liftErr : Unit -> Unit := id
+    let actualLift := observe 4 (liftND get2 put1 liftInfo liftErr m)
+    let expectedLift := observe 4 (liftND_lemFuel 6 get2 put1 liftInfo liftErr m)
+    if actualLift != expectedLift then
+      throw (IO.userError s!"lift divergence: {actualLift} vs {expectedLift}")
+    let a := (match m with | ND run => (run 10).1)
+    let actualAction := observe 4 (ND (fun s => (liftAction get2 put1 liftInfo liftErr a, s)) : M)
+    let expectedAction := observe 4 (ND (fun s => (liftAction_lemFuel 6 get2 put1 liftInfo liftErr a, s)) : M)
+    if actualAction != expectedAction then
+      throw (IO.userError s!"action divergence: {actualAction} vs {expectedAction}")
+  IO.println "ND compiled runtime matches finite prefixes across six action shapes"
