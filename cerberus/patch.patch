+static int memo_immutable(memo_walk *w, lean_object *object) {
+    if (lean_is_scalar(object)) return 1;
+    int fresh;
+    memo_visit *root = memo_visit_get(w, object, &fresh);
+    if (!fresh) return root->state == 2;
+    size_t depth = 1, capacity = 64;
+    memo_frame *stack = memo_alloc(capacity, sizeof(*stack));
+    stack[0] = memo_frame_new(object, root);
+    while (depth) {
+        memo_frame *f = &stack[depth - 1];
+        if (f->visit->state == 3 || f->next == f->count) {
+            if (f->visit->state == 1) f->visit->state = 2;
+            int bad = f->visit->state == 3;
+            --depth;
+            if (bad && depth) stack[depth - 1].visit->state = 3;
+            continue;
+        }
+        size_t i = f->next++;
+        lean_object *child = f->tag == LeanArray ? lean_array_get_core(f->object, i) :
+            f->tag == LeanClosure ? lean_closure_get(f->object, i) : lean_ctor_get(f->object, i);
+        if (lean_is_scalar(child)) continue;
+        memo_visit *v = memo_visit_get(w, child, &fresh);
+        if (!fresh) {
+            if (v->state != 2) f->visit->state = 3;
+            continue;
+        }
+        if (depth == capacity) {
