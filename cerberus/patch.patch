diff --git a/lean_frontend/host/families/system/system-memory.lean.in b/lean_frontend/host/families/system/system-memory.lean.in
new file mode 100644
index 00000000..828bd05f
--- /dev/null
+++ b/lean_frontend/host/families/system/system-memory.lean.in
@@ -0,0 +1,138 @@
+/- Generated model-memory codec for the enabled system contracts. It does not
+admit arbitrary source declarations or reinterpret native pointers as guest
+pointers. The shared driver validates source signatures and owns FILE identity.
+Output preparation and completion must be adjacent modeled actions, with exactly
+one native request between them. Never retry an effect after a boundary error. -/
+import CerbHostMemoryCells
+import CerbHostSystem
+
+namespace CerbHostSystemMemory
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+inductive Request where
+  | fgets (destination : PointerValue) (limit : Int) (stream : PointerValue)
+  | setvbuf (stream buffer : PointerValue) (mode size : Int)
+
+inductive ReturnValue where
+  | signedInt (value : Int)
+  /-- None is the null pointer of the source declaration's return pointee type.
+      Some returns the unchanged original pointer, including provenance. -/
+  | pointer (value : Option PointerValue)
+
+structure Prepared where
+  private mk ::
+  native : CerbHostSystem.Request
+  modeledErrno : UInt32
+  outputs : PreparedOutputs
+  inputFootprints : List Footprint
+  source : Request
+
+structure Completion where
+  returnValue : ReturnValue
+  nativeErrnoAfter : UInt32
+  memory : MemState
+  outputFootprints : List Footprint
+
+private def fail {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+
+private def i32 (value : Int) : Except Failure UInt32 := do
+  if value < -2147483648 || value > 2147483647 then
+    fail "source int is outside the pinned 32-bit domain"
+  return (value % 4294967296).toNat.toUInt32
+
+private def u64 (value : Int) : Except Failure UInt64 := do
+  if value < 0 || value > 18446744073709551615 then
+    fail "source size_t is outside the pinned unsigned 64-bit domain"
+  return value.toNat.toUInt64
+
+private def signed32 (value : UInt32) : Int :=
+  if value.toNat < 2147483648 then value.toNat
+  else (value.toNat : Int) - 4294967296
+
+private def fileToken (resolve : PointerValue → Except String UInt64)
+    (pointer : PointerValue) : Except Failure UInt64 := do
+  match resolve pointer with
+  | .error message => fail message
+  | .ok token =>
+    if token == 0 then fail "FILE mapping returned the reserved null token"
+    return token
+
+private def isNull : PointerValue → Bool
+  | .PV .Prov_none (.PVnull _) => true
+  | _ => false
+
+def prepare [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (resolve : PointerValue → Except String UInt64)
+    (errnoPointer : PointerValue) (request : Request) (state : MemState) :
+    Except Failure Prepared := do
+  let errnoCell : Cell := ⟨errnoPointer, .signedInt⟩
+  let (modeledErrno, errnoRead, initial) ← readInteger enums tags errnoCell state
+  let nativeErrno ← i32 modeledErrno
+  match request with
+  | .fgets destination limit stream =>
+    let nativeLimit ← i32 limit
+    let token ← fileToken resolve stream
+    -- n <= 0 never inspects the destination. n == 1 prepares only its NUL cell.
+    let (cells, after) ← arrayCells enums tags .byte destination limit.toNat initial
+    let outputs ← prepareOutputs enums tags (cells ++ [errnoCell]) after
+    return ⟨.fgets nativeLimit token, nativeErrno, outputs, [errnoRead], request⟩
+  | .setvbuf stream buffer mode size =>
+    if !isNull buffer then
+      fail "non-NULL setvbuf needs a retained modeled backing lease; temporary copying is not a substitute"
+    let token ← fileToken resolve stream
+    let nativeMode ← i32 mode
+    let nativeSize ← u64 size
+    let outputs ← prepareOutputs enums tags [errnoCell] initial
+    return ⟨.setvbuf token nativeMode nativeSize, nativeErrno, outputs, [errnoRead], request⟩
+
+def executeNative (prepared : Prepared) : BaseIO CerbHostSystem.SystemResult :=
+  CerbHostSystem.execute prepared.modeledErrno prepared.native
+
+/-- Validate before any model write. Binary NUL bytes have no special role in
+the writtenBytes length; only the required final success terminator is inspected. -/
+private def linePrefix (limit : Int) (response : CerbHostSystem.SystemResult) :
+    Except Failure (Bool × List (Option Int)) := do
+  if response.status.value != 0 && response.status.value != 1 then
+    fail "fgets response has invalid pointer-presence status"
+  let success := response.status.value == 1
+  if response.bytes.size > limit.toNat then fail "fgets writtenBytes exceeds prepared output"
+  if limit ≤ 0 then
+    if success || response.bytes.size != 0 || !response.fields.isEmpty then
+      fail "fgets with nonpositive size must not write"
+  else if limit == 1 then
+    if !success || response.bytes.data != #[0] || !response.fields.isEmpty then
+      fail "pinned fgets with size one must write exactly NUL without stream I/O"
+  else
+    if response.fields.size != 3 then fail "fgets response lacks transfer/indicator fields"
+    if response.fields[1]!.toNat > 1 || response.fields[2]!.toNat > 1 then
+      fail "fgets response has non-Boolean FILE indicators"
+    let transferred := response.fields[0]!.toNat
+    if transferred ≥ limit.toNat then fail "fgets transferred count exceeds requested data"
+    if response.bytes.size != transferred + (if success then 1 else 0) then
+      fail "fgets writtenBytes and exact native transfer count differ"
+    if success then
+      if transferred == 0 || response.bytes.data[response.bytes.size - 1]? != some 0 then
+        fail "successful fgets lacks data or its terminating NUL"
+    else if transferred != 0 && response.fields[2]! == 0 then
+      fail "partial failed fgets lacks the native error indicator"
+  let writtenBytes := response.bytes.data.toList.map (fun byte => some (byte.toNat : Int))
+  return (success, writtenBytes ++ List.replicate (limit.toNat - response.bytes.size) none)
+
+def complete [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (prepared : Prepared) (response : CerbHostSystem.SystemResult) :
+    Except Failure Completion := do
+  if !response.boundaryError.isEmpty then fail response.boundaryError
+  let errnoWrite : Option Int := some (signed32 response.nativeErrnoAfter)
+  let (returned, writes) ← match prepared.source with
+  | .fgets destination limit _ => do
+    let (success, writtenBytes) ← linePrefix limit response
+    pure (ReturnValue.pointer (if success then some destination else none), writtenBytes)
+  | .setvbuf _ _ _ _ => do
+    if response.bytes.size != 0 || !response.fields.isEmpty then
+      fail "setvbuf returned an unexpected memory payload"
+    let _ ← i32 response.status.value
+    pure (ReturnValue.signedInt response.status.value, [])
+  let (footprints, memory) ← commitSelectedOutputs enums tags prepared.outputs (writes ++ [errnoWrite])
+  return ⟨returned, response.nativeErrnoAfter, memory, footprints⟩
+
+end CerbHostSystemMemory
