+val gnu_loop_known_counter_profile: Core.core_tag_definitions ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe bool)
+let rec gnu_loop_known_counter_profile tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let nonnegative operand = gnu_loop_initial_counter tagDefs operand >>= fun known ->
+    E.return (maybe Nothing (fun value -> if value < 0 then Nothing else Just (value <> 0)) known) in
+  match node with
+    | A.AilEident _ -> nonnegative expr
+    | A.AilErvalue _ -> nonnegative expr
+    | A.AilEannot _ operand -> gnu_loop_known_counter_profile tagDefs operand
+    | A.AilEunary A.PostfixDecr operand -> nonnegative operand
+    | A.AilEbinary (A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixDecr operand)) A.Gt
+        (A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant number _ _)))) ->
+        if number <> 0 then E.return Nothing else
+          gnu_loop_initial_counter tagDefs operand >>= fun known ->
+          E.return (maybe Nothing (fun value -> Just (value > 0)) known)
+    | _ -> E.return Nothing
+  end
