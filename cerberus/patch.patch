diff --git a/lean_frontend/CerbHostBoundary.lean b/lean_frontend/CerbHostBoundary.lean
new file mode 100644
index 00000000..b35b8b2f
--- /dev/null
+++ b/lean_frontend/CerbHostBoundary.lean
@@ -0,0 +1,46 @@
+import CerbHostAdapters
+
+/- Shared, pure marshalling rules. Host wrappers are generated from contracts.
+   The interpreter must call prepareWrite only after its ordinary Cerberus
+   memory reads have validated the requested span and copied its bytes.
+   This module never dereferences, casts or reconstructs a guest pointer. -/
+namespace CerbHostBoundary
+open CerbHostAdapters
+
+def bytesOfChars (chars : List Char) : Except String ByteArray := do
+  let mut bytes := ByteArray.empty
+  for char in chars do
+    if char.toNat > 255 then
+      throw "non-byte character at host boundary"
+    bytes := bytes.push char.toNat.toUInt8
+  return bytes
+
+def prepareWrite (fd : Int) (chars : List Char) (count : Int) :
+    Except String Request := do
+  if count < 0 || count != (chars.length : Int) then
+    throw "FS_WRITE count differs from its validated byte span"
+  return .write fd (← bytesOfChars chars)
+
+/-- Completion is pure and serializable; a model can provide the response
+    without performing native IO. A replay must additionally justify that
+    response with its chosen environment relation. -/
+structure WriteCompletion where
+  returnValue : Int
+  /-- Native code plus symbolic name. The dispatcher must translate explicitly:
+      Cerberus builtin errno numbering differs from native Linux headers. -/
+  errnoUpdate : Option (UInt32 × String)
+  writtenBytes : ByteArray
+
+def completeWrite (bytes : ByteArray) (result : NativeResult) :
+    Except String WriteCompletion := do
+  if result.value == -1 then
+    if result.error == 0 then
+      throw "native failure without errno"
+    return { returnValue := -1, errnoUpdate := some (result.error, result.errorName),
+             writtenBytes := ByteArray.empty }
+  if result.value < 0 || result.value > (bytes.size : Int) || result.error != 0 || !result.errorName.isEmpty then
+    throw "native write response violates its declared contract"
+  return { returnValue := result.value, errnoUpdate := none,
+           writtenBytes := bytes.extract 0 result.value.toNat }
+
+end CerbHostBoundary
diff --git a/lean_frontend/CerbHostFormat.lean b/lean_frontend/CerbHostFormat.lean
new file mode 100644
index 00000000..c00b66ec
--- /dev/null
+++ b/lean_frontend/CerbHostFormat.lean
@@ -0,0 +1,139 @@
+import Driver
+
+/- Dynamic formatted strings use the existing physical GNU va_list model. No
+   guest pointers or va_list objects cross into native libc, and all allocation,
+   reads, writes, cursor transitions and failures remain ordinary model actions.
+   This adapter is selected by the external C contract, independent of program. -/
+namespace CerbHostFormat
+open CerbMem CerberusImpl
+
+private def lookup {α : Type} (key : sym) (values : Fmap sym α) : Option α :=
+  fmapLookupBy (fun a b => Lem_Basic_classes.ordCompare a b) key values
+private def ident : identifier → String | .Identifier _ name => name
+private def ptr (ty : ctype) : ctype := .Ctype [] (.Pointer no_qualifiers ty)
+private def stringType := ptr char0
+private def formatType : ctype := .Ctype [] (.Pointer { no_qualifiers with const := true } char0)
+
+def supportsName (name : String) : Bool := name == "vasprintf" || name == "__vasprintf_chk"
+
+structure Admitted where
+  tid : Nat
+  location : CerbLocation.Loc
+  thread : thread_state
+  outputSlot : PointerValue
+  flagSlot : Option PointerValue
+  formatSlot : PointerValue
+  argumentsSlot : PointerValue
+  recordType : ctype
+
+/-- Admission is pure and completes before the first guest-memory access. -/
+def admit [LemFuel] (sequence : Nat) (state : driver_state) (request : host_request) :
+    Except String Admitted := do
+  if !state.host_enabled || state.host_reply.isSome || state.host_sequence != sequence + 1 then
+    throw "invalid formatted-string request state or sequence"
+  let .Host_external tid location errnoPointer symbol callType arguments := request
+    | throw "formatted-string adapter requires an external request"
+  let [(activeTid, (_, thread))] := state.core_state0.thread_states
+    | throw "concurrent formatted-string execution is not implemented"
+  if activeTid != tid || thread.errno != errnoPointer || thread.current_loc != location then
+    throw "formatted-string request changed its thread, errno or location"
+  let program := state.core_file
+  if program.calling_convention0 != .Normal_callconv then
+    throw "formatted-string adapter requires normal parameter objects"
+  if (lookup_proc_body state.core_extern program symbol).isSome then
+    throw "formatted-string adapter would bypass a linked procedure"
+  let resolved := resolve_linked_function state.core_extern symbol
+  let names := Lem_Map_extra.fold (fun name binding found =>
+    let (symbols, linkage) := binding
+    if linkage == .LK_none && symbols.any (· == resolved) then ident name :: found else found)
+    program.extern []
+  let [name] := names | throw "formatted-string external name is ambiguous"
+  if !supportsName name then throw "external is not a supported formatted-string contract"
+  let checked := name == "__vasprintf_chk"
+  let count := if checked then 4 else 3
+  let some (.ProcDecl _ result parameters) := lookup resolved program.funs
+    | throw "formatted-string adapter requires an external procedure declaration"
+  if result != .BTy_loaded .OTy_integer ||
+      parameters != List.replicate count (.BTy_object .OTy_pointer) then
+    throw "formatted-string Core signature does not match normal integer-result calling"
+  let some (_, _, declaredResult, declaredParameters, variadic, prototype) :=
+      lookup resolved program.funinfo
+    | throw "formatted-string C prototype is missing"
+  let types := declaredParameters.map (·.2)
+  let some apType := types.getLast? | throw "formatted-string prototype has no va_list"
+  let .Ctype _ (.Pointer apQual recordType@(.Ctype _ (.Struct _))) := apType
+    | throw "formatted-string va_list parameter is not a record pointer"
+  let expected := [ptr stringType] ++ (if checked then [signed_int] else []) ++ [formatType,apType]
+  if variadic || !prototype || !ctypeEqual declaredResult signed_int ||
+      types.length != count || !(types.zip expected).all (fun (a,b) => ctypeEqual a b) ||
+      !qualifiersEqual apQual no_qualifiers then
+    throw "formatted-string declaration differs from its C contract"
+  let .Pexpr _ _ (.PEval (.Vctype (.Ctype _ (.Pointer functionQual
+      (.Ctype _ (.Function (returnQual, callResult) callParameters false)))))) := callType
+    | throw "formatted-string call has no fixed function-pointer prototype"
+  if !qualifiersEqual functionQual no_qualifiers ||
+      !qualifiersEqual returnQual no_qualifiers || !ctypeEqual callResult declaredResult ||
+      callParameters.length != count ||
+      !(callParameters.zip types).all (fun ((_,called,_),declared) => ctypeEqual called declared) then
+    throw "formatted-string call and declaration prototypes differ"
+  let slots ← arguments.mapM fun
+    | .Vobject (.OVpointer pointer) => pure pointer
+    | _ => throw "formatted-string argument is not a parameter object"
+  match checked, slots with
+  | true, [output,flag,format,ap] => return ⟨tid,location,thread,output,some flag,format,ap,recordType⟩
+  | false, [output,format,ap] => return ⟨tid,location,thread,output,none,format,ap,recordType⟩
+  | _, _ => throw "formatted-string call has the wrong arity"
+
+/-- Only model actions: failures and nondeterministic outcomes are consumed by
+    the normal driver runner, without imposing another fuel or memory budget. -/
+def execute [LemFuel] [CerbGlobal.Switches] (sequence : Nat) (request : host_request) :
+    driverM host_response :=
+  nd_bind nd_get fun state =>
+  match admit sequence state request with
+  | .error message => kill (.Error0 (CerbLocation.other "formatted-string admission") message)
+  | .ok admitted =>
+    let loc := admitted.location
+    let enums := state.core_file.enumDefs
+    let tags := state.core_file.tagDefs
+    let loadPointer := gnuvformat_parameter_pointer enums tags loc
+    let loadFlag := match admitted.flagSlot with
+      | none => gnuva_return (0 : Int)
+      | some slot => gnuvformat_parameter_integer enums tags loc slot
+    let parameters := gnuva_bind (loadPointer admitted.outputSlot) fun output =>
+      gnuva_bind loadFlag fun flag =>
+      gnuva_bind (loadPointer admitted.formatSlot) fun format =>
+      gnuva_bind (loadPointer admitted.argumentsSlot) fun ap =>
+      gnuva_return (output,flag,format,ap)
+    nd_bind (liftGNUVarargsRaw loc parameters) fun ((outputSlot,flag,format,ap),reads) =>
+    nd_bind (liftGNUVarargsRaw loc (gnuva_find_cursor ap)) fun (cursor,_) =>
+    let cursorType : ctype := .Ctype [] (.Struct cursor.gnuva_cursor_tag)
+    -- Distinct translation units have distinct tag identities. Require C
+    -- compatibility, then validate both canonical layouts before any va_arg.
+    if !are_compatible_aux enums tags (tags,tags,[]) (no_qualifiers,admitted.recordType)
+        (no_qualifiers,cursorType) then
+      kill (.Error0 loc "formatted-string va_list type is incompatible with its physical cursor")
+    else nd_bind (gnu_record_shape enums tags loc tags admitted.recordType) fun _ =>
+    nd_bind (gnu_record_shape enums tags loc tags cursorType) fun shape =>
+    nd_bind nd_get fun current =>
+    match current.gnu_varargs_state.gnuva_active_scopes with
+    | [] => kill (.Error0 loc "formatted-string call is outside a C invocation")
+    | owner :: _ =>
+      nd_bind (liftGNUVarargsRaw loc (gnuvformat_format enums tags loc admitted.tid tags
+        (gnu_layout_oracle enums tags tags) shape owner
+        (printf_eval_conv enums tags current admitted.thread) none flag format ap)) fun (output,effects) =>
+      -- Ordinary dynamic storage, aligned like malloc, remains free-able by C.
+      nd_bind (liftMem (allocateRegion admitted.tid .PrefMalloc (.IV .Prov_none 16)
+        (.IV .Prov_none (Int.ofNat output.length + 1)))) fun buffer =>
+      nd_bind (liftGNUVarargsRaw loc (gnuvformat_write_chars enums tags loc buffer output)) fun (_,writes) =>
+      nd_bind (liftMem (storeM enums tags loc stringType false outputSlot
+        (.MVpointer char0 buffer))) fun assignment =>
+      nd_return (.Host_memory (Int.ofNat output.length) (reads ++ effects ++ writes ++ [assignment]))
+
+/-- Install exactly one sequence-tagged reply and enter the original continuation. -/
+def resume {α : Type} [LemFuel] [CerbGlobal.Switches] (sequence : Nat) (request : host_request)
+    (continuation : driverM α) : driverM α :=
+  nd_bind (execute sequence request) fun reply =>
+  nd_bind (nd_update fun state => { state with host_reply := some (sequence,reply) }) fun _ =>
+  continuation
+
+end CerbHostFormat
diff --git a/lean_frontend/CerbHostSystemAccountHandler.lean b/lean_frontend/CerbHostSystemAccountHandler.lean
new file mode 100644
index 00000000..66aae1de
--- /dev/null
+++ b/lean_frontend/CerbHostSystemAccountHandler.lean
@@ -0,0 +1,292 @@
+import Driver
+import CerbHostSystem
+import CerbHostMemoryCells
+import CerbHostDescriptors
+
+/- A checked bridge for the pinned getpwuid account contract. Native account
+   pointers never cross into model memory. The record and its strings live in
+   modeled static storage, and each subsequent lookup invalidates the previous
+   string allocations while retaining the record address. -/
+namespace CerbHostSystemAccountHandler
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+private abbrev Program := generic_file Unit core_run_annotation
+private def stop {α : Type} (message : String) : Except Failure α :=
+  .error (.boundary message)
+
+private def lookup {α : Type} (key : sym) (values : Fmap sym α) : Option α :=
+  fmapLookupBy (fun a b => Lem_Basic_classes.ordCompare a b) key values
+
+private def identifierText : identifier → String
+  | .Identifier _ text => text
+
+private def offset [LemFuel] (program : Program) (tag : sym) (field : identifier) : Int :=
+  let .IV _ n := offsetofIval program.enumDefs program.tagDefs program.tagDefs tag field
+  n
+
+private def charType : ctype := .Ctype [] (.Basic (.Integer .Char0))
+private def stringPointerType : ctype := .Ctype [] (.Pointer no_qualifiers charType)
+private def isUnsignedInt (ty : ctype) : Bool := ctypeEqual ty CellKind.unsignedInt.ty
+private def isStringPointer (ty : ctype) : Bool := ctypeEqual ty stringPointerType
+
+structure Shape where
+  recordType : ctype
+  tag : sym
+  fields : Array identifier
+
+private def checkShape [LemFuel] (program : Program) (returnType : ctype) :
+    Except Failure Shape := do
+  let .Ctype _ (.Pointer q recordType@(.Ctype _ (.Struct tag))) := returnType
+    | stop "getpwuid must return a pointer to its declared struct passwd"
+  if !qualifiersEqual q no_qualifiers then
+    stop "getpwuid return pointer has unsupported qualifiers"
+  let some (_, .StructDef _ members none) := lookup tag program.tagDefs
+    | stop "getpwuid struct passwd is missing or incomplete"
+  let expected := [
+    ("pw_name", 0, false), ("pw_passwd", 8, false),
+    ("pw_uid", 16, true), ("pw_gid", 20, true),
+    ("pw_gecos", 24, false), ("pw_dir", 32, false),
+    ("pw_shell", 40, false)]
+  if members.length != expected.length ||
+      sizeofCtype program.enumDefs program.tagDefs recordType != 48 ||
+      alignofCtype program.enumDefs program.tagDefs recordType != 8 then
+    stop "getpwuid struct passwd does not have the pinned AMD64 layout"
+  let mut fields := #[]
+  for ((field, (_, _, qualifiers, ty)), (name, byteOffset, integer)) in
+      members.zip expected do
+    if identifierText field != name ||
+        !qualifiersEqual qualifiers no_qualifiers ||
+        offset program tag field != byteOffset ||
+        (if integer then !isUnsignedInt ty else !isStringPointer ty) then
+      stop "getpwuid struct passwd fields differ from the pinned declaration"
+    fields := fields.push field
+  return ⟨recordType, tag, fields⟩
+
+structure Admitted where
+  location : CerbLocation.Loc
+  shape : Shape
+  uidObject : PointerValue
+
+private def admit [LemFuel] (state : driver_state) (location : CerbLocation.Loc)
+    (symbol : sym) (callType : generic_pexpr Unit sym) (arguments : List value) :
+    Except Failure Admitted := do
+  let program := state.core_file
+  if program.calling_convention0 != .Normal_callconv then
+    stop "getpwuid requires the pinned normal argument-object convention"
+  if (lookup_proc_body state.core_extern program symbol).isSome then
+    stop "getpwuid host handling would bypass a linked model or user procedure"
+  let resolved := resolve_linked_function state.core_extern symbol
+  let names := Lem_Map_extra.fold (fun ident binding found =>
+    let (symbols, linkage) := binding
+    if linkage == .LK_none && symbols.any (fun entry => entry == resolved)
+      then identifierText ident :: found else found) program.extern []
+  if names != ["getpwuid"] then stop "external target is not uniquely getpwuid"
+  let some (.ProcDecl _ coreResult coreParameters) := lookup resolved program.funs
+    | stop "getpwuid must remain a real external procedure declaration"
+  if coreResult != .BTy_loaded .OTy_pointer ||
+      coreParameters != [.BTy_object .OTy_pointer] then
+    stop "getpwuid Core signature differs from normal pointer-result calling"
+  let some (_, _, declaredResult, declaredParameters, variadic, prototype) :=
+      lookup resolved program.funinfo
+    | stop "getpwuid has no original source C prototype"
+  let [(_, parameterType)] := declaredParameters
+    | stop "getpwuid declaration must have exactly one parameter"
+  if variadic || !prototype || !isUnsignedInt parameterType ||
+      arguments.length != 1 then
+    stop "getpwuid C declaration has a non-uid_t parameter or wrong arity"
+  let shape ← checkShape program declaredResult
+  let .Pexpr _ _ (.PEval (.Vctype (.Ctype _ (.Pointer functionQual
+      (.Ctype _ (.Function (returnQual, callResult) callParameters false)))))) := callType
+    | stop "getpwuid call has no fixed function-pointer C prototype"
+  let [(calledQualifiers, calledParameter, _)] := callParameters
+    | stop "getpwuid call has the wrong parameter count"
+  if !qualifiersEqual functionQual no_qualifiers ||
+      !qualifiersEqual returnQual no_qualifiers ||
+      !qualifiersEqual calledQualifiers no_qualifiers ||
+      !ctypeEqual declaredResult callResult ||
+      !ctypeEqual parameterType calledParameter then
+    stop "getpwuid call and declaration prototypes differ"
+  let [.Vobject (.OVpointer uidObject)] := arguments
+    | stop "getpwuid argument is not its parameter temporary object"
+  return ⟨location, shape, uidObject⟩
+
+private def decodeStrings (bytes : ByteArray) :
+    Except Failure (Array (Option ByteArray)) := do
+  let mut cursor := 0
+  let mut result := #[]
+  for _ in [0:5] do
+    if cursor + 8 > bytes.size then stop "getpwuid string header is truncated"
+    let mut length : Nat := 0
+    let mut scale : Nat := 1
+    for _ in [0:8] do
+      length := length + (bytes.get! cursor).toNat * scale
+      cursor := cursor + 1
+      scale := scale * 256
+    if length == 18446744073709551615 then
+      result := result.push none
+    else
+      if length == 0 || length > bytes.size - cursor then
+        stop "getpwuid string length exceeds its transport payload"
+      let string := bytes.extract cursor (cursor + length)
+      if string.get! (length - 1) != 0 then
+        stop "getpwuid native string lacks its NUL terminator"
+      result := result.push (some string)
+      cursor := cursor + length
+  if cursor != bytes.size then stop "getpwuid transport has trailing bytes"
+  return result
+
+structure StaticStorage where
+  record : PointerValue
+  strings : List PointerValue
+
+structure EffectReceipt where
+  sequence : Nat
+  original : host_request
+  uid : UInt32
+  response : CerbHostSystem.SystemResult
+
+private def materialize [LemFuel] [CerbGlobal.Switches]
+    (program : Program) (location : CerbLocation.Loc) (tid : Nat)
+    (shape : Shape) (prior : Option StaticStorage)
+    (response : CerbHostSystem.SystemResult) (state : MemState) :
+    Except Failure (PointerValue × Option StaticStorage × List Footprint × MemState) := do
+  let found := response.status.value == 1
+  let strings ← if found then decodeStrings response.bytes else
+    if response.fields.size != 0 || response.bytes.size != 0 then
+      stop "NULL getpwuid response includes account fields"
+    else pure #[]
+  if found && (response.fields.size != 2 ||
+      response.fields[0]!.toNat > 4294967295 ||
+      response.fields[1]!.toNat > 4294967295) then
+    stop "getpwuid account scalar fields violate uid_t/gid_t"
+  let mut memory := state
+  if let some old := prior then
+    for pointer in old.strings do
+      let (_, after) ← immediate (killM location false pointer) memory
+      memory := after
+  if !found then
+    return (nullPtrval shape.recordType,
+      prior.map (fun old => { old with strings := [] }), [], memory)
+  let record ← match prior with
+    | some old => pure old.record
+    | none => do
+      let (pointer, after) ← immediate
+        (allocateObject program.enumDefs program.tagDefs tid
+          (PrefOther "getpwuid-static") (.IV .Prov_none 8)
+          shape.recordType none none) memory
+      memory := after
+      pure pointer
+  let mut pointers := #[]
+  let mut retained := []
+  let mut footprints := []
+  for string in strings do
+    match string with
+    | none => pointers := pointers.push (nullPtrval charType)
+    | some bytes =>
+      let ty : ctype := .Ctype [] (.Array0 CellKind.byte.ty (some bytes.size))
+      let (pointer, after) ← immediate
+        (allocateObject program.enumDefs program.tagDefs tid
+          (PrefOther "getpwuid-string") (.IV .Prov_none 1)
+          ty none none) memory
+      memory := after
+      let (cells, after) ← arrayCells program.enumDefs program.tagDefs
+        .byte pointer bytes.size memory
+      let outputs ← prepareOutputs program.enumDefs program.tagDefs cells after
+      let (writes, after) ← commitOutputs program.enumDefs program.tagDefs
+        outputs (bytes.data.toList.map (fun byte => Int.ofNat byte.toNat))
+      memory := after
+      footprints := footprints ++ writes
+      pointers := pointers.push pointer
+      retained := pointer :: retained
+  let fieldValues : Array MemValue := #[
+    .MVpointer charType pointers[0]!,
+    .MVpointer charType pointers[1]!,
+    .MVinteger CellKind.unsignedInt.ity
+      (.IV .Prov_none (Int.ofNat response.fields[0]!.toNat)),
+    .MVinteger CellKind.unsignedInt.ity
+      (.IV .Prov_none (Int.ofNat response.fields[1]!.toNat)),
+    .MVpointer charType pointers[2]!,
+    .MVpointer charType pointers[3]!,
+    .MVpointer charType pointers[4]!]
+  let fieldTypes : Array ctype := #[
+    stringPointerType, stringPointerType, CellKind.unsignedInt.ty,
+    CellKind.unsignedInt.ty, stringPointerType, stringPointerType,
+    stringPointerType]
+  for i in [0:7] do
+    let fieldPointer := memberShiftPtrval program.enumDefs program.tagDefs
+      record shape.tag shape.fields[i]!
+    let (write, after) ← immediate
+      (storeM program.enumDefs program.tagDefs location fieldTypes[i]!
+        false fieldPointer fieldValues[i]!) memory
+    memory := after
+    footprints := footprints ++ [write]
+  return (record, some ⟨record, retained.reverse⟩, footprints, memory)
+
+def supportsName (name : String) : Bool := name == "getpwuid"
+
+def execute [LemFuel] [CerbGlobal.Switches] (sequence : Nat)
+    (table : CerbHostDescriptors.Table) (prior : Option StaticStorage)
+    (state : driver_state) (original : host_request) :
+    BaseIO (Except (Failure × Option EffectReceipt)
+      (driver_state × Option StaticStorage × host_response)) := do
+  if !state.host_enabled || state.host_reply.isSome ||
+      state.host_sequence != sequence + 1 then
+    return .error (.boundary "invalid account request state or sequence", none)
+  match CerbHostDescriptors.validateIdle table with
+  | .error reason => return .error (.boundary reason, none)
+  | .ok () => pure ()
+  let .Host_external tid location errnoPointer symbol callType arguments := original
+    | return .error (.boundary "account handler requires an external request", none)
+  if state.core_state0.thread_states.length != 1 then
+    return .error (.boundary "concurrent account lookup is not implemented", none)
+  let some (_, (_, thread)) := state.core_state0.thread_states.find?
+      (fun entry => entry.1 == tid)
+    | return .error (.boundary "account request has no current guest thread", none)
+  if thread.errno != errnoPointer || thread.current_loc != location then
+    return .error (.boundary "account request changed errno or location", none)
+  let admitted ← match admit state location symbol callType arguments with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  let program := state.core_file
+  let (uidValue, uidRead, afterUid) ← match readInteger program.enumDefs
+      program.tagDefs ⟨admitted.uidObject, .unsignedInt⟩ state.layout_state with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  let (errnoValue, errnoRead, afterErrno) ← match readInteger program.enumDefs
+      program.tagDefs ⟨errnoPointer, .signedInt⟩ afterUid with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
