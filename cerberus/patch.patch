+(* The fortified read entry has the same opaque byte producer as read.
+   Its extra size argument checks the destination and may terminate, but it
+   supplies no compiler-known pointer value. This establishes preservation of
+   existing unknown-extent classes only: it is not a readonly, disjointness,
+   success, count, or runtime-memory summary. Every argument is checked by the
+   caller and the original call, writes, errors and bounds check remain. *)
+val gnu_standard_fortified_read_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_standard_fortified_read_call (A.AnnotatedExpression _ _ _ node) =
+  if not (Implementation.has_amd64_sysv_abi ()) then E.return false else
+  match node with
+    | A.AilEcall callee [_; _; _; _] ->
+        let signature = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function (_, result)
+              [(_, fd, _); (_, Ctype.Ctype _ (Ctype.Pointer qs destination), _);
+               (_, count, _); (_, bound, _)] false))) ->
+              gnu_scalar_value_type_equal fd Ctype.signed_int &&
+              gnu_scalar_value_type_equal result
+                (Ctype.Ctype [] (Ctype.Basic (Ctype.Integer (Ctype.Signed Ctype.Long)))) &&
+              AilTypesAux.is_void destination && qs = Ctype.no_qualifiers &&
+              gnu_standard_size_type count && gnu_standard_size_type bound
+          | _ -> false end in
+        if not signature || not (gnu_inline_direct_designator callee) then E.return false else
+        gnu_inline_function_target callee >>= (function
+          | Nothing -> E.return false
+          | Just (declared, _) ->
+              E.linker_name declared >>= (function
+                | Just "__read_chk" ->
+                    E.gnu_inline_target declared >>= fun target ->
+                    E.gnu_has_source_definition target >>= fun defined ->
+                    E.gnu_linker_has_source_definition "__read_chk" >>= fun alias_defined ->
+                    gnu_call_attributes callee >>= fun attrs ->
+                    E.return (not defined && not alias_defined &&
+                      not (Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs))
+                | _ -> E.return false end)
+          end)
+    | _ -> E.return false end
