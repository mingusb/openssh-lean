+val translate_if_control_branches_result:
+  bool ->
+  E.elabM (C.expr unit) -> E.elabM (C.expr unit * C.expr unit) -> E.elabM (C.expr unit)
+let translate_if_control_branches_result return_choice test branches =
+  E.wrapped_fresh_symbol C.BTy_boolean >>= fun do_then_wrp ->
+  E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun test_wrp ->
+  E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun case_wrp ->
+  test >>= fun core_test ->
+  branches >>= fun (core_left, core_right) ->
+  E.return (Caux.mk_sseq_e test_wrp.E.sym_pat core_test
+    (Caux.mk_sseq_e do_then_wrp.E.sym_pat
+      (Caux.mk_case_e test_wrp.E.sym_pe
+        [(Caux.mk_specified_pat case_wrp.E.sym_pat,
+          Caux.mk_pure_e (Caux.mk_if_pe
+            (Caux.mk_not_pe (Caux.mk_op_pe C.OpEq case_wrp.E.sym_pe (Caux.mk_integer_pe 1)))
+            (Caux.mk_boolean_pe true) (Caux.mk_boolean_pe false)));
+         (Caux.mk_unspecified_pat (Caux.mk_empty_pat C.BTy_ctype),
+          Caux.mk_nd_e [Caux.mk_pure_e (Caux.mk_boolean_pe true); Caux.mk_pure_e (Caux.mk_boolean_pe false)])])
+      (let branch = Caux.mk_if_e do_then_wrp.E.sym_pe core_left core_right in
+        if return_choice then Caux.mk_sseq_e (Caux.mk_empty_pat C.BTy_unit) branch
+          (Caux.mk_pure_e do_then_wrp.E.sym_pe) else branch)))
+
+val translate_if_control_branches:
+  E.elabM (C.expr unit) -> E.elabM (C.expr unit * C.expr unit) -> E.elabM (C.expr unit)
+let translate_if_control_branches test branches = translate_if_control_branches_result false test branches
