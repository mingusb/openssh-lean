+(* Locations, typedef spelling and the pre-adjustment source category of a
+   parameter are not part of C type compatibility. Keep all other annotations
+   conservatively, except an empty attribute container: it carries no contract.
+   In particular this is not permission to drop type attributes or ABI contracts. The original declarations remain untouched for va_start
+   validation and ordinary runtime call lowering. *)
+val gnu_function_target_annotations: list Annot.annot -> list Annot.annot
+let gnu_function_target_annotations annotations = List.filter (function
+  | Annot.Aloc _ -> false
+  | Annot.Atypedef _ -> false
+  | Annot.Aparameter_origin _ -> false
+  | Annot.Aattrs (Annot.Attrs []) -> false
+  | _ -> true
+end) annotations
+
+(* A conservative type relation for target metadata. This neither normalizes
+   enums using ambient readers nor uses ctypeEqual, whose pointer fallback does
+   not compare referents. Parameter counts, pointee qualifiers and tag/enum
+   identities must agree. As in are_compatible_params, the top-level qualifiers
+   and register storage class of function parameters do not distinguish their
+   adjusted parameter types. Other compatible representations may still refuse
+   target propagation; the ordinary indirect call remains available. *)
+val gnu_function_target_type_equal: Ctype.ctype -> Ctype.ctype -> bool
+let rec gnu_function_target_type_equal (Ctype.Ctype annotations1 left) (Ctype.Ctype annotations2 right) =
+  let self = gnu_function_target_type_equal in
+  gnu_function_target_annotations annotations1 = gnu_function_target_annotations annotations2 && match (left, right) with
+    | (Ctype.Void, Ctype.Void) -> true
+    | (Ctype.Nullptr, Ctype.Nullptr) -> true
+    | (Ctype.Byte, Ctype.Byte) -> true
+    | (Ctype.Basic left_bty, Ctype.Basic right_bty) -> left_bty = right_bty
+    | (Ctype.Pointer left_qs left_ref, Ctype.Pointer right_qs right_ref) ->
+        left_qs = right_qs && self left_ref right_ref
+    | (Ctype.Array left_element left_bound, Ctype.Array right_element right_bound) ->
+        left_bound = right_bound && self left_element right_element
+    | (Ctype.Atomic left_element, Ctype.Atomic right_element) -> self left_element right_element
+    | (Ctype.Struct left_tag, Ctype.Struct right_tag) -> left_tag = right_tag
+    | (Ctype.Union left_tag, Ctype.Union right_tag) -> left_tag = right_tag
+    | (Ctype.Function (left_qs, left_return) left_params left_variadic,
+       Ctype.Function (right_qs, right_return) right_params right_variadic) ->
+        left_qs = right_qs && self left_return right_return && left_variadic = right_variadic &&
+        List.length left_params = List.length right_params &&
+        List.all (fun ((_, left_ty, _), (_, right_ty, _)) -> self left_ty right_ty)
+          (List.zip left_params right_params)
+    | (Ctype.FunctionNoParams (left_qs, left_return), Ctype.FunctionNoParams (right_qs, right_return)) ->
+        left_qs = right_qs && self left_return right_return
+    | _ -> false
+  end
