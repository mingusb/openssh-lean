index 00000000..5c3630a0
--- /dev/null
+++ b/lean_frontend/inject_nd_runtime.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Bind generated proof-facing ND definitions to unbounded Lem runtime counterparts.
+
+The source functions remain kernel-transparent fuel approximations. Runtime
+implementations are generated from duplicate Lem equations without fuel, and
+this injection is explicit, byte-checked, and part of the normal generation
+recipe. Finite-prefix runtime correspondence has executable regression coverage;
+a general theorem relating the partial implementations remains outstanding.
+"""
+from pathlib import Path
+import sys
+
+def inject(path: Path) -> None:
+    source = path.read_text(encoding="utf-8")
+    for name in ("nd_bind_runtime", "liftND_runtime", "liftAction_runtime"):
+        if source.count("partial def " + name) != 1:
+            raise SystemExit(f"expected exactly one generated partial {name}")
+    inhabitant = """instance { a cs err info st : Type } : Nonempty (ndM a info err cs st) :=
+  Nonempty.intro (ND (fun state => (NDkilled default, state)))
+
+"""
+    if "Nonempty (ndM a info err cs st)" not in source:
+        anchor = "export ndM (ND)" + chr(10)
+        if source.count(anchor) != 1:
+            raise SystemExit("expected one generated ndM export")
+        source = source.replace(anchor, anchor + inhabitant, 1)
+    edits = {
+        "nd_bind": """private def nd_bind_operational { a b c d e f : Type } [LemFuel] :
+    ndM f b d a c -> (f -> ndM e b d a c) -> ndM e b d a c :=
+  nd_bind_runtime
+
+@[implemented_by nd_bind_operational]
+""",
+        "liftND": """private def liftND_operational { a cs err1 err2 info1 info2 st1 st2 : Type } [LemFuel] :
+    (st2 -> st1) -> (st2 -> st1 -> st2) -> (info1 -> info2) -> (err1 -> err2) ->
+      ndM a info1 err1 cs st1 -> ndM a info2 err2 cs st2 :=
+  liftND_runtime
+
+@[implemented_by liftND_operational]
+""",
+        "liftAction": """private def liftAction_operational { a cs err1 err2 info1 info2 st1 st2 : Type } [LemFuel] :
+    (st2 -> st1) -> (st2 -> st1 -> st2) -> (info1 -> info2) -> (err1 -> err2) ->
+      nd_action a info1 err1 cs st1 -> nd_action a info2 err2 cs st2 :=
+  liftAction_runtime
+
+@[implemented_by liftAction_operational]
+""",
+    }
+    for name, prefix in edits.items():
+        anchor = chr(10) + "def " + name + " {"
+        marker = "@[implemented_by " + name + "_operational]"
+        if marker in source:
+            if source.count(marker) != 1:
+                raise SystemExit(f"duplicate implementation attribute for {name}")
+            continue
+        if source.count(anchor) != 1:
+            raise SystemExit(f"expected exactly one generated wrapper {name}")
+        source = source.replace(anchor, chr(10) + prefix + "def " + name + " {", 1)
+    path.write_text(source, encoding="utf-8")
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: inject_nd_runtime.py <generated Nondeterminism.lean>")
+    inject(Path(sys.argv[1]))
