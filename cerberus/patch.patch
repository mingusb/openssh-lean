+(* Exact, format-tagged GNU AMD64 floating values. No host floating arithmetic
+   participates in parsing, rounding, conversion, arithmetic or byte payloads.
+   FP80 is the x87 80-bit payload; its six AMD64 object-padding bytes belong to
+   the memory codec, not the value. Environment adapters are separate: callers
+   currently select the ordinary nearest-even, masked-exception profile. *)
+open import Pervasives Utils
+import Ctype String_extra
+
+type fp_format = FP32 | FP64 | FP80
+type fp_value = FpValue of fp_format * integer
+type fp_rounding = FPNearestEven | FPTowardZero | FPTowardPositive | FPTowardNegative
+type fp_operator = FPAdd | FPSubtract | FPMultiply | FPDivide
+type fp_class =
+  | FPZero of bool
+  | FPFinite of bool * integer * integer
+  | FPInfinity of bool
+  | FPNaN of bool * integer * bool
+  | FPUnsupported
+
+val fp_same_format: fp_format -> fp_format -> bool
+let fp_same_format left right = match (left, right) with
+  | (FP32, FP32) -> true | (FP64, FP64) -> true | (FP80, FP80) -> true
+  | _ -> false
+end
+instance (Eq fp_format)
+  let (=) = fp_same_format
+  let (<>) left right = not (fp_same_format left right)
+end
+
+val fp_format_of_type: Ctype.realFloatingType -> maybe fp_format
+let fp_format_of_type ty = match ty with
+  | Ctype.Float -> Just FP32 | Ctype.Double -> Just FP64 | Ctype.LongDouble -> Just FP80
+  | _ -> Nothing
+end
+
+val fp_type_of_format: fp_format -> Ctype.realFloatingType
+let fp_type_of_format fmt = match fmt with
+  | FP32 -> Ctype.Float | FP64 -> Ctype.Double | FP80 -> Ctype.LongDouble
+end
+
+val fp_format_of_value: fp_value -> fp_format
+let fp_format_of_value (FpValue fmt _) = fmt
+val fp_payload_bits: fp_value -> integer
+let fp_payload_bits (FpValue _ bits) = bits
+val fp_payload_bytes: fp_format -> nat
+let fp_payload_bytes fmt = match fmt with FP32 -> 4 | FP64 -> 8 | FP80 -> 10 end
+val fp_precision: fp_format -> nat
+let fp_precision fmt = match fmt with FP32 -> 24 | FP64 -> 53 | FP80 -> 64 end
+val fp_exponent_bits: fp_format -> nat
+let fp_exponent_bits fmt = match fmt with FP32 -> 8 | FP64 -> 11 | FP80 -> 15 end
+val fp_bias: fp_format -> integer
+let fp_bias fmt = match fmt with FP32 -> 127 | FP64 -> 1023 | FP80 -> 16383 end
+val fp_stored_significand_bits: fp_format -> nat
+let fp_stored_significand_bits fmt = match fmt with FP80 -> 64 | _ -> fp_precision fmt - 1 end
+val fp_power: integer -> nat -> integer
+let fp_power base exponent = List.foldl (fun value () -> base * value) 1 (List.replicate exponent ())
+val fp_power_two: nat -> integer
+let fp_power_two exponent = fp_power 2 exponent
+val fp_min_quantum: fp_format -> integer
+let fp_min_quantum fmt = 1 - fp_bias fmt - integerFromNat (fp_precision fmt - 1)
+val fp_sign_bits: fp_format -> bool -> integer
+let fp_sign_bits fmt negative = if negative then fp_power_two (8 * fp_payload_bytes fmt - 1) else 0
+val fp_max_exponent_field: fp_format -> integer
+let fp_max_exponent_field fmt = fp_power_two (fp_exponent_bits fmt) - 1
+val fp_zero: fp_format -> bool -> fp_value
+let fp_zero fmt negative = FpValue fmt (fp_sign_bits fmt negative)
+val fp_infinity: fp_format -> bool -> fp_value
+let fp_infinity fmt negative =
+  let explicit = match fmt with FP80 -> fp_power_two 63 | _ -> 0 end in
+  FpValue fmt (fp_sign_bits fmt negative + fp_max_exponent_field fmt *
+    fp_power_two (fp_stored_significand_bits fmt) + explicit)
+val fp_max_finite: fp_format -> bool -> fp_value
+let fp_max_finite fmt negative =
+  FpValue fmt (fp_sign_bits fmt negative + (fp_max_exponent_field fmt - 1) *
+    fp_power_two (fp_stored_significand_bits fmt) +
+    fp_power_two (fp_stored_significand_bits fmt) - 1)
+
+val fp_from_bits: fp_format -> integer -> either string fp_value
+let fp_from_bits fmt bits =
+  if bits < 0 || bits >= fp_power_two (8 * fp_payload_bytes fmt) then
+    Left "floating payload is outside its format width"
+  else Right (FpValue fmt bits)
+
+val fp_classify: fp_value -> fp_class
+let fp_classify (FpValue fmt bits) =
+  let sig_width = fp_stored_significand_bits fmt in
+  let sign_place = fp_power_two (8 * fp_payload_bytes fmt - 1) in
+  let sig_place = fp_power_two sig_width in
+  let negative = bits >= sign_place in
+  let exponent = (bits / sig_place) mod fp_power_two (fp_exponent_bits fmt) in
+  let significand = bits mod sig_place in
+  let hidden = fp_power_two (fp_precision fmt - 1) in
+  let explicit = match fmt with FP80 -> true | _ -> false end in
+  let fraction = if explicit then significand mod hidden else significand in
+  if bits < 0 || bits >= 2 * sign_place then FPUnsupported
+  else if explicit && exponent <> 0 && significand < hidden then FPUnsupported
+  else if exponent = fp_max_exponent_field fmt then
+    if fraction = 0 then FPInfinity negative
+    else FPNaN negative fraction (fraction < hidden / 2)
+  else if exponent = 0 then
+    if significand = 0 then FPZero negative
+    else FPFinite negative significand (fp_min_quantum fmt)
+  else FPFinite negative (if explicit then significand else hidden + significand)
+    (exponent - fp_bias fmt - integerFromNat (fp_precision fmt - 1))
+
+val fp_is_finite: fp_value -> bool
+let fp_is_finite value = match fp_classify value with
+  | FPZero _ -> true | FPFinite _ _ _ -> true | _ -> false
+end
+val fp_bits_equal: fp_value -> fp_value -> bool
+let fp_bits_equal (FpValue f1 b1) (FpValue f2 b2) = fp_same_format f1 f2 && b1 = b2
+instance (Eq fp_value)
+  let (=) = fp_bits_equal
+  let (<>) left right = not (fp_bits_equal left right)
+end
+val fp_common_format: fp_format -> fp_format -> fp_format
+let fp_common_format left right = match (left, right) with
+  | (FP80, _) -> FP80 | (_, FP80) -> FP80
+  | (FP64, _) -> FP64 | (_, FP64) -> FP64 | _ -> FP32
+end
+
+(* A decimal spelling of a nonnegative integer has d digits, hence at most 4d
+   bits since 10 < 16. The fold is a proven magnitude bound, not a value/input
+   acceptance limit; after exhaustion the remaining value is necessarily zero. *)
+val fp_bit_length: integer -> nat
+let fp_bit_length value =
+  let budget = 4 * List.length (String.toCharList (show value)) in
+  snd (List.foldl (fun (remaining, count) () ->
+    if remaining <= 0 then (remaining, count) else (remaining / 2, count + 1))
+    (value, (0 : nat)) (List.replicate budget ()))
+
+val fp_ratio_at_least_power: integer -> integer -> integer -> bool
+let fp_ratio_at_least_power numerator denominator exponent =
+  if exponent >= 0 then numerator >= denominator * fp_power_two (natFromInteger exponent)
+  else numerator * fp_power_two (natFromInteger (0 - exponent)) >= denominator
+
+val fp_round_quotient: fp_rounding -> bool -> integer -> integer -> integer -> integer
+let fp_round_quotient mode negative quotient remainder denominator =
+  if remainder = 0 then quotient else
+  let increment = match mode with
+    | FPTowardZero -> false
+    | FPTowardPositive -> not negative
+    | FPTowardNegative -> negative
+    | FPNearestEven -> 2 * remainder > denominator ||
+        (2 * remainder = denominator && quotient mod 2 <> 0)
+  end in
+  if increment then quotient + 1 else quotient
+
+val fp_overflow: fp_format -> fp_rounding -> bool -> fp_value
+let fp_overflow fmt mode negative =
+  let infinite = match mode with
+    | FPNearestEven -> true | FPTowardZero -> false
+    | FPTowardPositive -> not negative | FPTowardNegative -> negative
+  end in
+  if infinite then fp_infinity fmt negative else fp_max_finite fmt negative
+
+val fp_round_ratio: fp_format -> fp_rounding -> bool -> integer -> integer -> either string fp_value
+let fp_round_ratio fmt mode negative numerator denominator =
+  if numerator < 0 || denominator <= 0 then Left "invalid exact floating ratio"
+  else if numerator = 0 then Right (fp_zero fmt negative)
+  else
+    let e0 = integerFromNat (fp_bit_length numerator) - integerFromNat (fp_bit_length denominator) in
+    let exponent = if fp_ratio_at_least_power numerator denominator e0 then e0 else e0 - 1 in
+    let precision_minus_one = integerFromNat (fp_precision fmt - 1) in
+    let quantum = if exponent - precision_minus_one > fp_min_quantum fmt then
+        exponent - precision_minus_one else fp_min_quantum fmt in
+    let (n, d) = if quantum < 0 then
+        (numerator * fp_power_two (natFromInteger (0 - quantum)), denominator)
+      else (numerator, denominator * fp_power_two (natFromInteger quantum)) in
+    let rounded = fp_round_quotient mode negative (n / d) (n mod d) d in
+    let hidden = fp_power_two (fp_precision fmt - 1) in
+    if rounded < hidden then Right (FpValue fmt (fp_sign_bits fmt negative + rounded))
+    else
+      let (significand, quantum) = if rounded >= 2 * hidden then (hidden, quantum + 1) else (rounded, quantum) in
+      let exponent_field = quantum + precision_minus_one + fp_bias fmt in
+      if exponent_field >= fp_max_exponent_field fmt then Right (fp_overflow fmt mode negative)
+      else
+        let fraction = match fmt with FP80 -> significand | _ -> significand - hidden end in
+        Right (FpValue fmt (fp_sign_bits fmt negative + exponent_field *
+          fp_power_two (fp_stored_significand_bits fmt) + fraction))
+
+val fp_round_scaled: fp_format -> fp_rounding -> bool -> integer -> integer -> either string fp_value
+let fp_round_scaled fmt mode negative significand exponent =
+  if exponent >= 0 then fp_round_ratio fmt mode negative
+    (significand * fp_power_two (natFromInteger exponent)) 1
+  else fp_round_ratio fmt mode negative significand (fp_power_two (natFromInteger (0 - exponent)))
+
+val fp_quiet_nan: fp_format -> bool -> integer -> fp_value
+let fp_quiet_nan fmt negative payload =
+  let hidden = fp_power_two (fp_precision fmt - 1) in
+  let fraction = (payload mod (hidden / 2)) + hidden / 2 in
+  let explicit = match fmt with FP80 -> hidden | _ -> 0 end in
+  FpValue fmt (fp_sign_bits fmt negative + fp_max_exponent_field fmt *
+    fp_power_two (fp_stored_significand_bits fmt) + explicit + fraction)
+
+val fp_convert: fp_format -> fp_rounding -> fp_value -> either string fp_value
+let fp_convert target mode (FpValue source _ as value) =
+  if fp_same_format source target then
+    match fp_classify value with FPUnsupported -> Left "unsupported x87 floating encoding" | _ -> Right value end
+  else match fp_classify value with
+    | FPUnsupported -> Left "unsupported x87 floating encoding"
+    | FPZero negative -> Right (fp_zero target negative)
+    | FPInfinity negative -> Right (fp_infinity target negative)
+    | FPFinite negative significand exponent -> fp_round_scaled target mode negative significand exponent
+    | FPNaN negative payload _ ->
+        let source_width = fp_precision source - 1 in
+        let target_width = fp_precision target - 1 in
+        let payload = if target_width >= source_width then payload * fp_power_two (target_width - source_width)
+          else payload / fp_power_two (source_width - target_width) in
+        Right (fp_quiet_nan target negative payload)
+  end
+
+val fp_from_integer: fp_format -> fp_rounding -> integer -> either string fp_value
+let fp_from_integer fmt mode value = fp_round_ratio fmt mode (value < 0) (if value < 0 then 0 - value else value) 1
+val fp_to_integer: fp_value -> either string integer
+let fp_to_integer value = match fp_classify value with
+  | FPZero _ -> Right 0
+  | FPFinite negative significand exponent ->
+      let magnitude = if exponent >= 0 then significand * fp_power_two (natFromInteger exponent)
+        else significand / fp_power_two (natFromInteger (0 - exponent)) in
+      Right (if negative then 0 - magnitude else magnitude)
+  | _ -> Left "nonfinite or unsupported floating-to-integer conversion"
+end
+
+val fp_negate: fp_value -> fp_value
+let fp_negate (FpValue fmt bits) =
+  let sign = fp_power_two (8 * fp_payload_bytes fmt - 1) in
+  FpValue fmt (if bits >= sign then bits - sign else bits + sign)
+
+val fp_signed_ratio: bool -> integer -> integer -> integer * integer
+let fp_signed_ratio negative significand exponent =
+  let numerator = if exponent >= 0 then significand * fp_power_two (natFromInteger exponent) else significand in
+  let denominator = if exponent < 0 then fp_power_two (natFromInteger (0 - exponent)) else 1 in
+  (if negative then 0 - numerator else numerator, denominator)
+
+val fp_finite_ratio: fp_class -> maybe (integer * integer)
+let fp_finite_ratio classification = match classification with
+  | FPZero _ -> Just (0, 1)
+  | FPFinite negative significand exponent -> Just (fp_signed_ratio negative significand exponent)
+  | _ -> Nothing
+end
+val fp_class_negative: fp_class -> bool
+let fp_class_negative classification = match classification with
+  | FPZero negative -> negative | FPFinite negative _ _ -> negative
+  | FPInfinity negative -> negative | FPNaN negative _ _ -> negative
+  | FPUnsupported -> false
+end
+
+(* Nothing is unordered (NaN), not equality. Comparisons are exact across
+   formats, including the two signs of zero. *)
+val fp_compare: fp_value -> fp_value -> either string (maybe integer)
+let fp_compare left right =
+  let a = fp_classify left in let b = fp_classify right in
+  match (a, b) with
+    | (FPUnsupported, _) -> Left "unsupported x87 floating encoding"
+    | (_, FPUnsupported) -> Left "unsupported x87 floating encoding"
+    | (FPNaN _ _ _, _) -> Right Nothing | (_, FPNaN _ _ _) -> Right Nothing
+    | (FPInfinity n1, FPInfinity n2) -> Right (Just (if n1 = n2 then 0 else if n1 then (0 - 1) else 1))
+    | (FPInfinity negative, _) -> Right (Just (if negative then (0 - 1) else 1))
+    | (_, FPInfinity negative) -> Right (Just (if negative then 1 else (0 - 1)))
+    | _ -> match (fp_finite_ratio a, fp_finite_ratio b) with
+        | (Just (n1, d1), Just (n2, d2)) ->
+            let l = n1 * d2 in let r = n2 * d1 in
+            Right (Just (if l < r then (0 - 1) else if l > r then 1 else 0))
+        | _ -> Left "malformed floating comparison"
+      end
+  end
+
+(* Arithmetic workers receive already classified, non-NaN operands. Each
+   operation keeps its infinity/zero rules next to its exact rational formula. *)
+val fp_add_classes: fp_format -> fp_rounding -> fp_class -> fp_class -> either string fp_value
+let fp_add_classes fmt mode left right =
+  match (left, right) with
+    | (FPInfinity a, FPInfinity b) ->
+        if a = b then Right (fp_infinity fmt a) else Right (fp_quiet_nan fmt true 0)
+    | (FPInfinity negative, _) -> Right (fp_infinity fmt negative)
+    | (_, FPInfinity negative) -> Right (fp_infinity fmt negative)
+    | _ -> match (fp_finite_ratio left, fp_finite_ratio right) with
+        | (Just (left_n, left_d), Just (right_n, right_d)) ->
+            let numerator = left_n * right_d + right_n * left_d in
+            let downward = match mode with FPTowardNegative -> true | _ -> false end in
+            let zero_negative = match (left, right) with
+              | (FPZero a, FPZero b) -> if a = b then a else downward
+              | _ -> downward
+            end in
+            fp_round_ratio fmt mode (if numerator = 0 then zero_negative else numerator < 0)
+              (if numerator < 0 then 0 - numerator else numerator) (left_d * right_d)
+        | _ -> Left "malformed floating addition"
+      end
+  end
+
+val fp_multiply_classes: fp_format -> fp_rounding -> fp_class -> fp_class -> either string fp_value
+let fp_multiply_classes fmt mode left right =
+  let negative = fp_class_negative left <> fp_class_negative right in
+  match (left, right) with
+    | (FPInfinity _, FPZero _) -> Right (fp_quiet_nan fmt true 0)
+    | (FPZero _, FPInfinity _) -> Right (fp_quiet_nan fmt true 0)
+    | (FPInfinity _, _) -> Right (fp_infinity fmt negative)
+    | (_, FPInfinity _) -> Right (fp_infinity fmt negative)
+    | _ -> match (fp_finite_ratio left, fp_finite_ratio right) with
+        | (Just (left_n, left_d), Just (right_n, right_d)) ->
+            let numerator = left_n * right_n in
+            fp_round_ratio fmt mode negative
+              (if numerator < 0 then 0 - numerator else numerator) (left_d * right_d)
+        | _ -> Left "malformed floating multiplication"
+      end
+  end
+
+val fp_divide_classes: fp_format -> fp_rounding -> fp_class -> fp_class -> either string fp_value
+let fp_divide_classes fmt mode left right =
+  let negative = fp_class_negative left <> fp_class_negative right in
+  match (left, right) with
+    | (FPInfinity _, FPInfinity _) -> Right (fp_quiet_nan fmt true 0)
+    | (FPZero _, FPZero _) -> Right (fp_quiet_nan fmt true 0)
+    | (FPInfinity _, _) -> Right (fp_infinity fmt negative)
+    | (_, FPInfinity _) -> Right (fp_zero fmt negative)
+    | (_, FPZero _) -> Right (fp_infinity fmt negative)
+    | _ -> match (fp_finite_ratio left, fp_finite_ratio right) with
+        | (Just (left_n, left_d), Just (right_n, right_d)) ->
+            let numerator = left_n * right_d in
+            let denominator = left_d * right_n in
+            fp_round_ratio fmt mode negative
+              (if numerator < 0 then 0 - numerator else numerator)
+              (if denominator < 0 then 0 - denominator else denominator)
+        | _ -> Left "malformed floating division"
+      end
+  end
+
+val fp_binary: fp_format -> fp_rounding -> fp_operator -> fp_value -> fp_value -> either string fp_value
+let fp_binary fmt mode operation left right =
+  let right = match (operation, fp_classify right) with
+    | (FPSubtract, FPNaN _ _ _) -> right
+    | (FPSubtract, _) -> fp_negate right
+    | _ -> right
+  end in
+  let operation = match operation with FPSubtract -> FPAdd | _ -> operation end in
+  let left_class = fp_classify left in
+  let right_class = fp_classify right in
+  match (left_class, right_class) with
+    | (FPUnsupported, _) -> Left "unsupported x87 floating encoding"
+    | (_, FPUnsupported) -> Left "unsupported x87 floating encoding"
+    | (FPNaN _ _ _, FPNaN _ _ _) ->
+        Left "two-NaN payload selection requires the target instruction profile"
+    | (FPNaN negative payload _, _) ->
+        fp_convert fmt mode (fp_quiet_nan (fp_format_of_value left) negative payload)
+    | (_, FPNaN negative payload _) ->
+        fp_convert fmt mode (fp_quiet_nan (fp_format_of_value right) negative payload)
+    | _ -> match operation with
+        | FPAdd -> fp_add_classes fmt mode left_class right_class
+        | FPMultiply -> fp_multiply_classes fmt mode left_class right_class
+        | FPDivide -> fp_divide_classes fmt mode left_class right_class
+        | FPSubtract -> Left "internal unnormalized floating subtraction"
+      end
+  end
+
+val fp_digit: char -> maybe integer
+let fp_digit c =
+  let code = String_extra.ord c in
+  if code >= 48 && code <= 57 then Just (integerFromNat (code - 48))
+  else if code >= 97 && code <= 102 then Just (10 + integerFromNat (code - 97))
+  else if code >= 65 && code <= 70 then Just (10 + integerFromNat (code - 65))
+  else Nothing
+val fp_digit_in_base: integer -> char -> bool
+let fp_digit_in_base base c = match fp_digit c with Just n -> n < base | Nothing -> false end
+val fp_digits: integer -> list char -> integer
+let fp_digits base chars = List.foldl (fun n c -> n * base + maybe 0 (fun d -> d) (fp_digit c)) 0 chars
+
+val fp_exponent: list char -> either string integer
+let fp_exponent chars =
+  let (negative, digits) = match chars with
+    | #'-' :: rest -> (true, rest) | #'+' :: rest -> (false, rest) | _ -> (false, chars) end in
+  if digits = [] || not (List.all (fp_digit_in_base 10) digits) then Left "malformed floating exponent"
+  else let n = fp_digits 10 digits in Right (if negative then 0 - n else n)
+
+val fp_parse_magnitude: integer -> list char -> either string (integer * integer * nat)
+let fp_parse_magnitude base chars =
+  let integral = List.takeWhile (fp_digit_in_base base) chars in
+  let rest = List.drop (List.length integral) chars in
+  let (fractional, rest) = match rest with
+    | #'.' :: tail -> let digits = List.takeWhile (fp_digit_in_base base) tail in
+        (digits, List.drop (List.length digits) tail)
+    | _ -> ([], rest) end in
+  if integral = [] && fractional = [] then Left "floating literal has no digits" else
+  let explicit_exponent = match rest with
+    | [] -> Right 0
+    | marker :: tail -> if (base = 16 && (marker = #'p' || marker = #'P')) ||
+        (base = 10 && (marker = #'e' || marker = #'E')) then fp_exponent tail
+        else Left "malformed floating literal suffix"
+  end in
+  match explicit_exponent with
+    | Left message -> Left message
+    | Right exponent ->
+        let bits_per_digit = if base = 16 then 4 else 1 in
+        Right (fp_digits base (integral ++ fractional),
+          exponent - bits_per_digit * integerFromNat (List.length fractional),
+          if base = 16 then 4 * (List.length integral + List.length fractional)
+            else List.length integral + List.length fractional)
+  end
+
+(* GNU nan builtins use a base-0 integer payload truncated into the quiet
+   significand. Empty payload selects the default quiet NaN. Nonliteral,
+   signed, whitespace-bearing, over-64-bit and partially consumed tags remain explicit
+   frontend boundaries until the corresponding runtime nan route is modeled. *)
+val fp_parse_nan_payload: list char -> either string integer
+let fp_parse_nan_payload chars =
+  if chars = [] then Right 0 else
+  let (base, digits) = match chars with
+    | #'0' :: #'x' :: rest -> (16, rest)
+    | #'0' :: #'X' :: rest -> (16, rest)
+    | #'0' :: rest -> (8, #'0' :: rest)
+    | _ -> (10, chars)
+  end in
+  if digits = [] || not (List.all (fp_digit_in_base base) digits) then
+    Left "GNU NaN payload requires a complete nonnegative base-0 integer literal"
+  else let payload = fp_digits base digits in
+    if payload >= fp_power_two 64 then Left "GNU NaN payload beyond unsigned long long range is not implemented"
+    else Right payload
+
+val fp_parse_finite: fp_format -> bool -> list char -> either string fp_value
+let fp_parse_finite fmt negative chars =
+  let (base, digits) = match chars with
+    | #'0' :: #'x' :: rest -> (16, rest)
+    | #'0' :: #'X' :: rest -> (16, rest)
+    | _ -> (10, chars)
+  end in
+  match fp_parse_magnitude base digits with
+    | Left message -> Left message
+    | Right (mantissa, exponent, bound) ->
+        let scale = if base = 16 then 2 else 10 in
+        if mantissa = 0 then Right (fp_zero fmt negative)
+        else if exponent > fp_bias fmt + 1 then Right (fp_infinity fmt negative)
+        else if exponent + integerFromNat bound < fp_min_quantum fmt - 1 then Right (fp_zero fmt negative)
+        else if exponent >= 0 then fp_round_ratio fmt FPNearestEven negative
+          (mantissa * fp_power scale (natFromInteger exponent)) 1
+        else fp_round_ratio fmt FPNearestEven negative mantissa (fp_power scale (natFromInteger (0 - exponent)))
+  end
+
+val fp_parse: fp_format -> string -> either string fp_value
+let fp_parse fmt text =
+  let (negative, chars) = match String.toCharList text with
+    | #'-' :: rest -> (true, rest)
+    | #'+' :: rest -> (false, rest)
+    | chars -> (false, chars)
+  end in
+  if chars = String.toCharList "inf" then Right (fp_infinity fmt negative)
+  else if chars = String.toCharList "nan" then Right (fp_quiet_nan fmt negative 0)
+  else match chars with
+    | #'n' :: #'a' :: #'n' :: #'(' :: rest ->
+        (match List.reverse rest with
+          | #')' :: reversed_payload ->
+              (match fp_parse_nan_payload (List.reverse reversed_payload) with
+                | Left message -> Left message
+                | Right payload -> Right (fp_quiet_nan fmt negative payload)
+              end)
+          | _ -> Left "malformed GNU NaN payload literal"
+        end)
+    | _ -> fp_parse_finite fmt negative chars
+  end
