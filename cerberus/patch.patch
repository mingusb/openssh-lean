diff --git a/frontend/model/bitfield_value.lem b/frontend/model/bitfield_value.lem
new file mode 100644
index 00000000..52b78e36
--- /dev/null
+++ b/frontend/model/bitfield_value.lem
@@ -0,0 +1,136 @@
+(* Finite per-bit representation shared by concrete OCaml and Lean memory.
+   Access checking and action footprints belong to the memory consumers. *)
+open import Pervasives Num_extra Utils
+
+type bit_fragment 'prov = <|
+  fragment_value: maybe bool;
+  fragment_provenance: 'prov;
+|>
+
+type field_slice = <|
+  field_start: nat;
+  field_width: nat;
+  field_signed: bool;
+|>
+
+type field_observation 'prov = <|
+  field_value: maybe integer;
+  field_provenances: list 'prov;
+|>
+
+(* A byte is exactly eight low-to-high bits. Missing values remain missing;
+   zero is never substituted for an unspecified bit in a loaded value. *)
+val fragments_of_byte: forall 'p. 'p -> maybe integer -> list (bit_fragment 'p)
+let fragments_of_byte prov value =
+  List.mapi (fun index _ ->
+    <| fragment_value= Maybe.map (fun n ->
+         integerRem_f (integerDiv_t n (2 ** index)) 2 = 1) value;
+       fragment_provenance= prov |>
+  ) (List.replicate 8 ())
+
+val valid_bytes: forall 'p. list (list (bit_fragment 'p)) -> bool
+let valid_bytes bytes = List.all (fun bits -> List.length bits = 8) bytes
+
+val valid_slice: nat -> field_slice -> bool
+let valid_slice bytes slice =
+  slice.field_width > 0 && slice.field_start + slice.field_width <= 8 * bytes
+
+val read_unsigned_fragments: forall 'p. list (bit_fragment 'p) -> maybe integer
+let read_unsigned_fragments bits =
+  List.foldr (fun bit acc ->
+    match (bit.fragment_value, acc) with
+      | (Just b, Just n) -> Just ((if b then 1 else 0) + 2 * n)
+      | _ -> Nothing
+    end
+  ) (Just 0) bits
+
+(* Width-limited two's-complement interpretation on the pinned AMD64 target.
+   The caller must first perform the C assignment conversion (_Bool uses
+   comparison with zero, not truncation). This function performs the further
+   narrowing to the declared field width. *)
+val narrow_field_value: field_slice -> integer -> either string integer
+let narrow_field_value slice n =
+  if slice.field_width = 0 then Left "zero-width field has no value"
+  else
+    let modulus = 2 ** slice.field_width in
+    let unsigned = integerRem_f n modulus in
+    Right (if slice.field_signed && unsigned >= 2 ** (slice.field_width - 1)
+           then unsigned - modulus else unsigned)
+
+val read_field:
+  forall 'p. field_slice -> list (list (bit_fragment 'p)) ->
+  either string (field_observation 'p)
+let read_field slice bytes =
+  if not (valid_bytes bytes) then Left "malformed partial-byte representation"
+  else if not (valid_slice (List.length bytes) slice) then
+    Left "bitfield slice outside the supplied byte window"
+  else
+    let selected = List.take slice.field_width
+      (List.drop slice.field_start (List.concat bytes)) in
+    let signed_value = match read_unsigned_fragments selected with
+      | Nothing -> Nothing
+      | Just n ->
+          Just (if slice.field_signed && n >= 2 ** (slice.field_width - 1)
+                then n - 2 ** slice.field_width else n)
+      end in
+    Right <| field_value= signed_value;
+             field_provenances= List.map (fun bit -> bit.fragment_provenance) selected |>
+
+(* A single mask update. Outside bits are returned verbatim, including their
+   specifiedness and provenance. There is no intermediate whole-slot load or
+   store and no write to untouched bytes. Undefined source values make only
+   the selected bits unspecified. *)
+val write_field:
+  forall 'p. field_slice -> 'p -> maybe integer ->
+  list (list (bit_fragment 'p)) -> either string (list (list (bit_fragment 'p)))
+let write_field slice source_prov value bytes =
+  if not (valid_bytes bytes) then Left "malformed partial-byte representation"
+  else if not (valid_slice (List.length bytes) slice) then
+    Left "bitfield slice outside the supplied byte window"
+  else
+    let unsigned = Maybe.map (fun n -> integerRem_f n (2 ** slice.field_width)) value in
+    Right (List.mapi (fun byte_index bits ->
+      List.mapi (fun bit_index old ->
+        let absolute = 8 * byte_index + bit_index in
+        if absolute < slice.field_start || absolute >= slice.field_start + slice.field_width
+        then old
+        else <| fragment_value= Maybe.map (fun n ->
+                 integerRem_f (integerDiv_t n (2 ** (absolute - slice.field_start))) 2 = 1) unsigned;
+                fragment_provenance= source_prov |>
+      ) bits
+    ) bytes)
+
+(* Exact known/data masks for diagnostics. The data bits under an unknown
+   mask bit are zero only in this diagnostic encoding, never in C semantics. *)
+val fragment_masks: forall 'p. list (bit_fragment 'p) -> integer * integer
+let fragment_masks bits =
+  List.foldr (fun bit (known, value) ->
+    match bit.fragment_value with
+      | Nothing -> (2 * known, 2 * value)
+      | Just b -> (1 + 2 * known, (if b then 1 else 0) + 2 * value)
+    end
+  ) (0, 0) bits
+
+(* A selected unsigned field of width < int-width, or a signed field of
+   width <= int-width, has an int-representable range. The typing integration
+   must retain width through lvalue conversion and use this range test only
+   where C/GNU integer promotions apply; it must not replace an extended
+   >int-width field with its un-narrowed declared base type. *)
+val field_range_fits_int: nat -> field_slice -> bool
+let field_range_fits_int int_width slice =
+  slice.field_width > 0 &&
+    (if slice.field_signed then slice.field_width <= int_width
+     else slice.field_width < int_width)
+
+(* Access spans in bits, for the sequential overlap checker. The concurrency
+   memory-location group is separately the maximal contiguous bitfield run,
+   split by a zero-width or ordinary member; it must not be confused with
+   this selected scalar range. *)
+val selected_bit_range: integer -> field_slice -> integer * integer
+let selected_bit_range address slice =
+  let first = 8 * address + integerFromNat slice.field_start in
+  (first, first + integerFromNat slice.field_width)
+
+val bit_ranges_overlap: (integer * integer) -> (integer * integer) -> bool
+let bit_ranges_overlap (first1, end1) (first2, end2) =
+  first1 < end2 && first2 < end1
