+  Ctype.ctype -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_volatile_pointer_value_load target_ty (A.AnnotatedExpression _ _ _ node as expr) =
+  AilTypesAux.is_pointer target_ty &&
+  gnu_function_target_type_equal target_ty (ctype_of expr) &&
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident _) as operand) ->
+        let (qs, ty) = qualified_ctype_of operand in
+        qs.Ctype.volatile && not (AilTypesAux.is_atomic ty)
+    | A.AilEannot _ operand -> gnu_volatile_pointer_value_load target_ty operand
+    | A.AilEcast _ _ operand -> gnu_volatile_pointer_value_load target_ty operand
+    | _ -> false
+  end
