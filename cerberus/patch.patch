diff --git a/lean_frontend/AilSyntax_lemMeasureProofs.lean b/lean_frontend/AilSyntax_lemMeasureProofs.lean
new file mode 100644
index 00000000..376cc287
--- /dev/null
+++ b/lean_frontend/AilSyntax_lemMeasureProofs.lean
@@ -0,0 +1,150 @@
+import AilSyntax
+
+set_option autoImplicit false
+
+namespace AilSyntax_lemMeasureProofs
+
+/-- Lem projects statement records before inspecting their constructors. Expose
+    that strictly smaller node to the automatic termination prover. -/
+@[simp] theorem statement_node_size_lt {a : Type} [SizeOf a]
+    (stmt : statement a) : sizeOf stmt.node < sizeOf stmt := by
+  cases stmt
+  simp
+  omega
+
+/-- Above each derived measure, both members of the mutually recursive block
+    are stable across any two fuel values. The list measure includes one extra
+    step for the empty-list base case, so neither worker reaches its fallback. -/
+private theorem statement_expression_result_stable_aux {a : Type} (k : Nat) :
+    (∀ (stmt : statement a) (f g : Nat),
+      statement.lemSize stmt ≤ k →
+      statement.lemSize stmt ≤ f →
+      statement.lemSize stmt ≤ g →
+      statement_expression_result_lemFuel f stmt = statement_expression_result_lemFuel g stmt) ∧
+    (∀ (statements : List (statement a)) (f g : Nat),
+      expression_.lemSize_aux6 statements + 1 ≤ k →
+      expression_.lemSize_aux6 statements + 1 ≤ f →
+      expression_.lemSize_aux6 statements + 1 ≤ g →
+      statement_expression_result_list_lemFuel f statements =
+        statement_expression_result_list_lemFuel g statements) := by
+  induction k with
+  | zero =>
+      constructor
+      · intro stmt f g hk hf hg
+        have hpos : 0 < statement.lemSize stmt := by
+          cases stmt with
+          | mk loc desug attrs node =>
+              simp only [statement.lemSize]
+              omega
+        omega
+      · intro statements f g hk hf hg
+        omega
+  | succ k ih =>
+      obtain ⟨ih_stmt, ih_list⟩ := ih
+      constructor
+      · intro stmt f g hk hf hg
+        have hpos : 0 < statement.lemSize stmt := by
+          cases stmt with
+          | mk loc desug attrs node =>
+              simp only [statement.lemSize]
+              omega
+        cases f with
+        | zero => omega
+        | succ f =>
+            cases g with
+            | zero => omega
+            | succ g =>
+                cases stmt with
+                | mk loc desug attrs node =>
+                    cases node <;> try rfl
+                    case AilSlabel label body annot =>
+                      have hlt : statement.lemSize body <
+                          statement.lemSize
+                            (statement.mk loc desug attrs (AilSlabel label body annot)) := by
+                        simp only [statement.lemSize, statement_.lemSize]
+                        omega
+                      have hstable := ih_stmt body f g (by omega) (by omega) (by omega)
+                      change statement_expression_result_lemFuel f body =
+                        statement_expression_result_lemFuel g body
+                      exact hstable
+                    case AilSmarker marker body =>
+                      have hlt : statement.lemSize body <
+                          statement.lemSize
+                            (statement.mk loc desug attrs (AilSmarker marker body)) := by
+                        simp only [statement.lemSize, statement_.lemSize]
+                        omega
+                      have hstable := ih_stmt body f g (by omega) (by omega) (by omega)
+                      change statement_expression_result_lemFuel f body =
+                        statement_expression_result_lemFuel g body
+                      exact hstable
+                    case AilSvla_scope symbol captures types body =>
+                      cases body with
+                      | mk bodyLoc bodyDesug bodyAttrs bodyNode =>
+                          cases bodyNode <;> try rfl
+                          case AilSblock bindings statements =>
+                            have hlt : expression_.lemSize_aux6 statements + 1 <
+                                statement.lemSize
+                                  (statement.mk loc desug attrs
+                                    (AilSvla_scope symbol captures types
+                                      (statement.mk bodyLoc bodyDesug bodyAttrs
+                                        (AilSblock bindings statements)))) := by
+                              simp only [statement.lemSize, statement_.lemSize,
+                                expression_.lemSize_aux6]
+                              omega
+                            have hstable := ih_list statements f g (by omega) (by omega) (by omega)
+                            change statement_expression_result_list_lemFuel f statements =
+                              statement_expression_result_list_lemFuel g statements
+                            exact hstable
+      · intro statements f g hk hf hg
+        have hpos : 0 < expression_.lemSize_aux6 statements + 1 := by omega
+        cases f with
+        | zero => omega
+        | succ f =>
+            cases g with
+            | zero => omega
+            | succ g =>
+                cases statements with
+                | nil =>
+                    change none = none
+                    rfl
+                | cons head tail =>
+                    cases tail with
+                    | nil =>
+                        have hlt : statement.lemSize head <
+                            expression_.lemSize_aux6 [head] + 1 := by
+                          simp only [expression_.lemSize_aux6]
+                          omega
+                        have hstable := ih_stmt head f g (by omega) (by omega) (by omega)
+                        change statement_expression_result_lemFuel f head =
+                          statement_expression_result_lemFuel g head
+                        exact hstable
+                    | cons second rest =>
+                        have hlt : expression_.lemSize_aux6 (second :: rest) + 1 <
+                            expression_.lemSize_aux6 (head :: second :: rest) + 1 := by
+                          simp only [expression_.lemSize_aux6]
+                          omega
+                        have hstable := ih_list (second :: rest) f g (by omega) (by omega) (by omega)
+                        change statement_expression_result_list_lemFuel f (second :: rest) =
+                          statement_expression_result_list_lemFuel g (second :: rest)
+                        exact hstable
+
+theorem statement_expression_result_measure_sufficient {a : Type}
+    (stmt : statement a) (lemFuel : Nat)
+    (lemMeasureLe : statement.lemSize stmt ≤ lemFuel) :
+    statement_expression_result_lemFuel lemFuel stmt = statement_expression_result stmt := by
+  have hstable := (statement_expression_result_stable_aux (statement.lemSize stmt)).1
+    stmt (statement.lemSize stmt) lemFuel (Nat.le_refl _) (Nat.le_refl _) lemMeasureLe
+  simpa only [statement_expression_result] using hstable.symm
+
+theorem statement_expression_result_list_measure_sufficient {a : Type}
+    (statements : List (statement a)) (lemFuel : Nat)
+    (lemMeasureLe : expression_.lemSize_aux6 statements + 1 ≤ lemFuel) :
+    statement_expression_result_list_lemFuel lemFuel statements =
+      statement_expression_result_list statements := by
+  have hstable :=
+    (statement_expression_result_stable_aux (expression_.lemSize_aux6 statements + 1)).2
+      statements (expression_.lemSize_aux6 statements + 1) lemFuel
+      (Nat.le_refl _) (Nat.le_refl _) lemMeasureLe
+  simpa only [statement_expression_result_list] using hstable.symm
+
+end AilSyntax_lemMeasureProofs
