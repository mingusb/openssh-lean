+(* An ordinary opaque pointer parameter remains opaque when it is advanced
+   within its original object. This certifies an extent class, not its current
+   pointer value or any pointee contents. Caller-specific instances never use
+   this exemption, and the whole-function escape/refinement gates still apply. *)
+val gnu_opaque_pointer_self_offset:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_opaque_pointer_self_offset sym (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_opaque_pointer_self_offset sym in
+  let offset operand = AilTypesAux.is_integer (ctype_of operand) &&
+    gnu_inline_parameter_expression_safe sym operand in
+  if not (AilTypesAux.is_pointer (ctype_of expr)) then false else match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident other) as object_expr) ->
+        let (qs, ty) = qualified_ctype_of object_expr in
+        other = sym && not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty)
+    | A.AilEcast _ ty operand -> AilTypesAux.is_pointer ty && self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEbinary left (A.Arithmetic A.Add) right ->
+        (self left && offset right) || (offset left && self right)
+    | A.AilEbinary left (A.Arithmetic A.Sub) right -> self left && offset right
+    | _ -> false
+  end
