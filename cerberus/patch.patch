+/* Intern stable function descriptors by pointer. The descriptor is allocated
+   once per distinct function, not once per memoized call. */
+static memo_table memo_codes;
+static lean_object *memo_code_key(void *fn) {
+    if (!memo_codes.capacity) {
+        memo_codes.capacity = 1024;
+        memo_codes.buckets = memo_alloc(1024, sizeof(*memo_codes.buckets));
+    }
+    /* Code addresses are not Lean objects, so this table's key is boxed. */
+    lean_object *raw = lean_box_uint64((uint64_t)(uintptr_t)fn);
+    memo_codes.structural = 1;
+    uint64_t hash = memo_hash(&memo_codes, raw);
+    memo_entry *entry = memo_find(&memo_codes, raw, hash);
+    if (entry) { lean_dec(raw); lean_inc(entry->value); return entry->value; }
+    Dl_info info;
+    lean_object *key;
+    if (dladdr(fn, &info) && info.dli_fname && info.dli_fbase) {
+        char *path = realpath(info.dli_fname, NULL);
+        if (!path) path = strdup(info.dli_fname);
+        key = memo_pair(lean_mk_string(path),
+            lean_box_uint64((uint64_t)((uintptr_t)fn - (uintptr_t)info.dli_fbase)));
+        free(path);
+    } else {
+        /* No relocatable code identity: retain in-process caching, but never
+           publish a snapshot which could contain this process-specific key. */
+        memo_disk_enabled = 0;
+        key = memo_pair(lean_mk_string("process-only"), lean_box_uint64((uintptr_t)fn));
+    }
+    lean_inc(key);
+    memo_put(&memo_codes, raw, key, 0);
+    return key;
+}
