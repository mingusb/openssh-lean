+(* Source compatibility admits variable bounds. The values have already been
+   captured once; these pure checks compare their instantiated types without
+   reading bound variables or evaluating either source expression again.
+   Pointer-to-void conversions impose no array compatibility requirement. *)
+let vla_check_pointer_compatibility loc left right body =
+  match (AilTypesAux.referenced_type (Ctype.unatomic left),
+         AilTypesAux.referenced_type (Ctype.unatomic right)) with
+    | (Just element_left, Just element_right) ->
+        if (Vla_types.vla_has_runtime_extent element_left || Vla_types.vla_has_runtime_extent element_right) &&
+           AilTypesAux.are_compatible (Ctype.no_qualifiers, element_left) (Ctype.no_qualifiers, element_right) then
+          Caux.mk_if_e
+            (Caux.mk_are_compatible (Caux.mk_ail_ctype_pe element_left) (Caux.mk_ail_ctype_pe element_right))
+            body (Caux.mk_pure_e (Caux.mk_std_undef_pe loc "Â§6.7.6.2#6" Undefined.UB076))
+        else body
+    | _ -> body
+  end
+
+let vla_expression_compatibility expression body =
+  let A.AnnotatedExpression _ _ loc node = expression in
+  let compare left right = vla_check_pointer_compatibility loc (ctype_of left) (ctype_of right) body in
+  match node with
+    | A.AilEassign left right -> compare left right
+    | A.AilEbinary left (A.Arithmetic A.Sub) right -> compare left right
+    | A.AilEbinary left A.Lt right -> compare left right
+    | A.AilEbinary left A.Gt right -> compare left right
+    | A.AilEbinary left A.Le right -> compare left right
+    | A.AilEbinary left A.Ge right -> compare left right
+    | A.AilEbinary left A.Eq right -> compare left right
+    | A.AilEbinary left A.Ne right -> compare left right
+    | A.AilEcond _ (Just left) right -> compare left right
+    | A.AilEcall callee arguments ->
+        let Ctype.Ctype _ function_type = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ target) -> target
+          | ty -> ty
+        end in
+        (match function_type with
+          | Ctype.Function _ parameters _ ->
+              List.foldr (fun ((_, expected, _), argument) result ->
+                vla_check_pointer_compatibility loc expected (ctype_of argument) result)
+                body (List.zip parameters arguments)
+          | _ -> body
+        end)
+    | _ -> body
+  end
