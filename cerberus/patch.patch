+    if (ok) {
+        memo_loaded = lean_alloc_array(0, memo_part_count);
+        memo_regions = lean_alloc_array(0, memo_part_count);
+        for (size_t i = 0; ok && i < memo_part_count; ++i) {
+            lean_object *path = lean_mk_string(memo_part_paths[i]);
+            lean_object *res = lean_compacted_region_read(path, memo_regions);
+            if (lean_io_result_is_ok(res)) {
+                lean_object *pair = lean_io_result_take_value(res);
+                lean_object *region = lean_ctor_get(pair, 1);
+                lean_inc(region);
+                memo_regions = lean_array_push(memo_regions, region);
+                memo_loaded = lean_array_push(memo_loaded, pair);
+                size_t count = lean_array_size(lean_ctor_get(pair, 0));
+                if (i && count != memo_loaded_count) ok = 0;
+                memo_loaded_count = count;
