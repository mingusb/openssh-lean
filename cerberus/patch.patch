+static void memo_gc_parts(size_t keep_from) {
+    DIR *dir = opendir(memo_directory);
+    if (!dir) return;
+    struct dirent *ent;
+    while ((ent = readdir(dir))) {
+        if (!memo_part_name(ent->d_name)) continue;
+        char *path = memo_format("%s/%s", memo_directory, ent->d_name);
+        int keep = 0;
+        for (size_t i = keep_from; i < memo_part_count; ++i)
+            if (!strcmp(path, memo_part_paths[i])) { keep = 1; break; }
+        if (!keep && memo_regular_owned(path)) unlink(path);
+        free(path);
