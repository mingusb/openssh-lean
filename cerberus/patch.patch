diff --git a/lean_frontend/host/families/network/guest/templates/memory_cells.lean.in b/lean_frontend/host/families/network/guest/templates/memory_cells.lean.in
new file mode 100644
index 00000000..ef74b45b
--- /dev/null
+++ b/lean_frontend/host/families/network/guest/templates/memory_cells.lean.in
@@ -0,0 +1,193 @@
+/- Generated shared memory codec. The returned snapshot is the original state;
+probe stores and their access observations never enter the execution state. -/
+import CerbMem
+
+namespace CerbHostMemoryCells
+open CerbMem CerberusImpl
+
+abbrev TagDefs := CerbTags.TagDefsMap
+
+inductive Failure where
+  | boundary (message : String)
+  | memory (reason : kill_reason mem_error)
+
+def immediate {α : Type} (action : memM α) (state : MemState) : Except Failure (α × MemState) :=
+  let .ND next := action
+  match next state with
+  | (.NDactive value, after) => .ok (value, after)
+  | (.NDkilled reason, _) => .error (.memory reason)
+  | _ => .error (.boundary "host memory preparation requires a single immediate memory outcome")
+
+inductive CellKind where
+  | byte | signedShort | unsignedShort | signedInt | unsignedInt | signedLong | unsignedLong
+  deriving BEq, Repr
+
+def CellKind.ity : CellKind → integerType
+  | .byte => .Unsigned .Ichar
+  | .signedShort => .Signed .Short
+  | .unsignedShort => .Unsigned .Short
+  | .signedLong => .Signed .Long
+  | .unsignedLong => .Unsigned .Long
+  | .signedInt => .Signed .Int_
+  | .unsignedInt => .Unsigned .Int_
+
+def CellKind.ty : CellKind → ctype
+  | .byte => unsigned_char
+  | .signedShort => signed_short
+  | .unsignedShort => unsigned_short
+  | .signedLong => signed_long
+  | .unsignedLong => unsigned_long
+  | .signedInt => signed_int
+  | .unsignedInt => unsigned_int
+
+def CellKind.width : CellKind → Nat
+  | .byte => 1
+  | .signedShort | .unsignedShort => 2
+  | .signedLong | .unsignedLong => 8
+  | .signedInt | .unsignedInt => 4
+
+def CellKind.accepts (kind : CellKind) (value : Int) : Bool :=
+  match kind with
+  | .byte => 0 ≤ value && value ≤ 255
+  | .signedShort => -32768 ≤ value && value ≤ 32767
+  | .unsignedShort => 0 ≤ value && value ≤ 65535
+  | .signedLong => -9223372036854775808 ≤ value && value ≤ 9223372036854775807
+  | .unsignedLong => 0 ≤ value && value ≤ 18446744073709551615
+  | .signedInt => -2147483648 ≤ value && value ≤ 2147483647
+  | .unsignedInt => 0 ≤ value && value ≤ 4294967295
+
+structure Cell where
+  pointer : PointerValue
+  kind : CellKind
+
+private def location := CerbLocation.other "generated host memory codec"
+
+private def ordinaryAddress : PointerValue → Except Failure (Int × Int)
+  | .PV (.Prov_some allocation) (.PVconcrete _ address) => .ok (allocation, address)
+  | _ => .error (.boundary "host memory requires an ordinary concrete allocation pointer")
+
+private def storeValue [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (cell : Cell) (value : Int) (state : MemState) : Except Failure (Footprint × MemState) := do
+  if !cell.kind.accepts value then
+    throw (.boundary "host result is outside its declared modeled integer type")
+  immediate (storeM enums tags location cell.kind.ty false cell.pointer
+    (.MVinteger cell.kind.ity (.IV .Prov_none value))) state
+
+private def checkCell [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (cell : Cell) (state : MemState) : Except Failure MemState := do
+  let _ ← ordinaryAddress cell.pointer
+  if sizeofCtype enums tags cell.kind.ty != cell.kind.width then
+    throw (.boundary "host output integer width differs from the pinned ABI")
+  let (valid, alignedState) ← immediate
+    (validForDerefPtrval enums tags cell.kind.ty cell.pointer) state
+  if !valid then throw (.boundary "host output pointer fails model lifetime/alignment checks")
+  -- This is a real store evaluated on a disposable snapshot. The representative
+  -- value is type-valid; no pointer, allocator or function-pointer side effect.
+  let (_, probeState) ← storeValue enums tags cell 0 alignedState
+  return probeState
+
+private def noOverlaps (cells : List Cell) : Except Failure Unit := do
+  let mut spans : List (Int × Nat) := []
+  for cell in cells do
+    let (_, address) ← ordinaryAddress cell.pointer
+    let width := cell.kind.width
+    if spans.any (fun (start, count) =>
+        address < start + (count : Int) && start < address + (width : Int)) then
+      throw (.boundary "overlapping host output cells require an alias-preserving contract")
+    spans := (address, width) :: spans
+
+/-- The constructor is private: clients cannot fabricate a successfully prepared
+output set or retarget it. No equality on MemState is used. -/
+structure PreparedOutputs where
+  private mk ::
+  snapshot : MemState
+  cells : List Cell
+
+def prepareOutputs [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (cells : List Cell) (state : MemState) : Except Failure PreparedOutputs := do
+  noOverlaps cells
+  let mut probe := state
+  for cell in cells do
+    probe ← checkCell enums tags cell probe
+  return ⟨state, cells⟩
+
+def PreparedOutputs.length (prepared : PreparedOutputs) : Nat := prepared.cells.length
+
+/-- Passing no replacement state/pointers makes the snapshot relationship
+explicit. The caller must not run modeled actions between prepare and finish.
+If an unexpected post-effect validation failure occurs, stop without retry. -/
+def commitSelectedOutputs [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (prepared : PreparedOutputs) (values : List (Option Int)) :
+    Except Failure (List Footprint × MemState) := do
+  if prepared.cells.length != values.length then
+    throw (.boundary "host output value count differs from prepared cells")
+  let pairs := prepared.cells.zip values
+  if pairs.any (fun (cell, value) => value.any (fun n => !cell.kind.accepts n)) then
+    throw (.boundary "host output value does not fit prepared cell type")
+  let mut after := prepared.snapshot
+  let mut footprints := []
+  for (cell, value) in pairs do
+    match value with
+    | none => pure ()
+    | some number =>
+      let (footprint, next) ← storeValue enums tags cell number after
+      footprints := footprint :: footprints
+      after := next
+  return (footprints.reverse, after)
+
+def commitOutputs [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (prepared : PreparedOutputs) (values : List Int) :
+    Except Failure (List Footprint × MemState) :=
+  commitSelectedOutputs enums tags prepared (values.map some)
+
+/-- Native failure which promises no output write preserves the exact original
+state, including unspecified values and the observation buffer. -/
+def unchanged (prepared : PreparedOutputs) : MemState := prepared.snapshot
+
+def readInteger [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (cell : Cell) (state : MemState) : Except Failure (Int × Footprint × MemState) := do
+  let _ ← ordinaryAddress cell.pointer
+  if sizeofCtype enums tags cell.kind.ty != cell.kind.width then
+    throw (.boundary "host input integer width differs from the pinned ABI")
+  let (valid, alignedState) ← immediate
+    (validForDerefPtrval enums tags cell.kind.ty cell.pointer) state
+  if !valid then throw (.boundary "host input pointer fails model lifetime/alignment checks")
+  let ((footprint, value), after) ← immediate
+    (loadM enums tags location cell.kind.ty cell.pointer) alignedState
+  match value with
+  | .MVinteger ity (.IV _ number) =>
+    if ity != cell.kind.ity || !cell.kind.accepts number then
+      throw (.boundary "host integer load has the wrong representation")
+    return (number, footprint, after)
+  | _ => throw (.boundary "host input is unspecified or not an integer")
+
+def arrayCells [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (kind : CellKind) (pointer : PointerValue) (count : Nat) (state : MemState) :
+    Except Failure (List Cell × MemState) := do
+  let mut cells := []
+  let mut after := state
+  for index in List.range count do
+    let (element, next) ← immediate
+      (effArrayShiftPtrval enums tags location pointer kind.ty
+        (.IV .Prov_none (index : Int))) after
+    cells := { pointer := element, kind := kind } :: cells
+    after := next
+  return (cells.reverse, after)
+
+/-- Exact binary span, including embedded zero bytes. No trailing element is
+loaded or shifted to; zero length does not inspect the pointer. -/
+def readBytes [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (pointer : PointerValue) (count : Nat) (state : MemState) :
+    Except Failure (ByteArray × List Footprint × MemState) := do
+  let (cells, shifted) ← arrayCells enums tags .byte pointer count state
+  let mut bytes := ByteArray.empty
+  let mut footprints := []
+  let mut after := shifted
+  for cell in cells do
+    let (value, footprint, next) ← readInteger enums tags cell after
+    bytes := bytes.push value.toNat.toUInt8
+    footprints := footprint :: footprints
+    after := next
+  return (bytes, footprints.reverse, after)
+
+end CerbHostMemoryCells
diff --git a/lean_frontend/host/families/network/guest/templates/network_guest.lean.in b/lean_frontend/host/families/network/guest/templates/network_guest.lean.in
new file mode 100644
index 00000000..3fec4224
--- /dev/null
+++ b/lean_frontend/host/families/network/guest/templates/network_guest.lean.in
@@ -0,0 +1,154 @@
+/- Generated from network-guest-contracts.json. This is an explicit guest/model
+codec, not the external-symbol admission gate or descriptor-table implementation.
+Every native request must run exactly once through the shared host runner. -/
+import CerbHostMemoryCells
+import CerbHostNetworkAdapters
+
+namespace CerbHostNetworkGuest
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+/-- Caller supplies these pointers only after validating the exact linked
+pollfd CType and obtaining its members through the model's member shift. -/
+structure PollRecord where
+  fd : PointerValue
+  events : PointerValue
+  revents : PointerValue
+
+/-- absent is a positive assertion from the COMPLETE process descriptor table.
+A resolver/model failure must remain Except.error and is never treated as absence. -/
+inductive DescriptorResolution where
+  | mapped (nativeFD : UInt32)
+  | absent
+
+inductive Request where
+@REQUESTS@
+
+inductive NativeRequest where
+@NATIVE_REQUESTS@
+
+structure Prepared where
+  private mk ::
+  native : NativeRequest
+  modeledErrno : UInt32
+  outputs : PreparedOutputs
+  inputFootprints : List Footprint
+  reservedGuests : List Int
+
+structure Completion where
+  returnValue : Int
+  nativeErrnoAfter : UInt32
+  /-- (guest, native), adopted atomically by the process-owned descriptor table. -/
+  descriptorTransfers : List (Int × UInt32)
+  memory : MemState
+  outputFootprints : List Footprint
+
+private def fail {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+
+private def i32 (n : Int) : Except Failure UInt32 := do
+  if n < -2147483648 || n > 2147483647 then fail "native int argument is out of range"
+  return (n % 4294967296).toNat.toUInt32
+
+private def fd (resolve : Int → Except String DescriptorResolution)
+    (guest : Int) : Except Failure UInt32 := do
+  let wire ← i32 guest
+  if guest < 0 then return wire
+  match resolve guest with
+  | .error message => fail message
+  | .ok .absent =>
+    -- Pinned fs/file.c hard allocation bound is below INT_MAX. Native adapters
+    -- check that exact kernel profile before using this impossible descriptor.
+    return 2147483647
+  | .ok (.mapped native) =>
+    if native.toNat ≥ 2147483584 then fail "mapped native fd exceeds pinned kernel hard bound"
+    return native
+
+private def knownInvalid (native : UInt32) : Bool :=
+  native == 2147483647 || native.toNat > 2147483647
+
+private def append (a b : ByteArray) : ByteArray :=
+  b.data.foldl (fun out byte => out.push byte) a
+
+private def word (n : UInt64) (bytes : Nat) : ByteArray := Id.run do
+  let mut out := ByteArray.empty
+  for i in List.range bytes do out := out.push ((n >>> (8*i).toUInt64).toUInt8)
+  return out
+
+private def readWord (bytes : ByteArray) (offset count : Nat) : Except Failure UInt64 := do
+  if offset + count > bytes.size then fail "short native record"
+  let mut out : UInt64 := 0
+  for i in List.range count do out := out ||| (bytes[offset+i]!.toUInt64 <<< (8*i).toUInt64)
+  return out
+
+private def sign16 (n : UInt64) : Int :=
+  if n.toNat < 32768 then n.toNat else (n.toNat : Int) - 65536
+
+def descriptorCount : Request → Nat
+@COUNTS@
+
+private def verifyReservations (request : Request) (guests : List Int) : Except Failure Unit := do
+  if guests.length != descriptorCount request ||
+      guests.eraseDups.length != guests.length ||
+      guests.any (fun n => n < 0 || n > 2147483647) then
+    fail "descriptor reservation does not match generated request"
+
+def prepareResolved [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (resolve : Int → Except String DescriptorResolution) (reserved : List Int)
+    (errnoPointer : PointerValue) (request : Request) (state : MemState) :
+    Except Failure Prepared := do
+  verifyReservations request reserved
+  let errnoCell : Cell := ⟨errnoPointer, .signedInt⟩
+  let (modeledErrno, errnoRead, initial) ← readInteger enums tags errnoCell state
+  let nativeErrno ← i32 modeledErrno
+  match request with
+@PREPARES@
+
+/-- Compatibility entry point: a failed legacy resolver never asserts absence. -/
+def prepare [LemFuel] [CerbGlobal.Switches] (enums : EnumDefs) (tags : TagDefs)
+    (resolve : Int → Except String UInt32) (reserved : List Int)
+    (errnoPointer : PointerValue) (request : Request) (state : MemState) :
+    Except Failure Prepared :=
+  prepareResolved enums tags (fun guest => (resolve guest).map DescriptorResolution.mapped)
+    reserved errnoPointer request state
+
+/-- IO is deliberately isolated from pure preparation/completion. A caller must
+not retry this request after any outcome, including a boundary error. -/
+def executeNative (prepared : Prepared) : BaseIO CerbHostNetworkAdapters.NetworkResult :=
+  match prepared.native with
+@EXECUTES@
+
+private def nativeFD (n : Int) : Except Failure UInt32 := do
+  if n < 0 || n > 2147483647 then fail "host returned a descriptor outside the pinned int domain"
+  return n.toNat.toUInt32
+
+private def pairFields (fields : Array UInt64) : Except Failure (List UInt32) := do
+  if fields.size != 2 then fail "socketpair response has wrong descriptor arity"
+  let a ← nativeFD fields[0]!.toNat
+  let b ← nativeFD fields[1]!.toNat
+  if a == b then fail "socketpair returned duplicate native descriptors"
+  return [a,b]
+
+def complete [LemFuel] (enums : EnumDefs) (tags : TagDefs)
+    (prepared : Prepared) (response : CerbHostNetworkAdapters.NetworkResult) :
+    Except Failure Completion := do
+  if !response.boundaryError.isEmpty then fail response.boundaryError
+  let errnoBits := response.nativeErrnoAfter.toNat
+  let errnoValue : Option Int := some (if errnoBits < 2147483648 then (errnoBits : Int)
+    else (errnoBits : Int) - 4294967296)
+  let failed := response.status.value == -1
+  if failed && (response.status.error == 0 || response.status.error != response.nativeErrnoAfter) then
+    fail "native -1 result without matching errno snapshot"
+  if !failed && response.status.error != 0 then fail "native success carries a failure status"
+  let (value, natives, writes) ← match prepared.native with
+@COMPLETES@
+  if natives.length != (if failed then 0 else prepared.reservedGuests.length) then
+    fail "native descriptor count differs from reserved guest count"
+  let (footprints, after) ← commitSelectedOutputs enums tags prepared.outputs (writes ++ [errnoValue])
+  return {
+    returnValue := value
+    nativeErrnoAfter := response.nativeErrnoAfter
+    descriptorTransfers := prepared.reservedGuests.zip natives
+    memory := after
+    outputFootprints := footprints
+  }
+
+end CerbHostNetworkGuest
