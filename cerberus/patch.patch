+/* Encode callbacks even when nested in records, arrays or other captures.
+   Raw subgraphs are tagged 0; closures 1, constructors containing closures 2,
+   arrays containing closures 3. This distinguishes code from data even under
+   type erasure. Immutable subgraphs without callbacks keep ShareCommon's
+   original representation. A pointer memo and explicit stack make traversal
+   once per newly seen object, without recursion on C's stack. */
+static memo_table memo_argument_keys;
+typedef struct {
+    lean_object *object, *children;
+    size_t next, count;
+    uint8_t tag, encoded_child;
