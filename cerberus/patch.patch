diff --git a/tests/openssh-gnu-modes/zero-array-storage.c b/tests/openssh-gnu-modes/zero-array-storage.c
new file mode 100644
index 00000000..ac817a30
--- /dev/null
+++ b/tests/openssh-gnu-modes/zero-array-storage.c
@@ -0,0 +1,25 @@
+/* The intended GNU use: final members backed by extra heap storage. */
+extern void *malloc(unsigned long);
+extern void free(void *);
+struct file_handle { unsigned int handle_bytes; int handle_type; unsigned char f_handle[0]; };
+struct words { char tag; unsigned long payload[0]; };
+int main(void) {
+    struct file_handle *p = malloc(sizeof *p + 3);
+    if (!p) return 90;
+    p->handle_bytes = 3;
+    p->handle_type = 17;
+    p->f_handle[0] = 19;
+    p->f_handle[1] = 23;
+    p->f_handle[2] = 29;
+    if (p->handle_bytes != 3 || p->handle_type != 17) return 1;
+    if (p->f_handle[0] != 19 || p->f_handle[1] != 23 || p->f_handle[2] != 29) return 2;
+    free(p);
+    struct words *q = malloc(sizeof *q + 2 * sizeof(unsigned long));
+    if (!q) return 91;
+    q->tag = 31;
+    q->payload[0] = 0x123456789abcdef0UL;
+    q->payload[1] = 0xfedcba9876543210UL;
+    if (q->tag != 31 || q->payload[0] != 0x123456789abcdef0UL || q->payload[1] != 0xfedcba9876543210UL) return 3;
+    free(q);
+    return 0;
+}
