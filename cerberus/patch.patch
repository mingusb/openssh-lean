+    if (!ok) { unlink(tmp); unlink(meta_tmp); }
+    else memo_gc_parts(keep_from);
+    memo_trace("save ok=%d tables=%zu entries=%zu skipped=%zu parts=%zu restored_hits=%llu\n",
