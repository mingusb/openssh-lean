+    uint64_t id = UINT64_C(14695981039346656037);
+    for (ssize_t i = 0; i < len; ++i) id = (id ^ (uint8_t)exe[i]) * UINT64_C(1099511628211);
+    memo_cache_path = memo_format("%s/%016llx", memo_directory, (unsigned long long)id);
+    memo_meta_path = memo_format("%s/%016llx.identity", memo_directory, (unsigned long long)id);
+    memo_lock_path = memo_format("%s/%016llx.lock", memo_directory, (unsigned long long)id);
+    memo_manifest = memo_identity();
+    if (!memo_manifest) { memo_trace("skip identity-unavailable\n"); return; }
+    memo_disk_enabled = 1;
+    atexit(memo_persist_exit);
+    int lock = memo_lock();
+    if (lock < 0) { memo_trace("cold lock-unavailable\n"); return; }
+    memo_meta_existed = memo_regular_owned(memo_meta_path) && memo_sha256(memo_meta_path, memo_meta_digest);
+    int ok = memo_meta_existed;
+    if (ok) {
+        FILE *meta = fopen(memo_meta_path, "r");
+        size_t size = strlen(memo_manifest), parts = 0;
+        char *prefix = memo_alloc(size + 1, 1), *line = NULL;
+        size_t capacity = 0;
+        ok = meta && fread(prefix, 1, size, meta) == size && !strcmp(prefix, memo_manifest);
+        free(prefix);
+        if (ok) ok = getline(&line, &capacity, meta) > 0 &&
+            sscanf(line, "parts %zu", &parts) == 1 && parts > 0;
+        for (size_t i = 0; ok && i < parts; ++i) {
+            ssize_t n = getline(&line, &capacity, meta);
+            ok = n > 66 && line[64] == ' ' && line[n - 1] == '\n';
+            if (!ok) break;
+            line[64] = 0; line[n - 1] = 0;
+            ok = strspn(line, "0123456789abcdef") == 64 && memo_part_name(line + 65);
+            char *part = memo_format("%s/%s", memo_directory, line + 65);
+            char hash[65];
+            ok = ok && memo_regular_owned(part) && memo_sha256(part, hash) && !strcmp(hash, line);
+            if (ok) memo_add_part(part, hash); else free(part);
