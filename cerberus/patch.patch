+    | A.AilEbinary (A.AnnotatedExpression _ _ _ (A.AilEbinary _ bop1 _) as nested)
+        bop2 (A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant number _ _)))) ->
+        if number = 0 && gnu_scalar_is_equality bop1 && gnu_scalar_is_equality bop2 then
+          gnu_scalar_guard_equalities nested >>= fun (yes,no) ->
+          E.return (match bop2 with A.Eq -> (no,yes) | _ -> (yes,no) end)
