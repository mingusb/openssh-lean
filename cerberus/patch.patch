+(* A direct volatile external read cannot make an unchanged, unescaped
+   ordinary formal a compiler constant. Capture the existing dense entry fact
+   before test translation invalidates memory; never invent one from its type. *)
+val gnu_volatile_guard_nonconstant_subjects:
+  A.expression GenTypes.genTypeCategory -> E.elabM (list Symbol.sym)
+let gnu_volatile_guard_nonconstant_subjects
+    (A.AnnotatedExpression _ _ _ node as condition) =
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression
+        (GenTypes.GenLValueType qs ty _) _ _ (A.AilEident source)) ->
+        E.has_external_linker_name source >>= fun is_external ->
+        if not is_external then E.return [] else
+        if not (qs.Ctype.volatile && AilTypesAux.is_integer ty)
+        then E.return [] else
+        E.gnu_current_parameter_subjects >>= fun params ->
+        E.mapM (fun param ->
+          E.gnu_branch_subject_allowed param >>= fun unchanged ->
+          E.gnu_compiler_fact param >>= fun fact ->
+          E.return (if unchanged &&
