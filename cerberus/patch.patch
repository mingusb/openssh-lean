+(* No queued procedure reference may survive without an executable body.
+   Core typechecking additionally checks argument/result types at each use.
+   Ordinary declarations are not counted as completed specializations. *)
+let validate_gnu_inline_targets cfuns =
+  E.gnu_inline_generated_targets >>= fun targets ->
+  E.mapM_ (fun target -> match Map.lookup target cfuns with
+    | Just (C.Proc _ _ _ _ _) -> E.return ()
+    | _ -> E.record_error_at Loc.unknown
+        "GNU inline specialization left an undefined generated procedure"
+  end) targets
