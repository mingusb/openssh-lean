+#include <unistd.h>
+
+#define PATH(s) (const unsigned char *)(s), strlen(s) + 1
+#define INCOMING ((uint32_t)EDOM)
+static void ok(cerb_host_files_result r) {
+    assert(r.boundary_error == NULL && r.status.value >= 0 && r.status.error == 0);
+}
+static void error(cerb_host_files_result r, int number) {
+    assert(r.boundary_error == NULL && r.status.value == -1 && r.status.error == (uint32_t)number);
+    assert(r.native_errno_after == (uint32_t)number && r.status.error_name != NULL);
+}
+static void assert_stat(cerb_host_files_result r, const struct stat *native) {
+    const uint64_t fields[] = {
+        (uint64_t)native->st_dev, (uint64_t)native->st_ino, (uint64_t)native->st_nlink,
+        (uint64_t)native->st_mode, (uint64_t)native->st_uid, (uint64_t)native->st_gid,
+        (uint64_t)native->st_rdev, (uint64_t)native->st_size, (uint64_t)native->st_blksize,
+        (uint64_t)native->st_blocks, (uint64_t)native->st_atim.tv_sec,
+        (uint64_t)native->st_atim.tv_nsec, (uint64_t)native->st_mtim.tv_sec,
+        (uint64_t)native->st_mtim.tv_nsec, (uint64_t)native->st_ctim.tv_sec,
+        (uint64_t)native->st_ctim.tv_nsec };
+    ok(r); assert(r.field_count == sizeof(fields)/sizeof(fields[0]));
+    assert(memcmp(r.fields, fields, sizeof(fields)) == 0);
+    assert(r.bytes_count == sizeof(*native) && memcmp(r.bytes, native, sizeof(*native)) == 0);
+    cerb_host_files_dispose(&r);
+}
+int main(void) {
+    char template[] = "/tmp/cerb-files-native-XXXXXX";
+    cerb_host_files_result r = cerb_host_files_mkdtemp_raw(INCOMING, PATH(template));
+    ok(r);
+    assert(strcmp(template, "/tmp/cerb-files-native-XXXXXX") == 0);
+    char root[PATH_MAX], path[PATH_MAX], second[PATH_MAX], symbolic[PATH_MAX], missing[PATH_MAX];
+    assert(r.bytes_count <= sizeof(root));
+    memcpy(root, r.bytes, r.bytes_count); cerb_host_files_dispose(&r);
+    assert(snprintf(path,sizeof(path),"%s/data",root)>0);
+    assert(snprintf(second,sizeof(second),"%s/link",root)>0);
+    assert(snprintf(symbolic,sizeof(symbolic),"%s/symlink",root)>0);
+    assert(snprintf(missing,sizeof(missing),"%s/absent",root)>0);
+
+    errno=ERANGE;
+    r=cerb_host_files_open_raw(INCOMING,PATH(path),O_RDWR|O_CREAT|O_EXCL,0600,1);
+    ok(r); assert(errno==ERANGE); int fd=(int)r.status.value;
+    const unsigned char payload[]={0,255,65,0,66};
+    uint64_t lengths[]={2,3};
+    r=cerb_host_files_writev_raw(INCOMING,fd,lengths,2,payload,sizeof(payload));
+    ok(r); assert(r.status.value==5);
