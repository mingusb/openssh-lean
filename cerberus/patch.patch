+import AilSyntax_lemMeasureProofs
+
+/- A reduced reproduction of the private-loop analyzer's syntax recursion.
+   Explicit record-constructor matches expose the nested body to Lean.
+   This checks the recursion shape only; runtime regression suites check the
+   actual generated analyzer and its transfer results. -/
+namespace PrivateLoopTerminationShape
+
+def summarize (transfer : Nat → Nat) (state : Nat) : Nat :=
+  transfer state
+
+mutual
+def transfer (state : Nat) (stmt : statement Unit) : Nat :=
+  match stmt with
+  | ⟨_, _, _, .AilSblock [] [⟨_, _, _, .AilSwhile _ body _⟩,
+      ⟨_, _, _, .AilSlabel _ _ _⟩]⟩ =>
+    summarize (fun next => transfer next body) state
+  | ⟨_, _, _, .AilSblock [] statements⟩ => sequence state statements
+  | ⟨_, _, _, .AilSif _ yes no⟩ =>
+    transfer state yes + transfer state no
+  | ⟨_, _, _, .AilSmarker _ body⟩ => transfer state body
+  | _ => state
+
+def sequence (state : Nat) (statements : List (statement Unit)) : Nat :=
+  match statements with
+  | [] => state
+  | child :: rest => sequence (transfer state child) rest
+end
+
+example (state : Nat) :
+    transfer state (statement.mk default default default .AilSskip) = state := rfl
+
+end PrivateLoopTerminationShape
+
+/- Explicit record and node layers, matching the generated projections. -/
+namespace ProjectionSteps
+
+mutual
+def transfer (state : Nat) (stmt : statement Unit) : Nat :=
+  node state stmt.node
+
+def node (state : Nat) (subject : statement_ Unit) : Nat :=
+  match subject with
+  | .AilSblock [] statements =>
+    if state == 0 then
+      match statements with
+      | [loop, exitLabel] => nested state loop exitLabel
+      | _ => state
+    else sequence state statements
+  | .AilSif _ yes no => transfer state yes + transfer state no
+  | .AilSmarker _ body => transfer state body
+  | _ => state
+
+def nested (state : Nat) (loop exitLabel : statement Unit) : Nat :=
+  nestedNode state loop.node exitLabel.node
+
+def nestedNode (state : Nat) (loop exitNode : statement_ Unit) : Nat :=
+  match loop, exitNode with
+  | .AilSwhile _ body _, .AilSlabel _ _ _ =>
+    PrivateLoopTerminationShape.summarize (fun next => transfer next body) state
+  | _, _ => state
+
+def sequence (state : Nat) (statements : List (statement Unit)) : Nat :=
+  match statements with
+  | [] => state
+  | child :: rest => sequence (transfer state child) rest
+end
+
+example (state : Nat) :
+    transfer state (statement.mk default default default .AilSskip) = state := by
+  simp [transfer, node]
+end ProjectionSteps
+
+
+/- The generated analyzer has varying facts and control targets as well as
+   syntax. Keep syntax first in each worker: Lean's bounded measure search tries
+   uniform parameter positions first. The previous mixed layout reproduced the
+   full Translation failure before this reordering. -/
+namespace MixedArguments
+
+mutual
+def transfer (stmt : statement Unit) (breakSym : Nat) (continues facts : List Nat) : Nat :=
+  node stmt.node breakSym continues facts facts.isEmpty
+
+def node (subject : statement_ Unit) (breakSym : Nat) (continues facts : List Nat)
+    (isNested : Bool) : Nat :=
+  match subject with
+  | .AilSblock [] statements =>
+    if isNested then
+      match statements with
+      | [loop, exitLabel] => nested loop exitLabel facts
+      | _ => 0
+    else sequence statements breakSym continues (some (0, facts))
+  | .AilSif _ yes no =>
+    transfer yes breakSym continues (0 :: facts) +
+      transfer no breakSym continues (1 :: facts)
+  | .AilSmarker _ body => transfer body breakSym continues facts
+  | _ => facts.length
+
+def nested (loop exitLabel : statement Unit) (entry : List Nat) : Nat :=
+  nestedNode loop.node exitLabel.node entry
+
+def nestedNode (loop exitNode : statement_ Unit) (entry : List Nat) : Nat :=
+  match loop, exitNode with
+  | .AilSwhile _ body _, .AilSlabel _ _ _ =>
+    let transferBody := fun facts => transfer body 0 [] facts
+    transferBody entry + transferBody (0 :: entry)
+  | _, _ => 0
+
+def sequence (statements : List (statement Unit)) (breakSym : Nat) (continues : List Nat)
+    (current : Option (Nat × List Nat)) : Nat :=
+  match statements with
+  | [] => 0
+  | child :: rest =>
+    match current with
+    | none => 0
+    | some (count, facts) =>
+      sequence rest breakSym continues
+        (some (count + transfer child breakSym continues facts, count :: facts))
+end
+
+example (facts : List Nat) :
+    transfer (statement.mk default default default .AilSskip) 0 [] facts = facts.length := by
+  simp [transfer, node]
+end MixedArguments
