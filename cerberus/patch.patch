+  if bound_fails then Mem.return (Right (U.Error loc "GNU_fortify_failure_requires_process_abort_semantics"))
+  else if Mem.model_name <> "concrete" || not (Implementation.has_amd64_sysv_abi ()) then
+    Mem.return (Right (U.Error loc "GNU fortified format requires the AMD64 concrete ABI"))
