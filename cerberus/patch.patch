+    | A.AilEbinary left _ right -> combine [left; right]
+    | A.AilEcond test yes no -> combine (test :: no :: maybe [] (fun value -> [value]) yes)
+    | A.AilEassign left right -> combine [left; right]
+    | A.AilEcompoundAssign left _ right -> combine [left; right]
