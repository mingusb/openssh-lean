+import Driver
+import CerbHostSystem
+import CerbHostMemoryCells
+import CerbHostDescriptors
+
+/- The generated setlocale transport copies strings across the host boundary.
+   This bridge admits the exact C call, retains the guest result as modeled
+   static storage, and never treats a native address as a guest pointer. -/
+namespace CerbHostSystemLocaleHandler
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+private abbrev Program := generic_file Unit core_run_annotation
+private def stop {α : Type} (message : String) : Except Failure α :=
+  .error (.boundary message)
+
+private def lookup {α : Type} (key : sym) (values : Fmap sym α) : Option α :=
+  fmapLookupBy (fun a b => Lem_Basic_classes.ordCompare a b) key values
+
+private def identifierText : identifier → String
+  | .Identifier _ text => text
+
+private def charType : ctype := .Ctype [] (.Basic (.Integer .Char0))
+private def charPointerType : ctype :=
+  .Ctype [] (.Pointer no_qualifiers charType)
+private def constCharPointerType : ctype :=
+  .Ctype [] (.Pointer { no_qualifiers with const := true } charType)
+
+structure Admitted where
+  location : CerbLocation.Loc
+  categoryObject : PointerValue
+  localeObject : PointerValue
+
+private def admit (state : driver_state) (location : CerbLocation.Loc)
+    (symbol : sym) (callType : generic_pexpr Unit sym)
+    (arguments : List value) : Except Failure Admitted := do
+  let program := state.core_file
+  if program.calling_convention0 != .Normal_callconv then
+    stop "setlocale requires the pinned normal argument-object convention"
+  if (lookup_proc_body state.core_extern program symbol).isSome then
+    stop "setlocale host handling would bypass a linked model or user procedure"
+  let resolved := resolve_linked_function state.core_extern symbol
+  let names := Lem_Map_extra.fold (fun ident binding found =>
+    let (symbols, linkage) := binding
+    if linkage == .LK_none && symbols.any (fun entry => entry == resolved)
+      then identifierText ident :: found else found) program.extern []
+  if names != ["setlocale"] then stop "external target is not uniquely setlocale"
+  let some (.ProcDecl _ coreResult coreParameters) := lookup resolved program.funs
+    | stop "setlocale must remain a real external procedure declaration"
+  if coreResult != .BTy_loaded .OTy_pointer ||
+      coreParameters != [.BTy_object .OTy_pointer, .BTy_object .OTy_pointer] then
+    stop "setlocale Core signature differs from normal pointer-result calling"
+  let some (_, _, declaredResult, declaredParameters, variadic, prototype) :=
+      lookup resolved program.funinfo
+    | stop "setlocale has no original source C prototype"
+  let [(_, declaredCategory), (_, declaredLocale)] := declaredParameters
+    | stop "setlocale declaration has the wrong parameter count"
+  if variadic || !prototype ||
+      !ctypeEqual declaredResult charPointerType ||
+      !ctypeEqual declaredCategory CellKind.signedInt.ty ||
+      !ctypeEqual declaredLocale constCharPointerType then
+    stop "setlocale declaration differs from the pinned int/const-char-pointer ABI"
+  let .Pexpr _ _ (.PEval (.Vctype (.Ctype _ (.Pointer functionQual
+      (.Ctype _ (.Function (returnQual, callResult) callParameters false)))))) := callType
+    | stop "setlocale call has no fixed function-pointer C prototype"
+  let [(categoryQual, categoryType, _), (localeQual, localeType, _)] := callParameters
+    | stop "setlocale call has the wrong parameter count"
+  if !qualifiersEqual functionQual no_qualifiers ||
+      !qualifiersEqual returnQual no_qualifiers ||
+      !qualifiersEqual categoryQual no_qualifiers ||
+      !qualifiersEqual localeQual no_qualifiers ||
+      !ctypeEqual callResult declaredResult ||
+      !ctypeEqual categoryType CellKind.signedInt.ty ||
+      !ctypeEqual localeType constCharPointerType then
+    stop "setlocale call and declaration prototypes differ"
+  let [.Vobject (.OVpointer categoryObject),
+       .Vobject (.OVpointer localeObject)] := arguments
+    | stop "setlocale arguments are not their parameter temporary objects"
+  return ⟨location, categoryObject, localeObject⟩
+
+private partial def readGuestCString [LemFuel] [CerbGlobal.Switches]
+    (program : Program) (location : CerbLocation.Loc)
+    (pointer : PointerValue) (index : Nat) (bytes : ByteArray)
+    (reads : List Footprint) (state : MemState) :
+    Except Failure (ByteArray × List Footprint × MemState) := do
+  let (element, shifted) ← immediate
+    (effArrayShiftPtrval program.enumDefs program.tagDefs location
+      pointer unsigned_char (.IV .Prov_none (Int.ofNat index))) state
+  let (value, footprint, after) ← readInteger program.enumDefs
+    program.tagDefs ⟨element, .byte⟩ shifted
+  if value < 0 || value > 255 then stop "setlocale input byte is outside unsigned char"
+  let bytes := bytes.push (UInt8.ofNat value.toNat)
+  let reads := footprint :: reads
+  if value == 0 then return (bytes, reads.reverse, after)
+  readGuestCString program location pointer (index + 1) bytes reads after
+
+structure StaticStorage where
+  pointer : PointerValue
+  capacity : Nat
+
+structure EffectReceipt where
+  sequence : Nat
+  original : host_request
+  category : UInt32
+  locale : ByteArray
+  response : CerbHostSystem.SystemResult
+
+private def materialize [LemFuel] [CerbGlobal.Switches]
+    (program : Program) (location : CerbLocation.Loc) (tid : Nat)
+    (prior : Option StaticStorage) (response : CerbHostSystem.SystemResult)
+    (state : MemState) :
+    Except Failure (PointerValue × Option StaticStorage × List Footprint × MemState) := do
+  if response.status.value == 0 then
+    if !response.bytes.isEmpty || !response.fields.isEmpty then
+      stop "NULL setlocale response includes a result payload"
+    return (nullPtrval charType, prior, [], state)
+  let bytes := response.bytes
+  if !response.fields.isEmpty || bytes.isEmpty ||
+      bytes.data[bytes.size - 1]? != some 0 ||
+      (bytes.data.toList.take (bytes.size - 1)).contains 0 then
+    stop "setlocale result is not one exact NUL-terminated C string"
+  let mut memory := state
+  let pointer ← match prior with
+    | some old =>
+      if old.capacity ≥ bytes.size then pure old.pointer
+      else do
+        let (_, after) ← immediate (killM location false old.pointer) memory
+        memory := after
+        let ty : ctype := .Ctype [] (.Array0 CellKind.byte.ty (some bytes.size))
+        let (pointer, after) ← immediate
+          (allocateObject program.enumDefs program.tagDefs tid
+            (PrefOther "setlocale-static") (.IV .Prov_none 1)
+            ty none none) memory
+        memory := after
+        pure pointer
+    | none => do
+      let ty : ctype := .Ctype [] (.Array0 CellKind.byte.ty (some bytes.size))
+      let (pointer, after) ← immediate
+        (allocateObject program.enumDefs program.tagDefs tid
+          (PrefOther "setlocale-static") (.IV .Prov_none 1)
+          ty none none) memory
+      memory := after
+      pure pointer
+  let (cells, after) ← arrayCells program.enumDefs program.tagDefs
+    .byte pointer bytes.size memory
+  let outputs ← prepareOutputs program.enumDefs program.tagDefs cells after
+  let (writes, after) ← commitOutputs program.enumDefs program.tagDefs
+    outputs (bytes.data.toList.map (fun byte => Int.ofNat byte.toNat))
+  return (pointer, some ⟨pointer, max bytes.size (prior.map (·.capacity) |>.getD 0)⟩,
+    writes, after)
+
+def supportsName (name : String) : Bool := name == "setlocale"
+
+def execute [LemFuel] [CerbGlobal.Switches] (sequence : Nat)
+    (table : CerbHostDescriptors.Table) (prior : Option StaticStorage)
+    (state : driver_state) (original : host_request) :
+    BaseIO (Except (Failure × Option EffectReceipt)
+      (driver_state × Option StaticStorage × host_response)) := do
+  if !state.host_enabled || state.host_reply.isSome ||
+      state.host_sequence != sequence + 1 then
+    return .error (.boundary "invalid locale request state or sequence", none)
+  match CerbHostDescriptors.validateIdle table with
+  | .error reason => return .error (.boundary reason, none)
+  | .ok () => pure ()
+  let .Host_external tid location errnoPointer symbol callType arguments := original
+    | return .error (.boundary "locale handler requires an external request", none)
+  if state.core_state0.thread_states.length != 1 then
+    return .error (.boundary "concurrent locale mutation is not implemented", none)
+  let some (_, (_, thread)) := state.core_state0.thread_states.find?
+      (fun entry => entry.1 == tid)
+    | return .error (.boundary "locale request has no current guest thread", none)
+  if thread.errno != errnoPointer || thread.current_loc != location then
+    return .error (.boundary "locale request changed errno or location", none)
+  let admitted ← match admit state location symbol callType arguments with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  let program := state.core_file
+  let (category, categoryRead, afterCategory) ← match readInteger
+      program.enumDefs program.tagDefs ⟨admitted.categoryObject, .signedInt⟩
+      state.layout_state with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  if category < -2147483648 || category > 2147483647 then
+    return .error (.boundary "setlocale category is outside pinned int", none)
+  let (valid, checked) ← match immediate
+      (validForDerefPtrval program.enumDefs program.tagDefs
+        constCharPointerType admitted.localeObject) afterCategory with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  if !valid then
+    return .error (.boundary "setlocale argument object is not dereferenceable", none)
+  let ((localeRead, stored), afterLocale) ← match immediate
+      (loadM program.enumDefs program.tagDefs location
+        constCharPointerType admitted.localeObject) checked with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  if !memValueHasType constCharPointerType stored then
+    return .error (.boundary "setlocale argument object has incompatible type", none)
+  let .MVpointer _ localePointer := stored
+    | return .error (.boundary "setlocale argument is not a pointer", none)
+  let (isNull, afterNull) ← match immediate
+      (eqPtrval location localePointer (nullPtrval charType)) afterLocale with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  let (locale, stringReads, afterString) ←
+    if isNull then pure (ByteArray.empty, [], afterNull)
+    else
+      match readGuestCString program location localePointer 0 ByteArray.empty [] afterNull with
+      | .error failure => return .error (failure, none)
+      | .ok result => pure result
+  let (errnoValue, errnoRead, afterErrno) ← match readInteger
+      program.enumDefs program.tagDefs ⟨errnoPointer, .signedInt⟩ afterString with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  if errnoValue < 0 || errnoValue > 2147483647 then
+    return .error (.boundary "modeled errno is outside pinned int", none)
+  let errnoOutputs ← match prepareOutputs program.enumDefs program.tagDefs
+      [⟨errnoPointer, .signedInt⟩] afterErrno with
+    | .error failure => return .error (failure, none)
+    | .ok result => pure result
+  if (← CerbHostSystem.enableCurrentWorker) != 1 then
+    return .error (.boundary "dedicated locale worker PID validation failed", none)
+  let nativeCategory : UInt32 := UInt32.ofNat (category % 4294967296).toNat
+  let response ← CerbHostSystem.execute (UInt32.ofNat errnoValue.toNat)
+    (.setlocale nativeCategory locale)
+  let receipt : EffectReceipt := ⟨sequence, original, nativeCategory, locale, response⟩
+  if !response.boundaryError.isEmpty then
+    return .error (.boundary response.boundaryError, some receipt)
+  if response.status.value != 0 && response.status.value != 1 then
+    return .error (.boundary "setlocale native result is not NULL or string", some receipt)
+  if response.nativeErrnoAfter.toNat > 2147483647 ||
+      (response.status.value == 1 && response.status.error != 0) ||
+      (response.status.value == 0 &&
+        response.status.error != response.nativeErrnoAfter) then
+    return .error (.boundary "setlocale native errno/result contract failed", some receipt)
+  let (errnoWrites, memory) ← match commitSelectedOutputs program.enumDefs
+      program.tagDefs errnoOutputs
+        [if response.nativeErrnoAfter.toNat == errnoValue.toNat then none
+         else some (Int.ofNat response.nativeErrnoAfter.toNat)] with
+    | .error failure => return .error (failure, some receipt)
+    | .ok result => pure result
+  let (pointer, storage, writes, after) ← match materialize program location tid
+      prior response memory with
+    | .error failure => return .error (failure, some receipt)
+    | .ok result => pure result
+  return .ok ({state with layout_state := after}, storage,
+    .Host_pointer pointer
+      ([categoryRead, localeRead, errnoRead] ++ stringReads ++ errnoWrites ++ writes))
+
+end CerbHostSystemLocaleHandler
