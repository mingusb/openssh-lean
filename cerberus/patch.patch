+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function (_, result)
+            [(_, first, _); (_, second, _); (_, third, _)] true))) ->
+              gnu_function_target_type_equal result Ctype.signed_int &&
+              character_pointer true first && character_pointer false third &&
+              gnu_standard_size_type second
