+import Exact_float
+
+/- Shared-model checks supplement native C/three-engine integration checks.
+   No proof axiom or nonterminating implementation is introduced here. -/
+open fp_format fp_rounding fp_operator fp_value
+
+def expectBits (label : String) (result : Sum String fp_value) (fmt : fp_format) (bits : Int) : IO Unit := do
+  match result with
+  | .inl error => throw (IO.userError (label ++ ": " ++ error))
+  | .inr value =>
+    unless fp_bits_equal value (.FpValue fmt bits) do
+      throw (IO.userError s!"{label}: expected bits {bits}, got {fp_payload_bits value}")
+
+def expectRefusal (label : String) (result : Sum String fp_value) : IO Unit := do
+  match result with
+  | .inl _ => pure ()
+  | .inr _ => throw (IO.userError (label ++ ": expected explicit refusal"))
+
+def main : IO Unit := do
+  expectBits "float even tie" (fp_parse FP32 "16777217.0") FP32 1266679808
+  expectBits "float odd tie" (fp_parse FP32 "16777219.0") FP32 1266679810
+  expectBits "negative zero" (fp_parse FP80 "-0x0p0") FP80 604462909807314587353088
+  expectBits "x87 low bit" (fp_parse FP80 "0x1.0000000000000002p0") FP80 302222231531620438900737
+  expectBits "smallest float subnormal" (fp_parse FP32 "0x1p-149") FP32 1
+  expectBits "subnormal half tie" (fp_parse FP32 "0x1p-150") FP32 0
+  expectBits "subnormal odd tie" (fp_parse FP32 "0x3p-150") FP32 2
+  expectBits "normal-boundary tie" (fp_parse FP32 "0x1.fffffep-127") FP32 8388608
+  expectBits "binary64 decimal" (fp_parse FP64 "0.1") FP64 4591870180066957722
+  expectBits "binary32 decimal" (fp_parse FP32 "0.1") FP32 1036831949
+  expectBits "directed positive" (fp_from_integer FP32 FPTowardPositive 16777217) FP32 1266679809
+  expectBits "directed negative" (fp_from_integer FP32 FPTowardNegative (-16777217)) FP32 3414163457
+  expectBits "truncate negative" (fp_from_integer FP32 FPTowardZero (-16777217)) FP32 3414163456
+  expectBits "nearest overflow" (fp_round_scaled FP32 FPNearestEven false 1 128) FP32 2139095040
+  expectBits "positive max finite" (fp_round_scaled FP32 FPTowardZero false 1 128) FP32 2139095039
+  expectBits "negative max finite" (fp_round_scaled FP32 FPTowardPositive true 1 128) FP32 4286578687
+  expectBits "tiny directed positive" (fp_round_scaled FP32 FPTowardPositive false 1 (-151)) FP32 1
+  expectBits "tiny directed negative" (fp_round_scaled FP32 FPTowardNegative true 1 (-151)) FP32 2147483649
+  expectBits "negative cancellation" (fp_binary FP32 FPTowardNegative FPAdd (.FpValue FP32 1065353216) (.FpValue FP32 3212836864)) FP32 2147483648
+  expectBits "positive zero plus positive zero" (fp_binary FP32 FPTowardNegative FPAdd (.FpValue FP32 0) (.FpValue FP32 0)) FP32 0
+  expectBits "negative zero times positive" (fp_binary FP32 FPNearestEven FPMultiply (.FpValue FP32 2147483648) (.FpValue FP32 1065353216)) FP32 2147483648
+  expectBits "single NaN quieting" (fp_binary FP64 FPNearestEven FPAdd (.FpValue FP64 9218868437227405378) (.FpValue FP64 4607182418800017408)) FP64 9221120237041090626
+  expectRefusal "out-of-width raw payload" (fp_from_bits FP32 4294967296)
+  expectRefusal "negative raw payload" (fp_from_bits FP80 (-1))
+  expectRefusal "unsupported x87 encoding" (fp_convert FP80 FPNearestEven (.FpValue FP80 18446744073709551616))
+  match fp_compare (.FpValue FP64 9221120237041090560) (.FpValue FP64 0) with
+  | .inr none => pure ()
+  | _ => throw (IO.userError "NaN comparison must be unordered")
+  match fp_to_integer (.FpValue FP64 13838998704956112896) with
+  | .inr value => unless value == -3 do throw (IO.userError "float-to-int must truncate toward zero")
+  | .inl message => throw (IO.userError message)
+  IO.println "Exact floating model: 27 checks passed"
