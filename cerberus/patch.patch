+++ b/lean_frontend/host/families/network/generate_network_adapters.py
@@ -0,0 +1,799 @@
+#!/usr/bin/env python3
+"""Generate the pinned Linux network boundary from declarative API contracts.
+This is an additive native/Lean boundary. The modeled dispatcher must marshal
+provenance, ownership and errno; generated native code never sees model pointers.
+"""
+import argparse, hashlib, json, re
+from pathlib import Path
+
+HEADER = r"""/* Generated. Edit contracts and generator primitives, not this file. */
+#ifndef CERB_HOST_NETWORK_ADAPTERS_H
+#define CERB_HOST_NETWORK_ADAPTERS_H
+#include "host_adapters.h"
+typedef struct {
+    cerb_host_result status;
+    unsigned char *bytes;
+    size_t bytes_count;
+    uint64_t fields[32];
+    size_t field_count;
+    const char *boundary_error;
+    uint32_t native_errno_after;
+} cerb_host_network_result;
+void cerb_host_network_dispose(cerb_host_network_result *r);
+"""
+PRELUDE = r"""/* Generated network adapters; all pointers refer to native copies. */
+#define _GNU_SOURCE
+#include "host_network_adapters.h"
+#include <arpa/inet.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <ifaddrs.h>
+#include <limits.h>
+#include <linux/if_link.h>
+#include <sys/uio.h>
+#include <netdb.h>
+#include <net/if.h>
+#include <netpacket/packet.h>
+#include <poll.h>
+#include <resolv.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/resource.h>
+#include <sys/un.h>
+#include <sys/utsname.h>
+#include <unistd.h>
+_Static_assert(sizeof(int)==4 && sizeof(socklen_t)==4, "pinned network int ABI");
+_Static_assert(sizeof(ssize_t)==8 && sizeof(nfds_t)==8, "pinned network count ABI");
+_Static_assert(sizeof(struct pollfd)==8, "pinned poll ABI");
+_Static_assert(sizeof(void*)==8 && sizeof(long)==8, "pinned LP64 ABI");
+_Static_assert(sizeof(struct sockaddr_in)==16 && sizeof(struct sockaddr_in6)==28,
+               "pinned address ABI");
+
+/* Failure write contracts and INT_MAX sentinel are audited against this
+   exact kernel. A different kernel is an explicit boundary, not guessed ABI. */
+static bool cerb_net_failure_profile(void) {
+    struct utsname name;
+    return uname(&name)==0 && strcmp(name.release,"@KERNEL_RELEASE@")==0 &&
+        strcmp(name.machine,"x86_64")==0;
+}
+static const char *cerb_net_errno_name(int error) {
+@ERRNO@
+    return NULL;
+}
+static cerb_host_network_result cerb_net_empty(void) {
+    cerb_host_network_result r = {0};
+    return r;
+}
+static cerb_host_network_result cerb_net_boundary(const char *why) {
+    cerb_host_network_result r = cerb_net_empty();
+    r.boundary_error = why;
+    return r;
+}
+void cerb_host_network_dispose(cerb_host_network_result *r) {
+    free(r->bytes); r->bytes=NULL; r->bytes_count=0;
+}
+static void cerb_net_result(cerb_host_network_result *r, int64_t value,
+                           int error, int saved_errno) {
+    r->status.value=value; r->status.error=(uint32_t)error;
+    r->status.error_name=error ? cerb_net_errno_name(error) : NULL;
+    errno=saved_errno;
+}
+static bool cerb_net_copy(cerb_host_network_result *r, const unsigned char *p, size_t n) {
+    if (n && !p) { r->boundary_error="missing validated copied span"; return false; }
+    r->bytes=malloc(n ? n : 1);
+    if (!r->bytes) { r->boundary_error="native adapter allocation failed"; return false; }
+    if(n) memcpy(r->bytes,p,n);
+    else r->bytes[0]=0; /* transport dummy outside the zero-length modeled span */
+    r->bytes_count=n; return true;
+}
+static void *cerb_net_dup(const unsigned char *p,size_t n) {
+    void *q=malloc(n ? n : 1);
+    if(q && n) memcpy(q,p,n);
+    else if(q) ((unsigned char*)q)[0]=0; /* no observable bytes at length zero */
+    return q;
+}
+static bool cerb_net_string(const unsigned char *s,size_t n) {
+    return n && s && s[n-1]==0 && !memchr(s,0,n-1);
+}
+/* Payloads use little-endian length-prefixed byte spans, never native pointers. */
+static bool cerb_net_append(cerb_host_network_result *r,const void *p,size_t n) {
+    if(r->boundary_error) return false;
+    if(n>SIZE_MAX-r->bytes_count) {
+        r->boundary_error="native adapter payload size overflow"; return false;
+    }
+    unsigned char *q=realloc(r->bytes,r->bytes_count+n+(n==0 && r->bytes_count==0));
+    if(!q) { r->boundary_error="native adapter payload allocation failed"; return false; }
+    r->bytes=q;
+    if(n) memcpy(q+r->bytes_count,p,n);
+    r->bytes_count+=n; return true;
+}
+static bool cerb_net_u64(cerb_host_network_result *r,uint64_t x) {
+    unsigned char b[8];
+    for(unsigned i=0;i<8;i++) b[i]=(unsigned char)(x>>(i*8));
+    return cerb_net_append(r,b,8);
+}
+static bool cerb_net_blob(cerb_host_network_result *r,const void *p,size_t n) {
+    return cerb_net_u64(r,n) && cerb_net_append(r,p,n);
+}
+static bool cerb_net_cstring(cerb_host_network_result *r,const char *p) {
+    return p ? cerb_net_blob(r,p,strlen(p)+1) : cerb_net_blob(r,NULL,0);
+}
+static uint64_t cerb_net_load64(const unsigned char *p) {
+    uint64_t x=0; for(unsigned i=0;i<8;i++) x|=(uint64_t)p[i]<<(i*8); return x;
+}
+/* Each run is confined to one native worker thread. Tokens are monotonically
+   allocated registry identities, not pointer bits. A worker teardown must close
+   live handles. Caller dispatch must check the exact token class before use. */
+enum { CERB_ADDRINFO=1, CERB_IFADDRS=2, CERB_DLHANDLE=3,
+       CERB_DLSYMBOL=4, CERB_RESOLVER_STATE=5 };
+typedef struct cerb_net_owner_ref {
+    uint64_t owner;
+    struct cerb_net_owner_ref *next;
+} cerb_net_owner_ref;
+typedef struct cerb_net_handle {
+    uint64_t token; unsigned kind; void *pointer;
+    uint64_t acquisitions;
+    bool nodelete;
+    cerb_net_owner_ref *owners;
+    struct cerb_net_handle *next;
+} cerb_net_handle;
+static _Thread_local cerb_net_handle *cerb_net_handles;
+/* Globally unique within this worker process: a token issued on one thread
+   cannot accidentally name a different thread's TLS object. Process routing
+   remains part of the host session capability, never just this integer. */
+static _Atomic uint64_t cerb_net_next_token=1;
+static cerb_net_handle *cerb_net_slot(unsigned kind) {
+    cerb_net_handle *p=calloc(1,sizeof(*p)); if(!p) return NULL;
+    uint64_t next=atomic_load_explicit(&cerb_net_next_token,memory_order_relaxed);
+    do {
+        if(next==UINT64_MAX) { free(p);return NULL; }
+    } while(!atomic_compare_exchange_weak_explicit(&cerb_net_next_token,&next,next+1,
+               memory_order_relaxed,memory_order_relaxed));
+    p->token=next;p->kind=kind;return p;
+}
+static void cerb_net_publish(cerb_net_handle *p,void *value) {
+    p->pointer=value;p->next=cerb_net_handles;cerb_net_handles=p;
+}
+static cerb_net_handle *cerb_net_lookup(uint64_t id,unsigned kind) {
+    for(cerb_net_handle *p=cerb_net_handles;p;p=p->next)
+        if(p->token==id && p->kind==kind)return p;
+    return NULL;
+}
+static cerb_net_handle *cerb_net_identity(void *pointer,unsigned kind) {
+    for(cerb_net_handle *p=cerb_net_handles;p;p=p->next)
+        if(p->pointer==pointer && p->kind==kind)return p;
+    return NULL;
+}
+static void cerb_net_remove(cerb_net_handle *h) {
+    cerb_net_handle **p=&cerb_net_handles;
+    while(*p && *p!=h)p=&(*p)->next;
+    if(*p) {
+        *p=h->next;
+        while(h->owners) {
+            cerb_net_owner_ref *next=h->owners->next;free(h->owners);h->owners=next;
+        }
+        free(h);
+    }
+}
+static void cerb_net_release_symbols(uint64_t owner) {
+    cerb_net_handle *p=cerb_net_handles,*next;
+    while(p) {
+        next=p->next;
+        if(p->kind==CERB_DLSYMBOL) {
+            cerb_net_owner_ref **link=&p->owners;
+            while(*link) {
+                if((*link)->owner==owner) {
+                    cerb_net_owner_ref *dead=*link;*link=dead->next;free(dead);
+                } else link=&(*link)->next;
+            }
+            if(!p->owners)cerb_net_remove(p);
+        }
+        p=next;
+    }
+}
+static size_t cerb_net_addr_size(const struct sockaddr *a) {
+    if(!a) return 0;
+    switch(a->sa_family) {
+    case AF_INET: return sizeof(struct sockaddr_in);
+    case AF_INET6: return sizeof(struct sockaddr_in6);
+    case AF_PACKET: return sizeof(struct sockaddr_ll);
+    case AF_UNIX: return sizeof(struct sockaddr_un);
+    default: return SIZE_MAX;
+    }
+}
+static bool cerb_net_addr_blob(cerb_host_network_result *r,const struct sockaddr *a) {
+    size_t n=cerb_net_addr_size(a);
+    if(n==SIZE_MAX) { r->boundary_error="ifaddrs address family has no pinned layout"; return false; }
+    return cerb_net_blob(r,a,n);
+}
+"""
+LEAN_PRELUDE = r"""/- Generated network API boundary. Inputs contain copied bytes and mapped native
+descriptors only. The Cerberus dispatcher owns memory provenance and copyback. -/
+import CerbHostAdapters
+namespace CerbHostNetworkAdapters
+structure NetworkResult where
+  status : CerbHostAdapters.NativeResult
+  bytes : ByteArray
+  fields : Array UInt64
+  boundaryError : String
+  nativeErrnoAfter : UInt32
+  deriving Inhabited
+/-- A host operation can already have happened when a boundary resource error is
+reported. Never retry that operation or reinterpret this field as native errno. -/
+def NetworkResult.accept (r : NetworkResult) : Except String NetworkResult :=
+  if r.boundaryError.isEmpty then .ok r else .error r.boundaryError
+
+"""
+FFI_PRELUDE = r"""
+#ifndef CERB_HOST_NO_LEAN
+#include <lean/lean.h>
+static lean_obj_res cerb_net_box(cerb_host_network_result r) {
+    lean_object *status=lean_alloc_ctor(0,2,sizeof(uint32_t));
+    lean_ctor_set(status,0,lean_int64_to_int(r.status.value));
+    lean_ctor_set(status,1,lean_mk_string(r.status.error_name ? r.status.error_name : ""));
+    lean_ctor_set_uint32(status,2*sizeof(void*),r.status.error);
+    lean_object *bytes=lean_alloc_sarray(1,r.bytes_count,r.bytes_count);
+    if(r.bytes_count) memcpy(lean_sarray_cptr(bytes),r.bytes,r.bytes_count);
+    lean_object *fields=lean_mk_empty_array_with_capacity(lean_box(r.field_count));
+    for(size_t i=0;i<r.field_count;i++) fields=lean_array_push(fields,lean_box_uint64(r.fields[i]));
+    lean_object *result=lean_alloc_ctor(0,4,sizeof(uint32_t));
+    lean_ctor_set(result,0,status); lean_ctor_set(result,1,bytes);
+    lean_ctor_set(result,2,fields);
+    lean_ctor_set(result,3,lean_mk_string(r.boundary_error ? r.boundary_error : ""));
+    lean_ctor_set_uint32(result,4*sizeof(void*),r.native_errno_after);
+    cerb_host_network_dispose(&r); return result;
+}
+"""
+# Each primitive contains the actual operation and its complete marshalling rule.
+# Contract symbols cannot supply arbitrary C code.
+BODIES = {}
+BODIES["socket"] = r"""
+    int saved=errno; int value=socket(domain,type,protocol); int e=value==-1?errno:0;
+    cerb_net_result(&r,value,e,saved); return r;
+"""
+BODIES["fd_int"] = r"""
+    int saved=errno; int value=@SYMBOL@(fd,argument); int e=value==-1?errno:0;
+    cerb_net_result(&r,value,e,saved); return r;
+"""
+BODIES["socketpair"] = r"""
+    if(!cerb_net_failure_profile()) return cerb_net_boundary("unmatched pinned socketpair failure profile");
+    int pair[2]={-1,-1}; int saved=errno;
+    int value=socketpair(domain,type,protocol,pair); int e=value==-1?errno:0;
+    /* Kernel writes may precede a failing sock_create/protocol check.
+       On failure these numbers are output bytes, NOT owned handles. */
+    if(pair[0]>=0 && pair[1]>=0) {
+        r.fields[0]=(uint32_t)pair[0]; r.fields[1]=(uint32_t)pair[1]; r.field_count=2;
+    } else if(pair[0]!=-1 || pair[1]!=-1 || value==0) {
+        r.boundary_error="unexpected partial socketpair writes to validated local pair";
+    }
+    cerb_net_result(&r,value,e,saved); return r;
+"""
+BODIES["address_in"] = r"""
+    if(address_size>UINT32_MAX) return cerb_net_boundary("socklen_t overflow");
+    void *copy=cerb_net_dup(address,address_size);
+    if(!copy) return cerb_net_boundary("native address allocation failed");
+    int saved=errno;
+    int value=@SYMBOL@(fd,(const struct sockaddr*)copy,(socklen_t)address_size);
+    int e=value==-1?errno:0; free(copy);
+    cerb_net_result(&r,value,e,saved); return r;
+"""
+BODIES["address_out"] = r"""
+    if(address_size>UINT32_MAX || (!present && address_size))
+        return cerb_net_boundary("invalid nullable sockaddr capacity");
+    if(present && !cerb_net_copy(&r,address,address_size)) return r;
+    socklen_t n=(socklen_t)address_size; int saved=errno;
+    int value=@SYMBOL@(fd,present?(struct sockaddr*)r.bytes:NULL,present?&n:NULL);
+    int e=value==-1?errno:0; r.fields[0]=n; r.field_count=1;
+    cerb_net_result(&r,value,e,saved); return r;
+"""
+BODIES["getsockopt"] = r"""
+    if(value_size>UINT32_MAX) return cerb_net_boundary("socklen_t overflow");
+    if(!cerb_net_copy(&r,value,value_size)) return r;
+    socklen_t n=(socklen_t)value_size; int saved=errno;
+    int result=getsockopt(fd,level,option,r.bytes,&n); int e=result==-1?errno:0;
+    r.fields[0]=n; r.field_count=1; cerb_net_result(&r,result,e,saved); return r;
+"""
+BODIES["setsockopt"] = r"""
+    if(value_size>UINT32_MAX || (!present && value_size))
+        return cerb_net_boundary("unsupported nullable socket option span");
+    void *copy=present?cerb_net_dup(value,value_size):NULL;
+    if(present && !copy) return cerb_net_boundary("native option allocation failed");
