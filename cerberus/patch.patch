+  | (GNU_extent_local a, GNU_extent_local b) -> gnu_extent_same_address a b
+  | (GNU_extent_member a x, GNU_extent_member b y) -> a = b && gnu_extent_same_address x y
+  | (GNU_extent_offset a, GNU_extent_offset b) -> gnu_extent_same_address a b
