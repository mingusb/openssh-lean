+    | A.AilEcast _ ty operand ->
+        (match (gnu_scalar_type_bounds (ctype_of operand), gnu_scalar_type_bounds ty) with
+          | (Just (al,ah), Just (bl,bh)) ->
+              if bl <= al && ah <= bh then gnu_scalar_guard_object operand else E.return Nothing
+          | _ -> E.return Nothing
+        end)
+    | _ -> E.return Nothing
+  end
