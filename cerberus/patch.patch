+    | CabsScontinue -> st
+    | CabsSbreak -> st
+    | CabsSreturn value -> maybe st (fun e -> expr st e) value
+    | CabsSpar statements -> List.foldl (fun acc s -> stmt acc s) st statements
+    | CabsSasm _ _ _ _ _ outputs inputs _ labels ->
+        let acc = List.foldl (fun acc (CabsAsmOperand _ _ _ e) -> expr acc e) st (outputs ++ inputs) in
+        <| acc with gnu_region_jumps= List.map (fun ident -> (ident,path)) labels ++ acc.gnu_region_jumps |>
+    | CabsSmarker body -> stmt st body
