diff --git a/tests/openssh-gnu-modes/object-size.c b/tests/openssh-gnu-modes/object-size.c
new file mode 100644
index 00000000..ffc6f65b
--- /dev/null
+++ b/tests/openssh-gnu-modes/object-size.c
@@ -0,0 +1,52 @@
+/* Object expressions and their closest subobjects, without evaluating ptr. */
+struct buffers { char first[7]; int middle; char last[11]; };
+static unsigned calls;
+static char *touch(void) { ++calls; return 0; }
+
+#ifndef OBJECT_SIZE_MODE
+#define OBJECT_SIZE_MODE 0
+#endif
+
+#define STATIC4(p, whole, part) \
+    (__builtin_object_size(p, 0) == (whole) && \
+     __builtin_object_size(p, 1) == (part) && \
+     __builtin_object_size(p, 2) == (whole) && \
+     __builtin_object_size(p, 3) == (part))
+#define DYNAMIC4(p, whole, part) \
+    (__builtin_dynamic_object_size(p, 0) == (whole) && \
+     __builtin_dynamic_object_size(p, 1) == (part) && \
+     __builtin_dynamic_object_size(p, 2) == (whole) && \
+     __builtin_dynamic_object_size(p, 3) == (part))
+
+static unsigned remaining(unsigned index) {
+    char bytes[13];
+    return __builtin_dynamic_object_size(bytes + index, OBJECT_SIZE_MODE);
+}
+
+#ifdef OBJECT_SIZE_INDEX
+int main(void) {
+    unsigned observed = remaining(OBJECT_SIZE_INDEX);
+    return observed != (OBJECT_SIZE_INDEX < 13 ? 13-OBJECT_SIZE_INDEX : 0);
+}
+#else
+int main(void) {
+    char a[13];
+    struct buffers s;
+    int scalar;
+    if (!STATIC4(a, 13, 13) || !DYNAMIC4(a, 13, 13)) return 1;
+    if (!STATIC4(&a[3], 10, 10) || !DYNAMIC4(&a[3], 10, 10)) return 2;
+    if (!STATIC4(s.first, sizeof(s), 7) || !DYNAMIC4(s.first, sizeof(s), 7)) return 3;
+    if (!STATIC4(&s.first[3], sizeof(s)-3, 4)) return 4;
+    if (!DYNAMIC4(&s.first[3], sizeof(s)-3, 4)) return 5;
+    if (!STATIC4(&s.middle, 16, 4) || !DYNAMIC4(&s.middle, 16, 4)) return 6;
+    if (!STATIC4(&scalar, sizeof(scalar), sizeof(scalar))) return 7;
+    if (!STATIC4("hello", 6, 6) || !DYNAMIC4("hello", 6, 6)) return 8;
+    if (!STATIC4(a+13, 0, 0) || !DYNAMIC4(a+13, 0, 0)) return 9;
+    int i = 2;
+    if (__builtin_object_size(a+i++, 0) != (unsigned long)-1 || i != 2) return 11;
+    if (__builtin_dynamic_object_size(a+i++, 0) != (unsigned long)-1 || i != 2) return 12;
+    if (__builtin_object_size(touch(), 2) != 0 || calls != 0) return 13;
+    if (__builtin_dynamic_object_size(touch(), 2) != 0 || calls != 0) return 14;
+    return 0;
+}
+#endif
