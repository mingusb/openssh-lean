+type erase_loop_control_state = <|
+  elc_continue: maybe Symbol.sym;
+  elc_break: maybe Symbol.sym;
+  (* C1 m1b (charter section 3.4 b'): the pass's own supply component.
+     DEAD on the OCaml target (elc_fresh_int redirects to the ambient
+     counter); on Lean it is seeded from the elaboration supply at the
+     erase_loop_control call and returned to it. *)
+  elc_supply: nat;
+|>
+
+val elc_fresh_int: St.stateM nat erase_loop_control_state
+let elc_fresh_int =
+  fun st ->
+    let n = st.elc_supply in
+    (n, <| st with elc_supply= n+1 |>)
+declare ocaml target_rep function elc_fresh_int = `Fork_renumber.elc_fresh_int`
+
+val     erase_loop_control_aux: A.statement GenTypes.genTypeCategory -> St.stateM (A.statement GenTypes.genTypeCategory) erase_loop_control_state
+let rec erase_loop_control_aux stmt =
+  let loc = stmt.A.loc in
+  let with_fresh_labels mf =
+    fun st ->
+      (* C1 m1b: the label mints draw from the pass's supply at the same
+         run-time firing point as the former ambient draws (continue
+         then break); the inner run inherits the advanced supply and
+         hands its final supply back to the outer state (the original
+         code discarded the inner state entirely â€” the label fields are
+         still discarded, only the supply flows back). *)
+      let (nc, st_c) = elc_fresh_int st in
+      let (nb, st_b) = elc_fresh_int st_c in
+      let continue_sym = Symbol.set_symbol_description (Symbol.fresh_given_int (Symbol.digest ()) nc) (Symbol.SD_Id ("continue_" ^ show nc)) in
+      let break_sym    = Symbol.set_symbol_description (Symbol.fresh_given_int (Symbol.digest ()) nb) (Symbol.SD_Id ("break_" ^ show nb)) in
+      let (ret, st')   = mf <| elc_continue= Just continue_sym; elc_break= Just break_sym; elc_supply= st_b.elc_supply |> in
+      ((continue_sym, break_sym, ret), <| st_b with elc_supply= st'.elc_supply |>) in
+  A.mk_statement_full loc stmt.A.desug_info stmt.A.attrs <$> match stmt.A.node with
+    | A.AilSskip ->
+        St.return stmt.A.node
+    | A.AilSexpr _ ->
+        St.return stmt.A.node
+    | A.AilSvla_scope identity captures checked body ->
+        A.AilSvla_scope identity captures checked <$> erase_loop_control_aux body
+    | A.AilSblock binds ss ->
