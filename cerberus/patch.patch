index 00000000..5cd6dc6c
--- /dev/null
+++ b/lean_frontend/CerbCertifiedInventory.lean
@@ -0,0 +1,544 @@
+import Core
+import Init.Data.List.BasicAux
+import Std.Tactic
+
+set_option autoImplicit false
+
+/-! Exact syntactic traversal of the supplied Core tree. The specification names
+real Core constructor fields and contains no reference to the extractor.
+This proves syntax coverage only. Literal values remain explicit obligations;
+binding, alias resolution, dispatch domains and runtime closure are separate. -/
+namespace CerbCertifiedInventory
+
+inductive Node where
+  | pure : pexpr → Node
+  | effect : expr Unit → Node
+  | action : action0 Unit → Node
+
+/-- Independent immediate-subterm specification, constructor by constructor. -/
+def Immediate : Node → Node → Prop
+  | .pure (.Pexpr ann unit (.PEsym s)), child => False
+  | .pure (.Pexpr ann unit (.PEimpl k)), child => False
+  | .pure (.Pexpr ann unit (.PEval v)), child => False
+  | .pure (.Pexpr ann unit (.PEconstrained xs)), child => (∃ entry ∈ xs, child = .pure entry.2)
+  | .pure (.Pexpr ann unit (.PEundef loc ub)), child => False
+  | .pure (.Pexpr ann unit (.PEerror message p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEctor ctor xs)), child => (∃ entry ∈ xs, child = .pure entry)
+  | .pure (.Pexpr ann unit (.PEcase p xs)), child => child = .pure p ∨ (∃ entry ∈ xs, child = .pure entry.2)
+  | .pure (.Pexpr ann unit (.PEarray_shift p ty q)), child => child = .pure p ∨ child = .pure q
+  | .pure (.Pexpr ann unit (.PEmember_shift p tag member)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEmemop op xs)), child => (∃ entry ∈ xs, child = .pure entry)
+  | .pure (.Pexpr ann unit (.PEnot p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEop op p q)), child => child = .pure p ∨ child = .pure q
+  | .pure (.Pexpr ann unit (.PEconv_int ty p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEwrapI ty op p q)), child => child = .pure p ∨ child = .pure q
+  | .pure (.Pexpr ann unit (.PEcatch_exceptional_condition ty op p q)), child => child = .pure p ∨ child = .pure q
+  | .pure (.Pexpr ann unit (.PEstruct tag xs)), child => (∃ entry ∈ xs, child = .pure entry.2)
+  | .pure (.Pexpr ann unit (.PEunion tag member p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEcfunction p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEmemberof tag member p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEcall name xs)), child => (∃ entry ∈ xs, child = .pure entry)
+  | .pure (.Pexpr ann unit (.PElet pat p q)), child => child = .pure p ∨ child = .pure q
+  | .pure (.Pexpr ann unit (.PEif p q r)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r
+  | .pure (.Pexpr ann unit (.PEis_scalar p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEis_integer p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEis_signed p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEis_unsigned p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEbmc_assume p)), child => child = .pure p
+  | .pure (.Pexpr ann unit (.PEare_compatible p q)), child => child = .pure p ∨ child = .pure q
+  | .pure (.Pexpr ann unit (.PEare_compatible_parameter p q)), child => child = .pure p ∨ child = .pure q
+  | .effect (.Expr ann (.Epure p)), child => child = .pure p
+  | .effect (.Expr ann (.Ememop op xs)), child => (∃ entry ∈ xs, child = .pure entry)
+  | .effect (.Expr ann (.Eaction (.Paction pol act))), child => child = .action act
+  | .effect (.Expr ann (.Ecase p xs)), child => child = .pure p ∨ (∃ entry ∈ xs, child = .effect entry.2)
+  | .effect (.Expr ann (.Elet pat p e)), child => child = .pure p ∨ child = .effect e
+  | .effect (.Expr ann (.Eif p e f)), child => child = .pure p ∨ child = .effect e ∨ child = .effect f
+  | .effect (.Expr ann (.Eccall unit ty callee xs)), child => child = .pure ty ∨ child = .pure callee ∨ (∃ entry ∈ xs, child = .pure entry)
+  | .effect (.Expr ann (.Eproc unit name xs)), child => (∃ entry ∈ xs, child = .pure entry)
+  | .effect (.Expr ann (.Eunseq xs)), child => (∃ entry ∈ xs, child = .effect entry)
+  | .effect (.Expr ann (.Ewseq pat e f)), child => child = .effect e ∨ child = .effect f
+  | .effect (.Expr ann (.Esseq pat e f)), child => child = .effect e ∨ child = .effect f
+  | .effect (.Expr ann (.Ebound e)), child => child = .effect e
+  | .effect (.Expr ann (.Eindivisible label e)), child => child = .effect e
+  | .effect (.Expr ann (.End xs)), child => (∃ entry ∈ xs, child = .effect entry)
+  | .effect (.Expr ann (.Esave label xs e)), child => (∃ entry ∈ xs, child = .pure entry.2.2) ∨ child = .effect e
+  | .effect (.Expr ann (.Erun unit label xs)), child => (∃ entry ∈ xs, child = .pure entry)
+  | .effect (.Expr ann (.Epar xs)), child => (∃ entry ∈ xs, child = .effect entry)
+  | .effect (.Expr ann (.Ewait tid)), child => False
+  | .effect (.Expr ann (.Eannot annotations e)), child => child = .effect e
+  | .effect (.Expr ann (.Eexcluded n act)), child => child = .action act
+  | .action (.Action loc unit (.Create p q pref)), child => child = .pure p ∨ child = .pure q
+  | .action (.Action loc unit (.CreateReadOnly p q r pref)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r
+  | .action (.Action loc unit (.Alloc0 p q pref)), child => child = .pure p ∨ child = .pure q
+  | .action (.Action loc unit (.Kill kind p)), child => child = .pure p
+  | .action (.Action loc unit (.Store0 locking p q r order)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r
+  | .action (.Action loc unit (.Load0 p q order)), child => child = .pure p ∨ child = .pure q
+  | .action (.Action loc unit (.SeqRMW post p q s r)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r
+  | .action (.Action loc unit (.RMW0 p q r s success failure)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r ∨ child = .pure s
+  | .action (.Action loc unit (.Fence0 order)), child => False
+  | .action (.Action loc unit (.CompareExchangeStrong p q r s success failure)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r ∨ child = .pure s
+  | .action (.Action loc unit (.CompareExchangeWeak p q r s success failure)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r ∨ child = .pure s
+  | .action (.Action loc unit (.LinuxFence order)), child => False
+  | .action (.Action loc unit (.LinuxLoad p q order)), child => child = .pure p ∨ child = .pure q
+  | .action (.Action loc unit (.LinuxStore p q r order)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r
+  | .action (.Action loc unit (.LinuxRMW p q r order)), child => child = .pure p ∨ child = .pure q ∨ child = .pure r
+
+/-- Executable immediate children, independently compared with Immediate below. -/
+def children : Node → List Node
+  | .pure (.Pexpr ann unit (.PEsym s)) => []
+  | .pure (.Pexpr ann unit (.PEimpl k)) => []
+  | .pure (.Pexpr ann unit (.PEval v)) => []
+  | .pure (.Pexpr ann unit (.PEconstrained xs)) => (xs.map fun entry => .pure entry.2)
+  | .pure (.Pexpr ann unit (.PEundef loc ub)) => []
+  | .pure (.Pexpr ann unit (.PEerror message p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEctor ctor xs)) => (xs.map fun entry => .pure entry)
+  | .pure (.Pexpr ann unit (.PEcase p xs)) => [.pure p] ++ (xs.map fun entry => .pure entry.2)
+  | .pure (.Pexpr ann unit (.PEarray_shift p ty q)) => [.pure p] ++ [.pure q]
+  | .pure (.Pexpr ann unit (.PEmember_shift p tag member)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEmemop op xs)) => (xs.map fun entry => .pure entry)
+  | .pure (.Pexpr ann unit (.PEnot p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEop op p q)) => [.pure p] ++ [.pure q]
+  | .pure (.Pexpr ann unit (.PEconv_int ty p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEwrapI ty op p q)) => [.pure p] ++ [.pure q]
+  | .pure (.Pexpr ann unit (.PEcatch_exceptional_condition ty op p q)) => [.pure p] ++ [.pure q]
+  | .pure (.Pexpr ann unit (.PEstruct tag xs)) => (xs.map fun entry => .pure entry.2)
+  | .pure (.Pexpr ann unit (.PEunion tag member p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEcfunction p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEmemberof tag member p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEcall name xs)) => (xs.map fun entry => .pure entry)
+  | .pure (.Pexpr ann unit (.PElet pat p q)) => [.pure p] ++ [.pure q]
+  | .pure (.Pexpr ann unit (.PEif p q r)) => [.pure p] ++ [.pure q] ++ [.pure r]
+  | .pure (.Pexpr ann unit (.PEis_scalar p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEis_integer p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEis_signed p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEis_unsigned p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEbmc_assume p)) => [.pure p]
+  | .pure (.Pexpr ann unit (.PEare_compatible p q)) => [.pure p] ++ [.pure q]
+  | .pure (.Pexpr ann unit (.PEare_compatible_parameter p q)) => [.pure p] ++ [.pure q]
+  | .effect (.Expr ann (.Epure p)) => [.pure p]
+  | .effect (.Expr ann (.Ememop op xs)) => (xs.map fun entry => .pure entry)
+  | .effect (.Expr ann (.Eaction (.Paction pol act))) => [.action act]
+  | .effect (.Expr ann (.Ecase p xs)) => [.pure p] ++ (xs.map fun entry => .effect entry.2)
+  | .effect (.Expr ann (.Elet pat p e)) => [.pure p] ++ [.effect e]
+  | .effect (.Expr ann (.Eif p e f)) => [.pure p] ++ [.effect e] ++ [.effect f]
+  | .effect (.Expr ann (.Eccall unit ty callee xs)) => [.pure ty] ++ [.pure callee] ++ (xs.map fun entry => .pure entry)
+  | .effect (.Expr ann (.Eproc unit name xs)) => (xs.map fun entry => .pure entry)
+  | .effect (.Expr ann (.Eunseq xs)) => (xs.map fun entry => .effect entry)
+  | .effect (.Expr ann (.Ewseq pat e f)) => [.effect e] ++ [.effect f]
+  | .effect (.Expr ann (.Esseq pat e f)) => [.effect e] ++ [.effect f]
+  | .effect (.Expr ann (.Ebound e)) => [.effect e]
+  | .effect (.Expr ann (.Eindivisible label e)) => [.effect e]
+  | .effect (.Expr ann (.End xs)) => (xs.map fun entry => .effect entry)
+  | .effect (.Expr ann (.Esave label xs e)) => (xs.map fun entry => .pure entry.2.2) ++ [.effect e]
+  | .effect (.Expr ann (.Erun unit label xs)) => (xs.map fun entry => .pure entry)
+  | .effect (.Expr ann (.Epar xs)) => (xs.map fun entry => .effect entry)
+  | .effect (.Expr ann (.Ewait tid)) => []
+  | .effect (.Expr ann (.Eannot annotations e)) => [.effect e]
+  | .effect (.Expr ann (.Eexcluded n act)) => [.action act]
+  | .action (.Action loc unit (.Create p q pref)) => [.pure p] ++ [.pure q]
+  | .action (.Action loc unit (.CreateReadOnly p q r pref)) => [.pure p] ++ [.pure q] ++ [.pure r]
+  | .action (.Action loc unit (.Alloc0 p q pref)) => [.pure p] ++ [.pure q]
+  | .action (.Action loc unit (.Kill kind p)) => [.pure p]
+  | .action (.Action loc unit (.Store0 locking p q r order)) => [.pure p] ++ [.pure q] ++ [.pure r]
+  | .action (.Action loc unit (.Load0 p q order)) => [.pure p] ++ [.pure q]
+  | .action (.Action loc unit (.SeqRMW post p q s r)) => [.pure p] ++ [.pure q] ++ [.pure r]
+  | .action (.Action loc unit (.RMW0 p q r s success failure)) => [.pure p] ++ [.pure q] ++ [.pure r] ++ [.pure s]
+  | .action (.Action loc unit (.Fence0 order)) => []
+  | .action (.Action loc unit (.CompareExchangeStrong p q r s success failure)) => [.pure p] ++ [.pure q] ++ [.pure r] ++ [.pure s]
+  | .action (.Action loc unit (.CompareExchangeWeak p q r s success failure)) => [.pure p] ++ [.pure q] ++ [.pure r] ++ [.pure s]
+  | .action (.Action loc unit (.LinuxFence order)) => []
+  | .action (.Action loc unit (.LinuxLoad p q order)) => [.pure p] ++ [.pure q]
+  | .action (.Action loc unit (.LinuxStore p q r order)) => [.pure p] ++ [.pure q] ++ [.pure r]
+  | .action (.Action loc unit (.LinuxRMW p q r order)) => [.pure p] ++ [.pure q] ++ [.pure r]
+
+theorem immediate_iff_mem (parent child : Node) :
+    Immediate parent child ↔ child ∈ children parent := by
+  cases parent with
+  | pure p =>
+    cases p with
+    | Pexpr ann unit node =>
+      cases node <;> simp [Immediate, children, eq_comm]
+  | effect e =>
+    cases e with
+    | Expr ann node =>
+      cases node <;> simp [Immediate, children, eq_comm]
+  | action a =>
+    cases a with
+    | Action loc unit node =>
+      cases node <;> simp [Immediate, children, eq_comm]
+
+/-- A structural size of the actual Core value, not a caller-supplied fuel. -/
+noncomputable def measure : Node → Nat
+  | .pure p => sizeOf p
+  | .effect e => sizeOf e
+  | .action a => sizeOf a
+
+theorem immediate_measure_lt (parent child : Node) (h : Immediate parent child) :
+    measure child < measure parent := by
+  cases parent with
+  | pure p =>
+    cases p with
+    | Pexpr ann unit node =>
+      cases node with
+      | PEsym s =>
+        simp only [Immediate] at h
+      | PEimpl k =>
+        simp only [Immediate] at h
+      | PEval v =>
+        simp only [Immediate] at h
+      | PEconstrained xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        rcases entry with ⟨key, value⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | PEundef loc ub =>
+        simp only [Immediate] at h
+      | PEerror message p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEctor ctor xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | PEcase p xs =>
+        simp only [Immediate] at h
+        rcases h with rfl | ⟨entry, hmem, rfl⟩
+        · simp [measure] <;> omega
+        · rcases entry with ⟨key, value⟩
+          have hsize := List.sizeOf_lt_of_mem hmem
+          simp_all [measure] <;> omega
+      | PEarray_shift p ty q =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | PEmember_shift p tag member =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEmemop op xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | PEnot p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEop op p q =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | PEconv_int ty p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEwrapI ty op p q =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | PEcatch_exceptional_condition ty op p q =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | PEstruct tag xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        rcases entry with ⟨key, value⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | PEunion tag member p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEcfunction p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEmemberof tag member p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEcall name xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | PElet pat p q =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | PEif p q r =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | PEis_scalar p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEis_integer p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEis_signed p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEis_unsigned p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEbmc_assume p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | PEare_compatible p q =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | PEare_compatible_parameter p q =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+  | effect e =>
+    cases e with
+    | Expr ann node =>
+      cases node with
+      | Epure p =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | Ememop op xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | Eaction act =>
+        cases act with
+        | Paction pol act =>
+          simp only [Immediate] at h
+          rcases h with rfl
+          simp [measure] <;> omega
+      | Ecase p xs =>
+        simp only [Immediate] at h
+        rcases h with rfl | ⟨entry, hmem, rfl⟩
+        · simp [measure] <;> omega
+        · rcases entry with ⟨key, value⟩
+          have hsize := List.sizeOf_lt_of_mem hmem
+          simp_all [measure] <;> omega
+      | Elet pat p e =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | Eif p e f =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | Eccall unit ty callee xs =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl | ⟨entry, hmem, rfl⟩
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+        · have hsize := List.sizeOf_lt_of_mem hmem
+          simp_all [measure] <;> omega
+      | Eproc unit name xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | Eunseq xs =>
