+(* A source-derived aggregate return summary. The accepted helper has only
+   a straight-line local record construction and one final return. Every field
+   origin is substituted from typed, effect-free actuals; callee-local addresses,
+   unknown identifiers, calls, branches and volatile/atomic loads are excluded.
+   These expressions are analysis metadata, never replacement runtime calls. *)
+val gnu_record_literal:
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_record_literal (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEstruct _ _ -> Just expr
+  | A.AilErvalue operand -> gnu_record_literal operand
+  | A.AilEcompound qs ty operand ->
+      if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (gnu_inline_fixed_object_type ty)
+      then Nothing else gnu_record_literal operand
+  | A.AilEannot _ operand -> gnu_record_literal operand
+  | _ -> Nothing
+end
+
+val gnu_record_argument_readonly: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_record_argument_readonly expr =
+  if gnu_size_effects expr = Just false then true else
+  match gnu_record_literal expr with
+    | Just (A.AnnotatedExpression _ _ _ (A.AilEstruct _ fields)) ->
+        List.all (fun (_, value) -> maybe true gnu_record_argument_readonly value) fields
+    | _ -> false
+  end
