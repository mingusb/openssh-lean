+union Number { int first; long second; };
+union Choice { struct { int x, y; } pair; long whole; };
+struct Container { int before; union Choice choice; int after; };
+static union Number saved = {.second = 10000000000L};
+static union Number zero;
+static int calls;
+static long next(void) { ++calls; return 10000000001L; }
