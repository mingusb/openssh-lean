+
+/-- Data in the linked Core file, with its checked input identity. Interpreter
+and host semantics are separate; this is not an OpenSSH equivalence proof. -/
+structure LinkedCoreProofInput where
+  identity : LinkedCoreIdentity
+  artifactSHA256 : String
+  core : CoreSnapshot
+
+/-- A lazy proof view into one already linked Core artifact. Combining views
+never re-links independently translated units or changes symbol identities. -/
+structure LinkedCoreProofSlice where
+  artifactSHA256 : String
+  functionOrdinals : List Nat
+  globalOrdinals : List Nat
+  deriving BEq
+
+private def canonicalOrdinals (length : Nat) (requested : List Nat) : List Nat :=
+  (List.range length).filter (fun ordinal => requested.contains ordinal)
+
+def LinkedCoreProofInput.selectSlice (input : LinkedCoreProofInput)
+    (functions globals : List Nat) : Option LinkedCoreProofSlice :=
+  if functions.all (· < input.core.funs.length) &&
+      globals.all (· < input.core.globs.length) then
+    some (LinkedCoreProofSlice.mk input.artifactSHA256
+      (canonicalOrdinals input.core.funs.length functions)
+      (canonicalOrdinals input.core.globs.length globals))
+  else none
+
+def LinkedCoreProofInput.validSlice (input : LinkedCoreProofInput)
+    (slice : LinkedCoreProofSlice) : Bool :=
+  slice.artifactSHA256 == input.artifactSHA256 &&
+  slice.functionOrdinals ==
+    canonicalOrdinals input.core.funs.length slice.functionOrdinals &&
+  slice.globalOrdinals ==
+    canonicalOrdinals input.core.globs.length slice.globalOrdinals
+
+/-- Union two selections from the same checked linked artifact in its original
+function and global-initializer order. Different artifacts cannot be mixed. -/
+def LinkedCoreProofInput.composeSlices (input : LinkedCoreProofInput)
+    (left right : LinkedCoreProofSlice) : Option LinkedCoreProofSlice :=
+  if !input.validSlice left || !input.validSlice right then none
+  else input.selectSlice (left.functionOrdinals ++ right.functionOrdinals)
+    (left.globalOrdinals ++ right.globalOrdinals)
+
+def LinkedCoreProofInput.selectedFunctions (input : LinkedCoreProofInput)
+    (slice : LinkedCoreProofSlice) :
+    Option (List (sym × generic_fun_map_decl Unit Unit)) :=
+  if !input.validSlice slice then none
+  else some <| (input.core.funs.zipIdx.filter
+    (fun (_, ordinal) => slice.functionOrdinals.contains ordinal)).map Prod.fst
+
+def LinkedCoreProofInput.selectedGlobals (input : LinkedCoreProofInput)
+    (slice : LinkedCoreProofSlice) :
+    Option (List (sym × generic_globs Unit Unit)) :=
+  if !input.validSlice slice then none
+  else some <| (input.core.globs.zipIdx.filter
+    (fun (_, ordinal) => slice.globalOrdinals.contains ordinal)).map Prod.fst
+
+structure LinkedBindingInputs where
+  bindingSHA256 : String
+  cabs : List String
+  libcCore : String
+  libcTus : List String
+  runtimeStdCore : String
+  fuel : Nat
+  addressSpaceTop : Int
+
+def hashFile (tool path : String) (length : Nat) : IO String := do
+  let out ← IO.Process.output { cmd := tool, args := #[path] }
+  if out.exitCode != 0 then
+    throw <| IO.userError s!"{tool} failed for {path}: {out.stderr}"
+  let hash := (out.stdout.splitOn " ").head!
+  unless hash.length == length &&
+      hash.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f')) do
+    throw <| IO.userError s!"malformed {tool} output for {path}"
+  return hash
+
+def requireAbsolute (path : String) : IO Unit := do
+  unless path.startsWith "/" do
+    throw <| IO.userError s!"certificate path is not absolute: {path}"
+
+private def linkedField (object : Lean.Json) (name : String) : IO Lean.Json :=
+  match object.getObjVal? name with
+  | .ok value => pure value
+  | .error error => throw <| IO.userError s!"linked binding missing {name}: {error}"
+
+private def linkedString (object : Lean.Json) (name : String) : IO String := do
+  let value ← linkedField object name
+  match value.getStr? with
+  | .ok text => pure text
+  | .error error => throw <| IO.userError s!"linked binding {name} is not a string: {error}"
+
+private def linkedArray (object : Lean.Json) (name : String) : IO (Array Lean.Json) := do
+  let value ← linkedField object name
+  match value.getArr? with
+  | .ok entries => pure entries
+  | .error error => throw <| IO.userError s!"linked binding {name} is not an array: {error}"
+
+private def linkedBoolean (object : Lean.Json) (name : String) : IO Bool := do
+  let value ← linkedField object name
+  match Lean.fromJson? value with
+  | .ok result => pure result
+  | .error error => throw <| IO.userError s!"linked binding {name} is not Boolean: {error}"
+
+private def linkedNat (object : Lean.Json) (name : String) : IO Nat := do
+  let value ← linkedField object name
+  match Lean.fromJson? value with
+  | .ok result => pure result
+  | .error error => throw <| IO.userError s!"linked binding {name} is not a natural number: {error}"
+
+private def verifyLinkedFile (object : Lean.Json) (pathField hashField : String)
+    (profile : Bool := false) : IO String := do
+  let path ← linkedString object pathField
+  let expected ← linkedString object hashField
+  requireAbsolute path
+  let started ← IO.monoNanosNow
+  unless (← hashFile "sha256sum" path 64) == expected do
+    throw <| IO.userError s!"linked binding input changed: {path}"
+  if profile then
+    IO.eprintln s!"cerberus-lean: linked Core timing kind=operation name=verify_file path={path} ns={(← IO.monoNanosNow) - started}"
+  return path
+
+/-- Recheck the exact source, preprocessing, Cabs, libc, runtime and translator
+bytes recorded by the checked source-binding receipt. This is an IO provenance
+check, not a kernel proof that C translation preserves behavior. -/
+def verifyLinkedBinding (path : String)
+    (expectedTranslator : Option String := none) (profile : Bool := false) :
+    IO LinkedBindingInputs := do
+  requireAbsolute path
+  let bindingSHA ← hashFile "sha256sum" path 64
+  let raw ← IO.FS.readFile path
+  let binding ← match Lean.Json.parse raw with
+    | .ok value => pure value
+    | .error error => throw <| IO.userError s!"linked binding JSON parse failed: {error}"
+  let scope ← linkedString binding "scope"
+  let sshBinding := scope == "configured-ssh-link-input-provenance"
+  let targetBinding := scope == "configured-openssh-target-link-input-provenance"
+  let censusBinding := scope == "pinned-openssh-census-unit-input-provenance"
+  unless (sshBinding && (← linkedString binding "receipt_mode") == "ssh-inputs-only" ||
+      targetBinding && (← linkedString binding "receipt_mode") == "target-inputs-only" ||
+      censusBinding && (← linkedString binding "receipt_mode") == "census-unit-input-only") &&
+      (← linkedBoolean binding "input_provenance_verified") &&
+      !(← linkedBoolean binding "linked_core_certified") &&
+      !(← linkedBoolean binding "lean_argv_executed") do
+    throw <| IO.userError "linked binding is not checked input-only target provenance"
+  if targetBinding then
+    let manifestPath ← verifyLinkedFile binding "target_manifest_path" "target_manifest_sha256" profile
+    let _ ← verifyLinkedFile binding "target_link_map_path" "target_link_map_sha256" profile
+    let _ ← verifyLinkedFile (← linkedField binding "native_target") "path" "sha256" profile
+    let _ ← verifyLinkedFile binding "shared_libc_binding_path" "shared_libc_binding_sha256" profile
+    let manifestRaw ← IO.FS.readFile manifestPath
+    let manifest ← match Lean.Json.parse manifestRaw with
+      | .ok value => pure value
+      | .error error => throw <| IO.userError s!"target manifest JSON parse failed: {error}"
+    let targetName ← linkedString binding "target"
+    let targets ← linkedArray manifest "targets"
+    let mut matchingTargets : Array Lean.Json := #[]
+    for row in targets do
+      if (← linkedString row "target") == targetName then
+        matchingTargets := matchingTargets.push row
+    unless matchingTargets.size == 1 do
+      throw <| IO.userError "target binding does not identify one configured link closure"
+    let manifestSources ← linkedArray matchingTargets[0]! "ordered_sources"
+    let boundSources ← linkedArray binding "frontend_order"
+    unless manifestSources.size == boundSources.size &&
+        manifestSources == boundSources.map (fun row => (row.getObjVal? "source").toOption.getD Lean.Json.null) do
+      throw <| IO.userError "target binding source order differs from native link closure"
+  if censusBinding then
+    let manifestPath ← verifyLinkedFile binding "target_manifest_path" "target_manifest_sha256" profile
+    let _ ← verifyLinkedFile binding "shared_libc_binding_path" "shared_libc_binding_sha256" profile
+    let _ ← verifyLinkedFile binding "census_path" "census_sha256" profile
+    let _ ← verifyLinkedFile binding "binding_generator_path" "binding_generator_sha256" profile
+    let object ← linkedField binding "compiled_object"
+    let objectPath ← verifyLinkedFile object "object_path" "object_sha256" profile
+    let memberSource ← linkedString object "source"
+    let sourceClass ← linkedString binding "source_class"
+    unless objectPath.endsWith ("/" ++ (memberSource.replace ".c" ".o")) do
+      throw <| IO.userError "compiled object does not match its census source"
+    let manifestRaw ← IO.FS.readFile manifestPath
+    let manifest ← match Lean.Json.parse manifestRaw with
+      | .ok value => pure value
+      | .error error => throw <| IO.userError s!"census manifest JSON parse failed: {error}"
+    let unlinked ← linkedArray manifest "unlinked_census_sources"
+    let linked ← linkedArray manifest "linked_source_union"
+    if sourceClass == "archive-only" then
+      unless unlinked.contains (Lean.toJson memberSource) &&
+          !linked.contains (Lean.toJson memberSource) do
+        throw <| IO.userError "archive-only source is in a native executable link"
+      let archive ← linkedField binding "archive_member"
+      let archivePath ← verifyLinkedFile archive "archive_path" "archive_sha256" profile
+      let archiveObjectPath ← verifyLinkedFile archive "object_path" "object_sha256" profile
+      let member ← linkedString archive "member"
+      let expectedArchive := if memberSource.startsWith "openbsd-compat/" then
+        "openbsd-compat/libopenbsd-compat.a"
+        else "libssh.a"
+      unless archivePath.endsWith ("/" ++ expectedArchive) &&
+          archiveObjectPath == objectPath &&
+          (← linkedString archive "source") == memberSource &&
+          objectPath.endsWith ("/" ++ member) do
+        throw <| IO.userError "archive member does not match its census source and object"
+      let archiveList ← IO.Process.output { cmd := "ar", args := #["t", archivePath] }
+      let occurrences := ((archiveList.stdout.splitOn "\n").filter (· == member)).length
+      unless archiveList.exitCode == 0 && occurrences == 1 do
+        throw <| IO.userError "archive member missing or duplicated in the native archive"
+    else if sourceClass == "configured-executable-link" then
+      unless linked.contains (Lean.toJson memberSource) &&
+          !unlinked.contains (Lean.toJson memberSource) do
+        throw <| IO.userError "linked source absent from every configured executable link"
+    else
+      throw <| IO.userError "unknown census unit source class"
+  let switches ← linkedArray binding "semantic_switches"
+  unless switches == #[Lean.toJson "gnu_pointer_conversions"] do
+    throw <| IO.userError "linked binding semantic switches differ"
+  let translator ← linkedField binding "translator"
+  let translatorPath ← verifyLinkedFile translator "path" "sha256" profile
+  let expectedTranslatorPath ← match expectedTranslator with
+    | some value => pure value
+    | none => pure (← IO.appPath).toString
+  unless translatorPath == expectedTranslatorPath do
+    throw <| IO.userError "linked binding names a different translator executable"
+  let runtime ← linkedField binding "runtime"
+  let runtimeStdCore ← verifyLinkedFile (← linkedField runtime "std_core") "path" "sha256" profile
+  let runtimeImpl ← verifyLinkedFile (← linkedField runtime "implementation") "path" "sha256" profile
+  unless runtimeStdCore.endsWith "/libcore/std.core" &&
+      runtimeImpl == runtimeStdCore.replace "/libcore/std.core"
+        "/libcore/impls/gcc_4.9.0_x86_64-apple-darwin10.8.0.impl" do
+    throw <| IO.userError "linked binding runtime paths are inconsistent"
+  let _ ← verifyLinkedFile binding "build_receipt_path" "build_receipt_sha256" profile
+  let fuel ← linkedNat binding "fuel"
+  let addressSpaceTop : Int := Int.ofNat (← linkedNat binding "address_space_top")
+  let sources ← linkedArray binding "frontend_order"
+  unless sources.size > 0 && (!sshBinding || sources.size == 90) &&
+      (!censusBinding || sources.size == 1) do
+    throw <| IO.userError s!"unexpected ordered target input count: {sources.size}"
+  if censusBinding then
+    let object ← linkedField binding "compiled_object"
+    unless (← linkedString sources[0]! "source") == (← linkedString object "source") do
+      throw <| IO.userError "census object and source binding differ"
+  let mut cabs : List String := []
+  for source in sources do
+    let _ ← verifyLinkedFile source "original_path" "original_sha256" profile
+    let pre ← verifyLinkedFile source "preprocessed_path" "preprocessed_sha256" profile
+    let digestStarted ← IO.monoNanosNow
+    unless (← hashFile "md5sum" pre 32) ==
+        (← linkedString source "preprocessed_digest_md5") do
+      throw <| IO.userError s!"linked preprocessed digest changed: {pre}"
+    if profile then
+      IO.eprintln s!"cerberus-lean: linked Core timing kind=operation name=verify_digest path={pre} ns={(← IO.monoNanosNow) - digestStarted}"
+    let cab ← verifyLinkedFile source "cabs_path" "cabs_sha256" profile
+    cabs := cab :: cabs
+  let libc ← linkedField binding "libc"
+  let core ← verifyLinkedFile (← linkedField libc "core") "path" "sha256" profile
+  let metadata ← linkedArray libc "metadata_order"
+  unless metadata.size == 12 do
+    throw <| IO.userError s!"expected 12 libc metadata inputs, found {metadata.size}"
+  let mut libcTus : List String := []
+  for row in metadata do
+    let source ← verifyLinkedFile row "source_path" "source_sha256" profile
+    let digestStarted ← IO.monoNanosNow
+    unless (← hashFile "md5sum" source 32) ==
+        (← linkedString row "source_digest_md5") do
+      throw <| IO.userError s!"linked libc source digest changed: {source}"
+    if profile then
+      IO.eprintln s!"cerberus-lean: linked Core timing kind=operation name=verify_digest path={source} ns={(← IO.monoNanosNow) - digestStarted}"
+    let cab ← verifyLinkedFile row "cabs_path" "cabs_sha256" profile
+    libcTus := cab :: libcTus
+  unless (← hashFile "sha256sum" path 64) == bindingSHA do
+    throw <| IO.userError "linked binding changed during validation"
+  return {
+    bindingSHA256 := bindingSHA, cabs := cabs.reverse,
+    libcCore := core, libcTus := libcTus.reverse,
+    runtimeStdCore, fuel, addressSpaceTop
+  }
+
+def emitCertificate [CerbGlobal.Switches] (outputPath originalSourcePath translationInputPath cabsPath translationInputDigestMD5
+    observedCabsContent : String)
+    (requestedSymbolName : String) (coreFile : file Unit) : IO Unit := do
+  unless CerbGlobal.Switches.switches == CerbGlobal.defaultSwitches do
+    throw <| IO.userError "certificate mode requires canonical default semantic switches"
+  requireAbsolute outputPath
+  requireAbsolute originalSourcePath
+  requireAbsolute translationInputPath
+  requireAbsolute cabsPath
+  unless outputPath != originalSourcePath && outputPath != translationInputPath &&
+      outputPath != cabsPath do
+    throw <| IO.userError "certificate output overlaps a certified input"
+  unless (← IO.FS.readFile cabsPath) == observedCabsContent do
+    throw <| IO.userError "Cabs input changed after parsing"
+  let md5 ← hashFile "md5sum" translationInputPath 32
+  unless md5 == translationInputDigestMD5 do
+    throw <| IO.userError s!"source differs from Cabs digest: {translationInputPath}"
+  let translatorPath := (← IO.appPath).toString
+  requireAbsolute translatorPath
+  if outputPath == translatorPath then
+    throw <| IO.userError "certificate output overlaps translator"
+  let identity : CertIdentity := {
+    originalSourcePath,
+    originalSourceSHA256 := ← hashFile "sha256sum" originalSourcePath 64,
+    translationInputPath,
+    translationInputSHA256 := ← hashFile "sha256sum" translationInputPath 64,
+    translationInputDigestMD5,
+    cabsPath,
+    cabsSHA256 := ← hashFile "sha256sum" cabsPath 64,
+    semanticSwitches := "default:[]",
+    translatorPath,
+    translatorSHA256 := ← hashFile "sha256sum" translatorPath 64
+  }
+  unless (← IO.FS.readFile cabsPath) == observedCabsContent do
+    throw <| IO.userError "Cabs input changed during certificate emission"
+  let selected := (fmapElements coreFile.funs).filter fun (symbol, _) =>
+    match symbol with
+    | .Symbol _ _ (.SD_Id name) => name == requestedSymbolName
+    | _ => false
+  unless selected.length == 1 do
+    throw <| IO.userError s!"expected exactly one translated function named {requestedSymbolName}; found {selected.length}"
+  let quoteStart ← IO.monoMsNow
+  let mut functions : Array CertEntry := #[]
+  for (symbol, body) in selected do
+    let expr := Lean.toExpr symbol
+    if expr.hasSorry || expr.hasFVar || expr.hasMVar then
+      throw <| IO.userError "unclosed function symbol quote"
+    let bodyJson ← match quoteFunction body with
+      | .ok j => pure j
+      | .error e => throw <| IO.userError e
+    functions := functions.push {
+      symbol := exprToJson expr,
+      body := bodyJson
+    }
+  let quoteMs := (← IO.monoMsNow) - quoteStart
+  let referenceStart ← IO.monoMsNow
+  let selectedRefs := CerbBoundaryCensus.collectSelected coreFile (selected.map Prod.fst)
+  let referencesMs := (← IO.monoMsNow) - referenceStart
+  let deferred := selectedRefs.filter fun r =>
+    r.disposition == "translated-body-outside-selected-slice" ||
+    r.disposition == "translated-global-outside-selected-slice"
+  let references := Lean.Json.mkObj [
+    ("schema", Lean.toJson (2 : Nat)),
+    ("scope", Lean.toJson "selected-quoted-symbol-bodies"),
+    ("full_census_deferred", Lean.toJson true),
+    ("excluded_scope", Lean.toJson ([
+      "other translated function bodies", "other Core standard library bodies",
+      "other global initializers", "implementation bodies"
+    ] : List String)),
+    ("selected_symbol_count", Lean.toJson selected.length),
+    ("reference_count", Lean.toJson selectedRefs.size),
+    ("outside_selected_body_or_global_count", Lean.toJson deferred.size),
+    ("rows", Lean.toJson selectedRefs)
+  ]
+  unless (← hashFile "sha256sum" originalSourcePath 64) == identity.originalSourceSHA256 &&
+      (← hashFile "sha256sum" translationInputPath 64) == identity.translationInputSHA256 &&
+      (← hashFile "md5sum" translationInputPath 32) == identity.translationInputDigestMD5 &&
+      (← hashFile "sha256sum" cabsPath 64) == identity.cabsSHA256 &&
+      (← hashFile "sha256sum" translatorPath 64) == identity.translatorSHA256 do
+    throw <| IO.userError "Core certificate inputs changed during emission"
+  let writeStart ← IO.monoMsNow
+  let cert : CertFile := { identity, functions, references }
+  IO.FS.writeFile outputPath (Lean.toJson cert).compress
+  let writeMs := (← IO.monoMsNow) - writeStart
+  IO.eprintln s!"cerberus-lean: certificate profile quote_ms={quoteMs} selected_references_ms={referencesMs} json_write_ms={writeMs}"
+
+/-- Quote one selected body after the function and extern maps have been
+linked. This export-only link omits global initializers: link_aux merges funs
+independently of globs, so the function map is the same as in a successful
+ordinary link. The source binding is rechecked before publication. The JSON
+does not prove C-to-Core translation correctness or global semantics. -/
+def emitLinkedCertificate [CerbGlobal.Switches]
+    (outputPath bindingPath requestedSymbolName : String)
+    (linkedFile : file Unit) : IO Unit := do
+  unless CerbGlobal.Switches.switches == [.gnu_pointer_conversions] do
+    throw <| IO.userError "linked certificate requires the recorded GNU pointer conversion switch"
+  requireAbsolute outputPath
+  requireAbsolute bindingPath
+  let inputs ← verifyLinkedBinding bindingPath
+  let translatorPath := (← IO.appPath).toString
+  unless outputPath != bindingPath && outputPath != translatorPath &&
+      outputPath != inputs.libcCore &&
+      !(inputs.cabs ++ inputs.libcTus).contains outputPath do
+    throw <| IO.userError "linked certificate output overlaps a certified input"
+  let linkedFunctions := fmapElements linkedFile.funs
+  -- The "*" selection records every linked function body in one translation
+  -- run. Other Core file fields remain outside this function-body artifact.
+  let allFunctions := requestedSymbolName == "*"
+  let selected := if allFunctions then linkedFunctions else
+    linkedFunctions.filter fun (symbol, _) =>
+      match symbol with
+      | .Symbol _ _ (.SD_Id name) => name == requestedSymbolName
+      | _ => false
+  if !allFunctions && selected.length != 1 then
+    throw <| IO.userError s!"expected exactly one linked function named {requestedSymbolName}; found {selected.length}"
+  let mut functions : Array CertEntry := #[]
+  let mut quotedCount := 0
+  for (symbol, body) in selected do
+    let symbolExpr := Lean.toExpr symbol
+    if symbolExpr.hasSorry || symbolExpr.hasFVar || symbolExpr.hasMVar then
+      throw <| IO.userError "unclosed linked function symbol quote"
+    let bodyJson ← match quoteFunction body with
+      | .ok value => pure value
+      | .error error => throw <| IO.userError error
+    functions := functions.push { symbol := exprToJson symbolExpr, body := bodyJson }
+    quotedCount := quotedCount + 1
+    if allFunctions && quotedCount % 100 == 0 then
+      IO.eprintln s!"cerberus-lean: linked body export quoted {quotedCount}/{selected.length} functions"
+  if allFunctions then
+    IO.eprintln s!"cerberus-lean: linked body export quoting complete ({quotedCount} functions)"
+  let references := CerbBoundaryCensus.collectSelected linkedFile (selected.map Prod.fst)
+  let deferred := references.filter fun row =>
+    row.disposition == "translated-body-outside-selected-slice" ||
+      row.disposition == "translated-global-outside-selected-slice"
+  let identity : LinkedCertIdentity := {
+    sourceBindingPath := bindingPath,
+    sourceBindingSHA256 := inputs.bindingSHA256,
+    translatorPath,
+    translatorSHA256 := ← hashFile "sha256sum" translatorPath 64,
+    semanticSwitches := "gnu_pointer_conversions",
+    selectedSymbolName := requestedSymbolName,
+    linkProjection := "functions-only; global-initializer-order-omitted",
+    linkedFunctionCount := (fmapElements linkedFile.funs).length
+  }
+  let refs := Lean.Json.mkObj [
+    ("schema", Lean.toJson (3 : Nat)),
+    ("scope", Lean.toJson (if allFunctions then
+      "all-extern-linked-function-bodies" else "selected-body-from-extern-linked-Core")),
+    ("full_census_deferred", Lean.toJson true),
+    ("global_initializer_dispositions_provisional", Lean.toJson true),
+    ("link_projection", Lean.toJson identity.linkProjection),
+    ("selected_symbol_count", Lean.toJson selected.length),
+    ("linked_function_count", Lean.toJson identity.linkedFunctionCount),
+    ("reference_count", Lean.toJson references.size),
+    ("outside_selected_body_or_global_count", Lean.toJson deferred.size),
+    ("excluded_scope", Lean.toJson ((if allFunctions then
+      ["Core standard library bodies", "global initializers",
+        "implementation bodies", "non-body Core file fields"]
+      else
+      ["other linked function bodies", "other Core standard library bodies",
+        "other global initializers", "implementation bodies"]) : List String)),
+    ("rows", Lean.toJson references)
+  ]
+  let afterInputs ← verifyLinkedBinding bindingPath
+  unless afterInputs.bindingSHA256 == inputs.bindingSHA256 &&
+      (← hashFile "sha256sum" translatorPath 64) == identity.translatorSHA256 do
+    throw <| IO.userError "linked certificate inputs changed during emission"
+  let cert : LinkedCertFile := { identity, functions, references := refs }
+  IO.FS.writeFile outputPath (Lean.toJson cert).compress
+
+private def timedQuote {α : Type} [Lean.ToExpr α]
+    (field : String) (value : α) : IO Lean.Expr := do
+  let started ← IO.monoNanosNow
+  let result ← (CerberusFresh.forceIO (fun () => Lean.toExpr value) : BaseIO Lean.Expr)
+  IO.eprintln s!"cerberus-lean: linked Core timing kind=field field={field} entries=1 ns={(← IO.monoNanosNow) - started}"
+  return result
+
+private def timedQuoteList {α : Type} [Lean.ToExpr α]
+    (field : String) (values : List α) : IO Lean.Expr := do
+  let started ← IO.monoNanosNow
+  let typeExpr := Lean.toTypeExpr α
+  let mut result := Lean.mkApp (Lean.mkConst ``List.nil [Lean.Level.zero]) typeExpr
+  let cons := Lean.mkApp (Lean.mkConst ``List.cons [Lean.Level.zero]) typeExpr
+  let mut ordinal := values.length
+  for value in values.reverse do
+    let entryStarted ← IO.monoNanosNow
+    let item ← (CerberusFresh.forceIO (fun () => Lean.toExpr value) : BaseIO Lean.Expr)
+    result := Lean.mkApp2 cons item result
+    ordinal := ordinal - 1
+    IO.eprintln s!"cerberus-lean: linked Core timing kind=item field={field} ordinal={ordinal} ns={(← IO.monoNanosNow) - entryStarted}"
+  IO.eprintln s!"cerberus-lean: linked Core timing kind=field field={field} entries={values.length} ns={(← IO.monoNanosNow) - started}"
+  return result
+
+/-- Export every field from the ordinary linked Core result, checking the
+source binding and translator on both sides of emission. -/
+def emitLinkedCoreSnapshot [CerbGlobal.Switches]
+    (outputPath bindingPath : String) (linkedFile : file Unit) : IO Unit := do
+  unless CerbGlobal.Switches.switches == [.gnu_pointer_conversions] do
+    throw <| IO.userError "linked Core snapshot requires the recorded GNU pointer conversion switch"
+  requireAbsolute outputPath
+  requireAbsolute bindingPath
+  let verificationStarted ← IO.monoNanosNow
+  let inputs ← verifyLinkedBinding bindingPath (profile := true)
+  IO.eprintln s!"cerberus-lean: linked Core timing kind=operation name=verify_initial ns={(← IO.monoNanosNow) - verificationStarted}"
+  let translatorPath := (← IO.appPath).toString
+  unless outputPath != bindingPath && outputPath != translatorPath &&
+      outputPath != inputs.libcCore &&
+      !(inputs.cabs ++ inputs.libcTus).contains outputPath do
+    throw <| IO.userError "linked Core snapshot output overlaps a certified input"
+  let snapshotStarted ← IO.monoNanosNow
+  let snapshot ← (CerberusFresh.forceIO (fun () => CoreSnapshot.fromFile linkedFile) : BaseIO CoreSnapshot)
