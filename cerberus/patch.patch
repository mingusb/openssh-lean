+_Static_assert((unsigned short)0x10001UL == 1, "unsigned reduction");
+_Static_assert((unsigned int)-1 == 0xffffffffU, "unsigned wrap");
+_Static_assert(-(int)3.75 == -3, "truncation toward zero");
