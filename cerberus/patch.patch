+val gnu_sizeof_truth: Core.core_tag_definitions -> Ctype.ctype -> maybe bool
+let gnu_sizeof_truth tagDefs cty =
+  let graph = List.map (fun (tag, (_, def)) ->
+    (tag, match def with
+      | Ctype.StructDef _ members _ -> List.map (fun (_, (_, _, _, member_ty)) -> member_ty) members
+      | Ctype.UnionDef _ members -> List.map (fun (_, (_, _, _, member_ty)) -> member_ty) members
+    end)) (Map_extra.toList tagDefs) in
+  let (positive, _) = List.foldl (fun (known, stationary) _ ->
+    if stationary then (known, true) else
+    let next = List.foldl (fun acc (tag, members) ->
+      if List.elem tag acc || not (List.any (gnu_positive_size_type acc) members)
+      then acc else tag :: acc
+    ) known graph in
+    (next, List.length next = List.length known)
+  ) ([], false) graph in
+  if gnu_positive_size_type positive cty then Just true
+  else
+    (* Absence from the positive-member closure is not proof of zero size:
+       alignment and padding can make an empty aggregate nonempty. Ask the
+       checked layout, retaining missing tags and runtime extents as unknown. *)
+    maybe Nothing (fun size -> if size < 0 then Nothing else Just (size <> 0))
+      (Vla_types.vla_checked_sizeof tagDefs
+        (fun ty -> Mem.eval_integer_value (Mem.sizeof_ival_with_tags tagDefs ty)) cty)
