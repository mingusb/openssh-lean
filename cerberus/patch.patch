+val gnu_guard_value: A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory
+let rec gnu_guard_value (A.AnnotatedExpression ty annots loc node as expr) =
+  match node with
+    | A.AilEbinary prefix A.Comma value ->
+        if gnu_guard_scalar_update prefix then gnu_guard_value value else expr
+    | A.AilEcast qs cty operand ->
+        A.AnnotatedExpression ty annots loc (A.AilEcast qs cty (gnu_guard_value operand))
+    | A.AilEannot cty operand ->
+        A.AnnotatedExpression ty annots loc (A.AilEannot cty (gnu_guard_value operand))
+    | _ -> expr
+  end
+
+val gnu_guard_direct_function: A.expression GenTypes.genTypeCategory -> maybe Symbol.sym
+let rec gnu_guard_direct_function (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilEident sym -> if AilTypesAux.is_function (ctype_of expr) then Just sym else Nothing
+    | A.AilEfunction_decay operand -> gnu_guard_direct_function operand
+    | A.AilEunary A.Address operand -> gnu_guard_direct_function operand
+    | _ -> Nothing
+  end
