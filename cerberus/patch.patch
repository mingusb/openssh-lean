diff --git a/lean_frontend/host/families/network/handler/templates/network_handler.lean.in b/lean_frontend/host/families/network/handler/templates/network_handler.lean.in
new file mode 100644
index 00000000..4e6eb0d9
--- /dev/null
+++ b/lean_frontend/host/families/network/handler/templates/network_handler.lean.in
@@ -0,0 +1,152 @@
+/- Generated host-call handler. The shared runner must validate and select the
+unique continuation before invoking this handler. This module performs one
+native effect and never retries, resumes, or backtracks after that effect. -/
+import Driver
+import CerbHostNetworkAdmission
+import CerbHostDescriptors
+
+namespace CerbHostNetworkHandler
+open CerbMem CerbHostMemoryCells CerberusImpl
+
+def symbols : List String := @SYMBOLS@
+
+/-- Pure classification only. Supported means a guest handler exists, not that
+the current call has passed its exact source-prototype and memory checks. -/
+inductive Selection where
+  | supported (name : String)
+  | unsupported (name reason : String)
+  | other (name : String)
+  deriving BEq, Repr
+
+def classifyName : String → Selection
+@SELECTIONS@
+  | name => .other name
+
+/-- Resolve family identity before any parameter load, reservation or effect.
+Another family may handle .other; errors and selected-family failures are final. -/
+def select [LemFuel] (program : CerbHostNetworkAdmission.Program)
+    (links : Fmap sym sym) (original : sym) : Except Failure Selection := do
+  if (lookup_proc_body links program original).isSome then
+    throw (.boundary "external family selection cannot bypass a modeled or user procedure body")
+  let resolved := resolve_linked_function links original
+  let names := Lem_Map_extra.fold (fun identifier binding found =>
+    let (symbols, linkage) := binding
+    if linkage == .LK_none && symbols.any (fun symbol => symbol == resolved) then
+      let .Identifier _ name := identifier
+      name :: found
+    else found) program.extern []
+  let [name] := names
+    | throw (.boundary "external family selection requires one unique unresolved linker name")
+  return classifyName name
+
+structure EffectReceipt where
+  sequence : Nat
+  request : host_request
+  prepared : CerbHostNetworkGuest.Prepared
+  response : CerbHostNetworkAdapters.NetworkResult
+
+abbrev FailureReceipt :=
+  Failure × CerbHostDescriptors.Table × Option EffectReceipt
+abbrev Result :=
+  driver_state × CerbHostDescriptors.Table × host_response
+
+private inductive Reservation where
+  | unchanged
+  | fresh (plan : CerbHostDescriptors.Plan)
+
+private def descriptorFlags : CerbHostNetworkGuest.Request → Option UInt32
+@FLAGS@
+
+private def reserve (table : CerbHostDescriptors.Table)
+    (request : CerbHostNetworkGuest.Request) :
+    Except String (CerbHostDescriptors.Table × Reservation × List Int) := do
+  CerbHostDescriptors.validateIdle table
+  let count := CerbHostNetworkGuest.descriptorCount request
+  if count == 0 then return (table, .unchanged, [])
+  let (reserved, plan) ← CerbHostDescriptors.reserveFresh table count
+  return (reserved, .fresh plan, plan.guests.map Int.ofNat)
+
+private def resolve (table : CerbHostDescriptors.Table) (guest : Int) :
+    Except String CerbHostNetworkGuest.DescriptorResolution := do
+  match ← CerbHostDescriptors.classify table guest with
+  | .absent => return .absent
+  | .mapped entry => return .mapped entry.native
+
+private def finish (table : CerbHostDescriptors.Table) (reservation : Reservation)
+    (request : CerbHostNetworkGuest.Request) (completion : CerbHostNetworkGuest.Completion) :
+    Except String CerbHostDescriptors.Table := do
+  match reservation with
+  | .unchanged =>
+    if !completion.descriptorTransfers.isEmpty then
+      throw "network response transferred descriptors without a reservation"
+    return table
+  | .fresh plan =>
+    if completion.returnValue == -1 then
+      if !completion.descriptorTransfers.isEmpty then
+        throw "failed network call transferred live descriptors"
+      return ← CerbHostDescriptors.completeFresh table plan.ticket
+        (.failed completion.returnValue completion.nativeErrnoAfter)
+    if completion.descriptorTransfers.map Prod.fst != plan.guests.map Int.ofNat then
+      throw "network descriptor transfers differ from reserved guest identities"
+    let returned := completion.descriptorTransfers.map fun (_, native) =>
+      ({ native := native, descriptorFlags := descriptorFlags request, statusFlags := none } :
+        CerbHostDescriptors.Returned)
+    CerbHostDescriptors.completeFresh table plan.ticket (.returned returned)
+
+/-- Only the already-selected request is handled. ABI selection, continuation
+shape, and available continuation fuel are obligations of the shared IO runner.
+The passed table is the complete live inventory for this same isolated worker. -/
+def performRequest [LemFuel] [CerbGlobal.Switches]
+    (sequence : Nat) (table : CerbHostDescriptors.Table)
+    (perform : CerbHostNetworkGuest.Prepared → BaseIO CerbHostNetworkAdapters.NetworkResult)
+    (state : driver_state) (request : host_request) :
+    BaseIO (Except FailureReceipt Result) := do
+  if !state.host_enabled || state.host_reply.isSome ||
+      state.host_sequence != sequence + 1 then
+    return .error (.boundary "invalid network request state or sequence", table, none)
+  match CerbHostDescriptors.validateIdle table with
+  | .error error => return .error (.boundary error, table, none)
+  | .ok () => pure ()
+  let .Host_external tid location errnoPointer symbol callType arguments := request
+    | return .error (.boundary "network handler requires an external-call request", table, none)
+  if state.core_state0.thread_states.length != 1 then
+    return .error (.boundary "concurrent network host execution is not implemented", table, none)
+  let some (_, (_, thread)) := state.core_state0.thread_states.find? (fun entry => entry.1 == tid)
+    | return .error (.boundary "network request has no current thread", table, none)
+  if thread.errno != errnoPointer || thread.current_loc != location then
+    return .error (.boundary "network request changed its thread errno object or location", table, none)
+  let admitted ← match CerbHostNetworkAdmission.admit location state.core_file
+      state.core_extern symbol callType arguments with
+    | .error error => return .error (error, table, none)
+    | .ok admitted => pure admitted
+  let decoded ← match CerbHostNetworkAdmission.decode admitted state.layout_state (some table.limit) with
+    | .error error => return .error (error, table, none)
+    | .ok decoded => pure decoded
+  let (reserved, reservation, guests) ← match reserve table decoded.request with
+    | .error error => return .error (.boundary error, table, none)
+    | .ok reservation => pure reservation
+  let enums := state.core_file.enumDefs
+  let tags := state.core_file.tagDefs
+  let prepared ← match CerbHostNetworkGuest.prepareResolved enums tags
+      (resolve reserved) guests errnoPointer decoded.request decoded.memory with
+    | .error error => return .error (error, table, none)
+    | .ok prepared => pure prepared
+  let response ← perform prepared
+  let receipt : EffectReceipt := ⟨sequence, request, prepared, response⟩
+  let completion ← match CerbHostNetworkGuest.complete enums tags prepared response with
+    | .error error => return .error (error, reserved, some receipt)
+    | .ok completion => pure completion
+  let completedTable ← match finish reserved reservation decoded.request completion with
+    | .error error => return .error (.boundary error, reserved, some receipt)
+    | .ok completedTable => pure completedTable
+  let footprints := decoded.inputFootprints ++ prepared.inputFootprints ++ completion.outputFootprints
+  return .ok ({ state with layout_state := completion.memory }, completedTable,
+    .Host_memory completion.returnValue footprints)
+
+def execute [LemFuel] [CerbGlobal.Switches]
+    (sequence : Nat) (table : CerbHostDescriptors.Table)
+    (state : driver_state) (request : host_request) :
+    BaseIO (Except FailureReceipt Result) :=
+  performRequest sequence table CerbHostNetworkGuest.executeNative state request
+
+end CerbHostNetworkHandler
