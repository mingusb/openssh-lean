+                                  "; local-type=" ^ Pp.stringFromAil_ctype Ctype.no_qualifiers local_ty ^
+                                  "; result-type=" ^ Pp.stringFromAil_ctype Ctype.no_qualifiers (ctype_of result)) in
+                                if subject <> local || not (gnu_function_target_type_equal local_ty (ctype_of result))
