+(* The typeof-origin marker is needed by GNU mode/layout admission, so retain it
+   in every source type. For this value-flow transfer only, compare integer
+   parameter types after removing that exact internal origin marker. All other
+   annotations and the shared conservative type relation remain in force. *)
+val gnu_alloc_size_rebind_annotations: list Annot.annot -> list Annot.annot
+let gnu_alloc_size_rebind_annotations annotations =
+  List.foldr (fun annotation kept -> match annotation with
+    | Annot.Aattrs (Annot.Attrs attributes) ->
+        let attributes = List.filter (fun attribute ->
+          not (Cerb_attributes.is_typeof_expr_origin attribute)) attributes in
+        if attributes = [] then kept
+        else Annot.Aattrs (Annot.Attrs attributes) :: kept
+    | _ -> annotation :: kept
+  end) [] annotations
