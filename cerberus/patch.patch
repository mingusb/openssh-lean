+(* Whole-TU contents-dependency certificates, used only at generic entry. *)
+val set_gnu_unrefined_parameter_contents: list Symbol.sym -> elabM unit
+let set_gnu_unrefined_parameter_contents parameters = fun st ->
+  ((), <| st with gnu_unrefined_parameter_contents= parameters |>)
