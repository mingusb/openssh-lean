new file mode 100644
index 00000000..4c449f14
--- /dev/null
+++ b/frontend/model/gnu_amd64_asm_core.lem
@@ -0,0 +1,207 @@
+(* Typed Core bridge for the shared AMD64 register semantics. Instruction
+   payloads are data, not executable source strings. Invalid/undefined output
+   values fail explicitly; a write-only register's dummy payload is never read. *)
+open import Pervasives
+import Gnu_amd64_asm Core Mem Mem_aux
+
+module Asm = Gnu_amd64_asm
+
+let inline (>>=) = Asm.asm_bind
+
+val asm_operand_code: Asm.asm_operand -> (integer * integer)
+let asm_operand_code operand = match operand with
+  | Asm.Asm_Slot index -> (0, integerFromNat index)
+  | Asm.Asm_Immediate value -> (1, value)
+end
+
+val asm_condition_code: Asm.asm_condition -> integer
+let asm_condition_code condition = match condition with
+  | Asm.Asm_Equal -> 0 | Asm.Asm_Not_equal -> 1
+  | Asm.Asm_Signed_less -> 2 | Asm.Asm_Signed_less_equal -> 3
+  | Asm.Asm_Signed_greater -> 4 | Asm.Asm_Signed_greater_equal -> 5
+  | Asm.Asm_Below -> 6 | Asm.Asm_Below_equal -> 7
+  | Asm.Asm_Above -> 8 | Asm.Asm_Above_equal -> 9
+end
+
+val asm_instruction_code: Asm.asm_instruction -> list integer
+let asm_instruction_code instruction =
+  let record opcode variant source destination =
+    let (source_kind, source_value) = asm_operand_code source in
+    let (dest_kind, dest_value) = asm_operand_code destination in
+    [opcode; variant; source_kind; source_value; dest_kind; dest_value]
+  in
+  match instruction with
+    | Asm.Asm_Move source dest -> record 0 0 source (Asm.Asm_Slot dest)
+    | Asm.Asm_Logical operation source dest ->
+        let variant = match operation with
+          | Asm.Asm_Logical_and -> 0 | Asm.Asm_Logical_or -> 1 | Asm.Asm_Logical_xor -> 2
+        end in record 1 variant source (Asm.Asm_Slot dest)
+    | Asm.Asm_Test source dest -> record 2 0 source dest
+    | Asm.Asm_Compare source dest -> record 3 0 source dest
+    | Asm.Asm_Shift operation source dest ->
+        let variant = match operation with
+          | Asm.Asm_Shift_left -> 0 | Asm.Asm_Shift_right -> 1 | Asm.Asm_Shift_arithmetic_right -> 2
+        end in record 4 variant source (Asm.Asm_Slot dest)
+    | Asm.Asm_Bit_scan_forward source dest -> record 5 0 source (Asm.Asm_Slot dest)
+    | Asm.Asm_Conditional_move condition source dest ->
+        record 6 (asm_condition_code condition) source (Asm.Asm_Slot dest)
+  end
+
+val asm_operand_of_code: integer -> integer -> maybe Asm.asm_operand
+let asm_operand_of_code kind value =
+  if kind = 0 && value >= 0 then Just (Asm.Asm_Slot (natFromInteger value))
+  else if kind = 1 then Just (Asm.Asm_Immediate value) else Nothing
+
+val asm_instruction_of_code: list integer -> either string Asm.asm_instruction
+let asm_instruction_of_code code =
+  let bad = Left "GNU AMD64 asm Core instruction payload is malformed" in
+  match code with
+    | [opcode; variant; source_kind; source_value; dest_kind; dest_value] ->
+        if opcode < 0 || variant < 0 then bad else
+        match (asm_operand_of_code source_kind source_value,
+               asm_operand_of_code dest_kind dest_value) with
+          | (Just source, Just destination) ->
+              match (natFromInteger opcode, natFromInteger variant, destination) with
+                | (0, 0, Asm.Asm_Slot index) -> Right (Asm.Asm_Move source index)
+                | (1, 0, Asm.Asm_Slot index) -> Right (Asm.Asm_Logical Asm.Asm_Logical_and source index)
+                | (1, 1, Asm.Asm_Slot index) -> Right (Asm.Asm_Logical Asm.Asm_Logical_or source index)
+                | (1, 2, Asm.Asm_Slot index) -> Right (Asm.Asm_Logical Asm.Asm_Logical_xor source index)
+                | (2, 0, _) -> Right (Asm.Asm_Test source destination)
+                | (3, 0, _) -> Right (Asm.Asm_Compare source destination)
+                | (4, 0, Asm.Asm_Slot index) -> Right (Asm.Asm_Shift Asm.Asm_Shift_left source index)
+                | (4, 1, Asm.Asm_Slot index) -> Right (Asm.Asm_Shift Asm.Asm_Shift_right source index)
+                | (4, 2, Asm.Asm_Slot index) -> Right (Asm.Asm_Shift Asm.Asm_Shift_arithmetic_right source index)
+                | (5, 0, Asm.Asm_Slot index) -> Right (Asm.Asm_Bit_scan_forward source index)
+                | (6, _, Asm.Asm_Slot index) ->
+                    match List.lookup variant
+                      [(0, Asm.Asm_Equal); (1, Asm.Asm_Not_equal);
+                       (2, Asm.Asm_Signed_less); (3, Asm.Asm_Signed_less_equal);
+                       (4, Asm.Asm_Signed_greater); (5, Asm.Asm_Signed_greater_equal);
+                       (6, Asm.Asm_Below); (7, Asm.Asm_Below_equal);
+                       (8, Asm.Asm_Above); (9, Asm.Asm_Above_equal)] with
+                      | Just condition -> Right (Asm.Asm_Conditional_move condition source index)
+                      | Nothing -> bad
+                    end
+                | _ -> bad
+              end
+          | _ -> bad
+        end
+    | _ -> bad
+  end
+
+val asm_either_map: forall 'a 'b. ('a -> either string 'b) -> list 'a -> either string (list 'b)
+let asm_either_map function_ values =
+  List.foldr (fun value rest -> match (function_ value, rest) with
+    | (Right value', Right rest') -> Right (value' :: rest')
+    | (Left message, _) -> Left message
+    | (_, Left message) -> Left message
+  end) (Right []) values
+
+val asm_core_integer: Core.value -> either string integer
+let asm_core_integer value = match value with
+  | Core.Vobject (Core.OVinteger integer_value) ->
+      match Mem.provenance_free_integer integer_value with
+        | Just integer -> Right integer
+        | Nothing -> Left "GNU AMD64 asm provenance-bearing or symbolic integer operands are unsupported"
+      end
+  | _ -> Left "GNU AMD64 asm Core operand is not an integer"
+end
+
+val asm_core_word: Core.value -> either string Asm.asm_word
+let asm_core_word value = match value with
+  | Core.Vtuple [Core.Vtrue; payload] ->
+      match asm_core_integer payload with
+        | Right integer -> Right (Just integer)
+        | Left message -> Left message
+      end
+  | Core.Vtuple [Core.Vfalse; payload] ->
+      (* Check the payload's Core type, but do not invent a register value. *)
+      match asm_core_integer payload with
+        | Right _ -> Right Nothing
+        | Left message -> Left message
+      end
+  | _ -> Left "GNU AMD64 asm Core register knownness is malformed"
+end
+
+val asm_core_instruction: Core.value -> either string Asm.asm_instruction
+let asm_core_instruction value = match value with
+  | Core.Vlist (Core.BTy_object Core.OTy_integer) values -> match asm_either_map asm_core_integer values with
+      | Left message -> Left message
+      | Right code -> asm_instruction_of_code code
+    end
+  | _ -> Left "GNU AMD64 asm Core instruction is not a list"
+end
+
+(* Core may also be supplied directly. Reuse the C template decoder's encoding
+   checks, then enforce the register-bank boundary independently of the C
+   constraint validator. A variable shift already names its count-value slot;
+   physical allocation was checked before C lowering and is not re-invented. *)
+val asm_core_validate_instruction: nat -> nat -> nat -> Asm.asm_instruction -> either string Asm.asm_instruction
+let asm_core_validate_instruction width total outputs instruction =
+  let decode opcode source destination =
+    let count_slot = match source with Asm.Asm_Slot index -> Just index | _ -> Nothing end in
+    Asm.asm_decode_opcode width count_slot opcode source destination
+  in
+  let checked = match instruction with
+    | Asm.Asm_Move source destination -> decode "mov" source destination
+    | Asm.Asm_Logical operation source destination ->
+        decode (match operation with
+          | Asm.Asm_Logical_and -> "and" | Asm.Asm_Logical_or -> "or" | Asm.Asm_Logical_xor -> "xor"
+        end) source destination
+    | Asm.Asm_Test source (Asm.Asm_Slot destination) -> decode "test" source destination
+    | Asm.Asm_Compare source (Asm.Asm_Slot destination) -> decode "cmp" source destination
+    | Asm.Asm_Test _ _ ->
+        Left "GNU AMD64 asm Core comparison destination is not a register"
+    | Asm.Asm_Compare _ _ ->
+        Left "GNU AMD64 asm Core comparison destination is not a register"
+    | Asm.Asm_Shift operation source destination ->
+        decode (match operation with
+          | Asm.Asm_Shift_left -> "shl" | Asm.Asm_Shift_right -> "shr"
+          | Asm.Asm_Shift_arithmetic_right -> "sar"
+        end) source destination
+    | Asm.Asm_Bit_scan_forward source destination -> decode "bsf" source destination
+    | Asm.Asm_Conditional_move condition source destination ->
+        decode (match condition with
+          | Asm.Asm_Equal -> "cmove" | Asm.Asm_Not_equal -> "cmovne"
+          | Asm.Asm_Signed_less -> "cmovl" | Asm.Asm_Signed_less_equal -> "cmovle"
+          | Asm.Asm_Signed_greater -> "cmovg" | Asm.Asm_Signed_greater_equal -> "cmovge"
+          | Asm.Asm_Below -> "cmovb" | Asm.Asm_Below_equal -> "cmovbe"
+          | Asm.Asm_Above -> "cmova" | Asm.Asm_Above_equal -> "cmovae"
+        end) source destination
+  end in
+  match checked with
+    | Left message -> Left message
+    | Right instruction' ->
+        let (reads, write, _) = Asm.asm_instruction_accesses instruction' in
+        if List.any (fun index -> index >= total) reads ||
+           (match write with Just index -> index >= outputs | Nothing -> false end) then
+          Left "GNU AMD64 asm Core instruction accesses an invalid or input-only register"
+        else Right instruction'
+  end
+
+val asm_core_run: list Core.value -> either string Core.value
+let asm_core_run arguments = match arguments with
+  | [width_value; output_count_value;
+     Core.Vlist (Core.BTy_list (Core.BTy_object Core.OTy_integer)) program_values;
+     Core.Vlist (Core.BTy_tuple [Core.BTy_boolean; Core.BTy_object Core.OTy_integer]) register_values] ->
+      asm_core_integer width_value >>= fun width ->
+      asm_core_integer output_count_value >>= fun output_count ->
+      asm_either_map asm_core_instruction program_values >>= fun program ->
+      asm_either_map asm_core_word register_values >>= fun registers ->
+      if not (List.elem width [8; 16; 32; 64]) || output_count <= 0 ||
+         output_count > integerFromNat (List.length registers) then
+        Left "GNU AMD64 asm Core width or output count is invalid"
+      else
+        let width = natFromInteger width in
+        let output_count = natFromInteger output_count in
+        asm_either_map (asm_core_validate_instruction width (List.length registers) output_count)
+          program >>= fun checked_program ->
+        Asm.asm_execute width checked_program
+          <| Asm.asm_registers= registers; Asm.asm_status= Asm.asm_unknown_flags |> >>= fun state ->
+        asm_either_map (function
+          | Just integer -> Right (Core.Vobject (Core.OVinteger (Mem.integer_ival integer)))
+          | Nothing -> Left "GNU AMD64 asm output remains architecturally undefined"
+        end) (List.take output_count state.Asm.asm_registers) >>= fun outputs ->
+        Right (Core.Vlist (Core.BTy_object Core.OTy_integer) outputs)
+  | _ -> Left "GNU AMD64 asm Core builtin arguments are malformed"
+end
diff --git a/frontend/model/gnu_amd64_varargs.lem b/frontend/model/gnu_amd64_varargs.lem
new file mode 100644
index 00000000..22efbe16
--- /dev/null
+++ b/frontend/model/gnu_amd64_varargs.lem
@@ -0,0 +1,356 @@
+(* GNU AMD64 SysV variadic argument classification and frame planning.
+
+   Shared classifier used by the GNU AMD64 runtime. C frontend admission
+   still requires the separate typing/translation and lifetime integration.
+   The planner describes real GP/SSE save slots and stack locations; it must
+   not be replaced by the replacement libc's integer va_list cursor.
+
+   Layout callbacks must come from the selected target's actual CType layout.
+   Missing or unsupported layout is an error, never a fabricated size/offset.
+   Register-save holes have no invented contents. Runtime storage, provenance,
+   argument type checks, cursor writes and frame lifetime remain obligations.
+*)
+open import Pervasives Utils
+import Ctype Symbol Loc Annot Map Map_extra Implementation
+
+type gnuabi_tag_definitions = map Symbol.sym (Loc.t * Ctype.tag_definition)
+
+val gnuabi_bind: forall 'a 'b. either string 'a -> ('a -> either string 'b) -> either string 'b
+let gnuabi_bind result next = match result with
+  | Left message -> Left message
+  | Right value -> next value
+end
+let inline (>>=) = gnuabi_bind
+
+type gnuabi_layout_oracle = <|
+  gnuabi_size_of: Ctype.ctype -> maybe integer;
+  gnuabi_align_of: Ctype.ctype -> maybe integer;
+  gnuabi_offset_of: Symbol.sym -> Symbol.identifier -> maybe integer;
+|>
+
+type gnuabi_eightbyte_class =
+  | GNUABI_No_class
+  | GNUABI_Integer_class
+  | GNUABI_SSE_class
+  | GNUABI_SSE_up_class
+  | GNUABI_X87_class
+  | GNUABI_X87_up_class
+  | GNUABI_Memory_class
+
+instance (Eq gnuabi_eightbyte_class)
+  let (=) = unsafe_structural_equality
+  let (<>) = unsafe_structural_inequality
+end
+
+type gnuabi_argument_layout = <|
+  gnuabi_argument_type: Ctype.ctype;
+  gnuabi_argument_size: integer;
+  gnuabi_argument_alignment: integer;
+  (* Nothing denotes the SysV MEMORY class, not a missing analysis. *)
+  gnuabi_argument_classes: maybe (list gnuabi_eightbyte_class);
+|>
+
+type gnuabi_copy_piece = <|
+  gnuabi_source_offset: integer;
+  gnuabi_save_offset: integer;
+  gnuabi_copy_size: integer;
+|>
+
+type gnuabi_argument_location =
+  | GNUABI_Register_argument of list gnuabi_copy_piece
+  | GNUABI_Stack_argument of integer
+
+type gnuabi_placed_argument = <|
+  gnuabi_placed_layout: gnuabi_argument_layout;
+  gnuabi_placed_location: gnuabi_argument_location;
+|>
+
+type gnuabi_placement_state = <|
+  gnuabi_gp_used: integer;
+  gnuabi_fp_used: integer;
+  gnuabi_stack_used: integer;
+|>
+
+type gnuabi_frame_layout = <|
+  gnuabi_named_arguments: list gnuabi_placed_argument;
+  gnuabi_anonymous_arguments: list gnuabi_placed_argument;
+  gnuabi_initial_gp_offset: integer;
+  gnuabi_initial_fp_offset: integer;
+  gnuabi_initial_overflow_offset: integer;
+  gnuabi_overflow_size: integer;
+  gnuabi_register_save_size: integer;
+  gnuabi_has_hidden_result_pointer: bool;
+|>
+
+val gnuabi_align_up: integer -> integer -> integer
+let gnuabi_align_up value alignment =
+  let remainder = value mod alignment in
+  if remainder = 0 then value else value + alignment - remainder
+
+val gnuabi_merge_class: gnuabi_eightbyte_class -> gnuabi_eightbyte_class -> gnuabi_eightbyte_class
+let gnuabi_merge_class left right =
+  if left = right then left else
+  if left = GNUABI_No_class then right else
+  if right = GNUABI_No_class then left else
+  if left = GNUABI_Memory_class || right = GNUABI_Memory_class then GNUABI_Memory_class else
+  if left = GNUABI_Integer_class || right = GNUABI_Integer_class then GNUABI_Integer_class else
+  if List.elem left [GNUABI_X87_class; GNUABI_X87_up_class] || List.elem right [GNUABI_X87_class; GNUABI_X87_up_class]
+  then GNUABI_Memory_class
+  else GNUABI_SSE_class
+
+val gnuabi_shape_nodes: Ctype.ctype -> nat
+let rec gnuabi_shape_nodes (Ctype.Ctype _ ty) = match ty with
+  | Ctype.Array element _ -> 1 + gnuabi_shape_nodes element
+  | Ctype.Atomic element -> 1 + gnuabi_shape_nodes element
+  | _ -> 1
+end
+
+(* A bound derived from the actual type graph, not a fixed acceptance limit.
+   Pointers stop recursion; repeated aggregate tags on a by-value path are
+   separately rejected. Every recursive step consumes a CType node or a tag. *)
+val gnuabi_traversal_budget: gnuabi_tag_definitions -> Ctype.ctype -> nat
+let gnuabi_traversal_budget tags ty =
+  1 + gnuabi_shape_nodes ty + List.foldl (fun total (_, (_, definition)) ->
+    let members = match definition with
+      | Ctype.StructDef _ members _ -> members
+      | Ctype.UnionDef _ members -> members
+    end in
+    total + 1 + List.foldl (fun n (_, (_, _, _, member_ty)) -> n + gnuabi_shape_nodes member_ty) 0 members
+  ) 0 (Map_extra.toList tags)
+
+(* Class contributions use absolute byte positions within the argument, so
+   nested aggregates do not accidentally classify their padding as values. *)
+val gnuabi_mark_slots: integer -> integer -> gnuabi_eightbyte_class -> list (integer * gnuabi_eightbyte_class)
+let gnuabi_mark_slots offset size cls =
+  if size = 0 then [] else
+  let first = offset / 8 in
+  let last = (offset + size - 1) / 8 in
+  if first = last then [(first, cls)] else [(first, cls); (last, cls)]
+
+val gnuabi_merge_contributions:
+  either string (maybe (list (integer * gnuabi_eightbyte_class))) ->
+  either string (maybe (list (integer * gnuabi_eightbyte_class))) ->
+  either string (maybe (list (integer * gnuabi_eightbyte_class)))
+let gnuabi_merge_contributions left right = match (left, right) with
+  | (Left message, _) -> Left message
+  | (_, Left message) -> Left message
+  | (Right Nothing, _) -> Right Nothing
+  | (_, Right Nothing) -> Right Nothing
+  | (Right (Just a), Right (Just b)) -> Right (Just (a ++ b))
+end
+
+(* Each floating category contributes either one SSE eightbyte or a paired
+   class. Keep its layout check and diagnostic together. *)
+val gnuabi_float_slots: integer -> integer -> Ctype.realFloatingType ->
+  either string (maybe (list (integer * gnuabi_eightbyte_class)))
+let gnuabi_float_slots offset size real_ty =
+  let paired first second mismatch =
+    if size = 16 && offset mod 16 = 0 then
+      Right (Just [(offset / 8, first); (offset / 8 + 1, second)])
+    else Left mismatch in
+  match real_ty with
+    | Ctype.LongDouble -> paired GNUABI_X87_class GNUABI_X87_up_class
+        "GNU variadic ABI long double layout does not match AMD64 SysV"
+    | Ctype.FloatN64x -> paired GNUABI_X87_class GNUABI_X87_up_class
+        "GNU variadic ABI _Float64x layout does not match AMD64 SysV"
+    | Ctype.FloatN128 -> paired GNUABI_SSE_class GNUABI_SSE_up_class
+        "GNU variadic ABI _Float128 layout does not match AMD64 SysV"
+    | _ ->
+        if size <= 8 then Right (Just (gnuabi_mark_slots offset size GNUABI_SSE_class))
+        else Left "GNU variadic ABI floating layout does not match AMD64 SysV"
+  end
+
+(* The explicit traversal bound is represented structurally inside the worker.
+   Each recursive type edge consumes exactly one token. The public nat-bound
+   entry point below retains the same budget and exhaustion behavior. *)
+val gnuabi_classify_slots_budget: list unit -> list Symbol.sym -> gnuabi_tag_definitions -> gnuabi_layout_oracle ->
+  integer -> Ctype.ctype -> either string (maybe (list (integer * gnuabi_eightbyte_class)))
+let rec gnuabi_classify_slots_budget fuel seen tags oracle offset (Ctype.Ctype annots ty as cty) =
+  match fuel with
+  | [] -> Left "GNU variadic ABI type traversal exhausted its type-graph bound"
+  | _ :: remaining ->
+  let recurse next_seen at child = gnuabi_classify_slots_budget remaining next_seen tags oracle at child in
+  match (oracle.gnuabi_size_of cty, oracle.gnuabi_align_of cty) with
+    | (Just size, Just alignment) ->
+      if size < 0 || alignment <= 0 then Left "GNU variadic ABI received an invalid type layout" else
+      if offset mod alignment <> 0 then Right Nothing else
+      if size > 16 then Right Nothing else
+      if size = 0 then Right (Just []) else
+      match Annot.get_bitfield annots with
+        | Just _ -> Left "GNU variadic ABI bit-field classification is not yet implemented"
+        | Nothing -> match ty with
+          | Ctype.Basic (Ctype.Integer _) -> Right (Just (gnuabi_mark_slots offset size GNUABI_Integer_class))
+          | Ctype.Pointer _ _ -> Right (Just (gnuabi_mark_slots offset size GNUABI_Integer_class))
+          | Ctype.Nullptr -> Right (Just (gnuabi_mark_slots offset size GNUABI_Integer_class))
+          | Ctype.Basic (Ctype.Floating (Ctype.RealFloating real_ty)) ->
+              gnuabi_float_slots offset size real_ty
+          | Ctype.Atomic element -> recurse seen offset element
+          | Ctype.Array element (Just bound) ->
+              if bound < 0 then Left "GNU variadic ABI array bound is negative" else
+              match oracle.gnuabi_size_of element with
+                | Just element_size ->
+                    if element_size <= 0 then Left "GNU variadic ABI nonempty array has invalid element size" else
+                    if bound * element_size <> size then Left "GNU variadic ABI array size is inconsistent" else
+                    List.foldl (fun accumulated index ->
+                      gnuabi_merge_contributions accumulated
+                        (recurse seen (offset + integerFromNat index * element_size) element)
+                    ) (Right (Just [])) (Utils.list_init (natFromInteger bound) (fun n -> n))
+                | Nothing -> Left "GNU variadic ABI array element layout is unavailable"
+              end
+          | Ctype.Struct tag ->
+              if List.elem tag seen then Left "GNU variadic ABI recursive by-value structure" else
+              match Map.lookup tag tags with
+                | Just (_, Ctype.StructDef layout members flexible) ->
+                    if flexible <> Nothing then
+                      Left "GNU variadic ABI flexible array aggregate classification is not yet implemented"
+                    else List.foldl (fun accumulated (field_ident, (_, _, _, member_ty)) ->
+                      match (oracle.gnuabi_offset_of tag field_ident, oracle.gnuabi_size_of member_ty) with
+                        | (Just member_offset, Just member_size) ->
+                            if member_offset < 0 || member_size < 0 || member_offset + member_size > size then
+                              Left "GNU variadic ABI structure member extent is invalid"
+                            else gnuabi_merge_contributions accumulated
+                              (recurse (tag :: seen) (offset + member_offset) member_ty)
+                        | _ -> Left "GNU variadic ABI structure member layout is unavailable"
+                      end
+                    ) (Right (Just [])) members
+                | _ -> Left "GNU variadic ABI structure definition is unavailable"
+              end
+          | Ctype.Union tag ->
+              if List.elem tag seen then Left "GNU variadic ABI recursive by-value union" else
+              match Map.lookup tag tags with
+                | Just (_, Ctype.UnionDef layout members) ->
+                    List.foldl (fun accumulated (_, (_, _, _, member_ty)) ->
+                      match oracle.gnuabi_size_of member_ty with
+                        | Just member_size ->
+                            if member_size < 0 || member_size > size then
+                              Left "GNU variadic ABI union member extent is invalid"
+                            else gnuabi_merge_contributions accumulated (recurse (tag :: seen) offset member_ty)
+                        | Nothing -> Left "GNU variadic ABI union member layout is unavailable"
+                      end
+                    ) (Right (Just [])) members
+                | _ -> Left "GNU variadic ABI union definition is unavailable"
+              end
+          | _ -> Left "GNU variadic ABI type category is not yet implemented"
+        end
+      end
+    | _ -> Left "GNU variadic ABI type size or alignment is unavailable"
+  end
+  end
+
+declare {lean} termination_argument gnuabi_classify_slots_budget = automatic
+
+val gnuabi_classify_slots: nat -> list Symbol.sym -> gnuabi_tag_definitions -> gnuabi_layout_oracle ->
+  integer -> Ctype.ctype -> either string (maybe (list (integer * gnuabi_eightbyte_class)))
+let gnuabi_classify_slots fuel seen tags oracle offset cty =
+  gnuabi_classify_slots_budget (List.replicate fuel ()) seen tags oracle offset cty
+
+(* Combine absolute byte contributions, then apply the SysV cleanup rules.
+   Padding stays NO_CLASS; an orphan X87UP is MEMORY and an orphan SSEUP is SSE. *)
+val gnuabi_finish_classes: integer -> list (integer * gnuabi_eightbyte_class) ->
+  maybe (list gnuabi_eightbyte_class)
+let gnuabi_finish_classes size contributions =
+  let count = natFromInteger ((size + 7) / 8) in
+  let classes = Utils.list_init count (fun index ->
+    List.foldl (fun cls (slot, contribution) ->
+      if slot = integerFromNat index then gnuabi_merge_class cls contribution else cls
+    ) GNUABI_No_class contributions) in
+  let cleanup (previous, invalid, reversed) cls =
+    let next =
+      if cls = GNUABI_SSE_up_class &&
+         previous <> GNUABI_SSE_class && previous <> GNUABI_SSE_up_class
+      then GNUABI_SSE_class else cls in
+    let invalid = invalid || cls = GNUABI_Memory_class ||
+      (cls = GNUABI_X87_up_class && previous <> GNUABI_X87_class) in
+    (next, invalid, next :: reversed) in
+  let (_, invalid, reversed) = List.foldl cleanup (GNUABI_No_class, false, []) classes in
+  if invalid then Nothing else Just (List.reverse reversed)
+
+val gnuabi_classify: gnuabi_tag_definitions -> gnuabi_layout_oracle -> Ctype.ctype -> either string gnuabi_argument_layout
+let gnuabi_classify tags oracle ty =
+  if not (Implementation.has_amd64_sysv_abi ()) then
+    Left "GNU variadic ABI requires the AMD64 SysV target" else
+  match (oracle.gnuabi_size_of ty, oracle.gnuabi_align_of ty) with
+    | (Just size, Just alignment) ->
+        if size < 0 || alignment <= 0 then Left "GNU variadic ABI received an invalid type layout" else
+        gnuabi_classify_slots (gnuabi_traversal_budget tags ty) [] tags oracle 0 ty >>= fun contributions ->
+        let classes = match contributions with
+          | Nothing -> Nothing
+          | Just slots -> gnuabi_finish_classes size slots
+        end in
+        Right <| gnuabi_argument_type= ty; gnuabi_argument_size= size;
+          gnuabi_argument_alignment= alignment; gnuabi_argument_classes= classes |>
+    | _ -> Left "GNU variadic ABI type size or alignment is unavailable"
+  end
+
+val gnuabi_register_need: list gnuabi_eightbyte_class -> integer * integer
+let gnuabi_register_need classes = List.foldl (fun (gp, fp) cls -> match cls with
+  | GNUABI_Integer_class -> (gp+1, fp)
+  | GNUABI_SSE_class -> (gp, fp+1)
+  | _ -> (gp, fp)
+end) (0, 0) classes
+
+val gnuabi_register_pieces: gnuabi_argument_layout -> gnuabi_placement_state -> list gnuabi_eightbyte_class -> list gnuabi_copy_piece
+let gnuabi_register_pieces layout state classes =
+  let (_, _, _, _, reversed) = List.foldl (fun (source, gp, fp, last_sse, pieces) cls ->
+    let amount = min 8 (layout.gnuabi_argument_size-source) in
+    let piece at = <| gnuabi_source_offset= source; gnuabi_save_offset= at; gnuabi_copy_size= amount |> in
+    match cls with
+      | GNUABI_No_class -> (source+8, gp, fp, last_sse, pieces)
+      | GNUABI_Integer_class -> (source+8, gp+1, fp, last_sse, piece (gp*8) :: pieces)
+      | GNUABI_SSE_class -> (source+8, gp, fp+1, 48+fp*16, piece (48+fp*16) :: pieces)
+      | GNUABI_SSE_up_class -> (source+8, gp, fp, last_sse, piece (last_sse+8) :: pieces)
+      (* gnuabi_place excludes these classes from register allocation. *)
+      | GNUABI_X87_class -> (source+8, gp, fp, last_sse, pieces)
+      | GNUABI_X87_up_class -> (source+8, gp, fp, last_sse, pieces)
+      | GNUABI_Memory_class -> (source+8, gp, fp, last_sse, pieces)
+    end
+  ) (0, state.gnuabi_gp_used, state.gnuabi_fp_used, 0, []) classes in
+  List.reverse reversed
+
+val gnuabi_place: gnuabi_argument_layout -> gnuabi_placement_state -> gnuabi_placed_argument * gnuabi_placement_state
+let gnuabi_place layout state =
+  let stack () =
+    let at = gnuabi_align_up state.gnuabi_stack_used (max 8 layout.gnuabi_argument_alignment) in
+    (<| gnuabi_placed_layout= layout; gnuabi_placed_location= GNUABI_Stack_argument at |>,
+      <| state with gnuabi_stack_used= at + gnuabi_align_up layout.gnuabi_argument_size 8 |>) in
+  match layout.gnuabi_argument_classes with
+    | Nothing -> stack ()
+    | Just classes ->
+        let (gp, fp) = gnuabi_register_need classes in
+        if List.any (fun cls -> List.elem cls [GNUABI_X87_class; GNUABI_X87_up_class; GNUABI_Memory_class]) classes ||
+           state.gnuabi_gp_used + gp > 6 || state.gnuabi_fp_used + fp > 8 then stack () else
+        (<| gnuabi_placed_layout= layout; gnuabi_placed_location= GNUABI_Register_argument (gnuabi_register_pieces layout state classes) |>,
+          <| state with gnuabi_gp_used= state.gnuabi_gp_used+gp; gnuabi_fp_used= state.gnuabi_fp_used+fp |>)
+  end
+
+val gnuabi_place_types: gnuabi_tag_definitions -> gnuabi_layout_oracle -> gnuabi_placement_state -> list Ctype.ctype ->
+  either string (list gnuabi_placed_argument * gnuabi_placement_state)
+let gnuabi_place_types tags oracle initial types =
+  let place_next accumulated ty =
+    accumulated >>= fun (reversed, state) ->
+    gnuabi_classify tags oracle ty >>= fun layout ->
+    let (argument, next) = gnuabi_place layout state in
+    Right (argument :: reversed, next) in
+  List.foldl place_next (Right ([], initial)) types >>= fun (reversed, state) ->
+  Right (List.reverse reversed, state)
+
+val gnuabi_plan_frame: gnuabi_tag_definitions -> gnuabi_layout_oracle -> Ctype.ctype -> list Ctype.ctype ->
+  list Ctype.ctype -> either string gnuabi_frame_layout
+let gnuabi_plan_frame tags oracle return_ty named_types promoted_anonymous_types =
+  let hidden = match return_ty with
+    | Ctype.Ctype _ Ctype.Void -> Right false
+    | _ -> gnuabi_classify tags oracle return_ty >>= fun layout ->
+        Right (layout.gnuabi_argument_classes = Nothing)
+  end in
+  hidden >>= fun hidden_result ->
+  let initial = <| gnuabi_gp_used= if hidden_result then 1 else 0;
+    gnuabi_fp_used= 0; gnuabi_stack_used= 0 |> in
+  gnuabi_place_types tags oracle initial named_types >>= fun (named, after_named) ->
+  gnuabi_place_types tags oracle after_named promoted_anonymous_types >>= fun (anonymous, after_anonymous) ->
+  Right <| gnuabi_named_arguments= named; gnuabi_anonymous_arguments= anonymous;
+    gnuabi_initial_gp_offset= after_named.gnuabi_gp_used * 8;
+    gnuabi_initial_fp_offset= 48 + after_named.gnuabi_fp_used * 16;
+    gnuabi_initial_overflow_offset= after_named.gnuabi_stack_used;
+    gnuabi_overflow_size= after_anonymous.gnuabi_stack_used;
+    gnuabi_register_save_size= 176;
+    gnuabi_has_hidden_result_pointer= hidden_result |>
diff --git a/frontend/model/gnu_amd64_varargs_runtime.lem b/frontend/model/gnu_amd64_varargs_runtime.lem
new file mode 100644
index 00000000..63b56921
--- /dev/null
+++ b/frontend/model/gnu_amd64_varargs_runtime.lem
@@ -0,0 +1,737 @@
+(* GNU AMD64 physical variadic runtime.
+
+   The canonical record tag and field identifiers come from the C frontend.
+   All reads, writes, copies and deallocations go through Mem. The ledger tracks
+   invocation ownership, borrowing and C lifetime/type obligations; it does not
+   supply replacement argument bytes or an integer-only va_list cursor.
+
+   The driver supplies call and scope tokens and preserves the returned memory
+   footprints. Each variadic invocation owns one shared register/stack frame;
+   va_start and va_copy create cursors over that backing. Scope exit releases it.
+
+   Physical fields remain authoritative for every read. Direct field mutations
+   that disagree with the tracked ABI position are explicitly refused. This
+   boundary must not be reported as complete GNU ABI support.
+*)
+open import Pervasives Utils
+import Map Ctype Ctype_aux Symbol Loc Undefined Mem Mem_aux Implementation Global
+import Gnu_amd64_varargs
+
+module Plan = Gnu_amd64_varargs
+
+type gnuva_abi_error =
+  | GNUVA_Refused of string
+  | GNUVA_Undefined_result of Undefined.undefined_behaviour
+
+type gnuva_scope_id = integer
+type gnuva_pointer_key = maybe integer * integer
+
+type gnuva_record_shape = <|
+  gnuva_record_tag: Symbol.sym;
+  gnuva_gp_field: Symbol.identifier;
+  gnuva_fp_field: Symbol.identifier;
+  gnuva_overflow_field: Symbol.identifier;
+  gnuva_reg_save_field: Symbol.identifier;
+|>
+
+type gnuva_physical_cursor = <|
+  gnuva_gp_offset: integer;
+  gnuva_fp_offset: integer;
+  gnuva_overflow_arg_area: Mem.pointer_value;
+  gnuva_reg_save_area: Mem.pointer_value;
+|>
+
+(* Only the storage selected by the ABI algorithm is read. In particular an
+   INTEGER va_arg using a GP slot must not read gnuva_fp_offset or gnuva_overflow_arg_area:
+   user code can access those other record fields without an unsequenced race. *)
+type gnuva_argument_storage =
+  | GNUVA_Argument_register of Mem.pointer_value
+  | GNUVA_Argument_stack of Mem.pointer_value
+  | GNUVA_Argument_empty
+
+type gnuva_frame = <|
+  gnuva_owner_scope: gnuva_scope_id;
+  gnuva_frame_plan: Plan.gnuabi_frame_layout;
+  gnuva_register_storage: Mem.pointer_value;
+  gnuva_overflow_storage: Mem.pointer_value;
+|>
+
+type gnuva_cursor = <|
+  gnuva_cursor_key: gnuva_pointer_key;
+  gnuva_cursor_tag: Symbol.sym;
+  gnuva_cursor_owner: gnuva_scope_id;
+  gnuva_frame_owner: gnuva_scope_id;
+  gnuva_pending_arguments: list Plan.gnuabi_placed_argument;
+  gnuva_expected_position: Plan.gnuabi_placement_state;
+  gnuva_active: bool;
+  gnuva_indeterminate: bool;
+|>
+
+type gnuva_borrow_kind = GNUVA_Borrow_value | GNUVA_Borrow_reference | GNUVA_Borrow_unknown
+type gnuva_call_borrow = <|
+  gnuva_borrow_call: integer;
+  gnuva_borrow_key: gnuva_pointer_key;
+  gnuva_borrow_kind: gnuva_borrow_kind;
+  gnuva_borrow_consumed: bool;
+|>
+
+type gnuva_call_parameter = <|
+  gnuva_parameter_call: integer;
+  gnuva_parameter_key: gnuva_pointer_key;
+  gnuva_parameter_type: Ctype.ctype;
+|>
+
+type gnuva_runtime_state = <|
+  gnuva_next_scope: gnuva_scope_id;
+  gnuva_next_call: integer;
+  gnuva_active_scopes: list gnuva_scope_id;
+  gnuva_active_calls: list integer;
+  gnuva_call_borrows: list gnuva_call_borrow;
+  gnuva_call_parameters: list gnuva_call_parameter;
+  gnuva_frames: list gnuva_frame;
+  gnuva_cursors: list gnuva_cursor;
+  gnuva_temporary_objects: list (gnuva_scope_id * Mem.pointer_value);
+|>
+
+let gnuva_initial_state = <| gnuva_next_scope= 0; gnuva_next_call= 0; gnuva_active_scopes= [];
+  gnuva_active_calls= []; gnuva_call_borrows= []; gnuva_call_parameters= []; gnuva_frames= []; gnuva_cursors= []; gnuva_temporary_objects= [] |>
+
+(* Exhaustive exploration must retain ledger differences. Pointer comparison
+   here is only for freshly allocated owned storage (validated by gnuva_key_of before
+   insertion); it does not execute C pointer equality or compare user pointers.
+   The allocation identity distinguishes reuse of the same numeric address. *)
+val gnuva_storage_identity: Mem.pointer_value -> maybe gnuva_pointer_key
+let gnuva_storage_identity pointer = Mem.case_ptrval pointer
+  (fun _ -> Nothing) (fun _ -> Nothing)
+  (fun allocation address -> match allocation with
+    | Nothing -> Nothing
+    | Just _ -> Just (allocation, address)
+  end)
+
+let gnuva_same_storage left right = match (gnuva_storage_identity left, gnuva_storage_identity right) with
+  | (Just a, Just b) -> a = b
+  | _ -> false
+end
+
+val gnuva_same_list: forall 'a. ('a -> 'a -> bool) -> list 'a -> list 'a -> bool
+let rec gnuva_same_list equal left right = match (left, right) with
+  | ([], []) -> true
+  | (a :: rest_a, b :: rest_b) -> equal a b && gnuva_same_list equal rest_a rest_b
+  | _ -> false
+end
+
+val gnuva_same_argument_layout: Plan.gnuabi_argument_layout -> Plan.gnuabi_argument_layout -> bool
+let gnuva_same_argument_layout a b =
+  a.Plan.gnuabi_argument_type = b.Plan.gnuabi_argument_type && a.Plan.gnuabi_argument_size = b.Plan.gnuabi_argument_size &&
+  a.Plan.gnuabi_argument_alignment = b.Plan.gnuabi_argument_alignment && a.Plan.gnuabi_argument_classes = b.Plan.gnuabi_argument_classes
+
+val gnuva_same_piece: Plan.gnuabi_copy_piece -> Plan.gnuabi_copy_piece -> bool
+let gnuva_same_piece a b = a.Plan.gnuabi_source_offset = b.Plan.gnuabi_source_offset &&
+  a.Plan.gnuabi_save_offset = b.Plan.gnuabi_save_offset && a.Plan.gnuabi_copy_size = b.Plan.gnuabi_copy_size
+
+val gnuva_same_location: Plan.gnuabi_argument_location -> Plan.gnuabi_argument_location -> bool
+let gnuva_same_location a b = match (a, b) with
+  | (Plan.GNUABI_Stack_argument x, Plan.GNUABI_Stack_argument y) -> x = y
+  | (Plan.GNUABI_Register_argument x, Plan.GNUABI_Register_argument y) -> gnuva_same_list gnuva_same_piece x y
+  | _ -> false
+end
+
+val gnuva_same_placed_argument: Plan.gnuabi_placed_argument -> Plan.gnuabi_placed_argument -> bool
+let gnuva_same_placed_argument a b = gnuva_same_argument_layout a.Plan.gnuabi_placed_layout b.Plan.gnuabi_placed_layout &&
+  gnuva_same_location a.Plan.gnuabi_placed_location b.Plan.gnuabi_placed_location
+
+val gnuva_same_position: Plan.gnuabi_placement_state -> Plan.gnuabi_placement_state -> bool
+let gnuva_same_position a b = a.Plan.gnuabi_gp_used = b.Plan.gnuabi_gp_used && a.Plan.gnuabi_fp_used = b.Plan.gnuabi_fp_used &&
+  a.Plan.gnuabi_stack_used = b.Plan.gnuabi_stack_used
+
+val gnuva_same_plan: Plan.gnuabi_frame_layout -> Plan.gnuabi_frame_layout -> bool
+let gnuva_same_plan a b =
+  gnuva_same_list gnuva_same_placed_argument a.Plan.gnuabi_named_arguments b.Plan.gnuabi_named_arguments &&
+  gnuva_same_list gnuva_same_placed_argument a.Plan.gnuabi_anonymous_arguments b.Plan.gnuabi_anonymous_arguments &&
+  a.Plan.gnuabi_initial_gp_offset = b.Plan.gnuabi_initial_gp_offset && a.Plan.gnuabi_initial_fp_offset = b.Plan.gnuabi_initial_fp_offset &&
+  a.Plan.gnuabi_initial_overflow_offset = b.Plan.gnuabi_initial_overflow_offset && a.Plan.gnuabi_overflow_size = b.Plan.gnuabi_overflow_size &&
+  a.Plan.gnuabi_register_save_size = b.Plan.gnuabi_register_save_size &&
+  a.Plan.gnuabi_has_hidden_result_pointer = b.Plan.gnuabi_has_hidden_result_pointer
+
+val gnuva_same_frame: gnuva_frame -> gnuva_frame -> bool
+let gnuva_same_frame a b = a.gnuva_owner_scope = b.gnuva_owner_scope && gnuva_same_plan a.gnuva_frame_plan b.gnuva_frame_plan &&
+  gnuva_same_storage a.gnuva_register_storage b.gnuva_register_storage && gnuva_same_storage a.gnuva_overflow_storage b.gnuva_overflow_storage
+
+val gnuva_same_cursor: gnuva_cursor -> gnuva_cursor -> bool
+let gnuva_same_cursor a b = a.gnuva_cursor_key = b.gnuva_cursor_key && a.gnuva_cursor_owner = b.gnuva_cursor_owner &&
+  a.gnuva_cursor_tag = b.gnuva_cursor_tag && a.gnuva_frame_owner = b.gnuva_frame_owner && a.gnuva_active = b.gnuva_active &&
+  a.gnuva_indeterminate = b.gnuva_indeterminate &&
+  gnuva_same_position a.gnuva_expected_position b.gnuva_expected_position &&
+  gnuva_same_list gnuva_same_placed_argument a.gnuva_pending_arguments b.gnuva_pending_arguments
+
+val gnuva_same_borrow_kind: gnuva_borrow_kind -> gnuva_borrow_kind -> bool
+let gnuva_same_borrow_kind a b = match (a, b) with
+  | (GNUVA_Borrow_value, GNUVA_Borrow_value) -> true
+  | (GNUVA_Borrow_reference, GNUVA_Borrow_reference) -> true
+  | (GNUVA_Borrow_unknown, GNUVA_Borrow_unknown) -> true
+  | _ -> false
+end
+
+val gnuva_same_call_borrow: gnuva_call_borrow -> gnuva_call_borrow -> bool
+let gnuva_same_call_borrow a b = a.gnuva_borrow_call = b.gnuva_borrow_call &&
+  a.gnuva_borrow_key = b.gnuva_borrow_key && gnuva_same_borrow_kind a.gnuva_borrow_kind b.gnuva_borrow_kind &&
+  a.gnuva_borrow_consumed = b.gnuva_borrow_consumed
+
+val gnuva_same_call_parameter: gnuva_call_parameter -> gnuva_call_parameter -> bool
+let gnuva_same_call_parameter a b = a.gnuva_parameter_call = b.gnuva_parameter_call &&
+  a.gnuva_parameter_key = b.gnuva_parameter_key && a.gnuva_parameter_type = b.gnuva_parameter_type
+
+val gnuva_runtime_state_eq: gnuva_runtime_state -> gnuva_runtime_state -> bool
+let gnuva_runtime_state_eq a b = a.gnuva_next_scope = b.gnuva_next_scope && a.gnuva_active_scopes = b.gnuva_active_scopes &&
+  a.gnuva_next_call = b.gnuva_next_call && a.gnuva_active_calls = b.gnuva_active_calls &&
+  gnuva_same_list gnuva_same_call_borrow a.gnuva_call_borrows b.gnuva_call_borrows &&
+  gnuva_same_list gnuva_same_call_parameter a.gnuva_call_parameters b.gnuva_call_parameters &&
+  gnuva_same_list gnuva_same_frame a.gnuva_frames b.gnuva_frames && gnuva_same_list gnuva_same_cursor a.gnuva_cursors b.gnuva_cursors &&
+  gnuva_same_list (fun (owner_a, pointer_a) (owner_b, pointer_b) ->
+    owner_a = owner_b && gnuva_same_storage pointer_a pointer_b) a.gnuva_temporary_objects b.gnuva_temporary_objects
+
+(* State transformer over the existing concrete memory monad. The same Lem
+   body is intended to generate both execution implementations. *)
+type gnuva_runtimeM 'a = gnuva_runtime_state -> Mem.memM (either gnuva_abi_error (('a * list Mem.footprint) * gnuva_runtime_state))
+
+val gnuva_return: forall 'a. 'a -> gnuva_runtimeM 'a
+let gnuva_return value state = Mem.return (Right ((value, []), state))
+
+val gnuva_fail: forall 'a. gnuva_abi_error -> gnuva_runtimeM 'a
+let gnuva_fail cause _ = Mem.return (Left cause)
+
+val gnuva_bind: forall 'a 'b. gnuva_runtimeM 'a -> ('a -> gnuva_runtimeM 'b) -> gnuva_runtimeM 'b
+let gnuva_bind action next state = Mem.bind (action state) (function
+  | Left cause -> Mem.return (Left cause)
+  | Right ((value, first_footprints), after) ->
+      Mem.bind (next value after) (function
+        | Left cause -> Mem.return (Left cause)
+        | Right ((result, next_footprints), final_state) ->
+            Mem.return (Right ((result, first_footprints ++ next_footprints), final_state))
+      end)
+end)
+
+let inline (>>=) = gnuva_bind
+let inline (>>) first second = gnuva_bind first (fun _ -> second)
+
+(* Planner failures are explicit runtime refusals, never replacement layouts. *)
+val gnuva_from_plan: forall 'a. either string 'a -> gnuva_runtimeM 'a
+let gnuva_from_plan result = match result with
+  | Left message -> gnuva_fail (GNUVA_Refused message)
+  | Right value -> gnuva_return value
+end
+
+val gnuva_lift: forall 'a. Mem.memM 'a -> gnuva_runtimeM 'a
+let gnuva_lift action state = Mem.bind action (fun value -> Mem.return (Right ((value, []), state)))
+
+(* These are the footprints actually returned by the checked memory accesses,
+   not synthetic broad ranges or a shadow race detector. The driver attaches
+   them with the same Eannot/DA_pos path used by ordinary Core actions. *)
+val gnuva_lift_access: forall 'a. Mem.memM ('a * list Mem.footprint) -> gnuva_runtimeM 'a
+let gnuva_lift_access action state = Mem.bind action (fun result -> Mem.return (Right (result, state)))
+
+let gnuva_load_value loc ty pointer = gnuva_lift_access
+  (Mem.bind (Mem.load loc ty pointer) (fun (footprint, value) -> Mem.return (value, [footprint])))
+
+let gnuva_store_value loc ty pointer value = gnuva_lift_access
+  (Mem.bind (Mem.store loc ty false pointer value) (fun footprint -> Mem.return ((), [footprint])))
+
+let gnuva_get state = Mem.return (Right ((state, []), state))
+let gnuva_put state _ = Mem.return (Right (((), []), state))
+
+let gnuva_require_scope scope = gnuva_get >>= fun state ->
+  if List.elem scope state.gnuva_active_scopes then gnuva_return ()
+  else gnuva_fail (GNUVA_Refused "GNU variadic ABI operation used an inactive invocation token")
+
+val gnuva_each: forall 'a. ('a -> gnuva_runtimeM unit) -> list 'a -> gnuva_runtimeM unit
+let rec gnuva_each action items = match items with
+  | [] -> gnuva_return ()
+  | first :: rest -> action first >> gnuva_each action rest
+end
+
+val gnuva_first_matching: forall 'a. ('a -> bool) -> list 'a -> maybe 'a
+let rec gnuva_first_matching predicate items = match items with
+  | [] -> Nothing
+  | first :: rest -> if predicate first then Just first else gnuva_first_matching predicate rest
+end
+
+(* No pointer-to-integer C conversion is evaluated for bookkeeping. A pointer
+   without a concrete allocation identity is explicitly unsupported here. *)
+val gnuva_key_of: Mem.pointer_value -> gnuva_runtimeM gnuva_pointer_key
+let gnuva_key_of pointer = Mem.case_ptrval pointer
+  (fun _ -> gnuva_fail (GNUVA_Undefined_result Undefined.UB136))
+  (fun _ -> gnuva_fail (GNUVA_Undefined_result Undefined.UB136))
+  (fun allocation address -> match allocation with
+    | Nothing -> gnuva_fail (GNUVA_Refused "GNU variadic ABI pointer has no concrete allocation identity")
+    | Just _ -> gnuva_return (allocation, address)
+  end)
+
+let gnuva_find_frame owner = gnuva_get >>= fun state ->
+  match gnuva_first_matching (fun item -> item.gnuva_owner_scope = owner) state.gnuva_frames with
+    | Nothing -> gnuva_fail (GNUVA_Undefined_result Undefined.UB136)
+    | Just item -> gnuva_return item
+  end
+
+let gnuva_find_cursor pointer = gnuva_key_of pointer >>= fun key -> gnuva_get >>= fun state ->
+  match gnuva_first_matching (fun item -> item.gnuva_cursor_key = key) state.gnuva_cursors with
+    | Just item -> if not item.gnuva_active then gnuva_fail (GNUVA_Undefined_result Undefined.UB136)
+        else if item.gnuva_indeterminate then gnuva_fail (GNUVA_Undefined_result Undefined.UB137)
+        else gnuva_return item
+    | Nothing -> gnuva_fail (GNUVA_Undefined_result Undefined.UB136)
+  end
+
+let gnuva_install_cursor gnuva_cursor = gnuva_get >>= fun state ->
+  gnuva_put <| state with gnuva_cursors= gnuva_cursor :: List.filter (fun item -> item.gnuva_cursor_key <> gnuva_cursor.gnuva_cursor_key) state.gnuva_cursors |>
+
+(* The call boundary sees the already evaluated argument value and its source
+   type. It does not load a parameter again or replay an argument expression.
+   A pointer to the array is the 7.16 footnote exception; array-adjusted pointers
+   to the record pass the list by value. Erased origins are retained as unknown
+   and are refused only if that call actually consumes the corresponding list. *)
+let gnuva_borrow_kind_of tags tag (Ctype.Ctype _ ty) =
+  let compatible actual = Ctype_aux.are_compatible_aux (tags, tags, [])
+    (Ctype.no_qualifiers, Ctype.Ctype [] (Ctype.Struct actual))
+    (Ctype.no_qualifiers, Ctype.Ctype [] (Ctype.Struct tag)) in
+  match ty with
+  | Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Struct actual)) ->
+      if compatible actual then GNUVA_Borrow_value else GNUVA_Borrow_unknown
+  | Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Array (Ctype.Ctype _ (Ctype.Struct actual)) (Just bound))) ->
+      if bound = 1 && compatible actual then GNUVA_Borrow_reference else GNUVA_Borrow_unknown
+  | _ -> GNUVA_Borrow_unknown
+end
+
+(* Collect against the entry snapshot. The right fold preserves the existing
+   last-argument-first validation and source order in the resulting ledger. *)
+val gnuva_collect_borrows: Plan.gnuabi_tag_definitions -> integer -> list gnuva_cursor ->
+  list (Ctype.ctype * Mem.pointer_value) -> gnuva_runtimeM (list gnuva_call_borrow)
+let gnuva_collect_borrows tags call cursors arguments =
+  let collect (ty, pointer) following = following >>= fun borrowed ->
+    match gnuva_storage_identity pointer with
+      | Nothing -> gnuva_return borrowed
+      | Just key ->
+          match gnuva_first_matching (fun cursor ->
+              cursor.gnuva_cursor_key = key && cursor.gnuva_active) cursors with
+            | Nothing -> gnuva_return borrowed
+            | Just cursor ->
+                if cursor.gnuva_indeterminate then gnuva_fail (GNUVA_Undefined_result Undefined.UB137) else
+                gnuva_return (<| gnuva_borrow_call= call; gnuva_borrow_key= key;
+                  gnuva_borrow_kind= gnuva_borrow_kind_of tags cursor.gnuva_cursor_tag ty;
+                  gnuva_borrow_consumed= false |> :: borrowed)
+          end
+    end in
+  List.foldr collect (gnuva_return []) arguments
+
+let gnuva_enter_call tags arguments parameters = gnuva_get >>= fun state ->
+  let call = state.gnuva_next_call in
+  gnuva_collect_borrows tags call state.gnuva_cursors arguments >>= fun borrowed ->
+  let identify_parameter (ty, pointer) = match gnuva_storage_identity pointer with
+    | Nothing -> Nothing
+    | Just key -> Just <| gnuva_parameter_call= call; gnuva_parameter_key= key; gnuva_parameter_type= ty |>
+  end in
+  match Utils.maybe_mapM identify_parameter parameters with
+    | Nothing -> gnuva_fail (GNUVA_Refused "GNU C call parameter object lacks its allocation identity")
+    | Just identified ->
+        gnuva_put <| state with gnuva_next_call= call + 1; gnuva_active_calls= call :: state.gnuva_active_calls;
+          gnuva_call_parameters= identified ++ state.gnuva_call_parameters;
+          gnuva_call_borrows= borrowed ++ state.gnuva_call_borrows |> >> gnuva_return call
+  end
+
+let gnuva_consume_borrow owner gnuva_cursor = gnuva_get >>= fun state ->
+  let key = gnuva_cursor.gnuva_cursor_key in
+  if gnuva_cursor.gnuva_cursor_owner <> owner && not (List.any (fun item -> item.gnuva_borrow_key = key) state.gnuva_call_borrows) then
+    gnuva_fail (GNUVA_Refused "GNU va_list consumption outside its owner needs a tracked typed call boundary")
+  else if List.any (fun item -> item.gnuva_borrow_key = key && gnuva_same_borrow_kind item.gnuva_borrow_kind GNUVA_Borrow_unknown) state.gnuva_call_borrows then
+    gnuva_fail (GNUVA_Refused "consuming a borrowed GNU va_list after its pointer origin was erased is not yet implemented")
+  else gnuva_put <| state with gnuva_call_borrows= List.map (fun item ->
+    if item.gnuva_borrow_key = key then <| item with gnuva_borrow_consumed= true |> else item) state.gnuva_call_borrows |>
+
+let gnuva_leave_call call = gnuva_get >>= fun state ->
+  if not (List.elem call state.gnuva_active_calls) then gnuva_fail (GNUVA_Refused "GNU variadic call token is not gnuva_active") else
+  let invalidated key = List.any (fun item -> item.gnuva_borrow_call = call && item.gnuva_borrow_key = key &&
+    gnuva_same_borrow_kind item.gnuva_borrow_kind GNUVA_Borrow_value && item.gnuva_borrow_consumed) state.gnuva_call_borrows in
+  gnuva_put <| state with gnuva_active_calls= List.filter (fun other -> other <> call) state.gnuva_active_calls;
+    gnuva_call_parameters= List.filter (fun item -> item.gnuva_parameter_call <> call) state.gnuva_call_parameters;
+    gnuva_call_borrows= List.filter (fun item -> item.gnuva_borrow_call <> call) state.gnuva_call_borrows;
+    gnuva_cursors= List.map (fun gnuva_cursor -> if invalidated gnuva_cursor.gnuva_cursor_key then
+      <| gnuva_cursor with gnuva_indeterminate= true |> else gnuva_cursor) state.gnuva_cursors |>
+
+(* Library proxies load the exact CType of the already-created C parameter
+   object. Registration is metadata-only and never re-evaluates its source. *)
+let gnuva_load_call_parameter loc pointer = gnuva_key_of pointer >>= fun key -> gnuva_get >>= fun state ->
+  match gnuva_first_matching (fun parameter -> parameter.gnuva_parameter_key = key) state.gnuva_call_parameters with
+    | Nothing -> gnuva_fail (GNUVA_Refused "physical GNU library adapter requires precise C parameter type metadata")
+    | Just parameter -> gnuva_load_value loc parameter.gnuva_parameter_type pointer >>= fun value ->
+        gnuva_return (parameter.gnuva_parameter_type, value)
+  end
+
+(* Indeterminacy is a C lifetime obligation, not an overwrite of the ABI bytes.
+   Ordinary reads/writes and representation operations must check it too.
+   Pointer arithmetic/address-taking alone remains available to implement
+   va_end; that builtin deliberately does not call this access check. *)
+let gnuva_check_access pointer amount = gnuva_get >>= fun state ->
+  Mem.case_ptrval pointer
+    (fun _ -> gnuva_return ()) (fun _ -> gnuva_return ())
+    (fun allocation address ->
+        let overlaps gnuva_cursor =
+          let (cursor_allocation, cursor_address) = gnuva_cursor.gnuva_cursor_key in
+          amount > 0 && gnuva_cursor.gnuva_active && gnuva_cursor.gnuva_indeterminate &&
+          address < cursor_address + 24 && cursor_address < address + amount &&
+          (allocation = Nothing || allocation = cursor_allocation) in
+        if not (List.any overlaps state.gnuva_cursors) then gnuva_return ()
+        else if allocation = Nothing then
+          gnuva_fail (GNUVA_Refused "GNU va_list access with erased allocation identity may overlap an gnuva_indeterminate record")
+        else gnuva_fail (GNUVA_Undefined_result Undefined.UB137))
+
+let gnuva_ensure_not_active key = gnuva_get >>= fun state ->
+  if List.any (fun item -> item.gnuva_cursor_key = key && item.gnuva_active) state.gnuva_cursors then
+    gnuva_fail (GNUVA_Undefined_result Undefined.UB142)
+  else gnuva_return ()
+
+let gnuva_byte_pointer loc base offset =
+  gnuva_lift (Mem.eff_array_shift_ptrval loc base Ctype.unsigned_char (Mem.integer_ival offset))
+
+let gnuva_field_pointer loc shape base field_ident =
+  gnuva_lift (Mem.eff_member_shift_ptrval loc base shape.gnuva_record_tag field_ident)
+
+let gnuva_read_field loc shape base field_ident ty =
+  gnuva_field_pointer loc shape base field_ident >>= fun pointer ->
+  gnuva_load_value loc ty pointer
+
+let gnuva_write_field loc shape base field_ident ty value =
+  gnuva_field_pointer loc shape base field_ident >>= fun pointer ->
+  gnuva_store_value loc ty pointer value
+
+let gnuva_void_pointer_type = Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers Ctype.void)
+
+let gnuva_concrete_integer value = match Mem_aux.integerValueFromMemValue value with
+  | Just (_, integer_value) -> match Mem_aux.integerFromIntegerValue integer_value with
+      | Just number -> gnuva_return number
+      | Nothing -> gnuva_fail (GNUVA_Refused "GNU variadic ABI symbolic gnuva_cursor integer is not yet implemented")
+    end
+  | Nothing -> if Mem_aux.isUnspecifiedMemValue value then
+      gnuva_fail (GNUVA_Undefined_result Undefined.UB011_use_indeterminate_automatic_object)
+    else gnuva_fail (GNUVA_Refused "GNU variadic ABI gnuva_cursor field is not an integer")
+end
+
+let gnuva_concrete_pointer value = match Mem_aux.pointerValueFromMemValue value with
+  | Just (_, pointer) -> gnuva_return pointer
+  | Nothing -> if Mem_aux.isUnspecifiedMemValue value then
+      gnuva_fail (GNUVA_Undefined_result Undefined.UB011_use_indeterminate_automatic_object)
+    else gnuva_fail (GNUVA_Refused "GNU variadic ABI gnuva_cursor field is not a pointer")
+end
+
+let gnuva_read_cursor loc shape ap =
+  gnuva_read_field loc shape ap shape.gnuva_gp_field Ctype.unsigned_int >>= gnuva_concrete_integer >>= fun gp ->
+  gnuva_read_field loc shape ap shape.gnuva_fp_field Ctype.unsigned_int >>= gnuva_concrete_integer >>= fun fp ->
+  gnuva_read_field loc shape ap shape.gnuva_overflow_field gnuva_void_pointer_type >>= gnuva_concrete_pointer >>= fun overflow ->
+  gnuva_read_field loc shape ap shape.gnuva_reg_save_field gnuva_void_pointer_type >>= gnuva_concrete_pointer >>= fun reg_save ->
+  gnuva_return <| gnuva_gp_offset= gp; gnuva_fp_offset= fp; gnuva_overflow_arg_area= overflow; gnuva_reg_save_area= reg_save |>
+
+let gnuva_write_cursor loc shape ap physical =
+  gnuva_write_field loc shape ap shape.gnuva_gp_field Ctype.unsigned_int
+    (Mem_aux.integer_mval (Ctype.Unsigned Ctype.Int_) physical.gnuva_gp_offset) >>
+  gnuva_write_field loc shape ap shape.gnuva_fp_field Ctype.unsigned_int
+    (Mem_aux.integer_mval (Ctype.Unsigned Ctype.Int_) physical.gnuva_fp_offset) >>
+  gnuva_write_field loc shape ap shape.gnuva_overflow_field gnuva_void_pointer_type
+    (Mem.pointer_mval Ctype.void physical.gnuva_overflow_arg_area) >>
+  gnuva_write_field loc shape ap shape.gnuva_reg_save_field gnuva_void_pointer_type
+    (Mem.pointer_mval Ctype.void physical.gnuva_reg_save_area)
+
+(* Ledger checks may reject a language-lifetime/type violation, but never
+   substitute a stale ledger pointer or byte value for the physical record. *)
+let gnuva_checked_cursor loc shape ap =
+  gnuva_find_cursor ap >>= fun gnuva_cursor -> gnuva_find_frame gnuva_cursor.gnuva_frame_owner >>= fun gnuva_frame ->
+  gnuva_read_cursor loc shape ap >>= fun physical ->
+  gnuva_byte_pointer loc gnuva_frame.gnuva_overflow_storage gnuva_cursor.gnuva_expected_position.Plan.gnuabi_stack_used >>= fun expected_overflow ->
+  gnuva_lift (Mem.eq_ptrval loc physical.gnuva_reg_save_area gnuva_frame.gnuva_register_storage) >>= fun same_registers ->
+  gnuva_lift (Mem.eq_ptrval loc physical.gnuva_overflow_arg_area expected_overflow) >>= fun same_overflow ->
+  if physical.gnuva_gp_offset <> gnuva_cursor.gnuva_expected_position.Plan.gnuabi_gp_used * 8 ||
+     physical.gnuva_fp_offset <> 48 + gnuva_cursor.gnuva_expected_position.Plan.gnuabi_fp_used * 16 ||
+     not same_registers || not same_overflow then
+    gnuva_fail (GNUVA_Refused "GNU variadic ABI manually changed gnuva_cursor fields are not yet implemented")
+  else gnuva_return (gnuva_cursor, gnuva_frame, physical)
+
+let gnuva_read_argument_storage loc shape ap gnuva_cursor gnuva_frame layout =
+  let changed = GNUVA_Refused "GNU variadic ABI manually changed gnuva_cursor fields are not yet implemented" in
+  let stack () =
+    gnuva_read_field loc shape ap shape.gnuva_overflow_field gnuva_void_pointer_type >>= gnuva_concrete_pointer >>= fun pointer ->
+    gnuva_byte_pointer loc gnuva_frame.gnuva_overflow_storage gnuva_cursor.gnuva_expected_position.Plan.gnuabi_stack_used >>= fun expected ->
+    gnuva_lift (Mem.eq_ptrval loc pointer expected) >>= fun equal ->
+    if equal then gnuva_return (GNUVA_Argument_stack pointer) else gnuva_fail changed
+  in
+  let registers () =
+    gnuva_read_field loc shape ap shape.gnuva_reg_save_field gnuva_void_pointer_type >>= gnuva_concrete_pointer >>= fun pointer ->
+    gnuva_lift (Mem.eq_ptrval loc pointer gnuva_frame.gnuva_register_storage) >>= fun equal ->
+    if equal then gnuva_return (GNUVA_Argument_register pointer) else gnuva_fail changed
+  in
+  if layout.Plan.gnuabi_argument_size = 0 then gnuva_return GNUVA_Argument_empty else
+  match layout.Plan.gnuabi_argument_classes with
+    | Nothing -> stack ()
+    | Just classes ->
+        if List.any (fun cls -> List.elem cls [Plan.GNUABI_X87_class; Plan.GNUABI_X87_up_class; Plan.GNUABI_Memory_class]) classes then
+          stack ()
+        else
+          let (gp, fp) = Plan.gnuabi_register_need classes in
+          (* The register tests are short-circuiting: when GP space is already
+             exhausted, the FP cursor is irrelevant to this argument. *)
+          (if gp = 0 then gnuva_return true else
+            gnuva_read_field loc shape ap shape.gnuva_gp_field Ctype.unsigned_int >>= gnuva_concrete_integer >>= fun offset ->
+            if offset <> gnuva_cursor.gnuva_expected_position.Plan.gnuabi_gp_used * 8 then gnuva_fail changed else
+            gnuva_return (offset <= 48 - gp * 8)) >>= fun gp_available ->
+          if not gp_available then stack () else
+          (if fp = 0 then gnuva_return true else
+            gnuva_read_field loc shape ap shape.gnuva_fp_field Ctype.unsigned_int >>= gnuva_concrete_integer >>= fun offset ->
+            if offset <> 48 + gnuva_cursor.gnuva_expected_position.Plan.gnuabi_fp_used * 16 then gnuva_fail changed else
+            gnuva_return (offset <= 176 - fp * 16)) >>= fun fp_available ->
+          if fp_available then registers () else stack ()
+  end
+
+(* Change only the fields the selected ABI path consumes; no rewrites of an
+   unchanged field and no reads of unrelated record members. *)
+let gnuva_advance_argument_cursor loc shape ap before after storage = match storage with
+  | GNUVA_Argument_empty -> gnuva_return ()
+  | GNUVA_Argument_register _ ->
+      (if before.Plan.gnuabi_gp_used = after.Plan.gnuabi_gp_used then gnuva_return () else
+        gnuva_write_field loc shape ap shape.gnuva_gp_field Ctype.unsigned_int
+          (Mem_aux.integer_mval (Ctype.Unsigned Ctype.Int_) (after.Plan.gnuabi_gp_used * 8))) >>
+      (if before.Plan.gnuabi_fp_used = after.Plan.gnuabi_fp_used then gnuva_return () else
+        gnuva_write_field loc shape ap shape.gnuva_fp_field Ctype.unsigned_int
+          (Mem_aux.integer_mval (Ctype.Unsigned Ctype.Int_) (48 + after.Plan.gnuabi_fp_used * 16)))
+  | GNUVA_Argument_stack pointer ->
+      gnuva_byte_pointer loc pointer (after.Plan.gnuabi_stack_used - before.Plan.gnuabi_stack_used) >>= fun next_pointer ->
+      gnuva_write_field loc shape ap shape.gnuva_overflow_field gnuva_void_pointer_type
+        (Mem.pointer_mval Ctype.void next_pointer)
+end
+
+let gnuva_enter_scope () = gnuva_get >>= fun state ->
+  gnuva_put <| state with gnuva_next_scope= state.gnuva_next_scope + 1;
+    gnuva_active_scopes= state.gnuva_next_scope :: state.gnuva_active_scopes |> >> gnuva_return state.gnuva_next_scope
+
+let gnuva_copy_bytes loc destination destination_offset source source_offset amount =
+  if amount = 0 then gnuva_return () else
+  gnuva_byte_pointer loc destination destination_offset >>= fun to_pointer ->
+  gnuva_byte_pointer loc source source_offset >>= fun from_pointer ->
+  gnuva_lift_access (Mem.memcpy_with_footprints loc to_pointer from_pointer (Mem.integer_ival amount)) >> gnuva_return ()
+
+(* Only actual anonymous payloads are copied into register-save slots. ABI
+   padding, unnamed register holes, and registers occupied by named arguments
+   are not initialized with fabricated bytes. *)
+let gnuva_populate_argument loc gnuva_register_storage gnuva_overflow_storage (placed, (_, source)) =
+  match placed.Plan.gnuabi_placed_location with
+    | Plan.GNUABI_Stack_argument offset ->
+        gnuva_copy_bytes loc gnuva_overflow_storage offset source 0 placed.Plan.gnuabi_placed_layout.Plan.gnuabi_argument_size
+    | Plan.GNUABI_Register_argument pieces ->
+        gnuva_each (fun piece -> gnuva_copy_bytes loc gnuva_register_storage piece.Plan.gnuabi_save_offset source
+          piece.Plan.gnuabi_source_offset piece.Plan.gnuabi_copy_size) pieces
+  end
+
+(* A new invocation allocates its backing once, then copies only the actual
+   anonymous arguments. Register-save holes and padding remain unspecified. *)
+let gnuva_allocate_frame loc tid scope plan anonymous_actuals =
+  let overflow_alignment = List.foldl (fun alignment placed -> match placed.Plan.gnuabi_placed_location with
+    | Plan.GNUABI_Stack_argument _ -> max alignment placed.Plan.gnuabi_placed_layout.Plan.gnuabi_argument_alignment
+    | Plan.GNUABI_Register_argument _ -> alignment
+  end) 16 (plan.Plan.gnuabi_named_arguments ++ plan.Plan.gnuabi_anonymous_arguments) in
+  (* These are automatic invocation objects. allocate_region would incorrectly
+     permit free(ap->reg_save_area); byte arrays retain the saved padding. *)
+  let allocate_bytes label alignment size =
+    gnuva_lift (Mem.allocate_object tid (Symbol.PrefOther label) (Mem.integer_ival alignment)
+      (Ctype.Ctype [] (Ctype.Array Ctype.unsigned_char (Just size))) Nothing Nothing) in
+  allocate_bytes "GNU variadic register save" 16 plan.Plan.gnuabi_register_save_size >>= fun registers ->
+  allocate_bytes "GNU variadic overflow" overflow_alignment plan.Plan.gnuabi_overflow_size >>= fun overflow ->
+  gnuva_key_of registers >> gnuva_key_of overflow >>
+  gnuva_each (gnuva_populate_argument loc registers overflow)
+    (List.zip plan.Plan.gnuabi_anonymous_arguments anonymous_actuals) >>
+  gnuva_get >>= fun current ->
+  let frame = <| gnuva_owner_scope= scope; gnuva_frame_plan= plan;
+    gnuva_register_storage= registers; gnuva_overflow_storage= overflow |> in
+  gnuva_put <| current with gnuva_frames= frame :: current.gnuva_frames |>
+
+let gnuva_create_frame loc tid tags oracle scope return_type named_types anonymous_actuals =
+  gnuva_require_scope scope >>
+  gnuva_get >>= fun state ->
+  gnuva_from_plan (Plan.gnuabi_plan_frame tags oracle return_type named_types (List.map fst anonymous_actuals)) >>= fun plan ->
+  match gnuva_first_matching (fun item -> item.gnuva_owner_scope = scope) state.gnuva_frames with
+    (* A subsequent va_start sees the original shared backing, including byte
+       writes made through another cursor. Never repopulate it. *)
+    | Just frame ->
+        if gnuva_same_plan frame.gnuva_frame_plan plan then gnuva_return () else
+        gnuva_fail (GNUVA_Refused "GNU variadic ABI invocation attempted to replace its gnuva_argument gnuva_frame")
+    | Nothing -> gnuva_allocate_frame loc tid scope plan anonymous_actuals
+  end
+
+let gnuva_start loc shape owner ap =
+  gnuva_require_scope owner >>
+  gnuva_key_of ap >>= fun key -> gnuva_ensure_not_active key >> gnuva_find_frame owner >>= fun gnuva_frame ->
+  let plan = gnuva_frame.gnuva_frame_plan in
+  gnuva_byte_pointer loc gnuva_frame.gnuva_overflow_storage plan.Plan.gnuabi_initial_overflow_offset >>= fun overflow ->
+  gnuva_write_cursor loc shape ap <| gnuva_gp_offset= plan.Plan.gnuabi_initial_gp_offset; gnuva_fp_offset= plan.Plan.gnuabi_initial_fp_offset;
+    gnuva_overflow_arg_area= overflow; gnuva_reg_save_area= gnuva_frame.gnuva_register_storage |> >>
+  gnuva_install_cursor <| gnuva_cursor_key= key; gnuva_cursor_tag= shape.gnuva_record_tag; gnuva_cursor_owner= owner; gnuva_frame_owner= owner;
+    gnuva_pending_arguments= plan.Plan.gnuabi_anonymous_arguments;
+    gnuva_expected_position= <| Plan.gnuabi_gp_used= plan.Plan.gnuabi_initial_gp_offset / 8;
+      Plan.gnuabi_fp_used= (plan.Plan.gnuabi_initial_fp_offset - 48) / 16;
+      Plan.gnuabi_stack_used= plan.Plan.gnuabi_initial_overflow_offset |>;
+    gnuva_active= true; gnuva_indeterminate= false |>
+
+let gnuva_copy loc shape owner destination source =
+  gnuva_require_scope owner >>
+  gnuva_key_of destination >>= fun destination_key -> gnuva_ensure_not_active destination_key >>
+  gnuva_checked_cursor loc shape source >>= fun (source_cursor, _, physical) ->
+  gnuva_write_cursor loc shape destination physical >>
+  gnuva_install_cursor <| source_cursor with gnuva_cursor_key= destination_key; gnuva_cursor_owner= owner |>
+
+let gnuva_end_cursor owner ap =
+  gnuva_require_scope owner >>
+  gnuva_key_of ap >>= fun key -> gnuva_get >>= fun state ->
+  match gnuva_first_matching (fun item -> item.gnuva_cursor_key = key) state.gnuva_cursors with
+    | Just gnuva_cursor ->
+        if not gnuva_cursor.gnuva_active || gnuva_cursor.gnuva_cursor_owner <> owner then
+          gnuva_fail (GNUVA_Undefined_result Undefined.UB139)
+        else gnuva_install_cursor <| gnuva_cursor with gnuva_active= false |>
+    | Nothing -> gnuva_fail (GNUVA_Undefined_result Undefined.UB139)
+  end
+
+let gnuva_remember_temporary owner pointer = gnuva_get >>= fun state ->
+  gnuva_put <| state with gnuva_temporary_objects= (owner, pointer) :: state.gnuva_temporary_objects |>
+
+(* Reconstruction copies the physical saved bytes through Mem.memcpy. Pointer
+   provenance and unspecified padding follow the memory model's byte-copy
+   rules. A __int128 or split aggregate is never read from a misaligned GP slot. *)
+let gnuva_materialize loc tid owner layout location old_position storage =
+  gnuva_lift (Mem.allocate_object tid (Symbol.PrefOther "GNU va_arg reconstructed value")
+    (Mem.integer_ival layout.Plan.gnuabi_argument_alignment) layout.Plan.gnuabi_argument_type Nothing Nothing) >>= fun destination ->
+  gnuva_key_of destination >>
+  gnuva_remember_temporary owner destination >>
+  match (location, storage) with
+    | (Plan.GNUABI_Register_argument [], GNUVA_Argument_empty) -> gnuva_return ()
+    | (Plan.GNUABI_Stack_argument offset, GNUVA_Argument_stack pointer) ->
+        gnuva_copy_bytes loc destination 0 pointer
+          (offset - old_position.Plan.gnuabi_stack_used) layout.Plan.gnuabi_argument_size
+    | (Plan.GNUABI_Register_argument pieces, GNUVA_Argument_register pointer) ->
+        gnuva_each (fun piece -> gnuva_copy_bytes loc destination piece.Plan.gnuabi_source_offset
+          pointer piece.Plan.gnuabi_save_offset piece.Plan.gnuabi_copy_size) pieces
+    | _ -> gnuva_fail (GNUVA_Refused "GNU variadic ABI physical storage disagrees with its gnuva_argument placement")
+  end >> gnuva_return destination
+
+let gnuva_void_or_character (Ctype.Ctype _ ty) = match ty with
+  | Ctype.Void -> true
+  | Ctype.Basic (Ctype.Integer Ctype.Char) -> true
+  | Ctype.Basic (Ctype.Integer (Ctype.Signed Ctype.Ichar)) -> true
+  | Ctype.Basic (Ctype.Integer (Ctype.Unsigned Ctype.Ichar)) -> true
+  | _ -> false
+end
+
+let gnuva_is_void_type (Ctype.Ctype _ ty) = match ty with
+  | Ctype.Void -> true
+  | _ -> false
+end
+
+let gnuva_pointer_exception tags (Ctype.Ctype _ actual) (Ctype.Ctype _ requested) = match (actual, requested) with
+  | (Ctype.Pointer _ actual_target, Ctype.Pointer _ requested_target) ->
+      (* C23 permits immediately qualified/unqualified versions of compatible
+         targets; qualifiers nested inside those targets remain significant.
+         The void/character exception is separate and includes qualifiers. *)
+      Ctype_aux.are_compatible_aux (tags, tags, [])
+        (Ctype.no_qualifiers, actual_target) (Ctype.no_qualifiers, requested_target) ||
+      (gnuva_void_or_character actual_target && gnuva_void_or_character requested_target &&
+        (gnuva_is_void_type actual_target || gnuva_is_void_type requested_target)) ||
+      (* GCC's documented POSIX XSI extension is profile-gated. It permits a
+         pointer to be retrieved as another pointer type; it neither converts
+         the pointed-to object nor makes a later incompatible dereference valid. *)
+      (Global.has_switch Global.SW_gnu_pointer_conversions && Implementation.has_amd64_sysv_abi () &&
+        not (Global.is_CHERI ()))
+  | (Ctype.Nullptr, Ctype.Pointer _ _) ->
+      (* On this pinned target every ordinary pointer representation/alignment
+         equals char*. This is the one-way C23 nullptr_t exception, not a
+         reverse permission to fetch an arbitrary pointer as nullptr_t. *)
+      Implementation.has_amd64_sysv_abi () && not (Global.is_CHERI ())
+  | _ -> false
+end
+
+(* The signed/unsigned exception requires corresponding types AND a value
+   representable in both. Matching width alone is not sufficient. *)
+let gnuva_corresponding_integer_pair (Ctype.Ctype _ actual) (Ctype.Ctype _ requested) =
+  match (actual, requested) with
+    | (Ctype.Basic (Ctype.Integer a), Ctype.Basic (Ctype.Integer b)) ->
+        match (Implementation.normalise_integerType a, Implementation.normalise_integerType b) with
+          | (Ctype.Signed ibty1, Ctype.Unsigned ibty2) -> if ibty1 = ibty2 then Just (Ctype.Unsigned ibty2) else Nothing
+          | (Ctype.Unsigned ibty1, Ctype.Signed ibty2) -> if ibty1 = ibty2 then Just (Ctype.Signed ibty2) else Nothing
+          | _ -> Nothing
+        end
+    | _ -> Nothing
+  end
+
+let gnuva_types_compatible tags actual requested =
+  Ctype_aux.are_compatible_aux (tags, tags, [])
+    (Ctype.no_qualifiers, actual) (Ctype.no_qualifiers, requested) ||
+  gnuva_pointer_exception tags actual requested
+
+let gnuva_require_compatible loc tags actual requested actual_value =
+  if gnuva_types_compatible tags actual requested then gnuva_return ()
+  else match gnuva_corresponding_integer_pair actual requested with
+    | Nothing -> gnuva_fail (GNUVA_Undefined_result Undefined.UB141)
+    | Just requested_integer ->
+        gnuva_load_value loc actual actual_value >>= fun value ->
+        gnuva_concrete_integer value >>= fun number ->
+        match (Mem_aux.integerFromIntegerValue (Mem.min_ival requested_integer),
+                     Mem_aux.integerFromIntegerValue (Mem.max_ival requested_integer)) with
+          | (Just minimum, Just maximum) ->
+              if minimum <= number && number <= maximum then gnuva_return ()
+              else gnuva_fail (GNUVA_Undefined_result Undefined.UB141)
+          | _ -> gnuva_fail (GNUVA_Refused "GNU variadic ABI integer exception needs concrete type bounds")
+        end
+  end
+
+let gnuva_argument loc tid tags oracle shape owner ap requested =
+  gnuva_require_scope owner >>
+  gnuva_find_cursor ap >>= fun cursor ->
+  gnuva_find_frame cursor.gnuva_frame_owner >>= fun frame ->
+  gnuva_consume_borrow owner cursor >>
+  match cursor.gnuva_pending_arguments with
+    | [] -> gnuva_fail (GNUVA_Undefined_result Undefined.UB141)
+    | actual :: remaining ->
+        gnuva_from_plan (Plan.gnuabi_classify tags oracle requested) >>= fun layout ->
+        (* Reject incompatible types before reading an unrelated register bank. *)
+        let actual_type = actual.Plan.gnuabi_placed_layout.Plan.gnuabi_argument_type in
+        if not (gnuva_types_compatible tags actual_type requested) &&
+           gnuva_corresponding_integer_pair actual_type requested = Nothing then
+          gnuva_fail (GNUVA_Undefined_result Undefined.UB141)
+        else
+        gnuva_read_argument_storage loc shape ap cursor frame layout >>= fun storage ->
+        let before = cursor.gnuva_expected_position in
+        (* Consumed offsets/pointers came from the real record and were checked.
+           Unused fields stay unread; their ledger values select no bytes. *)
+        let (placed, after) = Plan.gnuabi_place layout before in
+        gnuva_materialize loc tid owner layout placed.Plan.gnuabi_placed_location before storage >>= fun result ->
+        (* The value-dependent signed/unsigned check reads this same temporary.
+           Compatible pointer exceptions also preserve the physical payload. *)
+        gnuva_require_compatible loc tags actual_type requested result >>
+        gnuva_advance_argument_cursor loc shape ap before after storage >>
+        gnuva_install_cursor <| cursor with gnuva_pending_arguments= remaining; gnuva_expected_position= after |> >>
+        gnuva_return result
+  end
+
+(* va_end retires one cursor, never the shared frame. Function-scope exit owns
+   the actual storage lifetime. This also covers copies whose original ended. *)
+let gnuva_leave_scope loc scope =
+  gnuva_require_scope scope >>
+  gnuva_get >>= fun state ->
+  if List.any (fun item -> item.gnuva_cursor_owner = scope && item.gnuva_active) state.gnuva_cursors then
+    gnuva_fail (GNUVA_Undefined_result Undefined.UB139)
+  else
+    let dead_frames = List.filter (fun item -> item.gnuva_owner_scope = scope) state.gnuva_frames in
+    gnuva_each (fun item -> gnuva_lift (Mem.kill loc false item.gnuva_register_storage) >>
+      gnuva_lift (Mem.kill loc false item.gnuva_overflow_storage)) dead_frames >>
+    gnuva_each (fun (_, pointer) -> gnuva_lift (Mem.kill loc false pointer))
+      (List.filter (fun (owner, _) -> owner = scope) state.gnuva_temporary_objects) >>
+    gnuva_get >>= fun current ->
+    gnuva_put <| current with
+      gnuva_active_scopes= List.filter (fun owner -> owner <> scope) current.gnuva_active_scopes;
+      gnuva_frames= List.filter (fun item -> item.gnuva_owner_scope <> scope) current.gnuva_frames;
+      gnuva_cursors= List.filter (fun item -> item.gnuva_cursor_owner <> scope && item.gnuva_frame_owner <> scope) current.gnuva_cursors;
+      gnuva_temporary_objects= List.filter (fun (owner, _) -> owner <> scope) current.gnuva_temporary_objects |>
+
+declare {lean} termination_argument gnuva_each = automatic
+declare {lean} termination_argument gnuva_first_matching = automatic
+declare {lean} termination_argument gnuva_same_list = automatic
diff --git a/frontend/model/gnu_amd64_vformat.lem b/frontend/model/gnu_amd64_vformat.lem
new file mode 100644
index 00000000..0e662b8a
--- /dev/null
+++ b/frontend/model/gnu_amd64_vformat.lem
@@ -0,0 +1,374 @@
+(* Physical GNU va_list formatting adapter. Argument objects are fetched from
+   the selected ABI cursor one conversion at a time. This module deliberately
+   shares the established scalar renderer but owns every caller-visible read,
+   write and cursor transition. Unsupported formats remain explicit. *)
+open import Pervasives Utils
+import Ctype Ctype_aux Mem Mem_common Mem_aux Undefined Implementation Decode Core Errors Loc Symbol Map_extra
+import Formatted Monadic_parsing Gnu_amd64_varargs Gnu_amd64_varargs_runtime
+
+module V = Gnu_amd64_varargs_runtime
+module F = Formatted
+let inline (>>=) = V.gnuva_bind
+let inline (>>) first next = V.gnuva_bind first (fun _ -> next)
+
+val gnuvformat_refuse: forall 'a. string -> V.gnuva_runtimeM 'a
+let gnuvformat_refuse message = V.gnuva_fail (V.GNUVA_Refused message)
+val gnuvformat_undefined: forall 'a. Undefined.undefined_behaviour -> V.gnuva_runtimeM 'a
+let gnuvformat_undefined problem = V.gnuva_fail (V.GNUVA_Undefined_result problem)
+
+let gnuvformat_checked_load loc ty pointer =
+  match Mem_aux.integerFromIntegerValue (Mem.sizeof_ival ty) with
+    | Nothing -> gnuvformat_refuse "physical v* argument access needs a concrete type size"
+    | Just size -> V.gnuva_check_access pointer size >> V.gnuva_load_value loc ty pointer
+  end
+
+let gnuvformat_checked_store loc ty pointer value =
+  match Mem_aux.integerFromIntegerValue (Mem.sizeof_ival ty) with
+    | Nothing -> gnuvformat_refuse "physical v* output access needs a concrete type size"
+    | Just size -> V.gnuva_check_access pointer size >> V.gnuva_store_value loc ty pointer value
+  end
+
+(* Every byte is read through Mem exactly when that string is consumed. The
+   precision-zero case performs no dereference, including for a null pointer. *)
+val gnuvformat_read_chars_runtime: Loc.t -> Mem.pointer_value -> maybe nat -> V.gnuva_runtimeM (list char)
+let rec gnuvformat_read_chars_runtime loc pointer limit =
+  if limit = Just 0 then V.gnuva_return [] else
+  gnuvformat_checked_load loc Ctype.char pointer >>= V.gnuva_concrete_integer >>= fun number ->
+  if number = 0 then V.gnuva_return [] else
+  V.gnuva_byte_pointer loc pointer 1 >>= fun next ->
+  gnuvformat_read_chars_runtime loc next (match limit with Nothing -> Nothing | Just n -> Just (n-1) end) >>= fun rest ->
+  V.gnuva_return (Decode.encode_character_constant number :: rest)
+
+(* The memory walk has a loud fuel-exhaustion result, never a fabricated NUL. *)
+
+val gnuvformat_read_chars: Loc.t -> Mem.pointer_value -> maybe nat -> V.gnuva_runtimeM (list char)
+let rec gnuvformat_read_chars loc pointer limit =
+  if limit = Just 0 then V.gnuva_return [] else
+  gnuvformat_checked_load loc Ctype.char pointer >>= V.gnuva_concrete_integer >>= fun number ->
+  if number = 0 then V.gnuva_return [] else
+  V.gnuva_byte_pointer loc pointer 1 >>= fun next ->
+  gnuvformat_read_chars loc next (match limit with Nothing -> Nothing | Just n -> Just (n-1) end) >>= fun rest ->
+  V.gnuva_return (Decode.encode_character_constant number :: rest)
+
+(* The memory walk has a loud fuel-exhaustion result, never a fabricated NUL. *)
+declare {lean} fuel val gnuvformat_read_chars = `fun _ => ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))`
+
+val gnuvformat_write_chars: Loc.t -> Mem.pointer_value -> list char -> V.gnuva_runtimeM unit
+let rec gnuvformat_write_chars loc pointer = function
+  | [] -> gnuvformat_checked_store loc Ctype.char pointer (Mem_aux.integer_mval Ctype.Char 0)
+  | first :: rest ->
+      gnuvformat_checked_store loc Ctype.char pointer
+        (Mem_aux.integer_mval Ctype.Char (Decode.decode_character_constant (Decode.escaped_char first))) >>
+      V.gnuva_byte_pointer loc pointer 1 >>= fun next -> gnuvformat_write_chars loc next rest
+end
+declare {lean} termination_argument gnuvformat_write_chars = automatic
+
+let gnuvformat_pointer_to ty = Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers ty)
+
+let gnuvformat_string_argument_type (Ctype.Ctype _ ty) = match ty with
+  | Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char))) -> true
+  | Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer (Ctype.Signed Ctype.Ichar)))) -> true
+  | Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer (Ctype.Unsigned Ctype.Ichar)))) -> true
+  | _ -> false
+end
+
+(* C23 7.23.6.1p9 requires the promoted conversion type's va_arg behavior,
+   including the value-dependent corresponding signed/unsigned exception.
+   %s accepts storage of each character type; retain its actual pointer CType
+   for retrieval and load rather than pretending those pointer types match.
+   Unrelated same-width integers and arbitrary GNU pointers are not admitted. *)
+let gnuvformat_fetch loc tid tags oracle shape owner ap requested is_string =
+  V.gnuva_find_cursor ap >>= fun cursor ->
+  match cursor.V.gnuva_pending_arguments with
+    | [] -> gnuvformat_undefined Undefined.UB153a_insufficient_arguments_for_format
+    | actual :: _ ->
+        let actual_ty = actual.Gnu_amd64_varargs.gnuabi_placed_layout.Gnu_amd64_varargs.gnuabi_argument_type in
+        if (if is_string then gnuvformat_string_argument_type actual_ty else
+          Ctype_aux.are_compatible_aux (tags, tags, [])
+            (Ctype.no_qualifiers, actual_ty) (Ctype.no_qualifiers, requested) ||
+          V.gnuva_corresponding_integer_pair actual_ty requested <> Nothing) then
+          let retrieval_ty = if is_string then actual_ty else requested in
+          V.gnuva_argument loc tid tags oracle shape owner ap retrieval_ty >>= fun pointer ->
+          V.gnuva_return (retrieval_ty, pointer)
+        else gnuvformat_undefined Undefined.UB153b_illtyped_argument_for_format
+  end
+
+let gnuvformat_integer_argument loc fetch_arg =
+  fetch_arg Ctype.signed_int false >>= fun (_, pointer) ->
+  gnuvformat_checked_load loc Ctype.signed_int pointer >>= V.gnuva_concrete_integer
+
+let gnuvformat_resolve_stars loc fetch_arg cp =
+  (match cp.F.cp_field_width with
+    | Just F.FW_asterisk -> gnuvformat_integer_argument loc fetch_arg >>= fun width ->
+        if width < (0 - 2147483647) then gnuvformat_refuse "physical v* width overflow needs EOVERFLOW handling" else
+        V.gnuva_return <| cp with F.cp_field_width= Just (F.FW_num (natFromInteger (abs width)));
+          F.cp_flags= <| cp.F.cp_flags with F.flag_minus= cp.F.cp_flags.F.flag_minus || width < 0 |> |>
+    | _ -> V.gnuva_return cp
+  end) >>= fun cp ->
+  match cp.F.cp_precision with
+    | Just F.P_asterisk -> gnuvformat_integer_argument loc fetch_arg >>= fun precision ->
+        V.gnuva_return <| cp with F.cp_precision= if precision < 0 then Nothing else Just (F.P_num (natFromInteger precision)) |>
+    | _ -> V.gnuva_return cp
+  end
+
+let gnuvformat_n_target_type cp = match cp.F.cp_length_modifier with
+  | Just F.LM_hh -> Ctype.signed_char
+  | Just F.LM_h -> Ctype.signed_short
+  | Just F.LM_l -> Ctype.signed_long
+  | Just F.LM_ll -> Ctype.signed_long_long
+  | Just F.LM_j -> Ctype.intmax_t
+  | Just F.LM_z -> Ctype.signed_long
+  | Just F.LM_t -> Ctype.ptrdiff_t
+  | Nothing -> Ctype.signed_int
+end
+
+let gnuvformat_plain_n cp = cp.F.cp_field_width = Nothing && cp.F.cp_precision = Nothing &&
+  not cp.F.cp_flags.F.flag_minus && not cp.F.cp_flags.F.flag_plus &&
+  not cp.F.cp_flags.F.flag_space && not cp.F.cp_flags.F.flag_hash && not cp.F.cp_flags.F.flag_zero
+
+let gnuvformat_supported cp =
+  let no_stars = <| cp with F.cp_field_width= (match cp.F.cp_field_width with
+      | Just F.FW_asterisk -> Just (F.FW_num 1) | other -> other end);
+    F.cp_precision= (match cp.F.cp_precision with
+      | Just F.P_asterisk -> Just (F.P_num 1) | other -> other end) |> in
+  F.gnu_format_supported no_stars || (cp.F.cp_conversion_specifier = F.CS_n && gnuvformat_plain_n cp)
+
+(* On the pinned LP64 target char and short, including their unsigned forms,
+   undergo default promotion to int. The shared renderer then performs the
+   required narrowing conversion before producing the digits. *)
+let gnuvformat_small_integer_conversion cp =
+  List.elem cp.F.cp_conversion_specifier [F.CS_di; F.CS_o; F.CS_u; F.CS_x; F.CS_X] &&
+  List.elem cp.F.cp_length_modifier [Just F.LM_hh; Just F.LM_h]
+
+let gnuvformat_supported_conversion cp = gnuvformat_supported cp || (gnuvformat_small_integer_conversion cp &&
+  gnuvformat_supported <| cp with F.cp_length_modifier= Nothing |>)
+
+let gnuvformat_integer_conversion_type cp = if gnuvformat_small_integer_conversion cp then Ctype.signed_int
+  else F.gnu_format_integer_type cp
+
+let gnuvformat_justify cp text = match cp.F.cp_field_width with
+  | Just (F.FW_num width) -> if List.length text < width then
+      F.justify cp.F.cp_precision cp.F.cp_conversion_specifier cp.F.cp_flags width text else text
+  | Nothing -> text
+  | Just F.FW_asterisk -> error "physical v* renderer received unresolved width"
+end
+
+(* Same-allocation overlap is an explicit conservative boundary until exact
+   source ranges are retained; do not report disjoint ranges as C gnuvformat_undefined. *)
+let gnuvformat_separate destination pointer =
+  if F.gnu_format_separate_allocation destination pointer then V.gnuva_return ()
+  else gnuvformat_refuse "physical v* same-allocation gnuvformat_format/string/output aliasing is not yet implemented"
+
+(* Conversion handlers keep argument fetches and visible memory effects in
+   conversion order. The recursive renderer below only sequences conversions
+   and carries the count used by %n. *)
+val gnuvformat_render_string: Loc.t ->
+  (Ctype.ctype -> bool -> V.gnuva_runtimeM (Ctype.ctype * Mem.pointer_value)) ->
+  maybe Mem.pointer_value -> F.conversion_specification -> V.gnuva_runtimeM (list char)
+let gnuvformat_render_string loc fetch_arg destination cp =
+  fetch_arg (gnuvformat_pointer_to Ctype.char) true >>= fun (retrieval_ty, argument) ->
+  gnuvformat_checked_load loc retrieval_ty argument >>= V.gnuva_concrete_pointer >>= fun source ->
+  (if cp.F.cp_precision = Just (F.P_num 0) then V.gnuva_return ()
+   else gnuvformat_separate destination source) >>
+  let limit = match cp.F.cp_precision with
+    | Just (F.P_num precision) -> Just precision
+    | _ -> Nothing
+  end in
+  gnuvformat_read_chars loc source limit >>= fun text ->
+  V.gnuva_return (gnuvformat_justify cp text)
+
+val gnuvformat_render_count: Loc.t ->
+  (Ctype.ctype -> bool -> V.gnuva_runtimeM (Ctype.ctype * Mem.pointer_value)) ->
+  maybe Mem.pointer_value -> Mem.pointer_value -> integer -> list char ->
+  F.conversion_specification -> V.gnuva_runtimeM (list char)
+let gnuvformat_render_count loc fetch_arg destination format_pointer flag output cp =
+  if flag > 0 then gnuvformat_refuse "fortified physical v* %n needs read-only gnuvformat_format policy and abort semantics" else
+  let ty = gnuvformat_n_target_type cp in
+  let pointer_ty = gnuvformat_pointer_to ty in
+  fetch_arg pointer_ty false >>= fun (_, argument) ->
+  gnuvformat_checked_load loc pointer_ty argument >>= V.gnuva_concrete_pointer >>= fun destination_n ->
+  gnuvformat_separate destination destination_n >>
+  gnuvformat_separate (Just format_pointer) destination_n >>
+  let count = integerFromNat (List.length output) in
+  match ty with
+    | Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity)) ->
+        match Mem_aux.integerFromIntegerValue (Mem.max_ival ity) with
+          | Just maximum ->
+              if count > maximum then gnuvformat_refuse "physical v* narrow %n count conversion is not yet implemented"
+              else gnuvformat_checked_store loc ty destination_n (Mem_aux.integer_mval ity count) >>
+                V.gnuva_return []
+          | Nothing -> gnuvformat_refuse "physical v* %n needs concrete integer bounds"
+        end
+    | _ -> gnuvformat_refuse "physical v* %n target is not an integer"
+  end
+
+val gnuvformat_render_integer: Loc.t ->
+  (Ctype.ctype -> Mem.mem_value -> Mem.memM (either Errors.error (Undefined.t Core.value))) ->
+  (Ctype.ctype -> bool -> V.gnuva_runtimeM (Ctype.ctype * Mem.pointer_value)) ->
+  F.conversion_specification -> V.gnuva_runtimeM (list char)
+let gnuvformat_render_integer loc eval_conv fetch_arg cp =
+  let ty = gnuvformat_integer_conversion_type cp in
+  fetch_arg ty false >>= fun (_, argument) ->
+  (* The shared formatter loads only this reconstructed scalar. Visible cursor
+     and source accesses retain their actual footprints. Check concreteness
+     before its abstract-value display paths could fabricate output. *)
+  gnuvformat_checked_load loc ty argument >>= V.gnuva_concrete_integer >>
+  V.gnuva_lift (F.printf_aux loc eval_conv [] [F.F_conv cp] [(ty, argument)]) >>= function
