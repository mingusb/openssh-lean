+#!/usr/bin/env python3
+"""Generate files exact-prototype admission from one reviewed source API spec."""
+import argparse, hashlib, json
+from pathlib import Path
+
+KINDS={"signedInt","unsignedInt","signedLong","unsignedLong","charPointer",
+ "constCharPointer","voidPointer","constVoidPointer","intPointer","statPointer",
+ "statvfsPointer","constTimevalPointer","constTimespecPointer","constIovecPointer"}
+
+def generate(spec, template):
+    seen=set(); rows=[]
+    for api in spec["apis"] + spec["unresolved"]:
+        name=api["symbol"]
+        if name in seen or api["result"] not in KINDS or any(p not in KINDS for p in api["parameters"]):
+            raise ValueError("invalid or duplicate source API contract: "+name)
+        seen.add(name)
+        ps=", ".join("."+p for p in api["parameters"])
+        rows.append(f'  | "{name}" => some ⟨.{api["result"]}, [{ps}], {str(api.get("variadic", False)).lower()}⟩')
+    rows.append("  | _ => none")
+    return template.replace("@CONTRACTS@","\n".join(rows))
+
+def main():
+    p=argparse.ArgumentParser(); p.add_argument("--contracts",type=Path,required=True)
+    p.add_argument("--output",type=Path,required=True); p.add_argument("--check",action="store_true")
+    a=p.parse_args(); spec=json.loads(a.contracts.read_text())
+    if spec.get("schema")!=1 or spec.get("family")!="files-admission": raise ValueError("unsupported schema")
+    template=(Path(__file__).parent/"templates/files_admission.lean.in").read_text()
+    data=generate(spec,template); out=a.output/"CerbHostFilesAdmission.lean"
+    if a.check:
+        if not out.exists() or out.read_text()!=data: raise SystemExit("stale files admission module")
+    else:
+        a.output.mkdir(parents=True,exist_ok=True); out.write_text(data)
+    manifest={"schema":1,"admitted_symbols":len(spec["apis"])+len(spec["unresolved"]),"unresolved_symbols":0,
+      "contracts_sha256":hashlib.sha256(a.contracts.read_bytes()).hexdigest(),
+      "generator_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+      "output_sha256":hashlib.sha256(data.encode()).hexdigest(),"compiled":False,"integrated":False}
+    mp=a.output/"files-admission-manifest.json"; text=json.dumps(manifest,indent=2,sort_keys=True)+"\n"
+    if a.check:
+        if not mp.exists() or mp.read_text()!=text: raise SystemExit("stale files admission manifest")
+    else: mp.write_text(text)
+    print(json.dumps({"admitted":len(spec["apis"])+len(spec["unresolved"]),"unresolved":0,"checked":a.check}))
+if __name__=="__main__": main()
