+static void good(cerb_host_network_result r) {
+    assert(!r.boundary_error);
+}
+
+static void failure_oracles(void) {
+    int direct[2]={-91,-92};errno=81;
+    assert(socketpair(-1,SOCK_STREAM,0,direct)==-1 && errno==EAFNOSUPPORT);
+    assert(direct[0]>=0 && direct[1]>=0);
+    assert(fcntl(direct[0],F_GETFD)==-1 && errno==EBADF);
+    assert(fcntl(direct[1],F_GETFD)==-1 && errno==EBADF);
+    cerb_host_network_result failed=cerb_net_socketpair_raw(81,-1,SOCK_STREAM,0);
+    good(failed);
+    assert(failed.status.value==-1 && failed.native_errno_after==EAFNOSUPPORT);
+    assert(failed.field_count==2 && failed.fields[0]==(uint32_t)direct[0] &&
+        failed.fields[1]==(uint32_t)direct[1]);
+    assert(fcntl((int)failed.fields[0],F_GETFD)==-1 && errno==EBADF);
+    assert(fcntl((int)failed.fields[1],F_GETFD)==-1 && errno==EBADF);
+    cerb_host_network_dispose(&failed);
+    direct[0]=-91;direct[1]=-92;
+    assert(socketpair(AF_UNIX,SOCK_STREAM|0x40000000,0,direct)==-1 && errno==EINVAL);
+    assert(direct[0]==-91 && direct[1]==-92);
+    failed=cerb_net_socketpair_raw(82,AF_UNIX,SOCK_STREAM|0x40000000,0);
+    good(failed);assert(failed.status.value==-1 && failed.field_count==0);
+    cerb_host_network_dispose(&failed);
+
+    struct pollfd direct_poll={-1,POLLIN,0x1234},input=direct_poll,observed;
+    assert(cerb_test_failure_begin(1)==0);
+    int result=poll(&direct_poll,1,0),native_errno=errno;
+    assert(cerb_test_failure_end()==0);
+    assert(result==-1 && native_errno==EINVAL && direct_poll.revents==0x1234);
+    assert(cerb_test_failure_begin(1)==0);
+    failed=cerb_net_poll_raw(83,(unsigned char*)&input,sizeof(input),0);
+    assert(cerb_test_failure_end()==0);
+    good(failed);memcpy(&observed,failed.bytes,sizeof(observed));
+    assert(failed.status.value==-1 && failed.native_errno_after==EINVAL);
+    assert(failed.field_count==1 && failed.fields[0]==0 && observed.revents==direct_poll.revents);
+    cerb_host_network_dispose(&failed);
+
+    direct_poll=input;
+    assert(cerb_test_failure_begin(2)==0);
+    result=poll(&direct_poll,1,1000);native_errno=errno;
+    assert(cerb_test_failure_end()==0);
+    assert(result==-1 && native_errno==EINTR && direct_poll.revents==0);
+    assert(cerb_test_failure_begin(2)==0);
+    failed=cerb_net_poll_raw(84,(unsigned char*)&input,sizeof(input),1000);
+    assert(cerb_test_failure_end()==0);
+    good(failed);memcpy(&observed,failed.bytes,sizeof(observed));
+    assert(failed.status.value==-1 && failed.native_errno_after==EINTR);
+    assert(failed.field_count==1 && failed.fields[0]==1 && observed.revents==direct_poll.revents);
+    cerb_host_network_dispose(&failed);
+
+    /* INT_MAX is outside the audited kernel's allocatable fd domain. */
+    struct pollfd absent={INT_MAX,POLLIN,0};
+    assert(poll(&absent,1,0)==1 && absent.revents==POLLNVAL);
+    input=absent;input.revents=0;
+    failed=cerb_net_poll_raw(85,(unsigned char*)&input,sizeof(input),1000);
+    good(failed);memcpy(&observed,failed.bytes,sizeof(observed));
+    assert(failed.status.value==1 && observed.revents==POLLNVAL && failed.fields[0]==1);
