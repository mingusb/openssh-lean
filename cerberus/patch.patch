+/* GCC x86-64 LP64 oracle: mode affects type identity/rank as well as width. */
+typedef int signed_qi __attribute__((mode(QI)));
+typedef unsigned int unsigned_qi __attribute__((__mode__(__QI__)));
+typedef char char_qi __attribute((mode(byte)));
+typedef int signed_hi __attribute__((mode(HI)));
+typedef unsigned int unsigned_hi __attribute__((mode(__HI__)));
+typedef long signed_si __attribute__((mode(SI)));
+typedef unsigned long unsigned_si __attribute__((mode(__SI__)));
+typedef int signed_di __attribute__((mode(DI)));
+typedef unsigned int unsigned_di __attribute__((mode(__DI__)));
+typedef long long long_long_di __attribute__((mode(DI)));
+typedef unsigned long long unsigned_long_long_di __attribute__((mode(DI)));
+typedef int register_t __attribute__((__mode__(__word__)));
+typedef unsigned int pointer_word __attribute__((mode(__pointer__)));
+typedef int plain_word __attribute__((mode(word)));
+typedef int plain_pointer __attribute__((mode(pointer)));
+typedef int under_byte __attribute__((mode(__byte__)));
+typedef int chained __attribute__((mode(QI))) __attribute__((mode(DI)));
+typedef int listed __attribute__((mode(HI), mode(SI)));
+typedef const unsigned int const_word __attribute__((mode(word)));
+typedef int (parenthesized) __attribute__((mode(word)));
+typedef int narrow __attribute__((mode(QI))), unchanged;
+
+#define SAME(T,U) _Static_assert(__builtin_types_compatible_p(T,U), #T)
+#define LAYOUT(T,N) _Static_assert(sizeof(T) == N && _Alignof(T) == N, #T " layout")
+SAME(signed_qi, signed char); SAME(unsigned_qi, unsigned char);
+SAME(char_qi, signed char); SAME(signed_hi, short); SAME(unsigned_hi, unsigned short);
+SAME(signed_si, int); SAME(unsigned_si, unsigned int);
+SAME(signed_di, long); SAME(unsigned_di, unsigned long);
+SAME(long_long_di, long); SAME(unsigned_long_long_di, unsigned long);
+SAME(register_t, long); SAME(pointer_word, unsigned long);
+SAME(plain_word, long); SAME(plain_pointer, long); SAME(under_byte, signed char);
+SAME(chained, long); SAME(listed, int); SAME(const_word, const unsigned long);
+SAME(parenthesized, long); SAME(narrow, signed char); SAME(unchanged, int);
+LAYOUT(signed_qi, 1); LAYOUT(unsigned_qi, 1);
+LAYOUT(signed_hi, 2); LAYOUT(unsigned_hi, 2);
+LAYOUT(signed_si, 4); LAYOUT(unsigned_si, 4);
+LAYOUT(signed_di, 8); LAYOUT(unsigned_di, 8);
+SAME(__typeof__(+(unsigned_qi)0), int);
+SAME(__typeof__((signed_di)0 + (unsigned int)0), long);
+
+int global_word __attribute__((mode(word))) = 4294967296L;
+unsigned int global_byte __attribute__((mode(QI))) = 255;
+int tentative_word __attribute__((mode(word)));
+struct mode_members {
+    int word __attribute__((mode(DI)));
+    unsigned int byte __attribute__((mode(QI)));
+};
+_Static_assert(sizeof(struct mode_members) == 16, "member layout");
+_Static_assert(_Alignof(struct mode_members) == 8, "member alignment");
+SAME(__typeof__(((struct mode_members *)0)->word), long);
+int main(void) {
+    struct mode_members members = {4294967296L, 255};
+    unsigned int local_byte __attribute__((mode(QI))) = 255;
+    int local_word __attribute__((mode(word))) = 4294967296L;
+    signed_qi minus_one = -1;
+    register_t words[2] = {4294967296L, 4294967297L};
+    if (global_word != 4294967296L) return 1;
+    if (global_byte != 255) return 2;
+    if (local_word != 4294967296L) return 3;
+    local_byte += 2;
+    if (local_byte != 1) return 4;
+    if (minus_one >= 0) return 5;
+    if (words[1] != 4294967297L) return 6;
+    if (sizeof(words) != 16) return 7;
+    if (&words[1] - &words[0] != 1) return 8;
+    if (tentative_word != 0) return 9;
+    members.byte += 2;
+    if (members.word != 4294967296L || members.byte != 1) return 10;
+    return 0;
+}
diff --git a/tests/openssh-gnu-modes/may-alias-tags.c b/tests/openssh-gnu-modes/may-alias-tags.c
