+  A.binaryOperator -> gnu_scalar_knowledge -> gnu_scalar_knowledge -> maybe gnu_scalar_knowledge
+let gnu_scalar_comparison bop (al, ah, av) (bl, bh, bv) =
+  let relation a b = match bop with
+    | A.Lt -> a < b | A.Le -> a <= b | A.Gt -> a > b | A.Ge -> a >= b
+    | A.Eq -> a = b | A.Ne -> a <> b | _ -> false
+  end in
+  let certain = match bop with
+    | A.Lt -> if ah < bl then Just true else if al >= bh then Just false else Nothing
+    | A.Le -> if ah <= bl then Just true else if al > bh then Just false else Nothing
+    | A.Gt -> if al > bh then Just true else if ah <= bl then Just false else Nothing
+    | A.Ge -> if al >= bh then Just true else if ah < bl then Just false else Nothing
+    | A.Eq -> if ah < bl || bh < al then Just false else
+        if al = ah && bl = bh then Just (al = bl) else Nothing
+    | A.Ne -> if ah < bl || bh < al then Just true else
+        if al = ah && bl = bh then Just (al <> bl) else Nothing
+    | _ -> Nothing
+  end in
+  match certain with
+    | Just yes -> gnu_scalar_singleton (if yes then 1 else 0)
+    | Nothing ->
+        (* Correlated independent-looking operands do not prove variation.
+           One operand must be a known singleton and the other must carry
+           actual alternatives whose endpoint results differ. *)
+        Just (0, 1, (al = ah && bv && relation al bl <> relation al bh) ||
+          (bl = bh && av && relation al bl <> relation ah bl))
