+val gnu_alloc_size_rebind_type_equal: Ctype.ctype -> Ctype.ctype -> bool
+let gnu_alloc_size_rebind_type_equal formal_ty allocation_ty =
+  let without_typeof_origin (Ctype.Ctype annotations ty) =
+    Ctype.Ctype (gnu_alloc_size_rebind_annotations annotations) ty in
+  match (formal_ty, allocation_ty) with
+    | (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer formal_ity)),
+       Ctype.Ctype _ (Ctype.Basic (Ctype.Integer allocation_ity))) ->
+        Implementation.normalise_integerType formal_ity =
+          Implementation.normalise_integerType allocation_ity &&
+        gnu_function_target_type_equal
+          (without_typeof_origin formal_ty) (without_typeof_origin allocation_ty)
+    | _ -> false
+  end
