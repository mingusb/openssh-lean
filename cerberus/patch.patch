+    free(tmp); free(meta_tmp); flock(lock, LOCK_UN); close(lock);
+}
+static void memo_persist_exit(void) {
+    pthread_mutex_lock(&memo_disk_mutex);
+    memo_persist_save();
+    memo_trace("exit restored_hits=%llu\n", (unsigned long long)memo_restored_hits);
+    pthread_mutex_unlock(&memo_disk_mutex);
+}
+static void memo_persist_init(void) {
+    memo_disk_initialized = 1;
+    const char *setting = getenv("CERB_MEMO_PERSIST");
+    if (setting && !strcmp(setting, "0")) return;
+    const char *base = getenv("CERB_MEMO_DIR");
+    if (base && *base) memo_directory = strdup(base);
+    else {
+        base = getenv("XDG_CACHE_HOME");
+        char *parent = NULL;
+        if (base && *base) parent = strdup(base);
+        else {
+            base = getenv("HOME");
+            if (!base || !*base) return;
+            parent = memo_format("%s/.cache", base);
+        }
+        /* Do not chmod a user's pre-existing general cache directory. */
+        if (mkdir(parent, 0700) && errno != EEXIST) { free(parent); return; }
+        memo_directory = memo_format("%s/cerberus-lean-memo-v1", parent);
+        free(parent);
+    }
+    if (!memo_owned_directory(memo_directory)) { memo_trace("skip cache-directory\n"); return; }
