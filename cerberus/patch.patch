+++ b/lean_frontend/test/Unit/VlaLayoutFastPathProof.lean
@@ -0,0 +1,55 @@
+import Vla_types
+
+/-- A type ready without any record dependencies remains ready with any
+    record closure. This proves the ordinary-type fast path for every type,
+    including invalid and unresolved types, without assuming a particular TU. -/
+theorem layout_ready_of_empty
+    (enums : Fmap sym integerType)
+    (tags : Fmap sym (CerbLocation.Loc × tag_definition))
+    (known : List sym) (ty : ctype)
+    (h : vla_layout_ready enums tags [] ty = true) :
+    vla_layout_ready enums tags known ty = true := by
+  cases ty with
+  | Ctype annotations node =>
+    cases node with
+    | Array0 element count =>
+      cases count with
+      | none => simpa only [vla_layout_ready] using h
+      | some n =>
+        simp only [vla_layout_ready, Bool.and_eq_true] at h ⊢
+        exact ⟨h.1, layout_ready_of_empty enums tags known element h.2⟩
+    | Atomic element =>
+      exact layout_ready_of_empty enums tags known element h
+    | Struct tag =>
+      change false = true at h
+      cases h
+    | Union0 tag =>
+      change false = true at h
+      cases h
+    | Basic basic =>
+      cases basic <;> simpa only [vla_layout_ready] using h
+    | _ => simpa only [vla_layout_ready] using h
+termination_by structural ty
+
+/-- The pre-optimization admission check, retained as the reference formula. -/
+def layout_checked_sizeof_reference
+    (enums : Fmap sym integerType)
+    (tags tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
+    (oracle : ctype → Option Int) (ty : ctype) : Option Int :=
+  if vla_layout_ready enums tags (vla_layout_closure enums tags tagDefs) ty
+  then oracle ty else none
+
+/-- The maintained optimized function returns the original result on every input. -/
+theorem checked_sizeof_fast_path_exact
+    (enums : Fmap sym integerType)
+    (tags tagDefs : Fmap sym (CerbLocation.Loc × tag_definition))
+    (oracle : ctype → Option Int) (ty : ctype) :
+    vla_checked_sizeof enums tags tagDefs oracle ty =
+      layout_checked_sizeof_reference enums tags tagDefs oracle ty := by
+  by_cases h : vla_layout_ready enums tags [] ty = true
+  · have ready := layout_ready_of_empty enums tags
+      (vla_layout_closure enums tags tagDefs) ty h
+    simp [h, vla_checked_sizeof, layout_checked_sizeof_reference, ready]
+  · simp [h, vla_checked_sizeof, layout_checked_sizeof_reference]
+
+#print axioms checked_sizeof_fast_path_exact
