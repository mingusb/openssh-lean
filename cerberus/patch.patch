+val gnu_opaque_array_cleanup_expression:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_opaque_array_cleanup_expression roots (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_opaque_array_cleanup_expression roots in
+  let counter left = let (qs, ty) = qualified_ctype_of left in
+    not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && AilTypesAux.is_arithmetic ty &&
+      match left with A.AnnotatedExpression _ _ _ (A.AilEident _) -> true | _ -> false end in
