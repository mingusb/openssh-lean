--- /dev/null
+++ b/lean_frontend/host/families/network/guest/NetworkGuestTest.lean
@@ -0,0 +1,188 @@
+import CerbHostNetworkGuest
+open CerbMem CerbHostMemoryCells CerbHostNetworkGuest CerberusImpl
+
+@[extern "cerb_network_test_failure_begin"]
+opaque failureBegin : UInt32 → BaseIO UInt32
+@[extern "cerb_network_test_failure_end"]
+opaque failureEnd : BaseIO UInt32
+
+private def ensure (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+
+private def take {α : Type} (x : Except Failure α) : IO α :=
+  match x with
+  | .ok value => pure value
+  | .error (.boundary message) => throw (IO.userError message)
+  | .error (.memory _) => throw (IO.userError "unexpected modeled memory error")
+
+private def fails {α : Type} (x : Except Failure α) : Bool :=
+  match x with | .error _ => true | .ok _ => false
+
+private def run [LemFuel] [CerbGlobal.Switches] : IO Unit := do
+  let enums : EnumDefs := fmapEmpty
+  let tags : CerbTags.TagDefsMap := fmapEmpty
+  let initial := (initialMemState 4096)
+  let (pointer, allocated) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 24)) initial)
+  let (cells, allocated) ← take (arrayCells enums tags .signedInt pointer 6 allocated)
+  let [cell0,cell1,cell2,cell3,_cell4,errnoCell] := cells
+    | throw (IO.userError "expected six allocated integer cells")
+  let observed := { allocated with observations := some [] }
+  let errnoLease ← take (prepareOutputs enums tags [errnoCell] observed)
+  let (_, state) ← take (commitOutputs enums tags errnoLease [-71])
+  let lease ← take (prepareOutputs enums tags [cell0, cell1] state)
+  ensure (fails (readInteger enums tags cell0 (unchanged lease)))
+    "preflight must not initialize an unspecified output"
+  ensure ((unchanged lease).observations.map List.length == state.observations.map List.length)
+    "preflight must not emit live write observations"
+  ensure (fails (prepareOutputs enums tags [cell0, cell0] state))
+    "overlapping output cells need explicit alias contract"
+  let readonly := { state with allocations := state.allocations.map fun _ allocation =>
+    { allocation with isReadonly := .IsReadOnly .ReadonlyConstQualified } }
+  ensure (fails (prepareOutputs enums tags [cell0] readonly))
+    "readonly output must be refused before effects"
+  let (past, _) ← take (arrayCells enums tags .signedInt pointer 7 state)
+  let [_,_,_,_,_,_,pastCell] := past
+    | throw (IO.userError "expected seventh one-past cell")
+  ensure (fails (prepareOutputs enums tags [pastCell] state))
+    "one-past output must fail actual store bounds"
+  let dead := { state with allocations := Std.TreeMap.empty }
+  ensure (fails (prepareOutputs enums tags [cell0] dead))
+    "dead allocation must fail before native call"
+  let null : PointerValue := .PV .Prov_none (.PVnull unsigned_char)
+  let (empty, _, _) ← take (readBytes enums tags null 0 state)
+  ensure (empty.size == 0) "zero length must not dereference null"
+  let bytePointer := cell3.pointer
+  let (byteCells, shifted) ← take (arrayCells enums tags .byte bytePointer 3 state)
+  let bytesLease ← take (prepareOutputs enums tags byteCells shifted)
+  let (_, state) ← take (commitOutputs enums tags bytesLease [65,0,66])
+  let (payload, _, state) ← take (readBytes enums tags bytePointer 3 state)
+  ensure (payload.data == #[65,0,66]) "binary span must preserve embedded NUL"
+  let rejectFD (_ : Int) : Except String UInt32 := .error "unexpected input descriptor"
+  let prepared ← take (prepare enums tags rejectFD [12,13] errnoCell.pointer
+    (.socketpair 1 1 0 pointer) state)
+  ensure (fails (readInteger enums tags cell0 (unchanged prepared.outputs)))
+    "socketpair prepare must leave guest outputs unspecified"
+  let response ← executeNative prepared
+  let completed ← take (complete enums tags prepared response)
+  ensure (completed.returnValue == 0 && completed.descriptorTransfers.length == 2)
+    "socketpair must return two owned native descriptors"
+  ensure (completed.descriptorTransfers.map Prod.fst == [12,13])
+    "socketpair returns reserved guest IDs"
+  let (first, _, after) ← take (readInteger enums tags cell0 completed.memory)
+  let (second, _, after) ← take (readInteger enums tags cell1 after)
+  let (err, _, after) ← take (readInteger enums tags errnoCell after)
+  ensure (first == 12 && second == 13 && err == -71) "guest descriptor and errno writeback"
+  let failedRequest ← take (prepare enums tags rejectFD [14,15] errnoCell.pointer
+    (.socketpair (-1) 1 0 cell2.pointer) after)
+  let failedResponse ← executeNative failedRequest
+  let failed ← take (complete enums tags failedRequest failedResponse)
+  ensure (failed.returnValue == -1 && failed.descriptorTransfers.isEmpty)
+    "failed socketpair must cancel reservation without adoption"
+  -- Corrected expectation: the pinned kernel writes its reserved fd numbers
+  -- before the later EAFNOSUPPORT failure, but releases both handles.
+  let (failedFirst, _, afterFailure) ← take (readInteger enums tags cell2 failed.memory)
+  let (failedSecond, _, afterFailure) ← take (readInteger enums tags cell3 afterFailure)
+  ensure (failedFirst == 14 && failedSecond == 15)
+    "failed socketpair must preserve observed writes without adopting released handles"
+  let (earlyPointer, earlyState) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 4) (.IV .Prov_none 8)) afterFailure)
+  let (earlyCells, earlyState) ← take (arrayCells enums tags .signedInt earlyPointer 2 earlyState)
+  let [earlyFirst,_] := earlyCells | throw (IO.userError "expected early-failure pair")
+  let earlyRequest ← take (prepare enums tags rejectFD [14,15] errnoCell.pointer
+    (.socketpair 1 1073741825 0 earlyPointer) earlyState)
+  let earlyResponse ← executeNative earlyRequest
+  let early ← take (complete enums tags earlyRequest earlyResponse)
+  ensure (early.returnValue == -1 && early.descriptorTransfers.isEmpty &&
+    fails (readInteger enums tags earlyFirst early.memory))
+    "pre-reservation socketpair failure must preserve unspecified output"
+
+  let pollRequest ← take (prepare enums tags rejectFD [] errnoCell.pointer (.poll [] 0) failed.memory)
+  let pollResponse ← executeNative pollRequest
+  let polled ← take (complete enums tags pollRequest pollResponse)
+  ensure (polled.returnValue == 0 && polled.descriptorTransfers.isEmpty)
+    "zero-time zero-descriptor poll guest completion"
+  let (pollPointer, pollState) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 4) (.IV .Prov_none 8)) polled.memory)
+  let (shorts, pollState) ← take (arrayCells enums tags .signedShort pollPointer 4 pollState)
+  let [_,_,eventsCell,reventsCell] := shorts
+    | throw (IO.userError "expected pinned pollfd short cells")
+  let pollFDCell : Cell := ⟨pollPointer,.signedInt⟩
+  let pollInputLease ← take (prepareOutputs enums tags [pollFDCell,eventsCell] pollState)
+  let (_, pollState) ← take (commitOutputs enums tags pollInputLease [-1,1])
+  let row : PollRecord := ⟨pollPointer,eventsCell.pointer,reventsCell.pointer⟩
+  let limitedRequest ← take (prepare enums tags rejectFD [] errnoCell.pointer (.poll [row] 0) pollState)
+  ensure ((← failureBegin 1) == 0) "set fixture soft limit"
+  let limitedResponse ← executeNative limitedRequest
+  ensure ((← failureEnd) == 0) "restore fixture soft limit"
+  let limited ← take (complete enums tags limitedRequest limitedResponse)
+  ensure (limited.returnValue == -1 && limited.nativeErrnoAfter == 22 &&
+    fails (readInteger enums tags reventsCell limited.memory))
+    "poll EINVAL must preserve unspecified revents"
+  let interruptRequest ← take (prepare enums tags rejectFD [] errnoCell.pointer
+    (.poll [row] 1000) pollState)
+  ensure ((← failureBegin 2) == 0) "arm fixture signal"
+  let interruptResponse ← executeNative interruptRequest
+  ensure ((← failureEnd) == 0) "restore fixture signal"
+  let interrupted ← take (complete enums tags interruptRequest interruptResponse)
+  let (interruptedEvents,_,_) ← take (readInteger enums tags reventsCell interrupted.memory)
+  ensure (interrupted.returnValue == -1 && interrupted.nativeErrnoAfter == 4 &&
+    interruptedEvents == 0) "poll EINTR must initialize observed zero revents"
+
+  let positiveFDLease ← take (prepareOutputs enums tags [pollFDCell] pollState)
+  let (_, absentState) ← take (commitOutputs enums tags positiveFDLease [77])
+  let absent (_ : Int) : Except String DescriptorResolution := .ok .absent
+  let absentRequest ← take (prepareResolved enums tags absent [] errnoCell.pointer
+    (.poll [row] 1000) absentState)
+  let absentResponse ← executeNative absentRequest
+  let absentCompleted ← take (complete enums tags absentRequest absentResponse)
+  let (actualFD,_,absentAfter) ← take (readInteger enums tags pollFDCell absentCompleted.memory)
+  let (actualEvents,_,absentAfter) ← take (readInteger enums tags eventsCell absentAfter)
+  let (actualRevents,_,_) ← take (readInteger enums tags reventsCell absentAfter)
+  ensure (absentCompleted.returnValue == 1 && actualFD == 77 && actualEvents == 1 &&
+    actualRevents == 32) "known-absent positive descriptor must yield native POLLNVAL"
+  let resolverError (_ : Int) : Except String DescriptorResolution := .error "test resolution failure"
+  ensure (fails (prepareResolved enums tags resolverError [] errnoCell.pointer
+    (.listen 77 1) absentState)) "resolver failure must never become known absence"
+  for request in [Request.bind 77 null 16, Request.connect 77 null 16,
+      Request.listen 77 (-1), Request.shutdown 77 2147483647,
+      Request.bind (-1) null 16, Request.connect (-1) null 16] do
+    let invalidRequest ← take (prepareResolved enums tags absent [] errnoCell.pointer request absentState)
+    ensure (invalidRequest.inputFootprints.length == 1)
+      "invalid fd must not cause an extra modeled sockaddr read"
+    let invalidResponse ← executeNative invalidRequest
+    let invalid ← take (complete enums tags invalidRequest invalidResponse)
+    ensure (invalid.returnValue == -1 && invalid.nativeErrnoAfter == 9)
+      "invalid fd must retain native EBADF priority over address/argument checks"
+  for count in [0,4294967296,18446744073709551615] do
+    let noArrayRequest ← take (prepare enums tags rejectFD [] errnoCell.pointer
+      (.poll_no_array count 0) absentState)
+    ensure (noArrayRequest.inputFootprints.length == 1)
+      "no-array poll must only read modeled errno"
+    let noArrayResponse ← executeNative noArrayRequest
+    let noArray ← take (complete enums tags noArrayRequest noArrayResponse)
+    ensure (noArray.descriptorTransfers.isEmpty && noArray.outputFootprints.length == 1)
+      "no-array poll must write only errno and transfer no descriptors"
+    ensure (noArray.returnValue == (if count == 18446744073709551615 then -1 else 0))
+      "no-array poll must retain kernel count narrowing and limit result"
+    let (_,_,_) ← take (readInteger enums tags errnoCell noArray.memory)
+    ensure (fails (readInteger enums tags reventsCell noArray.memory))
+      "no-array poll preserves unspecified revents"
+  let noArrayLimitedRequest ← take (prepare enums tags rejectFD [] errnoCell.pointer
+    (.poll_no_array 1 0) absentState)
+  ensure ((← failureBegin 1) == 0) "set zero limit for no-array guest poll"
+  let noArrayLimitedResponse ← executeNative noArrayLimitedRequest
+  ensure ((← failureEnd) == 0) "restore zero limit for no-array guest poll"
+  let noArrayLimited ← take (complete enums tags noArrayLimitedRequest noArrayLimitedResponse)
+  ensure (noArrayLimited.returnValue == -1 && noArrayLimited.nativeErrnoAfter == 22 &&
+    fails (readInteger enums tags reventsCell noArrayLimited.memory))
+    "count failure must precede array access and preserve unspecified output"
+  IO.println "network-guest-ok"
+
+def main (args : List String) : IO Unit := do
+  match args with
+  | [fuel] =>
+    match fuel.toNat? with
+    | some budget => @run ⟨budget⟩ ⟨CerbGlobal.defaultSwitches⟩
+    | none => throw (IO.userError "expected checked-runner fuel argument")
+  | _ => throw (IO.userError "expected checked-runner fuel argument")
