+    int (*volatile native_poll)(struct pollfd*,nfds_t,int)=poll;
+    int saved=errno; int value=native_poll(NULL,(nfds_t)count,timeout); int e=value==-1?errno:0;
+    if((effective==0 && value!=0 && !(value==-1 && e==EINTR)) ||
+       (effective!=0 && !(value==-1 && e==EINVAL)))
+        r.boundary_error="native poll count path changed after checked admission";
+    r.fields[0]=0;r.field_count=1;
+    cerb_net_result(&r,value,e,saved);return r;
+"""
+
+def instrument_errno(body):
+    # Shared profile: allocations/preparation precede errno installation.
+    body=body.replace("int saved=errno;", "int saved=errno; errno=(int)modeled_errno;")
+    body=body.replace("int e=", "r.native_errno_after=(uint32_t)errno; int e=")
+    body=body.replace("int after=errno", "r.native_errno_after=(uint32_t)errno; int after=errno")
+    body=body.replace("cerb_net_cstring(&r,value); cerb_net_result",
+                      "r.native_errno_after=(uint32_t)errno; cerb_net_cstring(&r,value); cerb_net_result")
+    body=body.replace("freeaddrinfo(slot->pointer);cerb_net_remove(slot);",
+                      "freeaddrinfo(slot->pointer);r.native_errno_after=(uint32_t)errno;cerb_net_remove(slot);")
+    body=body.replace("freeifaddrs(slot->pointer);cerb_net_remove(slot);",
+                      "freeifaddrs(slot->pointer);r.native_errno_after=(uint32_t)errno;cerb_net_remove(slot);")
+    body=body.replace("*__h_errno_location();r.field_count=1;",
+                      "*__h_errno_location();r.native_errno_after=(uint32_t)errno;r.field_count=1;")
+    body=body.replace("struct __res_state *s=__res_state();",
+                      "struct __res_state *s=__res_state();r.native_errno_after=(uint32_t)errno;")
+    if "r.native_errno_after=" not in body:
+        raise ValueError("primitive has no explicit immediate errno snapshot")
+    return body
+
+
+def generate(contract):
+    if contract.get("schema") != 1 or contract.get("profile") != "x86_64-linux-gnu":
+        raise ValueError("unsupported network contract profile")
+    names=set(); decl=[]; bodies=[]; externs=[]; ffi=[]
+    for api in contract["apis"]:
+        name=api["symbol"]; primitive=api["primitive"]
+        if not re.fullmatch(r"[a-z_][a-z0-9_]*",name) or name in names or primitive not in BODIES:
+            raise ValueError("unrecognized/duplicate adapter contract: "+name)
+        names.add(name)
+        cp=["uint32_t modeled_errno"];fp=["uint32_t modeled_errno"];fc=["modeled_errno"];lt=["UInt32"]
+        for arg in api["params"]:
+            n,k=arg["name"],arg["kind"]
+            if not re.fullmatch("[a-z][a-z0-9_]*",n):raise ValueError("invalid parameter")
+            if k=="bytes":
+                cp += [f"const unsigned char *{n}",f"size_t {n}_size"]
+                fp += [f"b_lean_obj_arg {n}"]
+                fc += [f"lean_sarray_cptr({n})",f"lean_sarray_size({n})"]
+                lt += ["@& ByteArray"]
+            elif k in ("i32","u32","u64"):
+                ctype={"i32":"int32_t","u32":"uint32_t","u64":"uint64_t"}[k]
+                cp += [ctype+" "+n];fp += [("uint32_t" if k=="i32" else ctype)+" "+n]
+                fc += [f"(int32_t){n}" if k=="i32" else n]
+                lt += ["UInt64" if k=="u64" else "UInt32"]
+            else:raise ValueError("unsupported primitive parameter "+k)
+        signature=f"cerb_host_network_result cerb_net_{name}_raw({', '.join(cp) or 'void'})"
+        decl.append(signature+";")
+        native_args=["modeled_errno"]
+        for arg in api["params"]:
+            native_args.append(arg["name"])
+            if arg["kind"]=="bytes":native_args.append(arg["name"]+"_size")
+        inner=signature.replace("cerb_net_"+name+"_raw", "cerb_net_"+name+"_impl")
+        bodies.append("static "+inner+" {\n    cerb_host_network_result r=cerb_net_empty();\n"+
+                      instrument_errno(BODIES[primitive]).replace("@SYMBOL@",name).replace("@RECEIVE@","1" if name=="recvmsg" else "0")+"\n}\n"+
+                      signature+" {\n    int entry_errno=errno;\n"+
+                      "    cerb_host_network_result result=cerb_net_"+name+"_impl("+", ".join(native_args)+");\n"+
+                      "    errno=entry_errno; return result;\n}")
+        externs.append(f'@[extern "cerb_net_{name}"]\nopaque {name} : '+" → ".join(lt+["BaseIO NetworkResult"]))
+        ffi.append(f"LEAN_EXPORT lean_obj_res cerb_net_{name}({', '.join(fp) or 'void'}) {{\n"+
+                   f"    return cerb_net_box(cerb_net_{name}_raw({', '.join(fc)}));\n}}")
+    errno="\n".join(f'#ifdef {n}\n    if(error=={n})return "{n}";\n#endif' for n in contract["errno_names"])
+    outputs={"host_network_adapters.h":HEADER+"\n".join(decl)+"\n#endif\n",
+             "host_network_adapters.c":PRELUDE.replace("@ERRNO@",errno).replace("@KERNEL_RELEASE@",contract["failure_semantics"]["kernel_release"])+"\n".join(bodies)+FFI_PRELUDE+"\n".join(ffi)+"\n#endif\n",
+             "CerbHostNetworkAdapters.lean":LEAN_PRELUDE+"\n\n".join(externs)+"\nend CerbHostNetworkAdapters\n"}
+    return outputs
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--contracts",type=Path,required=True)
+    ap.add_argument("--output",type=Path,required=True)
+    ap.add_argument("--check",action="store_true")
+    args=ap.parse_args();source=args.contracts.read_text();contract=json.loads(source)
+    files=generate(contract)
+    if not args.check:args.output.mkdir(parents=True,exist_ok=True)
+    for name,text in files.items():
+        dest=args.output/name
+        if args.check:
+            if not dest.exists() or dest.read_text()!=text:raise SystemExit("stale generated adapter: "+name)
+        else:dest.write_text(text)
+    manifest={"schema":1,"contracts_sha256":hashlib.sha256(source.encode()).hexdigest(),
+              "generator_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "outputs":{k:hashlib.sha256(v.encode()).hexdigest() for k,v in files.items()},
+              "generated_native_boundaries":sum(not a.get("helper",False) for a in contract["apis"]),
+              "generated_boundary_helpers":sum(a.get("helper",False) for a in contract["apis"]),
+              "integrated_modeled_apis":0,"scope":"staged generated native boundaries; model dispatch remains required"}
+    dest=args.output/"network-manifest.json"
+    if args.check:
+        if not dest.exists() or json.loads(dest.read_text())!=manifest:raise SystemExit("stale manifest")
+    else:dest.write_text(json.dumps(manifest,indent=2)+"\n")
+    print(json.dumps(manifest))
+
+if __name__=="__main__":main()
