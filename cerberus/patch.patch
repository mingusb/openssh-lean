+static int memo_transient_identity(const memo_table *t) {
+    return t == memo_tables && !t->structural && t->registered_next &&
+        t->registered_next->structural && t->registered_next->registered_next &&
+        !t->registered_next->registered_next->structural && memo_table_count == 3;
