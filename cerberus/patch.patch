+        requests.append(f"  | {name}"+(" "+" ".join(l) if l else ""))
+        nms=" ".join(p["name"] for p in a["params"])
+        cases.append(f"  | .{name}"+(" "+nms if nms else "")+f" => native_{name} modeledErrno"+(" "+nms if nms else ""))
+    header+="#endif\n"
+    includes="""/* Generated adapters. Host addresses never become modeled pointers. */
+#define _GNU_SOURCE
+#include "host_system.h"
+#include <errno.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <wchar.h>
+#include <time.h>
+#include <locale.h>
+#include <langinfo.h>
+#include <pwd.h>
+#include <grp.h>
+#include <shadow.h>
+#include <crypt.h>
+#include <signal.h>
+#include <termios.h>
+#include <sys/time.h>
+#include <sys/resource.h>
+#include <sys/utsname.h>
+#include <utmp.h>
+#include <syslog.h>
+#include <fnmatch.h>
+#include <gnu/libc-version.h>
+#include <netdb.h>
+_Static_assert(sizeof(int)==4 && sizeof(long)==8 && sizeof(void*)==8,"pinned LP64 ABI");
+_Static_assert(sizeof(pid_t)==4 && sizeof(gid_t)==4 && sizeof(uid_t)==4,"pinned process ABI");
+_Static_assert(sizeof(time_t)==8 && sizeof(rlim_t)==8,"pinned time/resource ABI");
+_Static_assert(NCCS==32 && sizeof(tcflag_t)==4 && sizeof(speed_t)==4,"pinned termios ABI");
+_Static_assert(sizeof(sigset_t)==128 && sizeof(wchar_t)==4,"pinned signal/wchar ABI");
+static const char *system_error_name(int error) {
+"""
+    includes+="\n".join(f'#ifdef {e}\n    if(error=={e}) return "{e}";\n#endif' for e in errno_names)
+    includes+="\n    return NULL;\n}\n"
+    box=r"""
+#ifndef CERB_HOST_NO_LEAN
+#include <lean/lean.h>
+static lean_object *box_native(cerb_host_result value) {
+    lean_object *r=lean_alloc_ctor(0,2,sizeof(uint32_t));
+    lean_ctor_set(r,0,lean_int64_to_int(value.value));
+    lean_ctor_set(r,1,lean_mk_string(value.error_name ? value.error_name : ""));
+    lean_ctor_set_uint32(r,2*sizeof(void *),value.error);
+    return r;
+}
+static lean_object *box_system(cerb_system_result value) {
+    lean_object *bytes=lean_alloc_sarray(1,value.bytes_count,value.bytes_count);
+    if(value.bytes_count) memcpy(lean_sarray_cptr(bytes),value.bytes,value.bytes_count);
+    lean_object *fields=lean_alloc_array(0,value.field_count);
+    for(size_t i=0;i<value.field_count;i++) fields=lean_array_push(fields,lean_box_uint64(value.fields[i]));
+    lean_object *r=lean_alloc_ctor(0,4,sizeof(uint32_t));
+    lean_ctor_set(r,0,box_native(value.status)); lean_ctor_set(r,1,bytes);
+    lean_ctor_set(r,2,fields); lean_ctor_set(r,3,lean_mk_string(value.boundary_error ? value.boundary_error : ""));
+    lean_ctor_set_uint32(r,4*sizeof(void *),value.native_errno_after);
+    cerb_system_dispose(&value);
+    return r;
+}
+/* The host driver calls this only after validating the single modeled thread
+   and its fresh, dedicated interpreter session. Recheck the PID in C so an
+   inherited worker authorization cannot survive fork. */
+LEAN_EXPORT uint32_t cerb_system_enable_current_worker(void) {
+    return (uint32_t)cerb_system_enable_worker((int32_t)getpid());
+}
+"""
+    native=includes+HELPERS+"\n\n".join(bodies)+box+"\n\n".join(ffi)+"\n#endif\n"
+    lean="""import CerbHostAdapters
+/- Generated system transport. Dispatch must validate the source declaration,
+   decode model memory, map fd/PID arguments and perform exact copyback.
+   A boundaryError is never a C result and must not replay an effect.
+   Pure execution never calls this BaseIO transport. -/
+namespace CerbHostSystem
+@[extern "cerb_system_enable_current_worker"]
+opaque enableCurrentWorker : BaseIO UInt32
+
+structure SystemResult where
+  status : CerbHostAdapters.NativeResult
+  bytes : ByteArray
+  fields : Array UInt64
+  boundaryError : String
+  nativeErrnoAfter : UInt32
+  deriving Inhabited
+
+inductive Request where
+"""+ "\n".join(requests)+"\n\n"+"\n\n".join(extern)+"""
+/-- Execute the already-marshalled request once. Process-state APIs fail closed
+    until a dedicated worker is initialized by the native runtime. -/
+def execute (modeledErrno : UInt32) : Request → BaseIO SystemResult
+"""+ "\n".join(cases)+"\nend CerbHostSystem\n"
+    return {"host_system.h":header,"host_system.c":native,"CerbHostSystem.lean":lean}
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--contracts",type=Path,required=True)
+    ap.add_argument("--base-contracts",type=Path)
+    ap.add_argument("--output",type=Path,required=True)
+    ap.add_argument("--check",action="store_true")
+    args=ap.parse_args()
+    contract=json.loads(args.contracts.read_text())
+    pin=contract.get("pinned_libc")
+    if pin and hashlib.sha256(Path(pin["path"]).read_bytes()).hexdigest()!=pin["sha256"]:
+        raise SystemExit("Installed libc differs from exact system contract; regenerate contract only after semantic validation")
+
+    outputs=generate(contract,json.loads(args.base_contracts.read_text()) if args.base_contracts else contract)
+    codec=contract.get("guest_codecs")
+    if codec:
+        if codec["symbols"]!=["fgets","setvbuf"] or codec["template"]!="system-memory.lean.in" or codec["output"]!="CerbHostSystemMemory.lean":
+            raise SystemExit("Unrecognized system memory codec contract")
+        outputs[codec["output"]]=(args.contracts.parent/codec["template"]).read_text()
+    manifest={"schema":1,"generated_apis":len(contract["apis"]),
+      "contracts_sha256":hashlib.sha256(args.contracts.read_bytes()).hexdigest(),
+      "errno_profile_sha256":hashlib.sha256(json.dumps(contract["profile"],sort_keys=True).encode()).hexdigest(),
+      "generator_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+      "outputs":{n:hashlib.sha256(v.encode()).hexdigest() for n,v in outputs.items()},
+      "scope":contract["scope"],"native_execution_validated":False,"lean_compilation_validated":False,"guest_dispatch_integrated":False}
+    outputs["system-manifest.json"]=json.dumps(manifest,indent=2,sort_keys=True)+"\n"
+    if not args.check: args.output.mkdir(parents=True,exist_ok=True)
+    for n,v in outputs.items():
+        p=args.output/n
+        if args.check:
+            if not p.exists() or p.read_text()!=v: raise SystemExit("Stale generated output: "+str(p))
+        elif not p.is_file() or p.read_text()!=v: p.write_text(v)
+    print(json.dumps({"generated_apis":len(contract["apis"]),"checked":args.check,"output":str(args.output)}))
+if __name__=="__main__": main()
