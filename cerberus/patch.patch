+        let known = gnu_boundary_null_condition zero_formals test in
+        let () = if isJust known then Debug.print_debug_located 2 [Debug.DB_elaboration]
+          (Loc.locOf test) (fun () -> "GNU opaque boundary constant branch; taken=" ^ show known ^
+            "; expression=" ^ Pp.stringFromAil_expression test) else () in
+        (match known with
+          | Just true -> self yes
+          | Just false -> self no
