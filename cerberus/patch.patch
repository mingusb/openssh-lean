+(* A string comparison observes bytes, not an allocation-address equality.
+   Admit the standard, undefined-body declaration only, with its exact scalar
+   result and character-pointer arguments. The caller checks argument effects
+   separately. This does not certify arbitrary pure/const predicates. *)
+val gnu_standard_string_comparison_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_standard_string_comparison_call (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEcall callee [_; _] ->
+        let character_pointer ty = match ty with
+          | Ctype.Ctype _ (Ctype.Pointer qs (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)))) ->
+              not qs.Ctype.volatile
+          | _ -> false end in
+        let signature = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function (_, result)
+              [(_, first, _); (_, second, _)] false))) ->
+              AilTypesAux.are_compatible (Ctype.no_qualifiers, result)
+                (Ctype.no_qualifiers, Ctype.signed_int) &&
+              character_pointer first && character_pointer second
+          | _ -> false end in
+        if not signature || not (gnu_inline_direct_designator callee) then E.return false else
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_has_source_definition target >>= fun defined ->
+              E.linker_name declared >>= fun name ->
+              E.return (not defined && (name = Just "strcmp" || name = Just "__builtin_strcmp"))
+        end
+    | _ -> E.return false
+  end
