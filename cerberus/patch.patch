+    while (*slot && *slot != t) slot = &(*slot)->registered_next;
+    if (*slot) *slot = t->registered_next;
+    memo_tables_tail = &memo_tables;
+    while (*memo_tables_tail) memo_tables_tail = &(*memo_tables_tail)->registered_next;
