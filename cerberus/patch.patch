+(* Standard formatting may write the output, the va_list and %n targets.
+   A private pointer object's complete no-address-escape certificate excludes
+   all of those destinations. This summary is used only with that certificate;
+   it is neither a readonly summary nor preservation of arbitrary memory. *)
+(* Only the protected-global caller uses this write-effect certificate.
+   The normal and fortified formatters write the destination, the va_list and
+   any percent-n arguments; the global-address census must exclude access to
+   the protected storage. No call, bound check, cursor transition or write is
+   erased, and this is not a readonly classification. *)
+val gnu_standard_vsnprintf_call: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_standard_vsnprintf_call (A.AnnotatedExpression _ _ _ node) =
+  if not (Implementation.has_amd64_sysv_abi ()) then E.return false else
+  match node with
+    | A.AilEcall callee args ->
+        let char_pointer writable ty = match ty with
+          | Ctype.Ctype _ (Ctype.Pointer qs (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)))) ->
+              not qs.Ctype.volatile && (not writable || not qs.Ctype.const)
+          | _ -> false end in
+        let signed_int ty = AilTypesAux.are_compatible (Ctype.no_qualifiers, ty)
+          (Ctype.no_qualifiers, Ctype.signed_int) in
+        let size_type ty = AilTypesAux.are_compatible (Ctype.no_qualifiers, ty)
+          (Ctype.no_qualifiers, Ctype.size_t) in
+        let va_pointer ty = match ty with
+          | Ctype.Ctype _ (Ctype.Pointer qs (Ctype.Ctype _ (Ctype.Struct _))) ->
+              not (qs.Ctype.volatile || qs.Ctype.const)
+          | _ -> false end in
+        let names = match ctype_of callee with
+          | Ctype.Ctype _ (Ctype.Pointer _
+              (Ctype.Ctype _ (Ctype.Function (_, result)
+                [(_, destination, _); (_, count, _); (_, format, _); (_, ap, _)] false))) ->
+              if List.length args = 4 && signed_int result && size_type count &&
+                 char_pointer true destination && char_pointer false format && va_pointer ap
+              then ["vsnprintf"; "__builtin_vsnprintf"] else []
+          | Ctype.Ctype _ (Ctype.Pointer _
+              (Ctype.Ctype _ (Ctype.Function (_, result)
+                [(_, destination, _); (_, count, _); (_, flags, _); (_, bound, _);
+                 (_, format, _); (_, ap, _)] false))) ->
+              if List.length args = 6 && signed_int result && size_type count &&
+                 signed_int flags && size_type bound && char_pointer true destination &&
+                 char_pointer false format && va_pointer ap
+              then ["__vsnprintf_chk"; "__builtin___vsnprintf_chk"] else []
+          | _ -> [] end in
+        if names = [] || not (gnu_inline_direct_designator callee) then E.return false else
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_has_source_definition target >>= fun defined ->
+              E.linker_name declared >>= (function
+                | Nothing -> E.return false
+                | Just name -> E.gnu_linker_has_source_definition name >>= fun alias_defined ->
+                    E.return (not defined && not alias_defined && List.elem name names)
+                end)
+        end
+    | _ -> E.return false
+  end
