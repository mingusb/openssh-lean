+check_generator lean_frontend/host/families/descriptors/generate_descriptors.py lean_frontend/host/families/descriptors/descriptor-contracts.json
+check_generator lean_frontend/host/families/network/generate_network_adapters.py lean_frontend/host/families/network/network-contracts.json
+check_generator lean_frontend/host/families/network/admission/generate_network_admission.py lean_frontend/host/families/network/admission/admission-contracts.json
+check_generator lean_frontend/host/families/network/handler/generate_network_handler.py lean_frontend/host/families/network/handler/handler-contracts.json
+check_generator lean_frontend/host/families/files/normal/generate_files_admission.py lean_frontend/host/families/files/normal/files-admission-contracts.json
+check_generator lean_frontend/host/families/files/normal/generate_files_extras.py lean_frontend/host/families/files/normal/files-request-contracts.json
+check_files_requests() {
+  python3 "$task_root/lean_frontend/host/families/files/normal/generate_files_requests.py" \
+    --source "$task_root/lean_frontend/host/families/files/normal/files-admission-contracts.json" \
+    --requests "$task_root/lean_frontend/host/families/files/normal/files-request-contracts.json" \
+    --output "$task_root/lean_frontend/generated" --check
+}
+if $task_quiet; then check_files_requests >/dev/null; else check_files_requests; fi
+check_generator lean_frontend/host/families/system/generate_system_adapters.py lean_frontend/host/families/system/system-contracts.json
+check_generator lean_frontend/host/families/system/output/generate_system_output.py lean_frontend/host/families/system/output/output-contracts.json
