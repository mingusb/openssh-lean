+        lean+='@[extern "cerb_host_files_'+a["symbol"]+'"]\nprivate opaque native_'+a["symbol"]+" : "+typ+"\n\n"
+    lean+="/-- Internal once-only dispatch. Never retry a failed/short OS call here. -/\ndef executeResolved (modeledErrno : UInt32) : ResolvedRequest → BaseIO FilesResult\n"
+    for a in contract["apis"]:
+        names=" ".join(p["name"] for p in a["params"])
+        lean+="  | .«"+a["symbol"]+"» "+names+" => native_"+a["symbol"]+" modeledErrno "+names+"\n"
+    lean+="\nend CerbHostFilesAdapters\n"
+    registry={"schema":1,"family":contract["family"],"generated":[{"symbol":a["symbol"],"shape":a["shape"],"status":"generated-unintegrated-unvalidated","contract":a} for a in contract["apis"]],"dispositions":contract["dispositions"],"wire":contract["wire"]}
+    return {"host_files.h":header,"host_files.c":source,"CerbHostFilesAdapters.lean":lean,"files-registry.json":json.dumps(registry,indent=2,sort_keys=True)+"\n"}
+
+def main():
+    ap=argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--contracts",type=Path,required=True)
+    ap.add_argument("--output",type=Path,required=True)
+    ap.add_argument("--check",action="store_true")
+    args=ap.parse_args()
+    contract_text=args.contracts.read_text()
+    files=generate(json.loads(contract_text))
+    manifest={"schema":1,"generator_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),"contracts_sha256":hashlib.sha256(contract_text.encode()).hexdigest(),"outputs":{n:hashlib.sha256(t.encode()).hexdigest() for n,t in files.items()},"validation":"generation only; native/Lean compilation and guest integration remain required"}
+    files["files-manifest.json"]=json.dumps(manifest,indent=2,sort_keys=True)+"\n"
+    if not args.check:
+        args.output.mkdir(parents=True,exist_ok=True)
+    for name,text in files.items():
+        dest=args.output/name
+        if args.check:
+            if not dest.is_file() or dest.read_text()!=text:
+                raise SystemExit("Stale generated file: "+str(dest))
+        else:
+            dest.write_text(text)
+    print(json.dumps({"generated_apis":len(json.loads(contract_text)["apis"]),"checked":args.check,"output":str(args.output)}))
+if __name__=="__main__":
+    main()
