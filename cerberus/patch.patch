+open Lean Lean.Elab.Command
+
+abbrev FunctionIndex := List (sym × generic_fun_map_decl Unit Unit)
+
+/-- The quoted bodies and the measured files used to create them. The identity
+fields are kernel-visible data; the check against current files happens at import. -/
+structure CoreCertificate where
+  identity : CertIdentity
+  functions : FunctionIndex
+
+def lookupFunction (certificate : CoreCertificate) (symbol : sym) :
+    Option (generic_fun_map_decl Unit Unit) :=
+  (certificate.functions.find? (fun p => p.1 == symbol)).map Prod.snd
+
+def importCertificate (path : String) (declName : Name) : CommandElabM Unit := do
+  let raw ← IO.FS.readFile path
+  let json ← match Json.parse raw with
+    | .ok j => pure j
+    | .error e => throwError "Core certificate JSON parse failed: {e}"
+  let cert : CertFile ← match fromJson? json with
+    | .ok c => pure c
+    | .error e => throwError "Core certificate schema failed: {e}"
+  verifyIdentity cert.identity
+  let symbolType := mkConst ``sym
+  let functionType := mkApp2 (mkConst ``generic_fun_map_decl)
+    (mkConst ``Unit) (mkConst ``Unit)
+  let pairType := mkApp2 (mkConst ``Prod [Level.zero, Level.zero])
+    symbolType functionType
+  let mut value := mkApp (mkConst ``List.nil [Level.zero]) pairType
+  let mut seen : Std.HashSet String := {}
+  for entry in cert.functions.toList.reverse do
+    let symbolExpr ← match exprFromJson? entry.symbol with
+      | .ok e => pure e
+      | .error e => throwError "Core certificate symbol decode failed: {e}"
+    let bodyExpr ← match exprFromJson? entry.body with
+      | .ok e => pure e
+      | .error e => throwError "Core certificate body decode failed: {e}"
+    if symbolExpr.hasSorry || symbolExpr.hasFVar || symbolExpr.hasMVar ||
+        symbolExpr.hasLooseBVars || bodyExpr.hasSorry || bodyExpr.hasFVar ||
+        bodyExpr.hasMVar || bodyExpr.hasLooseBVars then
+      throwError "Core certificate contains an open or sorry-bearing term"
+    let key := entry.symbol.compress
+    if seen.contains key then
+      throwError "Core certificate has duplicate structural symbols"
+    seen := seen.insert key
+    let pair := mkAppN (mkConst ``Prod.mk [Level.zero, Level.zero])
+      #[symbolType, functionType, symbolExpr, bodyExpr]
+    value := mkAppN (mkConst ``List.cons [Level.zero])
+      #[pairType, pair, value]
+  let certificateType := mkConst (Name.str (Name.mkSimple "CerbCoreQuote") "CoreCertificate")
+  let certificateValue := mkApp2 (mkConst (Name.str (Name.str (Name.mkSimple "CerbCoreQuote") "CoreCertificate") "mk"))
+    (Lean.toExpr cert.identity) value
+  let decl := Declaration.defnDecl {
+    name := declName
+    levelParams := []
+    type := certificateType
+    value := certificateValue
+    hints := .abbrev
+    safety := .safe
+  }
+  liftCoreM <| addDecl decl
+
+/-- One kernel-checkable function body selected by ordinal from a pinned
+all-functions linked artifact. It remains a model term, not a proof that
+translation or the pinned C program has identical behavior. -/
+structure LinkedBodySelection where
+  identity : LinkedCertIdentity
+  ordinal : Nat
+  symbol : sym
+  body : generic_fun_map_decl Unit Unit
+
+/-- Import only the requested body into a Lean definition. The artifact hash,
+all recorded source inputs and the translator binary are rechecked. The linked
+artifact must have been emitted by the trusted translator run; these IO checks
+alone cannot prove C-to-Core semantic preservation. -/
+def importLinkedBody (path expectedSHA256 : String) (ordinal : Nat)
+    (declName : Name) : CommandElabM Unit := do
+  requireAbsolute path
+  unless (← hashFile "sha256sum" path 64) == expectedSHA256 do
+    throwError "linked function artifact changed: {path}"
+  let raw ← IO.FS.readFile path
+  unless (← hashFile "sha256sum" path 64) == expectedSHA256 do
+    throwError "linked function artifact changed during read: {path}"
+  let json ← match Json.parse raw with
+    | .ok value => pure value
+    | .error error => throwError "linked function artifact parse failed: {error}"
+  let cert : LinkedCertFile ← match fromJson? json with
+    | .ok value => pure value
+    | .error error => throwError "linked function artifact schema failed: {error}"
+  unless cert.identity.semanticSwitches == "gnu_pointer_conversions" &&
+      cert.identity.selectedSymbolName == "*" &&
+      cert.identity.linkProjection == "functions-only; global-initializer-order-omitted" &&
+      cert.functions.size == cert.identity.linkedFunctionCount &&
+      cert.functions.size > 0 &&
+      (cert.references.getObjVal? "scope").toOption ==
+        some (Lean.toJson "all-extern-linked-function-bodies") do
+    throwError "linked function artifact is not a complete function-body export"
+  let inputs ← verifyLinkedBinding cert.identity.sourceBindingPath
+    (some cert.identity.translatorPath)
+  unless inputs.bindingSHA256 == cert.identity.sourceBindingSHA256 &&
+      (← hashFile "sha256sum" cert.identity.translatorPath 64) ==
+        cert.identity.translatorSHA256 do
+    throwError "linked function artifact identity changed"
+  let some entry := cert.functions[ordinal]?
+    | throwError "linked function ordinal {ordinal} is out of range"
+  let symbolExpr ← match exprFromJson? entry.symbol with
+    | .ok value => pure value
+    | .error error => throwError "linked function symbol decode failed: {error}"
+  let bodyExpr ← match exprFromJson? entry.body with
+    | .ok value => pure value
+    | .error error => throwError "linked function body decode failed: {error}"
+  if symbolExpr.hasSorry || symbolExpr.hasFVar || symbolExpr.hasMVar ||
+      symbolExpr.hasLooseBVars || bodyExpr.hasSorry || bodyExpr.hasFVar ||
+      bodyExpr.hasMVar || bodyExpr.hasLooseBVars then
+    throwError "linked function artifact contains an open or sorry-bearing term"
+  let selectionName := Name.str (Name.mkSimple "CerbCoreQuote") "LinkedBodySelection"
+  let value := mkAppN (mkConst (Name.str selectionName "mk"))
+    #[Lean.toExpr cert.identity, Lean.toExpr ordinal, symbolExpr, bodyExpr]
+  let decl := Declaration.defnDecl {
+    name := declName
+    levelParams := []
+    type := mkConst selectionName
+    value
+    hints := .abbrev
+    safety := .safe
+  }
+  liftCoreM <| addDecl decl
+
+/-- Import linked-Core data as a kernel-checked Lean definition. The
+artifact hash, complete source binding and translator are checked first. -/
+def importLinkedCoreSnapshot (path expectedSHA256 : String)
+    (declName : Name) : CommandElabM Unit := do
+  requireAbsolute path
+  unless (← hashFile "sha256sum" path 64) == expectedSHA256 do
+    throwError "linked Core snapshot artifact changed: {path}"
+  let raw ← if path.endsWith ".gz" then do
+      let unpacked ← IO.Process.output { cmd := "gzip", args := #["-dc", path] }
+      unless unpacked.exitCode == 0 do
+        throwError "linked Core snapshot decompression failed: {unpacked.stderr}"
+      pure unpacked.stdout
+    else IO.FS.readFile path
+  unless (← hashFile "sha256sum" path 64) == expectedSHA256 do
+    throwError "linked Core snapshot artifact changed during read: {path}"
+  let json ← match Json.parse raw with
+    | .ok value => pure value
+    | .error error => throwError "linked Core snapshot parse failed: {error}"
+  let artifact : LinkedCoreFile ← match fromJson? json with
+    | .ok value => pure value
+    | .error error => throwError "linked Core snapshot schema failed: {error}"
+  unless artifact.identity.scope == "ordinary-linked-Core-record-data" &&
+      artifact.identity.semanticSwitches == "gnu_pointer_conversions" &&
+      artifact.identity.fieldNames == linkedCoreFieldNames do
+    throwError "linked Core snapshot has a different scope or field schema"
+  let inputs ← verifyLinkedBinding artifact.identity.sourceBindingPath
+    (some artifact.identity.translatorPath)
+  unless inputs.bindingSHA256 == artifact.identity.sourceBindingSHA256 &&
+      (← hashFile "sha256sum" artifact.identity.translatorPath 64) ==
+        artifact.identity.translatorSHA256 do
+    throwError "linked Core snapshot identity changed"
+  let snapshotExpr ← match exprFromJson? artifact.snapshot with
+    | .ok value => pure value
+    | .error error => throwError "linked Core snapshot decode failed: {error}"
+  if snapshotExpr.hasSorry || snapshotExpr.hasFVar || snapshotExpr.hasMVar ||
+      snapshotExpr.hasLooseBVars then
+    throwError "linked Core snapshot contains an open or sorry-bearing term"
+  let proofInputName := Name.str (Name.mkSimple "CerbCoreQuote") "LinkedCoreProofInput"
+  let value := mkApp3 (mkConst (Name.str proofInputName "mk"))
+    (Lean.toExpr artifact.identity) (Lean.toExpr expectedSHA256) snapshotExpr
+  let decl := Declaration.defnDecl {
+    name := declName
+    levelParams := []
+    type := mkConst proofInputName
+    value
+    hints := .abbrev
+    safety := .safe
+  }
+  liftCoreM <| addDecl decl
+
+end CerbCoreQuote
