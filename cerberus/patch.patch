+(* Unknown counters need an explicit dense full-type certificate. A missing
+   scalar fact is never evidence that the loop may execute. *)
+val gnu_loop_unknown_counter: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_loop_unknown_counter (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_integer ty) then E.return false else
+  match node with
+    | A.AilEident sym -> E.gnu_compiler_fact sym >>= fun fact -> E.return (match fact with
+        | Nothing -> false
+        | Just (E.GNU_inline_integer_range_fact low high dense) ->
+            dense && low <> high && gnu_scalar_type_bounds ty = Just (low, high)
+        | _ -> false end)
+    | A.AilErvalue operand -> gnu_loop_unknown_counter operand
+    | A.AilEannot _ operand -> gnu_loop_unknown_counter operand
+    | A.AilEunary A.PostfixIncr operand -> gnu_loop_unknown_counter operand
+    | A.AilEunary A.PostfixDecr operand -> gnu_loop_unknown_counter operand
+    | A.AilEbinary (A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixDecr operand)) A.Gt
+        (A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant number _ _)))) ->
+        if number = 0 then gnu_loop_unknown_counter operand else E.return false
+    | A.AilEbinary operand A.Gt
+        (A.AnnotatedExpression _ _ _ (A.AilEconst (A.ConstantInteger (A.IConstant number _ _)))) ->
+        if number = 0 then gnu_loop_unknown_counter operand else E.return false
+    | _ -> E.return false
+  end
