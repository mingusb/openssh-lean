@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Generate the pinned entry-time descriptor inventory and Lean decoder."""
+import argparse
+import json
+from pathlib import Path
+
+def generate(path):
+    root = path.resolve().parent
+    contract = json.loads(path.read_text())
+    if contract["schema"] != 1 or contract["profile"] != "x86_64-linux-gnu":
+        raise ValueError("unsupported worker bootstrap contract")
+    outputs = {}
+    for name in contract["outputs"]:
+        text = (root / "templates" / (name + ".in")).read_text()
+        text = text.replace("@KERNEL@", contract["kernel_release"])
+        outputs[name] = text
+    outputs["bootstrap-accounting.json"] = json.dumps({
+        "schema": 1, "automatic_inventory": True,
+        "initial_guest_mapping": "actual pre-Lean main-entry descriptors",
+        "ofd_alias_evidence": "F_DUPFD_QUERY exact native file pointer comparison",
+        "startup_contract": contract["startup_contract"],
+        "remaining_obligations": contract["remaining_obligations"],
+        "status": "generated; checked native and Lean execution required",
+        "main_dispatcher_status": "Linux host mode consumes this inventory through runFiles"
+    }, indent=2) + "\n"
+    return outputs
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--contracts", type=Path, required=True)
+    p.add_argument("--output", type=Path, required=True)
+    p.add_argument("--check", action="store_true")
+    a = p.parse_args()
+    outputs = generate(a.contracts)
+    if not a.check:
+        a.output.mkdir(parents=True, exist_ok=True)
+    for name, text in outputs.items():
+        path = a.output / name
+        if a.check:
+            if not path.exists() or path.read_text() != text:
+                raise SystemExit("stale worker bootstrap output: " + str(path))
+        else:
+            if not path.exists() or path.read_text() != text:
+                path.write_text(text)
+    print("worker-bootstrap-generation-ok")
+if __name__ == "__main__":
+    main()
diff --git a/lean_frontend/host/bootstrap/templates/CerbHostWorkerBootstrap.lean.in b/lean_frontend/host/bootstrap/templates/CerbHostWorkerBootstrap.lean.in
new file mode 100644
index 00000000..8ef95edc
--- /dev/null
+++ b/lean_frontend/host/bootstrap/templates/CerbHostWorkerBootstrap.lean.in
@@ -0,0 +1,82 @@
+import CerbHostDescriptors
+
+namespace CerbHostWorkerBootstrap
+
+structure NativeInventory where
+  words : Array UInt64
+  privateDescriptors : Array UInt32
+  error : String
+  deriving Repr, Nonempty
+
+/-- One-shot FFI. The executable must link the generated --wrap=main bootstrap. -/
+@[extern "cerb_worker_take_inventory_lean"]
+opaque takeInventory : BaseIO NativeInventory
+
+structure Initialized where
+  table : CerbHostDescriptors.Table
+  runtimePrivateDescriptors : Array UInt32
+  hardLimit : UInt64
+  processId : UInt32
+  deriving Repr
+
+private def fail {α : Type} (message : String) : Except String α := .error message
+
+/-- Initial guest numbers are the numbers inherited by the worker, unlike later
+dynamically allocated guest descriptors. Native-private additions are excluded. -/
+def decode (raw : NativeInventory) : Except String Initialized := do
+  if !raw.error.isEmpty then fail raw.error
+  if raw.words.size < 4 then fail "worker inventory header is truncated"
+  let session := raw.words[0]!.toNat
+  let limit := raw.words[1]!.toNat
+  let hardLimit := raw.words[2]!
+  let count := raw.words[3]!.toNat
+  if session == 0 || session > 2147483647 then fail "worker inventory has invalid process identity"
+  if raw.words.size != 4 + 4*count then fail "worker inventory length disagrees with count"
+  if limit > hardLimit.toNat then fail "worker inventory soft limit exceeds hard limit"
+  let mut entries : List CerbHostDescriptors.Entry := []
+  let mut descriptions : List CerbHostDescriptors.Description := []
+  for i in [:count] do
+    let base := 4 + 4*i
+    let fd := raw.words[base]!.toNat
+    let description := raw.words[base+1]!.toNat
+    let descriptorFlags := raw.words[base+2]!.toNat
+    let statusFlags := raw.words[base+3]!.toNat
+    if fd > 2147483647 || description > i || descriptorFlags > 4294967295 ||
+       statusFlags > 4294967295 then fail "worker inventory scalar is outside its exact domain"
+    entries := {
+      guest := fd
+      native := fd.toUInt32
+      generation := i
+      description := description
+      descriptorFlags := some descriptorFlags.toUInt32
+    } :: entries
+    match descriptions.find? (fun record => record.id == description) with
+    | some record =>
+      if record.statusFlags != some statusFlags.toUInt32 then
+        fail "worker inventory assigns inconsistent flags to shared OFD"
+    | none =>
+      if description != i then fail "worker inventory aliases a nonexistent OFD"
+      descriptions := ⟨description, some statusFlags.toUInt32⟩ :: descriptions
+  let table ← CerbHostDescriptors.create session limit entries.reverse descriptions.reverse
+  CerbHostDescriptors.validateIdle table
+  let mut seen : List UInt32 := []
+  for fd in raw.privateDescriptors do
+    if fd.toNat > 2147483647 || seen.contains fd ||
+       table.entries.any (fun entry => entry.native == fd) then
+      fail "runtime-private descriptor collides with initial guest ownership"
+    seen := fd :: seen
+  return {
+    table := table
+    runtimePrivateDescriptors := raw.privateDescriptors
+    hardLimit := hardLimit
+    processId := session.toUInt32
+  }
+
+/-- Invoke once at first driver entry, before any modeled host effect.
+Failed decoding is terminal for this worker, not permission to retry. -/
+def start : IO Initialized := do
+  match decode (← takeInventory) with
+  | .ok initialized => return initialized
+  | .error error => throw (IO.userError error)
+
+end CerbHostWorkerBootstrap
diff --git a/lean_frontend/host/bootstrap/templates/host_worker_bootstrap.c.in b/lean_frontend/host/bootstrap/templates/host_worker_bootstrap.c.in
new file mode 100644
index 00000000..15bf6ed3
--- /dev/null
+++ b/lean_frontend/host/bootstrap/templates/host_worker_bootstrap.c.in
@@ -0,0 +1,244 @@
+/* Generated dedicated-worker bootstrap. No guest descriptor is duplicated,
+   closed, moved or assigned replacement flags by this module. */
+#define _GNU_SOURCE
+#include "host_worker_bootstrap.h"
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/utsname.h>
+#include <unistd.h>
+_Static_assert(sizeof(void*)==8 && sizeof(long)==8 && sizeof(int)==4,
+               "worker bootstrap requires pinned LP64 target");
+_Static_assert(F_DUPFD_QUERY==1027, "pinned Linux F_DUPFD_QUERY ABI");
+
+typedef struct {
+    cerb_worker_entry wire;
+    dev_t device;
+    ino_t inode;
+    dev_t rdevice;
+    mode_t mode;
+} captured_entry;
+static captured_entry *captured;
+static cerb_worker_entry *public_entries;
+static size_t captured_count;
+static struct rlimit captured_limit;
+static pid_t captured_pid;
+static const char *capture_error="worker main wrapper did not capture initial descriptors";
+static atomic_int captured_state=0;
+
+typedef struct { uint32_t *items; size_t count; const char *error; } fd_list;
+
+static bool profile_matches(void) {
+    struct utsname value;
+    return uname(&value)==0 && strcmp(value.release,"@KERNEL@")==0 &&
+           strcmp(value.machine,"x86_64")==0;
+}
+static int compare_fd(const void *a,const void *b) {
+    uint32_t x=*(const uint32_t*)a,y=*(const uint32_t*)b;
+    return (x>y)-(x<y);
+}
+/* Enumeration opens/closes only its own /proc/self/fd directory.
+   It never reopens a guest file through /proc and never copies an OFD. */
+static fd_list enumerate_descriptors(void) {
+    fd_list out={0};
+    DIR *directory=opendir("/proc/self/fd");
+    if(!directory) { out.error="cannot enumerate initial descriptor table";return out; }
+    int own=dirfd(directory);
+    if(own<0) { out.error="cannot identify inventory directory descriptor";goto done; }
+    size_t capacity=0;
+    for(;;) {
+        errno=0;
+        struct dirent *entry=readdir(directory);
+        if(!entry) {
+            if(errno) out.error="descriptor inventory read failed";
+            break;
+        }
+        if(entry->d_name[0]=='.') continue;
+        char *end=NULL;
+        errno=0;
+        unsigned long value=strtoul(entry->d_name,&end,10);
+        if(errno || !end || *end || value>INT_MAX) {
+            out.error="descriptor inventory contains invalid numeric entry";break;
+        }
+        if((int)value==own) continue;
+        if(out.count==capacity) {
+            size_t next=capacity?capacity*2:16;
+            if(next<capacity || next>SIZE_MAX/sizeof(uint32_t)) {
+                out.error="descriptor inventory size overflow";break;
+            }
+            uint32_t *items=realloc(out.items,next*sizeof(uint32_t));
+            if(!items) { out.error="descriptor inventory allocation failed";break; }
+            out.items=items;capacity=next;
+        }
+        out.items[out.count++]=(uint32_t)value;
+    }
+done:
+    if(closedir(directory) && !out.error) out.error="inventory directory close failed";
+    if(out.error) { free(out.items);out.items=NULL;out.count=0; }
+    else if(out.count) qsort(out.items,out.count,sizeof(uint32_t),compare_fd);
+    return out;
+}
+static const char *read_identity(uint32_t fd,captured_entry *out) {
+    int descriptor=fcntl((int)fd,F_GETFD);
+    if(descriptor<0) return "captured descriptor closed during inventory";
+    int status=fcntl((int)fd,F_GETFL);
+    if(status<0) return "cannot observe captured descriptor status flags";
+    struct stat info;
+    if(fstat((int)fd,&info)) return "cannot observe captured descriptor identity";
+    out->wire.fd=fd;
+    out->wire.descriptor_flags=(uint32_t)descriptor;
+    out->wire.status_flags=(uint32_t)status;
+    out->device=info.st_dev;out->inode=info.st_ino;
+    out->rdevice=info.st_rdev;out->mode=info.st_mode;
+    return NULL;
+}
+static const char *capture_initial(void) {
+    if(!profile_matches()) return "worker kernel/architecture does not match audited profile";
+    if(getrlimit(RLIMIT_NOFILE,&captured_limit))
+        return "cannot observe initial RLIMIT_NOFILE";
+    if(captured_limit.rlim_cur>UINT64_C(2147483648))
+        return "initial descriptor allocation limit exceeds supported signed-int domain";
+    fd_list inventory=enumerate_descriptors();
+    if(inventory.error) return inventory.error;
+    if(inventory.count>SIZE_MAX/sizeof(captured_entry) ||
+       inventory.count>UINT32_MAX) {
+        free(inventory.items);return "initial inventory count is outside supported domain";
+    }
+    captured=calloc(inventory.count?inventory.count:1,sizeof(captured_entry));
+    public_entries=calloc(inventory.count?inventory.count:1,sizeof(cerb_worker_entry));
+    if(!captured || !public_entries) {
+        free(captured);free(public_entries);free(inventory.items);
+        captured=NULL;public_entries=NULL;return "initial inventory allocation failed";
+    }
+    const char *error=NULL;
+    for(size_t i=0;i<inventory.count;i++) {
+        error=read_identity(inventory.items[i],&captured[i]);
+        if(error) break;
+        captured[i].wire.description=(uint32_t)i;
+        for(size_t j=0;j<i;j++) {
+            int same=fcntl((int)inventory.items[i],F_DUPFD_QUERY,(int)inventory.items[j]);
+            if(same<0 || same>1) { error="exact OFD comparison unavailable";break; }
+            if(same) {
+                if(captured[i].wire.status_flags!=captured[j].wire.status_flags) {
+                    error="shared OFD flags changed during inventory";break;
+                }
+                captured[i].wire.description=captured[j].wire.description;
+                break;
+            }
+        }
+        if(error) break;
+        public_entries[i]=captured[i].wire;
+    }
+    if(!error) captured_count=inventory.count;
+    free(inventory.items);
+    return error;
+}
+extern int __real_main(int argc,char **argv);
+int __wrap_main(int argc,char **argv) {
+    int original_errno=errno;
+    if(atomic_load(&captured_state)!=0) {
+        fputs("host bootstrap entered more than once\n",stderr);return 125;
+    }
+    captured_pid=getpid();
+    capture_error=capture_initial();
+    atomic_store(&captured_state,1);
+    errno=original_errno;
+    /* Pure execution must remain available even when host bootstrap is not
+       supported. A host session consumes and reports capture_error explicitly. */
+    return __real_main(argc,argv);
+}
+
+static bool captured_fd(uint32_t fd) {
+    for(size_t i=0;i<captured_count;i++) if(captured[i].wire.fd==fd) return true;
+    return false;
+}
+cerb_worker_inventory cerb_worker_take_inventory(void) {
+    int original_errno=errno;
+    cerb_worker_inventory out={0};
+    int expected=1;
+    if(!atomic_compare_exchange_strong(&captured_state,&expected,2)) {
+        out.error="initial descriptor inventory already consumed or not captured";goto done;
+    }
+    if(captured_pid!=getpid()) {
+        out.error="captured descriptor inventory belongs to another process";goto done;
+    }
+    if(capture_error) { out.error=capture_error;goto done; }
+    struct rlimit limit;
+    if(getrlimit(RLIMIT_NOFILE,&limit) || limit.rlim_cur!=captured_limit.rlim_cur ||
+       limit.rlim_max!=captured_limit.rlim_max) {
+        out.error="descriptor limits changed during runtime initialization";goto done;
+    }
+    for(size_t i=0;i<captured_count;i++) {
+        captured_entry actual={0};
+        const captured_entry *initial=&captured[i];
+        out.error=read_identity(initial->wire.fd,&actual);
+        if(out.error) goto done;
+        /* This is a drift check, NOT proof of OFD identity. The reviewed startup
+           contract forbids close/rebind of inherited descriptors. Exact OFD
+           relationships within the live table are verified separately below. */
+        if(actual.device!=initial->device || actual.inode!=initial->inode ||
+           actual.rdevice!=initial->rdevice || actual.mode!=initial->mode ||
+           actual.wire.descriptor_flags!=initial->wire.descriptor_flags ||
+           actual.wire.status_flags!=initial->wire.status_flags) {
+            out.error="inherited descriptor changed during runtime initialization";goto done;
+        }
+        for(size_t j=0;j<i;j++) {
+            int same=fcntl((int)initial->wire.fd,F_DUPFD_QUERY,(int)captured[j].wire.fd);
+            if(same<0 || same>1 ||
+               (same!=0)!=(initial->wire.description==captured[j].wire.description)) {
+                out.error="inherited OFD relationship changed during initialization";goto done;
+            }
+        }
+    }
+    fd_list current=enumerate_descriptors();
+    if(current.error) { out.error=current.error;goto done; }
+    for(size_t i=0;i<current.count;i++)
+        if(!captured_fd(current.items[i])) current.items[out.private_count++]=current.items[i];
+    out.private_fds=current.items;
+    out.entries=public_entries;out.entry_count=captured_count;
+    out.soft_limit=captured_limit.rlim_cur;out.hard_limit=captured_limit.rlim_max;
+    out.session=(uint64_t)(uint32_t)captured_pid;
+done:
+    errno=original_errno;
+    return out;
+}
+void cerb_worker_dispose_inventory(cerb_worker_inventory *inventory) {
+    free(inventory->private_fds);inventory->private_fds=NULL;inventory->private_count=0;
+}
+#ifndef CERB_HOST_NO_LEAN
+#include <lean/lean.h>
+LEAN_EXPORT lean_obj_res cerb_worker_take_inventory_lean(void) {
+    cerb_worker_inventory raw=cerb_worker_take_inventory();
+    size_t word_count=4+4*raw.entry_count;
+    lean_object *words=lean_mk_empty_array_with_capacity(lean_unsigned_to_nat(word_count));
+    words=lean_array_push(words,lean_box_uint64(raw.session));
+    words=lean_array_push(words,lean_box_uint64(raw.soft_limit));
+    words=lean_array_push(words,lean_box_uint64(raw.hard_limit));
+    words=lean_array_push(words,lean_box_uint64(raw.entry_count));
+    for(size_t i=0;i<raw.entry_count;i++) {
+        const cerb_worker_entry *entry=&raw.entries[i];
+        words=lean_array_push(words,lean_box_uint64(entry->fd));
+        words=lean_array_push(words,lean_box_uint64(entry->description));
+        words=lean_array_push(words,lean_box_uint64(entry->descriptor_flags));
+        words=lean_array_push(words,lean_box_uint64(entry->status_flags));
+    }
+    lean_object *private_fds=lean_mk_empty_array_with_capacity(lean_unsigned_to_nat(raw.private_count));
+    for(size_t i=0;i<raw.private_count;i++)
+        private_fds=lean_array_push(private_fds,lean_box_uint32(raw.private_fds[i]));
+    lean_object *result=lean_alloc_ctor(0,3,0);
+    lean_ctor_set(result,0,words);
+    lean_ctor_set(result,1,private_fds);
+    lean_ctor_set(result,2,lean_mk_string(raw.error?raw.error:""));
+    cerb_worker_dispose_inventory(&raw);
+    return result;
+}
+#endif
diff --git a/lean_frontend/host/bootstrap/templates/host_worker_bootstrap.h.in b/lean_frontend/host/bootstrap/templates/host_worker_bootstrap.h.in
