+(* The pinned GNU early object-size pass keeps entry/body PHI alternatives
+   for a positive known counter, before later trip-count simplification. A
+   known-zero loop is eliminated before that pass. This profile applies only
+   to direct closed nonvolatile integer counters and these tested conditions;
+   it is not a claim that positive loops have a runtime zero-iteration path. *)
+val gnu_loop_initial_counter: Core.core_tag_definitions ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe integer)
+let rec gnu_loop_initial_counter tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_integer ty) then E.return Nothing else
+  match node with
+    | A.AilEident sym -> E.gnu_compiler_fact sym >>= function
+        | Just (E.GNU_inline_integer_range_fact low high _) ->
+            E.return (if low = high then Just low else Nothing)
+        | Just (E.GNU_inline_integer_progression_fact low high _) ->
+            E.return (if low = high then Just low else Nothing)
+        | Just (E.GNU_inline_integer_fact origin) ->
+            gnu_scalar_knowledge_of tagDefs origin >>= fun known -> E.return (match known with
+              | Just (low, high, _) -> if low = high then Just low else Nothing
+              | _ -> Nothing end)
+        | _ -> E.return Nothing end
+    | A.AilErvalue operand -> gnu_loop_initial_counter tagDefs operand
+    | A.AilEannot _ operand -> gnu_loop_initial_counter tagDefs operand
+    | _ -> E.return Nothing
+  end
