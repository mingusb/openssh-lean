+            (List.filter keep (private_bindings ++ private_locals))
+            (List.filter keep (List.map fst bindings ++ frame_locals))
+            zero_formals separate_frame separate_pointers opaque_locals
+            live_values live_roots protected_global whole_body child >>= fun child_checked ->
+          if not checked || not child_checked
+          then E.return (false, initialized, origin_values, origin_roots) else
