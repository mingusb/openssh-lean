+    | A.AilSblock _ statements -> E.mapM self statements >>= fun found -> E.return (List.concat found)
+    | A.AilSif test yes no -> expression test >>= fun first ->
+        self yes >>= fun second -> self no >>= fun third -> E.return (first ++ second ++ third)
+    | A.AilSwhile test body _ -> expression test >>= fun first ->
+        self body >>= fun second -> E.return (first ++ second)
+    | A.AilSdo body test _ -> expression test >>= fun first ->
+        self body >>= fun second -> E.return (first ++ second)
+    | A.AilSswitch test body -> expression test >>= fun first ->
+        self body >>= fun second -> E.return (first ++ second)
