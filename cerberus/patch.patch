+static memo_frame memo_frame_new(lean_object *object, memo_visit *visit) {
+    memo_frame f = {.object = object, .visit = visit, .tag = lean_ptr_tag(object)};
+    if (f.tag <= LeanMaxCtorTag) f.count = lean_ctor_num_objs(object);
+    else if (f.tag == LeanArray) f.count = lean_array_size(object);
+    else if (f.tag == LeanClosure) f.count = lean_closure_num_fixed(object);
+    else if (f.tag != LeanString && f.tag != LeanScalarArray && f.tag != LeanMPZ)
+        visit->state = 3;
