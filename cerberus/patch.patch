+    let fsSeek ← take (prepare enums tags fsResolve [] 0 base seekRequest fsOpened.memory)
+    let fsSought ← take (complete enums tags fsSeek (← executeNative fsSeek))
+    ensure (fsSought.returnValue == 0) "FS_LSEEK uses the mapped descriptor and signed-long offset"
+    let readRequest ← take (CerbHostFilesFS.decode none (.FS_READ 45 output 1))
