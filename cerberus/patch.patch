+    let duplicate ← take (prepare enums tags resolve [41] 128 base (.dup 40) state)
+    let duplicateNative ← executeNative duplicate
+    if duplicateNative.status.value >= 0 then remember duplicateNative.status.value.toNat.toUInt32
+    let duplicated ← take (complete enums tags duplicate duplicateNative)
+    ensure (duplicated.returnValue == 41 && duplicated.closeOnExec == [(41,false)])
