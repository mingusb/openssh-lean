+val gnu_scalar_entry_members:
+  Core.core_tag_definitions -> list Symbol.sym -> Ctype.ctype ->
+  list (list Symbol.identifier * E.gnu_inline_fact)
+let rec gnu_scalar_entry_members tagDefs seen (Ctype.Ctype annotations node as ty) =
+  if Annot.get_bitfield annotations <> Nothing then [] else
+  match gnu_scalar_type_bounds ty with
+    | Just (low, high) -> [([], E.GNU_inline_integer_range_fact low high true)]
+    | Nothing -> match node with
+        | Ctype.Struct tag ->
+            if List.elem tag seen then [] else match Map.lookup tag tagDefs with
+              | Just (_, Ctype.StructDef _ members _) -> List.concat (List.map
+                  (fun (ident, (_, _, qs, member_ty)) ->
+                    if qs.Ctype.volatile || AilTypesAux.is_atomic member_ty then [] else
+                    List.map (fun (path, fact) -> (ident :: path, fact))
+                      (gnu_scalar_entry_members tagDefs (tag :: seen) member_ty)) members)
+              | _ -> [] end
+        | _ -> [] end
+  end
