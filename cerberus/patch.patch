+}
+/* Exact-target identity is checked before allocation limits by pinned Linux. */
+static void descriptor_identity_oracle(void) {
+    int fd=open("/dev/null",O_RDONLY|O_CLOEXEC);
+    assert(fd>=0);
+    assert(cerb_test_failure_begin(1)==0);
+    errno=71;int two=dup2(fd,fd),two_errno=errno;
+    errno=72;int three=dup3(fd,fd,0),three_errno=errno;
+    int flags=fcntl(fd,F_GETFD);
+    assert(cerb_test_failure_end()==0);
+    assert(two==fd && two_errno==71);
+    assert(three==-1 && three_errno==EINVAL);
+    assert(flags==FD_CLOEXEC);
+    assert(close(fd)==0);
+}
+/* Pinned native count/error-order oracle; no array allocation. */
+static void poll_count_oracle(void) {
+    int (*volatile native_poll)(struct pollfd*,nfds_t,int)=poll;
+    struct rlimit limit;
+    assert(getrlimit(RLIMIT_NOFILE,&limit)==0);
+    assert(sizeof(nfds_t)==8 && strcmp(gnu_get_libc_version(),"2.43")==0);
+    uint64_t counts[]={0,UINT64_C(4294967296),UINT64_C(4294967297),
+        UINT64_MAX,(uint64_t)limit.rlim_cur+1};
+    int values[]={0,0,-1,-1,-1},errors[]={91,91,EFAULT,EINVAL,EINVAL};
+    assert(limit.rlim_cur<UINT32_MAX);
+    for(size_t i=0;i<sizeof(counts)/sizeof(counts[0]);i++) {
+        errno=91;
+        int value=native_poll((struct pollfd*)(uintptr_t)1,(nfds_t)counts[i],0);
+        int error=errno;
+        assert(value==values[i] && error==errors[i]);
+        if(i!=2) {
+            cerb_host_network_result r=cerb_net_poll_no_array_raw(91,counts[i],0);
+            good(r);assert(r.status.value==value && r.native_errno_after==(uint32_t)error);
+            assert(r.field_count==1 && r.fields[0]==0 && r.bytes_count==0);
+            cerb_host_network_dispose(&r);
+        }
+    }
+    cerb_host_network_result rejected=cerb_net_poll_no_array_raw(91,1,0);
+    assert(rejected.boundary_error);cerb_host_network_dispose(&rejected);
+    assert(cerb_test_failure_begin(1)==0);
+    errno=92;
+    int value=native_poll((struct pollfd*)(uintptr_t)1,(nfds_t)1,0);
+    int error=errno;
+    cerb_host_network_result limited=cerb_net_poll_no_array_raw(92,1,0);
+    assert(cerb_test_failure_end()==0);
+    assert(value==-1 && error==EINVAL);
+    good(limited);assert(limited.status.value==value && limited.native_errno_after==(uint32_t)error);
+    assert(limited.fields[0]==0 && limited.bytes_count==0);
+    cerb_host_network_dispose(&limited);
+}
+int main(void) {
+    poll_count_oracle();
+    descriptor_identity_oracle();
+    failure_oracles();
+    errno=31;
+    cerb_host_network_result pair=cerb_net_socketpair_raw(71,AF_UNIX,SOCK_STREAM,0);
+    good(pair);assert(pair.status.value==0 && pair.field_count==2);
+    assert(pair.native_errno_after==71 && errno==31);
+    int a=(int)pair.fields[0],b=(int)pair.fields[1];
+    cerb_host_network_dispose(&pair);
+    unsigned char iov[]={3,0,0,0,0,0,0,0,'a','b','c'};
+    cerb_host_network_result sent=cerb_net_sendmsg_raw(72,a,0,NULL,0,0,NULL,0,iov,sizeof(iov),0);
+    good(sent);assert(sent.status.value==3 && sent.native_errno_after==72);
+    cerb_host_network_dispose(&sent);
+    struct pollfd input={b,POLLIN,0};
+    cerb_host_network_result ready=cerb_net_poll_raw(73,(unsigned char*)&input,sizeof(input),0);
+    good(ready);assert(ready.status.value==1 && ready.bytes_count==sizeof(input));
+    struct pollfd output;memcpy(&output,ready.bytes,sizeof(output));
+    assert(output.fd==b && (output.revents&POLLIN));
+    cerb_host_network_dispose(&ready);
+    unsigned char receive[]={3,0,0,0,0,0,0,0,0xaa,0xbb,0xcc};
+    cerb_host_network_result got=cerb_net_recvmsg_raw(74,b,0,NULL,0,0,NULL,0,receive,sizeof(receive),0);
+    good(got);assert(got.status.value==3 && got.bytes_count==27);
+    assert(!memcmp(got.bytes+24,"abc",3));assert(got.native_errno_after==74);
+    cerb_host_network_dispose(&got);
+    int native_type=0;socklen_t n=sizeof(native_type);
+    assert(getsockopt(a,SOL_SOCKET,SO_TYPE,&native_type,&n)==0);
+    int zero=0;
+    cerb_host_network_result opt=cerb_net_getsockopt_raw(75,a,SOL_SOCKET,SO_TYPE,(unsigned char*)&zero,sizeof(zero));
+    good(opt);assert(opt.status.value==0 && opt.fields[0]==n);
+    assert(!memcmp(opt.bytes,&native_type,n));cerb_host_network_dispose(&opt);
+    /* SCM_RIGHTS remains raw native handles at this boundary. Modeled driver
+       registration/copyback is a separate obligation, not tested here. */
+    int pip[2];assert(pipe(pip)==0);assert(write(pip[1],"z",1)==1);
+    union { struct cmsghdr align; unsigned char bytes[CMSG_SPACE(sizeof(int))]; } ctl={0};
+    struct cmsghdr *c=(struct cmsghdr*)ctl.bytes;
+    c->cmsg_len=CMSG_LEN(sizeof(int));c->cmsg_level=SOL_SOCKET;c->cmsg_type=SCM_RIGHTS;
+    memcpy(CMSG_DATA(c),&pip[0],sizeof(int));
+    unsigned char one[]={1,0,0,0,0,0,0,0,'f'};
+    sent=cerb_net_sendmsg_raw(75,a,0,NULL,0,1,ctl.bytes,sizeof(ctl.bytes),one,sizeof(one),0);
+    good(sent);assert(sent.status.value==1);cerb_host_network_dispose(&sent);
+    memset(ctl.bytes,0,sizeof(ctl.bytes));one[8]=0;
+    got=cerb_net_recvmsg_raw(75,b,0,NULL,0,1,ctl.bytes,sizeof(ctl.bytes),one,sizeof(one),0);
+    good(got);assert(got.status.value==1 && got.fields[1]==sizeof(ctl.bytes));
+    memcpy(ctl.bytes,got.bytes+16,sizeof(ctl.bytes));
+    int passed_fd;memcpy(&passed_fd,CMSG_DATA((struct cmsghdr*)ctl.bytes),sizeof(int));
+    char transferred=0;assert(read(passed_fd,&transferred,1)==1 && transferred=='z');
+    close(passed_fd);close(pip[0]);close(pip[1]);cerb_host_network_dispose(&got);
+    cerb_host_network_result down=cerb_net_shutdown_raw(76,a,SHUT_WR);
+    good(down);assert(down.status.value==0);cerb_host_network_dispose(&down);
+    got=cerb_net_recvmsg_raw(77,b,0,NULL,0,0,NULL,0,receive,sizeof(receive),0);
+    good(got);assert(got.status.value==0 && got.bytes_count==27);
+    assert(!memcmp(got.bytes+24,receive+8,3));cerb_host_network_dispose(&got);
+    close(a);close(b);
+    errno=13;int oracle=socket(-1,SOCK_STREAM,0);int oracle_errno=errno;
+    assert(oracle==-1);
+    errno=31;cerb_host_network_result bad=cerb_net_socket_raw(78,-1,SOCK_STREAM,0);
+    good(bad);assert(bad.status.value==-1 && bad.status.error==(uint32_t)oracle_errno);
+    assert(bad.native_errno_after==(uint32_t)oracle_errno && errno==31);
+    cerb_host_network_dispose(&bad);
+
+    /* Exercise copied sockaddr values and independently returned lengths. */
+    cerb_host_network_result server=cerb_net_socket_raw(79,AF_INET,SOCK_STREAM,0);
+    good(server);assert(server.status.value>=0);a=(int)server.status.value;
+    struct sockaddr_in addr={0};addr.sin_family=AF_INET;addr.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
+    cerb_host_network_result bound=cerb_net_bind_raw(80,a,(unsigned char*)&addr,sizeof(addr));
+    good(bound);assert(bound.status.value==0);cerb_host_network_dispose(&bound);
+    cerb_host_network_result listening=cerb_net_listen_raw(81,a,1);
+    good(listening);assert(listening.status.value==0);cerb_host_network_dispose(&listening);
+    unsigned char address[128]={0};
+    cerb_host_network_result named=cerb_net_getsockname_raw(82,a,1,address,sizeof(address));
+    good(named);assert(named.status.value==0 && named.fields[0]==sizeof(addr));
+    memcpy(&addr,named.bytes,sizeof(addr));cerb_host_network_dispose(&named);
+    cerb_host_network_result client=cerb_net_socket_raw(83,AF_INET,SOCK_STREAM,0);
+    good(client);assert(client.status.value>=0);b=(int)client.status.value;
+    cerb_host_network_result connected=cerb_net_connect_raw(84,b,(unsigned char*)&addr,sizeof(addr));
+    good(connected);assert(connected.status.value==0);cerb_host_network_dispose(&connected);
+    cerb_host_network_result accepted=cerb_net_accept_raw(85,a,1,address,sizeof(address));
+    good(accepted);assert(accepted.status.value>=0 && accepted.fields[0]==sizeof(addr));
+    int accepted_fd=(int)accepted.status.value;cerb_host_network_dispose(&accepted);
