+val gnu_branch_local_symbols: A.statement GenTypes.genTypeCategory -> list Symbol.sym
+let rec gnu_branch_local_symbols stmt =
+  let self = gnu_branch_local_symbols in match stmt.A.node with
+    | A.AilSvla_scope _ _ _ body -> self body
+    | A.AilSblock bindings statements ->
+        List.map fst (List.filter (function
+          | (_, ((_, A.Automatic, _), _, _, _)) -> true
+          | _ -> false
+        end) bindings) ++
+        List.concat (List.map self statements)
+    | A.AilSif _ left right -> self left ++ self right
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSswitch _ body -> self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSpar statements -> List.concat (List.map self statements)
+    | A.AilSmarker _ body -> self body
+    | _ -> []
+  end
