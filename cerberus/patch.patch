+#ifndef CERB_HOST_WORKER_BOOTSTRAP_H
+#define CERB_HOST_WORKER_BOOTSTRAP_H
+#include <stdint.h>
+#include <stddef.h>
+typedef struct {
+    uint32_t fd, description, descriptor_flags, status_flags;
+} cerb_worker_entry;
+typedef struct {
+    const cerb_worker_entry *entries;
+    size_t entry_count;
+    uint32_t *private_fds;
+    size_t private_count;
+    uint64_t soft_limit, hard_limit, session;
+    const char *error;
+} cerb_worker_inventory;
+/* Captured by __wrap_main before Lean initializes, consumed exactly once.
+   The caller owns private_fds only. Entries remain immutable process metadata. */
+cerb_worker_inventory cerb_worker_take_inventory(void);
+void cerb_worker_dispose_inventory(cerb_worker_inventory *inventory);
+#endif
diff --git a/lean_frontend/host/families/descriptors/DescriptorIdentityNativeTest.c b/lean_frontend/host/families/descriptors/DescriptorIdentityNativeTest.c
new file mode 100644
index 00000000..3203467d
--- /dev/null
+++ b/lean_frontend/host/families/descriptors/DescriptorIdentityNativeTest.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/resource.h>
+#include <unistd.h>
+int main(void) {
+    int fd=open("/dev/null",O_RDONLY|O_CLOEXEC);
+    assert(fd>=0);
+    struct rlimit original,low;
+    assert(getrlimit(RLIMIT_NOFILE,&original)==0);
+    low=original;low.rlim_cur=0;
+    assert(setrlimit(RLIMIT_NOFILE,&low)==0);
+    errno=71;int two=dup2(fd,fd),two_errno=errno;
+    errno=72;int three=dup3(fd,fd,0),three_errno=errno;
+    int flags=fcntl(fd,F_GETFD);
+    assert(setrlimit(RLIMIT_NOFILE,&original)==0);
+    assert(two==fd && two_errno==71);
+    assert(three==-1 && three_errno==EINVAL);
+    assert(flags==FD_CLOEXEC);
+    assert(close(fd)==0);
+    return 0;
+}
