index 00000000..32294dd5
--- /dev/null
+++ b/scripts/test_openssh_gnu_keywords.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Check the GNU spelling extension without weakening unsupported attributes."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def normalize(value):
+    if isinstance(value, list):
+        return [normalize(x) for x in value]
+    if isinstance(value, dict):
+        if value.get("tag", "").startswith("Loc_") or set(value) == {"file", "line", "col"}:
+            return {"source_location": "omitted"}
+        return {k: normalize(v) for k, v in value.items() if k != "digest"}
+    return value
+
+
+def all_defined_42(text):
+    expected = 'Defined {value: "Specified(42)", stdout: "", stderr: "", blocked: "false"}'
+    lines = text.splitlines()
+    if lines == [expected]:
+        return True
+    return bool(lines) and len(lines) % 2 == 0 and all(
+        lines[i] == f"EXECUTION {i // 2}:" and lines[i + 1] == expected
+        for i in range(0, len(lines), 2))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parent.parent
+    driver = root / "_build/default/backend/driver/main.exe"
+    fixtures = root / "tests/openssh-gnu-keywords"
+    result = {"canonical_ast_matches_gnu_aliases": False,
+              "unsupported_mode_attribute_still_rejected": False, "native_exit_codes": {},
+              "ocaml_observations": {}, "ocaml_exit_codes": {}, "ocaml_timeouts": {},
+              "fixtures_sha256": {}}
+    trees = {}
+    with tempfile.TemporaryDirectory(prefix="cerberus-gnu-keywords-") as temp:
+        for name in ("canonical", "aliases", "canonical-asm", "aliases-asm"):
+            source = fixtures / (name + ".c")
+            result["fixtures_sha256"][name] = hashlib.sha256(source.read_bytes()).hexdigest()
+            parsed = subprocess.run([str(driver), "--runtime=" + str(root / "_build/install/default"),
+                                     "--cabs-json", str(source)], capture_output=True, timeout=30)
+            if parsed.returncode:
+                raise RuntimeError(parsed.stderr.decode(errors="replace"))
+            trees[name] = normalize(json.loads(parsed.stdout))
+            binary = str(Path(temp) / name)
+            subprocess.run(["cc", "-std=gnu23", "-O2", str(source), "-o", binary],
+                           check=True, capture_output=True, timeout=30)
+            result["native_exit_codes"][name] = subprocess.run([binary], timeout=10).returncode
+            if name in {"canonical", "aliases"}:
+                try:
+                    executed = subprocess.run([str(driver), "--runtime=" + str(root / "_build/install/default"),
+                                               "--nolibc", "--exec", "--batch", "--mode=exhaustive", str(source)],
+                                              capture_output=True, timeout=30)
+                    result["ocaml_observations"][name] = executed.stdout.decode().strip()
+                    result["ocaml_exit_codes"][name] = executed.returncode
+                    result["ocaml_timeouts"][name] = False
+                except subprocess.TimeoutExpired:
+                    result["ocaml_observations"][name] = ""
+                    result["ocaml_exit_codes"][name] = None
+                    result["ocaml_timeouts"][name] = True
+        result["canonical_ast_matches_gnu_aliases"] = trees["canonical"] == trees["aliases"]
+        result["assembly_ast_matches_gnu_aliases"] = trees["canonical-asm"] == trees["aliases-asm"]
+        result["assembly_semantics_added"] = False
+        refusal = subprocess.run([str(driver), "--runtime=" + str(root / "_build/install/default"),
+                                  "--nolibc", "--exec", "--batch", str(fixtures / "refuse-mode.c")],
+                                 capture_output=True, timeout=30)
+        result["unsupported_mode_attribute_still_rejected"] = refusal.returncode != 0
+        result["refusal_stderr"] = refusal.stderr.decode(errors="replace")
+        result["normalized_ast_sha256"] = hashlib.sha256(
+            json.dumps(trees["canonical"], sort_keys=True).encode()).hexdigest()
+        result["normalized_assembly_ast_sha256"] = hashlib.sha256(
+            json.dumps(trees["canonical-asm"], sort_keys=True).encode()).hexdigest()
+    result["passed"] = (result["canonical_ast_matches_gnu_aliases"]
+                        and result["assembly_ast_matches_gnu_aliases"]
+                        and result["unsupported_mode_attribute_still_rejected"]
+                        and set(result["ocaml_exit_codes"].values()) == {0}
+                        and all(all_defined_42(value) for value in result["ocaml_observations"].values())
+                        and result["native_exit_codes"] == {
+                            "canonical": 42, "aliases": 42, "canonical-asm": 0, "aliases-asm": 0})
+    result["scope"] = "Parser AST comparison and native/OCaml regressions, including file-scope typeof; not a preservation theorem"
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(result))
+    return 0 if result["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
