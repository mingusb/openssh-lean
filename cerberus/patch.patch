+                Mem.return (Right (U.Error loc "GNU fortified format conversion is not yet supported"))
+              else gnu_format_args_check loc dst fs args >>= function
+                | U.Error l msg -> Mem.return (Right (U.Error l msg))
+                | U.Undef l ubs -> Mem.return (Right (U.Undef l ubs))
