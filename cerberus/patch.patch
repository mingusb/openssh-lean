+  if gnu_memory_expression_readonly expr then E.return true else match node with
+    | A.AilEassign left right -> if counter left then self right else E.return false
+    | A.AilEcompoundAssign left _ right -> if counter left then self right else E.return false
+    | A.AilEunary A.PostfixIncr left -> E.return (counter left)
+    | A.AilEunary A.PostfixDecr left -> E.return (counter left)
+    | A.AilEcall _ (first :: rest) ->
+        let element = gnu_pointer_array_argument_root first in
+        if not (maybe false (fun sym -> List.elem sym roots) element) then E.return false else
+        E.mapM gnu_memory_certified_readonly (first :: rest) >>= fun readonly ->
+        if not (List.all (fun value -> value) readonly) then E.return false else
+        gnu_standard_free_call expr >>= fun releases ->
+        if releases then E.return true else gnu_explicit_erase_wrapper_expression [] expr
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | _ -> E.return false
+  end in
+  checked >>= fun accepted ->
+  let () = if accepted then () else Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr)
+    (fun () -> "GNU opaque array cleanup rejected: " ^ Pp.stringFromAil_expression expr) in
+  E.return accepted
