diff --git a/lean_frontend/CerbRuntimeArgs.lean b/lean_frontend/CerbRuntimeArgs.lean
new file mode 100644
index 00000000..a25a58e8
--- /dev/null
+++ b/lean_frontend/CerbRuntimeArgs.lean
@@ -0,0 +1,32 @@
+import CerberusImpl
+
+namespace CerbRuntimeArgs
+
+/-- Runtime arguments are byte strings, not C source character literals.
+The existing model stores plain char values with the selected signedness. -/
+def byteValues (text : String) : List Int :=
+  let signed := CerberusImpl.is_signed_ity .Char0
+  text.toUTF8.data.toList.map fun byte =>
+    let n := Int.ofNat byte.toNat
+    if signed && n >= 128 then n - 256 else n
+
+/-- glibc's short program name aliases the bytes following the last slash. -/
+def prognameOffset (text : String) : Int :=
+  let (_, offset) := text.toUTF8.data.foldl (fun (index, last) byte =>
+    (index + 1, if byte == 47 then index + 1 else last)) (0, 0)
+  Int.ofNat offset
+
+/-- The separator preserves argv[0] and every subsequent argument exactly.
+The historical text form remains explicit for old diagnostic invocations. -/
+def parse (arguments : List String) : Except String (List String) := do
+  let argv ← match arguments with
+    | [] => pure ["cmdname"]
+    | ["--args", text] =>
+      pure ("cmdname" :: (((text.replace "\t" " ").splitOn " ").filter (· != "")))
+    | "--" :: first :: rest => pure (first :: rest)
+    | _ => throw "expected -- ARGV0 [ARG ...] or the legacy --args TEXT form"
+  if argv.any (fun arg => arg.contains (Char.ofNat 0)) then
+    throw "argv cannot contain an embedded NUL byte"
+  return argv
+
+end CerbRuntimeArgs
diff --git a/lean_frontend/CerbRuntimeInit.lean b/lean_frontend/CerbRuntimeInit.lean
new file mode 100644
index 00000000..19ba9c02
--- /dev/null
+++ b/lean_frontend/CerbRuntimeInit.lean
@@ -0,0 +1,13 @@
+import CerbMemoPass
+
+namespace CerbRuntimeInit
+
+/-- Match the monolithic driver's validated native entry boundary. In
+    particular, configure false still enables explicitly selected pure caches;
+    omitting this call silently disables them and makes large programs crawl. -/
+def prepare : IO Unit := do
+  unless (← IO.getEnv "LEAN_ABORT_ON_PANIC").isSome do
+    throw (IO.userError "LEAN_ABORT_ON_PANIC is required; a Lean panic must not become a default result")
+  CerbMemo.configure ((← IO.getEnv "CERB_MEMO") == some "1")
+
+end CerbRuntimeInit
diff --git a/lean_frontend/CerbSavedProgram.lean b/lean_frontend/CerbSavedProgram.lean
new file mode 100644
index 00000000..21fbc865
--- /dev/null
+++ b/lean_frontend/CerbSavedProgram.lean
@@ -0,0 +1,120 @@
+import CerbCoreData
+
+/- A compiled Core program and its producer are immutable inputs. The consumer
+   is a separately built runtime; it need not contain the C translator. This
+   loader preserves producer identity instead of relabeling an old translation
+   with the runtime's hash. The original same-translator loader stays strict. -/
+namespace CerbSavedProgram
+
+structure Parameters where
+  producerSHA256 : String
+  bindingSHA256 : String
+  sourceCount : Nat
+  fuel : Nat
+  addressSpaceTop : Nat
+
+structure Loaded where
+  coreFile : file Unit
+  supply : Nat
+  executionDigest : String
+  parameters : Parameters
+
+private def field {α : Type} [Lean.FromJson α] (json : Lean.Json) (key : String) : IO α :=
+  match json.getObjValAs? α key with
+  | .ok value => pure value
+  | .error error => throw (IO.userError s!"saved program binding {key}: {error}")
+
+def readParameters (bindingPath expectedProducer : String) : IO Parameters := do
+  CerbCoreQuote.requireAbsolute bindingPath
+  let digest ← CerbCoreQuote.hashFile "sha256sum" bindingPath 64
+  let binding ← match Lean.Json.parse (← IO.FS.readFile bindingPath) with
+    | .ok value => pure value
+    | .error error => throw (IO.userError error)
+  let scope : String ← field binding "scope"
+  let mode : String ← field binding "receipt_mode"
+  let switches : List String ← field binding "semantic_switches"
+  let hostABI : String ← field binding "host_abi"
+  let sourceRows : Array Lean.Json ← field binding "frontend_order"
+  let translator : Lean.Json ← field binding "translator"
+  let producer : String ← field translator "sha256"
+  let verified : Bool ← field binding "input_provenance_verified"
+  let certified : Bool ← field binding "linked_core_certified"
+  let executed : Bool ← field binding "lean_argv_executed"
+  let fuel : Nat ← field binding "fuel"
+  let addressSpaceTop : Nat ← field binding "address_space_top"
+  unless ((scope == "configured-ssh-link-input-provenance" && mode == "ssh-inputs-only" && sourceRows.size == 90) ||
+      (scope == "configured-openssh-target-link-input-provenance" && mode == "target-inputs-only") ||
+      (scope == "pinned-openssh-census-unit-input-provenance" && mode == "census-unit-input-only" && sourceRows.size == 1)) &&
+      verified && !certified && !executed && sourceRows.size > 0 &&
+      switches == ["gnu_pointer_conversions"] && producer == expectedProducer &&
+      producer.length == 64 && producer.toList.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f')) &&
+      hostABI == "linux-amd64" && fuel > 0 && addressSpaceTop > 0 && addressSpaceTop < 2^64 do
+    throw (IO.userError "saved program source binding or execution parameters differ")
+  unless (← CerbCoreQuote.hashFile "sha256sum" bindingPath 64) == digest do
+    throw (IO.userError "saved program binding changed while reading")
+  return {
+    producerSHA256 := producer
+    bindingSHA256 := digest
+    sourceCount := sourceRows.size
+    fuel := fuel
+    addressSpaceTop := addressSpaceTop }
+
+
+/-- Schema 1 is a typed JSON data interface, independent of native code layout.
+    Keep its version check explicit: incompatible Core data requires a new
+    schema/codec, never a producer-hash override or a fabricated new export. -/
+def validateHeader (artifact : CerbCoreData.Artifact) (bindingPath : String)
+    (parameters : Parameters) : Bool :=
+  artifact.schemaVersion == 1 &&
+  artifact.sourceBindingPath == bindingPath &&
+  artifact.sourceBindingSHA256 == parameters.bindingSHA256 &&
+  artifact.translatorSHA256 == parameters.producerSHA256 &&
+  artifact.semanticSwitches == "gnu_pointer_conversions" &&
+  artifact.fieldNames == CerbCoreQuote.linkedCoreFieldNames &&
+  artifact.orderedDigests.length == parameters.sourceCount &&
+  artifact.orderedDigests.length > 0 &&
+  artifact.linkedFunctionCount == artifact.snapshot.funs.length &&
+  artifact.linkedGlobalCount == artifact.snapshot.globs.length
+
+/-- Verify original producer/binding/data identities, decode every typed Core
+    constructor, then check lossless reconstruction. No translation is run and
+    no claim about the current translator's output is made. -/
+def decode (bindingPath artifactPath expectedSHA256 expectedProducer : String) : IO (CerbCoreData.Artifact × Parameters) := do
+  CerbCoreQuote.requireAbsolute artifactPath
+  let parameters ← readParameters bindingPath expectedProducer
+  unless (← CerbCoreQuote.hashFile "sha256sum" artifactPath 64) == expectedSHA256 do
+    throw (IO.userError "saved Core artifact SHA-256 differs")
+  let raw ← IO.FS.readFile artifactPath
+  let json ← match Lean.Json.parse raw with
+    | .ok value => pure value
+    | .error error => throw (IO.userError s!"saved Core JSON parse failed: {error}")
+  let artifact : CerbCoreData.Artifact ← match Lean.fromJson? json with
+    | .ok value => pure value
+    | .error error => throw (IO.userError s!"saved Core decode failed: {error}")
+  unless validateHeader artifact bindingPath parameters do
+    throw (IO.userError "saved Core producer, schema or field inventory differs")
+  unless (← CerbCoreQuote.hashFile "sha256sum" artifactPath 64) == expectedSHA256 &&
+      (← CerbCoreQuote.hashFile "sha256sum" bindingPath 64) == parameters.bindingSHA256 do
+    throw (IO.userError "saved Core artifact or binding changed while loading")
+  return (artifact, parameters)
+
+/-- Rebuild maps with this runtime's own comparison code. Cached snapshots
+    contain data only, never native comparator closures. -/
+def reconstruct (artifact : CerbCoreData.Artifact) (parameters : Parameters) : IO Loaded := do
+  let coreFile ← (CerberusFresh.forceIO
+    (fun () => artifact.snapshot.toFile) : BaseIO (file Unit))
+  unless (← (CerberusFresh.forceIO
+      (fun () => CerbCoreQuote.CoreSnapshot.fromFile coreFile == artifact.snapshot) : BaseIO Bool)) do
+    throw (IO.userError "saved Core decoded data changed during reconstruction")
+  return {
+    coreFile := coreFile
+    supply := artifact.supply
+    executionDigest := artifact.executionDigest
+    parameters := parameters }
+
+
+def load (bindingPath artifactPath expectedSHA256 expectedProducer : String) : IO Loaded := do
+  let (artifact, parameters) ← decode bindingPath artifactPath expectedSHA256 expectedProducer
+  reconstruct artifact parameters
+
+end CerbSavedProgram
