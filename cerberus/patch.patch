+        (* Outer pointer definitions can read a nested for-loop index. Include
+           those arithmetic candidates in the same grounded write census before
+           pruning the outer pointer; lexical visitation order is not evidence
+           that an otherwise certified index has no representation origin.
+           These are analysis candidates only, never preinitialized values. *)
+        let nested_scalars = List.filter (fun sym ->
+          not (List.elem sym origin_candidates) &&
+            gnu_alloc_size_subject_unescaped sym whole_body)
+          (gnu_scalar_origin_locals whole_body) in
