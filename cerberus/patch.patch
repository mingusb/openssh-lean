+/* Regression for GNU keyword spellings used by portable OpenSSH's headers. */
+static inline int f(const int *restrict p) { return *p; }
+static inline signed int g(const int *restrict p) { return *p; }
+typedef signed int S;
+typedef typeof(1) T;
+typedef typeof(1) U;
+int main(void) {
+  const int x = 20;
+  const int y = 20;
+  volatile int a = 0;
+  volatile int b = 0;
+  S s = 1;
+  T t = 1;
+  U u = 0;
+  int counter = 0;
+  typeof(counter++) local = 0;
+  int total;
+  if (_Alignof(long) != _Alignof(long)) return 4;
+  /* Keep this keyword regression independent of operand-order enumeration. */
+  total = f(&x);
+  total += g(&y);
+  total += a;
+  total += b;
+  total += s;
+  total += t;
+  total += u;
+  total += counter;
+  total += local;
+  return total;
+}
