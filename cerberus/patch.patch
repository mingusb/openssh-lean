+(* This library call can write only through its destination. A private-global
+   preservation caller has already proved that the global storage cannot escape
+   to that argument. Never use this as a readonly or arbitrary memory summary. *)
+val gnu_standard_bounded_string_write_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_standard_bounded_string_write_call (A.AnnotatedExpression _ _ _ node) =
+  if not (Implementation.has_amd64_sysv_abi ()) then E.return false else
+  match node with
+    | A.AilEcall callee [_; _; _; _] ->
+        if not (gnu_strlcpy_chk_signature (ctype_of callee) &&
+          gnu_inline_direct_designator callee) then E.return false else
+        gnu_inline_function_target callee >>= (function
+          | Nothing -> E.return false
+          | Just (declared, _) ->
+              E.linker_name declared >>= (function
+                | Just name ->
+                    if not (List.elem name ["__strlcpy_chk"; "__strlcat_chk"]) then E.return false else
+                    E.gnu_inline_target declared >>= fun target ->
+                    E.gnu_has_source_definition target >>= fun defined ->
+                    E.gnu_linker_has_source_definition name >>= fun alias_defined ->
+                    gnu_call_attributes callee >>= fun attrs ->
+                    E.return (not defined && not alias_defined &&
+                      not (Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs))
+                | _ -> E.return false end)
+          end)
+    | _ -> E.return false end
