+++ b/frontend/model/gnu_amd64_asm.lem
@@ -0,0 +1,646 @@
+declare {lean} extra_import `CerbMemoPass`
+(* Straight-line AMD64 register semantics for GNU extended assembly.
+
+   Cabs/AIL/Core use this module for the supported register-only contracts.
+   The maintained integration is a candidate awaiting coordinated validation.
+   No instruction, undefined register value or flag is silently erased.
+   Width is the instruction operand width; virtual slots denote whole operands
+   of that same width, not arbitrary overlapping architectural subregisters.
+   A decoder/constraint checker must establish that precondition before use.
+*)
+open import Pervasives
+import String_extra
+
+(* Shared error sequencing for the pure register model and its Core adapter. *)
+val asm_bind: forall 'a 'b. either string 'a -> ('a -> either string 'b) -> either string 'b
+let asm_bind outcome next = match outcome with
+  | Left message -> Left message
+  | Right value -> next value
+end
+let inline (>>=) = asm_bind
+
+type asm_word = maybe integer
+
+type asm_operand =
+  | Asm_Slot of nat
+  | Asm_Immediate of integer
+
+type asm_condition =
+  | Asm_Equal | Asm_Not_equal | Asm_Signed_less | Asm_Signed_less_equal
+  | Asm_Signed_greater | Asm_Signed_greater_equal
+  | Asm_Below | Asm_Below_equal | Asm_Above | Asm_Above_equal
+
+type asm_logical_operation = Asm_Logical_and | Asm_Logical_or | Asm_Logical_xor
+type asm_shift_operation = Asm_Shift_left | Asm_Shift_right | Asm_Shift_arithmetic_right
+
+type asm_instruction =
+  | Asm_Move of asm_operand * nat
+  | Asm_Logical of asm_logical_operation * asm_operand * nat
+  | Asm_Test of asm_operand * asm_operand
+  | Asm_Compare of asm_operand * asm_operand (* AT&T source, destination *)
+  | Asm_Shift of asm_shift_operation * asm_operand * nat
+  | Asm_Bit_scan_forward of asm_operand * nat
+  | Asm_Conditional_move of asm_condition * asm_operand * nat
+
+type asm_flags = <|
+  asm_zero: maybe bool;
+  asm_sign: maybe bool;
+  asm_overflow: maybe bool;
+  asm_carry: maybe bool;
+|>
+
+type asm_machine = <|
+  asm_registers: list asm_word;
+  asm_status: asm_flags;
+|>
+
+let asm_unknown_flags = <| asm_zero= Nothing; asm_sign= Nothing; asm_overflow= Nothing; asm_carry= Nothing |>
+
+val asm_power_two: nat -> integer
+let asm_power_two width = List.foldl (fun value () -> 2 * value) 1 (List.replicate width ())
+
+val asm_narrow: nat -> integer -> integer
+let asm_narrow width value =
+  let modulus = asm_power_two width in
+  let remainder = value mod modulus in
+  if remainder < 0 then remainder + modulus else remainder
+
+val asm_read_slot: nat -> list asm_word -> either string asm_word
+let rec asm_read_slot index values = match values with
+  | [] -> Left "GNU AMD64 asm register index is out of range"
+  | value :: rest -> if index = 0 then Right value else asm_read_slot (index - 1) rest
+end
+
+val asm_write_slot: nat -> asm_word -> list asm_word -> either string (list asm_word)
+let rec asm_write_slot index value values = match values with
+  | [] -> Left "GNU AMD64 asm output register index is out of range"
+  | current :: rest -> if index = 0 then Right (value :: rest)
+      else match asm_write_slot (index - 1) value rest with
+        | Left message -> Left message
+        | Right updated -> Right (current :: updated)
+      end
+end
+
+val asm_read_operand: nat -> asm_operand -> asm_machine -> either string asm_word
+let asm_read_operand width source state = match source with
+  | Asm_Immediate value -> Right (Just (asm_narrow width value))
+  | Asm_Slot index -> match asm_read_slot index state.asm_registers with
+      | Left message -> Left message
+      | Right Nothing -> Right Nothing
+      | Right (Just value) -> Right (Just (asm_narrow width value))
+    end
+end
+
+val asm_write_register: nat -> nat -> asm_word -> asm_flags -> asm_machine -> either string asm_machine
+let asm_write_register width index value asm_status state =
+  let normalized = match value with Nothing -> Nothing | Just n -> Just (asm_narrow width n) end in
+  match asm_write_slot index normalized state.asm_registers with
+    | Left message -> Left message
+    | Right asm_registers -> Right <| asm_registers= asm_registers; asm_status= asm_status |>
+  end
+
+val asm_bitwise: nat -> asm_logical_operation -> integer -> integer -> integer
+let asm_bitwise width operation left right =
+  let (_, _, _, result) = List.foldl (fun (left, right, place, result) () ->
+    let a = left mod 2 in
+    let b = right mod 2 in
+    let bit = match operation with
+      | Asm_Logical_and -> if a = 1 && b = 1 then 1 else 0
+      | Asm_Logical_or -> if a = 1 || b = 1 then 1 else 0
+      | Asm_Logical_xor -> if a <> b then 1 else 0
+    end in
+    (left / 2, right / 2, place * 2, result + place * bit)
+  ) (left, right, 1, 0) (List.replicate width ()) in result
+
+val asm_negative: nat -> integer -> bool
+let asm_negative width value = value >= asm_power_two (width - 1)
+
+(* Unknown machine bits are not arbitrary constants. These identities recover
+   results independent of those bits; all other unknown results remain unknown. *)
+val asm_logical_value: nat -> asm_logical_operation -> asm_word -> asm_word -> asm_word
+let asm_logical_value width operation left right = match (left, right) with
+  | (Just a, Just b) -> Just (asm_bitwise width operation a b)
+  | _ -> match operation with
+      | Asm_Logical_and -> if left = Just 0 || right = Just 0 then Just 0 else Nothing
+      | Asm_Logical_or -> let all = asm_power_two width - 1 in
+          if left = Just all || right = Just all then Just all else Nothing
+      | Asm_Logical_xor -> Nothing
+    end
+end
+
+val asm_logical_flags: nat -> asm_word -> asm_flags
+let asm_logical_flags width value = match value with
+  | Nothing -> <| asm_zero= Nothing; asm_sign= Nothing; asm_overflow= Just false; asm_carry= Just false |>
+  | Just n -> <| asm_zero= Just (n = 0); asm_sign= Just (asm_negative width n);
+                asm_overflow= Just false; asm_carry= Just false |>
+end
+
+val asm_compare_flags: nat -> asm_word -> asm_word -> asm_flags
+let asm_compare_flags width source destination = match (source, destination) with
+  | (Just src, Just dst) ->
+      let result = asm_narrow width (dst - src) in
+      let a = asm_negative width dst in
+      let b = asm_negative width src in
+      let r = asm_negative width result in
+      <| asm_zero= Just (result = 0); asm_sign= Just r;
+         asm_overflow= Just (a <> b && r <> a); asm_carry= Just (dst < src) |>
+  | _ -> asm_unknown_flags
+end
+
+val asm_negate_flag: maybe bool -> maybe bool
+let asm_negate_flag value = match value with Nothing -> Nothing | Just b -> Just (not b) end
+
+val asm_and_flag: maybe bool -> maybe bool -> maybe bool
+let asm_and_flag left right = match (left, right) with
+  | (Just false, _) -> Just false
+  | (_, Just false) -> Just false
+  | (Just true, Just true) -> Just true
+  | _ -> Nothing
+end
+
+val asm_or_flag: maybe bool -> maybe bool -> maybe bool
+let asm_or_flag left right = asm_negate_flag (asm_and_flag (asm_negate_flag left) (asm_negate_flag right))
+
+val asm_condition_value: asm_condition -> asm_flags -> maybe bool
+let asm_condition_value asm_condition asm_status =
+  let less = match (asm_status.asm_sign, asm_status.asm_overflow) with
+    | (Just s, Just o) -> Just (s <> o)
+    | _ -> Nothing
+  end in
+  match asm_condition with
+    | Asm_Equal -> asm_status.asm_zero
+    | Asm_Not_equal -> asm_negate_flag asm_status.asm_zero
+    | Asm_Signed_less -> less
+    | Asm_Signed_less_equal -> asm_or_flag less asm_status.asm_zero
+    | Asm_Signed_greater -> asm_and_flag (asm_negate_flag less) (asm_negate_flag asm_status.asm_zero)
+    | Asm_Signed_greater_equal -> asm_negate_flag less
+    | Asm_Below -> asm_status.asm_carry
+    | Asm_Below_equal -> asm_or_flag asm_status.asm_carry asm_status.asm_zero
+    | Asm_Above -> asm_and_flag (asm_negate_flag asm_status.asm_carry) (asm_negate_flag asm_status.asm_zero)
+    | Asm_Above_equal -> asm_negate_flag asm_status.asm_carry
+  end
+
+val asm_first_bit: nat -> integer -> integer
+let asm_first_bit remaining value =
+  let (_, result, _) = List.foldl (fun (value, index, found) () ->
+    if found || value mod 2 = 1 then (value, index, true)
+    else (value / 2, index + 1, false)
+  ) (value, 0, false) (List.replicate remaining ()) in result
+
+(* The count is masked as an x86 count, not a C shift count. Integer exponent
+   conversion is bounded by the 5/6-bit mask and never uses a negative value. *)
+val asm_masked_count: nat -> integer -> nat
+let asm_masked_count width value = natFromInteger (value mod (if width = 64 then 64 else 32))
+
+val asm_shift_value: nat -> asm_shift_operation -> nat -> integer -> integer
+let asm_shift_value width operation count value =
+  let mask = asm_power_two width - 1 in
+  match operation with
+    | Asm_Shift_left -> asm_narrow width (value * asm_power_two count)
+    | Asm_Shift_right -> value / asm_power_two count
+    | Asm_Shift_arithmetic_right ->
+        if not (asm_negative width value) then value / asm_power_two count
+        else if count >= width then mask
+        else value / asm_power_two count + asm_power_two width - asm_power_two (width - count)
+  end
+
+val asm_shift_flags: nat -> asm_shift_operation -> nat -> integer -> integer -> asm_flags
+let asm_shift_flags width operation count before after =
+  let asm_carry = match operation with
+    | Asm_Shift_left -> if count >= width then Nothing
+        else Just ((before / asm_power_two (width - count)) mod 2 = 1)
+    | Asm_Shift_right -> if count >= width then Nothing
+        else Just ((before / asm_power_two (count - 1)) mod 2 = 1)
+    | Asm_Shift_arithmetic_right -> if count >= width then Just (asm_negative width before)
+        else Just ((before / asm_power_two (count - 1)) mod 2 = 1)
+  end in
+  let asm_overflow = if count <> 1 then Nothing else match operation with
+    | Asm_Shift_arithmetic_right -> Just false
+    | Asm_Shift_right -> Just (asm_negative width before)
+    | Asm_Shift_left -> match asm_carry with
+        | Just c -> Just (asm_negative width after <> c)
+        | Nothing -> Nothing
+      end
+  end in
+  <| asm_zero= Just (after = 0); asm_sign= Just (asm_negative width after);
+     asm_overflow= asm_overflow; asm_carry= asm_carry |>
+
+val asm_same_slot: asm_operand -> nat -> bool
+let asm_same_slot source destination = match source with
+  | Asm_Slot index -> index = destination
+  | _ -> false
+end
+
+val asm_step: nat -> asm_instruction -> asm_machine -> either string asm_machine
+let asm_step width instruction state =
+  let read operand = asm_read_operand width operand state in
+  let write destination value flags = asm_write_register width destination value flags state in
+  if not (List.elem width [8; 16; 32; 64]) then
+    Left "GNU AMD64 asm operand width is unsupported"
+  else match instruction with
+    | Asm_Move source destination ->
+        read source >>= fun value ->
+        write destination value state.asm_status
+    | Asm_Logical operation source destination ->
+        read source >>= fun left ->
+        read (Asm_Slot destination) >>= fun right ->
+        let value = match operation with
+          | Asm_Logical_xor ->
+              if asm_same_slot source destination then Just 0
+              else asm_logical_value width operation left right
+          | _ -> asm_logical_value width operation left right
+        end in
+        write destination value (asm_logical_flags width value)
+    | Asm_Test source destination ->
+        read source >>= fun left ->
+        read destination >>= fun right ->
+        let value = asm_logical_value width Asm_Logical_and left right in
+        Right <| state with asm_status= asm_logical_flags width value |>
+    | Asm_Compare source destination ->
+        read source >>= fun left ->
+        read destination >>= fun right ->
+        let same = match (source, destination) with
+          | (Asm_Slot a, Asm_Slot b) -> a = b
+          | _ -> false
+        end in
+        let flags = if same then
+          <| asm_zero= Just true; asm_sign= Just false; asm_overflow= Just false; asm_carry= Just false |>
+          else asm_compare_flags width left right in
+        Right <| state with asm_status= flags |>
+    | Asm_Shift operation source destination ->
+        read source >>= fun count_value ->
+        read (Asm_Slot destination) >>= fun value ->
+        (match count_value with
+          | Nothing -> write destination Nothing asm_unknown_flags
+          | Just raw_count ->
+              let count = asm_masked_count width raw_count in
+              if count = 0 then Right state else
+              match value with
+                | Nothing -> write destination Nothing asm_unknown_flags
+                | Just before ->
+                    let after = asm_shift_value width operation count before in
+                    write destination (Just after) (asm_shift_flags width operation count before after)
+              end
+        end)
+    | Asm_Bit_scan_forward source destination ->
+        if width = 8 then Left "GNU AMD64 asm has no 8-bit BSF instruction" else
+        read source >>= function
+          | Nothing -> write destination Nothing asm_unknown_flags
+          | Just value ->
+              let result = if value = 0 then Nothing else Just (asm_first_bit width value) in
+              write destination result <| asm_unknown_flags with asm_zero= Just (value = 0) |>
+        end
+    | Asm_Conditional_move condition source destination ->
+        if width = 8 then Left "GNU AMD64 asm has no 8-bit CMOV instruction" else
+        read source >>= fun source_value ->
+        read (Asm_Slot destination) >>= fun previous ->
+        let result = match asm_condition_value condition state.asm_status with
+          | Just true -> source_value
+          | Just false -> previous
+          | Nothing -> if source_value = previous then previous else Nothing
+        end in
+        write destination result state.asm_status
+  end
+
+val asm_execute: nat -> list asm_instruction -> asm_machine -> either string asm_machine
+let rec asm_execute width instructions state = match instructions with
+  | [] -> Right state
+  | asm_instruction :: rest -> match asm_step width asm_instruction state with
+      | Left message -> Left message
+      | Right next -> asm_execute width rest next
+    end
+end
+
+declare {lean} termination_argument asm_read_slot = automatic
+declare {lean} termination_argument asm_write_slot = automatic
+declare {lean} termination_argument asm_execute = automatic
+
+(* The template decoder consumes instruction syntax rather than recognizing
+   application-specific template strings. Unsupported addressing, flags,
+   directives and subregister aliases remain explicit errors. *)
+val asm_split_chars: (char -> bool) -> list char -> list (list char)
+let asm_split_chars separator chars =
+  let (finished, current) = List.foldl (fun (finished, current) c ->
+    if separator c then (List.reverse current :: finished, [])
+    else (finished, c :: current)
+  ) ([], []) chars in List.reverse (List.reverse current :: finished)
+
+let asm_horizontal_space c = c = #' ' || c = #'\t' || c = #'\r'
+
+val asm_trim_chars: list char -> list char
+let asm_trim_chars chars =
+  List.reverse (List.dropWhile asm_horizontal_space (List.reverse (List.dropWhile asm_horizontal_space chars)))
+
+val asm_digit_value: char -> maybe integer
+let asm_digit_value c =
+  let code = String_extra.ord c in
+  if code >= 48 && code <= 57 then Just (integerFromNat (code - 48))
+  else if code >= 97 && code <= 102 then Just (10 + integerFromNat (code - 97))
+  else if code >= 65 && code <= 70 then Just (10 + integerFromNat (code - 65))
+  else Nothing
+
+val asm_unsigned_number: integer -> list char -> either string integer
+let asm_unsigned_number base chars =
+  if chars = [] then Left "GNU AMD64 asm expected an integer" else
+  List.foldl (fun result c -> match result with
+    | Left message -> Left message
+    | Right n -> match asm_digit_value c with
+        | Just digit -> if digit < base then Right (base * n + digit)
+            else Left "GNU AMD64 asm integer digit is out of range"
+        | Nothing -> Left "GNU AMD64 asm integer expression is unsupported"
+      end
+  end) (Right 0) chars
+
+val asm_immediate_number: list char -> either string integer
+let asm_immediate_number chars =
+  let (asm_negative, digits) = match chars with
+    | #'-' :: rest -> (true, rest)
+    | #'+' :: rest -> (false, rest)
+    | _ -> (false, chars)
+  end in
+  let parsed = match digits with
+    | #'0' :: #'x' :: rest -> asm_unsigned_number 16 rest
+    | #'0' :: #'X' :: rest -> asm_unsigned_number 16 rest
+    | #'0' :: rest -> if rest = [] then Right 0 else asm_unsigned_number 8 rest
+    | _ -> asm_unsigned_number 10 digits
+  end in
+  match parsed with
+    | Left message -> Left message
+    | Right value -> Right (if asm_negative then 0 - value else value)
+  end
+
+val asm_named_slot: list (string * nat) -> list char -> either string asm_operand
+let asm_named_slot names chars = match List.reverse chars with
+  | #']' :: reversed ->
+      let name = String.toString (List.reverse reversed) in
+      match List.filter (fun (candidate, _) -> candidate = name) names with
+        | [(_, slot)] -> Right (Asm_Slot slot)
+        | _ -> Left "GNU AMD64 asm symbolic operand is missing or ambiguous"
+      end
+  | _ -> Left "GNU AMD64 asm malformed symbolic operand"
+end
+
+val asm_operand_reference: list (string * nat) -> list char -> either string asm_operand
+let asm_operand_reference names chars = match chars with
+  | #'[' :: rest -> asm_named_slot names rest
+  | _ -> match asm_unsigned_number 10 chars with
+      | Left message -> Left message
+      | Right index -> Right (Asm_Slot (natFromInteger index))
+    end
+end
+
+val asm_decode_operand: nat -> maybe nat -> list (string * nat) -> list char -> either string asm_operand
+let asm_decode_operand width count_slot names chars = match asm_trim_chars chars with
+  | #'$' :: rest -> match asm_immediate_number rest with
+      | Left message -> Left message
+      | Right value -> Right (Asm_Immediate value)
+    end
+  | [#'%'; #'%'; #'c'; #'l'] -> match count_slot with
+      | Just index -> Right (Asm_Slot index)
+      | Nothing -> Left "GNU AMD64 asm uses CL without a unique count-register operand"
+    end
+  | #'%' :: rest -> match rest with
+      | #'w' :: tail -> if width = 16 then asm_operand_reference names tail
+          else Left "GNU AMD64 asm mixed-width register alias is unsupported"
+      | #'k' :: tail -> if width = 32 then asm_operand_reference names tail
+          else Left "GNU AMD64 asm mixed-width register alias is unsupported"
+      | #'q' :: tail -> if width = 64 then asm_operand_reference names tail
+          else Left "GNU AMD64 asm mixed-width register alias is unsupported"
+      | #'b' :: tail -> if width = 8 then asm_operand_reference names tail
+          else Left "GNU AMD64 asm mixed-width register alias is unsupported"
+      | _ -> asm_operand_reference names rest
+    end
+  | _ -> Left "GNU AMD64 asm memory or fixed-register addressing is unsupported"
+end
+
+val asm_decode_condition: string -> maybe asm_condition
+let asm_decode_condition opcode = match opcode with
+  | "cmove" -> Just Asm_Equal | "cmovz" -> Just Asm_Equal
+  | "cmovne" -> Just Asm_Not_equal | "cmovnz" -> Just Asm_Not_equal
+  | "cmovl" -> Just Asm_Signed_less | "cmovnge" -> Just Asm_Signed_less
+  | "cmovle" -> Just Asm_Signed_less_equal | "cmovng" -> Just Asm_Signed_less_equal
+  | "cmovg" -> Just Asm_Signed_greater | "cmovnle" -> Just Asm_Signed_greater
+  | "cmovge" -> Just Asm_Signed_greater_equal | "cmovnl" -> Just Asm_Signed_greater_equal
+  | "cmovb" -> Just Asm_Below | "cmovc" -> Just Asm_Below | "cmovnae" -> Just Asm_Below
+  | "cmovbe" -> Just Asm_Below_equal | "cmovna" -> Just Asm_Below_equal
+  | "cmova" -> Just Asm_Above | "cmovnbe" -> Just Asm_Above
+  | "cmovae" -> Just Asm_Above_equal | "cmovnb" -> Just Asm_Above_equal | "cmovnc" -> Just Asm_Above_equal
+  | _ -> Nothing
+end
+
+val asm_register_source: asm_operand -> bool
+let asm_register_source source = match source with Asm_Slot _ -> true | _ -> false end
+
+val asm_immediate_encodable: nat -> asm_operand -> bool
+let asm_immediate_encodable width source = match source with
+  | Asm_Slot _ -> true
+  | Asm_Immediate value ->
+      if value < (0 - asm_power_two (width - 1)) || value >= asm_power_two width then false
+      else if width = 64 then
+        let unsigned = asm_narrow width value in
+        let signed = if asm_negative width unsigned then unsigned - asm_power_two width else unsigned in
+        signed >= (0 - 2147483648) && signed <= 2147483647
+      else true
+end
+
+val asm_decode_opcode: nat -> maybe nat -> string -> asm_operand -> nat -> either string asm_instruction
+let asm_decode_opcode width count_slot opcode source destination =
+  let shift operation = match source with
+    | Asm_Immediate value -> if value >= (0 - 128) && value <= 255 then
+          Right (Asm_Shift operation source destination)
+        else Left "GNU AMD64 asm immediate shift count is outside its byte encoding"
+    | Asm_Slot index -> if count_slot = Just index then Right (Asm_Shift operation source destination)
+        else Left "GNU AMD64 asm variable shift requires the count register"
+  end in
+  let logical operation = if asm_immediate_encodable width source then
+      Right (Asm_Logical operation source destination)
+    else Left "GNU AMD64 asm logical immediate cannot use this encoding" in
+  match opcode with
+    | "mov" -> (match source with
+        | Asm_Immediate value ->
+            if value < (0 - asm_power_two (width - 1)) || value >= asm_power_two width then
+              Left "GNU AMD64 asm move immediate exceeds the operand encoding"
+            else Right (Asm_Move source destination)
+        | _ -> Right (Asm_Move source destination)
+      end)
+    | "and" -> logical Asm_Logical_and
+    | "or" -> logical Asm_Logical_or
+    | "xor" -> logical Asm_Logical_xor
+    | "shl" -> shift Asm_Shift_left
+    | "sal" -> shift Asm_Shift_left
+    | "shr" -> shift Asm_Shift_right
+    | "sar" -> shift Asm_Shift_arithmetic_right
+    | "test" -> if asm_immediate_encodable width source then Right (Asm_Test source (Asm_Slot destination))
+        else Left "GNU AMD64 asm test immediate cannot use this encoding"
+    | "cmp" -> if asm_immediate_encodable width source then Right (Asm_Compare source (Asm_Slot destination))
+        else Left "GNU AMD64 asm compare immediate cannot use this encoding"
+    | "bsf" -> if width <> 8 && asm_register_source source then Right (Asm_Bit_scan_forward source destination)
+        else Left "GNU AMD64 asm BSF source or width is invalid"
+    | _ -> match asm_decode_condition opcode with
+        | Just asm_condition -> if width <> 8 && asm_register_source source then
+              Right (Asm_Conditional_move asm_condition source destination)
+            else Left "GNU AMD64 asm CMOV source or width is invalid"
+        | Nothing -> Left ("GNU AMD64 asm instruction is unsupported: " ^ opcode)
+      end
+  end
+
+val asm_decode_instruction: nat -> maybe nat -> list (string * nat) -> list char -> either string asm_instruction
+let asm_decode_instruction width count_slot names chars =
+  let trimmed = asm_trim_chars chars in
+  let mnemonic = List.takeWhile (fun c -> not (asm_horizontal_space c)) trimmed in
+  let rest = List.drop (List.length mnemonic) trimmed in
+  match (List.reverse mnemonic, asm_split_chars (fun c -> c = #',') rest) with
+    | (suffix :: reversed, [source_text; destination_text]) ->
+        let opcode = String.toString (List.reverse reversed) in
+        let is_shift = List.elem opcode ["shl"; "sal"; "shr"; "sar"] in
+        let source_text = asm_trim_chars source_text in
+        let destination_text = asm_trim_chars destination_text in
+        let fixed_count = source_text = [#'%'; #'%'; #'c'; #'l'] in
+        let byte_modifier = match source_text with #'%' :: #'b' :: _ -> true | _ -> false end in
+        let immediate = match source_text with #'$' :: _ -> true | _ -> false end in
+        let instruction_width = match suffix with
+          | #'b' -> 8 | #'w' -> 16 | #'l' -> 32 | #'q' -> 64 | _ -> 0
+        end in
+        if instruction_width <> width then Left "GNU AMD64 asm operand width is missing or inconsistent"
+        else if (fixed_count && not is_shift) || destination_text = [#'%'; #'%'; #'c'; #'l'] then
+          Left "GNU AMD64 asm fixed count register is supported only as a shift source"
+        else if is_shift && not (immediate || fixed_count || byte_modifier) then
+          Left "GNU AMD64 asm variable shift needs an explicit CL byte spelling"
+        else match (asm_decode_operand (if is_shift && byte_modifier then 8 else width) count_slot names source_text,
+                    asm_decode_operand width count_slot names destination_text) with
+          | (Left message, _) -> Left message
+          | (_, Left message) -> Left message
+          | (Right source, Right (Asm_Slot destination)) ->
+              asm_decode_opcode width count_slot opcode source destination
+          | _ -> Left "GNU AMD64 asm destination must be a register operand"
+        end
+    | _ -> Left "GNU AMD64 asm instruction needs a mnemonic and two operands"
+  end
+
+val asm_decode_template: nat -> maybe nat -> list (string * nat) -> string -> either string (list asm_instruction)
+let asm_decode_template width count_slot names template =
+  let lines = List.filter (fun line -> asm_trim_chars line <> [])
+    (asm_split_chars (fun c -> c = #'\n' || c = #';') (String.toCharList template)) in
+  List.foldl (fun accumulated line ->
+    accumulated >>= fun instructions ->
+    asm_decode_instruction width count_slot names line >>= fun instruction ->
+    Right (instruction :: instructions)
+  ) (Right []) lines >>= fun reversed ->
+  Right (List.reverse reversed)
+
+(* Allocation-independent register-only contract. Output slots represent
+   distinct output operands; the C bridge must reject aliased output lvalues
+   unless it models their writeback ordering. Input registers may overlap a
+   non-early-clobber output, so every input read must precede that output's
+   first write. Reads and writes within one instruction happen in that order.
+   Undefined output register bits are permitted here: the instruction model
+   can recover them (xor-self or BSF-zero followed by CMOV), and the bridge
+   must reject any unknown final observable output instead of inventing bits. *)
+type asm_output_contract = bool * bool * bool (* read/write, early clobber, fixed C *)
+
+val asm_output_constraint: string -> either string asm_output_contract
+let asm_output_constraint constraint = match constraint with
+  | "=r" -> Right (false, false, false)
+  | "=&r" -> Right (false, true, false)
+  | "+r" -> Right (true, false, false)
+  | "+&r" -> Right (true, true, false)
+  | "=c" -> Right (false, false, true)
+  | "=&c" -> Right (false, true, true)
+  | "+c" -> Right (true, false, true)
+  | "+&c" -> Right (true, true, true)
+  | _ -> Left "GNU AMD64 asm output constraint is unsupported (register r/c, =/+, optional & required)"
+end
+
+val asm_input_constraint: string -> either string bool
+let asm_input_constraint constraint = match constraint with
+  | "r" -> Right false
+  | "c" -> Right true
+  | _ -> Left "GNU AMD64 asm input constraint or matching-operand tie is not yet supported"
+end
+
+val asm_sequence_results: forall 'a. list (either string 'a) -> either string (list 'a)
+let asm_sequence_results results = List.foldr (fun result acc -> match (result, acc) with
+  | (Left message, _) -> Left message
+  | (_, Left message) -> Left message
+  | (Right value, Right values) -> Right (value :: values)
+end) (Right []) results
+
+val asm_slot_reads: asm_operand -> list nat
+let asm_slot_reads operand = match operand with Asm_Slot slot -> [slot] | _ -> [] end
+
+val asm_instruction_accesses: asm_instruction -> list nat * maybe nat * bool
+let asm_instruction_accesses instruction = match instruction with
+  | Asm_Move source dest -> (asm_slot_reads source, Just dest, false)
+  | Asm_Logical _ source dest -> (asm_slot_reads source ++ [dest], Just dest, true)
+  | Asm_Test source dest -> (asm_slot_reads source ++ asm_slot_reads dest, Nothing, true)
+  | Asm_Compare source dest -> (asm_slot_reads source ++ asm_slot_reads dest, Nothing, true)
+  | Asm_Shift _ source dest -> (asm_slot_reads source ++ [dest], Just dest, true)
+  | Asm_Bit_scan_forward source dest -> (asm_slot_reads source, Just dest, true)
+  | Asm_Conditional_move _ source dest -> (asm_slot_reads source ++ [dest], Just dest, false)
+end
+
+val asm_validate_instruction_contract:
+  nat -> list (nat * asm_output_contract) -> bool -> list asm_instruction -> either string unit
+let asm_validate_instruction_contract total_slots outputs has_cc instructions =
+  let noutputs = List.length outputs in
+  let original_input written slot = if slot >= noutputs then true else
+    match List.lookup slot outputs with
+      | Just (read_write, _, _) -> read_write && not (List.elem slot written)
+      | Nothing -> false
+    end in
+  let dangerous_write slot = match List.lookup slot outputs with
+    | Just (_, early, _) -> not early
+    | Nothing -> false
+  end in
+  match List.foldl (fun result instruction -> match result with
+    | Left message -> Left message
+    | Right written ->
+        let (reads, destination, modifies_flags) = asm_instruction_accesses instruction in
+        if List.any (fun slot -> slot >= total_slots) reads ||
+            maybe false (fun slot -> slot >= total_slots) destination then
+          Left "GNU AMD64 asm operand reference is out of range"
+        else if maybe false (fun slot -> slot >= noutputs) destination then
+          Left "GNU AMD64 asm writes an input-only operand"
+        else if modifies_flags && not has_cc then
+          Left "GNU AMD64 asm modifies flags without a cc clobber"
+        else if List.any (fun read -> original_input written read &&
+            List.any (fun output -> output <> read && dangerous_write output) written) reads then
+          Left "GNU AMD64 asm output may clobber a later input read; early-clobber constraint required"
+        else Right (match destination with
+          | Just slot -> if List.elem slot written then written else slot :: written
+          | Nothing -> written
+        end)
+  end) (Right []) instructions with
+    | Left message -> Left message
+    | Right _ -> Right ()
+  end
+
+val asm_validate_contract:
+  nat -> list (maybe string * string) -> list (maybe string * string) -> list string -> string ->
+  either string (list asm_instruction * list bool * maybe nat)
+let asm_validate_contract width outputs inputs clobbers template =
+  if not (List.elem width [8; 16; 32; 64]) then Left "GNU AMD64 asm operand width is unsupported"
+  else if not (List.all (fun clobber -> clobber = "cc") clobbers) then
+    Left "GNU AMD64 asm register/memory clobbers are not yet implemented"
+  else
+    let (_, names) = List.foldl (fun (index, names) (name, _) ->
+      (index + 1, match name with Just name -> (name, index) :: names | Nothing -> names end)
+    ) (0, []) (outputs ++ inputs) in
+    let duplicate_name = List.any (fun (name, _) -> name = "" ||
+      List.length (List.filter (fun (other, _) -> name = other) names) <> 1) names in
+    if duplicate_name then Left "GNU AMD64 asm operand names are empty or duplicated" else
+    asm_sequence_results (List.map (fun (_, constraint) -> asm_output_constraint constraint) outputs) >>= fun output_contracts ->
+    asm_sequence_results (List.map (fun (_, constraint) -> asm_input_constraint constraint) inputs) >>= fun input_counts ->
+    let (_, indexed_outputs) = List.foldl (fun (index, acc) contract ->
+      (index + 1, acc ++ [(index, contract)])) (0, []) output_contracts in
+    let count_bindings = List.map (fun (_, _, fixed_count) -> fixed_count) output_contracts ++ input_counts in
+    let (_, count_slots) = List.foldl (fun (index, acc) fixed_count ->
+      (index + 1, if fixed_count then index :: acc else acc)) (0, []) count_bindings in
+    if List.length count_slots > 1 then
+      Left "GNU AMD64 asm multiple fixed count-register operands require tie analysis"
+    else
+      let count_slot = match count_slots with [slot] -> Just slot | _ -> Nothing end in
+      asm_decode_template width count_slot names template >>= fun instructions ->
+      asm_validate_instruction_contract (List.length outputs + List.length inputs)
+        indexed_outputs (List.elem "cc" clobbers) instructions >>= fun () ->
+      Right (instructions, List.map (fun (read_write, _, _) -> read_write) output_contracts, count_slot)
