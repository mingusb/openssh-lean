+import Lean.Compiler.LCNF
+import CerbMemo
+
+open Lean Compiler LCNF
+register_option cerbMemo.enabled : Bool := {
+  defValue := true
+  descr := "Automatic memoization of classified pure computations"
+}
+namespace CerbMemoPass
+
+private def primitiveNamespaces : List Name :=
+  [`Nat, `Int, `UInt8, `UInt16, `UInt32, `UInt64, `USize, `Bool, `Char,
+   `String, `Array, `ByteArray, `Float, `Float32]
+
+private def isPrimitive (env : Environment) (name : Name) : Bool :=
+  (primitiveNamespaces.any (·.isPrefixOf name) || name == `System.Platform.getNumBits || name == `panicCore) &&
+    ((env.getModuleIdxFor? name).any fun idx =>
+      (`Init).isPrefixOf env.header.moduleNames[idx]!)
+
+private def isInfrastructure (name : Name) : Bool :=
+  (`CerbMemo).isPrefixOf name || (`CerbMemoPass).isPrefixOf name
+
+private partial def inspectType (t : Expr) : Bool :=
+  match t with
+  | .const n _ =>
+    [`IO, `BaseIO, `EIO, `EST, `ST, `EStateM, `IO.RealWorld].any (·.isPrefixOf n)
+  | .app f a => inspectType f || inspectType a
+  | .forallE _ d b _ | .lam _ d b _ => inspectType d || inspectType b
+  | .letE _ t v b _ => inspectType t || inspectType v || inspectType b
+  | .mdata _ b | .proj _ _ b => inspectType b
+  | _ => false
+
+/- panicCore is admitted only for the executable's enforced abort-on-panic
+   profile. A reached panic cannot produce a result to insert in the cache.
+   Unsafe *bodies* are inspected transitively; unsafe native boundaries and
+   unresolved calls are not licensed merely by having a pure result type.
+
+   Callback requirements are inferred from bodies and discharged using actual
+   argument provenance. A pure result type alone never licenses caching. -/
+private inductive Value where
+  | unknown
+  | parameter (index : Nat)
+  | function (name : Name) (captured : Array Value)
+  | localFunction
+  deriving Inhabited
+
+private structure Call where
+  name : Name
+  args : Array Value
+
+private structure Node where
+  arity : Nat := 0
+  deps : NameSet := {}
+  calls : Array Call := #[]
+  required : Array Nat := #[]
+  reason : Option String := none
+  small : Bool := false
+  constructionOnly : Bool := false
+
+private def require (node : Node) (index : Nat) : Node :=
+  if node.required.contains index then node
+  else { node with required := node.required.push index }
+
+private def argValue (values : FVarIdMap Value) : Arg .pure → Value
+  | .fvar id => (values.get? id).getD .unknown
+  | _ => .unknown
+
+private partial def inspect (code : Code .pure) (values : FVarIdMap Value)
+    (node : Node) : Node :=
+  match code with
+  | .let d k =>
+    let (value, node) := match d.value with
+      | .const name _ args =>
+        let args := args.map (argValue values)
+        (.function name args, { node with
+          deps := node.deps.insert name
+          calls := node.calls.push { name, args } })
+      | .fvar id args =>
+        let source := (values.get? id).getD .unknown
+        if args.isEmpty then (source, node)
+        else
+          let node := match source with
+            | .parameter i => require node i
+            | .localFunction => node
+            | .function name captured => { node with
+                deps := node.deps.insert name
+                calls := node.calls.push { name, args := captured ++ args.map (argValue values) } }
+            | .unknown => { node with reason := some "unresolved indirect call" }
+          (.unknown, node)
+      | _ => (.unknown, node)
+    inspect k (values.insert d.fvarId value) node
+  | .fun d k | .jp d k =>
+    let values := values.insert d.fvarId .localFunction
+    let inner := d.params.foldl (fun values p => values.insert p.fvarId .unknown) values
+    inspect k values (inspect d.value inner node)
+  | .cases c => c.alts.foldl (fun node a => inspect a.getCode values node) node
+  | .return _ | .jmp _ _ => node
+  | .unreach _ => { node with reason := some "unreachable/panic path" }
+
+/-- Resolved summaries are recorded before insertion of unsafe runtime calls. -/
+private initialize summaries : SimplePersistentEnvExtension (Name × Node) (NameMap Node) ←
+  registerSimplePersistentEnvExtension {
+    addEntryFn := fun state (name, node) => state.insert name node
+    addImportedFn := fun modules => modules.foldl (fun state entries =>
+      entries.foldl (fun state (name, node) => state.insert name node) state) {}
+    asyncMode := .sync
+    -- Match splitters can be compiled in a realization branch. Preserve its
+    -- summaries when Lean merges the branch, without duplicating prior entries.
+    replay? := some <| SimplePersistentEnvExtension.replayOfFilter
+      (fun state entry => !state.contains entry.1)
+      (fun state (name, node) => state.insert name node)
+  }
+
+private partial def collect (pending : List Name) (localDecls : NameMap (Decl .pure))
+    (graph : NameMap Node := {}) : CompilerM (NameMap Node) := do
+  match pending with
+  | [] => return graph
+  | name :: rest =>
+    if graph.contains name then return ← collect rest localDecls graph
+    let env ← getEnv
+    if !localDecls.contains name then
+      if let some node := (summaries.getState env).find? name then
+        return ← collect rest localDecls (graph.insert name node)
+    if let some (.ctorInfo ci) := env.find? name then
+      return ← collect rest localDecls
+        (graph.insert name { arity := ci.numParams + ci.numFields, constructionOnly := true })
+    let found ← match localDecls.find? name with
+      | some d => pure (some d)
+      | none => getMonoDecl? name
+    let some d := found |
+      return ← collect rest localDecls
+        (graph.insert name { reason := some "callee implementation unavailable" })
+    let rawTypeBad := (env.find? name).any fun ci => inspectType ci.type
+    -- Inlining can carry an earlier cache wrapper into a later body. Its
+    -- logical behavior is thunk application, still requiring a pure thunk.
+    let memoIntrinsic := name == `CerbMemo.evalImpl || name == `CerbMemo.evalImpl._redArg
+    let node ← if memoIntrinsic then
+        pure { arity := d.params.size, required := #[d.params.size - 1] }
+      else if isInfrastructure name then
+        pure { arity := d.params.size, reason := some "cache infrastructure" }
+      else if rawTypeBad then
+        pure { arity := d.params.size, reason := some "effectful state/world type" }
+      else match d.value with
+        | .extern _ => pure { arity := d.params.size, reason := if isPrimitive env name then none else some "unclassified native boundary" }
+        | .code code =>
+          let values := d.params.toList.zipIdx.foldl
+            (fun values (p, i) => values.insert p.fvarId (.parameter i)) ({} : FVarIdMap Value)
+          pure (inspect code values { arity := d.params.size, small := !d.recursive && d.size < 24 })
+    collect (node.deps.toList ++ rest) localDecls (graph.insert name node)
+
+/-- Require a supplied callback to be pure for every argument it may receive.
+    Unknown projections/results stay uncached rather than being assumed pure. -/
+private partial def pureArgument (graph : NameMap Node) (node : Node) : Value → Node
+  | .parameter i => require node i
+  | .localFunction => node -- its complete body was inspected with its enclosing body
+  | .unknown => { node with reason := some "callback provenance unavailable" }
+  | .function name captured =>
+    match graph.find? name with
+    | none => { node with reason := some s!"callback summary unavailable: {name}" }
+    | some target =>
+      if target.reason.isSome then
+        { node with reason := some s!"uncacheable callback {name}" }
+      else if captured.size >= target.arity then
+        { node with reason := some s!"returned callback provenance unavailable: {name}" }
+      else
+        target.required.foldl (fun node i =>
+          match captured[i]? with
+          | some value => pureArgument graph node value
+          | none => { node with reason := some s!"callback needs unknown callback argument: {name}" }) node
+
+private def propagate (graph : NameMap Node) : NameMap Node := Id.run do
+  let mut current := graph
+  -- Each productive pass adds a required parameter or marks a node uncacheable.
+  let bound := graph.toList.foldl (fun n (_, node) => n + node.arity + 1) 1
+  for _ in [:bound] do
+    let mut changed := false
+    for (name, old) in current.toList do
+      if old.reason.isSome then continue
+      let mut node := old
+      for call in old.calls do
+        match current.find? call.name with
+        | none => node := { node with reason := some s!"callee summary unavailable: {call.name}" }
+        | some target =>
+          if target.reason.isSome then
+            node := { node with reason := some s!"depends on uncacheable {call.name}" }
+          else if call.args.size > target.arity then
+            node := { node with reason := some s!"returned callback provenance unavailable: {call.name}" }
+          else
+            for i in target.required do
+              -- A missing argument denotes partial application, not invocation.
+              if let some value := call.args[i]? then
+                node := pureArgument current node value
+      if node.reason != old.reason || node.required.size != old.required.size then
+        current := current.insert name node
+        changed := true
+    if !changed then break
+  return current
+
+/-- Constructor/projection-only helpers do no reusable computation. Follow
+    their small nonrecursive forwarding wrappers as well: caching a generic
+    state-return wrapper would otherwise retain every intermediate state merely
+    to allocate the returned pair. No primitive operation, callback, native
+    boundary or recursive computation is added to this classification. -/
+private def markConstructionOnly (graph : NameMap Node) : NameMap Node := Id.run do
+  let mut current := graph
+  for _ in [:graph.size] do
+    let mut changed := false
+    for (name, node) in current.toList do
+      if node.constructionOnly || !node.small || node.reason.isSome ||
+          !node.required.isEmpty then continue
+      if node.deps.toList.all (fun dep =>
+          (current.find? dep).any (·.constructionOnly)) then
+        current := current.insert name { node with constructionOnly := true }
+        changed := true
+    if !changed then break
+  return current
+
+/-- Imported runtime workers retain Lean's ownership optimizations. Their
+    surrounding application computation is still memoized. A specialization
+    inherits the origin of the nearest existing declaration prefix. -/
+private partial def isRuntimeWorker (env : Environment) (name : Name) : Bool :=
+  if let some idx := env.getModuleIdxFor? name then
+    let owner := env.header.moduleNames[idx]!
+    (`Init).isPrefixOf owner || (`Std).isPrefixOf owner
+  else if name.isAnonymous then false
+  else isRuntimeWorker env name.getPrefix
+
+/-- Split only direct, fully applied self tail calls. Branching recursion and
+    calls hidden in local functions retain ordinary recursive memoization. -/
+private partial def tailRecursion (name : Name) (arity : Nat) (code : Code .pure)
+    (tailContext := true) : Bool × Bool :=
+  match code with
+  | .let d k =>
+    let (seen, bad) := tailRecursion name arity k tailContext
+    match d.value with
+    | .const n _ args =>
+      if n != name then (seen, bad)
+      else
+        let tail := match k with
+          | .return id => tailContext && id == d.fvarId && args.size == arity
+          | _ => false
+        (true, bad || !tail)
+    | _ => (seen, bad)
+  | .fun d k =>
+    let (a, b) := tailRecursion name arity d.value false
+    let (c, d) := tailRecursion name arity k tailContext
+    (a || c, b || d)
+  | .jp d k =>
+    -- Join points transfer control within the same function; unlike a local
+    -- function, they have no independently returning call continuation.
+    let (a, b) := tailRecursion name arity d.value tailContext
+    let (c, d) := tailRecursion name arity k tailContext
+    (a || c, b || d)
+  | .cases c =>
+    c.alts.foldl (fun (a, b) alt =>
+      let (c, d) := tailRecursion name arity alt.getCode tailContext
+      (a || c, b || d)) (false, false)
+  | .return _ | .jmp _ _ | .unreach _ => (false, false)
+
+private partial def renameLoop (fromName toName : Name)
+    (code : Code .pure) : CompilerM (Code .pure) := do
+  match code with
+  | .let d k =>
+    let d ← match d.value with
+      | .const n us args =>
+        if n == fromName then d.updateValue (.const toName us args) else pure d
+      | _ => pure d
+    return code.updateLet! d (← renameLoop fromName toName k)
+  | .fun d k | .jp d k =>
+    let d ← d.updateValue (← renameLoop fromName toName d.value)
+    return code.updateFun! d (← renameLoop fromName toName k)
+  | .cases c =>
+    return code.updateAlts! (← c.alts.mapMonoM fun alt =>
+      return alt.updateCode (← renameLoop fromName toName alt.getCode))
+  | .return _ | .jmp _ _ | .unreach _ => return code
+
+private def wrap (decl : Decl .pure) : CompilerM (Decl .pure) := do
+  let .code body := decl.value | return decl
+  let unit ← mkParam `memoUnit (mkConst ``Unit) false
+  let thunk ← mkAuxFunDecl #[unit] body `memoThunk
+  let result ← mkAuxLetDecl (.const ``CerbMemo.evalImpl [] #[.erased, .fvar thunk.fvarId])
+  return { decl with value := .code (.fun thunk (.let result (.return result.fvarId))) }
+
+/-- Preserve a cached loop entry without retaining every intermediate state.
+    The worker has the original body and self recursion; the entry owns fresh
+    parameters, following Lean's own reduceArity transformation. -/
+private def wrapEntry (decl : Decl .pure) : CompilerM (Array (Decl .pure)) := do
+  let .code body := decl.value | return #[decl]
+  let (seen, bad) := tailRecursion decl.name decl.params.size body
+  if !seen || bad then return #[← wrap decl]
+  let workerName := decl.name ++ `_memoLoop
+  if (← getDecl? workerName).isSome then
+    throwError "memoization loop worker name already exists: {workerName}"
+  let worker := { decl with
+    name := workerName
+    value := .code (← renameLoop decl.name workerName body)
+    inlineAttr? := some .noinline }
+  worker.saveMono
+  let entry ← (do
+    let params ← decl.params.mapM Internalize.internalizeParam
+    let result ← mkAuxLetDecl (.const workerName [] (params.map (·.toArg)))
+    let entry := { decl with
+      params
+      recursive := false
+      value := .code (.let result (.return result.fvarId)) }
+    pure entry : Internalize.InternalizeM .pure (Decl .pure)).run' {}
+  let entry ← wrap entry
+  entry.saveMono
+  trace[CerbMemo.coverage] "{decl.name}: cached loop entry; internal iterations use {workerName}"
+  return #[worker, entry]
+
+private def run (decls : Array (Decl .pure)) : CompilerM (Array (Decl .pure)) := do
+  if !cerbMemo.enabled.get (← getOptions) then return decls
+  let env ← getEnv
+  let locals := decls.foldl (fun m d => m.insert d.name d) ({} : NameMap (Decl .pure))
+  let graph := markConstructionOnly (propagate (← collect (decls.toList.map (·.name)) locals))
+  modifyEnv fun env => graph.toList.foldl (fun env (name, node) =>
+    summaries.addEntry env (name, { arity := node.arity, required := node.required, reason := node.reason, constructionOnly := node.constructionOnly })) env
+  decls.foldlM (init := #[]) fun result d => do
+    let node := (graph.find? d.name).getD { reason := some "missing analysis" }
+    let cheapDeps := node.deps.toList.all fun n =>
+      isPrimitive env n || env.isConstructor n
+    let reason := if isInfrastructure d.name then some "cache infrastructure"
+      else if isRuntimeWorker env d.name then some "runtime worker inside cached application"
+      else if d.params.isEmpty then some "already a shared constant"
+      else if node.reason.isSome then node.reason
+      else if !node.required.isEmpty then some s!"requires pure callback arguments {node.required}"
+      else if node.constructionOnly then some "constructor-only forwarding"
+      else if !d.recursive && d.size < 24 && cheapDeps then some "small straight-line calculation"
+      else none
+    match reason with
+    | some why =>
+      trace[CerbMemo.coverage] "{d.name}: uncached: {why}"
+      return result.push d
+    | none =>
+      trace[CerbMemo.coverage] "{d.name}: cached automatically"
+      return result ++ (← wrapEntry d)
+
+initialize registerTraceClass `CerbMemo.coverage
+
+@[cpass] meta def install : PassInstaller :=
+  .installBefore .mono `lambdaLifting (fun _ => {
+    name := `cerbMemo
+    phase := .mono
+    phaseOut := .mono
+    shouldAlwaysRunCheck := true
+    run
+  })
+end CerbMemoPass
diff --git a/lean_frontend/CerbND.lean b/lean_frontend/CerbND.lean
index c7da47d8..4231dbb5 100644
--- a/lean_frontend/CerbND.lean
+++ b/lean_frontend/CerbND.lean
@@ -164,6 +164,76 @@ def runND [LemFuel] (m : ndM a info err cs st) (st0 : st) :
     List (nd_status a err st × List String × st) :=
   runNDFuel LemFuel.fuel m st0
 
+/-- Exhaustive execution with a pure terminal projection. Completed arenas,
+memory maps and traces need not survive while sibling paths are explored.
+Every branch, duplicate, ordering rule and fuel-exhaustion leaf is retained.
+`runNDFuelMap_eq_map` states the exact relationship to the original runner. -/
+def runNDFuelMap (project : (nd_status a err st × List String × st) → b)
+    (fuel : Nat) (m : ndM a info err cs st) (st0 : st) : List b :=
+  match fuel with
+  | 0 => [project (Killed st0 fuelExhaustedKill, [], st0)]
+  | fuel + 1 =>
+    match m with
+    | ND m_act =>
+      match m_act st0 with
+      | (NDactive result, st') => [project (Active result, [], st')]
+      | (NDkilled reason, st') => [project (Killed st' reason, [], st')]
+      | (NDnd _info branches, st') =>
+        branches.foldl (fun acc (_, branch) =>
+          runNDFuelMap project fuel branch st' ++ acc) []
+      | (NDguard _info _constraint continuation, st') =>
+        runNDFuelMap project fuel continuation st'
+      | (NDbranch _info _constraint left right, st') =>
+        runNDFuelMap project fuel left st' ++ runNDFuelMap project fuel right st'
+      | (NDstep _info branches, st') =>
+        branches.foldl (fun acc (_, branch) =>
+          runNDFuelMap project fuel branch st' ++ acc) []
+
+private theorem map_prepend_fold (project : α → β) (results : γ → List α)
+    (branches : List γ) (acc : List α) :
+    branches.foldl (fun out branch => (results branch).map project ++ out) (acc.map project) =
+      (branches.foldl (fun out branch => results branch ++ out) acc).map project := by
+  induction branches generalizing acc with
+  | nil => rfl
+  | cons branch branches ih =>
+    simpa only [List.foldl_cons, List.map_append] using ih (results branch ++ acc)
+
+/-- Exact list equality, including ordering, multiplicity, empty branch sets
+and fuel exhaustion; this introduces no assumptions about the executed program. -/
+theorem runNDFuelMap_eq_map (project : (nd_status a err st × List String × st) → b)
+    (fuel : Nat) (m : ndM a info err cs st) (st0 : st) :
+    runNDFuelMap project fuel m st0 = (runNDFuel fuel m st0).map project := by
+  induction fuel generalizing m st0 with
+  | zero => rfl
+  | succ fuel ih =>
+    cases m with
+    | ND step =>
+      cases h : step st0 with
+      | mk action st' =>
+        cases action with
+        | NDactive result => simp only [runNDFuelMap, runNDFuel, h, List.map_singleton]
+        | NDkilled reason => simp only [runNDFuelMap, runNDFuel, h, List.map_singleton]
+        | NDnd info branches =>
+          simp only [runNDFuelMap, runNDFuel, h, ih]
+          exact map_prepend_fold project (fun branch => runNDFuel fuel branch.2 st') branches []
+        | NDguard info constraint continuation =>
+          simp only [runNDFuelMap, runNDFuel, h, ih]
+        | NDbranch info constraint left right =>
+          simp only [runNDFuelMap, runNDFuel, h, ih, List.map_append]
+        | NDstep info branches =>
+          simp only [runNDFuelMap, runNDFuel, h, ih]
+          exact map_prepend_fold project (fun branch => runNDFuel fuel branch.2 st') branches []
+
+def runNDMap [LemFuel] (project : (nd_status a err st × List String × st) → b)
+    (m : ndM a info err cs st) (st0 : st) : List b :=
+  runNDFuelMap project LemFuel.fuel m st0
+
+theorem runNDMap_eq_map [LemFuel]
+    (project : (nd_status a err st × List String × st) → b)
+    (m : ndM a info err cs st) (st0 : st) :
+    runNDMap project m st0 = (runND m st0).map project :=
+  runNDFuelMap_eq_map project LemFuel.fuel m st0
+
 /-- Fuel-totalized single-trace runner (worker; callers use `runND1`):
     follow exactly ONE branch at every nondeterminism point, yielding at
     most one execution. Same exhaustion kill/budget as `runNDFuel`.
