+val gnu_format_return_expression:
+  A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_format_return_expression stmt = match stmt.A.node with
+  | A.AilSreturn expr -> Just expr
+  | A.AilSblock [] [child] -> gnu_format_return_expression child
+  | A.AilSmarker _ child -> gnu_format_return_expression child
+  | _ -> Nothing end
