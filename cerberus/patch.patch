+val gnu_loop_isolated_member_comparisons:
+  gnu_boundary_return_resolver -> list Symbol.sym -> list Symbol.sym ->
+  list E.gnu_memory_slot -> A.statement GenTypes.genTypeCategory -> E.elabM bool
