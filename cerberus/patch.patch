+val translate_if_control:
+  E.elabM (C.expr unit) -> E.elabM (C.expr unit) -> E.elabM (C.expr unit) ->
+  E.elabM (C.expr unit)
+let translate_if_control test left right =
+  translate_if_control_branches test
