+(* A summary contains no callee locals, memory reads or hidden effects. Formal
+   substitution checks the original pointed-to type, retaining any explicit
+   pointer casts in the predicate. Other operand forms stay unsupported. *)
+val gnu_guard_substitute:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_guard_substitute formal actual (A.AnnotatedExpression ty annots loc node as expr) =
+  let self = gnu_guard_substitute formal actual in
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (qs, cty) = qualified_ctype_of operand in
+        if sym = formal && not qs.Ctype.volatile && not (AilTypesAux.is_atomic cty) &&
+            AilTypesAux.is_pointer cty && gnu_function_target_type_equal cty (ctype_of actual)
+        then Just actual else Nothing
+    | A.AilEcast qs cty operand ->
+        if not (AilTypesAux.is_pointer cty && AilTypesAux.is_pointer (ctype_of operand)) then Nothing else
+        maybe Nothing (fun value -> Just (A.AnnotatedExpression ty annots loc (A.AilEcast qs cty value))) (self operand)
+    | A.AilEannot cty operand ->
+        maybe Nothing (fun value -> Just (A.AnnotatedExpression ty annots loc (A.AilEannot cty value))) (self operand)
+    | A.AilEarray_decay (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        if sym <> formal then Just expr else Nothing
+    | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+        if sym <> formal then Just expr else Nothing
+    | _ -> Nothing
+  end
