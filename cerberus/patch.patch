+/- Generated modeled-memory preparation for files normal calls. -/
+import CerbHostFilesAdmission
+import CerbHostFilesRequests
+import CerbHostFilesOperands
+set_option autoImplicit false
+
+namespace CerbHostFilesExtras
+open CerbMem CerbHostMemoryCells CerbHostFilesAdmission CerbHostFilesRequests CerberusImpl
+abbrev Program := generic_file Unit core_run_annotation
+
+structure Prepared where
+  extra : Extra
+  inputFootprints : List Footprint
+  memory : MemState
+
+private def fail {α : Type} (s : String) : Except Failure α := .error (.boundary s)
+private def ident : identifier → String | .Identifier _ s => s
+private def integerKind : ctype → Option CellKind
+  | .Ctype _ (.Basic (.Integer (.Signed .Int_))) => some .signedInt
+  | .Ctype _ (.Basic (.Integer (.Unsigned .Int_))) => some .unsignedInt
+  | .Ctype _ (.Basic (.Integer (.Signed .Long))) => some .signedLong
+  | .Ctype _ (.Basic (.Integer (.Unsigned .Long))) => some .unsignedLong
+  | _ => none
+
+def fcntlNeedsArgument (command : Int) : Except Failure Bool :=
+  if command == 1 || command == 3 then .ok false
+  else if command == 2 || command == 4 then .ok true
+  else fail "fcntl command is outside the generated guest subset"
+
+private def promotedInt [LemFuel] [CerbGlobal.Switches] (program : Program)
+    (objects : List (ctype × PointerValue)) (state : MemState) :
+    Except Failure (Int × List Footprint × MemState) := do
+  let (type, pointer) :: _ := objects | fail "required promoted variadic integer is missing"
+  let some kind := integerKind type | fail "variadic operand is not an admitted promoted integer"
+  if kind != .signedInt && kind != .unsignedInt then fail "variadic integer was not promoted to int"
+  let (number, footprint, after) ← readInteger program.enumDefs program.tagDefs {pointer := pointer, kind := kind} state
+  if kind == .unsignedInt && number > 2147483647 then
+    fail "unsigned promoted operand exceeds signed-int compatibility"
+  return (number, [footprint], after)
+
+private def recordMembers (tags : TagDefs) (type : ctype) :
+    Except Failure (sym × List CerbTagsWf.Member) := do
+  let .Ctype _ (.Pointer _ (.Ctype _ (.Struct tag))) := type |
+    fail "aggregate input does not retain its declared struct pointer CType"
+  match CerbTagsWf.lookup tags tag with
+  | some (_, .StructDef _ members none) => return (tag, members)
+  | _ => fail "aggregate input struct is absent, flexible, or incomplete"
+
+private def pairCells [LemFuel] [CerbGlobal.Switches] (program : Program)
+    (pointer : PointerValue) (type : ctype) (secName subName : String)
+    (state : MemState) : Except Failure (Option (List Cell) × MemState) := do
+  let (isNull, checked) ← immediate (eqPtrval (CerbLocation.other "files time input") pointer (nullPtrval void)) state
+  if isNull then return (none, checked)
+  let (tag, members) ← recordMembers program.tagDefs type
+  match members with
+  | [(sec, (_, _, qs0, t0)), (sub, (_, _, qs1, t1))] =>
+    if ident sec != secName || ident sub != subName || !qualifiersEqual qs0 no_qualifiers ||
+       !qualifiersEqual qs1 no_qualifiers || integerKind t0 != some .signedLong ||
+       integerKind t1 != some .signedLong then fail "time record member contract differs"
+  | _ => fail "time record must contain exactly two signed-long members"
+  let .Ctype _ (.Pointer _ recordType) := type | fail "time pointer lost its pointee"
+  if sizeofCtype program.enumDefs program.tagDefs recordType != 16 ||
+     alignofCtype program.enumDefs program.tagDefs recordType != 8 then fail "time record ABI differs"
+  let mut cells := []
+  let mut after := checked
+  for i in [0, 1] do
+    let (element, next) ← immediate (effArrayShiftPtrval program.enumDefs program.tagDefs
+      (CerbLocation.other "files time pair") pointer recordType (.IV .Prov_none i)) after
+    let subPointer := memberShiftPtrval program.enumDefs program.tagDefs element tag
+      (.Identifier CerbLocation.unknown subName)
+    let secPointer := memberShiftPtrval program.enumDefs program.tagDefs element tag
+      (.Identifier CerbLocation.unknown secName)
+    cells := {pointer := subPointer, kind := .signedLong} ::
+      {pointer := secPointer, kind := .signedLong} :: cells
+    after := next
+  return (some cells.reverse, after)
+
+private def iovecSpans [LemFuel] [CerbGlobal.Switches] (program : Program)
+    (pointer : PointerValue) (type : ctype) (count : Int) (state : MemState) :
+    Except Failure (List CerbHostFilesGuest.Span × List Footprint × MemState) := do
+  if count < 0 || count > 1024 then fail "iovec count is outside the pinned admission"
+  if count == 0 then return ([], [], state)
+  let (tag, members) ← recordMembers program.tagDefs type
+  let [(baseName, (_, _, qb, baseType)), (lenName, (_, _, ql, lenType))] := members |
+    fail "iovec must contain exactly base and length"
+  if ident baseName != "iov_base" || ident lenName != "iov_len" ||
+     !qualifiersEqual qb no_qualifiers || !qualifiersEqual ql no_qualifiers ||
+     integerKind lenType != some .unsignedLong then fail "iovec member contract differs"
+  let .Ctype _ (.Pointer baseQualifiers (.Ctype _ .Void0)) := baseType |
+    fail "iovec base is not void pointer"
+  if !qualifiersEqual baseQualifiers no_qualifiers then
+    fail "iovec base pointer qualifiers differ from the pinned layout"
+  let .Ctype _ (.Pointer _ recordType) := type | fail "iovec pointer lost pointee"
+  if sizeofCtype program.enumDefs program.tagDefs recordType != 16 ||
+     alignofCtype program.enumDefs program.tagDefs recordType != 8 then fail "iovec ABI differs"
+  let mut spans := []; let mut fps := []; let mut after := state
+  for i in List.range count.toNat do
+    let (element, shifted) ← immediate (effArrayShiftPtrval program.enumDefs program.tagDefs
+      (CerbLocation.other "files iovec") pointer recordType (.IV .Prov_none i)) after
+    let (recordValid, checkedRecord) ← immediate (validForDerefPtrval
+      program.enumDefs program.tagDefs recordType element) shifted
+    if !recordValid then fail "iovec record fails lifetime/alignment checks"
+    let bp := memberShiftPtrval program.enumDefs program.tagDefs element tag baseName
+    let lp := memberShiftPtrval program.enumDefs program.tagDefs element tag lenName
+    let (baseValid, checkedBase) ← immediate (validForDerefPtrval
+      program.enumDefs program.tagDefs baseType bp) checkedRecord
+    if !baseValid then fail "iovec base member fails lifetime/alignment checks"
+    let ((fb, mv), loaded) ← immediate (loadM program.enumDefs program.tagDefs
+      (CerbLocation.other "files iovec base") baseType bp) checkedBase
+    if !memValueHasType baseType mv then fail "iovec base stored value has incompatible CType"
+    let .MVpointer _ base ← pure mv | fail "iovec base stored value is not a pointer"
+    let (len, fl, next) ← readInteger program.enumDefs program.tagDefs {pointer := lp, kind := .unsignedLong} loaded
+    spans := {pointer := base, count := len} :: spans; fps := fl :: fb :: fps; after := next
+  return (spans.reverse, fps.reverse, after)
+
+def prepare [LemFuel] [CerbGlobal.Switches] (profile : CerbHostFilesOperands.Profile)
+    (admitted : Admitted) (decoded : Decoded) (state : MemState) : Except Failure Prepared := do
+  match admitted.name, decoded.arguments with
+  | "open", [.pointer _, .number flags] =>
+      let (mode, fps, after) ← CerbHostFilesOperands.prepareOpenArgs profile admitted.program.enumDefs
+        admitted.program.tagDefs flags admitted.variadicObjects state
+      return ⟨.openMode mode, fps, after⟩
+  | "openat", [.number _, .pointer _, .number flags] =>
+      let (mode, fps, after) ← CerbHostFilesOperands.prepareOpenArgs profile admitted.program.enumDefs
+        admitted.program.tagDefs flags admitted.variadicObjects state
+      return ⟨.openMode mode, fps, after⟩
+  | "fcntl", [.number _, .number command] =>
+      if !(← fcntlNeedsArgument command) then return ⟨.fcntlArgument 0, [], state⟩
+      let (argument, fps, after) ← promotedInt admitted.program admitted.variadicObjects state
+      return ⟨.fcntlArgument argument, fps, after⟩
+  | "utimes", [.pointer _, .pointer times] =>
+      let (cells, after) ← pairCells admitted.program times admitted.parameterTypes[1]! "tv_sec" "tv_usec" state
+      return ⟨.times cells, [], after⟩
+  | "futimes", [.number _, .pointer times] =>
+      let (cells, after) ← pairCells admitted.program times admitted.parameterTypes[1]! "tv_sec" "tv_usec" state
+      return ⟨.times cells, [], after⟩
+  | "utimensat", [.number _, .pointer _, .pointer times, .number _] =>
+      let (cells, after) ← pairCells admitted.program times admitted.parameterTypes[2]! "tv_sec" "tv_nsec" state
+      return ⟨.times cells, [], after⟩
+  | "readv", [.number _, .pointer vectors, .number count]
+  | "writev", [.number _, .pointer vectors, .number count] =>
+      let (spans, fps, after) ← iovecSpans admitted.program vectors admitted.parameterTypes[1]! count state
+      return ⟨.spans spans, fps, after⟩
+  | "write", [.number _, .pointer buffer, .number count] =>
+      if count < 0 || count > 9223372036854775807 then fail "write count is outside size_t/ssize_t admission"
+      let (bytes, fps, after) ← readBytes admitted.program.enumDefs admitted.program.tagDefs buffer count.toNat state
+      return ⟨.bytes bytes, fps, after⟩
+  | _, _ => return ⟨.none, [], state⟩
+
+end CerbHostFilesExtras
diff --git a/lean_frontend/host/families/files/normal/templates/files_requests.lean.in b/lean_frontend/host/families/files/normal/templates/files_requests.lean.in
new file mode 100644
index 00000000..bed9e205
--- /dev/null
+++ b/lean_frontend/host/families/files/normal/templates/files_requests.lean.in
@@ -0,0 +1,35 @@
+/- Generated request construction only. Extra values must be prepared by the
+typed modeled-memory helpers named in files-request-contracts.json. -/
+import CerbHostFilesAdmission
+set_option autoImplicit false
+
+namespace CerbHostFilesRequests
+open CerbMem CerbHostMemoryCells CerbHostFilesAdmission
+abbrev Request := CerbHostFilesGuest.Request
+abbrev Span := CerbHostFilesGuest.Span
+
+inductive Extra where
+  | none
+  | openMode (mode : Option Int)
+  | fcntlArgument (argument : Int)
+  | times (value : Option (List CerbHostMemoryCells.Cell))
+  | spans (value : List Span)
+  | bytes (value : ByteArray)
+
+private def stop {α : Type} (message : String) : Except Failure α := .error (.boundary message)
+private def pointee : ctype → Except Failure ctype
+  | .Ctype _ (.Pointer _ target) => .ok target
+  | _ => stop "generated record output parameter is not a pointer"
+private def record (pointer : PointerValue) (type : ctype) : Except Failure CerbHostFilesGuest.OutputRecord := do
+  return { pointer := pointer, recordType := (← pointee type) }
+
+def constructFrom (name : String) (arguments : List Argument) (types : List ctype)
+    (extra : Extra := .none) : Except Failure Request := do
+  match name, arguments, types, extra with
+@REQUESTS@
+  | _, _, _, _ => stop "decoded files arguments or prepared extra do not match the generated request contract"
+
+def construct (admitted : Admitted) (decoded : Decoded) (extra : Extra := .none) : Except Failure Request :=
+  constructFrom admitted.name decoded.arguments admitted.parameterTypes extra
+
+end CerbHostFilesRequests
diff --git a/lean_frontend/host/families/network/NetworkFailureFixtures.h b/lean_frontend/host/families/network/NetworkFailureFixtures.h
new file mode 100644
index 00000000..d8c94174
--- /dev/null
+++ b/lean_frontend/host/families/network/NetworkFailureFixtures.h
@@ -0,0 +1,64 @@
+/* Test-only process-local controls; never linked into the adapter library.
+   Linux thread-directed timers are necessary: Lean has multiple runtime threads. */
+#ifndef CERB_NETWORK_FAILURE_FIXTURES_H
+#define CERB_NETWORK_FAILURE_FIXTURES_H
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <time.h>
+#include <signal.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <string.h>
+static struct rlimit cerb_test_saved_limit;
+static struct sigaction cerb_test_saved_action;
+static sigset_t cerb_test_saved_mask;
+static timer_t cerb_test_timer;
+static int cerb_test_mode;
+static void cerb_test_alarm(int signal_number) { (void)signal_number; }
+static uint32_t cerb_test_failure_begin(uint32_t mode) {
+    if(cerb_test_mode) return UINT32_MAX;
+    if(mode==1) {
+        if(getrlimit(RLIMIT_NOFILE,&cerb_test_saved_limit)) return UINT32_MAX;
+        struct rlimit limit=cerb_test_saved_limit;limit.rlim_cur=0;
+        if(setrlimit(RLIMIT_NOFILE,&limit)) return UINT32_MAX;
+        cerb_test_mode=1;return 0;
+    }
+    if(mode==2) {
+        struct sigaction action;memset(&action,0,sizeof(action));
+        action.sa_handler=cerb_test_alarm;sigemptyset(&action.sa_mask);
+        if(sigaction(SIGALRM,&action,&cerb_test_saved_action)) return UINT32_MAX;
+        sigset_t unblocked;sigemptyset(&unblocked);sigaddset(&unblocked,SIGALRM);
+        if(pthread_sigmask(SIG_UNBLOCK,&unblocked,&cerb_test_saved_mask)) {
+            sigaction(SIGALRM,&cerb_test_saved_action,NULL);return UINT32_MAX;
+        }
+        struct sigevent event;memset(&event,0,sizeof(event));
+        event.sigev_notify=SIGEV_THREAD_ID;event.sigev_signo=SIGALRM;
+        event._sigev_un._tid=(pid_t)syscall(SYS_gettid);
+        if(timer_create(CLOCK_MONOTONIC,&event,&cerb_test_timer)) {
+            pthread_sigmask(SIG_SETMASK,&cerb_test_saved_mask,NULL);
+            sigaction(SIGALRM,&cerb_test_saved_action,NULL);return UINT32_MAX;
+        }
+        struct itimerspec timer;memset(&timer,0,sizeof(timer));
+        timer.it_value.tv_nsec=50000000;timer.it_interval.tv_nsec=50000000;
+        if(timer_settime(cerb_test_timer,0,&timer,NULL)) {
+            timer_delete(cerb_test_timer);
+            pthread_sigmask(SIG_SETMASK,&cerb_test_saved_mask,NULL);
+            sigaction(SIGALRM,&cerb_test_saved_action,NULL);return UINT32_MAX;
+        }
+        cerb_test_mode=2;return 0;
+    }
+    return UINT32_MAX;
+}
+static uint32_t cerb_test_failure_end(void) {
+    int mode=cerb_test_mode;cerb_test_mode=0;
+    if(mode==1) return (uint32_t)setrlimit(RLIMIT_NOFILE,&cerb_test_saved_limit);
+    if(mode==2) {
+        int a=timer_delete(cerb_test_timer);
+        int b=pthread_sigmask(SIG_SETMASK,&cerb_test_saved_mask,NULL);
+        int c=sigaction(SIGALRM,&cerb_test_saved_action,NULL);
+        return a||b||c ? UINT32_MAX : 0;
+    }
+    return UINT32_MAX;
+}
+#endif
diff --git a/lean_frontend/host/families/network/NetworkFailureTestSupport.c b/lean_frontend/host/families/network/NetworkFailureTestSupport.c
new file mode 100644
index 00000000..fcced9e3
--- /dev/null
+++ b/lean_frontend/host/families/network/NetworkFailureTestSupport.c
@@ -0,0 +1,9 @@
+#define _GNU_SOURCE
+#include <lean/lean.h>
+#include "NetworkFailureFixtures.h"
+LEAN_EXPORT uint32_t cerb_network_test_failure_begin(uint32_t mode) {
+    return cerb_test_failure_begin(mode);
+}
+LEAN_EXPORT uint32_t cerb_network_test_failure_end(void) {
+    return cerb_test_failure_end();
+}
diff --git a/lean_frontend/host/families/network/NetworkTest.lean b/lean_frontend/host/families/network/NetworkTest.lean
new file mode 100644
index 00000000..dd0a360c
--- /dev/null
+++ b/lean_frontend/host/families/network/NetworkTest.lean
@@ -0,0 +1,130 @@
+import CerbHostNetworkAdapters
+open CerbHostNetworkAdapters
+
+@[extern "cerb_network_test_failure_begin"]
+opaque failureBegin : UInt32 → BaseIO UInt32
+@[extern "cerb_network_test_failure_end"]
+opaque failureEnd : BaseIO UInt32
+
+private def ensure (ok : Bool) (message : String) : IO Unit := do
+  unless ok do throw (IO.userError message)
+
+private def accept (r : NetworkResult) : IO NetworkResult := do
+  ensure r.boundaryError.isEmpty r.boundaryError
+  return r
+
+private def wordBytes (n : UInt64) (count : Nat) : ByteArray := Id.run do
+  let mut out := ByteArray.empty
+  for i in [:count] do
+    out := out.push ((n >>> (8*i).toUInt64).toUInt8)
+  return out
+
+private def append (a b : ByteArray) : ByteArray :=
+  b.data.foldl (fun acc byte => acc.push byte) a
+
+private def iov (data : ByteArray) : ByteArray :=
+  append (wordBytes data.size.toUInt64 8) data
+
+def main : IO Unit := do
+  let pair ← accept (← socketpair 71 1 1 0)
+  ensure (pair.status.value == 0 && pair.fields.size == 2) "socketpair result"
+  ensure (pair.nativeErrnoAfter == 71) "success errno snapshot"
+  let a := pair.fields[0]!.toUInt32
+  let b := pair.fields[1]!.toUInt32
+  let payload := ByteArray.mk #[97,98,99]
+  let sent ← accept (← sendmsg 72 a 0 ByteArray.empty 0 ByteArray.empty (iov payload) 0)
+  ensure (sent.status.value == 3 && sent.nativeErrnoAfter == 72) "sendmsg count/errno"
+  let entries := append (wordBytes b.toUInt64 4) (ByteArray.mk #[1,0,0,0])
+  let ready ← accept (← poll 73 entries 0)
+  ensure (ready.status.value == 1 && ready.bytes.size == 8 && ready.bytes[6]! == 1) "poll copied records"
+  let initial := ByteArray.mk #[170,187,204]
+  let got ← accept (← recvmsg 74 b 0 ByteArray.empty 0 ByteArray.empty (iov initial) 0)
+  ensure (got.status.value == 3 && got.bytes.size == 27) "recvmsg shape"
+  ensure ((got.bytes.extract 24 27).data == payload.data) "recvmsg copied data"
+  let opt ← accept (← getsockopt 75 a 1 3 (ByteArray.mk #[0,0,0,0]))
+  ensure (opt.status.value == 0 && opt.fields[0]! == 4 && opt.bytes[0]! == 1) "socket option layout"
+  let down ← accept (← shutdown 76 a 1)
+  ensure (down.status.value == 0) "shutdown"
+  let eof ← accept (← recvmsg 77 b 0 ByteArray.empty 0 ByteArray.empty (iov initial) 0)
+  ensure (eof.status.value == 0 && (eof.bytes.extract 24 27).data == initial.data) "EOF preserves untouched bytes"
+  let bad ← accept (← socket 78 4294967295 1 0)
+  ensure (bad.status.value == -1 && bad.status.error == 97 && bad.nativeErrnoAfter == 97) "native EAFNOSUPPORT"
+  let failedPair ← accept (← socketpair 81 4294967295 1 0)
+  ensure (failedPair.status.value == -1 && failedPair.nativeErrnoAfter == 97 &&
+    failedPair.fields.size == 2) "failed socketpair still exposes released reservation writes"
+  let earlyPair ← accept (← socketpair 82 1 1073741825 0)
+  ensure (earlyPair.status.value == -1 && earlyPair.fields.isEmpty) "early socketpair failure has no writes"
+  let negative := append (wordBytes 4294967295 4) (ByteArray.mk #[1,0,52,18])
+  ensure ((← failureBegin 1) == 0) "lower fixture descriptor limit"
+  let limited ← poll 83 negative 0
+  ensure ((← failureEnd) == 0) "restore fixture descriptor limit"
+  let limited ← accept limited
+  ensure (limited.status.value == -1 && limited.nativeErrnoAfter == 22 &&
+    limited.fields.size == 1 && limited.fields[0]! == 0 &&
+    limited.bytes[6]! == 52 && limited.bytes[7]! == 18) "EINVAL leaves poll outputs untouched"
+  ensure ((← failureBegin 2) == 0) "arm fixture interrupt"
+  let interrupted ← poll 84 negative 1000
+  ensure ((← failureEnd) == 0) "restore fixture signal state"
+  let interrupted ← accept interrupted
+  ensure (interrupted.status.value == -1 && interrupted.nativeErrnoAfter == 4 &&
+    interrupted.fields.size == 1 && interrupted.fields[0]! == 1 &&
+    interrupted.bytes[6]! == 0 && interrupted.bytes[7]! == 0) s!"EINTR still writes poll revents: value={interrupted.status.value}, errno={interrupted.nativeErrnoAfter}, fields={repr interrupted.fields}, bytes={repr interrupted.bytes.data}"
+  let absentBytes := append (wordBytes 2147483647 4) (ByteArray.mk #[1,0,0,0])
+  let absent ← accept (← poll 85 absentBytes 1000)
+  ensure (absent.status.value == 1 && absent.bytes[6]! == 32) "unallocatable sentinel yields native POLLNVAL"
+  let badBind ← accept (← bind 86 2147483647 ByteArray.empty)
+  let badConnect ← accept (← connect 87 2147483647 ByteArray.empty)
+  let badListen ← accept (← listen 88 2147483647 4294967295)
+  let badShutdown ← accept (← shutdown 89 2147483647 2147483647)
+  for result in [badBind,badConnect,badListen,badShutdown] do
+    ensure (result.status.value == -1 && result.nativeErrnoAfter == 9) "invalid socket fd native errno"
+  let state ← accept (← __res_state 91)
+  ensure (state.status.value == 1 && state.fields.size == 6 && state.fields[3]! == 8) "typed resolver object"
+  let token := state.fields[0]!
+  let original := state.fields[4]!
+  let again ← accept (← __res_state 92)
+  ensure (again.fields[0]! == token) "resolver stable TLS identity"
+  let loaded ← accept (← resolver_options_load 93 token)
+  ensure (loaded.fields[0]! == original) "resolver options load"
+  let changed := original ^^^ 2
+  let stored ← accept (← resolver_options_store 94 token original changed)
+  ensure (stored.fields[0]! == changed) "resolver options store"
+  let stale ← resolver_options_store 95 token original original
+  ensure (!stale.boundaryError.isEmpty) "stale options snapshot refusal"
+  let restored ← accept (← resolver_options_store 96 token changed original)
+  ensure (restored.fields[0]! == original) "resolver options restore"
+  let h1 ← accept (← dlopen 97 0 ByteArray.empty 2)
+  let h2 ← accept (← dlopen 98 0 ByteArray.empty 2)
+  ensure (h1.status.value == 1 && h2.status.value == 1 && h1.fields[1]! == h2.fields[1]!) "loader handle identity"
+  let handle := h1.fields[1]!
+  ensure (h2.fields[2]! == 2) "loader acquisition count"
+  let name := ByteArray.mk #[109,97,108,108,111,99,0]
+  let sym1 ← accept (← dlsym 99 handle name)
+  let sym2 ← accept (← dlsym 100 handle name)
+  ensure (sym1.status.value == 1 && sym1.fields[1]! == sym2.fields[1]!) "symbol identity"
+  let symbol := sym1.fields[1]!
+  let info ← accept (← provider_symbol_info 101 symbol)
+  ensure (info.fields[1]! == 0 && info.fields[2]! == 0 && info.fields[3]! == 1) "unclassified symbol has no callable/data capabilities"
+  let released ← accept (← dlclose 102 handle)
+  ensure (released.status.value == 0 && released.fields[1]! == 1) "release one acquisition"
+  let _ ← accept (← provider_symbol_info 103 symbol)
+  let finalRelease ← accept (← dlclose 104 handle)
+  ensure (finalRelease.status.value == 0 && finalRelease.fields[1]! == 0) "release final acquisition"
+  let expired ← provider_symbol_info 105 symbol
+  ensure (!expired.boundaryError.isEmpty) "expired symbol borrow refusal"
+  for count in [0,4294967296] do
+    let empty ← accept (← poll_no_array 91 count 0)
+    ensure (empty.status.value == 0 && empty.nativeErrnoAfter == 91 &&
+      empty.fields == #[0] && empty.bytes.size == 0) "poll narrows nfds to zero without array access"
+  let over ← accept (← poll_no_array 91 18446744073709551615 0)
+  ensure (over.status.value == -1 && over.nativeErrnoAfter == 22 &&
+    over.fields == #[0] && over.bytes.size == 0) "poll limit error precedes array access"
+  let needsArray ← poll_no_array 91 1 0
+  ensure (!needsArray.boundaryError.isEmpty) "ordinary poll count cannot omit its array"
+  ensure ((← failureBegin 1) == 0) "set zero limit for no-array poll"
+  let limitedNoArray ← poll_no_array 92 1 0
+  ensure ((← failureEnd) == 0) "restore limit after no-array poll"
+  let limitedNoArray ← accept limitedNoArray
+  ensure (limitedNoArray.status.value == -1 && limitedNoArray.nativeErrnoAfter == 22 &&
+    limitedNoArray.fields == #[0] && limitedNoArray.bytes.size == 0) "zero limit count error writes no array"
+  IO.println "network-ok"
diff --git a/lean_frontend/host/families/network/admission/NetworkAdmissionTest.lean b/lean_frontend/host/families/network/admission/NetworkAdmissionTest.lean
new file mode 100644
index 00000000..5f484ba0
--- /dev/null
+++ b/lean_frontend/host/families/network/admission/NetworkAdmissionTest.lean
@@ -0,0 +1,182 @@
+import CerbHostNetworkAdmission
+open CerbMem CerbHostMemoryCells CerbHostNetworkAdmission CerberusImpl
+
+private def ensure (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+private def take {α : Type} (x : Except Failure α) : IO α :=
+  match x with
+  | .ok value => pure value
+  | .error (.boundary message) => throw (IO.userError message)
+  | .error (.memory _) => throw (IO.userError "unexpected model memory failure")
+private def fails {α : Type} (x : Except Failure α) : Bool :=
+  match x with | .error _ => true | .ok _ => false
+private def fixtureMapInsert {α : Type} (key : sym) (value : α) (map : Fmap sym α) : Fmap sym α :=
+  fmapAddBy (fun a b => Lem_Basic_classes.ordCompare a b) key value map
+private def identCompare : identifier → identifier → LemOrdering
+  | .Identifier _ a, .Identifier _ b => Lem_Basic_classes.ordCompare a b
+private def functionType (result : ctype) (parameters : List ctype) (varargs := false) :
+    generic_pexpr Unit sym :=
+  .Pexpr [] () (.PEval (.Vctype (.Ctype [] (.Pointer no_qualifiers
+    (.Ctype [] (.Function (no_qualifiers,result)
+      (parameters.map fun type => (no_qualifiers,type,false)) varargs))))))
+
+private def fixtureProgram (symbol : sym) : Program :=
+  { (default : Program) with
+    calling_convention0 := .Normal_callconv
+    stdlib := fmapEmpty
+    funs := fixtureMapInsert symbol (.ProcDecl (CerbLocation.other "test") (.BTy_loaded .OTy_integer)
+      (List.replicate 3 (.BTy_object .OTy_pointer))) fmapEmpty
+    funinfo := fixtureMapInsert symbol (CerbLocation.other "test", no_attributes, signed_int,
+      [(none,signed_int),(none,signed_int),(none,signed_int)],false,true) fmapEmpty
+    extern := fmapAddBy identCompare (.Identifier (CerbLocation.other "test") "socket")
+      ([symbol],.LK_none) fmapEmpty
+    enumDefs := fmapEmpty
+    tagDefs := fmapEmpty }
+
+private def pollTag : sym := .Symbol "network-admission" 201 (.SD_Id "pollfd")
+private def pollRecordType : ctype := .Ctype [] (.Struct pollTag)
+private def pollPointerType : ctype := .Ctype [] (.Pointer no_qualifiers pollRecordType)
+private def pollMember (name : String) (type : ctype) : CerbTagsWf.Member :=
+  (.Identifier CerbLocation.unknown name, (.Attrs [], none, no_qualifiers, type))
+private def pollTags : CerbTags.TagDefsMap :=
+  Lem_Map.fromList [(pollTag, (CerbLocation.unknown,
+    .StructDef natural_aggregate_layout [
+      pollMember "fd" CellKind.signedInt.ty,
+      pollMember "events" CellKind.signedShort.ty,
+      pollMember "revents" CellKind.signedShort.ty] none))]
+
+private def argumentObject [LemFuel] [CerbGlobal.Switches] (program : Program)
+    (type : ctype) (contents : MemValue) (state : MemState) :
+    IO (PointerValue × MemState) := do
+  let (object, state) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 16)) state)
+  let (_, state) ← take (immediate (storeM program.enumDefs program.tagDefs
+    (CerbLocation.other "poll argument") type false object contents) state)
+  return (object, state)
+
+private def run [LemFuel] [CerbGlobal.Switches] : IO Unit := do
+  let symbol : sym := .Symbol "" 200 (.SD_Id "socket")
+  let file := fixtureProgram symbol
+  let callLocation := CerbLocation.other "admission-test-call"
+  let (pointer, state) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 4) (.IV .Prov_none 12))
+    (initialMemState 4096))
+  let (cells, state) ← take (arrayCells file.enumDefs file.tagDefs .signedInt pointer 3 state)
+  let lease ← take (prepareOutputs file.enumDefs file.tagDefs cells state)
+  let (_, state) ← take (commitOutputs file.enumDefs file.tagDefs lease [1,1,0])
+  let arguments := cells.map (fun cell => value.Vobject (.OVpointer cell.pointer))
+  let call := functionType signed_int [signed_int,signed_int,signed_int]
+  let accepted ← take (admit callLocation file fmapEmpty symbol call arguments)
+  let decoded ← take (decode accepted state)
+  ensure (match decoded.request with | .socket 1 1 0 => true | _ => false)
+    "normal convention must load parameter objects instead of treating pointers as arguments"
+  ensure (decoded.inputFootprints.length == 3) "actual parameter loads must retain three footprints"
+  ensure (fails (admit callLocation file fmapEmpty symbol call
+    [.Vloaded (.LVspecified (.OVinteger (.IV .Prov_none 1))),
+     .Vloaded (.LVspecified (.OVinteger (.IV .Prov_none 1))),
+     .Vloaded (.LVspecified (.OVinteger (.IV .Prov_none 0)))]))
+    "loaded scalar arguments do not satisfy Normal_callconv"
+  ensure (fails (admit callLocation { file with calling_convention0 := .Inner_arg_callconv }
+    fmapEmpty symbol call arguments)) "unsupported call convention must fail before IO"
+  ensure (fails (admit callLocation file fmapEmpty symbol
+    (functionType unsigned_int [signed_int,signed_int,signed_int]) arguments))
+    "return prototype mismatch"
+  ensure (fails (admit callLocation file fmapEmpty symbol
+    (functionType signed_int [unsigned_int,signed_int,signed_int]) arguments))
+    "parameter prototype mismatch"
+  ensure (fails (admit callLocation file fmapEmpty symbol
+    (functionType signed_int [signed_int,signed_int,signed_int] true) arguments))
+    "variadic call cannot enter fixed ABI adapter"
+  let defined := { file with
+    funs := fixtureMapInsert symbol
+      (.Proc (CerbLocation.other "test") none (.BTy_loaded .OTy_integer) [] default) file.funs
+  }
+  ensure (fails (admit callLocation defined fmapEmpty symbol call arguments))
+    "host adapter must not shadow a defined procedure"
+  let duplicate := { file with
+    extern := fmapAddBy identCompare
+      (.Identifier (CerbLocation.other "test") "other_socket") ([symbol],.LK_none) file.extern
+  }
+  ensure (fails (admit callLocation duplicate fmapEmpty symbol call arguments))
+    "ambiguous linker names must refuse"
+  let intPointer : ctype := .Ctype [] (.Pointer no_qualifiers signed_int)
+  let shortPointer : ctype := .Ctype [] (.Pointer no_qualifiers
+    (.Ctype [] (.Basic (.Integer (.Signed .Short)))))
+  let constPointer : ctype := .Ctype [] (.Pointer
+    { no_qualifiers with const := true } signed_int)
+  let pointerPointer : ctype := .Ctype [] (.Pointer no_qualifiers intPointer)
+  let pairTypes := [signed_int,signed_int,signed_int,intPointer]
+  let pairFile := { file with
+    funs := fixtureMapInsert symbol
+      (.ProcDecl (CerbLocation.other "test") (.BTy_loaded .OTy_integer)
+        (List.replicate 4 (.BTy_object .OTy_pointer))) fmapEmpty
+    funinfo := fixtureMapInsert symbol (CerbLocation.other "test", no_attributes, signed_int,
+      pairTypes.map (fun type => (none,type)),false,true) fmapEmpty
+    extern := fmapAddBy identCompare (.Identifier (CerbLocation.other "test") "socketpair")
+      ([symbol],.LK_none) fmapEmpty
+  }
+  let pairArguments := arguments ++ [.Vobject (.OVpointer pointer)]
+  let _ ← take (admit callLocation pairFile fmapEmpty symbol
+    (functionType signed_int pairTypes) pairArguments)
+  for wrong in [shortPointer,constPointer,pointerPointer] do
+    ensure (fails (admit callLocation pairFile fmapEmpty symbol
+      (functionType signed_int [signed_int,signed_int,signed_int,wrong]) pairArguments))
+      "call pointer referent or qualifiers differ despite upstream ctypeEqual fallback"
+  let wrongDeclared := { pairFile with
+    funinfo := fixtureMapInsert symbol (CerbLocation.other "test", no_attributes, signed_int,
+      [(none,signed_int),(none,signed_int),(none,signed_int),(none,shortPointer)],false,true)
+      fmapEmpty
+  }
+  ensure (fails (admit callLocation wrongDeclared fmapEmpty symbol
+    (functionType signed_int [signed_int,signed_int,signed_int,shortPointer]) pairArguments))
+    "matching wrong pointer prototypes cannot bypass the socketpair int-pointer contract"
+  ensure ((← take (planPollCount 0 none)) == .withoutArray)
+    "zero count does not need descriptor inventory"
+  ensure ((← take (planPollCount 4294967296 none)) == .withoutArray)
+    "nfds_t high bits must narrow before array access"
+  ensure ((← take (planPollCount 4294967297 (some 10240))) == .array 1)
+    "large nfds_t with low word one reads only one record"
+  ensure ((← take (planPollCount 18446744073709551615 (some 10240))) == .withoutArray)
+    "narrowed count above limit fails before array access"
+  ensure ((← take (planPollCount 1 (some 0))) == .withoutArray)
+    "zero soft limit is observed, not treated as unknown"
+  ensure (fails (planPollCount 1 none))
+    "missing resource-limit evidence cannot authorize array reads"
+  ensure (fails (planPollCount (-1) (some 10240)) &&
+    fails (planPollCount 18446744073709551616 (some 10240)))
+    "count narrowing only follows exact source scalar admission"
+  let pollTypes := [pollPointerType, CellKind.unsignedLong.ty, signed_int]
+  let pollFile := { file with
+    funinfo := fixtureMapInsert symbol (CerbLocation.other "test", no_attributes, signed_int,
+      pollTypes.map (fun type => (none,type)),false,true) fmapEmpty
+    extern := fmapAddBy identCompare (.Identifier (CerbLocation.other "test") "poll")
+      ([symbol],.LK_none) fmapEmpty
+    tagDefs := pollTags
+  }
+  for (count, limit) in [(0,none), (4294967296,none),
+      (18446744073709551615,some 10240), (1,some 0)] do
+    let (arrayObject, pollState) ← argumentObject pollFile pollPointerType
+      (.MVpointer pollRecordType (nullPtrval pollRecordType)) state
+    let (countObject, pollState) ← argumentObject pollFile CellKind.unsignedLong.ty
+      (.MVinteger (.Unsigned .Long) (.IV .Prov_none count)) pollState
+    let (timeoutObject, pollState) ← argumentObject pollFile signed_int
+      (.MVinteger CellKind.signedInt.ity (.IV .Prov_none 0)) pollState
+    let pollArguments := [arrayObject,countObject,timeoutObject].map
+      (fun object => value.Vobject (.OVpointer object))
+    let admittedPoll ← take (admit callLocation pollFile fmapEmpty symbol
+      (functionType signed_int pollTypes) pollArguments)
+    let decodedPoll ← take (decode admittedPoll pollState limit)
+    ensure (match decodedPoll.request with
+      | .poll_no_array original 0 => original == count
+      | _ => false) "admission retains original count without touching NULL array"
+    ensure (decodedPoll.inputFootprints.length == 3)
+      "no-array poll only loads its three parameter objects"
+  IO.println "network-admission-ok"
+
+def main (args : List String) : IO Unit := do
+  match args with
+  | [fuel] =>
+    match fuel.toNat? with
+    | some budget => @run ⟨budget⟩ ⟨CerbGlobal.defaultSwitches⟩
+    | none => throw (IO.userError "expected checked-runner fuel argument")
+  | _ => throw (IO.userError "expected checked-runner fuel argument")
