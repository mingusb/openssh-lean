+    | CabsEpredecr e -> expr st e
+    | CabsEunary _ e -> expr st e
+    | CabsEsizeof_expr e -> expr st e
+    | CabsEsizeof_type t -> ty st t
+    | CabsEalignof t -> ty st t
+    | CabsEalignof_expr e -> expr st e
+    | CabsEcast t e -> expr (ty st t) e
+    | CabsEbinary _ a b -> expr (expr st a) b
+    | CabsEcond a b c -> expr (expr (expr st a) b) c
+    | CabsEassign _ a b -> expr (expr st a) b
+    | CabsEcomma a b -> expr (expr st a) b
+    | CabsEassert e -> expr st e
+    | CabsEoffsetof t _ -> ty st t
+    | CabsEoffsetof_path t _ ds -> List.foldl (fun acc d -> gnu_region_scan_designator path switch_path acc d) (ty st t) ds
