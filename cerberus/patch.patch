+import Vla_types
+import Ctype_lemMeasureProofs
+
+set_option autoImplicit false
+
+namespace Vla_types_lemMeasureProofs
+
+/-- Both mutually recursive workers are stable once their derived structural
+    measure is within the supplied fuel. The parameter-list measure includes
+    one extra step for its empty-list base case. -/
+private theorem vla_symbols_stable_aux (k : Nat) :
+    (∀ (ty : ctype) (f g : Nat),
+      ctype.lemSize ty ≤ k →
+      ctype.lemSize ty ≤ f →
+      ctype.lemSize ty ≤ g →
+      vla_type_symbols_lemFuel f ty = vla_type_symbols_lemFuel g ty) ∧
+    (∀ (parameters : List (qualifiers × ctype × Bool)) (f g : Nat),
+      ctype_.lemSize_aux1 parameters + 1 ≤ k →
+      ctype_.lemSize_aux1 parameters + 1 ≤ f →
+      ctype_.lemSize_aux1 parameters + 1 ≤ g →
+      vla_parameter_symbols_lemFuel f parameters =
+        vla_parameter_symbols_lemFuel g parameters) := by
+  induction k with
+  | zero =>
+      constructor
+      · intro ty f g hk hf hg
+        have hpos := Ctype_lemMeasureProofs.ctype_lemSize_pos ty
+        omega
+      · intro parameters f g hk hf hg
+        omega
+  | succ k ih =>
+      obtain ⟨ih_type, ih_parameters⟩ := ih
+      constructor
+      · intro ty f g hk hf hg
+        have hpos := Ctype_lemMeasureProofs.ctype_lemSize_pos ty
+        cases f with
+        | zero => omega
+        | succ f =>
+            cases g with
+            | zero => omega
+            | succ g =>
+                cases ty with
+                | Ctype annotations node =>
+                    cases node <;> try rfl
+                    case VariableArray element bound =>
+                        simp only [ctype.lemSize, ctype_.lemSize] at hk hf hg
+                        have hstable := ih_type element f g
+                          (by omega) (by omega) (by omega)
+                        change vla_unique_symbols
+                            (vla_type_symbols_lemFuel f element ++ [bound]) =
+                          vla_unique_symbols
+                            (vla_type_symbols_lemFuel g element ++ [bound])
+                        rw [hstable]
+                    case Array0 element count =>
+                        simp only [ctype.lemSize, ctype_.lemSize] at hk hf hg
+                        have hstable := ih_type element f g
+                          (by omega) (by omega) (by omega)
+                        change vla_type_symbols_lemFuel f element =
+                          vla_type_symbols_lemFuel g element
+                        exact hstable
+                    case Pointer qualifiers element =>
+                        simp only [ctype.lemSize, ctype_.lemSize] at hk hf hg
+                        have hstable := ih_type element f g
+                          (by omega) (by omega) (by omega)
+                        change vla_type_symbols_lemFuel f element =
+                          vla_type_symbols_lemFuel g element
+                        exact hstable
+                    case Atomic element =>
+                        simp only [ctype.lemSize, ctype_.lemSize] at hk hf hg
+                        have hstable := ih_type element f g
+                          (by omega) (by omega) (by omega)
+                        change vla_type_symbols_lemFuel f element =
+                          vla_type_symbols_lemFuel g element
+                        exact hstable
+                    case Function function parameters variadic =>
+                        cases function with
+                        | mk qualifiers result =>
+                            simp only [ctype.lemSize, ctype_.lemSize] at hk hf hg
+                            have hresult := ih_type result f g
+                              (by omega) (by omega) (by omega)
+                            have hparameters := ih_parameters parameters f g
+                              (by omega) (by omega) (by omega)
+                            change vla_unique_symbols
+                                (vla_type_symbols_lemFuel f result ++
+                                  vla_parameter_symbols_lemFuel f parameters) =
+                              vla_unique_symbols
+                                (vla_type_symbols_lemFuel g result ++
+                                  vla_parameter_symbols_lemFuel g parameters)
+                            rw [hresult, hparameters]
+                    case FunctionNoParams function =>
+                        cases function with
+                        | mk qualifiers result =>
+                            simp only [ctype.lemSize, ctype_.lemSize] at hk hf hg
+                            have hresult := ih_type result f g
+                              (by omega) (by omega) (by omega)
+                            change vla_type_symbols_lemFuel f result =
+                              vla_type_symbols_lemFuel g result
+                            exact hresult
+      · intro parameters f g hk hf hg
+        have hpos : 0 < ctype_.lemSize_aux1 parameters + 1 := by omega
+        cases f with
+        | zero => omega
+        | succ f =>
+            cases g with
+            | zero => omega
+            | succ g =>
+                cases parameters with
+                | nil => rfl
+                | cons head rest =>
+                    obtain ⟨qualifiers, ty, flag⟩ := head
+                    simp only [ctype_.lemSize_aux1] at hk hf hg
+                    have hparam := Ctype_lemMeasureProofs.ctype_param_lt
+                      ty qualifiers flag ((qualifiers, ty, flag) :: rest) (by simp)
+                    have htype := ih_type ty f g
+                      (by omega) (by omega) (by omega)
+                    have htail := ih_parameters rest f g
+                      (by omega) (by omega) (by omega)
+                    change vla_type_symbols_lemFuel f ty ++
+                        vla_parameter_symbols_lemFuel f rest =
+                      vla_type_symbols_lemFuel g ty ++
+                        vla_parameter_symbols_lemFuel g rest
+                    rw [htype, htail]
+
+theorem vla_type_symbols_measure_sufficient (ty : ctype) (lemFuel : Nat)
+    (lemMeasureLe : ctype.lemSize ty ≤ lemFuel) :
+    vla_type_symbols_lemFuel lemFuel ty = vla_type_symbols ty := by
+  have hstable := (vla_symbols_stable_aux (ctype.lemSize ty)).1
+    ty (ctype.lemSize ty) lemFuel (Nat.le_refl _) (Nat.le_refl _) lemMeasureLe
+  simpa only [vla_type_symbols] using hstable.symm
+
+theorem vla_parameter_symbols_measure_sufficient
+    (parameters : List (qualifiers × ctype × Bool)) (lemFuel : Nat)
+    (lemMeasureLe : ctype_.lemSize_aux1 parameters + 1 ≤ lemFuel) :
+    vla_parameter_symbols_lemFuel lemFuel parameters =
+      vla_parameter_symbols parameters := by
+  have hstable :=
+    (vla_symbols_stable_aux (ctype_.lemSize_aux1 parameters + 1)).2
+      parameters (ctype_.lemSize_aux1 parameters + 1) lemFuel
+      (Nat.le_refl _) (Nat.le_refl _) lemMeasureLe
+  simpa only [vla_parameter_symbols] using hstable.symm
+
+end Vla_types_lemMeasureProofs
