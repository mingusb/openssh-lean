+(* Only direct lexical stores are summarized here. The complete expression is
+   still evaluated normally; this summary merely protects disjoint snapshots
+   while evaluating a call's callee and arguments, before the call itself can
+   modify memory. Indirect stores and nested calls retain broad invalidation. *)
+val gnu_memory_direct_writes: A.expression GenTypes.genTypeCategory -> maybe (list Symbol.sym)
+let rec gnu_memory_direct_writes (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_size_effects expr = Just false then Just [] else match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident sym)) right ->
+        if gnu_size_effects right = Just false then Just [sym] else Nothing
+    | A.AilEunary A.PostfixIncr (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> Just [sym]
+    | A.AilEunary A.PostfixDecr (A.AnnotatedExpression _ _ _ (A.AilEident sym)) -> Just [sym]
+    | A.AilEcompoundAssign (A.AnnotatedExpression _ _ _ (A.AilEident sym)) _ right ->
+        if gnu_size_effects right = Just false then Just [sym] else Nothing
+    | A.AilEbinary left A.Comma right ->
+        (match (gnu_memory_direct_writes left, gnu_memory_direct_writes right) with
+          | (Just first, Just second) -> Just (first ++ second)
+          | _ -> Nothing end)
+    | A.AilEannot _ operand -> gnu_memory_direct_writes operand
+    | A.AilEcast _ _ operand -> gnu_memory_direct_writes operand
+    | _ -> Nothing
+  end
+
+val gnu_memory_call_evaluation_writes: A.expression GenTypes.genTypeCategory -> maybe (list Symbol.sym)
+let rec gnu_memory_call_evaluation_writes (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEcall (A.AnnotatedExpression _ _ _ (A.AilEbuiltin _)) _ -> Nothing
+    | A.AilEcall callee args -> List.foldl (fun acc operand ->
+        match (acc, gnu_memory_direct_writes operand) with
+          | (Just first, Just second) -> Just (first ++ second)
+          | _ -> Nothing end) (Just []) (callee :: args)
+    | A.AilEannot _ operand -> gnu_memory_call_evaluation_writes operand
+    | A.AilEcast _ _ operand -> gnu_memory_call_evaluation_writes operand
+    | A.AilEbinary left _ right ->
+        if gnu_inline_closed_integer_origin right then gnu_memory_call_evaluation_writes left
+        else if gnu_inline_closed_integer_origin left then gnu_memory_call_evaluation_writes right
+        else Nothing
+    | _ -> Nothing
+  end
+
+(* A pointer object's identity/extent survives a store to a distinct complete
+   arithmetic object. Its cached pointee contents need not: the pointer may
+   point to that very arithmetic object. Drop all contents, including nested
+   scalar snapshots, while preserving only positively known pointer facts. *)
+val gnu_memory_pointer_identity: E.gnu_inline_fact -> maybe E.gnu_inline_fact
+let rec gnu_memory_pointer_identity fact = match fact with
+  | E.GNU_inline_function_fact _ _ -> Just fact
+  | E.GNU_inline_unknown_extent_fact -> Just fact
+  | E.GNU_inline_unknown_value_fact -> Just fact
+  | E.GNU_inline_alloc_size_fact _ _ -> Just fact
+  | E.GNU_inline_counted_extent_fact upper exact ->
+      (match (gnu_memory_pointer_identity upper, gnu_memory_pointer_identity exact) with
+        | (Just upper, Just exact) -> Just (E.GNU_inline_counted_extent_fact upper exact)
+        | _ -> Nothing end)
+  | E.GNU_inline_dynamic_bound_fact saved -> maybe Nothing
+      (fun saved -> Just (E.GNU_inline_dynamic_bound_fact saved)) (gnu_memory_pointer_identity saved)
+  | E.GNU_inline_constant_alloc_size_fact _ -> Just fact
+  | E.GNU_inline_offset_extent_fact base index ty subtract dependencies ->
+      maybe Nothing (fun base -> Just (E.GNU_inline_offset_extent_fact base index ty subtract dependencies))
+        (gnu_memory_pointer_identity base)
+  | E.GNU_inline_extent_fact a b c extent _ ->
+      Just (E.GNU_inline_extent_fact a b c extent [])
+  | E.GNU_inline_extent_join_fact alternatives ->
+      let stripped = List.foldr (fun child acc ->
+        match (gnu_memory_pointer_identity child, acc) with
+          | (Just value, Just values) -> Just (value :: values)
+          | _ -> Nothing end) (Just []) alternatives in
+      maybe Nothing (fun values -> if values = [] then Nothing else
+        Just (E.GNU_inline_extent_join_fact values)) stripped
+  | E.GNU_inline_selected_extent_fact selector yes no ->
+      (match (gnu_memory_pointer_identity yes, gnu_memory_pointer_identity no) with
+        | (Just first, Just second) -> Just (E.GNU_inline_selected_extent_fact selector first second)
+        | _ -> Nothing end)
+  | _ -> Nothing
+end
+
+(* Opaque calls cannot write a complete unescaped automatic pointer object.
+   They can change its pointee, so retain identity/extent only, never contents.
+   The same escape/write check applies to every referenced size or offset. *)
+val gnu_memory_unescaped_pointer_survivors_for:
+  list (A.expression GenTypes.genTypeCategory) -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_memory_unescaped_pointer_survivors_for operands =
+  E.retain_gnu_current_private_objects (fun subject ->
+    List.all (gnu_alloc_size_subject_expression subject) operands) >>
+  E.gnu_memory_snapshot >>= fun (facts, _, _) ->
+  E.mapM (fun (slot, fact) -> match slot with
+    | (false, sym, path) ->
+        let subjects = sym :: gnu_inline_fact_alloc_size_dependencies fact in
+        E.mapM (fun subject -> E.gnu_alloc_size_subject_allowed subject >>= fun unescaped ->
+          E.gnu_current_private_object subject >>= fun currently_private ->
+          E.lookup_gnu_analysis_object_type subject >>= fun object_ty ->
+          (* Runtime privacy alone does not preserve GCC's earlier static
+             size knowledge for a later-escaped object. The current-point
+             certificate carries only an already-positive unknown class. *)
+          E.return ((unescaped ||
+              (currently_private && fact = E.GNU_inline_unknown_extent_fact)) && (match object_ty with
+            | Just (qs, ty) -> not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+                (subject <> sym || (if path = [] then AilTypesAux.is_pointer ty
+                  else AilTypesAux.is_struct_or_union ty && gnu_inline_fixed_object_type ty))
+            | Nothing -> false end))) subjects >>= fun unescaped ->
+        if not (List.all (fun ok -> ok) unescaped) ||
+            not (List.all (fun subject -> List.all
+              (gnu_inline_parameter_expression_safe subject) operands) subjects)
+        then E.return Nothing else
+          E.return (maybe Nothing (fun value -> Just (slot, value)) (gnu_memory_pointer_identity fact))
+    | _ -> E.return Nothing end) facts >>= fun optional ->
+  E.return (List.foldr (fun entry rest -> maybe rest (fun value -> value :: rest) entry) [] optional)
+
+val gnu_memory_unescaped_pointer_survivors:
+  A.expression GenTypes.genTypeCategory -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_memory_unescaped_pointer_survivors expr =
+  gnu_memory_unescaped_pointer_survivors_for [expr]
+
+(* A later address escape does not expose a fresh automatic object to an
+   earlier call. Preserve only closed ordinary pointer identities from the
+   current private frame. Reuse an existing whole-body survivor certificate
+   for static knowledge; current-point privacy alone grants dynamic bounds.
+   The original call and its effects are not replaced or summarized away. *)
+val gnu_current_private_pointer_call_survivors:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_current_private_pointer_call_survivors tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilEcall _ _ ->
+        E.gnu_visible_current_frame_objects >>= fun frame_objects ->
+        gnu_memory_unescaped_pointer_survivors expr >>= fun unescaped ->
+        E.gnu_memory_snapshot >>= fun (facts, _, _) ->
+        E.mapM (fun (((indirect, sym, path) as slot), fact) ->
+          if indirect || not (List.elem sym frame_objects) ||
+              not (gnu_alloc_size_subject_expression sym expr &&
+                gnu_inline_parameter_expression_safe sym expr)
+          then E.return Nothing else
+          E.gnu_current_private_object sym >>= fun currently_private ->
+          if not currently_private then E.return Nothing else
+          E.lookup_gnu_analysis_object_type sym >>= fun object_ty ->
+          let ordinary = maybe false (fun (qs, ty) ->
+            List.elem path (gnu_inline_pointer_member_paths tagDefs [] qs ty)) object_ty in
+          if not ordinary then E.return Nothing else
+          E.return (match gnu_memory_pointer_identity fact with
+            | Just identity ->
+                if not (gnu_member_fact_closed identity) ||
+                    gnu_inline_fact_alloc_size_dependencies identity <> []
+                then Nothing else
+                (match identity with
+                  | E.GNU_inline_extent_fact false _ _ _ _ ->
+                      (* This summary may be installed before initializer
+                         translation. Do not downgrade an independently
+                         certified whole-body survivor for the same slot.
+                         Both paths retain identity only, never contents. *)
+                      (* The pinned GCC O2 profile loses the static mode-0
+                         bound after an opaque call when this private pointer
+                         escapes later, even though its current dynamic value
+                         is still available. Preserve that distinction in the
+                         existing static-upper/dynamic-exact fact pair. *)
+                      Just (slot, maybe (E.GNU_inline_counted_extent_fact
+                        E.GNU_inline_unknown_extent_fact identity)
+                        (fun preserved -> preserved) (List.lookup slot unescaped))
+                  | E.GNU_inline_dynamic_bound_fact _ -> Just (slot, identity)
+                  | _ -> Nothing end)
+            | Nothing -> Nothing end)) facts >>= fun optional ->
+        E.return (List.foldr (fun item rest ->
+          maybe rest (fun fact -> fact :: rest) item) [] optional)
+    | _ -> E.return []
+  end
+
+(* A complete unescaped automatic integer cannot be written by another call.
+   Keep only previously established bounds or closed constants; no type-domain
+   fallback or nonconstancy certificate is created. Even unchanged values can
+   become correlated with a call's return, so remove non-singleton density. *)
+val gnu_memory_unescaped_scalar_survivors_for:
+  list (A.expression GenTypes.genTypeCategory) -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_memory_unescaped_scalar_survivors_for operands =
+  E.gnu_memory_snapshot >>= fun (facts, _, _) ->
+  E.mapM (fun (slot, fact) -> match slot with
+    | (false, sym, []) ->
+        E.gnu_alloc_size_subject_allowed sym >>= fun unescaped ->
+        E.lookup_gnu_analysis_object_type sym >>= fun object_ty ->
+        let scalar = match object_ty with
+          | Just (qs, ty) -> not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+              AilTypesAux.is_integer ty
+          | Nothing -> false end in
+        if not unescaped || not scalar || not (List.all
+            (gnu_inline_parameter_expression_safe sym) operands)
+        then E.return Nothing else
+        E.return (match fact with
+          | E.GNU_inline_integer_fact origin ->
+              if gnu_inline_closed_integer_origin origin && gnu_size_effects origin = Just false
+              then Just (slot, fact) else Nothing
+          | E.GNU_inline_integer_range_fact low high _ ->
+              if low <= high then Just (slot, E.GNU_inline_integer_range_fact low high (low = high)) else Nothing
+          | E.GNU_inline_integer_progression_fact low high step ->
+              if step > 0 && low <= high && (high-low) mod step = 0
+              then Just (slot, E.GNU_inline_integer_range_fact low high (low = high)) else Nothing
+          | _ -> Nothing end)
+    | _ -> E.return Nothing end) facts >>= fun optional ->
+  E.return (List.foldr (fun entry rest -> maybe rest (fun value -> value :: rest) entry) [] optional)
+
+val gnu_memory_unescaped_value_survivors_for:
+  list (A.expression GenTypes.genTypeCategory) -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_memory_unescaped_value_survivors_for operands =
+  gnu_memory_unescaped_pointer_survivors_for operands >>= fun pointers ->
+  gnu_memory_unescaped_scalar_survivors_for operands >>= fun scalars ->
+  E.return (pointers ++ scalars)
+
+val gnu_memory_unescaped_value_survivors:
+  A.expression GenTypes.genTypeCategory -> E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_memory_unescaped_value_survivors expr =
+  gnu_memory_unescaped_value_survivors_for [expr]
+
+(* Only guaranteed evaluation introduces an opaque memory definition here.
+   A call confined to an unselected conditional/short-circuit arm is not enough.
+   The caller separately verifies that every other effect is understood. *)
+val gnu_single_return_expression:
+  A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_single_return_expression stmt = match stmt.A.node with
+  | A.AilSreturn value -> Just value
+  | A.AilSblock _ [child] -> gnu_single_return_expression child
+  | A.AilSmarker _ child -> gnu_single_return_expression child
+  | _ -> Nothing
+end
+
+val gnu_guaranteed_opaque_call_seen:
+  list Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_guaranteed_opaque_call_seen visited (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_guaranteed_opaque_call_seen visited in
+  let any operands = E.mapM self operands >>= fun values -> E.return (List.any (fun value -> value) values) in
+  match node with
+    | A.AilEcall callee args ->
+        gnu_memory_certified_readonly expr >>= fun readonly ->
+        gnu_call_attributes callee >>= fun attrs ->
+        let declared_readonly = Cerb_attributes.has_gnu_noarg_attribute "pure" attrs ||
+          Cerb_attributes.has_gnu_noarg_attribute "const" attrs in
+        gnu_ordinary_opaque_memory_call callee >>= fun opaque ->
+        if opaque && not readonly && not declared_readonly then E.return true else
+        any (callee :: args) >>= fun argument_call ->
+        if argument_call then E.return true else
+        (* A readonly wrapper's body is not a caller-visible memory clobber.
+           Its argument effects have been checked independently above. *)
+        if readonly || declared_readonly then E.return false else
+        if not (gnu_inline_direct_designator callee &&
+            List.all gnu_memory_expression_readonly args)
+        then E.return false else
+        gnu_inline_function_target callee >>= (function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              if List.elem target visited then E.return false else
+              E.gnu_memory_call_body target >>= (function
+                | Nothing -> E.return false
+                | Just (params, body) ->
+                    if List.length params <> List.length args then E.return false else
+                    (* A normal return through this exact wrapper requires its
+                       returned expression. Prefixes and alternative returns
+                       need a separate path proof and remain unsupported. *)
+                    maybe (E.return false)
+                      (gnu_guaranteed_opaque_call_seen (target :: visited))
+                      (gnu_single_return_expression body)
+              end)
+        end)
+    | A.AilEbinary first A.And _ -> self first
+    | A.AilEbinary first A.Or _ -> self first
+    | A.AilEbinary first _ second -> any [first; second]
+    | A.AilEcond test _ _ -> self test
+    | A.AilEassign left right -> any [left; right]
+    | A.AilErvalue child -> self child
+    | A.AilEunary A.Plus child -> self child
+    | A.AilEunary A.Minus child -> self child
+    | A.AilEunary A.Bnot child -> self child
+    | A.AilEunary A.Address child -> self child
+    | A.AilEunary A.Indirection child -> self child
+    | A.AilEmemberof child _ -> self child
+    | A.AilEmemberofptr child _ -> self child
+    | A.AilEarray_decay child -> self child
+    | A.AilEannot _ child -> self child
+    | A.AilEcast _ _ child -> self child
+    | _ -> E.return false
+  end
+
+val gnu_guaranteed_opaque_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_guaranteed_opaque_call expr = gnu_guaranteed_opaque_call_seen [] expr
+
+(* A compiler-visible call clobber differs from failure to analyse a load.
+   Require an existing pointer fact AND an ordinary opaque formal root. An
+   unrestricted externally supplied object may be reached by the external call;
+   after its opaque memory definition, the reload has no visible allocation
+   origin. Complete private pointer values retain their original identity. *)
+(* Enumerate the supported counter effect without evaluating it. No call,
+   pointer store or hidden effect can enter this finite footprint. *)
+val gnu_memory_operand_counter_writes:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe (list E.gnu_memory_slot))
+let rec gnu_memory_operand_counter_writes (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_memory_operand_counter_writes in
+  if gnu_size_effects expr = Just false then E.return (Just []) else
+  match gnu_inline_counter_destination expr with
+    | Just destination -> gnu_memory_slot_of true destination >>= fun slot ->
+        E.return (maybe Nothing (fun value -> Just [value]) slot)
+    | Nothing -> (match node with
+        | A.AilEbinary left _ right ->
+            self left >>= fun first -> self right >>= fun second ->
+            E.return (match (first, second) with
+              | (Just first, Just second) -> Just (first ++ second)
+              | _ -> Nothing end)
+        | A.AilEannot _ operand -> self operand
+        | A.AilEcast _ _ operand -> self operand
+        | _ -> E.return Nothing end)
+  end
+
+val gnu_memory_operand_survivors:
+  list (A.expression GenTypes.genTypeCategory) ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym)
+let gnu_memory_operand_survivors operands =
+  gnu_memory_unescaped_value_survivors_for operands >>= fun private_facts ->
+  E.mapM gnu_memory_operand_counter_writes operands >>= fun counter_writes ->
+  let writes = List.foldl (fun acc value -> match (acc, value) with
+    | (Just first, Just second) -> Just (first ++ second)
+    | _ -> Nothing end) (Just []) counter_writes in
+  (match writes with
+    | Just [written] ->
+        E.gnu_memory_snapshot >>= fun (facts, _, _) ->
+        E.gnu_memory_disjoint_parameters >>= fun relations ->
+        E.gnu_indexed_memory_symbols >>= fun indexed ->
+        let (_, written_root, _) = written in
+        let survivors = List.filter (fun (((_, sym, _) as slot), fact) ->
+          fact = E.GNU_inline_unknown_extent_fact &&
+          not (List.elem sym indexed || List.elem written_root indexed) &&
+          gnu_memory_distinct_roots relations slot written) facts in
+        E.return (private_facts ++ survivors, [])
+    | _ ->
+  E.mapM gnu_opaque_memory_effects operands >>= fun allowed ->
+  if not (List.all (fun value -> value) allowed) then
+    gnu_private_global_memory_survivors operands >>= fun static_facts ->
+    E.return (private_facts ++ static_facts, []) else
+  E.mapM gnu_guaranteed_opaque_call operands >>= fun clobbers ->
+  E.gnu_memory_snapshot >>= fun (facts, roots, _) ->
+  E.gnu_indexed_memory_symbols >>= fun indexed ->
+  E.gnu_opaque_clobber_slots >>= fun clobberable ->
+  E.mapM (fun (slot, fact) ->
+    let (indirect, sym, _) = slot in
+    if List.elem sym indexed then E.return Nothing else match fact with
+      | E.GNU_inline_unknown_extent_fact -> E.return (Just (slot, fact))
+      | _ ->
+          if not indirect || not (List.any (fun value -> value) clobbers) ||
+              isNothing (gnu_memory_pointer_identity fact) then E.return Nothing else
+          E.gnu_branch_parameter_subject_allowed sym >>= fun parameter ->
+          E.gnu_compiler_fact sym >>= fun origin ->
+          (* Reuse the entry's typed mutable-slot certificate. Ordinary
+             parameter objects need not inhabit the local automatic-object map;
+             absence there is neither type information nor a no-alias proof. *)
+          let eligible = parameter && List.elem slot clobberable &&
+            gnu_inline_opaque_base origin in
+          let () = Debug.print_debug 2 [Debug.DB_elaboration] (fun () ->
+            "GNU operand clobber subject=" ^ show sym ^ "; eligible=" ^ show eligible ^
+            "; typed-slot=" ^ show (List.elem slot clobberable) ^
+            "; origin=" ^ gnu_inline_fact_kind origin) in
+          E.return (if eligible then Just (slot, E.GNU_inline_unknown_extent_fact) else Nothing)
+    end) facts >>= fun optional ->
+  let survivors = List.foldr (fun item rest -> maybe rest (fun value -> value :: rest) item) [] optional in
+  let retained_roots = List.filter (fun root -> not (List.elem root indexed) &&
+    not (List.any (fun (slot, fact) ->
+      let (_, sym, _) = slot in
+      sym = root && isJust (gnu_memory_pointer_identity fact) &&
+        List.lookup slot survivors <> Just E.GNU_inline_unknown_extent_fact) facts)) roots in
+  E.return (private_facts ++ survivors, retained_roots)
+  end)
+
+val gnu_call_evaluated_operands:
+  A.expression GenTypes.genTypeCategory -> list (A.expression GenTypes.genTypeCategory)
+let rec gnu_call_evaluated_operands (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEcall callee args -> callee :: args
+  | A.AilEannot _ child -> gnu_call_evaluated_operands child
+  | A.AilEcast _ _ child -> gnu_call_evaluated_operands child
+  | _ -> [expr]
+end
+
+val gnu_memory_prepare_call_evaluation: A.expression GenTypes.genTypeCategory -> E.elabM unit
+let gnu_memory_prepare_call_evaluation expr =
+  gnu_memory_certified_call_operands expr >>= fun readonly ->
+  if readonly then E.return () else
+  match gnu_memory_call_evaluation_writes expr with
+    | Nothing ->
+        gnu_memory_operand_survivors (gnu_call_evaluated_operands expr) >>= fun (facts, roots) ->
+        E.clear_gnu_memory_facts >>
+        E.with_preserved_gnu_memory facts roots [] (E.return ())
+    | Just writes ->
+        E.gnu_memory_snapshot >>= fun (facts, _, aliases) ->
+        let disjoint (indirect, sym, _) = not indirect && not (List.elem sym writes) in
+        E.clear_gnu_memory_facts >>
+        E.mapM_ (fun (slot, fact) ->
+          let dependencies = gnu_inline_fact_alloc_size_dependencies fact in
+          if disjoint slot && not (List.any (fun dependency -> List.elem dependency writes) dependencies)
+          then E.register_gnu_memory_fact slot fact else E.return ()) facts >>
+        E.mapM_ (fun (sym, slot) -> if not (List.elem sym writes) && disjoint slot then
+          E.register_gnu_memory_alias sym slot else E.return ()) aliases
+  end
+
+(* A top-level GNU compound expression enters its statements in source order.
+   Let those statements invalidate memory facts at their actual effects; an
+   eager unknown-call invalidation would discard even the incoming parameter
+   facts before the first statement. Only transparent single-operand wrappers
+   qualify here. Calls, binary operands and other potentially unsequenced
+   contexts retain their ordinary pre-evaluation invalidation. *)
+val gnu_memory_statement_expression_root: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_memory_statement_expression_root (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEgcc_statement _ _ -> true
+    | A.AilEannot _ operand -> gnu_memory_statement_expression_root operand
+    | A.AilEcast _ _ operand -> gnu_memory_statement_expression_root operand
+    | _ -> false
+  end
+
+(* A completed direct pointer assignment establishes a new storage alias.
+   Capture only the literal address of one ordinary named complete object;
+   no initial-formal identity, loaded pointer, cast or deferred address is used.
+   Publish it with the post-store state, never before the original assignment. *)
+val gnu_memory_direct_address_assignment:
+  A.expression GenTypes.genTypeCategory -> maybe (Symbol.sym * E.gnu_memory_slot)
+let gnu_memory_direct_address_assignment (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident destination) as left)
+        (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address
+          (A.AnnotatedExpression _ _ _ (A.AilEident target) as target_object))) ->
+        let (left_qs, left_ty) = qualified_ctype_of left in
+        let (object_qs, object_ty) = qualified_ctype_of target_object in
+        if destination = target || left_qs.Ctype.volatile || object_qs.Ctype.volatile ||
+            AilTypesAux.is_atomic left_ty || AilTypesAux.is_atomic object_ty ||
+            not (gnu_inline_fixed_object_type object_ty)
+        then Nothing else
+          (match left_ty with
+            | Ctype.Ctype _ (Ctype.Pointer _ pointed) ->
+                if AilTypesAux.is_function pointed ||
+                    not (gnu_function_target_type_equal pointed object_ty)
+                then Nothing else Just (destination, (false, target, []))
+            | _ -> Nothing end)
+    | _ -> Nothing
+  end
+
+val gnu_memory_prepare_expression: A.expression GenTypes.genTypeCategory -> E.elabM unit
+let rec gnu_memory_prepare_expression (A.AnnotatedExpression _ _ _ node as operand) =
+  E.retain_gnu_current_private_objects (fun subject ->
+    gnu_alloc_size_subject_expression subject operand) >>
+  let prepare_unsequenced () =
+    if gnu_memory_expression_readonly operand || gnu_memory_call_arguments_readonly operand ||
+        gnu_memory_statement_expression_root operand
+    then E.return () else gnu_memory_prepare_call_evaluation operand in
+  (* Only the first operand runs before a sequence point. Later operands
+     prepare their own incoming facts in the conditional/comma lowering.
+     Unsequenced siblings retain the conservative whole-expression rule. *)
+  (match node with
+    | A.AilEbinary first A.And _ -> gnu_memory_prepare_expression first
+    | A.AilEbinary first A.Or _ -> gnu_memory_prepare_expression first
+    | A.AilEbinary first A.Comma _ -> gnu_memory_prepare_expression first
+    | A.AilEcond first _ _ -> gnu_memory_prepare_expression first
+    | A.AilEbinary first _ second ->
+        (* An effect-free sibling cannot change the call's input facts,
+           even if it reads a runtime value. Descend through the wrapper before
+           preparing the call's own operands. This does not order evaluations
+           or suppress the original sibling read, call or subsequent store. *)
+        if gnu_memory_expression_readonly second
+        then gnu_memory_prepare_expression first
+        else if gnu_memory_expression_readonly first
+        then gnu_memory_prepare_expression second else prepare_unsequenced ()
+    | A.AilEannot _ child -> gnu_memory_prepare_expression child
+    | A.AilEcast _ _ child -> gnu_memory_prepare_expression child
+    | A.AilEassign (A.AnnotatedExpression _ _ _ (A.AilEident _) as destination) right ->
+        let (qs, ty) = qualified_ctype_of destination in
+        (* Computing a direct destination address cannot alter the RHS input
+           snapshot, including the address of a volatile arithmetic object.
+           This does not load that object: the original volatile store and its
+           narrower survivor check still follow evaluation of the RHS. *)
+        if (AilTypesAux.is_arithmetic ty || AilTypesAux.is_pointer ty) &&
+            (not qs.Ctype.volatile || AilTypesAux.is_arithmetic ty) &&
+            not (AilTypesAux.is_atomic ty)
+        then gnu_memory_prepare_expression right else prepare_unsequenced ()
+    | A.AilEcompoundAssign (A.AnnotatedExpression _ _ _ (A.AilEident _) as destination) _ right ->
+        let (qs, ty) = qualified_ctype_of destination in
+        (* This direct scalar destination introduces no address-evaluation
+           effect, and its store follows the operand computations. Prepare
+           the RHS at its own sequencing boundary; nested calls/writes retain
+           their existing invalidation. Post-expression clearing is unchanged. *)
+        if AilTypesAux.is_arithmetic ty && not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty)
+        then gnu_memory_prepare_expression right else prepare_unsequenced ()
+    | _ -> prepare_unsequenced ()
+  end) >>
+  E.retain_gnu_flow_facts (fun sym -> gnu_inline_parameter_expression_safe sym operand)
+
+(* Distinct fields of a struct do not overlap. Union alternatives, an
+   ancestor/descendant path, and unrelated indirect roots do not establish
+   disjointness. Compare named subobjects only; casts/offsets have no slot. *)
+val gnu_memory_paths_disjoint:
+  C.core_tag_definitions -> Ctype.ctype -> list Symbol.identifier -> list Symbol.identifier -> bool
+let rec gnu_memory_paths_disjoint tagDefs ty first second =
+  match (first, second) with
+    | (left :: rest_left, right :: rest_right) ->
+        (match ty with
+          | Ctype.Ctype _ (Ctype.Struct tag) ->
+              (match Map.lookup tag tagDefs with
+                | Just (_, Ctype.StructDef _ members _) ->
+                    (match (List.lookup left members, List.lookup right members) with
+                      | (Just (_, _, _, left_ty), Just _) ->
+                          if left <> right then true else
+                            gnu_memory_paths_disjoint tagDefs left_ty rest_left rest_right
+                      | _ -> false
+                    end)
+                | _ -> false
+              end)
+          | _ -> false
+        end)
+    | _ -> false
+  end
+
+(* Preserving an opaque root is safe only when a scalar store traverses
+   struct fields all the way down. A union edge or aggregate destination may
+   overwrite a pointer field even when its final spelling looks unrelated. *)
+val gnu_memory_struct_scalar_path:
+  C.core_tag_definitions -> Ctype.ctype -> list Symbol.identifier -> bool
+let rec gnu_memory_struct_scalar_path tagDefs ty path = match path with
+  | [] -> AilTypesAux.is_arithmetic ty
+  | ident :: rest -> (match ty with
+      | Ctype.Ctype _ (Ctype.Struct tag) -> (match Map.lookup tag tagDefs with
+          | Just (_, Ctype.StructDef _ members _) -> (match List.lookup ident members with
+              | Just (_, _, _, member_ty) -> gnu_memory_struct_scalar_path tagDefs member_ty rest
+              | _ -> false
+            end)
+          | _ -> false
+        end)
+      | _ -> false
+    end)
+end
+
+
+val gnu_memory_store_survivors_at:
+  C.core_tag_definitions -> E.gnu_memory_slot -> maybe Ctype.ctype ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot))
+let gnu_memory_store_survivors_at tagDefs (indirect, sym, path) root_ty =
+  E.gnu_memory_snapshot >>= fun (facts, roots, aliases) ->
+  E.gnu_indexed_memory_symbols >>= fun indexed ->
+  E.gnu_memory_disjoint_parameters >>= fun disjoint_parameters ->
+  (if indirect then E.gnu_incoming_disjoint_frame_pointers sym
+   else E.return []) >>= fun frame_pointers ->
+  E.gnu_alloc_size_subject_allowed sym >>= fun unescaped ->
+  let private_complete = not indirect && path = [] && unescaped &&
+    maybe false (fun ty -> AilTypesAux.is_arithmetic ty || AilTypesAux.is_pointer ty) root_ty in
+  let keep (other_indirect, other_sym, other_path) =
+    if private_complete && other_indirect && sym <> other_sym then true
+    else if not indirect && not other_indirect && sym <> other_sym then true
+    else if indirect && other_indirect &&
+        (List.elem (sym, other_sym) disjoint_parameters || List.elem (other_sym, sym) disjoint_parameters)
+      then true
+    else if indirect = other_indirect && sym = other_sym then
+      maybe false (fun ty -> gnu_memory_paths_disjoint tagDefs ty path other_path) root_ty
+    else false in
+  let standalone_arithmetic =
+    not indirect && path = [] && maybe false AilTypesAux.is_arithmetic root_ty in
+  (* A complete arithmetic object cannot overlap a pointer object. Retain an
+     indexed pointer value only when its address uses a separate unescaped
+     lexical pointer and literal index, never a mutable/aliased scalar load.
+     This retains no pointee contents, transitive root or alias certificate. *)
+  (if not standalone_arithmetic then E.return [] else
+    E.mapM (fun indexed_sym ->
+      E.gnu_indexed_memory_key indexed_sym >>= fun key ->
+      match maybe Nothing gnu_memory_constant_pointer_array_root key with
+        | Just base -> E.gnu_alloc_size_subject_allowed base >>= fun unescaped ->
+            E.return (if unescaped && base <> sym then Just indexed_sym else Nothing)
+        | Nothing -> E.return Nothing
+      end) indexed >>= fun optional ->
+    E.return (List.foldr (fun item acc -> maybe acc (fun sym -> sym :: acc) item) [] optional)
+  ) >>= fun stable_indexed ->
+  let kept_facts = List.foldr (fun (((other_indirect, _, _) as slot), fact) acc ->
+    let dependencies = gnu_inline_fact_alloc_size_dependencies fact in
+    let allocation_invalidated = dependencies <> [] &&
+      (indirect || path <> [] || List.elem sym dependencies) in
+    let (_, other_sym, _) = slot in
+    let fresh_pointer_slot = not other_indirect && List.elem other_sym frame_pointers &&
+      fact = E.GNU_inline_unknown_extent_fact in
+    if allocation_invalidated then acc
+    else if List.elem other_sym indexed then
+      if List.elem other_sym stable_indexed then
+        maybe acc (fun value -> (slot, value) :: acc) (gnu_memory_pointer_identity fact)
+      else acc
+    else if keep slot || fresh_pointer_slot then (slot, fact) :: acc
+    else if standalone_arithmetic && other_indirect then
+      maybe acc (fun value -> (slot, value) :: acc) (gnu_memory_pointer_identity fact)
+    else acc) [] facts in
+  let keep_root root =
+    (* A complete arithmetic object cannot overlap a distinct pointer object.
+       In particular a standalone call counter does not rewrite any opaque
+       formal's pointer-valued member. Member/union writes retain the stricter
+       same-root, struct-only rule below. *)
+    not (List.elem root indexed) &&
+      ((private_complete && root <> sym) ||
+      (not indirect && path = [] && maybe false AilTypesAux.is_arithmetic root_ty) ||
+      (indirect && root = sym && path <> [] &&
+        maybe false (fun ty -> gnu_memory_struct_scalar_path tagDefs ty path) root_ty)) in
+  let keep_alias (alias, (base_indirect, base, _)) =
+    not (List.elem base indexed) &&
+      not indirect && alias <> sym && (not base_indirect || base <> sym) in
+  E.return (kept_facts, List.filter keep_root roots, List.filter keep_alias aliases)
+
+val gnu_memory_store_survivors:
+  C.core_tag_definitions -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot))
+(* This identifies a prior opaque pointer load, not a disjoint allocation.
+   A character store may alias pointer representation, so only the already
+   certified unknown compiler extent survives; pointer values, aliases,
+   known bounds and all other memory knowledge are invalidated. *)
+val gnu_opaque_byte_store_origin:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_memory_slot)
+let rec gnu_opaque_byte_store_origin (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilErvalue operand ->
+      let (qs, ty) = qualified_ctype_of operand in
+      if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty)
+      then E.return Nothing else
+      gnu_memory_slot_of true operand >>= function
+        | Just slot -> E.gnu_memory_fact slot >>= function
+            | Just E.GNU_inline_unknown_extent_fact -> E.return (Just slot)
+            | _ -> E.return Nothing end
+        | _ -> E.return Nothing end
+  | A.AilEbinary pointer (A.Arithmetic A.Add) offset ->
+      if AilTypesAux.is_integer (ctype_of offset) && gnu_memory_expression_readonly offset
+      then gnu_opaque_byte_store_origin pointer
+      else if AilTypesAux.is_integer (ctype_of pointer) && gnu_memory_expression_readonly pointer
+      then gnu_opaque_byte_store_origin offset
+      else E.return Nothing
+  | A.AilEbinary pointer (A.Arithmetic A.Sub) offset ->
+      if AilTypesAux.is_integer (ctype_of offset) && gnu_memory_expression_readonly offset
+      then gnu_opaque_byte_store_origin pointer else E.return Nothing
+  | A.AilEcast _ ty operand ->
+      if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+      then gnu_opaque_byte_store_origin operand else E.return Nothing
+  | A.AilEannot _ operand -> gnu_opaque_byte_store_origin operand
+  | _ -> E.return Nothing
+end
+
+(* Byte contents may come from an ordinary integer parameter, as in an
+   encoded length. This admission does not evaluate the RHS or infer its value.
+   Exclude indirect loads and pointer-to-integer conversions: those could
+   transport a different pointer representation into aliased pointer storage. *)
+val gnu_opaque_byte_scalar_origin: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_opaque_byte_scalar_origin (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_opaque_byte_scalar_origin in
+  let (qs, ty) = qualified_ctype_of expr in
+  if not (AilTypesAux.is_integer ty) || qs.Ctype.volatile || AilTypesAux.is_atomic ty
+  then false else match node with
+    | A.AilEident _ -> true
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident _) as operand) -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEbinary left (A.Arithmetic _) right -> self left && self right
+    | _ -> gnu_inline_closed_integer_origin expr && gnu_memory_expression_readonly expr
+  end
+
+(* A struct integer-field store can clobber representation just like a byte
+   store. Preserve only the origin's existing opaque compiler class; no pointer
+   value, contents, aliases or known bound survives by this rule. Union paths
+   and pointer-bearing scalar expressions remain outside the certificate. *)
+val gnu_opaque_struct_store_origin:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_memory_slot)
+let rec gnu_opaque_struct_store_origin (A.AnnotatedExpression _ _ _ node) =
+  let structure ty = match ty with Ctype.Ctype _ (Ctype.Struct _) -> true | _ -> false end in
+  match node with
+    | A.AilEmemberofptr pointer _ -> (match ctype_of pointer with
+        | Ctype.Ctype _ (Ctype.Pointer qs pointed) ->
+            if qs.Ctype.volatile || not (structure pointed) then E.return Nothing else
+            gnu_opaque_byte_store_origin pointer
+        | _ -> E.return Nothing end)
+    | A.AilEmemberof base _ ->
+        if structure (ctype_of base) then gnu_opaque_struct_store_origin base else E.return Nothing
+    | A.AilEunary A.Indirection pointer -> (match ctype_of pointer with
+        | Ctype.Ctype _ (Ctype.Pointer qs pointed) ->
+            if qs.Ctype.volatile || not (structure pointed) then E.return Nothing else
+            gnu_opaque_byte_store_origin pointer
+        | _ -> E.return Nothing end)
+    | A.AilEannot _ child -> gnu_opaque_struct_store_origin child
+    | _ -> E.return Nothing
+  end
+
+val gnu_opaque_integer_store_value:
+  A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_opaque_integer_store_value (A.AnnotatedExpression _ _ _ node as value) =
+  if gnu_opaque_byte_scalar_origin value then E.return true else
+  if not (AilTypesAux.is_integer (ctype_of value)) then E.return false else match node with
+    | A.AilEcond test (Just yes) no ->
+        if not (gnu_opaque_byte_scalar_origin yes && gnu_opaque_byte_scalar_origin no)
+        then E.return false else gnu_opaque_memory_effects test
+    | _ -> E.return false
+  end
+
+val gnu_opaque_byte_store_survivor:
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_opaque_byte_store_survivor (A.AnnotatedExpression _ _ _ node as left) right =
+  let character = match ctype_of left with
+    | Ctype.Ctype _ (Ctype.Basic (Ctype.Integer Ctype.Char)) -> true
+    | Ctype.Ctype _ (Ctype.Basic (Ctype.Integer (Ctype.Signed Ctype.Ichar))) -> true
+    | Ctype.Ctype _ (Ctype.Basic (Ctype.Integer (Ctype.Unsigned Ctype.Ichar))) -> true
+    | _ -> false end in
+  let (qs, ty) = qualified_ctype_of left in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+      not (AilTypesAux.is_integer ty && gnu_memory_expression_readonly left)
+  then E.return [] else
+  gnu_opaque_integer_store_value right >>= fun scalar ->
+  if not scalar then E.return [] else
+  (match node with
+    | A.AilEunary A.Indirection pointer ->
+        if character then gnu_opaque_byte_store_origin pointer else E.return Nothing
+    | _ -> gnu_opaque_struct_store_origin left
+  end) >>= fun slot ->
+  E.return (maybe [] (fun slot -> [(slot, E.GNU_inline_unknown_extent_fact)]) slot)
+
+(* A complete declared character array cannot overlap an ordinary pointer
+   object. Carry this positive source-storage category through address-only
+   normalization, never through a projection into arbitrary aggregate storage. *)
+val gnu_extent_byte_array_origin: E.gnu_extent_address -> bool
+let rec gnu_extent_byte_array_origin address = match address with
+  | E.GNU_extent_byte_array_object -> true
+  | E.GNU_extent_local base -> gnu_extent_byte_array_origin base
+  | E.GNU_extent_formal base -> gnu_extent_byte_array_origin base
+  | E.GNU_extent_offset base -> gnu_extent_byte_array_origin base
+  | E.GNU_extent_indexed base -> gnu_extent_byte_array_origin base
+  | _ -> false
+end
+
+val gnu_fact_byte_array_origin: E.gnu_inline_fact -> bool
+let rec gnu_fact_byte_array_origin fact = match fact with
+  | E.GNU_inline_extent_fact false _ address _ _ -> gnu_extent_byte_array_origin address
+  | E.GNU_inline_dynamic_bound_fact saved -> gnu_fact_byte_array_origin saved
+  | E.GNU_inline_counted_extent_fact _ exact -> gnu_fact_byte_array_origin exact
+  | E.GNU_inline_offset_extent_fact base _ _ _ _ -> gnu_fact_byte_array_origin base
+  | _ -> false
+end
+
+(* Recover the live pointer slot actually used by this byte store. A numeric
+   known bound alone cannot establish separation. Pointer casts/offsets retain
+   an existing allocation origin; integer conversions and missing facts do not. *)
+val gnu_known_byte_array_pointer:
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (E.gnu_memory_slot * E.gnu_inline_fact))
+let rec gnu_known_byte_array_pointer (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_known_byte_array_pointer in
+  if not (gnu_memory_expression_readonly expr) then E.return Nothing else match node with
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not (AilTypesAux.is_pointer ty) || AilTypesAux.is_pointer_to_function ty
+        then E.return Nothing else
+        gnu_memory_slot_of true operand >>= function
+          | Nothing -> E.return Nothing
+          | Just slot -> E.gnu_memory_fact slot >>= fun fact ->
+              E.return (match maybe Nothing gnu_memory_pointer_identity fact with
+                | Just identity -> if gnu_member_fact_closed identity &&
+                    gnu_inline_fact_alloc_size_dependencies identity = [] &&
+                    gnu_fact_byte_array_origin identity
+                  then Just (slot, identity) else Nothing
+                | Nothing -> Nothing end)
+        end
+    | A.AilEbinary left (A.Arithmetic A.Add) right ->
+        if AilTypesAux.is_pointer (ctype_of left) && AilTypesAux.is_integer (ctype_of right)
+        then self left else
+        if AilTypesAux.is_integer (ctype_of left) && AilTypesAux.is_pointer (ctype_of right)
+        then self right else E.return Nothing
+    | A.AilEbinary pointer (A.Arithmetic A.Sub) offset ->
+        if AilTypesAux.is_pointer (ctype_of pointer) && AilTypesAux.is_integer (ctype_of offset)
+        then self pointer else E.return Nothing
+    | A.AilEcast _ ty operand ->
+        if AilTypesAux.is_pointer ty && AilTypesAux.is_pointer (ctype_of operand)
+        then self operand else E.return Nothing
+    | A.AilEannot _ operand -> self operand
+    | _ -> E.return Nothing
+  end
+
+val gnu_known_byte_array_store_survivors:
+  A.expression GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact) * list (Symbol.sym * E.gnu_memory_slot))
+let gnu_known_byte_array_store_survivors (A.AnnotatedExpression _ _ _ node as left) right =
+  let (qs, ty) = qualified_ctype_of left in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_character ty) ||
+      not (gnu_memory_expression_readonly left && gnu_memory_expression_readonly right)
+  then E.return ([], []) else match node with
+    | A.AilEunary A.Indirection pointer ->
+        gnu_known_byte_array_pointer pointer >>= function
+          | Nothing -> E.return ([], [])
+          | Just fact ->
+              E.gnu_memory_snapshot >>= fun (_, _, aliases) ->
+              E.mapM (fun ((alias, (indirect, _, _)) as entry) ->
+                if indirect then E.return Nothing else
+                E.lookup_gnu_analysis_object_type alias >>= fun ty ->
+                E.return (match ty with
+                  | Just (alias_qs, alias_ty) ->
+                      if not alias_qs.Ctype.volatile && not (AilTypesAux.is_atomic alias_ty) &&
+                          AilTypesAux.is_pointer alias_ty &&
+                          gnu_inline_parameter_expression_safe alias left &&
+                          gnu_inline_parameter_expression_safe alias right
+                      then Just entry else Nothing
+                  | Nothing -> Nothing end)) aliases >>= fun optional ->
+              E.return ([fact], List.foldr (fun item rest ->
+                maybe rest (fun alias -> alias :: rest) item) [] optional)
+        end
+    | _ -> E.return ([], [])
+  end
+
+(* An assignment expression yields the value just stored. When its target is
+   a fresh private capture, metadata may read that stored integer after the call
+   without re-evaluating the source expression. Ordinary dependency admission
+   still rejects escaped/nonlocal targets. Static query analysis stays separate. *)
+(* A complete named array is stable even when the row index has an effect.
+   This predicate grants no bound to a pointer merely from its pointed type. *)
+val gnu_complete_array_decay: A.expression GenTypes.genTypeCategory -> bool
+let gnu_complete_array_decay (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEarray_decay (A.AnnotatedExpression _ _ _ (A.AilEident _) as array_object) ->
+      let (qs, ty) = qualified_ctype_of array_object in
+      not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+        AilTypesAux.is_array ty && gnu_inline_fixed_object_type ty
+  | _ -> false
+end
+
+(* The original row-index update is captured inside its own operand by the
