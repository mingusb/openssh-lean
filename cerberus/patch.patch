--- /dev/null
+++ b/lean_frontend/CerbFastLocation.lean
@@ -0,0 +1,16 @@
+import CerbLocation
+
+/- The reduction loop asks this on every source step. A bare filename has the
+   Unix dirname ".", which cannot be any of CerbLocation.libraryDirs. Avoid
+   constructing and interning a memo key for that common negative case. Keep
+   the established predicate for every path containing a separator, including
+   absolute, relative and trailing-separator forms. -/
+namespace CerbFastLocation
+
+def isLibraryLocation (location : CerbLocation.Loc) : Bool :=
+  match CerbLocation.getFilename location with
+  | none => false
+  | some path =>
+    if path.contains '/' then CerbLocation.isLibraryPathSuffix path else false
+
+end CerbFastLocation
