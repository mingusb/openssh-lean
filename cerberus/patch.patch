+    }
+    if (!ok) {
+        /* Keep any mapped storage alive, but never use a partial restore. */
+        memo_loaded = NULL; memo_regions = NULL; memo_loaded_count = 0;
+    }
+    memo_trace("%s tables=%zu\n", ok ? "load" : "cold", memo_loaded_count);
+    flock(lock, LOCK_UN); close(lock);
+}
+static void memo_persist_register(memo_table *t) {
+    if (!memo_disk_initialized) memo_persist_init();
