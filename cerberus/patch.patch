+typedef unsigned int unsigned_ti __attribute__((__mode__(__TI__)));
+
+#define SAME(T,U) _Static_assert(__builtin_types_compatible_p(T,U), #T)
+SAME(i128, signed_spelling);
+SAME(i128, signed_ti);
+SAME(u128, unsigned_ti);
+SAME(__typeof__(+(i128)0), i128);
+SAME(__typeof__((i128)0 + (unsigned long long)0), i128);
+SAME(__typeof__((unsigned long long)0 + (i128)0), i128);
+SAME(__typeof__((long long)0 + (i128)0), i128);
+SAME(__typeof__((i128)0 + (long long)0), i128);
+SAME(__typeof__((i128)0 + (u128)0), u128);
+SAME(__typeof__((u128)0 + (i128)0), u128);
+SAME(__typeof__((i128)0 + sizeof(int)), i128);
+SAME(__typeof__(sizeof(int) + (i128)0), i128);
+_Static_assert(!__builtin_types_compatible_p(i128, long long), "distinct type");
+_Static_assert(sizeof(i128) == 16 && _Alignof(i128) == 16, "signed layout");
+_Static_assert(sizeof(u128) == 16 && _Alignof(u128) == 16, "unsigned layout");
+
+struct wide_member { char prefix; i128 wide; char suffix; };
+_Static_assert(sizeof(struct wide_member) == 48, "struct padding");
+_Static_assert(_Alignof(struct wide_member) == 16, "struct alignment");
+_Static_assert(__builtin_offsetof(struct wide_member, wide) == 16, "member offset");
+static u128 global_wide = ((u128)1 << 100) + 7;
+static i128 global_negative = -((i128)1 << 100);
+
+static u128 product(u128 a, u128 b) { return a * b; }
+
+int main(void) {
+    u128 high = (u128)1 << 127;
+    u128 all = (u128)-1;
+    i128 largest = (i128)(high - 1);
+    i128 smallest = -largest - 1;
+    u128 words[2] = {global_wide, all};
+    struct wide_member item = {1, global_negative, 2};
+    u128 bytes_word = 0;
+    unsigned char *bytes = (unsigned char *)&bytes_word;
+    int i;
+    if (global_wide >> 100 != 1 || (unsigned long long)global_wide != 7) return 1;
+    if (global_negative / 2 != -((i128)1 << 99)) return 2;
+    if (all + 1 != 0 || high + high != 0) return 3;
+    if ((u128)smallest != high || smallest + largest != -1) return 4;
+    if (product(((u128)1 << 63) + 1, ((u128)1 << 64) + 3)
+        != high + ((u128)5 << 63) + 3) return 5;
+    if (all / ((u128)1 << 64) != 18446744073709551615ULL) return 6;
+    if (all % ((u128)1 << 64) != 18446744073709551615ULL) return 7;
+    if ((i128)-19 / 5 != -3 || (i128)-19 % 5 != -4) return 8;
+    if ((global_negative >> 99) != -2) return 9;
+    if (((i128)-1 < (unsigned long long)0) != 1) return 10;
+    if (((i128)-1 < (u128)0) != 0) return 11;
+    if (words[1] != all || &words[1] - &words[0] != 1 || sizeof(words) != 32) return 12;
+    if (item.wide != global_negative || item.prefix != 1 || item.suffix != 2) return 13;
+    for (i = 0; i < 16; i++) bytes[i] = (unsigned char)(i + 1);
+    if ((unsigned long long)bytes_word != 0x0807060504030201ULL) return 14;
+    if ((unsigned long long)(bytes_word >> 64) != 0x100f0e0d0c0b0a09ULL) return 15;
+    bytes_word = high;
+    if (bytes[15] != 128 || bytes[0] != 0) return 16;
+    if ((~high ^ all) != high || (all & high) != high) return 17;
+    return 0;
+}
