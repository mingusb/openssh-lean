+            size = 112 if shape == "statvfs" else 144
+            offsets = list(range(0,89,8)) if shape == "statvfs" else [0,8,16,24,28,32,40,48,56,64,72,80,88,96,104,112]
+            policy = ".metadata "+str(size)+" "+kinds+" "+repr(offsets)
+        elif shape == "template":
+            lines += ["    let (cells, next) ← arrayCells enums tags .byte template wire_template.size after",
+                      "    outputCells := cells","    after := next"]
+            policy = ".templateDescriptor wire_template.size" if name == "mkstemp" else ".templatePointer template wire_template.size"
+        elif shape == "open":
+            policy = ".descriptor ((wire_flags &&& 524288) != 0)"
+        elif name == "dup":
+            policy = ".descriptor false"
+        elif name == "close":
+            policy = ".close fd"
+        elif name == "lseek":
+            policy = ".signed64"
+        elif name == "umask":
+            policy = ".unsigned32"
+        elif shape == "fcntl":
+            lines += ['    if command < 1 || command > 4 then fail "fcntl needs a separate typed command contract"']
+            policy = ".fcntl fd command argument"
+        else:
+            policy = ".zero"
+    lines += ["    let outputs ← prepareOutputs enums tags (outputCells ++ [errnoCell]) after",
+              "    return {",
+              "      native := .«"+name+"» "+ " ".join(args) + ", modeledErrno := modeledErrno,",
+              "      outputs := outputs, inputFootprints := reads, reservedGuests := reserved, policy := "+policy+" }"]
+    return "\n".join(lines)
+
+def generate(contracts, template):
+    apis = contracts["apis"]
+    if contracts["schema"] != 1 or contracts["family"] != "files":
+        raise ValueError("unsupported file guest contract")
+    got = {a["symbol"]:(a["shape"],[(p["name"],p["kind"]) for p in a["params"]]) for a in apis}
+    if got != EXPECTED or len(got) != len(apis):
+        raise ValueError("guest contracts differ from audited exact native schemas")
+    requests = variants(apis)
+    constructors = "\n".join(map(constructor, requests))
+    descriptor_counts = "\n".join(
+        ("  | .«"+request_name(a)+"» "+" ".join("_" for _ in request_params(a))) + " => " + str(2 if a["shape"] == "descriptor_pair" else
+                                1 if a["return_kind"] == "owned_descriptor" else 0)
+        for a in requests)
+    return template.replace("@@REQUESTS@@",constructors).replace(
+        "@@DESCRIPTOR_COUNTS@@",descriptor_counts).replace("@@PREPARE@@","\n".join(map(prepare_case,requests)))
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--contracts",type=Path,required=True)
+    p.add_argument("--output",type=Path,required=True)
+    p.add_argument("--check",action="store_true")
+    args = p.parse_args()
+    contracts = json.loads(args.contracts.read_text())
+    template = Path(__file__).with_name("templates") / "files_guest.lean.in"
+    source = generate(contracts,template.read_text())
+    registry = {
+        "schema":1,"generated_guest_codecs":[a["symbol"] for a in contracts["apis"]],
+        "remaining_guest_codecs":contracts["pending"],
+        "guest_execution_verified":False,"dispatcher_integrated":False,
+        "contract_sha256":hashlib.sha256(args.contracts.read_bytes()).hexdigest(),
+        "template_sha256":hashlib.sha256(template.read_bytes()).hexdigest(),
+        "obligations":contracts["obligations"]}
+    registry["copied_path_request_variants"] = [request_name(a) for a in variants(contracts["apis"]) if a.get("copied_paths")]
+    registry["filesystem_operations"] = [row["operation"] for row in contracts["filesystem_operations"]]
+    fs_template = Path(__file__).with_name("templates") / "files_fs.lean.in"
+    cases = []
+    for row in contracts["filesystem_operations"]:
+        case = "  | ." + row["operation"] + " " + " ".join(row["parameters"]) + " =>"
+        if row.get("copied_bytes"):
+            case += '\n    if count < 0 || count != (bytes.length : Int) then\n      .error (.boundary "FS_WRITE copied span/count mismatch")\n'
+            case += '\n    let input ← (CerbHostBoundary.bytesOfChars bytes).mapError Failure.boundary\n'
+            case += "    return .«" + row["request"] + "» " + row["arguments"]
+        elif row.get("metadata"):
+            case += "\n    let recordType ← match statPointee with\n" + \
+                    "      | some actual => pure actual\n" + \
+                    '      | none => .error (.boundary "FS_STAT requires its actual declared stat pointee CType")\n'
+            case += "    return .«" + row["request"] + "» " + row["arguments"]
+        else:
+            case += " return .«" + row["request"] + "» " + row["arguments"]
+        cases.append(case)
+    fs_source = fs_template.read_text().replace("@@FS_CASES@@", "\n".join(cases))
+    operands_template = Path(__file__).with_name("templates") / "files_operands.lean.in"
+    outputs = {"CerbHostFilesGuest.lean":source, "CerbHostFilesFS.lean":fs_source,
+               "CerbHostFilesOperands.lean":operands_template.read_text(),
+               "files-guest-registry.json":json.dumps(registry,indent=2)+"\n"}
+    if args.check:
+        for name,data in outputs.items():
+            if (args.output/name).read_text() != data:
+                raise SystemExit("stale generated file: "+name)
+    else:
+        args.output.mkdir(parents=True,exist_ok=True)
+        for name,data in outputs.items():
+            (args.output/name).write_text(data)
+    print(json.dumps({"guest_codecs":len(contracts["apis"]),"pending":len(contracts["pending"]),"checked":args.check}))
+if __name__ == "__main__":
+    main()
