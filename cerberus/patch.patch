index 00000000..1e38f825
--- /dev/null
+++ b/tests/openssh-gnu-modes/may-alias-tags.c
@@ -0,0 +1,28 @@
+struct Original { int value; };
+struct __attribute__((__may_alias__)) Alias { int value; };
+union __attribute__((may_alias)) AliasUnion { int value; unsigned int bits; };
+
+_Static_assert(sizeof(struct Alias) == sizeof(struct Original), "same storage size");
+_Static_assert(_Alignof(struct Alias) == _Alignof(struct Original), "same alignment");
+_Static_assert(!__builtin_types_compatible_p(struct Alias, struct Original), "distinct types");
+
+int change(struct Original *original, struct Alias *alias) {
+    original->value = 4;
+    alias->value = 9;
+    return original->value;
+}
+
+int change_union(struct Original *original, union AliasUnion *alias) {
+    original->value = 3;
+    alias->value = 11;
+    return original->value;
+}
+
+int main(void) {
+    struct Original value = { 0 };
+    if (change(&value, (struct Alias *)&value) != 9 || value.value != 9) return 1;
+    if (change_union(&value, (union AliasUnion *)&value) != 11 || value.value != 11) return 2;
+    struct Alias copy = *(struct Alias *)&value;
+    if (copy.value != 11) return 3;
+    return 0;
+}
