+    assert(bind(INT_MAX,(const struct sockaddr*)(uintptr_t)1,16)==-1 && errno==EBADF);
+    failed=cerb_net_bind_raw(86,INT_MAX,NULL,0);
+    good(failed);assert(failed.status.value==-1 && failed.native_errno_after==EBADF);
+    cerb_host_network_dispose(&failed);
+    assert(connect(INT_MAX,(const struct sockaddr*)(uintptr_t)1,16)==-1 && errno==EBADF);
+    failed=cerb_net_connect_raw(87,INT_MAX,NULL,0);
+    good(failed);assert(failed.status.value==-1 && failed.native_errno_after==EBADF);
+    cerb_host_network_dispose(&failed);
+    assert(listen(INT_MAX,-1)==-1 && errno==EBADF);
+    failed=cerb_net_listen_raw(88,INT_MAX,-1);
+    good(failed);assert(failed.status.value==-1 && failed.native_errno_after==EBADF);
+    cerb_host_network_dispose(&failed);
