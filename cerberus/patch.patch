+  let cheri_const_intrinsic =
+    if Global.is_CHERI () then
+      List.map (fun (sym, (qs, ty, sym')) ->
+      (* TODO: the partial pattern match in the lets is tasteless (even though the memop()
+          never evaluates to an unspecified value) *)
+      let ptr_ty = Ctype.mk_ctype_pointer qs ty in
+      ( Caux.mk_specified_pat (Caux.mk_sym_pat sym' (C.BTy_object C.OTy_pointer))
+      , cheri_readonly_perms ptr_ty (Caux.mk_sym_pe sym) )
+      ) const_aliases
+    else
+      [] in
+  let pat_core_kills : list (C.expr unit) =
+    List.map (fun (loc, _, sym, _, ty) ->
+      Caux.pkill (Loc.with_cursor_from loc loc) (C.Static ty) (Caux.mk_sym_pe sym)
+    ) compound_lits in
+  (* NOTE: doing the kills here is now redundant if there is are returns before all exit point.
+      but it may be nasty to do the check.
+      For non-void function however we know (?) that their must be these returns ?? so we could drop the kills here *)
+  (* the kill actions for the local variables *)
+  let core_kills : list (C.expr unit) =
+    List.map (fun (sym, ident_loc, (_, _, ty)) ->
+      Caux.pkill (Loc.with_cursor_from loc ident_loc) (C.Static ty) (Caux.mk_sym_pe sym)
+    ) decls_with_loc in
+  E.return (
+    (* NOTE: we sequence (left-to-right) the creates and kills of the block-scoped objects *)
+    Caux.mk_sseqs (lit_pats_core_creates ++ pats_core_creates ++ cheri_const_intrinsic) begin
+      mk_core (core_kills ++ pat_core_kills)
+    end
+  )
+
+
+(* This helper follows the same transparent nodes as
+   AilSyntax.statement_expression_result. Ordinary statement fallbacks still
+   use self, so source blocks/loops/switches do not become value expressions. *)
+and translate_statement_result translate_expr self f statement =
+  let loc = statement.A.loc in
+  let bTy = match A.statement_expression_result statement with
+    | Nothing -> C.BTy_unit
+    | Just expression -> maybe C.BTy_unit C.BTy_loaded
+        (Caux.core_object_type_of_ctype (ctype_of expression))
+  end in
+  let add_source = Caux.add_loc loc -| Caux.add_stmt -| Caux.add_attrs statement.A.attrs in
+  (match statement.A.node with
+    | A.AilSexpr expression ->
+        gnu_memory_prepare_expression expression >>
+        translate_expr expression >>= fun body -> E.return (add_source body)
+    | A.AilSvla_scope _ captures checked scope_body ->
+        (match scope_body.A.node with
+          | A.AilSblock bindings statements ->
+              wrapped_translate_vla_scope translate_expr loc captures checked [] []
+                (translate_block (Just translate_expr) self scope_body.A.loc f bindings statements)
+                >>= fun body -> E.return (add_source body)
+          | _ -> self statement
+        end)
+    | A.AilSlabel label child annotation ->
+        E.clear_gnu_flow_facts >> E.clear_gnu_memory_facts >>
+        E.restore_gnu_scalar_label_entry label >>
+        translate_statement_result translate_expr self f child >>= fun (_, body) ->
+        E.get_visible_objects >>= fun visible ->
+        E.mapM (fun symbol ->
+          E.resolve_object_type symbol >>= fun (_, ty) ->
+          E.return (symbol, ((C.BTy_object C.OTy_pointer, Just (ty, C.By_pointer)), Caux.mk_sym_pe symbol)))
+          visible >>= fun arguments ->
+        let annotations = match annotation with
+          | Just value -> [Annot.Alabel value]
+          | Nothing -> [Annot.Alabel Annot.LAactual_label]
+        end in
+        E.return (add_source (Caux.mk_save_e_ annotations (label, bTy) arguments body))
+    | A.AilSmarker marker child ->
+        E.clear_gnu_memory_facts >>
+        E.retain_gnu_flow_facts (fun symbol -> gnu_inline_parameter_unchanged symbol statement) >>
+        translate_statement_result translate_expr self f child >>= fun (_, body) ->
+        E.record_object_types_marker () >>= fun object_marker ->
+        E.return (add_source (Caux.add_annots
+          [Annot.Amarker_object_types object_marker; Annot.Amarker marker]
+          (Caux.mk_sseq_e (Caux.mk_empty_pat C.BTy_unit) (Caux.mk_pure_e Caux.mk_unit_pe) body)))
+    | _ -> self statement
+  end) >>= fun body -> E.return (bTy, body)
+
+(* A closed condition can make an arm unreachable through its ordinary entry,
+   but a label inside it can still be reached by goto or switch dispatch.
+   Nested GNU statement expressions are conservatively retained: they may
+   contain labels even when their surrounding expression looks ordinary. *)
+val gnu_dead_arm_closed: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_dead_arm_closed stmt =
+  let self = gnu_dead_arm_closed in
+  let expr = gnu_dead_arm_expression_closed in
+  match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif condition yes no -> expr condition && self yes && self no
+    | A.AilSwhile condition body _ -> expr condition && self body
+    | A.AilSdo body condition _ -> self body && expr condition
+    | A.AilSreturn operand -> expr operand
+    | A.AilSreturnVoid -> true
+    | A.AilSdeclaration declarations -> List.all (fun (_, value) -> maybe true expr value) declarations
+    | A.AilSmarker _ body -> self body
+    (* Incoming labels, switch cases/defaults, parallel control and all other
+       nonlocal transfers retain normal translation conservatively. *)
+    | _ -> false
+  end
+
+(* Restrict return dominance to structured arms without nonlocal edges.
+   A break/goto before a final return must not make that arm disappear from a
+   join. Loop/label cases retain their existing conservative analysis boundary. *)
+val gnu_statement_has_unstructured_control: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_statement_has_unstructured_control stmt =
+  let self = gnu_statement_has_unstructured_control in match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> true
+    | A.AilSblock _ statements -> List.any self statements
+    | A.AilSif _ left right -> self left || self right
+    | A.AilSmarker _ body -> self body
+    | A.AilSwhile _ _ _ -> true
+    | A.AilSdo _ _ _ -> true
+    | A.AilSswitch _ _ -> true
+    | A.AilScase _ _ -> true
+    | A.AilScase_rangeGNU _ _ _ -> true
+    | A.AilSdefault _ -> true
+    | A.AilSlabel _ _ _ -> true
+    | A.AilSgoto _ -> true
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSpar _ -> true
+    | _ -> false
+  end
+
+(* A source label can recover a scalar entry snapshot only when this is its
+   sole goto in the whole function and the jump skips a closed, label-free
+   sequence. This is an entry-edge fact, not a fact from the skipped guards. *)
+val gnu_statement_goto_targets: A.statement GenTypes.genTypeCategory -> list Symbol.sym
+let rec gnu_statement_goto_targets stmt =
+  let self = gnu_statement_goto_targets in match stmt.A.node with
+    | A.AilSvla_scope _ _ _ body -> self body
+    | A.AilSgoto label -> [label]
+    | A.AilSblock _ statements -> List.concat (List.map self statements)
+    | A.AilSif _ left right -> self left ++ self right
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSswitch _ body -> self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSpar statements -> List.concat (List.map self statements)
+    | A.AilSmarker _ body -> self body
+    | _ -> []
+  end
+
+(* Reject hidden control transfers in expression bodies before certifying
+   label uniqueness. The ordinary statement walk alone is insufficient for
+   GNU statement expressions, even when another subject gate rejects them. *)
+val gnu_labels_expressions_closed: A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_labels_expressions_closed stmt =
+  let self = gnu_labels_expressions_closed in
+  let expr = gnu_dead_arm_expression_closed in match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> false
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> expr operand
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSif test yes no -> expr test && self yes && self no
+    | A.AilSwhile test body _ -> expr test && self body
+    | A.AilSdo body test _ -> self body && expr test
+    | A.AilSbreak -> true
+    | A.AilScontinue -> true
+    | A.AilSreturnVoid -> true
+    | A.AilSreturn operand -> expr operand
+    | A.AilSswitch operand body -> expr operand && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSgoto _ -> true
+    | A.AilSdeclaration declarations -> List.all (fun (_, value) -> maybe true expr value) declarations
+    | A.AilSpar statements -> List.all self statements
+    | A.AilSreg_store _ operand -> expr operand
+    | A.AilSmarker _ body -> self body
+  end
+
+val gnu_unique_goto_targets: A.statement GenTypes.genTypeCategory -> list Symbol.sym
+let gnu_unique_goto_targets stmt =
+  if not (gnu_labels_expressions_closed stmt) then [] else
+  let targets = gnu_statement_goto_targets stmt in
+  List.filter (fun target -> List.length (List.filter (fun other -> target = other) targets) = 1) targets
+
+(* A forward join needs a complete census of incoming gotos. The ordinary
+   statement walker cannot see GNU statement-expression children, so descend
+   through expressions as well; an unrecognised node declines the certificate. *)
+val gnu_forward_collect_targets:
+  list (maybe (list Symbol.sym)) -> maybe (list Symbol.sym)
+let gnu_forward_collect_targets rows =
+  List.foldl (fun acc row -> match (acc, row) with
+    | (Just prior, Just targets) -> Just (prior ++ targets)
+    | _ -> Nothing end) (Just []) rows
+
+val gnu_forward_expression_goto_targets:
+  A.expression GenTypes.genTypeCategory -> maybe (list Symbol.sym)
+val gnu_forward_statement_goto_targets:
+  A.statement GenTypes.genTypeCategory -> maybe (list Symbol.sym)
+let rec gnu_forward_expression_goto_targets
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_dead_arm_expression_closed expr then Just [] else
+  match node with
+    | A.AilEgcc_statement bindings statements ->
+        if not (List.all (fun (_, (_, _, _, ty)) ->
+            gnu_inline_fixed_object_type ty) bindings)
+        then Nothing else
+        gnu_forward_collect_targets
+          (List.map gnu_forward_statement_goto_targets statements)
+    | _ -> match gnu_record_children expr with
+        | Just children -> gnu_forward_collect_targets
+            (List.map gnu_forward_expression_goto_targets children)
+        | Nothing -> Nothing end
+  end
+and gnu_forward_statement_goto_targets stmt =
+  match stmt.A.node with
+    | A.AilSgoto label -> Just [label]
+    | A.AilSvla_scope _ _ _ _ -> Nothing
+    | A.AilSreg_store _ value -> gnu_forward_expression_goto_targets value
+    | _ -> match gnu_record_statement_children stmt with
+        | Just (expressions, statements) ->
+            gnu_forward_collect_targets
+              (List.map gnu_forward_expression_goto_targets expressions ++
+                List.map gnu_forward_statement_goto_targets statements)
+        | Nothing -> Nothing end
+  end
+
+(* Only top-level source labels enter this acyclic join. Every syntactic goto,
+   including one inside a statement expression, must precede its target.
+   Translation separately verifies that the complete number was captured. *)
+val gnu_forward_memory_label_targets:
+  A.statement GenTypes.genTypeCategory -> list (Symbol.sym * nat)
+let gnu_forward_memory_label_targets stmt =
+  match (stmt.A.node, gnu_forward_statement_goto_targets stmt) with
+    | (A.AilSblock _ statements, Just all_targets) ->
+        let count target targets = List.length
+          (List.filter (fun other -> other = target) targets) in
+        snd (List.foldl (fun (prior, entries) child ->
+          let entries = match child.A.node with
+            | A.AilSlabel label _ Nothing ->
+                let expected = count label all_targets in
+                if count label prior = expected then (label, expected) :: entries else entries
+            | _ -> entries end in
+          let child_targets = maybe [] (fun targets -> targets)
+            (gnu_forward_statement_goto_targets child) in
+          (prior ++ child_targets, entries)) ([], []) statements)
+    | _ -> []
+  end
+
+(* Reachability pruning accepts only straight-line and conditional control.
+   A GNU statement expression is admitted when its nested statements satisfy
+   the same rule. Unhandled expression control declines the certificate. *)
+val gnu_forward_memory_reachability_region:
+  A.statement GenTypes.genTypeCategory -> bool
+val gnu_forward_expression_reachability_region:
+  A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_forward_memory_reachability_region stmt =
+  let self = gnu_forward_memory_reachability_region in
+  let expr = gnu_forward_expression_reachability_region in
+  match stmt.A.node with
+    | A.AilSskip -> true
+    | A.AilSexpr value -> expr value
+    | A.AilSdeclaration declarations ->
+        List.all (fun (_, value) -> maybe true expr value) declarations
+    | A.AilSreturn value -> expr value
+    | A.AilSreturnVoid -> true
+    | A.AilSgoto _ -> true
+    | A.AilSif test left right -> expr test && self left && self right
+    | A.AilSblock _ statements -> List.all self statements
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+and gnu_forward_expression_reachability_region
+    (A.AnnotatedExpression _ _ _ node as expression) =
+  if gnu_dead_arm_expression_closed expression then true else
+  match node with
+    | A.AilEgcc_statement bindings statements ->
+        List.all (fun (_, (_, _, _, ty)) ->
+          gnu_inline_fixed_object_type ty) bindings &&
+        List.all gnu_forward_memory_reachability_region statements
+    | A.AilEcast _ _ value -> gnu_forward_expression_reachability_region value
+    | A.AilEannot _ value -> gnu_forward_expression_reachability_region value
+    | A.AilErvalue value -> gnu_forward_expression_reachability_region value
+    | _ -> false
+  end
+
+val gnu_forward_memory_reachability_closed: A.statement GenTypes.genTypeCategory -> bool
+let gnu_forward_memory_reachability_closed stmt =
+  let targets = gnu_forward_statement_goto_targets stmt in
+  let labels = gnu_forward_memory_label_targets stmt in
+  isJust targets &&
+  List.all (fun target -> isJust (List.lookup target labels))
+    (maybe [] (fun found -> found) targets) &&
+  match stmt.A.node with
+    | A.AilSblock _ statements -> List.all (fun child -> match child.A.node with
+        | A.AilSlabel label body Nothing ->
+            isJust (List.lookup label labels) && gnu_forward_memory_reachability_region body
+        | _ -> gnu_forward_memory_reachability_region child
+      end) statements
+    | _ -> false
+  end
+
+val gnu_closed_forward_target: Symbol.sym -> list (A.statement GenTypes.genTypeCategory) -> bool
+let rec gnu_closed_forward_target target statements = match statements with
+    | [] -> false
+    | statement :: rest -> match statement.A.node with
+        | A.AilSlabel label _ Nothing -> target = label
+        | _ -> gnu_labels_expressions_closed statement &&
+            not (gnu_statement_has_unstructured_control statement) &&
+            gnu_closed_forward_target target rest
+      end
+  end
+
+(* Only a complete matched loop wrapper owns its generated labels. These
+   labels cannot introduce an entry from outside that loop. User labels and
+   labels without a matching enclosing owner retain the conservative boundary. *)
+val gnu_statement_has_entry_label_in:
+  list nat -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_statement_has_entry_label_in owners stmt =
+  let self = gnu_statement_has_entry_label_in owners in match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> true
+    | A.AilSlabel _ body (Just (Annot.LAloop_continue loop_id)) ->
+        not (List.elem loop_id owners) || self body
+    | A.AilSlabel _ body (Just (Annot.LAloop_break loop_id)) ->
+        not (List.elem loop_id owners) || self body
+    | A.AilSlabel _ _ _ -> true
+    | A.AilScase _ _ -> true
+    | A.AilScase_rangeGNU _ _ _ -> true
+    | A.AilSdefault _ -> true
+    | A.AilSblock [] [loop; exit_label] ->
+        let owner = match (loop.A.node, exit_label.A.node) with
+          | (A.AilSwhile _ _ loop_id,
+             A.AilSlabel _ tail (Just (Annot.LAloop_break break_id))) ->
+              if loop_id = break_id && (match tail.A.node with A.AilSskip -> true | _ -> false end)
+              then Just loop_id else Nothing
+          | (A.AilSdo _ _ loop_id,
+             A.AilSlabel _ tail (Just (Annot.LAloop_break break_id))) ->
+              if loop_id = break_id && (match tail.A.node with A.AilSskip -> true | _ -> false end)
+              then Just loop_id else Nothing
+          | _ -> Nothing end in
+        (match owner with
+          | Just loop_id -> gnu_statement_has_entry_label_in (loop_id :: owners) loop
+          | Nothing -> self loop || self exit_label end)
+    | A.AilSblock _ statements -> List.any self statements
+    | A.AilSif _ left right -> self left || self right
+    | A.AilSwhile _ body _ -> self body
+    | A.AilSdo body _ _ -> self body
+    | A.AilSswitch _ body -> self body
+    | A.AilSpar statements -> List.any self statements
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+val gnu_statement_has_entry_label: A.statement GenTypes.genTypeCategory -> bool
+let gnu_statement_has_entry_label stmt = gnu_statement_has_entry_label_in [] stmt
+
+(* A direct jump or declared nonreturning call does not reach the ordinary
+   if-join. A block with an entry label is excluded: its goto could resume
+   inside the block. Hidden expression control is excluded separately. *)
+val gnu_statement_has_no_fallthrough: A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_statement_has_no_fallthrough stmt =
+  let self = gnu_statement_has_no_fallthrough in
+  if not (gnu_labels_expressions_closed stmt) then E.return false else match stmt.A.node with
+    | A.AilSvla_scope _ _ _ _ -> E.return false
+    | A.AilSexpr operand -> gnu_expression_calls_noreturn operand
+    | A.AilSreturn _ -> E.return true
+    | A.AilSreturnVoid -> E.return true
+    | A.AilSgoto _ -> E.return true
+    | A.AilSbreak -> E.return true
+    | A.AilScontinue -> E.return true
+    | A.AilSif _ left right -> self left >>= fun first -> self right >>= fun second ->
+        E.return (first && second)
+    | A.AilSblock _ statements ->
+        if List.any gnu_statement_has_entry_label statements then E.return false else
+        E.mapM self statements >>= fun closed -> E.return (List.any (fun value -> value) closed)
+    | A.AilSmarker _ body -> self body
+    | _ -> E.return false
+  end
+
+(* Each admitted head has only its switch-dispatch predecessor. The body is
+   flat and every previous group terminates, so an earlier case cannot change
+   the snapshot seen here. Keep the ordinary effect/invalidation logic inside
+   the group; this is an entry state, never a whole-switch invariant. *)
+val gnu_switch_case_prefix:
+  A.statement GenTypes.genTypeCategory ->
+  (list (A.statement GenTypes.genTypeCategory) * A.statement GenTypes.genTypeCategory)
+let rec gnu_switch_case_prefix stmt =
+  let strip body =
+    let (heads, payload) = gnu_switch_case_prefix body in (stmt :: heads, payload) in
+  match stmt.A.node with
+    | A.AilScase _ body -> strip body
+    | A.AilScase_rangeGNU _ _ body -> strip body
+    | A.AilSdefault body -> strip body
+    | _ -> ([], stmt)
+  end
+
+val gnu_switch_dispatch_heads:
+  list (A.statement GenTypes.genTypeCategory) -> bool -> bool ->
+  E.elabM (maybe (list (A.statement GenTypes.genTypeCategory)))
+let rec gnu_switch_dispatch_heads statements started terminated = match statements with
+  | [] -> E.return (if not started || terminated then Just [] else Nothing)
+  | stmt :: rest ->
+      let (heads, payload) = gnu_switch_case_prefix stmt in
+      if (heads = [] && not started) ||
+          (heads <> [] && started && not terminated) ||
+          gnu_statement_has_entry_label payload ||
+          not (gnu_labels_expressions_closed payload) ||
+          (match payload.A.node with A.AilSpar _ -> true | _ -> false end)
+      then E.return Nothing else
+      gnu_statement_has_no_fallthrough payload >>= fun stops ->
+      let terminated = stops || (heads = [] && terminated) in
+      gnu_switch_dispatch_heads rest true terminated >>= function
+        | Nothing -> E.return Nothing
+        | Just following -> E.return (Just (heads ++ following))
+      end
+end
+
+val gnu_switch_independent_heads:
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (list (A.statement GenTypes.genTypeCategory))
+let gnu_switch_independent_heads body =
+  (* erase_loop_control creates this initial jump around the case block. *)
+  let original = match body.A.node with
+    | A.AilSblock [] [entry; source_body] ->
+        (match entry.A.node with A.AilSgoto _ -> source_body | _ -> body end)
+    | _ -> body end in
+  match original.A.node with
+    | A.AilSblock [] statements ->
+        gnu_switch_dispatch_heads statements false false >>= fun heads ->
+        E.return (maybe [] (fun found -> found) heads)
+    | _ -> E.return []
+  end
+
+(* Only a flat switch with no other entry labels receives selected metadata.
+   A head can be reached directly, or by the preceding group's ordinary exit.
+   Stacked heads fall through without effects. A terminating payload removes
+   only its ordinary predecessor; dispatch remains possible at every head. *)
+val gnu_switch_selected_heads:
+  list (A.statement GenTypes.genTypeCategory) -> bool -> bool ->
+  E.elabM (maybe (list (A.statement GenTypes.genTypeCategory * bool)))
+let rec gnu_switch_selected_heads statements started terminated = match statements with
+  | [] -> E.return (Just [])
+  | stmt :: rest ->
+      let (heads, payload) = gnu_switch_case_prefix stmt in
+      if (heads = [] && not started) ||
+          gnu_statement_has_entry_label payload ||
+          not (gnu_labels_expressions_closed payload) ||
+          (match payload.A.node with A.AilSpar _ -> true | _ -> false end)
+      then E.return Nothing else
+      gnu_statement_has_no_fallthrough payload >>= fun stops ->
+      let incoming = started && not terminated in
+      let entries = List.mapi (fun index head -> (head, index > 0 || incoming)) heads in
+      let terminated = stops || (heads = [] && terminated) in
+      gnu_switch_selected_heads rest true terminated >>= fun following ->
+      E.return (maybe Nothing (fun following -> Just (entries ++ following)) following)
+end
+
+val gnu_switch_selected_body:
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (A.statement GenTypes.genTypeCategory * bool)))
+let gnu_switch_selected_body body =
+  let original = match body.A.node with
+    | A.AilSblock [] [entry; source_body] ->
+        (match entry.A.node with A.AilSgoto _ -> source_body | _ -> body end)
+    | _ -> body end in
+  match original.A.node with
+    | A.AilSblock [] statements -> gnu_switch_selected_heads statements false false
+    | _ -> E.return Nothing
+  end
+
+(* Reuse the same promoted integer and comparisons as runtime dispatch. This
+   expression never evaluates the original selector or reads C storage. *)
+val gnu_switch_selector_test: C.pexpr -> case_selector -> C.pexpr
+let gnu_switch_selector_test selector selected = match selected with
+  | CaseSelectConstant n ->
+      Caux.mk_op_pe C.OpEq selector (Caux.mk_value_pe (C.Vobject (C.OVinteger (Mem.integer_ival n))))
+  | CaseSelectRange first last ->
+      Caux.mk_op_pe C.OpAnd
+        (Caux.mk_op_pe C.OpLe (Caux.mk_value_pe (C.Vobject (C.OVinteger (Mem.integer_ival first)))) selector)
+        (Caux.mk_op_pe C.OpLe selector (Caux.mk_value_pe (C.Vobject (C.OVinteger (Mem.integer_ival last)))))
+end
+
+val gnu_switch_head_test:
+  C.pexpr -> list (case_selector * Symbol.sym) ->
+  A.statement GenTypes.genTypeCategory -> C.pexpr
+let gnu_switch_head_test selector cases head = match head.A.node with
+  | A.AilScase n _ -> gnu_switch_selector_test selector (CaseSelectConstant n)
+  | A.AilScase_rangeGNU first last _ ->
+      gnu_switch_selector_test selector (CaseSelectRange first last)
+  | A.AilSdefault _ -> List.foldl (fun test (selected, _) ->
+      Caux.mk_op_pe C.OpAnd test (Caux.mk_not_pe (gnu_switch_selector_test selector selected)))
+        (Caux.mk_boolean_pe true) cases
+  | _ -> Caux.mk_boolean_pe false
+end
+
+(* Both predecessors must supply a positive fact. Missing analysis never turns
+   into unknown extent. Aliases/opaque roots survive only if shared exactly.
+   Selected bounds are local to this switch's explicitly bound selector. *)
+val gnu_switch_selected_memory:
+  C.pexpr ->
+  (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot)) ->
+  (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot)) ->
+  (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot))
+let gnu_switch_selected_memory selector (entry_facts, entry_roots, entry_aliases)
+    (prior_facts, prior_roots, prior_aliases) =
+  let facts = List.foldr (fun (slot, _) remaining ->
+    match (E.gnu_memory_snapshot_fact entry_facts [] entry_roots slot,
+           E.gnu_memory_snapshot_fact prior_facts [] prior_roots slot) with
+      | (Just first, Just second) ->
+          (match E.gnu_join_selected_inline_facts (Just selector) first second with
+            | Just fact -> (slot, fact) :: List.filter (fun (other, _) -> other <> slot) remaining
+            | Nothing -> remaining end)
+      | _ -> remaining
+    end) [] (entry_facts ++ prior_facts) in
+  (facts, List.filter (fun sym -> List.elem sym prior_roots) entry_roots,
+    List.filter (fun binding -> List.elem binding prior_aliases) entry_aliases)
+
+(* A returning case cannot affect the switch continuation. Before that
+   direct return, admit only simple sequencing with no alternative transfer. *)
+val gnu_switch_returning_prefix:
+  A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_switch_returning_prefix stmt =
+  match stmt.A.node with
+    | A.AilSskip -> true
+    | A.AilSexpr operand -> gnu_dead_arm_expression_closed operand
+    | A.AilSdeclaration declarations ->
+        List.all (fun (_, value) -> maybe true gnu_dead_arm_expression_closed value) declarations
+    | A.AilSblock [] statements -> List.all gnu_switch_returning_prefix statements
+    | _ -> false
+  end
+
+val gnu_switch_group_unchanged_exit:
+  Symbol.sym -> list (A.statement GenTypes.genTypeCategory) -> E.elabM bool
+let gnu_switch_group_unchanged_exit target statements =
+  match List.reverse statements with
+    | last :: reversed ->
+        let prefix = List.reverse reversed in
+        (match last.A.node with
+          | A.AilSgoto destination ->
+              if destination <> target then E.return false else
+              E.foldlM (fun checked stmt -> if checked then
+                gnu_readonly_transitive_body [] [] stmt else E.return false) true prefix
+          | A.AilSreturn operand ->
+              E.return (gnu_dead_arm_expression_closed operand &&
+                List.all gnu_switch_returning_prefix prefix)
+          | A.AilSreturnVoid -> E.return (List.all gnu_switch_returning_prefix prefix)
+          | _ -> E.return false end)
+    | [] -> E.return false
+  end
+
+val gnu_switch_groups_unchanged_exit:
+  Symbol.sym -> list (A.statement GenTypes.genTypeCategory) ->
+  list (A.statement GenTypes.genTypeCategory) -> E.elabM bool
+let rec gnu_switch_groups_unchanged_exit target group statements = match statements with
+  | [] -> gnu_switch_group_unchanged_exit target group
+  | stmt :: rest ->
+      let (heads, payload) = gnu_switch_case_prefix stmt in
+      if heads = [] then gnu_switch_groups_unchanged_exit target (group ++ [payload]) rest
+      else (if group = [] then E.return true else
+        gnu_switch_group_unchanged_exit target group) >>= fun checked ->
+        if not checked then E.return false else
+        gnu_switch_groups_unchanged_exit target [payload] rest
+end
+
+val gnu_switch_readonly_exit_memory:
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (E.gnu_memory_slot * E.gnu_inline_fact) *
+    list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot)))
+let gnu_switch_readonly_exit_memory stmt =
+  match stmt.A.node with
+    | A.AilSswitch test body ->
+        gnu_memory_certified_readonly test >>= fun readonly ->
+        if not readonly then E.return Nothing else
+        gnu_switch_independent_heads body >>= fun heads ->
+        if heads = [] then E.return Nothing else
+        (match body.A.node with
+          | A.AilSblock [] [entry; source_body] ->
+              (match (entry.A.node, source_body.A.node) with
+                | (A.AilSgoto target, A.AilSblock [] statements) ->
+                    gnu_switch_groups_unchanged_exit target [] statements >>= fun checked ->
+                    if checked then E.gnu_memory_snapshot >>= fun snapshot ->
+                      E.return (Just snapshot) else E.return Nothing
+                | _ -> E.return Nothing end)
+          | _ -> E.return Nothing end)
+    | _ -> E.return Nothing
+  end
+
+(* Nothing means unsupported; Just Nothing means an empty continuation;
+   Just (Just expression) means an unconditional return of that expression. *)
+val gnu_total_return_statement:
+  Core.core_tag_definitions -> A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (maybe (A.expression GenTypes.genTypeCategory)))
+val gnu_total_return_sequence:
+  Core.core_tag_definitions -> list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (maybe (maybe (A.expression GenTypes.genTypeCategory)))
+let rec gnu_total_return_statement tagDefs stmt =
+  if stmt.A.attrs <> Annot.no_attributes then E.return Nothing else match stmt.A.node with
+    | A.AilSskip -> E.return (Just Nothing)
+    | A.AilSreturn value ->
+        E.return (if gnu_dead_arm_expression_closed value then Just (Just value) else Nothing)
+    | A.AilSblock [] statements -> gnu_total_return_sequence tagDefs statements
+    | A.AilSif test yes no ->
+        gnu_total_query_guard tagDefs test >>= fun total ->
+        if not (total && gnu_dead_arm_closed yes && gnu_dead_arm_closed no)
+        then E.return Nothing else
+        gnu_resolved_closed_condition tagDefs test >>= function
+          | Just value -> gnu_total_return_statement tagDefs (if value = 0 then no else yes)
+          | Nothing -> E.return Nothing
+        end
+    | _ -> E.return Nothing
+  end
+and gnu_total_return_sequence tagDefs statements = match statements with
+  | [] -> E.return (Just Nothing)
+  | statement :: rest -> gnu_total_return_statement tagDefs statement >>= function
+      | Nothing -> E.return Nothing
+      | Just Nothing -> gnu_total_return_sequence tagDefs rest
+      | Just (Just value) -> E.return
+          (if List.all gnu_dead_arm_closed rest then Just (Just value) else Nothing)
+    end
+end
+
+val gnu_same_query_return:
+  Core.core_tag_definitions -> A.statement GenTypes.genTypeCategory ->
+  list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (maybe (A.expression GenTypes.genTypeCategory))
+let gnu_same_query_return tagDefs stmt rest =
+  if stmt.A.attrs <> Annot.no_attributes then E.return Nothing else match stmt.A.node with
+    | A.AilSif (A.AnnotatedExpression _ _ _ (A.AilEcall
+        (A.AnnotatedExpression _ _ _ (A.AilEbuiltin A.AilBGNU_constant_p)) [_]) as test) yes no ->
+        gnu_total_query_guard tagDefs test >>= fun total ->
+        if not (total && List.all gnu_dead_arm_closed (yes :: no :: rest))
+        then E.return Nothing else
+        gnu_total_return_sequence tagDefs (yes :: rest) >>= fun first ->
+        gnu_total_return_sequence tagDefs (no :: rest) >>= fun second ->
+        E.return (match (first, second) with
+          | (Just (Just a), Just (Just b)) -> if gnu_same_return_expression a b then Just a else Nothing
+          | _ -> Nothing end)
+    | _ -> E.return Nothing
+  end
+
+val gnu_translate_statement_sequence: forall 'a.
+  Core.core_tag_definitions ->
+  (A.statement GenTypes.genTypeCategory -> E.elabM 'a) ->
+  list (A.statement GenTypes.genTypeCategory) -> E.elabM (list 'a)
+let rec gnu_translate_statement_sequence tagDefs translate statements = match statements with
+    | [] -> E.return []
+    | statement :: rest ->
+        gnu_same_query_return tagDefs statement rest >>= function
+          | Just value ->
+              let () = Debug.print_debug_located 2 [Debug.DB_elaboration] statement.A.loc
+                (fun () -> "GNU compiler-query continuations share one exact return") in
+              translate (<| statement with A.node= A.AilSreturn value |>) >>= fun core ->
+              E.return [core]
+          | Nothing ->
+        (* A newly certified returning arm also excludes the ordinary suffix.
+           Keep the original statement and its effects. Any incoming label in
+           the suffix prevents this omission, even if ordinary entry is dead. *)
+        (if not (List.all gnu_dead_arm_closed rest) then E.return false else
+          match statement.A.node with
+            | A.AilSif test yes no ->
+                if not (gnu_dead_arm_expression_closed test) then E.return false else
+                gnu_resolved_closed_condition tagDefs test >>= function
+                  | Just value -> gnu_statement_has_no_fallthrough (if value = 0 then no else yes)
+                  | Nothing -> E.return false
+                end
+            | _ -> E.return false
+          end) >>= fun terminates ->
+        (match statement.A.node with
+          | A.AilSgoto target ->
+              E.gnu_scalar_label_is_unique target >>= fun unique ->
+              if unique && gnu_closed_forward_target target rest then
+                E.gnu_scalar_label_snapshot >>= fun facts -> E.return (Just (target, facts))
+              else E.return Nothing
+          | _ -> E.return Nothing
+        end) >>= fun entry ->
+        translate statement >>= fun core ->
+        if terminates then E.return [core] else
+        (let tail = gnu_translate_statement_sequence tagDefs translate rest in
+          match entry with
+            | Just (target, facts) -> E.with_gnu_scalar_label_entry target facts tail
+            | Nothing -> tail
+          end) >>= fun cores ->
+        E.return (core :: cores)
+        end
+  end
+
+(* This finite post-loop analysis accepts closed stores and same-type lexical
+   pointer copies from the current iteration facts. Copies can require several
+   rounds; no result is accepted before the header transfer reaches equality.
+   Conditional paths join, and unsupported/overlapping values are dropped.
+   Normal, break and continue exits remain separate until the loop header
+   fixed point has been computed. No runtime statement is replaced.
+   Arbitrary goto, declarations, nested loops, pointer arithmetic recurrences and
+   dynamic bounds remain outside this analysis. *)
+val gnu_loop_object_address: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_loop_object_address (A.AnnotatedExpression _ _ _ node) = match node with
+    | A.AilEident _ -> true
+    | A.AilEstr _ -> true
+    | A.AilEmemberof object_expr _ -> gnu_loop_object_address object_expr
+    | A.AilEannot _ object_expr -> gnu_loop_object_address object_expr
+    | _ -> false
+end
+
+val gnu_loop_address_constant: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_loop_address_constant (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_loop_address_constant in
+  let object_address = gnu_loop_object_address in
+  match node with
+    | A.AilEarray_decay object_expr -> object_address object_expr && gnu_inline_fixed_object_type (ctype_of object_expr)
+    | A.AilEfunction_decay object_expr -> object_address object_expr
+    | A.AilEunary A.Address object_expr -> object_address object_expr && gnu_inline_fixed_object_type (ctype_of object_expr)
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> AilTypesAux.is_pointer (ctype_of expr) && self operand
+    | A.AilEbinary left (A.Arithmetic A.Add) right ->
+        (self left && gnu_inline_closed_integer_origin right) ||
+        (gnu_inline_closed_integer_origin left && self right)
+    | A.AilEbinary left (A.Arithmetic A.Sub) right -> self left && gnu_inline_closed_integer_origin right
+    | _ -> false
+  end
+
+(* Child contents may change independently even when an address is fixed.
+   Only the closed pointer extent/target itself participates in this summary. *)
+val gnu_loop_without_contents: E.gnu_inline_fact -> E.gnu_inline_fact
+let rec gnu_loop_without_contents fact = match fact with
+  | E.GNU_inline_extent_fact a b c extent _ -> E.GNU_inline_extent_fact a b c extent []
+  | E.GNU_inline_extent_join_fact alternatives ->
+      E.GNU_inline_extent_join_fact (List.map gnu_loop_without_contents alternatives)
+  | other -> other
+end
+
+val gnu_loop_direct_lvalue: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_loop_direct_lvalue (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && match node with
+    | A.AilEident _ -> true
+    | A.AilEmemberof object_expr _ -> gnu_loop_direct_lvalue object_expr
+    | A.AilEannot _ object_expr -> gnu_loop_direct_lvalue object_expr
+    | _ -> false
+  end
+
+(* An unchanged lexical pointer can carry a closed entry snapshot or a
+   canonical local-address alias across the loop. Reading a member through it
+   is different: pointee contents may change, so that case stays outside this
+   invariant-value test. Whole-loop mutation and address-escape checks apply. *)
+val gnu_loop_invariant_pointer:
+  A.statement GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_loop_invariant_pointer loop (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty || not (AilTypesAux.is_pointer ty) then E.return false else
+  match node with
+    | A.AilEident sym -> E.gnu_branch_subject_allowed sym >>= fun allowed ->
+        E.return (allowed && gnu_inline_parameter_unchanged sym loop)
+    | A.AilErvalue operand -> gnu_loop_invariant_pointer loop operand
+    | A.AilEannot _ operand -> gnu_loop_invariant_pointer loop operand
+    | _ -> E.return false
+  end
+
+val gnu_loop_stable_lvalue:
+  A.statement GenTypes.genTypeCategory -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_loop_stable_lvalue loop (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then E.return false else
+    if gnu_loop_direct_lvalue expr then E.return true else match node with
+      | A.AilEunary A.Indirection pointer -> gnu_loop_invariant_pointer loop pointer
+      | A.AilEmemberofptr pointer _ -> gnu_loop_invariant_pointer loop pointer
+      | A.AilEmemberof operand _ -> gnu_loop_stable_lvalue loop operand
+      | A.AilEannot _ operand -> gnu_loop_stable_lvalue loop operand
+      | _ -> E.return false end
+
+let gnu_loop_join first second = List.foldr (fun (slot, fact) acc ->
+  match List.lookup slot second with
+    | Just other -> (match E.gnu_join_inline_facts fact other with
+        | Just joined -> (slot, joined) :: acc | Nothing -> acc end)
+    | Nothing -> acc
+  end) [] first
+
+(* A mutable pointer copy reads the current abstract iteration, never the
+   ordinary translator's entry snapshot. Closed direct lexical slots of the
+   identical pointed-to type qualify. A volatile pointer-object load has its
+   own positive compiler-opaque origin; it never borrows the entry snapshot.
+   Atomic loads and changing indirect destinations remain unsupported. *)
+val gnu_loop_copy_fact:
+  list (E.gnu_memory_slot * E.gnu_inline_fact) -> Ctype.ctype ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)
+let rec gnu_loop_copy_fact facts target_ty (A.AnnotatedExpression _ _ _ node as expr) =
+  if not (AilTypesAux.is_pointer target_ty) ||
+      not (gnu_function_target_type_equal target_ty (ctype_of expr)) then E.return Nothing else
+  match node with
+    | A.AilErvalue operand ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+            not (gnu_loop_direct_lvalue operand) then E.return Nothing else
+        gnu_memory_slot_of true operand >>= fun slot -> E.return (match slot with
+          | Just (false, sym, path) -> (match List.lookup (false, sym, path) facts with
+              | Just fact -> if gnu_member_fact_closed fact then Just (gnu_loop_without_contents fact) else Nothing
+              | Nothing -> Nothing end)
+          | _ -> Nothing end)
+    | A.AilEannot _ operand -> gnu_loop_copy_fact facts target_ty operand
+    | A.AilEcast _ _ operand -> gnu_loop_copy_fact facts target_ty operand
+    | _ -> E.return Nothing
+  end
+
+
+(* Closed loop transfers carry the current alias environment separately from
+   object-size facts. An extent does not identify an address. A pointer store
+   updates its exact lexical alias at that point; joins retain only agreement.
+   Thus a loop-local reassignment can establish a destination even when the
+   header has different zero-iteration and backedge aliases. *)
+type gnu_closed_loop_state =
+  list (E.gnu_memory_slot * E.gnu_inline_fact) * list (Symbol.sym * E.gnu_memory_slot)
+
+type gnu_closed_loop_paths =
+  maybe gnu_closed_loop_state * maybe gnu_closed_loop_state * maybe gnu_closed_loop_state
+
+let gnu_closed_loop_join (first, first_aliases) (second, second_aliases) =
+  (gnu_loop_join first second,
+    List.filter (fun (sym, slot) -> List.lookup sym second_aliases = Just slot) first_aliases)
+
+let gnu_closed_loop_merge_path first second = match (first, second) with
+  | (Nothing, other) -> other
+  | (other, Nothing) -> other
+  | (Just left, Just right) -> Just (gnu_closed_loop_join left right)
+end
+
+let gnu_closed_loop_merge_paths (normal1, break1, continue1) (normal2, break2, continue2) =
+  (gnu_closed_loop_merge_path normal1 normal2, gnu_closed_loop_merge_path break1 break2,
+    gnu_closed_loop_merge_path continue1 continue2)
+
+val gnu_loop_store:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> A.statement GenTypes.genTypeCategory -> gnu_closed_loop_state ->
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory) ->
+  E.elabM (maybe gnu_closed_loop_state)
+let gnu_loop_store translate_expr tagDefs loop (facts, aliases) left right =
+  (* The caller installs this transfer's aliases. A resolved direct lexical
+     slot is the current destination; an unresolved indirect root still fails. *)
+  gnu_memory_slot_of true left >>= function
+    | Just (false, sym, path) ->
+        gnu_memory_root_type sym left >>= function
+        | Nothing -> E.return Nothing
+        | Just root_ty ->
+          let survivors = List.filter (fun ((indirect, other, other_path), _) ->
+            not indirect && (sym <> other || gnu_memory_paths_disjoint tagDefs root_ty path other_path)) facts in
+          let unchanged_aliases = if path = [] then
+            List.filter (fun (other, _) -> sym <> other) aliases else aliases in
+          (match right with
+          | Nothing -> if AilTypesAux.is_integer (ctype_of left)
+              then E.return (Just (survivors, unchanged_aliases)) else E.return Nothing
+          | Just value ->
+              let volatile_load = gnu_volatile_pointer_value_load (ctype_of left) value in
+              if not (gnu_memory_expression_readonly value || volatile_load) then E.return Nothing else
+              (if path <> [] || not (AilTypesAux.is_pointer (ctype_of left)) || volatile_load
+               then E.return unchanged_aliases else
+                 gnu_memory_slot_of false value >>= fun target ->
+                 E.return (match target with
+                   | Just ((false, _, _) as slot) -> (sym, slot) :: unchanged_aliases
+                   | _ -> unchanged_aliases end)) >>= fun updated_aliases ->
+              (if volatile_load then E.return (Just E.GNU_inline_unknown_extent_fact)
+               else gnu_loop_copy_fact facts (ctype_of left) value) >>= fun copied ->
+              (match copied with
+                | Just fact -> E.return (Just fact)
+                | Nothing ->
+                    gnu_loop_invariant_pointer loop value >>= fun invariant ->
+                    if not (gnu_loop_address_constant value || gnu_inline_closed_integer_origin value || invariant)
+                    then E.return Nothing else capture_gnu_inline_fact translate_expr tagDefs (ctype_of left) value
+              end) >>= function
+                | Just fact -> if gnu_member_fact_closed fact then
+                    E.return (Just (gnu_memory_expand_identical_unions tagDefs root_ty
+                      [((false, sym, path), gnu_loop_without_contents fact)] ++ survivors, updated_aliases))
+                    else E.return Nothing
+                | Nothing -> E.return Nothing
+              end
+          end)
+        end
+    | _ -> E.return Nothing
+  end
+
+(* A call summary records definite straight-line stores and conditional
+   may-writes. A missing RHS means invalidation only, never an unknown value.
+   It never substitutes the runtime call. All arguments must be readonly;
+   their values and destination aliases are captured before abstract stores
+   so a later store cannot reread an actual changed by an earlier store. *)
+val gnu_call_store_statements:
+  A.statement GenTypes.genTypeCategory ->
+  maybe (bool * list (A.expression GenTypes.genTypeCategory * maybe (A.expression GenTypes.genTypeCategory)))
+let rec gnu_call_store_statements stmt = match stmt.A.node with
+  | A.AilSvla_scope _ _ _ _ -> Nothing
+  | A.AilSskip -> Just (true, [])
+  | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEassign left right)) -> Just (true, [(left,Just right)])
+  | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixIncr left)) ->
+      Just (true, [(left,Nothing)])
+  | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEunary A.PostfixDecr left)) ->
+      Just (true, [(left,Nothing)])
+  | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEcompoundAssign left _ right)) ->
+      if gnu_memory_expression_readonly right then Just (true, [(left,Nothing)]) else Nothing
+  | A.AilSexpr expr -> if gnu_memory_expression_readonly expr then Just (true, []) else Nothing
+  | A.AilSreturnVoid -> Just (false, [])
+  | A.AilSreturn expr -> if gnu_memory_expression_readonly expr then Just (false, []) else Nothing
+  | A.AilSblock [] statements -> List.foldl (fun acc child ->
+      match (acc, gnu_call_store_statements child) with
+        | (Just (falls, first), Just (next, second)) ->
+            if falls then Just (next, first ++ second) else Just (false, first)
+        | _ -> Nothing end) (Just (true, [])) statements
+  | A.AilSif condition yes no ->
+      if not (gnu_memory_expression_readonly condition) then Nothing else
+      (match (gnu_call_store_statements yes, gnu_call_store_statements no) with
+        | (Just (first_falls, first), Just (second_falls, second)) ->
+            (* A mixed early return would make the following stores conditional
+               too. Decline it rather than marking that suffix as definite. *)
+            let stores = first ++ second in
+            if first_falls <> second_falls || not (List.all (fun (left, right) ->
+                gnu_memory_expression_readonly left &&
+                  maybe true gnu_memory_expression_readonly right) stores)
+            then Nothing else Just (first_falls, List.map (fun (left, _) -> (left, Nothing)) stores)
+        | _ -> Nothing end)
+  | A.AilSmarker _ body -> gnu_call_store_statements body
+  | _ -> Nothing
+end
+
+val gnu_call_formal_value:
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_call_formal_value bindings (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym)) ->
+      (match List.lookup sym bindings with
+        | Just actual -> if gnu_function_target_type_equal (ctype_of expr) (ctype_of actual)
+            then Just actual else Nothing
+        | Nothing -> Nothing end)
+  | A.AilEannot _ operand -> gnu_call_formal_value bindings operand
+  | A.AilEcast _ _ operand ->
+      if gnu_function_target_type_equal (ctype_of expr) (ctype_of operand)
+      then gnu_call_formal_value bindings operand else Nothing
+  | _ -> Nothing
+end
+
+val gnu_call_store_lvalue:
+  bool -> list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_call_store_lvalue single_store bindings (A.AnnotatedExpression ty annots loc node as expr) =
+  let rebuild child make = maybe Nothing (fun value -> Just (A.AnnotatedExpression ty annots loc (make value))) child in
+  let pointer base = match gnu_call_formal_value bindings base with
+    | Just actual -> Just actual
+    | Nothing -> if not single_store || not (gnu_memory_expression_readonly base) then Nothing else
+        match base with
+          | A.AnnotatedExpression _ _ _ (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym))) ->
+              if isJust (List.lookup sym bindings) then Nothing else Just base
+          | _ -> Nothing end
+    end in
+  match node with
+    | A.AilEident sym -> if isJust (List.lookup sym bindings) then Nothing else Just expr
+    | A.AilEmemberof base ident -> rebuild (gnu_call_store_lvalue single_store bindings base) (fun base -> A.AilEmemberof base ident)
+    | A.AilEmemberofptr base ident -> rebuild (pointer base) (fun base -> A.AilEmemberofptr base ident)
+    | A.AilEunary A.Indirection base -> rebuild (pointer base) (fun base -> A.AilEunary A.Indirection base)
+    | A.AilEannot annotations operand -> rebuild (gnu_call_store_lvalue single_store bindings operand) (fun operand -> A.AilEannot annotations operand)
+    | _ -> Nothing
+  end
+
+(* Pointer actuals used only as values are copied before entering the callee.
+   They need not remain stable after a store. Destination bases must remain
+   stable because the abstract store list refers to their incoming addresses. *)
+val gnu_call_destination_parameter:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_call_destination_parameter parameter (A.AnnotatedExpression _ _ _ node) =
+  let pointer base = isJust (gnu_call_formal_value [(parameter, base)] base) in
+  match node with
+    | A.AilEmemberof base _ -> gnu_call_destination_parameter parameter base
+    | A.AilEmemberofptr base _ -> pointer base
+    | A.AilEunary A.Indirection base -> pointer base
+    | A.AilEannot _ base -> gnu_call_destination_parameter parameter base
+    | _ -> false
+  end
+
+(* A volatile scalar read remains a runtime effect, but performs no C store.
+   This narrower predicate is used only to preserve caller memory snapshots
+   across argument evaluation, never to remove or duplicate that evaluation. *)
+val gnu_call_argument_preserves_memory: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_call_argument_preserves_memory (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_call_argument_preserves_memory in
+  if gnu_memory_expression_readonly expr then true else match node with
+    | A.AilErvalue operand ->
+        AilTypesAux.is_arithmetic (ctype_of operand) &&
+          not (AilTypesAux.is_atomic (ctype_of operand)) &&
+          gnu_memory_expression_readonly operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | A.AilEcond test yes no -> self test && maybe true self yes && self no
+    | _ -> false
+  end
+
+(* A direct volatile integer read is a positive unknown selector in the
+   pinned compiler profile. Do not promote a missing constant analysis for an
+   arbitrary expression into evidence that both arms contribute a size. *)
+val gnu_call_volatile_selector: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_call_volatile_selector (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident _) as operand) ->
+        let (qs, ty) = qualified_ctype_of operand in
+        qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && AilTypesAux.is_integer ty
+    | A.AilEannot _ operand -> gnu_call_volatile_selector operand
+    | A.AilEcast _ ty operand ->
+        AilTypesAux.is_integer ty && AilTypesAux.is_integer (ctype_of operand) &&
+          gnu_call_volatile_selector operand
+    | _ -> false
+  end
+
+(* Retain the two store paths of one positively classified conditional.
+   Returning paths do not receive the suffix. A second unresolved selector is
+   deliberately outside this transfer: multiplying paths could invent an
+   infeasible combination when two tests use the same copied parameter.
+   Runtime conditions/calls remain unchanged. This transfers static sizes;
+   a dynamic size still requires the existing selected-value representation. *)
+val gnu_call_store_paths:
+  C.core_tag_definitions -> list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.statement GenTypes.genTypeCategory ->
+  maybe (list (bool * list (A.expression GenTypes.genTypeCategory * maybe (A.expression GenTypes.genTypeCategory))))
+let rec gnu_call_store_paths tagDefs bindings stmt =
+  let self = gnu_call_store_paths tagDefs bindings in
+  match stmt.A.node with
+    | A.AilSblock [] statements ->
+        List.foldl (fun acc child -> match acc with
+          | Nothing -> Nothing
+          | Just paths -> (match self child with
+              | Nothing -> if List.all (fun (falls, _) -> not falls) paths
+                  then Just paths else Nothing
+              | Just next ->
+                  if List.length paths > 1 && List.length next > 1 then Nothing else
+                  Just (List.concat (List.map (fun (falls, first) ->
+                    if falls then List.map (fun (later, second) ->
+                      (later, first ++ second)) next else [(false, first)]) paths))
+            end)
+          end) (Just [(true, [])]) statements
+    | A.AilSif condition yes no ->
+        if not (gnu_memory_expression_readonly condition) then Nothing else
+        (match gnu_record_value_substitute bindings condition with
+          | Nothing -> Nothing
+          | Just value -> (match gnu_constant_truth tagDefs value with
+              | Just true -> self yes
+              | Just false -> self no
               | Nothing ->
-                  let (_, _, _, ty) = fromJust "Translation.translate_expression, AilEstruct 3" (List.lookup ident ident_tys) in
-                  E.return
-                    ( (ident, Caux.mk_unspecified_pe ty) :: acc
-                    , (pat_acc, core_e_acc) )
-            end
-          ) ([], ([], [])) ident_e_opts >>= fun (core_xs_rev, (pat_acc, core_e_acc)) ->
-          E.return begin 
-            match (pat_acc, core_e_acc) with
-              | ([pat], [core_e]) ->
-                  Caux.mk_wseq_e pat core_e
-              | (_ :: _, _ :: _) ->
-                  (* STD (§6.7.9#23) the evaluations are unsequenced *)
-                  Caux.mk_wseq_e (Caux.mk_tuple_pat pat_acc) (Caux.add_std "§6.7.9#23" (Caux.mk_unseq_e core_e_acc))
-              | _ ->
-                  (* this is not possible (the Ail would be illformed) *)
-                  error "AilEstruct"
-            end
-            begin
-              Caux.mk_pure_e (Caux.mk_specified_pe (Caux.mk_struct_pe tag_sym (List.reverse core_xs_rev)))
+                  if not (gnu_call_volatile_selector value) then Nothing else
+                  (match (self yes, self no) with
+                    | (Just left, Just right) ->
+                        if List.length left + List.length right <= 2
+                        then Just (left ++ right) else Nothing
+                    | _ -> Nothing end)
+            end)
+        end)
+    | A.AilSmarker _ body -> self body
+    | _ -> maybe Nothing (fun path -> Just [path]) (gnu_call_store_statements stmt)
+  end
+
+val gnu_call_store_global_pointer:
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_call_store_global_pointer bindings (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEmemberof base _ -> gnu_call_store_global_pointer bindings base
+  | A.AilEmemberofptr base _ -> isNothing (gnu_call_formal_value bindings base)
+  | A.AilEunary A.Indirection base -> isNothing (gnu_call_formal_value bindings base)
+  | A.AilEannot _ operand -> gnu_call_store_global_pointer bindings operand
+  | _ -> false
+end
+
+(* Repeated stores may use a caller-captured global address only when every
+   destination reads the same global holder. The caller must separately prove
+   that the holder still points to one live lexical pointer cell. *)
+val gnu_call_repeated_global_lvalue:
+  A.expression GenTypes.genTypeCategory -> maybe Symbol.sym
+let rec gnu_call_repeated_global_lvalue (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEunary A.Indirection
+      (A.AnnotatedExpression _ _ _
+        (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident global)))) -> Just global
+  | A.AilEannot _ operand -> gnu_call_repeated_global_lvalue operand
+  | _ -> Nothing
+end
+
+val gnu_call_stable_pointer_actual: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_call_stable_pointer_actual (A.AnnotatedExpression _ _ _ node as expr) =
+  if gnu_loop_address_constant expr then E.return true else match node with
+    | A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym) as operand) ->
+        let (qs, ty) = qualified_ctype_of operand in
+        if qs.Ctype.volatile || AilTypesAux.is_atomic ty then E.return false
+        else E.gnu_branch_subject_allowed sym
+    | A.AilEannot _ operand -> gnu_call_stable_pointer_actual operand
+    | _ -> E.return false
+  end
+
+(* A void forwarding wrapper performs exactly this call, with no local
+   storage, prefix effects, branching or suffix. This is an analysis view;
+   runtime lowering retains the original call and once-only evaluations. *)
+val gnu_single_forwarding_call:
+  A.statement GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_single_forwarding_call stmt = match stmt.A.node with
+  | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEcall _ _) as expr) ->
+      if AilTypesAux.is_void (ctype_of expr) then Just expr else Nothing
+  | A.AilSblock [] [child] -> gnu_single_forwarding_call child
+  | A.AilSmarker _ child -> gnu_single_forwarding_call child
+  | _ -> Nothing
+end
+
+val gnu_forwarded_memory_call:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe (A.expression GenTypes.genTypeCategory))
+let gnu_forwarded_memory_call (A.AnnotatedExpression _ _ _ node as expr) = match node with
+  | A.AilEcall callee args ->
+      if not (AilTypesAux.is_void (ctype_of expr) &&
+          gnu_inline_direct_designator callee && gnu_memory_expression_readonly callee &&
+          List.all gnu_memory_expression_readonly args) then E.return Nothing else
+      gnu_inline_function_target callee >>= function
+        | Nothing -> E.return Nothing
+        | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+            E.gnu_memory_call_body target >>= function
+              | Nothing -> E.return Nothing
+              | Just (params, body) ->
+                  if List.length params <> List.length args ||
+                      not (List.all (fun param -> gnu_inline_parameter_unchanged param body &&
+                        gnu_alloc_size_subject_unescaped param body) params)
+                  then E.return Nothing else
+                  E.mapM (fun actual -> if AilTypesAux.is_pointer (ctype_of actual)
+                    then gnu_call_stable_pointer_actual actual else E.return true) args >>= fun stable ->
+                  if not (List.all (fun yes -> yes) stable) then E.return Nothing else
+                  let bindings = List.zip params args in
+                  let substitute operand = match gnu_call_formal_value bindings operand with
+                    | Just actual -> Just actual
+                    | Nothing -> if (gnu_loop_address_constant operand ||
+                          gnu_inline_closed_integer_origin operand) &&
+                        gnu_memory_expression_readonly operand &&
+                        List.all (fun param -> gnu_inline_parameter_expression_safe param operand) params
+                      then Just operand else Nothing
+                  end in
+                  E.return (match gnu_single_forwarding_call body with
+                    | Just (A.AnnotatedExpression ty annots loc (A.AilEcall inner operands)) ->
+                        let replaced = List.map substitute (inner :: operands) in
+                        if List.any isNothing replaced then Nothing else
+                        match List.map (fromJust "Translation.gnu_forwarded_memory_call") replaced with
+                          | target :: actuals -> Just (A.AnnotatedExpression ty annots loc
+                              (A.AilEcall target actuals))
+                          | [] -> Nothing
+                        end
+                    | _ -> Nothing
+                  end)
             end
+      end
+  | _ -> E.return Nothing
+end
+
+(* An acyclic forwarding chain cannot exceed the source body count. Cycles
+   still end at an unsupported call body; the bound grants no facts or
+   assumption of runtime termination. Stop at a non-forwarding body. *)
+val gnu_resolve_memory_forwarding:
+  A.expression GenTypes.genTypeCategory -> E.elabM (A.expression GenTypes.genTypeCategory)
+let gnu_resolve_memory_forwarding expr = fun st ->
+  let action = E.foldlM (fun (current, done) _ ->
+    if done then E.return (current, true) else
+    gnu_forwarded_memory_call current >>= fun forwarded ->
+    E.return (match forwarded with
+      | Just next -> (next, false)
+      | Nothing -> (current, true)
+    end)) (expr, false) (Map_extra.toList st.E.gnu_memory_call_bodies) in
+  let ((result, _), next) = action st in (result, next)
+
+(* Complete automatic outputs may expose their addresses to this call alone.
+   The transfer independently checks that the callee uses those addresses only
+   for stores. Type distinctions alone cannot establish this separation. *)
+val gnu_call_output_confined:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_call_output_confined sym call stmt =
+  if gnu_alloc_size_subject_unescaped sym stmt then true else
+  let self = gnu_call_output_confined sym call in
+  let pure = gnu_alloc_size_subject_expression sym in
+  match stmt.A.node with
+    | A.AilSexpr expr -> expr = call
+    | A.AilSblock _ children -> List.all self children
+    | A.AilSif condition yes no -> pure condition && self yes && self no
+    | A.AilSwhile condition body _ -> pure condition && self body
+    | A.AilSdo body condition _ -> self body && pure condition
+    | A.AilSswitch condition body -> pure condition && self body
+    | A.AilScase _ body -> self body
+    | A.AilScase_rangeGNU _ _ body -> self body
+    | A.AilSdefault body -> self body
+    | A.AilSlabel _ body _ -> self body
+    | A.AilSmarker _ body -> self body
+    | _ -> false
+  end
+
+val gnu_call_output_address:
+  A.expression GenTypes.genTypeCategory -> maybe (Symbol.sym * Ctype.ctype)
+let rec gnu_call_output_address (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEunary A.Address (A.AnnotatedExpression _ _ _ (A.AilEident sym) as object_expr) ->
+      let (qs, ty) = qualified_ctype_of object_expr in
+      if qs.Ctype.volatile || AilTypesAux.is_atomic ty ||
+          not (AilTypesAux.is_pointer ty || AilTypesAux.is_arithmetic ty)
+      then Nothing else Just (sym, ty)
+  | A.AilEannot _ operand -> gnu_call_output_address operand
+  | _ -> Nothing
+end
+
+(* A direct store of a visible local or parameter pointer cell address into
+   global pointer storage exposes that cell to a later call. Parameters have
+   live C objects here even when their ordinary calling-convention storage is
+   represented outside the local-object inventory. Keep only the address
+   relation, never its incoming value or bound; later stores revoke it. *)
+val gnu_global_pointer_address_assignment:
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (Symbol.sym * maybe E.gnu_memory_slot))
+let gnu_global_pointer_address_assignment (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEassign
+        (A.AnnotatedExpression _ _ _ (A.AilEident global)) right ->
+        E.gnu_addressable_global_pointers >>= fun globals ->
+        if not (List.elem global globals) then E.return Nothing else
+        E.gnu_visible_current_frame_objects >>= fun frame ->
+        E.gnu_current_parameter_subjects >>= fun parameters ->
+        let slot = match gnu_call_output_address right with
+          | Just (local, ty) ->
+              if (List.elem local frame || List.elem local parameters) &&
+                  AilTypesAux.is_pointer ty && gnu_size_effects right = Just false
+              then Just (false, local, []) else Nothing
+          | Nothing -> Nothing end in
+        E.return (Just (global, slot))
+    | _ -> E.return Nothing
+  end
+
+(* A direct helper's final opaque call can overwrite an address-exposed local
+   output after an earlier known store. The certificate requires one confined
+   direct output store, an unconditional ordinary opaque call with no argument
+   effects, and only a readonly return afterward. It does not evaluate or
+   replace any of the original C operations. *)
+val gnu_unmark_output_statement:
+  A.statement GenTypes.genTypeCategory -> A.statement GenTypes.genTypeCategory
+let rec gnu_unmark_output_statement stmt = match stmt.A.node with
+  | A.AilSmarker _ child -> gnu_unmark_output_statement child
+  | _ -> stmt end
+
+val gnu_output_then_opaque_tail:
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.statement GenTypes.genTypeCategory -> E.elabM bool
+let gnu_output_then_opaque_tail bindings stmt =
+  let stmt = gnu_unmark_output_statement stmt in
+  match stmt.A.node with
+    | A.AilSblock [] [store; opaque; ending] ->
+        let store = gnu_unmark_output_statement store in
+        let opaque = gnu_unmark_output_statement opaque in
+        let ending = gnu_unmark_output_statement ending in
+        match (store.A.node, opaque.A.node, ending.A.node) with
+          | (A.AilSexpr (A.AnnotatedExpression _ _ _
+                (A.AilEassign left right)),
+             A.AilSexpr (A.AnnotatedExpression _ _ _
+                (A.AilEcall callee args)),
+             A.AilSreturn value) ->
+              if args <> [] || not (gnu_memory_expression_readonly right &&
+                  gnu_memory_expression_readonly value)
+              then E.return false else
+              match gnu_call_store_lvalue true bindings left with
+                | Nothing -> E.return false
+                | Just actual_left ->
+                    gnu_memory_slot_of true actual_left >>= fun slot ->
+                    E.gnu_visible_current_frame_objects >>= fun frame ->
+                    (match slot with
+                      | Just (false, local, []) ->
+                          if not (List.elem local frame) then E.return false
+                          else gnu_ordinary_opaque_memory_call callee
+                      | _ -> E.return false end)
+              end
+          | _ -> E.return false
+        end
+    | _ -> E.return false
+  end
+
+(* A known address escape plus a guaranteed opaque tail definition is positive
+   evidence for the compiler's unknown extent. Without both certificates,
+   absence of a fact remains a refusal. *)
+val gnu_escaped_global_condition_call:
+  A.expression GenTypes.genTypeCategory ->
+  maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_escaped_global_condition_call (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEbinary left bop right ->
+        if not (bop = A.Eq || bop = A.Ne) then Nothing else
+        (match left with
+          | A.AnnotatedExpression _ _ _ (A.AilEcall _ _) ->
+              if gnu_inline_closed_integer_origin right &&
+                  gnu_memory_expression_readonly right
+              then Just left else Nothing
+          | _ -> Nothing end)
+    | A.AilEannot _ child -> gnu_escaped_global_condition_call child
+    | _ -> Nothing end
+
+val gnu_escaped_global_call_unknowns:
+  A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact))
+let gnu_escaped_global_call_unknowns condition =
+  match gnu_escaped_global_condition_call condition with
+    | Nothing -> E.return []
+    | Just (A.AnnotatedExpression _ _ _ (A.AilEcall callee args)) ->
+        if not (gnu_inline_direct_designator callee &&
+            List.all gnu_memory_expression_readonly args)
+        then E.return [] else
+        E.gnu_memory_snapshot >>= fun (_, _, aliases) ->
+        E.gnu_addressable_global_pointers >>= fun globals ->
+        E.gnu_visible_current_frame_objects >>= fun frame ->
+        let slots = List.foldr (fun (global, ((indirect, local, path) as slot)) rest ->
+          if List.elem global globals && not indirect && path = [] &&
+              List.elem local frame && not (List.elem slot rest)
+          then slot :: rest else rest) [] aliases in
+        if slots = [] then E.return [] else
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return []
+          | Just (declared, _) ->
+              E.gnu_inline_target declared >>= fun target ->
+              E.gnu_memory_call_body target >>= function
+                | Nothing -> E.return []
+                | Just (params, body) ->
+                    if List.length params <> List.length args then E.return [] else
+                    gnu_output_then_opaque_tail (List.zip params args) body >>= fun proved ->
+                    E.return (if proved then List.map (fun slot ->
+                      (slot, E.GNU_inline_unknown_extent_fact)) slots else [])
+              end
+        end
+    | _ -> E.return []
+  end
+
+
+(* A helper may fill fresh automatic output cells without writing the
+   incoming objects from which it computes their values. Certify the complete
+   source use of each output address before treating that cell as separate:
+   current-point privacy has already been revoked by ordinary argument escape
+   processing, and a bare unknown pointer extent does not prove separation.
+   The existing strict callee census checks every nested write/comparison;
+   these outputs acquire no contents-origin class or scalar value certificate. *)
+val gnu_confined_output_call_survivors:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym)
+let gnu_confined_output_call_survivors caller
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee &&
+          gnu_memory_expression_readonly callee &&
+          List.all gnu_memory_expression_readonly args)
+        then E.return ([], []) else
+        E.gnu_memory_call_body caller >>= function
+          | Nothing -> E.return ([], [])
+          | Just (_, body) ->
+              E.gnu_visible_current_frame_objects >>= fun frame_objects ->
+              let outputs = List.foldr (fun actual rest ->
+                match gnu_call_output_address actual with
+                  | Just (sym, _) ->
+                      if List.elem sym frame_objects && not (List.elem sym rest) &&
+                        gnu_call_output_confined sym expr body
+                      then sym :: rest else rest
+                  | Nothing -> rest end) [] args in
+              if outputs = [] then E.return ([], []) else
+              gnu_boundary_capture_origins >>= fun (values, origins) ->
+              if origins = [] then E.return ([], []) else
+              gnu_boundary_effects_expression [] true [] outputs [] false [] []
+                values origins Nothing expr >>= fun preserves ->
+              if not preserves then E.return ([], []) else
+              E.gnu_memory_snapshot >>= fun (facts, roots, _) ->
+              E.gnu_indexed_memory_symbols >>= fun indexed ->
+              E.mapM (fun root ->
+                if not (List.elem root origins) || List.elem root indexed
+                then E.return Nothing else
+                E.gnu_memory_opaque_subobject root [] >>= fun consistent ->
+                E.return (if consistent then Just root else Nothing)) roots >>= fun checked ->
+              let retained = List.foldr (fun root rest ->
+                maybe rest (fun sym -> sym :: rest) root) [] checked in
+              let () = if retained = [] then () else
+                Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr)
+                  (fun () -> "GNU confined output call retains incoming contents; outputs=" ^
+                    show outputs ^ "; roots=" ^ show retained) in
+              E.return (List.filter (fun ((indirect, root, _), fact) ->
+                indirect && List.elem root retained &&
+                  fact = E.GNU_inline_unknown_extent_fact) facts, retained)
+        end
+    | _ -> E.return ([], [])
+  end
+
+(* Every output-address formal is excluded from readable bindings, preventing
+   both output loads and address escapes through this substitution. *)
+val gnu_call_output_values:
+  C.core_tag_definitions -> list (Symbol.sym * A.expression GenTypes.genTypeCategory) ->
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe (list (A.expression GenTypes.genTypeCategory)))
+let gnu_call_output_values tagDefs bindings (A.AnnotatedExpression ty annots loc node as expr) =
+  let valid values = List.all (fun value -> gnu_memory_expression_readonly value &&
+    gnu_function_target_type_equal (ctype_of expr) (ctype_of value)) values in
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee) then E.return Nothing else
+        let actuals = List.foldr (fun arg rest ->
+          match (gnu_record_value_substitute bindings arg, rest) with
+            | (Just value, Just values) -> Just (value :: values)
+            | _ -> Nothing end) (Just []) args in
+        (match actuals with
+          | Nothing -> E.return Nothing
+          | Just actuals -> gnu_readonly_call_origins tagDefs
+              (A.AnnotatedExpression ty annots loc (A.AilEcall callee actuals)) >>= function
+                | Just (_, values) -> E.return (if valid values then Just values else Nothing)
+                | Nothing -> E.return Nothing end
+        end)
+    | _ -> E.return (match gnu_record_value_substitute bindings expr with
+        | Just value -> if valid [value] then Just [value] else Nothing
+        | Nothing -> Nothing end)
+  end
+
+val gnu_call_output_merge:
+  list (maybe (list (list (Symbol.sym * A.expression GenTypes.genTypeCategory)))) ->
+  maybe (list (list (Symbol.sym * A.expression GenTypes.genTypeCategory)))
+let gnu_call_output_merge results = List.foldr (fun result rest -> match (result, rest) with
+  | (Just paths, Just later) -> Just (paths ++ later)
+  | _ -> Nothing end) (Just []) results
+
+val gnu_call_output_paths:
+  C.core_tag_definitions -> list (Symbol.sym * (Symbol.sym * Ctype.ctype)) ->
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) -> bool ->
+  A.statement GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (list (Symbol.sym * A.expression GenTypes.genTypeCategory))))
+val gnu_call_output_sequence:
+  C.core_tag_definitions -> list (Symbol.sym * (Symbol.sym * Ctype.ctype)) ->
+  list (Symbol.sym * Ctype.ctype) ->
+  list (Symbol.sym * A.expression GenTypes.genTypeCategory) -> bool ->
+  list (A.statement GenTypes.genTypeCategory) ->
+  E.elabM (maybe (list (list (Symbol.sym * A.expression GenTypes.genTypeCategory))))
+let rec gnu_call_output_paths tagDefs outputs bindings in_switch body =
+  match gnu_record_body_parts body with
+    | Just (locals, statements) ->
+        if List.all (fun (sym, _) -> gnu_alloc_size_subject_unescaped sym body) locals
+        then gnu_call_output_sequence tagDefs outputs locals bindings in_switch statements
+        else E.return Nothing
+    | Nothing -> E.return Nothing
+  end
+and gnu_call_output_sequence tagDefs outputs locals bindings in_switch statements =
+  let sequence = gnu_call_output_sequence tagDefs outputs locals in
+  (* Continue each normal branch with the lexical suffix. An early return
+     terminates its own sequence before that suffix, so a later output store
+     cannot become definite on the returning path. Branch-local bindings keep
+     their distinct source symbols and never replace a caller object. *)
+  let branch continuation body = match gnu_record_body_parts body with
+    | Just (inner, statements) ->
+        if List.all (fun (sym, _) -> gnu_alloc_size_subject_unescaped sym body) inner
+        then gnu_call_output_sequence tagDefs outputs (locals ++ inner) bindings
+          in_switch (statements ++ continuation)
+        else E.return Nothing
+    | Nothing -> E.return Nothing
+    end in
+  let condition expr = match gnu_record_value_substitute bindings expr with
+    | Just value -> if gnu_memory_expression_readonly value &&
+        gnu_function_target_type_equal (ctype_of expr) (ctype_of value) then Just value else Nothing
+    | Nothing -> Nothing end in
+  match statements with
+    | [] -> E.return (Just [[]])
+    | first :: rest -> match first.A.node with
+        | A.AilSskip -> sequence bindings in_switch rest
+        | A.AilSdeclaration declarations ->
+            let add prior (sym, value) = match prior with
+              | Nothing -> E.return Nothing
+              | Just environments ->
+                  (match value with
+                    | Nothing -> E.return (Just environments)
+                    | Just value ->
+                        if not (maybe false (fun ty -> gnu_function_target_type_equal ty (ctype_of value))
+                          (List.lookup sym locals)) then E.return Nothing else
+                        E.mapM (fun known ->
+                          if isJust (List.lookup sym known) then E.return Nothing else
+                          gnu_call_output_values tagDefs known value >>= fun values ->
+                          E.return (maybe Nothing (fun values -> Just (List.map
+                            (fun actual -> (sym, actual) :: known) values)) values)) environments >>= fun results ->
+                        E.return (List.foldr (fun result remaining -> match (result, remaining) with
+                          | (Just values, Just later) -> Just (values ++ later)
+                          | _ -> Nothing end) (Just []) results)
+                  end)
+              end in
+            List.foldl (fun action declaration -> action >>= fun prior -> add prior declaration)
+              (E.return (Just [bindings])) declarations >>= fun next ->
+            (match next with
+              | Nothing -> E.return Nothing
+              | Just environments -> E.mapM (fun known -> sequence known in_switch rest)
+                  environments >>= fun results -> E.return (gnu_call_output_merge results)
+            end)
+        | A.AilSexpr (A.AnnotatedExpression _ _ _ (A.AilEassign left right)) ->
+            let destination = match left with
+              | A.AnnotatedExpression _ _ _ (A.AilEunary A.Indirection
+                  (A.AnnotatedExpression _ _ _ (A.AilErvalue
+                    (A.AnnotatedExpression _ _ _ (A.AilEident formal))))) ->
+                  List.lookup formal outputs
+              | _ -> Nothing end in
+            (match destination with
+              | Nothing -> E.return Nothing
+              | Just (destination, ty) ->
+                  if not (gnu_function_target_type_equal ty (ctype_of left) &&
+                    gnu_function_target_type_equal ty (ctype_of right))
+                  then E.return Nothing else
+                  (* All RHS facts are captured before abstract writes. Only
+                     private output storage can change along these paths. *)
+                  (match condition right with
+                    | Nothing -> E.return Nothing
+                    | Just value -> sequence bindings in_switch rest >>= fun paths ->
+                        E.return (maybe Nothing (fun paths -> Just (List.map
+                          (fun path -> (destination, value) :: path) paths)) paths)
+                  end)
+            end)
+        | A.AilSexpr expr ->
+            if not (gnu_return_summary_effect_closed expr) then E.return Nothing else
+            gnu_expression_calls_noreturn expr >>= fun stops ->
+            if stops then E.return (Just []) else E.return Nothing
+        | A.AilSreturnVoid -> E.return (Just [[]])
+        | A.AilSbreak -> E.return (if in_switch then Just [[]] else Nothing)
+        | A.AilSif test yes no ->
+            (match condition test with
+              | Nothing -> E.return Nothing
+              | Just test -> gnu_scalar_knowledge_of tagDefs test >>= fun known ->
+                  (match known with
+                    | Just (low, high, _) ->
+                        if low = 0 && high = 0 then branch rest no
+                        else if high < 0 || low > 0 then branch rest yes
+                        else branch rest yes >>= fun left -> branch rest no >>= fun right ->
+                          E.return (gnu_call_output_merge [left; right])
+                    | _ -> branch rest yes >>= fun left -> branch rest no >>= fun right ->
+                        E.return (gnu_call_output_merge [left; right]) end)
+            end)
+        | A.AilSswitch test body ->
+            if rest <> [] then E.return Nothing else
+            (match (condition test, body.A.node) with
+              | (Just test, A.AilSblock [] children) ->
+                  (match gnu_readonly_return_case_paths children with
+                    | Just (true, paths) ->
+                        gnu_scalar_knowledge_of tagDefs test >>= fun known ->
+                        let selected = match known with
+                          | Just (low, high, _) ->
+                              if low <> high then paths else
+                              let matching = List.filter (fun (key, _) -> maybe false
+                                (fun (first, last) -> first <= low && low <= last) key) paths in
+                              if matching = [] then List.filter (fun (key, _) -> isNothing key) paths
+                              else matching
+                          | _ -> paths end in
+                        E.mapM (fun (_, path) -> sequence bindings true path) selected >>= fun results ->
+                        E.return (gnu_call_output_merge results)
+                    | _ -> E.return Nothing end)
+              | _ -> E.return Nothing end)
+        | A.AilScase _ body -> sequence bindings in_switch (body :: rest)
+        | A.AilScase_rangeGNU _ _ body -> sequence bindings in_switch (body :: rest)
+        | A.AilSdefault body -> sequence bindings in_switch (body :: rest)
+        | _ -> E.return Nothing
+      end
+  end
+
+val gnu_private_output_memory_summary:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  C.core_tag_definitions -> maybe Symbol.sym -> A.expression GenTypes.genTypeCategory ->
+  E.elabM (maybe (list (E.gnu_memory_slot * E.gnu_inline_fact) * list Symbol.sym * list (Symbol.sym * E.gnu_memory_slot)))
+let gnu_private_output_memory_summary translate_expr tagDefs caller
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  match (caller, node) with
+    | (Just caller, A.AilEcall callee args) ->
+        if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+        then E.return Nothing else
+        E.gnu_memory_call_body caller >>= fun caller_body ->
+        gnu_inline_function_target callee >>= fun target ->
+        (match (caller_body, target) with
+          | (Just (_, caller_body), Just (declared, _)) ->
+              E.gnu_inline_target declared >>= fun target ->
+              E.gnu_memory_call_body target >>= fun body ->
+              (match (gnu_record_body_parts caller_body, body, ctype_of callee) with
+                | (Just (caller_locals, _), Just (params, body),
+                    Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _
+                      (Ctype.Function (_, Ctype.Ctype _ Ctype.Void) types false)))) ->
+                    if List.length params <> List.length args || List.length params <> List.length types ||
+                        not (List.all (fun param -> gnu_inline_parameter_unchanged param body &&
+                          gnu_alloc_size_subject_unescaped param body) params) ||
+                        not (List.all (fun ((qs, ty, _), actual) ->
+                          not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+                          gnu_function_target_type_equal ty (ctype_of actual)) (List.zip types args))
+                    then E.return Nothing else
+                    let parameters = List.zip params args in
+                    let outputs = List.foldr (fun (param, actual) rest ->
+                      maybe rest (fun output -> (param, output) :: rest)
+                        (gnu_call_output_address actual)) [] parameters in
+                    if outputs = [] || not (List.all (fun (_, (sym, ty)) ->
+                        maybe false (gnu_function_target_type_equal ty) (List.lookup sym caller_locals) &&
+                        gnu_call_output_confined sym expr caller_body) outputs)
+                    then E.return Nothing else
+                    let readable = List.filter (fun (param, _) -> isNothing (List.lookup param outputs)) parameters in
+                    if not (List.all (fun (_, actual) -> List.all (fun (_, (sym, _)) ->
+                        gnu_alloc_size_subject_expression sym actual) outputs) readable)
+                    then E.return Nothing else
+                    gnu_call_output_paths tagDefs outputs readable false body >>= function
+                      | Just (first :: rest) ->
+                          let prepare stores = E.mapM (fun (sym, value) ->
+                            capture_gnu_inline_fact translate_expr tagDefs (ctype_of value) value >>= fun captured ->
+                            let safe = match captured with
+                              | Just fact -> if gnu_member_fact_closed fact &&
+                                  gnu_inline_fact_alloc_size_dependencies fact = [] then Just fact else Nothing
+                              | Nothing -> Nothing end in
+                            E.return (sym, safe)) stores in
+                          E.mapM prepare (first :: rest) >>= fun prepared ->
+                          let path_facts stores = List.foldl (fun facts (sym, captured) ->
+                            let prior = List.filter (fun ((_, root, _), _) -> root <> sym) facts in
+                            maybe prior (fun fact -> ((false, sym, []), fact) ::
+                              List.map (fun (member, value) -> ((true, sym, member), value))
+                                (E.gnu_extent_member_snapshots fact) ++ prior) captured) [] stores in
+                          let joined = match List.map path_facts prepared with
+                            | first :: rest -> List.foldl gnu_loop_join first rest
+                            | [] -> [] end in
+                          let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf expr) (fun () ->
+                            "GNU private output helper " ^ show target ^ "; paths=" ^
+                            show (List.length prepared) ^ "; facts=" ^ show (List.length joined)) in
+                          E.return (Just (joined, [], []))
+                      | _ -> E.return Nothing
+                    end
+                | _ -> E.return Nothing end)
+          | _ -> E.return Nothing end)
+    | _ -> E.return Nothing
+  end
+
+
+(* Conditional output summaries execute metadata in source order. A state
+   contains only caller output cells and unescaped callee locals. No expression
+   is evaluated at runtime by this analysis, and missing facts stay missing. *)
+type gnu_output_flow_state = list (E.gnu_memory_slot * E.gnu_inline_fact)
+type gnu_output_flow_paths =
+  list gnu_output_flow_state *
+  list (maybe (A.expression GenTypes.genTypeCategory) * gnu_output_flow_state)
+
+val gnu_output_flow_cell:
+  list Symbol.sym -> list (Symbol.sym * Ctype.ctype) ->
+  A.expression GenTypes.genTypeCategory -> maybe E.gnu_memory_slot
+let rec gnu_output_flow_cell outputs locals (A.AnnotatedExpression _ _ _ node as expr) =
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then Nothing else
+  match node with
+    | A.AilEident sym -> if isJust (List.lookup sym locals)
+        then Just (false, sym, []) else Nothing
+    | A.AilEunary A.Indirection
+        (A.AnnotatedExpression _ _ _ (A.AilErvalue
+          (A.AnnotatedExpression _ _ _ (A.AilEident formal)))) ->
+        if List.elem formal outputs then Just (true, formal, []) else Nothing
+    | A.AilEannot _ operand -> gnu_output_flow_cell outputs locals operand
+    | _ -> Nothing
+  end
+
+(* A pointer-to-output formal may be dereferenced, but its address value cannot
+   be copied, returned, cast, or forwarded. Taking the address of its pointee
+   would also export the caller cell and therefore declines the summary. *)
+val gnu_output_formal_confined_expression:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_output_formal_confined_expression formal (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_output_formal_confined_expression formal in
+  let output operand = gnu_output_flow_cell [formal] [] operand = Just (true, formal, []) in
+  match node with
+    | A.AilEident sym -> sym <> formal
+    | A.AilErvalue operand -> if output operand then true else self operand
+    | A.AilEassign left right ->
+        if output left then self right else self left && self right
+    | A.AilEunary A.Address operand ->
+        not (output operand) && self operand
+    | _ -> maybe false (List.all self) (gnu_record_children expr)
+  end
+
+val gnu_output_formal_confined_statement:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_output_formal_confined_statement formal stmt =
+  match gnu_record_statement_children stmt with
+    | Nothing -> false
+    | Just (expressions, children) ->
+        List.all (gnu_output_formal_confined_expression formal) expressions &&
+        List.all (gnu_output_formal_confined_statement formal) children
+  end
+
+(* A record address can be borrowed by a visible optimized helper without
+   escaping. Each use of its formal must consume a typed scalar/pointer member
+   as a load or store. The holder address itself cannot be copied, returned,
+   reinterpreted, forwarded, or exported through a member address/array decay.
+   This certifies address confinement only; ordinary call/store invalidation
+   remains responsible for every member value. *)
+(* Record eligibility is separate from the pointer-return local census.
+   Require an actual automatic binding and a complete fixed record definition;
+   flexible arrays, volatile/atomic subobjects and by-value cycles decline. *)
+val gnu_borrowed_record_fixed_type:
+  C.core_tag_definitions -> list Symbol.sym -> Ctype.qualifiers -> Ctype.ctype -> bool
+let rec gnu_borrowed_record_fixed_type tagDefs seen qs ty =
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then false else
+  match ty with
+    | Ctype.Ctype _ (Ctype.Struct tag) ->
+        if List.elem tag seen then false else (match Map.lookup tag tagDefs with
+          | Just (_, Ctype.StructDef _ members Nothing) -> List.all
+              (fun (_, (_, _, member_qs, member_ty)) ->
+                gnu_borrowed_record_fixed_type tagDefs (tag :: seen) member_qs member_ty) members
+          | _ -> false end)
+    | Ctype.Ctype _ (Ctype.Union tag) ->
+        if List.elem tag seen then false else (match Map.lookup tag tagDefs with
+          | Just (_, Ctype.UnionDef _ members) -> List.all
+              (fun (_, (_, _, member_qs, member_ty)) ->
+                gnu_borrowed_record_fixed_type tagDefs (tag :: seen) member_qs member_ty) members
+          | _ -> false end)
+    | Ctype.Ctype _ (Ctype.Array element (Just count)) ->
+        count >= 0 && gnu_borrowed_record_fixed_type tagDefs seen Ctype.no_qualifiers element
+    | _ -> gnu_inline_fixed_object_type ty
+  end
+
+val gnu_borrowed_record_automatic:
+  C.core_tag_definitions -> Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_borrowed_record_automatic tagDefs subject stmt =
+  let bound = match stmt.A.node with
+    | A.AilSblock bindings _ -> List.any (function
+        | (sym, ((_, A.Automatic, _), _, qs, ty)) ->
+            sym = subject && AilTypesAux.is_struct_or_union ty &&
+              gnu_borrowed_record_fixed_type tagDefs [] qs ty
+        | _ -> false end) bindings
+    | _ -> false end in
+  bound || (match gnu_record_statement_children stmt with
+    | Just (_, children) -> List.any (gnu_borrowed_record_automatic tagDefs subject) children
+    | Nothing -> false end)
+
+val gnu_borrowed_record_member:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let gnu_borrowed_record_member formal expr =
+  let (qs, ty) = qualified_ctype_of expr in
+  not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+    (AilTypesAux.is_arithmetic ty || (AilTypesAux.is_pointer ty &&
+      not (AilTypesAux.is_pointer_to_function ty))) &&
+    gnu_call_destination_parameter formal expr
+
+val gnu_borrowed_record_formal_expression:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_borrowed_record_formal_expression formal
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_borrowed_record_formal_expression formal in
+  let member = gnu_borrowed_record_member formal in
+  match node with
+    | A.AilEident sym -> sym <> formal
+    | A.AilErvalue operand -> if member operand then true else self operand
+    | A.AilEassign left right ->
+        if member left then self right else self left && self right
+    | A.AilEcompoundAssign left _ right ->
+        if member left then self right else self left && self right
+    | A.AilEunary A.PostfixIncr operand -> member operand || self operand
+    | A.AilEunary A.PostfixDecr operand -> member operand || self operand
+    | _ -> maybe false (List.all self) (gnu_record_children expr)
+  end
+
+val gnu_borrowed_record_formal_statement:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> bool
+let rec gnu_borrowed_record_formal_statement formal stmt =
+  match gnu_record_statement_children stmt with
+    | Nothing -> false
+    | Just (expressions, children) ->
+        List.all (gnu_borrowed_record_formal_expression formal) expressions &&
+          List.all (gnu_borrowed_record_formal_statement formal) children
+  end
+
+val gnu_borrowed_record_address:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_borrowed_record_address subject (A.AnnotatedExpression _ _ _ node) =
+  match node with
+    | A.AilEunary A.Address
+        (A.AnnotatedExpression _ _ _ (A.AilEident sym) as object_expr) ->
+        let (qs, ty) = qualified_ctype_of object_expr in
+        sym = subject && not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+          AilTypesAux.is_struct_or_union ty && gnu_inline_fixed_object_type ty
+    | A.AilEannot _ operand -> gnu_borrowed_record_address subject operand
+    | _ -> false
+  end
+
+val gnu_visible_borrow_subject_expression:
+  Symbol.sym -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_visible_borrow_subject_expression subject
+    (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_visible_borrow_subject_expression subject in
+  if gnu_alloc_size_subject_expression subject expr then E.return true else
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee) then E.return false else
+        gnu_inline_function_target callee >>= (function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+              E.gnu_memory_call_body target >>= (function
+                | Nothing -> E.return false
+                | Just (params, body) -> (match ctype_of callee with
+                    | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _
+                        (Ctype.Function _ types false))) ->
+                        if List.length params <> List.length args ||
+                            List.length types <> List.length args then E.return false else
+                        E.return (List.all (fun ((formal, (qs, ty, _)), actual) ->
+                          gnu_alloc_size_subject_expression subject actual ||
+                            (not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+                             gnu_borrowed_record_address subject actual &&
+                             gnu_function_target_type_equal ty (ctype_of actual) &&
+                             gnu_inline_parameter_unchanged formal body &&
+                             gnu_alloc_size_subject_unescaped formal body &&
+                             gnu_borrowed_record_formal_statement formal body))
+                          (List.zip (List.zip params types) args))
+                    | _ -> E.return false end)
+              end)
+        end)
+    (* An address not consumed by the exact admitted call is an escape.
+       Descending to its identifier would incorrectly erase that context. *)
+    | A.AilEunary A.Address _ -> E.return false
+    | A.AilEarray_decay _ -> E.return false
+    | _ -> (match gnu_record_children expr with
+        | Nothing -> E.return false
+        | Just children -> E.mapM self children >>= fun checked ->
+            E.return (List.all (fun yes -> yes) checked)
+      end)
+  end
+
+val gnu_visible_borrow_subject_statement:
+  Symbol.sym -> A.statement GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_visible_borrow_subject_statement subject stmt =
+  if gnu_alloc_size_subject_unescaped subject stmt then E.return true else
+  match gnu_record_statement_children stmt with
+    | Nothing -> E.return false
+    | Just (expressions, children) ->
+        E.mapM (gnu_visible_borrow_subject_expression subject) expressions >>= fun first ->
+        if not (List.all (fun yes -> yes) first) then E.return false else
+        E.mapM (gnu_visible_borrow_subject_statement subject) children >>= fun rest ->
+        E.return (List.all (fun yes -> yes) rest)
+  end
+
+(* Repeated calls to this same audited helper are allowed, including calls in
+   a condition. Every address use must occupy the same unique output position.
+   Ordinary reads/writes of the local are not an address escape. *)
+val gnu_output_actual_confined_expression:
+  Symbol.sym -> Symbol.sym -> nat -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_output_actual_confined_expression subject target index (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_output_actual_confined_expression subject target index in
+  if gnu_alloc_size_subject_expression subject expr then E.return true else
+  match node with
+    | A.AilEcall callee args ->
+        if not (gnu_inline_direct_designator callee && List.all gnu_memory_expression_readonly args)
+        then E.return false else
+        gnu_inline_function_target callee >>= function
+          | Nothing -> E.return false
+          | Just (declared, _) -> E.gnu_inline_target declared >>= fun found ->
+              E.return (found = target && match List.index args index with
+                | Just actual -> maybe false (fun (sym, _) -> sym = subject)
+                    (gnu_call_output_address actual) &&
+                    List.all (fun (position, arg) -> position = index ||
+                      gnu_alloc_size_subject_expression subject arg) (List.mapi (fun position arg -> (position, arg)) args)
+                | Nothing -> false end)
+        end
+    (* A rejected escape must not become accepted by dropping its address
