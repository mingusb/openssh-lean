+    | A.AilEcall callee args -> self callee && List.all self args
+    | A.AilEassert operand -> self operand
+    | A.AilEarray _ _ elements -> List.all (maybe true self) elements
+    | A.AilEstruct _ members -> List.all (fun (_, value) -> maybe true self value) members
+    | A.AilEunion _ _ value -> maybe true self value
+    | A.AilEcompound _ _ operand -> self operand
+    | A.AilEmemberof operand _ -> self operand
+    | A.AilEmemberofptr (A.AnnotatedExpression _ _ _ (A.AilEunary A.Address operand)) _ -> self operand
+    | A.AilEmemberofptr operand _ -> self operand
+    | A.AilEannot _ operand -> self operand
+    | A.AilErvalue operand -> self operand
+    | A.AilEgeneric _ (Just index) associations ->
