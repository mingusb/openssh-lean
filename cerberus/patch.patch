diff --git a/scripts/direct_capture_scalars.py b/scripts/direct_capture_scalars.py
new file mode 100644
index 00000000..1f5da244
--- /dev/null
+++ b/scripts/direct_capture_scalars.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""Shared numeric call emitter; scenarios are data, never native API implementations."""
+import hashlib
+import json
+import re
+from pathlib import Path
+
+KINDS = {"fd": ("int32_t", "signed", 32), "i32": ("int32_t", "signed", 32),
+         "i64": ("int64_t", "signed", 64), "u32": ("uint32_t", "unsigned", 32),
+         "u64": ("uint64_t", "unsigned", 64)}
+RESOURCE_KINDS = {"none": 0, "pipe_read": 1, "temp_file": 2, "socketpair": 3}
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def cstr(value):
+    return json.dumps(value, ensure_ascii=True)
+
+def emit_text(value):
+    return "fputs(" + cstr(value) + ",c->out);"
+
+def emit_number(expression, bits=32, signed=True):
+    quoted = bits == 64
+    fmt = ("%lld" if signed else "%llu") if quoted else ("%d" if signed else "%u")
+    cast = ("long long" if signed else "unsigned long long") if quoted else ("int" if signed else "unsigned")
+    return "fprintf(c->out," + cstr(('"' if quoted else '') + fmt + ('"' if quoted else '')) + ",(" + cast + ")" + expression + ");"
+
+def expression(argument):
+    value = argument.get("expr")
+    if value in ("resource_fd", "SHUT_WR", "SHUT_RDWR"):
+        return value
+    if not isinstance(value, str) or re.fullmatch(r"-?(0|[1-9][0-9]*)", value) is None:
+        raise ValueError("nondeclarative scalar argument expression")
+    return value
+
+HEADER = r'''
+typedef struct { int kind; int32_t fd; int32_t peer; } cerb_capture_resource;
+'''
+
+COMMON = r'''
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+_Static_assert(sizeof(int32_t)==sizeof(int)&&sizeof(int64_t)==sizeof(off_t),"scalar capture ABI");
+typedef struct {
+ int descriptor_result,descriptor_errno,stat_result,stat_errno,read_errno,peer_errno;
+ off_t size;
+ ssize_t read_result,peer_result;
+ unsigned char bytes[64];
+} scalar_resource_snapshot;
+static scalar_resource_snapshot scalar_snapshot(const cerb_capture_resource*r){
+ scalar_resource_snapshot s={0};
+ if(!r || !r->kind)return s;
+ errno=0;s.descriptor_result=fcntl(r->fd,F_GETFD);s.descriptor_errno=errno;
+ if(r->kind==2){
+  struct stat st;
+  errno=0;s.stat_result=fstat(r->fd,&st);s.stat_errno=errno;
+  if(s.stat_result==0){s.size=st.st_size;errno=0;s.read_result=pread(r->fd,s.bytes,sizeof(s.bytes),0);s.read_errno=errno;}
+ }
+ if(r->kind==3){unsigned char x;errno=0;s.peer_result=recv(r->peer,&x,1,MSG_PEEK|MSG_DONTWAIT);s.peer_errno=errno;}
+ return s;
+}
+static void scalar_resource_json(FILE*out,const cerb_capture_resource*r,const scalar_resource_snapshot*s){
+ if(!r||!r->kind){fputs("[]",out);return;}
+ fprintf(out,"[{\"resource_id\":\"fixture\",\"kind\":%d,\"descriptor\":%d,\"descriptor_probe_result\":%d,\"descriptor_probe_errno\":%d",r->kind,r->fd,s->descriptor_result,s->descriptor_errno);
+ if(r->kind==2){
+  fprintf(out,",\"stat_result\":%d,\"stat_errno\":%d,\"size\":",s->stat_result,s->stat_errno);
+  if(s->stat_result==0)fprintf(out,"\"%lld\"",(long long)s->size);else fputs("null",out);
+  fputs(",\"prefix_read_result\":",out);
+  if(s->stat_result==0)fprintf(out,"\"%lld\"",(long long)s->read_result);else fputs("null",out);
+  fputs(",\"prefix_read_errno\":",out);
+  if(s->stat_result==0)fprintf(out,"%d",s->read_errno);else fputs("null",out);
+  fputs(",\"prefix_hex\":",out);
+  if(s->stat_result==0&&s->read_result>=0){fputc('"',out);hex(out,s->bytes,(size_t)s->read_result);fputc('"',out);}else fputs("null",out);
+  fputs(",\"prefix_limit\":64",out);
+ }
+ if(r->kind==3)fprintf(out,",\"peer_descriptor\":%d,\"peer_peek_result\":\"%lld\",\"peer_peek_errno\":%d",r->peer,(long long)s->peer_result,s->peer_errno);
+ fputs("}]",out);
+}
+static void scalar_resources(cerb_capture_context*c,const cerb_capture_resource*r,const scalar_resource_snapshot*b,const scalar_resource_snapshot*a){
+ fputs("\"resources_before\":",c->out);scalar_resource_json(c->out,r,b);
+ fputs(",\"resources_after\":",c->out);scalar_resource_json(c->out,r,a);
+ if(r&&r->kind)fputs(",\"effects\":[{\"kind\":\"observed_resource_transition\",\"before\":\"resources_before\",\"after\":\"resources_after\",\"coverage\":\"fixture descriptor probe, optional file size/prefix or local peer peek only\"}],",c->out);
+ else fputs(",\"effects\":[],",c->out);
+}
+'''
+
+FIXTURES = r'''
+#include <stdlib.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+static int scalar_fixture_begin(cerb_capture_resource*r,int kind){
+ *r=(cerb_capture_resource){kind,-1,-1};
+ if(kind==0)return 1;
+ if(kind==1){int fds[2];if(pipe(fds)!=0)return 0;r->fd=fds[0];r->peer=fds[1];return 1;}
+ if(kind==2){char path[]="./capture-file-XXXXXX";r->fd=mkstemp(path);if(r->fd<0)return 0;if(unlink(path)!=0||write(r->fd,"abcdef",6)!=6)return 0;return 1;}
+ if(kind==3){int fds[2];if(socketpair(AF_UNIX,SOCK_STREAM,0,fds)!=0)return 0;r->fd=fds[0];r->peer=fds[1];return 1;}
+ return 0;
+}
+static int scalar_fixture_end(cerb_capture_resource*r){
+ if(r->fd>=0&&fcntl(r->fd,F_GETFD)>=0&&close(r->fd)!=0)return 0;
+ if(r->peer>=0&&close(r->peer)!=0)return 0;
+ return 1;
+}
+'''
+
+def compatible(api):
+    params = api.get("params", [])
+    if any(p.get("kind") not in KINDS or re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*", p.get("name", "")) is None for p in params):
+        return False
+    # Numeric transport eligibility does not imply that a resource operation is pure.
+    return ((api.get("shape") == "scalar" and
+             (api.get("native_return") == "int" or api.get("return_kind") == "signed_scalar")) or
+            api.get("primitive") == "fd_int")
+
+def expand(base, cats, generator_sha, files):
+    scenario_path = Path(__file__).with_name("direct-capture-scenarios.json")
+    scenarios = json.loads(scenario_path.read_text())["scenarios"]
+    plan = json.loads(files["capture-plan.json"])
+    unsupported = json.loads(files["unsupported-signatures.json"])["rows"]
+    entries = {}
+    for path, catalog in cats:
+        family = path.parent.name if path != base else "base"
+        for api in catalog.get("apis", []):
+            entries[(family, api["symbol"])] = (path, api)
+    selected = {}
+    ids = set()
+    for case in scenarios:
+        if case["id"] in ids or re.fullmatch(r"[a-z0-9-]+", case["id"]) is None:
+            raise ValueError("invalid/duplicate scalar scenario id")
+        ids.add(case["id"])
+        key = (case["family"], case["symbol"])
+        if key not in entries:
+            raise ValueError("scenario declaration absent from catalog: " + str(key))
+        path, api = entries[key]
+        if not compatible(api):
+            raise ValueError("scenario requires unsupported numeric declaration shape")
+        if case["setup"] not in RESOURCE_KINDS or case["errno_seed"] not in ("0", "EINTR"):
+            raise ValueError("unsupported declarative resource/errno seed")
+        if len(case["arguments"]) != len(api.get("params", [])):
+            raise ValueError("scalar scenario arity differs from declaration")
+        for argument, param in zip(case["arguments"], api.get("params", [])):
+            if argument["name"] != param["name"] or argument["kind"] != param["kind"]:
+                raise ValueError("scenario argument declaration/order differs")
+            expression(argument)
+            ctype, signed, bits = KINDS[param["kind"]]
+            if argument["type"] != ("i" if signed == "signed" else "u") + str(bits):
+                raise ValueError("scenario width differs from declaration")
+            if "value_source" in argument and (argument["value_source"] != "resource_fd" or argument["expr"] != "resource_fd" or case["setup"] == "none"):
+                raise ValueError("resource descriptor is not established")
+        selected[key] = (path, api)
+    declarations, definitions, smoke = [], [], []
+    for (family, symbol), (path, api) in selected.items():
+        if re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*", symbol) is None:
+            raise ValueError("invalid declared symbol")
+        params = api.get("params", [])
+        cparams = [KINDS[p["kind"]][0] + " " + p["name"] for p in params]
+        signature = "int cerb_capture_" + symbol + "(cerb_capture_context*c,uint64_t id," + (",".join(cparams) + "," if cparams else "") + "const cerb_capture_resource*resource)"
+        declarations.append(signature + ";")
+        types = ",".join(KINDS[p["kind"]][0] for p in params) or "void"
+        body = ['static int (*const cerb_signature_' + symbol + ')(' + types + ') __attribute__((unused)) = &' + symbol + ';', signature + "{", "if (!ready(c)) { return 0; }", "int transport=errno;", "scalar_resource_snapshot resource_before=scalar_snapshot(resource);", "errno=c->modeled_errno;", "int before=errno;", "int value=" + symbol + "(" + ",".join(p["name"] for p in params) + ");", "int after=errno;", "c->modeled_errno=after;", "scalar_resource_snapshot resource_after=scalar_snapshot(resource);", "prefix(c,id," + cstr(symbol) + ");", emit_text('"arguments":[')]
+        for index, p in enumerate(params):
+            ctype, signed, bits = KINDS[p["kind"]]
+            descriptor = {"name": p["name"], "kind": p["kind"], "numeric_type": {"kind": signed, "bits": bits}, "declared_type": ctype}
+            text = json.dumps(descriptor, separators=(",", ":"))[:-1] + ',"value":'
+            body += [emit_text(("," if index else "") + text), emit_number(p["name"], bits, signed == "signed"), emit_text("}")]
