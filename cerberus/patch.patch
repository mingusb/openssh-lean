+    good(named);assert(named.status.value==0 && named.fields[0]==sizeof(addr));
+    cerb_host_network_dispose(&named);
+    close(accepted_fd);close(a);close(b);
+    cerb_host_network_dispose(&server);cerb_host_network_dispose(&client);
+    /* Typed borrowed resolver TLS object: no host addresses leave the bridge. */
+    unsigned long original=__res_state()->options;
+    cerb_host_network_result state=cerb_net___res_state_raw(91);
+    good(state);assert(state.status.value==1 && state.field_count==6);
+    uint64_t state_token=state.fields[0];
+    assert(state.fields[1]==sizeof(struct __res_state));
+    assert(state.fields[2]==offsetof(struct __res_state,options));
+    assert(state.fields[3]==sizeof(unsigned long) && state.fields[4]==original);
+    assert(state.native_errno_after==91);cerb_host_network_dispose(&state);
+    state=cerb_net___res_state_raw(92);good(state);assert(state.fields[0]==state_token);
+    cerb_host_network_dispose(&state);
+    state=cerb_net_resolver_options_load_raw(93,state_token);
+    good(state);assert(state.fields[0]==original);cerb_host_network_dispose(&state);
+    unsigned long changed=original^RES_DEBUG;
+    state=cerb_net_resolver_options_store_raw(94,state_token,original,changed);
+    good(state);assert(__res_state()->options==changed && state.fields[0]==changed);
+    cerb_host_network_dispose(&state);
+    state=cerb_net_resolver_options_store_raw(95,state_token,original,original);
+    assert(state.boundary_error && __res_state()->options==changed);cerb_host_network_dispose(&state);
+    state=cerb_net_resolver_options_store_raw(96,state_token,changed,original);
+    good(state);assert(__res_state()->options==original);cerb_host_network_dispose(&state);
+
+    /* Equal native handles/symbols retain identity across repeated acquisition.
+       These tests query capabilities; no untyped symbol is called as a function. */
+    cerb_host_network_result h1=cerb_net_dlopen_raw(97,0,NULL,0,RTLD_NOW);
+    cerb_host_network_result h2=cerb_net_dlopen_raw(98,0,NULL,0,RTLD_NOW);
+    good(h1);good(h2);assert(h1.status.value==1 && h2.status.value==1);
+    uint64_t handle=h1.fields[1];
+    assert(h2.fields[1]==handle && h2.fields[2]==2);
+    const unsigned char malloc_name[]="malloc";
+    cerb_host_network_result sym1=cerb_net_dlsym_raw(99,handle,malloc_name,sizeof(malloc_name));
+    cerb_host_network_result sym2=cerb_net_dlsym_raw(100,handle,malloc_name,sizeof(malloc_name));
+    good(sym1);good(sym2);assert(sym1.status.value==1 && sym2.fields[1]==sym1.fields[1]);
+    uint64_t symbol=sym1.fields[1];
+    assert(sym1.fields[2]==0 && sym1.fields[3]==0);
+    cerb_host_network_result info=cerb_net_provider_symbol_info_raw(101,symbol);
+    good(info);assert(info.fields[1]==0 && info.fields[2]==0 && info.fields[3]==1);
+    cerb_host_network_dispose(&info);
+    cerb_host_network_result released=cerb_net_dlclose_raw(102,handle);
+    good(released);assert(released.status.value==0 && released.fields[1]==1);
+    cerb_host_network_dispose(&released);
+    info=cerb_net_provider_symbol_info_raw(103,symbol);good(info);cerb_host_network_dispose(&info);
+    released=cerb_net_dlclose_raw(104,handle);
+    good(released);assert(released.status.value==0 && released.fields[1]==0);
+    cerb_host_network_dispose(&released);
+    info=cerb_net_provider_symbol_info_raw(105,symbol);
+    assert(info.boundary_error);cerb_host_network_dispose(&info);
+    cerb_host_network_dispose(&sym1);cerb_host_network_dispose(&sym2);
+    cerb_host_network_dispose(&h1);cerb_host_network_dispose(&h2);
+    puts("network-ok");return 0;
+}
diff --git a/lean_frontend/host/families/system/SystemMemoryTest.lean b/lean_frontend/host/families/system/SystemMemoryTest.lean
new file mode 100644
index 00000000..a0dcde99
--- /dev/null
+++ b/lean_frontend/host/families/system/SystemMemoryTest.lean
@@ -0,0 +1,122 @@
+import CerbHostSystemMemory
+open CerbMem CerbHostMemoryCells CerbHostSystemMemory CerberusImpl
+
+private def ensure (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+
+private def take (x : Except Failure α) : IO α :=
+  match x with
+  | .ok value => pure value
+  | .error (.boundary message) => throw (IO.userError message)
+  | .error (.memory _) => throw (IO.userError "unexpected modeled memory error")
+
+private def cell (cells : List Cell) (index : Nat) : IO Cell :=
+  match cells[index]? with
+  | some value => pure value
+  | none => throw (IO.userError "missing prepared test cell")
+
+private def fails (x : Except Failure α) : Bool :=
+  match x with | .error _ => true | .ok _ => false
+
+@[extern "cerb_system_test_enable_worker"]
+private opaque enableTestWorker : BaseIO UInt32
+@[extern "cerb_system_test_stream_fixture"]
+private opaque streamFixture : UInt32 → BaseIO UInt64
+
+private def accepted (r : CerbHostSystem.SystemResult) : IO Unit :=
+  ensure r.boundaryError.isEmpty r.boundaryError
+
+private def checkLine [LemFuel] [CerbGlobal.Switches]
+    (fixture : UInt32) (expected : Array UInt8) (present : Bool) (expectedErrno : Int) : IO Unit := do
+  let enums : EnumDefs := fmapEmpty
+  let tags : CerbTags.TagDefsMap := fmapEmpty
+  let (pointer, allocated) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 64))
+    (initialMemState 4096))
+  let (integers, allocated) ← take (arrayCells enums tags .signedInt pointer 16 allocated)
+  let errnoCell ← cell integers 12
+  let (byteCells, allocated) ← take (arrayCells enums tags .byte pointer 32 allocated)
+  let errnoLease ← take (prepareOutputs enums tags [errnoCell] allocated)
+  let (_, state) ← take (commitOutputs enums tags errnoLease [33])
+  let token ← streamFixture fixture
+  ensure (token != 0) "native stream fixture creation"
+  -- The fixture's driver table owns one modeled FILE identity, separate from its
+  -- output allocation; the resolver performs identity equality, never a cast.
+  let streamCell ← cell integers 14
+  let stream := streamCell.pointer
+  let resolve (p : PointerValue) : Except String UInt64 :=
+    if p == stream then .ok token else .error "unregistered modeled FILE identity"
+  let readonly := { state with allocations := state.allocations.map fun _ allocation =>
+    { allocation with isReadonly := .IsReadOnly .ReadonlyConstQualified } }
+  ensure (fails (prepare enums tags resolve errnoCell.pointer
+    (.fgets pointer 32 stream) readonly)) "readonly destination rejected before native I/O"
+  let firstByte ← cell byteCells 0
+  let suffixByte ← cell byteCells expected.size
+  let prepared ← take (prepare enums tags resolve errnoCell.pointer
+    (.fgets pointer 32 stream) state)
+  ensure (fails (readInteger enums tags firstByte (unchanged prepared.outputs)))
+    "preflight must not initialize destination bytes"
+  let response ← executeNative prepared
+  let completed ← take (complete enums tags prepared response)
+  match completed.returnValue with
+  | .pointer (some returned) =>
+    ensure (present && returned == pointer) "fgets returns exact original pointer"
+  | .pointer none => ensure (!present) "fgets failure returns typed NULL"
+  | _ => throw (IO.userError "fgets return classification")
+  let (actual, _, after) ← take (readBytes enums tags pointer expected.size completed.memory)
+  ensure (actual.data == expected) "binary prefix copyback including embedded NUL"
+  ensure (fails (readInteger enums tags suffixByte after))
+    "untouched suffix remains unspecified after success or partial failure"
+  let (err, _, _) ← take (readInteger enums tags errnoCell after)
+  ensure (err == expectedErrno) "native errno copied independently of return success"
+  accepted (← CerbHostSystem.execute 33 (.fclose token))
+
+private def run [LemFuel] [CerbGlobal.Switches] : IO Unit := do
+  ensure ((← enableTestWorker) == 1) "dedicated fixture worker initialization"
+  checkLine 0 #[65,0,66,10,0] true 33
+  checkLine 2 #[65,0,66,0] true 11
+  checkLine 3 #[65,0,66] false 5
+  checkLine 4 #[] false 5
+  let enums : EnumDefs := fmapEmpty
+  let tags : CerbTags.TagDefsMap := fmapEmpty
+  let (pointer, allocated) ← take (immediate
+    (allocateRegion 0 .PrefMalloc (.IV .Prov_none 8) (.IV .Prov_none 16))
+    (initialMemState 4096))
+  let (cells, allocated) ← take (arrayCells enums tags .signedInt pointer 4 allocated)
+  let errnoCell ← cell cells 0
+  let lease ← take (prepareOutputs enums tags [errnoCell] allocated)
+  let (_, state) ← take (commitOutputs enums tags lease [-17])
+  let token ← streamFixture 0
+  ensure (token != 0) "NULL output fixture"
+  let streamCell ← cell cells 3
+  let stream := streamCell.pointer
+  let resolve (p : PointerValue) : Except String UInt64 :=
+    if p == stream then .ok token else .error "unregistered modeled FILE identity"
+  let null := nullPtrval unsigned_char
+  let zero ← take (prepare enums tags resolve errnoCell.pointer (.fgets null 0 stream) state)
+  let zeroResult ← executeNative zero
+  let completed ← take (complete enums tags zero zeroResult)
+  let (err, _, after) ← take (readInteger enums tags errnoCell completed.memory)
+  ensure (err == -17) "signed modeled errno bit pattern survives a no-op native call"
+  ensure (fails (prepare enums tags resolve errnoCell.pointer
+    (.setvbuf stream pointer 0 4096) after))
+    "nonnull retained buffer must never be replaced with a temporary allocation"
+  let buffering ← take (prepare enums tags resolve errnoCell.pointer
+    (.setvbuf stream null 0 4096) after)
+  let bufferingResult ← executeNative buffering
+  let buffered ← take (complete enums tags buffering bufferingResult)
+  match buffered.returnValue with
+  | .signedInt value => ensure (value == 0) "NULL-buffer setvbuf actual result"
+  | _ => throw (IO.userError "setvbuf return classification")
+  let (err, _, _) ← take (readInteger enums tags errnoCell buffered.memory)
+  ensure (err == -17) "setvbuf signed errno unchanged"
+  accepted (← CerbHostSystem.execute 33 (.fclose token))
+  IO.println "system-memory-ok"
+
+def main (args : List String) : IO Unit := do
+  match args with
+  | [fuel] =>
+    match fuel.toNat? with
+    | some budget => @run ⟨budget⟩ ⟨CerbGlobal.defaultSwitches⟩
+    | none => throw (IO.userError "expected checked-runner fuel argument")
+  | _ => throw (IO.userError "expected checked-runner fuel argument")
diff --git a/lean_frontend/host/families/system/SystemOracle.c b/lean_frontend/host/families/system/SystemOracle.c
new file mode 100644
index 00000000..ea886aa0
--- /dev/null
+++ b/lean_frontend/host/families/system/SystemOracle.c
@@ -0,0 +1,244 @@
+#define _GNU_SOURCE
+#include "host_system.h"
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <grp.h>
+#include <pwd.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <termios.h>
+#include <time.h>
+#include <unistd.h>
+#include <signal.h>
+
+#include "SystemStreamFixtures.h"
+extern char *reference_fgets_libc(char *,int,FILE *) __asm__("fgets");
+extern int reference_getgroups_libc(int,gid_t *) __asm__("getgroups");
+static void clean(cerb_system_result *r) {
+    assert(!r->boundary_error);
+    cerb_system_dispose(r);
+}
+static void put32(unsigned char *p,uint32_t v) {
+    for(unsigned i=0;i<4;i++) p[i]=(unsigned char)(v>>(8*i));
+}
+static uint64_t get64(const unsigned char *p) {
+    uint64_t x=0;
+    for(unsigned i=0;i<8;i++) x|=(uint64_t)p[i]<<(8*i);
+    return x;
+}
+static void direct_tests(void) {
+    cerb_system_result r=cerb_system_getpid_raw(EDOM);
+    assert(r.boundary_error); cerb_system_dispose(&r);
+    errno=E2BIG;
+    r=cerb_system_getpagesize_raw(EDOM);
+    assert(r.status.value==getpagesize() && r.native_errno_after==EDOM && errno==E2BIG); clean(&r);
+    r=cerb_system_isatty_raw(EDOM,-1);
+    assert(r.status.value==0 && r.status.error==EBADF && r.native_errno_after==EBADF && errno==E2BIG); clean(&r);
+    r=cerb_system_clock_gettime_raw(EDOM,-1234);
+    assert(r.status.value==-1 && r.status.error==EINVAL && r.native_errno_after==EINVAL && !r.field_count && errno==E2BIG); clean(&r);
+    struct timespec before,after;
+    assert(!clock_gettime(CLOCK_MONOTONIC,&before));
+    r=cerb_system_clock_gettime_raw(EDOM,CLOCK_MONOTONIC);
+    assert(!clock_gettime(CLOCK_MONOTONIC,&after));
+    assert(r.status.value==0 && r.field_count==2 && r.fields[1]<1000000000);
+    assert(r.fields[0]>=(uint64_t)before.tv_sec && r.fields[0]<=(uint64_t)after.tv_sec); clean(&r);
+    r=cerb_system_arc4random_uniform_raw(EDOM,1);
+    assert(r.status.value==0 && r.native_errno_after==EDOM); clean(&r);
+    r=cerb_system_arc4random_buf_raw(EDOM,64);
+    assert(r.bytes_count==64 && r.status.value==0 && r.native_errno_after==EDOM); clean(&r);
+    r=cerb_system_arc4random_buf_raw(EDOM,0);
+    assert(r.bytes_count==0 && !r.boundary_error); clean(&r);
+    unsigned char wire[57]={0}; struct termios native={0};
+    assert(!cfsetispeed(&native,B9600));
+    r=cerb_system_cfsetispeed_raw(EDOM,wire,sizeof wire,B9600);
+    assert(r.status.value==0 && r.bytes_count==57);
+    cerb_system_result q=cerb_system_cfgetispeed_raw(EDOM,r.bytes,r.bytes_count);
+    assert(q.status.value==cfgetispeed(&native)); clean(&q);
+    memcpy(wire,r.bytes,57); clean(&r);
+    put32(wire+49,B9600);
+    r=cerb_system_cfsetospeed_raw(EDOM,wire,sizeof wire,B19200);
+    assert(r.status.value==0 && r.bytes_count==57);
+    q=cerb_system_cfgetospeed_raw(EDOM,r.bytes,r.bytes_count);
+    assert(q.status.value==B19200); clean(&q); clean(&r);
+    r=cerb_system_tcgetattr_raw(EDOM,-1);
+    assert(r.status.value==-1 && r.status.error==EBADF && !r.bytes_count); clean(&r);
+    unsigned char mask[sizeof(sigset_t)]; memset(mask,0xa5,sizeof mask);
+    sigset_t expected; memcpy(&expected,mask,sizeof expected); assert(!sigemptyset(&expected));
+    r=cerb_system_sigemptyset_raw(EDOM,mask,sizeof mask);
+    assert(r.status.value==0 && r.bytes_count==sizeof expected && !memcmp(r.bytes,&expected,sizeof expected)); clean(&r);
+    memcpy(&expected,mask,sizeof expected); assert(!sigfillset(&expected));
+    r=cerb_system_sigfillset_raw(EDOM,mask,sizeof mask);
+    assert(r.status.value==0 && !memcmp(r.bytes,&expected,sizeof expected)); clean(&r);
+    assert(!sigemptyset(&expected)); memcpy(mask,&expected,sizeof mask); assert(!sigaddset(&expected,SIGINT));
+    r=cerb_system_sigaddset_raw(EDOM,mask,sizeof mask,SIGINT);
+    assert(r.status.value==0 && !memcmp(r.bytes,&expected,sizeof expected)); clean(&r);
+}
+static void file_tests(void) {
+    char path[]="/tmp/cerb-generated-file-XXXXXX";
+    int seed=mkstemp(path); assert(seed>=0); assert(!close(seed));
+    const unsigned char mode[]="w+";
+    cerb_system_result r=cerb_system_fopen_raw(EDOM,(const unsigned char *)path,strlen(path)+1,mode,sizeof mode);
+    assert(r.status.value==1 && r.field_count==3 && r.fields[2]==1);
+    uint64_t token=r.fields[0]; int fd=(int)r.fields[1]; clean(&r);
+    assert(cerb_system_file_lookup(token) && fileno(cerb_system_file_lookup(token))==fd);
+    const unsigned char payload[]={'A',0,'B','\n'};
+    r=cerb_system_fwrite_raw(EDOM,payload,sizeof payload,1,sizeof payload,token);
+    assert(r.field_count==1 && r.fields[0]==sizeof payload); clean(&r);
+    r=cerb_system_fflush_raw(EDOM,token); assert(!r.status.value); clean(&r);
+    r=cerb_system_fileno_raw(EDOM,token); assert(r.status.value==fd); clean(&r);
+    r=cerb_system_fseek_raw(EDOM,token,0,SEEK_SET); assert(!r.status.value); clean(&r);
+    r=cerb_system_fgetc_raw(EDOM,token); assert(r.status.value=='A'); clean(&r);
+    r=cerb_system_fgetc_raw(EDOM,token); assert(r.status.value==0); clean(&r);
+    r=cerb_system_feof_raw(EDOM,token); assert(!r.status.value); clean(&r);
+    r=cerb_system_ferror_raw(EDOM,token); assert(!r.status.value); clean(&r);
+    r=cerb_system_rewind_raw(EDOM,token); assert(!r.status.value); clean(&r);
+    r=cerb_system_fputc_raw(EDOM,'Z',token); assert(r.status.value=='Z'); clean(&r);
+    const unsigned char text[]="line";
+    r=cerb_system_fputs_raw(EDOM,text,sizeof text,token); assert(r.status.value>=0); clean(&r);
+    r=cerb_system_fclose_raw(EDOM,token); assert(!r.status.value && r.fields[0]==(uint64_t)fd); clean(&r);
+    r=cerb_system_ferror_raw(EDOM,token); assert(r.boundary_error); cerb_system_dispose(&r);
+    errno=0; assert(fcntl(fd,F_GETFD)==-1 && errno==EBADF);
+    int fd2=open(path,O_RDWR); assert(fd2>=0);
+    r=cerb_system_fdopen_raw(EDOM,fd2,mode,sizeof mode);
+    assert(r.status.value==1 && r.fields[1]==(uint64_t)fd2); token=r.fields[0]; clean(&r);
+    assert(!close(fd2));
+    r=cerb_system_fclose_raw(EDOM,token);
+    assert(r.status.value==EOF && r.native_errno_after==EBADF); clean(&r);
+    r=cerb_system_feof_raw(EDOM,token); assert(r.boundary_error); cerb_system_dispose(&r);
+    assert(!unlink(path));
+    const unsigned char command[]="printf transport";
+    const unsigned char readmode[]="r";
+    r=cerb_system_popen_raw(EDOM,command,sizeof command,readmode,sizeof readmode);
+    assert(r.status.value==1 && r.fields[2]==2); token=r.fields[0]; clean(&r);
+    r=cerb_system_fgetc_raw(EDOM,token); assert(r.status.value=='t'); clean(&r);
+    r=cerb_system_pclose_raw(EDOM,token); assert(r.status.value==0); clean(&r);
+}
+
+static void compare_fgets(FILE *reference,uint64_t token,int limit) {
+    unsigned char expected[64],actual[64];
+    memset(expected,0xa5,sizeof expected); memset(actual,0xa5,sizeof actual);
+    errno=EDOM;
+    char *returned=reference_fgets_libc((char *)expected,limit,reference);
+    int reference_errno=errno;
+    int reference_eof=!!feof(reference),reference_error=!!ferror(reference);
+    errno=E2BIG;
+    cerb_system_result r=cerb_system_fgets_raw(EDOM,limit,token);
+    assert(!r.boundary_error && errno==E2BIG);
+    assert(r.status.value==(returned!=NULL));
+    assert(r.native_errno_after==(uint32_t)reference_errno);
+    assert(r.bytes_count<=sizeof actual);
+    if(r.bytes_count) memcpy(actual,r.bytes,r.bytes_count);
+    assert(!memcmp(actual,expected,sizeof actual));
+    FILE *candidate=cerb_system_file_lookup(token); assert(candidate);
+    assert(!!feof(candidate)==reference_eof && !!ferror(candidate)==reference_error);
+    clean(&r);
+}
+static void getline_tests(void) {
+    const int limits[]={-1,0,1,2,4,7,64};
+    for(unsigned fixture=0;fixture<5;fixture++)
+      for(unsigned old_error=0;old_error<2;old_error++)
+        for(unsigned caller_lock=0;caller_lock<2;caller_lock++)
+          for(unsigned n=0;n<sizeof limits/sizeof limits[0];n++) {
+            FILE *reference=system_fixture_stream(fixture);
+            FILE *candidate=system_fixture_stream(fixture);
+            assert(reference && candidate);
+            if(old_error) {
+                /* A genuine read-only stream write sets its existing error. */
+                assert(fputc('?',reference)==EOF && ferror(reference));
+                assert(fputc('?',candidate)==EOF && ferror(candidate));
+            }
+            if(caller_lock) {
+                __fsetlocking(reference,FSETLOCKING_BYCALLER);
+                __fsetlocking(candidate,FSETLOCKING_BYCALLER);
+            }
+            uint64_t token=system_register_fixture(candidate); assert(token);
+            compare_fgets(reference,token,limits[n]);
+            /* The second call also observes matching consumption/EOF state. */
+            compare_fgets(reference,token,64);
+            assert(!fclose(reference));
+            cerb_system_result close_result=cerb_system_fclose_raw(EDOM,token);
+            assert(!close_result.status.value); clean(&close_result);
+          }
+    /* setvbuf NULL preserves actual mode/size handling and errno. */
+    const int modes[]={_IOFBF,_IOLBF,_IONBF,-123};
+    const size_t sizes[]={0,1,4096};
+    for(unsigned mode=0;mode<sizeof modes/sizeof modes[0];mode++)
+      for(unsigned size=0;size<sizeof sizes/sizeof sizes[0];size++) {
+        FILE *reference=tmpfile(),*candidate=tmpfile();
+        assert(reference && candidate);
+        uint64_t token=system_register_fixture(candidate); assert(token);
+        errno=EDOM;
+        int expected=setvbuf(reference,NULL,modes[mode],sizes[size]);
+        int reference_errno=errno;
+        errno=E2BIG;
+        cerb_system_result r=cerb_system_setvbuf_raw(EDOM,token,modes[mode],sizes[size]);
+        assert(r.status.value==expected && r.native_errno_after==(uint32_t)reference_errno && errno==E2BIG);
+        clean(&r);
+        assert(fputs("buffering\n",reference)>=0 && fputs("buffering\n",candidate)>=0);
+        assert(!fflush(reference) && !fflush(candidate));
+        rewind(reference); rewind(candidate);
+        compare_fgets(reference,token,64);
+        assert(!fclose(reference));
+        r=cerb_system_fclose_raw(EDOM,token); assert(!r.status.value); clean(&r);
+      }
+}
+
+static void worker_tests(void) {
+    assert(cerb_system_enable_worker((int32_t)getpid()));
+    errno=E2BIG;
+    cerb_system_result r=cerb_system_getpid_raw(EDOM);
+    assert(r.status.value==getpid() && r.native_errno_after==EDOM && errno==E2BIG); clean(&r);
+    r=cerb_system_getppid_raw(EDOM);
+    assert(r.status.value==getppid()); clean(&r);
+    r=cerb_system_getpgrp_raw(EDOM);
+    assert(r.status.value==getpgrp()); clean(&r);
+    struct rlimit lim; assert(!getrlimit(RLIMIT_NOFILE,&lim));
+    r=cerb_system_getrlimit_raw(EDOM,RLIMIT_NOFILE);
+    assert(!r.status.value && r.field_count==2 && r.fields[0]==lim.rlim_cur && r.fields[1]==lim.rlim_max); clean(&r);
+    r=cerb_system_nanosleep_raw(EDOM,0,0);
+    assert(r.status.value==0 && !r.field_count); clean(&r);
+    const unsigned char key[]="CERBERUS_GENERATED_SYSTEM_TEST";
+    const unsigned char value[]="transport-value";
+    r=cerb_system_setenv_raw(EDOM,key,sizeof key,value,sizeof value,1);
+    assert(!r.status.value && !strcmp(getenv((const char *)key),(const char *)value)); clean(&r);
+    r=cerb_system_getenv_raw(EDOM,key,sizeof key);
+    assert(r.status.value==1 && r.bytes_count==sizeof value && !memcmp(r.bytes,value,sizeof value)); clean(&r);
+    r=cerb_system_unsetenv_raw(EDOM,key,sizeof key); assert(!r.status.value); clean(&r);
+    r=cerb_system_getenv_raw(EDOM,key,sizeof key);
+    assert(!r.status.value && !r.bytes_count && r.native_errno_after==EDOM); clean(&r);
+    const unsigned char bad[]={'x',0,'y',0};
+    r=cerb_system_getenv_raw(EDOM,bad,sizeof bad); assert(r.boundary_error); cerb_system_dispose(&r);
+    struct passwd *pw=getpwuid(getuid()); assert(pw);
+    char *expected=strdup(pw->pw_name); assert(expected);
+    r=cerb_system_getpwuid_raw(EDOM,getuid());
+    assert(r.status.value==1 && r.field_count==2 && r.fields[0]==getuid());
+    assert(r.bytes_count>8 && get64(r.bytes)==strlen(expected)+1 && !strcmp((char *)r.bytes+8,expected)); clean(&r); free(expected);
+    errno=EDOM;
+    int negative=reference_getgroups_libc(-1,NULL); int negative_errno=errno;
+    assert(negative==-1 && negative_errno==EINVAL);
+    errno=E2BIG;
+    r=cerb_system_getgroups_raw(EDOM,-1);
+    assert(r.status.value==negative && r.status.error==(uint32_t)negative_errno &&
+        r.native_errno_after==(uint32_t)negative_errno && errno==E2BIG && !r.bytes_count); clean(&r);
+    int count=getgroups(0,NULL); assert(count>=0);
+    r=cerb_system_getgroups_raw(EDOM,0); assert(r.status.value==count && !r.bytes_count); clean(&r);
+    r=cerb_system_getgroups_raw(EDOM,count); assert(r.status.value==count && r.bytes_count==(size_t)count*4); clean(&r);
+    file_tests();
+    getline_tests();
+    pid_t nested=fork(); assert(nested>=0);
+    if(!nested) { r=cerb_system_getpid_raw(EDOM); _exit(r.boundary_error?0:1); }
+    int st; assert(waitpid(nested,&st,0)==nested && WIFEXITED(st) && !WEXITSTATUS(st));
+}
+int main(void) {
+    direct_tests();
+    pid_t child=fork(); assert(child>=0);
+    if(!child) { worker_tests(); _exit(0); }
+    int st; assert(waitpid(child,&st,0)==child && WIFEXITED(st) && !WEXITSTATUS(st));
+    puts("system-ok");
+    return 0;
+}
diff --git a/lean_frontend/host/families/system/SystemStreamFixtures.h b/lean_frontend/host/families/system/SystemStreamFixtures.h
new file mode 100644
index 00000000..440a8ac0
--- /dev/null
+++ b/lean_frontend/host/families/system/SystemStreamFixtures.h
@@ -0,0 +1,55 @@
+#ifndef CERB_SYSTEM_STREAM_FIXTURES_H
+#define CERB_SYSTEM_STREAM_FIXTURES_H
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio_ext.h>
+
+/* A controlled stream, not a replacement for fgets: both reference libc and
+   generated transport consume independently created copies of this input. */
+typedef struct {
+    unsigned char bytes[8];
+    size_t length, position;
+    int terminal_error;
+} system_cookie;
+static ssize_t system_cookie_read(void *opaque,char *buffer,size_t limit) {
+    system_cookie *state=opaque;
+    size_t available=state->length-state->position;
+    if(available) {
+        size_t count=available<limit?available:limit;
+        memcpy(buffer,state->bytes+state->position,count);
+        state->position+=count;
+        return (ssize_t)count;
+    }
+    if(state->terminal_error) { errno=state->terminal_error; return -1; }
+    return 0;
+}
+static int system_cookie_close(void *opaque) { free(opaque); return 0; }
+static FILE *system_fixture_stream(unsigned fixture) {
+    system_cookie *cookie=calloc(1,sizeof *cookie);
+    if(!cookie) return NULL;
+    const unsigned char input[]={'A',0,'B','\n','C','D'};
+    memcpy(cookie->bytes,input,sizeof input);
+    cookie->length=sizeof input;
+    switch(fixture) {
+    case 0: break;
+    case 1: cookie->length=0; break;
+    case 2: cookie->length=3; cookie->terminal_error=EAGAIN; break;
+    case 3: cookie->length=3; cookie->terminal_error=EIO; break;
+    case 4: cookie->length=0; cookie->terminal_error=EIO; break;
+    default: free(cookie); return NULL;
+    }
+    cookie_io_functions_t methods={.read=system_cookie_read,.close=system_cookie_close};
+    FILE *stream=fopencookie(cookie,"r",methods);
+    if(!stream) free(cookie);
+    return stream;
+}
+static uint64_t system_register_fixture(FILE *stream) {
+    if(!stream) return 0;
+    cerb_system_file_reservation *entry=cerb_system_file_reserve();
+    if(!entry) { fclose(stream); return 0; }
+    return cerb_system_file_commit(entry,stream,1);
+}
+#endif
diff --git a/lean_frontend/host/families/system/SystemTest.lean b/lean_frontend/host/families/system/SystemTest.lean
new file mode 100644
index 00000000..9448d52a
--- /dev/null
+++ b/lean_frontend/host/families/system/SystemTest.lean
@@ -0,0 +1,180 @@
+import CerbHostSystem
+open CerbHostSystem
+
+private def require (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+
+private def accepted (r : SystemResult) : IO Unit :=
+  require r.boundaryError.isEmpty r.boundaryError
+
+@[extern "cerb_system_test_enable_worker"]
+private opaque enableTestWorker : BaseIO UInt32
+@[extern "cerb_system_test_temporary_fd"]
+private opaque temporaryFd : BaseIO UInt32
+@[extern "cerb_system_test_close_fd"]
+private opaque invalidateFd : UInt32 → BaseIO UInt32
+@[extern "cerb_system_test_stream_fixture"]
+private opaque streamFixture : UInt32 → BaseIO UInt64
+private def cstring (s : String) : ByteArray := s.toUTF8.push 0
+private def field (r : SystemResult) (i : Nat) : IO UInt64 := do
+  match r.fields[i]? with
+  | some x => return x
+  | none => throw (IO.userError "missing response field")
+
+def main : IO Unit := do
+  let denied ← execute 33 .getpid
+  require (!denied.boundaryError.isEmpty) "uninitialized worker must refuse PID dispatch"
+  let page ← execute 33 .getpagesize
+  accepted page
+  require (page.status.value > 0 && page.nativeErrnoAfter == 33) "pagesize/errno transport"
+  let tty ← execute 33 (.isatty 4294967295)
+  accepted tty
+  require (tty.status.value == 0 && tty.status.error == 9 && tty.nativeErrnoAfter == 9) "isatty EBADF"
+  let badClock ← execute 33 (.clock_gettime 4294966062)
+  accepted badClock
+  require (badClock.status.value == -1 && badClock.status.error == 22 && badClock.fields.isEmpty) "clock EINVAL"
+  let clock ← execute 33 (.clock_gettime 1)
+  accepted clock
+  require (clock.status.value == 0 && clock.fields.size == 2) "clock record"
+  let random ← execute 33 (.arc4random_uniform 1)
+  accepted random
+  require (random.status.value == 0 && random.nativeErrnoAfter == 33) "uniform singleton"
+  let bytes ← execute 33 (.arc4random_buf 64)
+  accepted bytes
+  require (bytes.bytes.size == 64 && bytes.nativeErrnoAfter == 33) "entropy output"
+  let zero ← execute 33 (.arc4random_buf 0)
+  accepted zero
+  require (zero.bytes.size == 0) "empty entropy"
+  let termios := ByteArray.mk (Array.replicate 57 0)
+  let speed ← execute 33 (.cfsetispeed termios 13)
+  accepted speed
+  require (speed.status.value == 0 && speed.bytes.size == 57) "termios update"
+  let readSpeed ← execute 33 (.cfgetispeed speed.bytes)
+  accepted readSpeed
+  require (readSpeed.status.value == 13) "termios speed getter"
+  let malformed ← execute 33 (.cfgetispeed ByteArray.empty)
+  require (!malformed.boundaryError.isEmpty) "malformed termios must not call native API"
+  let mask := ByteArray.mk (Array.replicate 128 165)
+  let empty ← execute 33 (.sigemptyset mask)
+  accepted empty
+  require (empty.status.value == 0 && empty.bytes.size == 128) "signal-set bytes"
+  let added ← execute 33 (.sigaddset empty.bytes 2)
+  accepted added
+  require (added.status.value == 0 && added.bytes.size == 128) "signal-set add"
+  require ((← enableTestWorker) == 1) "dedicated fixture worker initialization"
+  let fd ← temporaryFd
+  require (fd != 4294967295) "temporary descriptor"
+  let stream ← execute 33 (.fdopen fd (cstring "w+"))
+  accepted stream
+  require (stream.status.value == 1 && (← field stream 1) == fd.toUInt64) "fdopen descriptor transfer"
+  let token ← field stream 0
+  let payload := ByteArray.mk #[65, 0, 66, 10]
+  let written ← execute 33 (.fwrite payload 1 4 token)
+  accepted written
+  require ((← field written 0) == 4) "fwrite complete element count"
+  let flushed ← execute 33 (.fflush token)
+  accepted flushed
+  require (flushed.status.value == 0) "fflush"
+  let number ← execute 33 (.fileno token)
+  accepted number
+  require (number.status.value == fd.toNat) "fileno native identity requires driver mapping"
+  let seek ← execute 33 (.fseek token 0 0)
+  accepted seek
+  require (seek.status.value == 0) "fseek"
+  let first ← execute 33 (.fgetc token)
+  accepted first
+  require (first.status.value == 65) "fgetc first byte"
+  let embeddedNull ← execute 33 (.fgetc token)
+  accepted embeddedNull
+  require (embeddedNull.status.value == 0) "fgetc embedded NUL"
+  let eof ← execute 33 (.feof token)
+  let ferr ← execute 33 (.ferror token)
+  accepted eof; accepted ferr
+  require (eof.status.value == 0 && ferr.status.value == 0) "FILE indicators"
+  let rewound ← execute 33 (.rewind token)
+  accepted rewound
+  let put ← execute 33 (.fputc 90 token)
+  accepted put
+  require (put.status.value == 90) "fputc"
+  let text ← execute 33 (.fputs (cstring "line") token)
+  accepted text
+  require (text.status.value >= 0) "fputs"
+  let closed ← execute 33 (.fclose token)
+  accepted closed
+  require (closed.status.value == 0) "fclose"
+  let stale ← execute 33 (.ferror token)
+  require (!stale.boundaryError.isEmpty) "closed FILE token must be consumed"
+  let devnull ← execute 33 (.fopen (cstring "/dev/null") (cstring "w"))
+  accepted devnull
+  require (devnull.status.value == 1) "fopen"
+  let closeNull ← execute 33 (.fclose (← field devnull 0))
+  accepted closeNull
+  require (closeNull.status.value == 0) "fopen close"
+  let fd2 ← temporaryFd
+  require (fd2 != 4294967295) "second temporary descriptor"
+  let stream2 ← execute 33 (.fdopen fd2 (cstring "w+"))
+  accepted stream2
+  let token2 ← field stream2 0
+  require ((← invalidateFd fd2) == 0) "test close underlying descriptor"
+  let failedClose ← execute 33 (.fclose token2)
+  accepted failedClose
+  require (failedClose.status.value == -1 && failedClose.nativeErrnoAfter == 9) "fclose error"
+  let staleAfterFailure ← execute 33 (.feof token2)
+  require (!staleAfterFailure.boundaryError.isEmpty) "failed fclose still consumes FILE"
+  let process ← execute 33 (.popen (cstring "printf transport") (cstring "r"))
+  accepted process
+  require (process.status.value == 1) "popen"
+  let processToken ← field process 0
+  let processByte ← execute 33 (.fgetc processToken)
+  accepted processByte
+  require (processByte.status.value == 116) "popen output"
+  let processExit ← execute 33 (.pclose processToken)
+  accepted processExit
+  require (processExit.status.value == 0) "pclose wait result"
+
+  let binaryToken ← streamFixture 0
+  require (binaryToken != 0) "binary input fixture"
+  let zeroLimit ← execute 33 (.fgets 0 binaryToken)
+  accepted zeroLimit
+  require (zeroLimit.status.value == 0 && zeroLimit.bytes.size == 0 && zeroLimit.nativeErrnoAfter == 33) "fgets zero count"
+  let negativeLimit ← execute 33 (.fgets 4294967295 binaryToken)
+  accepted negativeLimit
+  require (negativeLimit.status.value == 0 && negativeLimit.bytes.size == 0) "fgets negative count"
+  let oneLimit ← execute 33 (.fgets 1 binaryToken)
+  accepted oneLimit
+  require (oneLimit.status.value == 1 && oneLimit.bytes.data == #[0]) "fgets count one exact terminator"
+  let line ← execute 33 (.fgets 64 binaryToken)
+  accepted line
+  require (line.status.value == 1 && line.bytes.data == #[65,0,66,10,0]) "fgets embedded NUL and newline exact prefix"
+  let tail ← execute 33 (.fgets 64 binaryToken)
+  accepted tail
+  require (tail.status.value == 1 && tail.bytes.data == #[67,68,0]) "fgets final unterminated line"
+  let done ← execute 33 (.fgets 64 binaryToken)
+  accepted done
+  require (done.status.value == 0 && done.bytes.size == 0 && (← field done 1) == 1) "fgets EOF leaves destination untouched"
+  accepted (← execute 33 (.fclose binaryToken))
+  let retryToken ← streamFixture 2
+  require (retryToken != 0) "partial EAGAIN fixture"
+  let retry ← execute 33 (.fgets 64 retryToken)
+  accepted retry
+  require (retry.status.value == 1 && retry.bytes.data == #[65,0,66,0] &&
+    retry.nativeErrnoAfter == 11 && (← field retry 2) == 1) "fgets partial EAGAIN retains error and terminates prefix"
+  accepted (← execute 33 (.fclose retryToken))
+  let errorToken ← streamFixture 3
+  require (errorToken != 0) "partial EIO fixture"
+  let failedLine ← execute 33 (.fgets 64 errorToken)
+  accepted failedLine
+  require (failedLine.status.value == 0 && failedLine.bytes.data == #[65,0,66] &&
+    failedLine.nativeErrnoAfter == 5 && (← field failedLine 2) == 1) "fgets partial failure writes prefix without NUL"
+  accepted (← execute 33 (.fclose errorToken))
+  let buffering ← execute 33 (.fopen (cstring "/dev/null") (cstring "w"))
+  accepted buffering
+  let bufferingToken ← field buffering 0
+  let buffered ← execute 33 (.setvbuf bufferingToken 0 4096)
+  accepted buffered
+  require (buffered.status.value == 0 && buffered.nativeErrnoAfter == 33) "setvbuf NULL full buffering"
+  let badMode ← execute 33 (.setvbuf bufferingToken 4294967173 4096)
+  accepted badMode
+  require (badMode.status.value != 0) "setvbuf invalid mode is not invented success"
+  accepted (← execute 33 (.fclose bufferingToken))
+  IO.println "system-ok"
