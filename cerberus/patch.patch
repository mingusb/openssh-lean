+(* This query is compiler knowledge, not a runtime test of an operand's value.
+   None means that propagation or optimization is still needed; it must not be
+   silently changed to the compiler's observable answer zero. Keep discarded
+   branches and operands unevaluated, including during Core translation. *)
+(* Establish positivity without inventing a concrete ABI byte count. A valid
+   ordinary scalar/pointer object occupies storage; aggregates need a member
+   that does. GNU zero-length arrays and zero-width bitfields cannot provide
+   that evidence. The finite by-value tag closure does not follow pointers or
+   flexible array members, and remains conservative for empty aggregates. *)
+val gnu_positive_size_type: list Symbol.sym -> Ctype.ctype -> bool
+let rec gnu_positive_size_type tags (Ctype.Ctype annots ty) =
+  match Annot.get_bitfield annots with
+    | Just (width, _) -> width > 0
+    | Nothing -> match ty with
+        | Ctype.Basic (Ctype.Integer ity) -> maybe false (fun size -> size > 0) (Implementation.sizeof_ity ity)
+        | Ctype.Basic (Ctype.Floating fty) -> maybe false (fun size -> size > 0) (Implementation.sizeof_fty fty)
+        | Ctype.Pointer _ _ -> true
+        | Ctype.Nullptr -> true
+        | Ctype.Byte -> true
+        | Ctype.Array element (Just bound) -> bound > 0 && gnu_positive_size_type tags element
+        | Ctype.Atomic element -> gnu_positive_size_type tags element
+        | Ctype.Struct tag -> List.elem tag tags
+        | Ctype.Union tag -> List.elem tag tags
+        | _ -> false
+      end
+  end
