+  | A.AilEannot _ operand -> gnu_pointer_array_argument_root operand
+  | A.AilEcast _ _ operand ->
+      if AilTypesAux.is_pointer (ctype_of expr) && AilTypesAux.is_pointer (ctype_of operand) &&
+          not (AilTypesAux.is_pointer_to_function (ctype_of expr)) &&
+          not (AilTypesAux.is_pointer_to_function (ctype_of operand))
+      then gnu_pointer_array_argument_root operand else Nothing
+  | _ -> Nothing
+end
+
+val gnu_opaque_pointer_array_load:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)
+let gnu_opaque_pointer_array_load expr = match gnu_pointer_array_load_root expr with
+  | Nothing -> E.return Nothing
+  | Just sym -> E.gnu_memory_has_opaque_root sym >>= fun opaque ->
+      E.return (if opaque then Just E.GNU_inline_unknown_extent_fact else Nothing)
+end
+
+val gnu_loaded_memory_fact:
+  A.expression GenTypes.genTypeCategory -> E.elabM (maybe E.gnu_inline_fact)
+let gnu_loaded_memory_fact expr =
+  gnu_memory_slot_of true expr >>= fun slot ->
+  (match slot with Just slot -> E.gnu_memory_fact slot | Nothing -> E.return Nothing end) >>= function
+    | Just fact -> E.return (Just fact)
+    | Nothing ->
+        gnu_opaque_pointer_array_load expr >>= function
+        | Just fact -> E.return (Just fact)
+        | Nothing ->
+            let pointer_base = match expr with
+              | A.AnnotatedExpression _ _ _ (A.AilEmemberofptr base _) -> Just base
+              | A.AnnotatedExpression _ _ _
+                  (A.AilEmemberof (A.AnnotatedExpression _ _ _
+                    (A.AilEunary A.Indirection base)) _) -> Just base
+              | _ -> Nothing end in
+            if not (AilTypesAux.is_pointer (ctype_of expr)) then E.return Nothing else
+            (match pointer_base with
+              | Nothing -> E.return Nothing
+              | Just base -> gnu_memory_slot_of false base >>= function
+                  | Just (true, root, path) ->
+                      E.gnu_memory_opaque_subobject root path >>= fun opaque ->
+                      if opaque then E.return (Just E.GNU_inline_unknown_extent_fact)
+                      else if path <> [] then E.return Nothing else
+                      (* An explicitly opaque base pointer has no compiler
+                         provenance for an unrecorded pointer member. An
+                         explicit member snapshot was checked above; it still
+                         takes precedence over this unknown result. *)
+                      E.gnu_compiler_fact root >>= fun parent ->
+                      E.return (if parent = Just E.GNU_inline_unknown_value_fact
+                        then Just E.GNU_inline_unknown_value_fact
+                        else if parent = Just E.GNU_inline_unknown_extent_fact
+                        then Just E.GNU_inline_unknown_extent_fact else Nothing)
+                  | _ -> E.return Nothing end
+            end)
+        end
+  end
+
+(* A dereferenced member lvalue and a pointer-member lvalue denote the same member. This
+   view changes only compiler-query analysis; original evaluation is retained. *)
+val gnu_member_pointer_base:
+  A.expression GenTypes.genTypeCategory -> maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_member_pointer_base (A.AnnotatedExpression _ _ _ node as expr) =
+  match node with
+    | A.AilEunary A.Indirection pointer ->
+        (match ctype_of expr with
+          | Ctype.Ctype _ (Ctype.Struct _) -> Just pointer
+          | Ctype.Ctype _ (Ctype.Union _) -> Just pointer
+          | _ -> Nothing end)
+    | A.AilEannot _ operand -> gnu_member_pointer_base operand
+    | _ -> Nothing
+  end
+
+val gnu_size_extent:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  Core.core_tag_definitions -> bool -> bool -> bool -> A.expression GenTypes.genTypeCategory -> E.elabM (maybe (list gnu_object_extent))
+
+val gnu_inline_fixed_object_type: Ctype.ctype -> bool
+let rec gnu_inline_fixed_object_type (Ctype.Ctype _ ty) = match ty with
+  | Ctype.VariableArray _ _ -> false
+  | Ctype.Array element (Just bound) -> bound >= 0 && gnu_inline_fixed_object_type element
+  | Ctype.Array _ Nothing -> false
+  | Ctype.Void -> false
+  | Ctype.Function _ _ _ -> false
+  | Ctype.FunctionNoParams _ -> false
+  | Ctype.Atomic element -> gnu_inline_fixed_object_type element
+  | _ -> true
+end
+
+(* Scalar call metadata may include fixed type queries as well as literals.
+   Keep this separate from pointer-offset provenance: sizeof(expression) is
+   unevaluated for the fixed types accepted here, even if its operand names
+   caller storage or contains an effect. The origin resolver removes that
+   operand before the fact is retained. Unknown array bounds remain excluded. *)
+val gnu_inline_closed_integer_origin: A.expression GenTypes.genTypeCategory -> bool
+let rec gnu_inline_closed_integer_origin (A.AnnotatedExpression _ _ _ expr) =
+  let self = gnu_inline_closed_integer_origin in
+  match expr with
+    | A.AilEconst (A.ConstantInteger _) -> true
+    | A.AilEconst (A.ConstantCharacter _) -> true
+    | A.AilEsizeof _ ty -> gnu_inline_fixed_object_type ty
+    | A.AilEsizeof_expr operand -> gnu_inline_fixed_object_type (ctype_of operand)
+    | A.AilEalignof _ ty -> gnu_inline_fixed_object_type ty
+    | A.AilEoffsetof ty _ -> gnu_inline_fixed_object_type ty
+    | A.AilEannot _ operand -> self operand
+    | A.AilEcast _ _ operand -> self operand
+    | A.AilEunary A.Plus operand -> self operand
+    | A.AilEunary A.Minus operand -> self operand
+    | A.AilEunary A.Bnot operand -> self operand
+    | A.AilEbinary left _ right -> self left && self right
+    | _ -> false
+  end
+
+(* Lifted from gnu_size_extent: is_dynamic is the only captured input.
+   Fresh extent bindings and static-alternative refusal remain unchanged. *)
+(* Collapse a locally captured choice only when both selected representations
+   share their static address/unknownness contract. No C load or allocation
+   inspection is introduced: the selector is the original branch's result. *)
+val gnu_selected_extent_code: E.gnu_inline_fact -> maybe E.gnu_inline_fact
+let rec gnu_selected_extent_code fact = match fact with
+  | E.GNU_inline_extent_fact _ _ _ _ _ -> Just fact
+  | E.GNU_inline_selected_extent_fact selector first second ->
+      (match (gnu_selected_extent_code first, gnu_selected_extent_code second) with
+        | (Just (E.GNU_inline_extent_fact unknown1 late1 address1 code1 _),
+           Just (E.GNU_inline_extent_fact unknown2 late2 address2 code2 _)) ->
+            if unknown1 <> unknown2 || not (E.gnu_extent_same_address address1 address2) then Nothing else
+              Just (E.GNU_inline_extent_fact unknown1 (late1 && late2) address1
+                (Caux.mk_if_e selector code1 code2) [])
+        | _ -> Nothing end)
+  | _ -> Nothing
+end
+
+val gnu_extent_shift:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  bool -> Ctype.ctype -> A.expression GenTypes.genTypeCategory -> bool ->
+  list gnu_object_extent -> E.elabM (maybe (list gnu_object_extent))
+let gnu_extent_shift translate_expr is_dynamic element_ty index subtract infos =
+  if (not is_dynamic && not (gnu_size_constant_offset index)) ||
+      (is_dynamic && List.length infos > 1) then E.return Nothing else
+  let sizeof ty = Caux.mk_sizeof_pe (Caux.mk_ail_ctype_pe ty) in
+E.mapM (fun info ->
+E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun loaded ->
+E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun value ->
+translate_expr index >>= fun core_index ->
+let amount = Caux.mk_op_pe C.OpMul value.E.sym_pe (sizeof element_ty) in
+let amount = if subtract then Caux.mk_op_pe C.OpSub (Caux.mk_integer_pe 0) amount else amount in
+let projection = gnu_extent_array_projection info.address_form in
+let forwarded_projection = gnu_extent_forwarded_projection info.address_form in
+let normalizes = projection || forwarded_projection in
+let displacement = Caux.mk_op_pe C.OpAdd info.normalized_displacement amount in
+let no_shift = Caux.mk_op_pe C.OpEq displacement (Caux.mk_integer_pe 0) in
+let whole_offset = Caux.mk_op_pe C.OpAdd info.whole_offset amount in
+(* forwprop folds the cumulative constant displacement. Retain
+   the original projection when that displacement is zero,
+   including when multiple additions cancel. A formal starts
+   this stage with the address normalized by its caller. *)
+let late_size = if normalizes then
+    Caux.mk_if_pe no_shift info.normalized_origin_size info.whole_size
+  else info.late_member_size in
+let late_offset = if normalizes then
+    Caux.mk_if_pe no_shift info.normalized_origin_offset whole_offset
+  else Caux.mk_op_pe C.OpAdd info.late_member_offset amount in
+let late_unknown = if normalizes then
+    Caux.mk_if_pe no_shift info.normalized_origin_unknown
+      (Caux.mk_boolean_pe info.whole_is_unknown)
+  else info.late_member_is_unknown in
+let wrap result = info.size_wrap (Caux.mk_wseq_e loaded.E.sym_pat core_index
+  (Caux.mk_case_e loaded.E.sym_pe [
+    (Caux.mk_specified_pat value.E.sym_pat, result);
+    (Caux.mk_empty_pat (C.BTy_loaded C.OTy_integer),
+      Caux.mk_pure_e (Caux.mk_error_pe "GNU object-size offset is unspecified" Caux.mk_unit_pe))
+  ])) in
+E.return (<| info with size_wrap= wrap;
+  whole_offset= whole_offset;
+  member_size= if forwarded_projection then late_size else info.member_size;
+  member_offset= if forwarded_projection then late_offset else Caux.mk_op_pe C.OpAdd info.member_offset amount;
+  member_is_unknown= if forwarded_projection then late_unknown else info.member_is_unknown;
+  late_member_size= late_size; late_member_offset= late_offset;
+  late_member_is_unknown= late_unknown; normalized_displacement= displacement;
+  late_member_supported= info.late_member_supported &&
+    (not normalizes || gnu_size_constant_offset index);
+  address_form= E.GNU_extent_offset info.address_form |>)) infos >>=
+  fun results -> E.return (Just results)
+
+(* Object-size query result only. Sharing this leaf does not convert a
+   value-only certificate into metadata for its pointee memory. *)
+val gnu_unknown_object_extent: unit -> gnu_object_extent
+let gnu_unknown_object_extent () = <| size_wrap= (fun e -> e); whole_is_unknown= true; member_is_unknown= Caux.mk_boolean_pe true;
+  late_member_is_unknown= Caux.mk_boolean_pe true; late_member_supported= true; address_form= E.GNU_extent_opaque;
+  whole_size= Caux.mk_integer_pe 0; whole_offset= Caux.mk_integer_pe 0;
+  member_size= Caux.mk_integer_pe 0; member_offset= Caux.mk_integer_pe 0;
+  late_member_size= Caux.mk_integer_pe 0; late_member_offset= Caux.mk_integer_pe 0;
+  normalized_origin_size= Caux.mk_integer_pe 0; normalized_origin_offset= Caux.mk_integer_pe 0;
+  normalized_origin_unknown= Caux.mk_boolean_pe true; normalized_displacement= Caux.mk_integer_pe 0 |>
+
+val gnu_extent_from_fact:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  bool -> bool -> bool -> E.gnu_inline_fact -> E.elabM (maybe (list gnu_object_extent))
+let rec gnu_extent_from_fact translate_expr is_dynamic static_upper is_formal fact =
+  let fact = if is_dynamic then maybe fact (fun selected -> selected) (gnu_selected_extent_code fact) else fact in
+  let alloc_size_extent size_expr =
+    translate_expr size_expr >>= fun size_code ->
+    E.wrapped_fresh_symbol (C.BTy_loaded C.OTy_integer) >>= fun allocation_size ->
+    E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun allocation_size_value ->
+    let zero = Caux.mk_integer_pe 0 in
+    let known = Caux.mk_boolean_pe false in
+    E.return (Just [<| size_wrap= (fun body ->
+        Caux.mk_sseq_e allocation_size.E.sym_pat size_code
+          (Caux.mk_case_e allocation_size.E.sym_pe [
+            (Caux.mk_specified_pat allocation_size_value.E.sym_pat, body);
+            (Caux.mk_empty_pat (C.BTy_loaded C.OTy_integer),
+              Caux.mk_pure_e (Caux.mk_error_pe
+                "GNU alloc_size argument is unspecified" Caux.mk_unit_pe))
+          ]));
+      whole_is_unknown= false; member_is_unknown= known; late_member_is_unknown= known;
+      late_member_supported= true; address_form= E.GNU_extent_local E.GNU_extent_object;
+      whole_size= allocation_size_value.E.sym_pe; whole_offset= zero;
+      member_size= allocation_size_value.E.sym_pe; member_offset= zero;
+      late_member_size= allocation_size_value.E.sym_pe; late_member_offset= zero;
+      normalized_origin_size= allocation_size_value.E.sym_pe; normalized_origin_offset= zero;
+      normalized_origin_unknown= known; normalized_displacement= zero |>]) in
+  match fact with
+          | E.GNU_inline_extent_fact whole_is_unknown late_member_supported address_form extent _ ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun whole_size ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun whole_offset ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun member_size ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun member_offset ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun late_member_size ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun late_member_offset ->
+              E.wrapped_fresh_symbol C.BTy_boolean >>= fun member_unknown ->
+              E.wrapped_fresh_symbol C.BTy_boolean >>= fun late_member_unknown ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun origin_size ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun origin_offset ->
+              E.wrapped_fresh_symbol C.BTy_boolean >>= fun origin_unknown ->
+              E.wrapped_fresh_symbol (C.BTy_object C.OTy_integer) >>= fun displacement ->
+              E.return (Just [<|
+                size_wrap= (fun body -> Caux.mk_wseq_e
+                  (Caux.mk_tuple_pat [whole_size.E.sym_pat; whole_offset.E.sym_pat;
+                    member_size.E.sym_pat; member_offset.E.sym_pat;
+                    late_member_size.E.sym_pat; late_member_offset.E.sym_pat;
+                    member_unknown.E.sym_pat; late_member_unknown.E.sym_pat;
+                    origin_size.E.sym_pat; origin_offset.E.sym_pat; origin_unknown.E.sym_pat;
+                    displacement.E.sym_pat]) extent body);
+                whole_is_unknown= whole_is_unknown;
+                (* An argument carries its normalized address into the callee,
+                   not an early bound from a builtin in the caller. Local
+                   initializer aliases remain in the same early-analysis stage. *)
+                member_is_unknown= if is_formal then late_member_unknown.E.sym_pe else member_unknown.E.sym_pe;
+                late_member_is_unknown= late_member_unknown.E.sym_pe; late_member_supported= late_member_supported;
+                address_form= if is_formal then E.GNU_extent_formal address_form
+                  else E.GNU_extent_local address_form;
+                whole_size= whole_size.E.sym_pe; whole_offset= whole_offset.E.sym_pe;
+                member_size= if is_formal then late_member_size.E.sym_pe else member_size.E.sym_pe;
+                member_offset= if is_formal then late_member_offset.E.sym_pe else member_offset.E.sym_pe;
+                late_member_size= late_member_size.E.sym_pe; late_member_offset= late_member_offset.E.sym_pe;
+                normalized_origin_size= if is_formal then late_member_size.E.sym_pe else origin_size.E.sym_pe;
+                normalized_origin_offset= if is_formal then late_member_offset.E.sym_pe else origin_offset.E.sym_pe;
+                normalized_origin_unknown= if is_formal then late_member_unknown.E.sym_pe else origin_unknown.E.sym_pe;
+                normalized_displacement= if is_formal then Caux.mk_integer_pe 0 else displacement.E.sym_pe
+              |>])
+          | E.GNU_inline_counted_extent_fact upper exact ->
+              (* The first component is only an upper-bound compiler profile.
+                 Use it only for the whole-object upper mode, never generic capture. *)
+              if is_dynamic then
+                gnu_extent_from_fact translate_expr true false is_formal exact
+              else if static_upper then
+                gnu_extent_from_fact translate_expr false false is_formal upper
+              else E.return Nothing
+          | E.GNU_inline_dynamic_bound_fact saved ->
+              if not is_dynamic then E.return Nothing else
+                gnu_extent_from_fact translate_expr true false is_formal saved
+          | E.GNU_inline_alloc_size_fact _ size_expr ->
+              if not is_dynamic then
+                let zero = Caux.mk_integer_pe 0 in
+                E.return (Just [<| size_wrap= (fun body -> body); whole_is_unknown= true;
+                  member_is_unknown= Caux.mk_boolean_pe true; late_member_is_unknown= Caux.mk_boolean_pe true;
+                  late_member_supported= true; address_form= E.GNU_extent_opaque;
+                  whole_size= zero; whole_offset= zero; member_size= zero; member_offset= zero;
+                  late_member_size= zero; late_member_offset= zero;
+                  normalized_origin_size= zero; normalized_origin_offset= zero;
+                  normalized_origin_unknown= Caux.mk_boolean_pe true; normalized_displacement= zero |>])
+              else alloc_size_extent size_expr
+          | E.GNU_inline_constant_alloc_size_fact size_expr -> alloc_size_extent size_expr
+          | E.GNU_inline_offset_extent_fact base index element_ty subtract _ ->
+              (* The offset belongs to the caller's address computation. Apply
+                 that normalization before promoting the completed address to
+                 a formal, using the same implementation as a direct query. *)
+              gnu_extent_from_fact translate_expr is_dynamic false false base >>= function
+                | Nothing -> E.return Nothing
+                | Just infos ->
+                    gnu_extent_shift translate_expr is_dynamic element_ty index subtract infos >>= function
+                      | Nothing -> E.return Nothing
+                      | Just infos ->
+                          E.return (Just (if not is_formal then infos else List.map (fun info ->
+                            <| info with
+                              member_size= info.late_member_size; member_offset= info.late_member_offset;
+                              member_is_unknown= info.late_member_is_unknown;
+                              normalized_origin_size= info.late_member_size;
+                              normalized_origin_offset= info.late_member_offset;
+                              normalized_origin_unknown= info.late_member_is_unknown;
+                              normalized_displacement= Caux.mk_integer_pe 0;
+                              address_form= E.GNU_extent_formal info.address_form |>) infos))
+                    end
+              end
+          | E.GNU_inline_unknown_value_fact ->
+              E.return (Just [gnu_unknown_object_extent ()])
+          | E.GNU_inline_unknown_extent_fact ->
+              E.return (Just [gnu_unknown_object_extent ()])
+          | E.GNU_inline_extent_join_fact alternatives ->
+              if alternatives = [] || is_dynamic then E.return Nothing else
+              E.mapM (gnu_extent_from_fact translate_expr is_dynamic static_upper is_formal) alternatives >>= fun results ->
+              if List.any (function Nothing -> true | Just _ -> false end) results then E.return Nothing else
+                E.return (Just (List.concat (List.map (fun result -> maybe [] (fun values -> values) result) results)))
+          | E.GNU_inline_selected_extent_fact _ first second ->
+              if is_dynamic then E.return Nothing else
+              E.mapM (gnu_extent_from_fact translate_expr false static_upper is_formal) [first; second] >>= fun results ->
+              if List.any (function Nothing -> true | Just _ -> false end) results then E.return Nothing else
+                E.return (Just (List.concat (List.map (fun result -> maybe [] (fun values -> values) result) results)))
+          | E.GNU_inline_runtime_pointer_choice_fact _ stored incoming ->
+              if is_dynamic then E.return Nothing else
+              gnu_extent_from_fact translate_expr false static_upper is_formal
+                (E.GNU_inline_extent_join_fact [stored; incoming])
+          | _ -> E.return Nothing
+end
+
+(* A permanent pointer origin is a value relation, not a snapshot of mutable
+   pointee storage. Loaded pointer objects must be certified unchanged across
+   the whole function; object addresses require no contents to be retained. *)
+val gnu_size_immutable_origin:
+  bool -> A.expression GenTypes.genTypeCategory -> E.elabM bool
+let rec gnu_size_immutable_origin address (A.AnnotatedExpression _ _ _ node as expr) =
+  let self = gnu_size_immutable_origin in
+  let (qs, ty) = qualified_ctype_of expr in
+  if qs.Ctype.volatile || AilTypesAux.is_atomic ty then E.return false else
+  match node with
+    | A.AilEident sym ->
+        if address then E.return (gnu_inline_fixed_object_type ty)
+        else if AilTypesAux.is_pointer ty then E.gnu_branch_subject_allowed sym
+        else E.return false
+    | A.AilEstr _ -> E.return address
+    | A.AilErvalue operand -> if address then E.return false else self false operand
+    | A.AilEannot _ operand -> self address operand
+    | A.AilEcast _ target_ty operand ->
+        if not address && AilTypesAux.is_pointer target_ty && AilTypesAux.is_pointer (ctype_of operand)
+        then self false operand else E.return false
+    | A.AilEarray_decay operand -> if address then E.return false else self true operand
+    | A.AilEunary A.Address operand -> if address then E.return false else self true operand
+    | A.AilEunary A.Indirection operand -> if address then self false operand else E.return false
+    | A.AilEmemberof operand _ -> if address then self true operand else E.return false
+    | A.AilEmemberofptr operand _ -> if address then self false operand else E.return false
+    | A.AilEbinary left (A.Arithmetic A.Add) right ->
+        if address then E.return false else
+        if AilTypesAux.is_pointer (ctype_of left) && gnu_size_literal_offset right then self false left
+        else if AilTypesAux.is_pointer (ctype_of right) && gnu_size_literal_offset left then self false right
+        else E.return false
+    | A.AilEbinary left (A.Arithmetic A.Sub) right ->
+        if not address && AilTypesAux.is_pointer (ctype_of left) && gnu_size_literal_offset right
+        then self false left else E.return false
+    | _ -> E.return false
+  end
+
+val gnu_inline_fact_kind: maybe E.gnu_inline_fact -> string
+let gnu_inline_fact_kind fact = match fact with
+  | Nothing -> "absent"
+  | Just (E.GNU_inline_extent_fact _ _ _ _ _) -> "extent"
+  | Just (E.GNU_inline_alloc_size_fact _ _) -> "alloc-size"
+  | Just (E.GNU_inline_dynamic_bound_fact _) -> "allocation-snapshot"
+  | Just (E.GNU_inline_counted_extent_fact _ _) -> "counted-static-upper/dynamic-exit"
+  | Just (E.GNU_inline_constant_alloc_size_fact _) -> "alloc-size-constant"
+  | Just (E.GNU_inline_offset_extent_fact _ _ _ _ _) -> "offset-extent"
+  | Just E.GNU_inline_unknown_extent_fact -> "unknown-extent"
+  | Just E.GNU_inline_unknown_value_fact -> "unknown-value-only"
+  | Just (E.GNU_inline_extent_join_fact _) -> "extent-join"
+  | Just (E.GNU_inline_selected_extent_fact _ _ _) -> "selected-extent"
+  | Just (E.GNU_inline_runtime_pointer_choice_fact _ _ _) -> "runtime-pointer-choice"
+  | Just (E.GNU_inline_integer_fact _) -> "integer"
+  | Just (E.GNU_inline_integer_range_fact _ _ _) -> "integer-range"
+  | Just (E.GNU_inline_integer_progression_fact _ _ _) -> "integer-progression"
+  | Just (E.GNU_inline_function_fact _ _) -> "function-target"
+end
+
+(* Capturing member snapshots packages an already opaque base in a rich
+   extent fact. Its positive whole-object unknownness is unchanged. This
+   predicate is only one condition of a storage-clobber certificate: callers
+   still require the typed ordinary-parameter catalog and an actual opaque
+   call. Missing facts, known allocations and joined alternatives do not qualify. *)
+val gnu_inline_opaque_base: maybe E.gnu_inline_fact -> bool
+let gnu_inline_opaque_base fact = match fact with
+  | Just E.GNU_inline_unknown_extent_fact -> true
+  | Just (E.GNU_inline_extent_fact true _ _ _ _) -> true
+  | _ -> false
+end
+
+(* Whole-object unknownness alone does not establish an opaque pointer value:
+   an address of an array member can still have a known closest-object bound.
