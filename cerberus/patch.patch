+  | [] -> V.gnuva_return output
+  | F.F_text text :: rest ->
+      gnuvformat_render loc eval_conv fetch_arg destination format_pointer flag (output ++ text) rest
+  | F.F_conv cp :: rest ->
+      gnuvformat_resolve_stars loc fetch_arg cp >>= fun cp ->
+      (match cp.F.cp_conversion_specifier with
+        | F.CS_percent -> V.gnuva_return [#'%']
