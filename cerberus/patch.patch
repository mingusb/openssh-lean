+val translate_gnu_object_size:
+  (A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)) ->
+  Core.core_tag_definitions -> bool -> integer -> A.expression GenTypes.genTypeCategory -> E.elabM (C.expr unit)
+let translate_gnu_object_size translate_expr tagDefs is_dynamic mode pointer =
+  let unknown_size = if mode >= 2 then Caux.mk_integer_pe 0
+    else Caux.mk_ivmax_pe (Caux.mk_ail_ctype_pe Ctype.size_t) in
+  let refuse message =
+    E.record_error_at (Loc.locOf pointer) message >>
+    E.return (Caux.mk_pure_e (Caux.mk_error_pe message Caux.mk_unit_pe)) in
+  E.get_gnu_unoptimized_parameters >>= fun unoptimized ->
+  if isJust unoptimized then refuse "GNU optimize(O0) object-size profile is not yet implemented" else
+  match gnu_size_effects pointer with
+    | Just true -> E.return (Caux.mk_pure_e (Caux.mk_specified_pe unknown_size))
+    | Nothing -> refuse "GNU object-size operand effect analysis is not yet implemented for this expression"
+    | Just false ->
+        gnu_size_extent translate_expr tagDefs is_dynamic (not is_dynamic && mode = 0) false pointer >>= function
+          | Nothing ->
+              E.gnu_memory_snapshot >>= fun (facts, roots, aliases) ->
+              let () = Debug.print_debug_located 2 [Debug.DB_elaboration] (Loc.locOf pointer) (fun () ->
+                "GNU missing extent: " ^ Pp.stringFromAil_expression pointer ^
+                "; slots=" ^ show (List.length facts) ^ "; opaque roots=" ^ show (List.length roots) ^
+                "; aliases=" ^ show (List.length aliases) ^
+                "; facts=[" ^ stringFromList (fun ((indirect, sym, path), fact) ->
+                  (if indirect then "indirect " else "direct ") ^ show sym ^ "/" ^
+                    show path ^ "=" ^ gnu_inline_fact_kind (Just fact)) facts ^ "]") in
+              (* Failure-only context: the queued specialization already
+                 records its source ancestry and entry facts. Inspect them
+                 without changing analysis, fresh supply, or emitted effects.
+                 Do not enable the per-expression Debug2 trace to find a caller. *)
+              (fun st -> ((st.E.gnu_inline_active, Map_extra.toList st.E.gnu_inline_facts), st)) >>=
+                fun (ancestors, entry_facts) ->
+              let subject = match pointer with
+                | A.AnnotatedExpression _ _ _ (A.AilEident sym) -> Just sym
+                | A.AnnotatedExpression _ _ _
+                    (A.AilErvalue (A.AnnotatedExpression _ _ _ (A.AilEident sym))) -> Just sym
+                | _ -> Nothing end in
+              (match subject with
+                | Just sym -> E.gnu_compiler_fact sym >>= fun fact ->
+                    E.return (gnu_inline_fact_kind fact)
+                | Nothing -> E.return "non-identifier operand" end) >>= fun pointer_fact ->
+              E.current_gnu_inline_call_sites >>= fun call_sites ->
+              refuse ("GNU object-size compiler pointer-flow analysis is not yet implemented for this expression" ^
+                " [query=" ^ (if is_dynamic then "dynamic" else "static") ^ "; mode=" ^ show mode ^
+                "; operand=" ^ Pp.stringFromAil_expression pointer ^
+                "; specialization ancestry=" ^ show ancestors ^ "; pointer fact=" ^ pointer_fact ^
+                "; entry facts=" ^ stringFromList
+                  (fun (sym, fact) -> show sym ^ ":" ^ gnu_inline_fact_kind (Just fact)) entry_facts ^
+                "; memory slots=" ^ show (List.length facts) ^
+                "; opaque roots=" ^ show (List.length roots) ^
+                "; aliases=" ^ show (List.length aliases) ^
+                "; caller capture sites=" ^ stringFromList (fun site -> site) call_sites ^ "]")
+          | Just infos ->
+              let remaining unknown size offset =
+                let zero = Caux.mk_integer_pe 0 in
+                Caux.mk_if_pe unknown unknown_size
+                  (Caux.mk_if_pe (Caux.mk_op_pe C.OpLt offset zero) zero
+                    (Caux.mk_if_pe (Caux.mk_op_pe C.OpLe size offset) zero (Caux.mk_op_pe C.OpSub size offset))) in
+              if List.length infos = 0 then refuse "GNU object-size empty extent join" else
+              if is_dynamic && List.length infos > 1 then
+                refuse "GNU dynamic object-size path-dependent extent join is not yet implemented" else
+              if (mode = 1 || mode = 3) && List.any (fun info -> not info.late_member_supported) infos then
