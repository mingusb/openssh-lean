+(* This internal marker preserves type-origin information for GNU mode/layout
+   checks. It does not express a function optimization contract. Keep it on
+   declarations and types; function-profile admission alone may disregard it. *)
+val is_typeof_expr_origin: attribute -> bool
+let is_typeof_expr_origin attr =
+  match (attr.attr_ns, attr.attr_id, attr.attr_args) with
+    | (Just (Symbol.Identifier _ "cerb"), Symbol.Identifier _ "typeof-expr-origin", []) -> true
+    | _ -> false
+  end
+
+val is_gnu_asm_label: attribute -> bool
+let is_gnu_asm_label attr =
+  match (attr.attr_ns, attr.attr_id) with
+    | (Just (Symbol.Identifier _ "gnu"), Symbol.Identifier _ "asm-label") -> true
+    | _ -> false
+  end
+
+(* The parser retains literal fragments. Admit plain ELF symbol spellings;
+   escaped/quoted assembler expressions require their own decoding rule. *)
+val decode_gnu_asm_label: attribute -> maybe Symbol.identifier
+let decode_gnu_asm_label attr =
+  if not (is_gnu_asm_label attr) then Nothing
+  else match attr.attr_args with
+    | [(loc, text, fragments)] ->
+        let initial = String.toCharList "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_.$" in
+        let remaining = initial ++ String.toCharList "0123456789" in
+        if fragments = [] || text <> String.concat "" (List.map snd fragments) then Nothing
+        else match String.toCharList text with
+          | first :: rest ->
+              if List.elem first initial && List.all (fun c -> List.elem c remaining) rest then
+                Just (Symbol.Identifier loc text)
+              else Nothing
+          | [] -> Nothing
+        end
+    | _ -> Nothing
+  end
+
+val asm_labels: attributes -> list Symbol.identifier
+let asm_labels (Attrs attrs) =
+  List.foldr (fun attr acc -> match decode_gnu_asm_label attr with
+    | Just name -> name :: acc
+    | Nothing -> acc
+    end) [] attrs
+
+val is_gnu_named_attribute: string -> attribute -> bool
+let is_gnu_named_attribute expected attr =
+  match (attr.attr_ns, attr.attr_id) with
+    | (Just (Symbol.Identifier _ "gnu"), Symbol.Identifier _ name) ->
+        name = expected || name = "__" ^ expected ^ "__"
+    | _ -> false
+  end
+
+val has_gnu_noarg_attribute: string -> attributes -> bool
+let has_gnu_noarg_attribute expected (Attrs attrs) =
+  List.any (fun attr -> is_gnu_named_attribute expected attr && attr.attr_args = []) attrs
+
+(* Only this exact optimization profile is currently modeled. Other option
+   strings and combinations remain explicit frontend refusals. *)
+val is_gnu_optimize_o0: attribute -> bool
+let is_gnu_optimize_o0 attr =
+  is_gnu_named_attribute "optimize" attr &&
+  match attr.attr_args with
+    | [(_, "O0", fragments)] ->
+        fragments <> [] && String.concat "" (List.map snd fragments) = "O0"
+    | _ -> false
+  end
+
+val has_gnu_optimize_o0: attributes -> bool
+let has_gnu_optimize_o0 (Attrs attrs) = List.any is_gnu_optimize_o0 attrs
+
+val type_attributes: Ctype.ctype -> attributes
+let type_attributes (Ctype.Ctype annots _) =
+  List.foldl (fun acc annot ->
+    match annot with
+      | Aattrs attrs -> combine_attributes acc attrs
+      | _ -> acc
+    end
+  ) no_attributes annots
+
+val gnu_integer_strip_suffix: list char -> list char
+let rec gnu_integer_strip_suffix reversed =
+  match reversed with
+    | c :: rest ->
+        if List.elem c (String.toCharList "uUlL") then gnu_integer_strip_suffix rest
+        else reversed
+    | [] -> []
+  end
