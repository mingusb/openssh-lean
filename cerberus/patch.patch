+    let fsOpen ← take (prepare enums tags resolve [45] 0 base fsRequest absentResult.memory)
+    ensure (fsOpen.inputFootprints.length == 1)
+      "already-copied path must not fabricate a second modeled path read"
+    let fsNative ← executeNative fsOpen
+    if fsNative.status.value >= 0 then remember fsNative.status.value.toNat.toUInt32
+    let fsOpened ← take (complete enums tags fsOpen fsNative)
+    let fsFD := fsNative.status.value.toNat.toUInt32
+    ensure (fsOpened.returnValue == 45 && fsOpened.descriptorTransfers == [(45,fsFD)])
+      "FS_OPEN must transfer the returned descriptor into the reserved guest identity"
