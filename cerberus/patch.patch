+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | Ewseq pat e f =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | Esseq pat e f =>
+        simp only [Immediate] at h
+        rcases h with rfl | rfl
+        · simp [measure] <;> omega
+        · simp [measure] <;> omega
+      | Ebound e =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | Eindivisible label e =>
+        simp only [Immediate] at h
+        rcases h with rfl
+        simp [measure] <;> omega
+      | End xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | Esave label xs e =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩ | rfl
+        · rcases entry with ⟨key, metadata, value⟩
+          have hsize := List.sizeOf_lt_of_mem hmem
+          simp_all [measure] <;> omega
+        · simp [measure] <;> omega
+      | Erun unit label xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | Epar xs =>
+        simp only [Immediate] at h
+        rcases h with ⟨entry, hmem, rfl⟩
+        have hsize := List.sizeOf_lt_of_mem hmem
+        simp_all [measure] <;> omega
+      | Ewait tid =>
