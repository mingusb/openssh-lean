+  maybe (A.expression GenTypes.genTypeCategory)
+let rec gnu_constant_p_dynamic_pointer tagDefs (A.AnnotatedExpression _ _ _ node as expr) =
+  let keep operand = if gnu_scalar_implementation_type_equal (ctype_of expr) (ctype_of operand)
+    then gnu_constant_p_dynamic_pointer tagDefs operand else Nothing in
+  match node with
