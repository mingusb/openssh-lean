+(* AIL keeps source argument types until the real call conversion. Arithmetic
+   conversion transports only an arithmetic origin, never a range or exact
+   value. Outer const addition preserves pointer layout. Deeper qualifiers,
+   annotations, volatile/atomic objects and pointer-number conversions remain
+   outside this relation; global ABI/type equality is unchanged. *)
+val gnu_origin_argument_compatible: Ctype.ctype -> Ctype.ctype -> bool
+let gnu_origin_argument_compatible formal actual =
+  gnu_function_target_type_equal formal actual ||
+    (AilTypesAux.is_arithmetic formal && AilTypesAux.is_arithmetic actual &&
+      not (AilTypesAux.is_atomic formal || AilTypesAux.is_atomic actual)) ||
+    match (formal, actual) with
+    | (Ctype.Ctype formal_annotations (Ctype.Pointer formal_qs formal_ty),
+       Ctype.Ctype actual_annotations (Ctype.Pointer actual_qs actual_ty)) ->
+        formal_qs.Ctype.const && not actual_qs.Ctype.const &&
+        not formal_qs.Ctype.volatile && not actual_qs.Ctype.volatile &&
+        formal_qs.Ctype.restrict = actual_qs.Ctype.restrict &&
+        not (AilTypesAux.is_atomic formal_ty || AilTypesAux.is_atomic actual_ty) &&
+        not (AilTypesAux.is_function formal_ty || AilTypesAux.is_function actual_ty) &&
+        gnu_function_target_annotations formal_annotations =
+          gnu_function_target_annotations actual_annotations &&
+        gnu_function_target_type_equal formal_ty actual_ty
+    | _ -> false
+  end
