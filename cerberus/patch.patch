+(* The fortified stream builtin receives parameter objects, not a glibc FILE
+   layout. Its first temporary has the selected runtime's FILE pointer type;
+   reading that pointer and the runtime object's fd member uses checked memory
+   operations and records their footprints. *)
+val gnufprintf_parameters: Loc.t -> Core.core_tag_definitions ->
+  Mem.pointer_value -> Mem.pointer_value -> Mem.pointer_value ->
+  V.gnuva_runtimeM (integer * integer * Mem.pointer_value)
+let gnufprintf_parameters loc tags stream_slot flag_slot fmt_slot =
+  V.gnuva_load_call_parameter loc stream_slot >>= fun (stream_ty, stream_value) ->
+  V.gnuva_concrete_pointer stream_value >>= fun stream ->
+  (match stream_ty with
+    | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Struct source_tag))) ->
+        if Symbol.symbol_description source_tag <> Symbol.SD_Id "_IO_FILE" then
+          gnuvformat_refuse "fortified stream parameter is not FILE*"
+        else
+          let candidates = List.foldr (fun (tag, (_, definition)) acc ->
+            match (Symbol.symbol_description tag, definition) with
+              | (Symbol.SD_Id "_IO_FILE", Ctype.StructDef _ members _) ->
+                  let fd_fields = List.filter (fun (member, (_, _, _, member_ty)) ->
+                    match member with
+                      | Symbol.Identifier _ "fd" -> member_ty = Ctype.signed_int
+                      | _ -> false end) members in
+                  (match fd_fields with
+                    | [(member, _)] ->
+                        (match Mem_aux.integerFromIntegerValue (Mem.offsetof_ival tags tag member) with
+                          | Just offset -> (tag, member, offset) :: acc
+                          | Nothing -> acc end)
+                    | _ -> acc end)
+              | _ -> acc
+            end) [] (Map_extra.toList tags) in
+          match candidates with
+            | [] -> gnuvformat_refuse "runtime FILE descriptor layout is unavailable"
+            | (runtime_tag, member, offset) :: rest ->
+                if not (List.all (fun (_, _, other_offset) -> other_offset = offset) rest) then
+                  gnuvformat_refuse "runtime FILE descriptor layouts disagree"
+                else
+                  V.gnuva_lift (Mem.eff_member_shift_ptrval loc stream runtime_tag member) >>= fun fd_slot ->
+                  V.gnuva_load_value loc Ctype.signed_int fd_slot >>= fun fd_value ->
+                  V.gnuva_concrete_integer fd_value
+          end
+    | _ -> gnuvformat_refuse "fortified stream parameter is not FILE*"
+  end) >>= fun fd ->
+  gnuvformat_parameter_integer loc flag_slot >>= fun flag ->
+  gnuvformat_parameter_pointer loc fmt_slot >>= fun fmt ->
+  V.gnuva_return (fd, flag, fmt)
+
+(* All entry points load format and va_list parameters last, after their own
+   fixed arguments and checks. Keeping this tail shared preserves that order. *)
+let gnuvformat_parameter_tail loc destination fd flag fmt ap =
+  gnuvformat_parameter_pointer loc fmt >>= fun format_pointer ->
+  gnuvformat_parameter_pointer loc ap >>= fun argument_list ->
+  V.gnuva_return (destination, fd, flag, format_pointer, argument_list)
+
+val gnuvformat_parameters: Loc.t -> integer -> list Mem.pointer_value ->
+  V.gnuva_runtimeM (maybe (Mem.pointer_value * integer * integer * bool) *
+    integer * integer * Mem.pointer_value * Mem.pointer_value)
+let gnuvformat_parameters loc kind slots =
+  let malformed = "physical v* adapter has malformed fixed parameter objects" in
+  if kind < 0 then gnuvformat_refuse malformed else
+  match (natFromInteger kind, slots) with
+    | (0, [dst; flag; capacity; fmt; ap]) ->
+        gnuvformat_parameter_pointer loc dst >>= fun destination ->
+        gnuvformat_parameter_integer loc flag >>= fun flag ->
+        gnuvformat_parameter_integer loc capacity >>= fun capacity ->
+        gnuvformat_parameter_tail loc (Just (destination, 0, capacity, true)) 1 flag fmt ap
+    | (1, [dst; n; flag; capacity; fmt; ap]) ->
+        gnuvformat_parameter_pointer loc dst >>= fun destination ->
+        gnuvformat_parameter_integer loc n >>= fun size ->
+        gnuvformat_parameter_integer loc flag >>= fun flag ->
+        gnuvformat_parameter_integer loc capacity >>= fun capacity ->
+        gnuvformat_parameter_tail loc (Just (destination, size, capacity, false)) 1 flag fmt ap
+    | (2, [flag; fmt; ap]) ->
+        gnuvformat_parameter_integer loc flag >>= fun flag ->
+        gnuvformat_parameter_tail loc Nothing 1 flag fmt ap
+    | (3, [dst; n; fmt; ap]) ->
+        gnuvformat_parameter_pointer loc dst >>= fun destination ->
+        gnuvformat_parameter_integer loc n >>= fun size ->
+        gnuvformat_parameter_tail loc (Just (destination, size, 18446744073709551615, false)) 1 0 fmt ap
+    | (4, [fd; fmt; ap]) ->
+        gnuvformat_parameter_integer loc fd >>= fun fd ->
+        if fd <> 1 && fd <> 2 then gnuvformat_refuse "GNU AMD64 libc FILE descriptor output is not yet implemented"
+        else gnuvformat_parameter_tail loc Nothing fd 0 fmt ap
+    | _ -> gnuvformat_refuse malformed
+  end
