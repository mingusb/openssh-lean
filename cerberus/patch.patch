@@ -0,0 +1,33 @@
+import CerbFastLocation
+
+namespace FastLocationTest
+private def ensure (ok : Bool) (message : String) : IO Unit :=
+  unless ok do throw (IO.userError message)
+
+@[noinline] def run : IO Unit := do
+  let mut cases := 0
+  for location in [CerbLocation.Loc.unknown, .other "runtime/libcore/x", .regions [] .noCursor] do
+    ensure (CerbFastLocation.isLibraryLocation location == CerbLocation.isLibraryLocation location)
+      "non-file location changed classification"
+    cases := cases + 1
+  let components := ["", ".", "..", "ed25519.c", "ordinary.c", "普通.c", "<internal>",
+    "runtime", "runtime/libcore", "runtime/libcore/impls", "runtime/libc/include",
+    "notruntime/libcore", "runtime/libcore-extra", "runtime/libcore/impls/subdir",
+    "some\\windows\\path.c"]
+  for pathPrefix in ["", "/", "//", "./", "../", "/prefix/", "relative/", "prefix//"] do
+    for component in components do
+      for suffix in ["", "/", "//", "/x", "/x/", "/file.c", "/../file.c"] do
+        let path := pathPrefix ++ component ++ suffix
+        let start : CerbLocation.Pos := ⟨path,1,1⟩
+        let stop : CerbLocation.Pos := ⟨"unrelated.c",9,10⟩
+        for location in [CerbLocation.Loc.point start, .region start stop .noCursor,
+            .regions [(start,stop)] (.pointCursor stop)] do
+          ensure (CerbFastLocation.isLibraryLocation location == CerbLocation.isLibraryLocation location)
+            s!"location classification changed: {path}"
+          cases := cases + 1
+  ensure (CerbFastLocation.isLibraryLocation (.point ⟨"runtime/libcore/impls/x.core",1,1⟩))
+    "runtime location lost its library classification"
+  ensure (!CerbFastLocation.isLibraryLocation (.point ⟨"ed25519.c",1,1⟩))
+    "application filename became a library location"
+  IO.println s!"Shared location fast path: {cases} reference comparisons passed"
+end FastLocationTest
