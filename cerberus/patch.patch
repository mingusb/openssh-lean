+(* Scan executable payloads, including labels, atomic actions and excluded
+   actions. Deferred template declarations have no executable bodies; every
+   executable use must instead refer to a generated definition or the external
+   source function. This is reference closure, not Core type checking. *)
+val gnu_inline_reference_free_pexpr: list Symbol.sym -> C.pexpr -> bool
+let rec gnu_inline_reference_free_pexpr templates (C.Pexpr _ _ node) =
+  let self = gnu_inline_reference_free_pexpr templates in
+  let name_free = function
+    | C.Sym sym -> not (List.any (fun target -> target = sym) templates)
+    | C.Impl _ -> true
+  end in
+  match node with
+    | C.PEsym sym -> name_free (C.Sym sym)
+    | C.PEimpl _ -> true
+    | C.PEval _ -> true
+    | C.PEundef _ _ -> true
+    | C.PEconstrained cases -> List.all (fun (_, pe) -> self pe) cases
+    | C.PEerror _ pe -> self pe
+    | C.PEctor _ pes -> List.all self pes
+    | C.PEcase pe cases -> self pe && List.all (fun (_, value) -> self value) cases
+    | C.PEarray_shift left _ right -> self left && self right
+    | C.PEmember_shift pe _ _ -> self pe
+    | C.PEmemop _ pes -> List.all self pes
+    | C.PEnot pe -> self pe
+    | C.PEop _ left right -> self left && self right
+    | C.PEconv_int _ pe -> self pe
+    | C.PEwrapI _ _ left right -> self left && self right
+    | C.PEcatch_exceptional_condition _ _ left right -> self left && self right
+    | C.PEstruct _ members -> List.all (fun (_, value) -> self value) members
+    | C.PEunion _ _ pe -> self pe
+    | C.PEcfunction pe -> self pe
+    | C.PEmemberof _ _ pe -> self pe
+    | C.PEcall name pes -> name_free name && List.all self pes
+    | C.PElet _ value body -> self value && self body
+    | C.PEif test yes no -> self test && self yes && self no
+    | C.PEis_scalar pe -> self pe
+    | C.PEis_integer pe -> self pe
+    | C.PEis_signed pe -> self pe
+    | C.PEis_unsigned pe -> self pe
+    | C.PEbmc_assume pe -> self pe
+    | C.PEare_compatible left right -> self left && self right
+    | C.PEare_compatible_parameter left right -> self left && self right
+  end
+
+val gnu_inline_reference_free_action: list Symbol.sym -> C.action unit -> bool
+let gnu_inline_reference_free_action templates (C.Action _ _ node) =
+  let self = gnu_inline_reference_free_pexpr templates in
+  match node with
+    | C.Create a b _ -> self a && self b
+    | C.CreateReadOnly a b c _ -> self a && self b && self c
+    | C.Alloc a b _ -> self a && self b
+    | C.Kill _ pe -> self pe
+    | C.Store _ a b c _ -> self a && self b && self c
+    | C.Load a b _ -> self a && self b
+    | C.SeqRMW _ a b _ c -> self a && self b && self c
+    | C.RMW a b c d _ _ -> List.all self [a; b; c; d]
+    | C.Fence _ -> true
+    | C.CompareExchangeStrong a b c d _ _ -> List.all self [a; b; c; d]
+    | C.CompareExchangeWeak a b c d _ _ -> List.all self [a; b; c; d]
+    | C.LinuxFence _ -> true
+    | C.LinuxLoad a b _ -> self a && self b
+    | C.LinuxStore a b c _ -> self a && self b && self c
+    | C.LinuxRMW a b c _ -> self a && self b && self c
+  end
+
+val gnu_inline_reference_free_expr: list Symbol.sym -> C.expr unit -> bool
+let rec gnu_inline_reference_free_expr templates (C.Expr _ node) =
+  let self = gnu_inline_reference_free_expr templates in
+  let pure = gnu_inline_reference_free_pexpr templates in
+  match node with
+    | C.Epure pe -> pure pe
+    | C.Ememop _ pes -> List.all pure pes
+    | C.Eaction (C.Paction _ action) -> gnu_inline_reference_free_action templates action
+    | C.Ecase pe cases -> pure pe && List.all (fun (_, body) -> self body) cases
+    | C.Elet _ pe body -> pure pe && self body
+    | C.Eif pe yes no -> pure pe && self yes && self no
+    | C.Eccall _ ty target args -> pure ty && pure target && List.all pure args
+    | C.Eproc _ name args ->
+        (match name with
+          | C.Sym sym -> not (List.any (fun target -> target = sym) templates)
+          | C.Impl _ -> true
+        end) && List.all pure args
+    | C.Eunseq bodies -> List.all self bodies
+    | C.Ewseq _ left right -> self left && self right
+    | C.Esseq _ left right -> self left && self right
+    | C.Ebound body -> self body
+    | C.Eindivisible _ body -> self body
+    | C.End bodies -> List.all self bodies
+    | C.Esave _ arguments body ->
+        List.all (fun (_, (_, value)) -> pure value) arguments && self body
+    | C.Erun _ _ args -> List.all pure args
+    | C.Epar bodies -> List.all self bodies
+    | C.Ewait _ -> true
+    | C.Eannot _ body -> self body
+    | C.Eexcluded _ action -> gnu_inline_reference_free_action templates action
+  end
+
+let gnu_inline_references_clear sources globs cfuns =
+  let clear_globs = List.all (fun (_, glob) -> match glob with
+    | C.GlobalDecl _ -> true
+    | C.GlobalDef _ body -> gnu_inline_reference_free_expr sources body
+  end) globs in
+  let clear_funs = Map_extra.fold (fun _ decl acc -> acc && match decl with
+    | C.Proc _ _ _ _ body -> gnu_inline_reference_free_expr sources body
+    | C.Fun _ _ body -> gnu_inline_reference_free_pexpr sources body
+    | C.ProcDecl _ _ _ -> true
+    | C.BuiltinDecl _ _ _ -> true
+  end) cfuns true in
+  clear_globs && clear_funs
+
+let validate_gnu_inline_references templates globs cfuns =
+  let sources = Map_extra.fold (fun sym _ acc -> sym :: acc) templates [] in
+  if gnu_inline_references_clear sources globs cfuns then E.return () else
+    let bad_funs = Map_extra.fold (fun sym decl acc ->
+      let clear = match decl with
+        | C.Proc _ _ _ _ body -> gnu_inline_reference_free_expr sources body
+        | C.Fun _ _ body -> gnu_inline_reference_free_pexpr sources body
+        | C.ProcDecl _ _ _ -> true
+        | C.BuiltinDecl _ _ _ -> true
+      end in
+      if clear then acc else show sym :: acc
+    ) cfuns [] in
+    E.record_error_at Loc.unknown
+      ("GNU inline specialization left an executable reference to a deferred template; functions: " ^
+        stringFromList (fun name -> name) bad_funs)
+
