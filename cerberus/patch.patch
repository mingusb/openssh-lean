+val gnu_record_body_parts:
+  A.statement GenTypes.genTypeCategory ->
+  maybe (list (Symbol.sym * Ctype.ctype) * list (A.statement GenTypes.genTypeCategory))
+let rec gnu_record_body_parts stmt = match stmt.A.node with
+  | A.AilSblock bindings statements ->
+      if not (List.all (function
+        | (_, ((_, A.Automatic, _), _, qs, ty)) ->
+            not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && gnu_inline_fixed_object_type ty
+        | _ -> false end) bindings) then Nothing else
+      List.foldl (fun acc child -> match (acc, gnu_record_body_parts child) with
+        | (Just (locals, first), Just (inner, rest)) -> Just (locals ++ inner, first ++ rest)
+        | _ -> Nothing end)
+        (Just (List.map (fun (sym, (_, _, _, ty)) -> (sym, ty)) bindings, [])) statements
+  | A.AilSmarker _ body -> gnu_record_body_parts body
+  | A.AilSskip -> Just ([], [])
+  | _ -> Just ([], [stmt])
+end
