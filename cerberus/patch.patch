+type collect_visibles_state = <|
+  visible_syms: list (Symbol.sym * Ctype.ctype);
+  label_visibles_: map Symbol.sym (list (Symbol.sym * Ctype.ctype));
+|>
+
+val collect_visibles_expr: A.expression GenTypes.genTypeCategory -> St.stateM unit collect_visibles_state
+val collect_visibles_: A.statement GenTypes.genTypeCategory -> St.stateM unit collect_visibles_state
+let rec collect_visibles_expr (A.AnnotatedExpression _ _ _ node) =
+  let self = collect_visibles_expr in
+  let self_optional = function
+    | Just expression -> self expression
+    | Nothing -> St.return ()
+  end in
+  let self_association = function
+    | A.AilGAtype _ _ expression -> self expression
+    | A.AilGAdefault expression -> self expression
+  end in
+  match node with
+    | A.AilEunary _ expression -> self expression
+    | A.AilEbinary left _ right -> self left >> self right
+    | A.AilEassign left right -> self left >> self right
+    | A.AilEcompoundAssign left _ right -> self left >> self right
+    | A.AilEcond condition middle last ->
+        self condition >> self_optional middle >> self last
+    | A.AilEcast _ _ expression -> self expression
+    | A.AilEcall callee arguments -> self callee >> St.mapM_ self arguments
+    | A.AilEassert expression -> self expression
+    | A.AilEgeneric expression _ associations ->
+        self expression >> St.mapM_ self_association associations
+    | A.AilEarray _ _ elements -> St.mapM_ self_optional elements
+    | A.AilEstruct _ members ->
+        St.mapM_ (fun (_, expression) -> self_optional expression) members
+    | A.AilEunion _ _ expression -> self_optional expression
+    | A.AilEcompound _ _ expression -> self expression
+    | A.AilEmemberof expression _ -> self expression
+    | A.AilEmemberofptr expression _ -> self expression
+    | A.AilEsizeof_expr expression -> self expression
+    | A.AilEannot _ expression -> self expression
+    | A.AilEva_start expression _ -> self expression
+    | A.AilEva_arg expression _ -> self expression
+    | A.AilEva_copy left right -> self left >> self right
+    | A.AilEva_end expression -> self expression
+    | A.AilEprint_type expression -> self expression
+    | A.AilEbmc_assume expression -> self expression
+    | A.AilErvalue expression -> self expression
+    | A.AilEarray_decay expression -> self expression
+    | A.AilEfunction_decay expression -> self expression
+    | A.AilEatomic expression -> self expression
+    | A.AilEgcc_statement binds statements ->
+        St.get >>= fun st ->
+        let saved_syms = st.visible_syms in
+        St.update (fun st ->
+          <| st with visible_syms= List.map (fun (sym, (_, _, _, ty)) -> (sym,ty)) binds ++ st.visible_syms |>
+        ) >>
+        St.mapM_ collect_visibles_ statements >>
+        St.update (fun st -> <| st with visible_syms= saved_syms |>)
+    | _ -> St.return ()
+  end
+and collect_visibles_ stmt =
+  match stmt.A.node with
+    | A.AilSskip ->
+        St.return ()
+    | A.AilSexpr expression ->
+        collect_visibles_expr expression
+    | A.AilSvla_scope _ captures _ body ->
+        St.mapM_ (fun (_, expression) -> collect_visibles_expr expression) captures >>
+        collect_visibles_ body
+    | A.AilSblock binds ss ->
+        St.get >>= fun st ->
+        let saved_syms = st.visible_syms in
+        St.update (fun st ->
+          <| st with visible_syms= List.map (fun (sym, (_, _, _, ty)) -> (sym ,ty)) binds ++ st.visible_syms |>
+        ) >>
+        St.mapM_ collect_visibles_ ss >>
+        St.update (fun st ->
+          <| st with visible_syms= saved_syms |>
+        )
+    | A.AilSif condition s1 s2 ->
+        collect_visibles_expr condition >> collect_visibles_ s1 >> collect_visibles_ s2
+    | A.AilSwhile condition s _ ->
+        collect_visibles_expr condition >> collect_visibles_ s
+    | A.AilSdo s condition _ ->
+        collect_visibles_ s >> collect_visibles_expr condition
+    | A.AilSbreak ->
+        St.return ()
+    | A.AilScontinue ->
+        St.return ()
+    | A.AilSreturnVoid ->
+        St.return ()
+    | A.AilSreturn expression ->
+        collect_visibles_expr expression
+    | A.AilSswitch expression s ->
+        collect_visibles_expr expression >> collect_visibles_ s
+    | A.AilScase _ s ->
+        collect_visibles_ s
+    | A.AilScase_rangeGNU _ _ s ->
+        collect_visibles_ s
+    | A.AilSdefault s ->
+        collect_visibles_ s
+    | A.AilSlabel label s _ ->
+        St.update (fun st -> <| st with
+          label_visibles_= Map.insert label st.visible_syms st.label_visibles_
+        |>) >>
+        collect_visibles_ s
+    | A.AilSgoto label ->
+        St.return ()
+    | A.AilSdeclaration declarations ->
+        St.mapM_ (fun (_, expression) ->
+          match expression with
+            | Just value -> collect_visibles_expr value
+            | Nothing -> St.return ()
+          end
+        ) declarations
+    | A.AilSpar ss ->
+        St.mapM_ collect_visibles_ ss
+    | A.AilSreg_store _ expression ->
+        collect_visibles_expr expression
+    | A.AilSmarker _ s ->
+        collect_visibles_ s
+  end
+
+val collect_visibles: A.statement GenTypes.genTypeCategory -> collect_visibles_state
+let collect_visibles stmt =
+    snd begin
+      State.runStateM (collect_visibles_ stmt)
+        <| visible_syms= []
+         ; label_visibles_= Map.empty |>
+    end
