+val gnu_guard_scalar_update: A.expression GenTypes.genTypeCategory -> bool
+let gnu_guard_scalar_update (A.AnnotatedExpression _ _ _ node) =
+  let direct (A.AnnotatedExpression _ _ _ node as operand) =
+    let (qs, ty) = qualified_ctype_of operand in
+    not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) && AilTypesAux.is_integer ty &&
+      match node with A.AilEident _ -> true | _ -> false end in
+  match node with
+    | A.AilEunary A.PostfixIncr operand -> direct operand
+    | A.AilEunary A.PostfixDecr operand -> direct operand
+    | A.AilEcompoundAssign operand _ value ->
+        direct operand && gnu_size_literal_offset value
+    | A.AilEassign operand value -> direct operand && gnu_size_literal_offset value
+    | _ -> false
+  end
