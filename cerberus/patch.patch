+    let (fsMetadata, _, fsState) ← take (readBytes enums tags metadataPointer 144 fsStatResult.memory)
+    ensure (fsStatResult.returnValue == 0 && fsMetadata == fsStatNative.bytes && fsStatNative.fields[7]! == 5)
+      "FS_STAT preserves the complete native object representation"
+    let closeRequest ← take (CerbHostFilesFS.decode none (.FS_CLOSE 45))
+    let fsClose ← take (prepare enums tags fsResolve [] 0 base closeRequest fsState)
+    let fsClosed ← take (complete enums tags fsClose (← executeNative fsClose))
+    if fsClosed.releasedGuests == [45] then forget fsFD
+    ensure (fsClosed.returnValue == 0 && fsClosed.releasedGuests == [45])
+      "FS_CLOSE consumes exactly its mapped descriptor"
+    IO.println "files-guest-ok"
+  finally
+    for fd in ← owned.get do
+      let _ ← CerbHostFilesAdapters.executeResolved 0 (.close fd)
+      pure ()
+    let path ← createdPath.get
+    if !path.isEmpty then
+      let _ ← CerbHostFilesAdapters.executeResolved 0 (.unlink path)
+      pure ()
+
+def main (args : List String) : IO Unit := do
+  match args with
+  | [fuel] =>
+    match fuel.toNat? with
+    | some budget => @run ⟨budget⟩ ⟨CerbGlobal.defaultSwitches⟩
+    | none => throw (IO.userError "expected checked-runner fuel argument")
+  | _ => throw (IO.userError "expected checked-runner fuel argument")
