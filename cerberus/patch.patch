+/-- Logical occurrence relation independent of traversal implementation. -/
+inductive Occurs : Node → Node → Prop
+  | here (node : Node) : Occurs node node
+  | descend {parent child found : Node} :
+      Immediate parent child → Occurs child found → Occurs parent found
+
+/-- Total traversal. Every recursive call consumes a genuine smaller Core
+subterm. There is no fuel exhaustion, partial definition or default fallback. -/
+def extract (node : Node) : List Node :=
+  node :: (children node).attach.flatMap (fun child => extract child.val)
+termination_by measure node
+decreasing_by
+  exact immediate_measure_lt _ _ ((immediate_iff_mem _ _).mpr child.property)
+
+theorem occurs_mem {root found : Node} (h : Occurs root found) :
+    found ∈ extract root := by
+  induction h with
+  | here node => rw [extract]; exact List.mem_cons_self
+  | @descend parent child found step occurrence ih =>
+    rw [extract]
+    apply List.mem_cons_of_mem
+    apply List.mem_flatMap.mpr
+    let c : {n // n ∈ children parent} := ⟨child, (immediate_iff_mem _ _).mp step⟩
+    exact ⟨c, List.mem_attach _ _, ih⟩
+
+theorem mem_occurs (root found : Node) (h : found ∈ extract root) :
+    Occurs root found := by
+  rw [extract] at h
+  rcases List.mem_cons.mp h with equal | inside
+  · subst found; exact .here root
+  · rcases List.mem_flatMap.mp inside with ⟨child, _, member⟩
+    exact .descend ((immediate_iff_mem _ _).mpr child.property)
+      (mem_occurs child.val found member)
+termination_by measure root
+decreasing_by
+  exact immediate_measure_lt _ _ ((immediate_iff_mem _ _).mpr child.property)
+
+/-- No syntactic occurrence is omitted, and no non-subterm is fabricated. -/
+theorem extract_exact (root found : Node) :
+    found ∈ extract root ↔ Occurs root found :=
+  ⟨mem_occurs root found, occurs_mem⟩
+
+end CerbCertifiedInventory
