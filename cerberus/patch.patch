+              let (qs, ty) = qualified_ctype_of left in
+              if not (AilTypesAux.is_integer ty && gnu_inline_fixed_object_type element_ty &&
+                  not qs.Ctype.volatile && not (AilTypesAux.is_atomic ty) &&
+                  gnu_size_effects base = Just false && gnu_size_effects original = Just false &&
