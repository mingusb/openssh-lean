+static int memo_part_name(const char *name) {
+    const char *prefix = strrchr(memo_cache_path, '/');
+    prefix = prefix ? prefix + 1 : memo_cache_path;
+    size_t n = strlen(prefix);
+    if (strncmp(name, prefix, n) || strncmp(name + n, ".part.", 6)) return 0;
+    const char *tail = name + n + 6;
+    size_t size = strlen(tail);
+    return size > 6 && !strcmp(tail + size - 6, ".olean") &&
+        strspn(tail, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.") == size;
+}
+static void memo_add_part(char *path, const char *hash) {
+    memo_part_paths = realloc(memo_part_paths, (memo_part_count + 1) * sizeof(char *));
+    memo_part_hashes = realloc(memo_part_hashes, (memo_part_count + 1) * sizeof(char *));
+    if (!memo_part_paths || !memo_part_hashes) abort();
+    memo_part_paths[memo_part_count] = path;
+    memo_part_hashes[memo_part_count++] = strdup(hash);
