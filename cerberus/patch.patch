+(* The pinned libc accessor exposes an integer object, not an opaque pointer
+   allocation. Keep its effect and scalar-load contract separate from pointer
+   origin inference. A visible replacement is analysed through its own body. *)
+val gnu_standard_errno_accessor: A.expression GenTypes.genTypeCategory -> E.elabM bool
+let gnu_standard_errno_accessor (A.AnnotatedExpression _ _ _ node) = match node with
+  | A.AilEcall callee [] ->
+      let signature = match ctype_of callee with
+        | Ctype.Ctype _ (Ctype.Pointer _ (Ctype.Ctype _ (Ctype.Function
+            (_, Ctype.Ctype _ (Ctype.Pointer qs result)) [] false))) ->
+            qs = Ctype.no_qualifiers && gnu_function_target_type_equal result Ctype.signed_int
+        | _ -> false end in
+      if not signature || not (gnu_inline_direct_designator callee) then E.return false else
+      gnu_inline_function_target callee >>= (function
+        | Nothing -> E.return false
+        | Just (declared, _) -> E.gnu_inline_target declared >>= fun target ->
+            E.gnu_has_source_definition target >>= fun defined ->
+            E.linker_name declared >>= fun name ->
+            gnu_call_attributes callee >>= fun attrs ->
+            E.return (not defined && name = Just "__errno_location" &&
+              not (Cerb_attributes.has_gnu_noarg_attribute "returns_twice" attrs))
+        end)
+  | _ -> E.return false end
