+    assert(r.boundary_error); /* No native read/termination occurred. */
+    r=cerb_host_files___read_chk_raw(INCOMING,fd,3,5);
+    ok(r);assert(r.status.value==3 && !memcmp(r.bytes,payload,3));cerb_host_files_dispose(&r);
+    ok(cerb_host_files_lseek_raw(INCOMING,fd,0,SEEK_SET));
+    r=cerb_host_files_read_raw(INCOMING,fd,3);
+    ok(r); assert(r.status.value==3 && r.bytes_count==3 && !memcmp(r.bytes,payload,3));
+    cerb_host_files_dispose(&r);
+    r=cerb_host_files_read_raw(INCOMING,fd,8);
+    ok(r); assert(r.status.value==2 && r.bytes_count==2 && !memcmp(r.bytes,payload+3,2));
+    cerb_host_files_dispose(&r);
+    r=cerb_host_files_read_raw(INCOMING,fd,8);
+    ok(r); assert(r.status.value==0 && r.bytes_count==0); cerb_host_files_dispose(&r);
+    ok(cerb_host_files_lseek_raw(INCOMING,fd,0,SEEK_SET));
+    r=cerb_host_files_readv_raw(INCOMING,fd,lengths,2);
+    ok(r); assert(r.status.value==5 && r.bytes_count==5 && !memcmp(r.bytes,payload,5));
+    cerb_host_files_dispose(&r);
+
+    struct stat native;
+    assert(fstat(fd,&native)==0);
+    assert_stat(cerb_host_files_fstat_raw(INCOMING,fd),&native);
+    assert_stat(cerb_host_files_stat_raw(INCOMING,PATH(path)),&native);
+    assert_stat(cerb_host_files_fstatat_raw(INCOMING,AT_FDCWD,PATH(path),0),&native);
+    r=cerb_host_files_fstatvfs_raw(INCOMING,fd); ok(r);
+    struct statvfs native_vfs; assert(fstatvfs(fd,&native_vfs)==0);
+    assert(r.field_count==12 && r.fields[11]==native_vfs.f_type);
+    assert(r.bytes_count==sizeof(struct statvfs));
+    struct statvfs transported_vfs; memcpy(&transported_vfs,r.bytes,sizeof(transported_vfs));
+    assert(transported_vfs.f_type==native_vfs.f_type && transported_vfs.f_bsize==r.fields[0]);
+    for (size_t i=0; i<sizeof(transported_vfs.__f_spare)/sizeof(transported_vfs.__f_spare[0]); ++i)
+        assert(transported_vfs.__f_spare[i]==0);
+
+    assert(r.field_count==12 && r.fields[0]==native_vfs.f_bsize && r.fields[10]==native_vfs.f_namemax);
+    cerb_host_files_dispose(&r);
+
+    r=cerb_host_files_dup_raw(INCOMING,fd); ok(r); int copy=(int)r.status.value;
+    /* Driver maps guest identities to these returned handles; numeric identity
+       between a guest descriptor and this host descriptor is never assumed. */
+    const int guest_fd=701, guest_copy=919;
+    assert(guest_fd!=guest_copy);
+    assert(lseek(copy,0,SEEK_SET)==0);
+    r=cerb_host_files_read_raw(INCOMING,fd,1);
+    ok(r); assert(r.status.value==1 && r.bytes[0]==0); cerb_host_files_dispose(&r);
+    r=cerb_host_files_dup2_raw(INCOMING,fd,copy); ok(r); assert(r.status.value==copy);
+    ok(cerb_host_files_close_raw(INCOMING,copy));
+    error(cerb_host_files_close_raw(INCOMING,copy),EBADF);
+    r=cerb_host_files_read_raw(INCOMING,-1,1); error(r,EBADF);cerb_host_files_dispose(&r);
+    error(cerb_host_files_open_raw(INCOMING,PATH(missing),O_RDONLY,0,0),ENOENT);
+    error(cerb_host_files_stat_raw(INCOMING,PATH(missing)),ENOENT);
+    r=cerb_host_files_fcntl_raw(INCOMING,fd,F_GETFL,0);ok(r);
+    assert((r.status.value&O_ACCMODE)==O_RDWR);
+    ok(cerb_host_files_fcntl_raw(INCOMING,fd,F_SETFD,FD_CLOEXEC));
+    assert(fcntl(fd,F_GETFD)&FD_CLOEXEC);
+    r=cerb_host_files_fcntl_raw(INCOMING,fd,INT_MAX,0);assert(r.boundary_error);
+    const unsigned char bad_path[]={'x',0,'y',0};
+    r=cerb_host_files_access_raw(INCOMING,bad_path,sizeof(bad_path),F_OK);
+    assert(r.boundary_error);
+
+    ok(cerb_host_files_ftruncate_raw(INCOMING,fd,3));
+    ok(cerb_host_files_fsync_raw(INCOMING,fd));
+    ok(cerb_host_files_fchmod_raw(INCOMING,fd,0640));
