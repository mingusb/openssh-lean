+static lean_object *memo_raw_argument(lean_object *arg) {
+    lean_object *key = lean_alloc_ctor(0, 1, 0);
+    lean_inc(arg); lean_ctor_set(key, 0, arg);
+    return key;
+}
+static memo_entry *memo_argument_find(lean_object *arg) {
+    return memo_find(&memo_argument_keys, arg, memo_hash(&memo_argument_keys, arg));
+}
+static memo_arg_frame memo_arg_frame_new(lean_object *arg) {
+    memo_arg_frame f = {.object = arg, .tag = lean_ptr_tag(arg)};
+    if (f.tag <= LeanMaxCtorTag) f.count = lean_ctor_num_objs(arg);
+    else if (f.tag == LeanArray) f.count = lean_array_size(arg);
+    else if (f.tag == LeanClosure) f.count = lean_closure_num_fixed(arg);
+    f.children = lean_alloc_array(f.count, f.count);
+    /* The scalar placeholder marks an active ancestor, not a cached result. */
+    lean_inc(arg); memo_put(&memo_argument_keys, arg, lean_box(0), 0);
+    return f;
+}
+static lean_object *memo_arg_frame_finish(memo_arg_frame *f) {
+    lean_object *key;
+    if (f->tag == LeanClosure) {
+        key = lean_alloc_ctor(1, 3, 0);
+        lean_ctor_set(key, 0, memo_code_key(lean_closure_fun(f->object)));
+        lean_ctor_set(key, 1, lean_box(lean_closure_arity(f->object)));
+        lean_ctor_set(key, 2, f->children);
+    } else if (f->encoded_child && f->tag <= LeanMaxCtorTag) {
+        size_t offset = (uint8_t *)lean_ctor_scalar_cptr(f->object) - (uint8_t *)f->object;
+        size_t size = lean_object_data_byte_size(f->object);
+        if (size < offset) abort();
+        size -= offset;
+        lean_object *scalars = lean_alloc_sarray(1, size, size);
+        if (size) memcpy(lean_sarray_cptr(scalars), lean_ctor_scalar_cptr(f->object), size);
+        key = lean_alloc_ctor(2, 3, 0);
+        lean_ctor_set(key, 0, lean_box(f->tag));
+        lean_ctor_set(key, 1, scalars);
+        lean_ctor_set(key, 2, f->children);
+    } else if (f->encoded_child && f->tag == LeanArray) {
+        key = lean_alloc_ctor(3, 1, 0);
+        lean_ctor_set(key, 0, f->children);
+    } else {
+        lean_dec(f->children);
+        key = memo_raw_argument(f->object);
+    }
+    lean_inc(f->object); lean_inc(key);
+    memo_put(&memo_argument_keys, f->object, key, 0);
+    return key;
+}
+static lean_object *memo_argument_key(lean_object *arg) {
+    if (lean_is_scalar(arg)) return memo_raw_argument(arg);
+    if (!memo_argument_keys.capacity) {
+        memo_argument_keys.capacity = 1024;
+        memo_argument_keys.buckets = memo_alloc(1024, sizeof(*memo_argument_keys.buckets));
+    }
+    memo_entry *found = memo_argument_find(arg);
+    if (found && !lean_is_scalar(found->value)) {
+        lean_inc(found->value); return found->value;
+    }
+    size_t depth = 1, capacity = 64;
+    memo_arg_frame *stack = memo_alloc(capacity, sizeof(*stack));
+    stack[0] = memo_arg_frame_new(arg);
+    lean_object *result = NULL;
+    while (depth) {
+        memo_arg_frame *f = &stack[depth - 1];
+        if (f->next == f->count) {
+            result = memo_arg_frame_finish(f);
+            --depth;
+            if (!depth) break;
+            f = &stack[depth - 1];
+            f->encoded_child |= lean_obj_tag(result) != 0;
+            lean_array_set_core(f->children, f->next++, result);
+            continue;
+        }
+        size_t i = f->next;
+        lean_object *child = f->tag == LeanArray ? lean_array_get_core(f->object, i) :
+            f->tag == LeanClosure ? lean_closure_get(f->object, i) : lean_ctor_get(f->object, i);
+        found = lean_is_scalar(child) ? NULL : memo_argument_find(child);
+        if (lean_is_scalar(child) || found) {
+            if (!found || lean_is_scalar(found->value)) {
+                /* A cycle remains an opaque process-local key; disk admission
+                   still rejects cyclic graphs rather than guessing equality. */
+                result = memo_raw_argument(child);
+            } else { result = found->value; lean_inc(result); }
+            f->encoded_child |= lean_obj_tag(result) != 0;
+            lean_array_set_core(f->children, f->next++, result);
+        } else {
+            if (depth == capacity) {
+                capacity *= 2;
+                stack = realloc(stack, capacity * sizeof(*stack));
+                if (!stack) abort();
+            }
+            stack[depth++] = memo_arg_frame_new(child);
+        }
+    }
+    free(stack);
+    return result;
+}
diff --git a/lean_frontend/native/memo_runtime.c b/lean_frontend/native/memo_runtime.c
new file mode 100644
index 00000000..48325a64
--- /dev/null
+++ b/lean_frontend/native/memo_runtime.c
@@ -0,0 +1,398 @@
+/* Private mutable storage for Lean's ShareCommon and result cache.
+   Every operation is serialized by the Lean cache mutex. Keys and values
+   retain strong references; hash collisions are resolved by exact equality.
+   Pointer keys use identity; structural keys use the pinned Lean runtime.
+   Growth rehashes stored hashes without traversing any Lean object. */
+#define _GNU_SOURCE
+#include <lean/lean.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+#include <dlfcn.h>
+#include <link.h>
+#include <sys/stat.h>
+#include <sys/file.h>
+#include <sys/wait.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <spawn.h>
+#include <limits.h>
+#include <dirent.h>
+
+extern uint8_t lean_sharecommon_eq(b_lean_obj_arg, b_lean_obj_arg);
+extern uint64_t lean_sharecommon_hash(b_lean_obj_arg);
+
+typedef struct memo_entry {
+    struct memo_entry *next;
+    lean_object *key, *value;
+    uint64_t hash;
+    uint8_t restored;
+} memo_entry;
+
+typedef struct memo_table {
+    struct memo_table *registered_next;
+    size_t capacity, size;
+    uint8_t structural;
+    memo_entry **buckets;
+} memo_table;
+
+static void *memo_alloc(size_t n, size_t size) {
+    void *p = calloc(n, size);
+    if (!p) abort();
+    return p;
+}
+
+static void memo_clear(memo_table *t) {
+    for (size_t i = 0; i < t->capacity; ++i) {
+        memo_entry *e = t->buckets[i];
+        while (e) {
+            memo_entry *next = e->next;
+            lean_dec(e->key);
+            lean_dec(e->value);
+            free(e);
+            e = next;
+        }
+        t->buckets[i] = NULL;
+    }
+    t->size = 0;
+}
+
+static void memo_persist_unregister(memo_table *t);
+
+static void memo_finalize(void *p) {
+    memo_table *t = p;
+    memo_persist_unregister(t);
+    memo_clear(t);
+    free(t->buckets);
+    free(t);
+}
+
+static void memo_foreach(void *p, b_lean_obj_arg f) {
+    memo_table *t = p;
+    for (size_t i = 0; i < t->capacity; ++i)
+        for (memo_entry *e = t->buckets[i]; e; e = e->next) {
+            lean_inc(f);
+            lean_inc(e->key);
+            lean_dec(lean_apply_1(f, e->key));
+            lean_inc(f);
+            lean_inc(e->value);
+            lean_dec(lean_apply_1(f, e->value));
+        }
+}
+
+static lean_external_class *memo_class;
+static pthread_once_t memo_once = PTHREAD_ONCE_INIT;
+static int memo_diagnostics_enabled;
+static void memo_report_tables(void);
+static void memo_register(void) {
+    const char *setting = getenv("CERB_MEMO_DIAGNOSTICS");
+    memo_diagnostics_enabled = setting && !strcmp(setting, "1");
+    atexit(memo_report_tables);
+    memo_class = lean_register_external_class(memo_finalize, memo_foreach);
+}
+
+/* Finalize all 64 bits before masking into power-of-two buckets. Lean's
+   mix_hash is a combining step: passing an aligned pointer as its first
+   argument leaves its low bits aligned, causing long collision chains. */
+static uint64_t memo_avalanche(uint64_t h) {
+    h ^= h >> 30;
+    h *= UINT64_C(0xbf58476d1ce4e5b9);
+    h ^= h >> 27;
+    h *= UINT64_C(0x94d049bb133111eb);
+    return h ^ (h >> 31);
+}
+
+static uint64_t memo_hash(const memo_table *t, b_lean_obj_arg key) {
+    return memo_avalanche(t->structural ? lean_sharecommon_hash(key) :
+        (uint64_t)(uintptr_t)key);
+}
+
+/* Compaction changes the MPZ object's allocation size (heap 24, region 32
+   bytes in this pinned runtime). ShareCommon checks storage size before its
+   MPZ value comparison, so equal restored integers otherwise never intern.
+   Hashing already uses numeric contents; compare that same signed value. */
+static uint8_t memo_structural_eq(b_lean_obj_arg a, b_lean_obj_arg b) {
+    if (!lean_is_scalar(a) && !lean_is_scalar(b) &&
+        lean_ptr_tag(a) == LeanMPZ && lean_ptr_tag(b) == LeanMPZ)
+        return lean_int_dec_eq(a, b);
+    return lean_sharecommon_eq(a, b);
+}
+
+static memo_entry *memo_find(const memo_table *t, b_lean_obj_arg key, uint64_t hash) {
+    for (memo_entry *e = t->buckets[hash & (t->capacity - 1)]; e; e = e->next)
+        if (e->hash == hash && (e->key == key ||
+            (t->structural && memo_structural_eq(e->key, key))))
+            return e;
+    return NULL;
+}
+
+static void memo_grow(memo_table *t) {
+    if (t->capacity > SIZE_MAX / 2 / sizeof(*t->buckets)) abort();
+    size_t capacity = t->capacity * 2;
+    memo_entry **buckets = memo_alloc(capacity, sizeof(*buckets));
+    for (size_t i = 0; i < t->capacity; ++i) {
+        memo_entry *e = t->buckets[i];
+        while (e) {
+            memo_entry *next = e->next;
+            size_t slot = e->hash & (capacity - 1);
+            e->next = buckets[slot];
+            buckets[slot] = e;
+            e = next;
+        }
+    }
+    free(t->buckets);
+    t->buckets = buckets;
+    t->capacity = capacity;
+}
+
+static void memo_put(memo_table *t, lean_obj_arg key, lean_obj_arg value, uint8_t restored) {
+    uint64_t hash = memo_hash(t, key);
+    memo_entry *e = memo_find(t, key, hash);
+    /* The externally held tables can be shared between Lean worker threads. */
+    lean_mark_mt(value);
+    if (e) {
+        lean_dec(key);
+        lean_dec(e->value);
+        e->value = value;
+        e->restored = restored;
+        return;
+    }
+    lean_mark_mt(key);
+    if (t->size >= t->capacity - t->capacity / 4) memo_grow(t);
+    size_t slot = hash & (t->capacity - 1);
+    e = memo_alloc(1, sizeof(*e));
+    e->next = t->buckets[slot];
+    e->key = key;
+    e->value = value;
+    e->hash = hash;
+    e->restored = restored;
+    t->buckets[slot] = e;
+    ++t->size;
+}
+
+/* A dedicated execution cache for the proof-defined tag-environment weight.
+   Cache hits require the exact same retained immutable Lean object. Computing
+   the value happens outside the lock, so recursive layout calls cannot deadlock.
+   This table is deliberately outside the broad persistent memo tables: process
+   pointers have no identity across runs. */
+static memo_table tag_weight_cache;
+static pthread_mutex_t tag_weight_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+LEAN_EXPORT lean_obj_res cerb_tagdefs_weight_cached(b_lean_obj_arg key,
+        lean_obj_arg compute) {
+    pthread_mutex_lock(&tag_weight_mutex);
+    if (!tag_weight_cache.capacity) {
+        tag_weight_cache.capacity = 1024;
+        tag_weight_cache.buckets = memo_alloc(1024, sizeof(*tag_weight_cache.buckets));
+    }
+    memo_entry *entry = memo_find(&tag_weight_cache, key,
+        memo_hash(&tag_weight_cache, key));
+    if (entry) {
+        lean_inc(entry->value);
+        lean_object *value = entry->value;
+        pthread_mutex_unlock(&tag_weight_mutex);
+        lean_dec(compute);
+        return value;
+    }
+    pthread_mutex_unlock(&tag_weight_mutex);
+
+    lean_object *value = lean_apply_1(compute, lean_box(0));
+    pthread_mutex_lock(&tag_weight_mutex);
+    lean_inc(key);
+    lean_inc(value);
+    memo_put(&tag_weight_cache, key, value, 0);
+    pthread_mutex_unlock(&tag_weight_mutex);
+    return value;
+}
+
+/* Disk persistence is below the existing FFI boundary. Hot table operations
+   remain hash lookups; hashing files, compaction and relocation run only at
+   startup/normal shutdown. Hash collisions never substitute for key equality.
+   Loaded regions stay mapped until process exit because tables point into them. */
+#include "memo_persist.h"
+
+static memo_table memo_probe_counts;
+static void memo_note_probe(const memo_table *table, lean_object *key, int hit) {
+    if (!memo_diagnostics_enabled || table->structural || table == memo_tables ||
+        table != memo_tables->registered_next->registered_next) return;
+    if (!memo_probe_counts.capacity) {
+        memo_probe_counts.capacity = 1024;
+        memo_probe_counts.buckets = memo_alloc(1024, sizeof(*memo_probe_counts.buckets));
+    }
+    lean_object *code = lean_ctor_get(key, 0);
+    memo_entry *e = memo_find(&memo_probe_counts, code, memo_hash(&memo_probe_counts, code));
+    uint64_t hits = e ? lean_ctor_get_uint64(e->value, 0) : 0;
+    uint64_t misses = e ? lean_ctor_get_uint64(e->value, 8) : 0;
+    lean_object *counts = lean_alloc_ctor(0, 0, 16);
+    lean_ctor_set_uint64(counts, 0, hits + (hit != 0));
+    lean_ctor_set_uint64(counts, 8, misses + (hit == 0));
+    lean_inc(code);
+    memo_put(&memo_probe_counts, code, counts, 0);
+}
+
+/* Optional real-workload evidence. Compare the previous and current bucket
+   distributions for exactly the same keys, outside timed execution. */
+static void memo_report_table(const char *name, const memo_table *t) {
+    if (!t->size) return;
+    size_t *old = memo_alloc(t->capacity, sizeof(*old));
+    size_t old_max = 0, new_max = 0;
+    uint64_t old_pairs = 0, new_pairs = 0;
+    for (size_t i = 0; i < t->capacity; ++i) {
+        size_t chain = 0;
+        for (memo_entry *e = t->buckets[i]; e; e = e->next) {
+            ++chain;
+            uint64_t hash = t->structural ? lean_sharecommon_hash(e->key) :
+                lean_uint64_mix_hash((uintptr_t)e->key, 11);
+            size_t n = ++old[hash & (t->capacity - 1)];
+            old_pairs += n - 1;
+            if (n > old_max) old_max = n;
+        }
+        new_pairs += chain * (chain - 1) / 2;
+        if (chain > new_max) new_max = chain;
+    }
+    memo_trace("distribution table=%s entries=%zu capacity=%zu old_max=%zu new_max=%zu old_probe_mean=%.4f new_probe_mean=%.4f\n",
+        name, t->size, t->capacity, old_max, new_max,
+        1.0 + (double)old_pairs / t->size, 1.0 + (double)new_pairs / t->size);
+    free(old);
+}
+static void memo_report_tables(void) {
+    if (!memo_diagnostics_enabled) return;
+    const char *names[] = {"identity", "canonical", "results"};
+    size_t i = 0;
+    for (memo_table *t = memo_tables; t; t = t->registered_next)
+        memo_report_table(i < 3 ? names[i++] : "extra", t);
+    memo_report_table("arguments", &memo_argument_keys);
+    memo_report_table("codes", &memo_codes);
+    for (size_t i = 0; i < memo_probe_counts.capacity; ++i)
+        for (memo_entry *e = memo_probe_counts.buckets[i]; e; e = e->next)
+            memo_trace("function offset=%llu hits=%llu misses=%llu library=%s\n",
+                (unsigned long long)lean_unbox_uint64(lean_ctor_get(e->key, 1)),
+                (unsigned long long)lean_ctor_get_uint64(e->value, 0),
+                (unsigned long long)lean_ctor_get_uint64(e->value, 8),
+                lean_string_cstr(lean_ctor_get(e->key, 0)));
+}
+
+LEAN_EXPORT lean_obj_res cerb_memo_table_new(uint8_t structural, lean_obj_arg unit) {
+    (void)unit;
+    pthread_once(&memo_once, memo_register);
+    memo_table *t = memo_alloc(1, sizeof(*t));
+    t->capacity = 1024;
+    t->structural = structural;
+    t->buckets = memo_alloc(t->capacity, sizeof(*t->buckets));
+    pthread_mutex_lock(&memo_disk_mutex);
+    memo_persist_register(t);
+    pthread_mutex_unlock(&memo_disk_mutex);
+    return lean_alloc_external(memo_class, t);
+}
+
+LEAN_EXPORT lean_obj_res cerb_memo_table_find(b_lean_obj_arg table, b_lean_obj_arg key) {
+    pthread_mutex_lock(&memo_disk_mutex);
+    memo_table *t = lean_get_external_data(table);
+    memo_entry *e = memo_find(t, key, memo_hash(t, key));
+    memo_note_probe(t, key, e != NULL);
+    if (!e) {
+        pthread_mutex_unlock(&memo_disk_mutex);
+        return lean_box(0);
+    }
+    if (e->restored) ++memo_restored_hits;
+    lean_object *some = lean_alloc_ctor(1, 1, 0);
+    lean_inc(e->value);
+    lean_ctor_set(some, 0, e->value);
+    pthread_mutex_unlock(&memo_disk_mutex);
+    return some;
+}
+
+LEAN_EXPORT lean_obj_res cerb_memo_table_insert(lean_obj_arg table,
+        lean_obj_arg key, lean_obj_arg value) {
+    pthread_mutex_lock(&memo_disk_mutex);
+    memo_table *t = lean_get_external_data(table);
+    memo_put(t, key, value, 0);
+    if (!memo_transient_identity(t)) memo_dirty = 1;
+    pthread_mutex_unlock(&memo_disk_mutex);
+    return table;
+}
+
+LEAN_EXPORT lean_obj_res cerb_memo_table_clear(lean_obj_arg table) {
+    pthread_mutex_lock(&memo_disk_mutex);
+    if (lean_get_external_data(table) == memo_tables && memo_argument_keys.capacity)
+        memo_clear(&memo_argument_keys);
+    memo_clear(lean_get_external_data(table));
+    memo_disk_reset = 1;
+    memo_dirty = 1;
+    pthread_mutex_unlock(&memo_disk_mutex);
+    return table;
+}
+
+/* Remove a temporary pointer alias without discarding its canonical object
+   or cached result. Expected O(1), with the same exact-key bucket policy. */
+static void memo_erase_identity(memo_table *t, b_lean_obj_arg key) {
+    uint64_t hash = memo_hash(t, key);
+    memo_entry **slot = &t->buckets[hash & (t->capacity - 1)];
+    while (*slot) {
+        memo_entry *e = *slot;
+        if (e->hash == hash && e->key == key) {
+            *slot = e->next;
+            lean_dec(e->key);
+            lean_dec(e->value);
+            free(e);
+            --t->size;
+            return;
+        }
+        slot = &e->next;
+    }
+}
+
+/* closureKey allocates its key/capture wrappers for this lookup only. Retaining
+   their pointer aliases would grow memory on every hit. The caller holds
+   raw_key alive until this returns, so its captures array remains valid.
+   Reusable argument identities and all canonical/result entries stay intact. */
+LEAN_EXPORT lean_obj_res cerb_memo_forget_lookup_wrappers(
+        lean_obj_arg table, b_lean_obj_arg raw_key) {
+    pthread_mutex_lock(&memo_disk_mutex);
+    memo_table *t = lean_get_external_data(table);
+    if (t->structural) abort();
+    lean_object *captures = lean_ctor_get(raw_key, 1);
+    for (size_t i = 0; i < lean_array_size(captures); ++i) {
+        lean_object *arg = lean_array_get_core(captures, i);
+        /* Immediate arguments are wrapped anew by memo_argument_key; unlike
+           heap argument encodings, these wrappers have no reusable owner. */
+        if (!lean_is_scalar(arg) && lean_obj_tag(arg) == 0 &&
+                lean_ctor_num_objs(arg) == 1 &&
+                lean_is_scalar(lean_ctor_get(arg, 0)))
+            memo_erase_identity(t, arg);
+    }
+    memo_erase_identity(t, captures);
+    memo_erase_identity(t, raw_key);
+    pthread_mutex_unlock(&memo_disk_mutex);
+    return table;
+}
+
+/* Read-only observation used by the repeated-hit retention regression. */
+LEAN_EXPORT uint64_t cerb_memo_identity_entries(lean_obj_arg unit) {
+    (void)unit;
+    pthread_mutex_lock(&memo_disk_mutex);
+    uint64_t size = memo_tables ? memo_tables->size : 0;
+    pthread_mutex_unlock(&memo_disk_mutex);
+    return size;
+}
+
+/* Captures retain all runtime arguments, not just a hash or an AST tag.
+   Code identity is a library path plus relative offset, stable under ASLR.
+   The complete executable/library content manifest is checked before loading. */
+LEAN_EXPORT lean_obj_res cerb_memo_closure_key(b_lean_obj_arg thunk) {
+    const unsigned count = lean_closure_num_fixed(thunk);
+    lean_object *captures = lean_alloc_array(count, count);
+    pthread_mutex_lock(&memo_disk_mutex);
+    for (unsigned i = 0; i < count; ++i)
+        lean_array_set_core(captures, i, memo_argument_key(lean_closure_get(thunk, i)));
+    lean_object *code = memo_code_key(lean_closure_fun(thunk));
+    pthread_mutex_unlock(&memo_disk_mutex);
+    lean_object *key = lean_alloc_ctor(0, 2, 0);
+    lean_ctor_set(key, 0, code);
+    lean_ctor_set(key, 1, captures);
+    return key;
+}
